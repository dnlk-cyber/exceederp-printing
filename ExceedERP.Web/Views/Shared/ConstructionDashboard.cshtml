                          }, {
                              type: 'bar',
                              label: 'Payment to date',
                              backgroundColor: window.chartColors.green,
                              data: result.PaymentAmountTodateData,
                              borderColor: 'white',
                              borderWidth: 2
                          }]

                    },


                    options: {

                        title: {
                            display: true,
                            text: 'Project Payments'
                        },
                        gridLines: {
                            display: false
                        },
                        pieceLabel: {
                            render: 'value',
                            fontColor: ['green', 'white', 'black'],
                            precision: 2
                        },
                        legend: {
                            position: 'bottom',
                            fontSize: 8,
                            fullWidth: true,
                            padding: 6,
                            labels: {
                                boxWidth: 15
                            }
                        },
                        scales: {
                            xAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,
                                    labelString: 'Projects'
                                },
                                barPercentage: 0.4
                            }],
                            yAxes: [{
                                display: true,
                                scaleLabel: {
