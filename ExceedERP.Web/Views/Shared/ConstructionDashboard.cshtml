                            borderColor: window.chartColors.yellow,
                            borderWidth: 2,
                            fill: false,
                            data: result.RemainingTimeData
                        },
                          {
                              type: 'bar',
                              label: 'Total Project Time',
                              backgroundColor: window.chartColors.blue,
                              data: result.TotalContractTimeData,
                              borderColor: 'white',
                              borderWidth: 2
                          }, {
                              type: 'bar',
                              label: 'Time Elapsed',
                              backgroundColor: window.chartColors.green,
                              data: result.TimeElapsedData,
                              borderColor: 'white',
                              borderWidth: 2
                          }]

                    },


                    options: {

                        title: {
                            display: true,
                            text: 'Time Status'
                        },
                        gridLines: {
                            display: false
                        },
                        pieceLabel: {
                            render: 'value',
                            fontColor: ['green', 'white', 'black'],
                            precision: 2
                        },
                        legend: {
                            position: 'bottom',
                            fontSize: 8,
                            fullWidth: true,
                            padding: 6,
                            labels: {
                                boxWidth: 15
                            }
                        },
                        scales: {
                            xAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,
                                    labelString: 'Projects'
                                },
                                barPercentage: 0.4
                            }],
                            yAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,
                                    labelString: 'Time (days)'
                                },
                                //ticks: {

                                //    // forces step size to be 5 units
                                //    stepSize: 1000
                                //}
                            }]
                        },
                        maintainAspectRatio: false

                    }
                });

            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function addProjectPaymentToChart() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetProjectPaymentStatusData", "Dashboard", new {area = ""})',
            success: function (result) {
                //render
                var ctx = document.getElementById("projectPayment").getContext('2d');
                ctx.Height = 500;
                var myChart = new Chart(ctx, {
                    type: 'bar',
