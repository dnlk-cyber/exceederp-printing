@using ExceedERP.Core.Domain.CMS
<style>
    #reportViewer1 {
        position: relative;
        width: 100%;
        height: 900px;
        font-family: Verdana, Arial;
    }
</style>

@if (HttpContext.Current.User.IsInRole(CMSRoles.CMSAdmin)
            || HttpContext.Current.User.IsInRole(CMSRoles.Trainee)
            || HttpContext.Current.User.IsInRole(CMSRoles.Trainer)
            || HttpContext.Current.User.IsInRole(CMSRoles.Examiner)
            || HttpContext.Current.User.IsInRole(CMSRoles.CMSReporting)

            )
{


    <li class="">
        <a href="#" class="dropdown-toggle">
            <i class="menu-icon fa fa-certificate"></i>
            <span class="menu-text">
                Certificate Mgmt
            </span>

            <b class="arrow fa fa-angle-down"></b>
        </a>

        <b class="arrow"></b>

        <ul class="submenu">


            @if (HttpContext.Current.User.IsInRole(CMSRoles.Trainer)
                || HttpContext.Current.User.IsInRole(CMSRoles.Examiner)
                ||HttpContext.Current.User.IsInRole(CMSRoles.TraineeRegistration)
                )
            {

                <li class="">
                    <a href="#" class="dropdown-toggle">
                        <i class="menu-icon fa fa-caret-right"></i>
                        Trainees
                        <b class="arrow fa fa-angle-down"></b>
                    </a>

                    <b class="arrow"></b>

                    <ul class="submenu">
                        @if (HttpContext.Current.User.IsInRole(CMSRoles.TraineeRegistration))
                        {
                            <li id="cms-trainee-reg-01" class="actionlinlk">@Html.ActionLink("Trainee Registration", "Index", "Trainees", new { area = "CMS" }, null)<b class="arrow"></b></li>
                            <li id="cms-trainee-reg-02" class="actionlinlk">@Html.ActionLink("Training Enrolent", "Index", "TrainingEnrolment", new { area = "CMS" }, null)<b class="arrow"></b></li>
                        }
                        @if (HttpContext.Current.User.IsInRole(CMSRoles.Trainer))
                        {
                            <li id="cms-trainee-stt-01" class="actionlinlk">@Html.ActionLink("Training Status", "Index", "ProgramStatus", new { area = "CMS" }, null)<b class="arrow"></b></li>
                        }
                        @if (HttpContext.Current.User.IsInRole(CMSRoles.Examiner))
                        {
                            <li id="cms-trainee-evl-01" class="actionlinlk">@Html.ActionLink("Training Evaluation", "Index", "TrainingEvaluation", new { area = "CMS" }, null)<b class="arrow"></b></li>
                            <li id="cms-company-evl-01" class="actionlinlk">@Html.ActionLink("Company Evaluation", "Index", "CompanyEvaluation", new { area = "CMS" }, null)<b class="arrow"></b></li>

                        }
                    </ul>
                </li>
            }


            @if (HttpContext.Current.User.IsInRole(CMSRoles.CMSReporting)
                        )
            {

                <li class="">
                    <a href="#" class="dropdown-toggle">
                        <i class="menu-icon fa fa-caret-right"></i>
                        Report
                        <b class="arrow fa fa-angle-down"></b>
                    </a>
                    <b class="arrow"></b>
                    <ul class="submenu">


                        @if (HttpContext.Current.User.IsInRole(CMSRoles.CMSReporting))
                        {

                            <li id="crm031" class="actionlinlk">@Html.ActionLink("Customer List", "CustomerList", "CRMReport", new { area = "CRM" }, null)<b class="arrow"></b></li>

                        }
                    </ul>
                </li>
            }

            @if (HttpContext.Current.User.IsInRole(CMSRoles.CMSAdmin))
            {
                <li class="">
                    <a href="#" class="dropdown-toggle">
                        <i class="menu-icon fa fa-caret-right"></i>
                        Settings
                        <b class="arrow fa fa-angle-down"></b>
                    </a>

                    <b class="arrow"></b>

                    <ul class="submenu">
                        <li class="">
                            <a href="#" class="dropdown-toggle">
                                <i class="menu-icon fa fa-caret-right"></i>
                                Programs and Courses
                                <b class="arrow fa fa-angle-down"></b>
                            </a>
                            <b class="arrow"></b>
                            <ul class="submenu">
                                <li id="cms-set-01" class="actionlinlk">@Html.ActionLink("Programs", "Index", "Program", new { area = "CMS" }, null)<b class="arrow"></b></li>
                                <li id="cms-set-02" class="actionlinlk">@Html.ActionLink("Courses", "Index", "Course", new { area = "CMS" }, null)<b class="arrow"></b></li>
                            </ul>
                        </li>
                        <li class="">
                            <a href="#" class="dropdown-toggle">
                                <i class="menu-icon fa fa-caret-right"></i>
                                Address
                                <b class="arrow fa fa-angle-down"></b>
                            </a>

                            <b class="arrow"></b>

                            <ul class="submenu">
                                <li id="cms-set-03" class="actionlinlk">@Html.ActionLink("City", "Index", "City", new { area = "CMS" }, null)<b class="arrow"></b></li>
                            </ul>
                        </li>
                        <li class="">
                            <a href="#" class="dropdown-toggle">
                                <i class="menu-icon fa fa-caret-right"></i>
                                ID Components
                                <b class="arrow fa fa-angle-down"></b>
                            </a>

                            <b class="arrow"></b>
                            <ul class="submenu">
                                <li id="cms-set-04" class="actionlinlk">@Html.ActionLink("Registration Number Prefix", "Index", "RegistrationNumberPrefix", new { area = "CMS" }, null)<b class="arrow"></b></li>
                                <li id="cms-set-05" class="actionlinlk">@Html.ActionLink("ISO Types", "Index", "ISOTypes", new { area = "CMS" }, null)<b class="arrow"></b></li>
                            </ul>
                        </li>
                    </ul>
                </li>
            }
        </ul>
    </li>
}
