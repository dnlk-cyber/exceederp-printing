@(Html.Kendo().DropDownListFor(m => m)
                  .ValuePrimitive(true)
                  .OptionLabel("Select Tax...")
                          .DataTextField("TaxName")
                                  .DataValueField("GLTaxRateID")
                          .Filter("contains")
                                .DataSource(dataSource =>
                                {
                                    dataSource.Read(read => read.Action("GetArTax", "FinanceDataProvider", new { area = "Finance" }))
                                    .ServerFiltering(false);
                                })
)
@Html.ValidationMessageFor(m => m)
