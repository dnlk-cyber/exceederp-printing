@(Html.Kendo().DropDownListFor(m => m)
                  .ValuePrimitive(true)
                  .OptionLabel("Select Terms...")
                          .DataTextField("PaymentTermsDays")
                             .DataValueField("PaymentTermsDays")
                          .Filter("contains")
                                .DataSource(dataSource =>
                                {
                                    dataSource.Read(read => read.Action("GetPaymentTerms", "FinanceDataProvider", new { area = "Finance" }))
                                    .ServerFiltering(false);
                                })
)
@Html.ValidationMessageFor(m => m)
