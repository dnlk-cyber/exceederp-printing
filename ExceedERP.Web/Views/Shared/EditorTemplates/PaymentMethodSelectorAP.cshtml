@(Html.Kendo().DropDownListFor(m => m)
                  .ValuePrimitive(true)
                  .OptionLabel("Select Method...")
      .DataTextField("Method")
      .DataValueField("Method")
      .Filter("contains")
      .DataSource(dataSource =>
      {
          dataSource.Read(read => read.Action("GetApPaymentMethods", "FinanceDataProvider", new { area = "Finance" }))
              .ServerFiltering(false);
       })
)
@Html.ValidationMessageFor(m => m)
