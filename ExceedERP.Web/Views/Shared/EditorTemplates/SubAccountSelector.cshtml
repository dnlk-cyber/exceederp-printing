@(Html.Kendo().DropDownListFor(m => m)
                  .ValuePrimitive(true)
                  .OptionLabel("Select Sub Account...")
                      .DataTextField("Description")
                         .DataValueField("Values")
                          .Filter("contains")
                                .DataSource(dataSource =>
                                {
                                    dataSource.Read(read => read.Action("GetSubAccounts", "FinanceDataProvider", new { area = "Finance" }))
                                    .ServerFiltering(false);
                                })
)
@Html.ValidationMessageFor(m => m)

