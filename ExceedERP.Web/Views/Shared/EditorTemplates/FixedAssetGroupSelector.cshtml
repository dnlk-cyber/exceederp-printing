@(Html.Kendo().DropDownListFor(m => m)
                  .ValuePrimitive(true)
                  .OptionLabel("Select Group...")
                      .DataTextField("Name")
                         .DataValueField("FixedAssetGroupID")
                          .Filter("contains")
                                .DataSource(dataSource =>
                                {
                                    dataSource.Read(read => read.Action("GetGroup", "FixedAssetDataProvider", new { area = "FixedAsset" }))
                                    .ServerFiltering(false);
                                })
)
@Html.ValidationMessageFor(m => m)
