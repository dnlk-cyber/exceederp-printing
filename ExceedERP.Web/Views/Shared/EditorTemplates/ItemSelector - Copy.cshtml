@(Html.Kendo().DropDownListFor(m => m)
                  .ValuePrimitive(true)
                  .OptionLabel("Select Item...")
                      .DataTextField("Name")
                          .DataValueField("ItemCode")
                              .Filter("contains")
                               .DataSource(dataSource =>
                              {
                                  dataSource.Read(read => read.Action("GetItems", "DataProvider", new { area = "Inventory" }).Data("filterInventoryItems"))
                                            .ServerFiltering(true);
                              })
                              .CascadeFrom("ItemCategoryCode")
                                    .Events(e =>
                                    {
                                        e.Select("onSelectItemCode");
                                    })
)
@Html.ValidationMessageFor(m => m)
