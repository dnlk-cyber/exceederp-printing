                <li class="">
                    <a href="#" class="dropdown-toggle">
                        <i class="menu-icon fa fa-caret-right"></i>
                        Report
                        <b class="arrow fa fa-angle-down"></b>
                    </a>

                    <b class="arrow"></b>

                    <ul class="submenu">

                        <li id="InfoDesk0g10" class="actionlinlk">
                            @Html.ActionLink("Maintenance Report", "MaintenanceForm", "HelpDeskReport", new { area = "InfoDesk" }, null)<b class="arrow"></b>
                        </li>
                        @*<li id="InfoDeskreport11" class="actionlinlk">
                            @Html.ActionLink("Software License", "SoftwareLicense", "HelpDeskReport", new { area = "InfoDesk" }, null)<b class="arrow"></b>
                        </li>*@


                    </ul>
                </li>

            }


        </ul>
