@using ExceedERP.Core.Domain.Printing


@{
    ViewBag.Title = "_Printing";
}


@if (HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingEstimationOfficer)
     || HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingEstimationTeamLead)
     || HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingEstimationDepartmentHead)
         || HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingProductionHead)
         || HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingProductionTeamLead)
         || HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingProductionOfficer)
          || HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingAdmin)
         )
{

    <li class="">
        <a href="#" class="dropdown-toggle">
            <i class="menu-icon fa fa-print"></i>
            <span class="menu-text">
                Printing New
            </span>
            <b class="arrow fa fa-angle-down"></b>
        </a>
        <b class="arrow"></b>
        <ul class="submenu">

            @if (HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingEstimationOfficer)
     || HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingEstimationTeamLead)
     || HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingEstimationDepartmentHead))
            {
                <li class="">
                    <a href="#" class="dropdown-toggle">
                        <i class="menu-icon fa fa-caret-right"></i>
                        Estimation
                        <b class="arrow fa fa-angle-down"></b>
                    </a>
                    <b class="arrow"></b>
                    <ul class="submenu">
                        <li id="printingEst01" class="actionlinlk">@Html.ActionLink("Printing Cost Estimation", "Index", "PrintingCostEstimation", new { area = "Printing" }, null)<b class="arrow"></b></li>
                        <li id="printingEst02" class="actionlinlk">@Html.ActionLink("Printing Cost Estimation Summary", "Index", "PrintingCostEstimationSummary", new { area = "Printing" }, null)<b class="arrow"></b></li>
                        <li id="printingEst03" class="actionlinlk">@Html.ActionLink("Printing Proforma Invoice", "Index", "PrintingProformaInvoice", new { area = "Printing" }, null)<b class="arrow"></b></li>
                        <li id="printingEst04" class="actionlinlk">@Html.ActionLink("Printing Job Order", "Index", "PrintingJobOrder", new { area = "Printing" }, null)<b class="arrow"></b></li>

                    </ul>
                </li>
            }
            @if (HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingProductionHead)
         || HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingProductionTeamLead)
         || HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingProductionOfficer))
            {
                <li class="">
                    <a href="#" class="dropdown-toggle">
                        <i class="menu-icon fa fa-caret-right"></i>
                        Production
                        <b class="arrow fa fa-angle-down"></b>
                    </a>
                    <b class="arrow"></b>
                    <ul class="submenu">
                        <li id="printingProduction01" class="actionlinlk">@Html.ActionLink("Printing JobCard", "Index", "PrintingJobOrderProduction", new { area = "Printing" }, null)<b class="arrow"></b></li>
                        <li id="printingProduction02" class="actionlinlk">@Html.ActionLink("Pre-Press Follow-Up", "Index", "PrintingProductionFollowUp", new { area = "Printing" }, null)<b class="arrow"></b></li>
                        <li id="printingProduction03" class="actionlinlk">@Html.ActionLink("Press Follow-Up", "IndexPress", "PrintingProductionFollowUp", new { area = "Printing" }, null)<b class="arrow"></b></li>
                        <li id="printingProduction04" class="actionlinlk">@Html.ActionLink("Post-Press Follow-Up", "IndexPostPress", "PrintingProductionFollowUp", new { area = "Printing" }, null)<b class="arrow"></b></li>
                    </ul>
                </li>
            }



            @if (HttpContext.Current.User.IsInRole(PrintingEstimationRoles.PrintingAdmin)
                 )
            {
                <li class="">
                    <a href="#" class="dropdown-toggle">
                        <i class="menu-icon fa fa-caret-right"></i>
                        Settings
                        <b class="arrow fa fa-angle-down"></b>
                    </a>
                    <b class="arrow"></b>
                    <ul class="submenu">
                        @*<li id="ps1" class="actionlinlk">@Html.ActionLink("Printing Job Type", "Index", "PrintingJobType", new { area = "Printing" }, null)<b class="arrow"></b></li>*@
                        <li id="ps2" class="actionlinlk">@Html.ActionLink("Paper Size", "Index", "PrintingPaperSize", new { area = "Printing" }, null)<b class="arrow"></b></li>
                        @*<li id="ps3" class="actionlinlk">@Html.ActionLink("Binding Style", "Index", "PrintingBindingStyle", new { area = "Printing" }, null)<b class="arrow"></b></li>*@
                        <li id="ps4" class="actionlinlk">@Html.ActionLink("Printing Machine", "Index", "PrintingMachineType", new { area = "Printing" }, null)<b class="arrow"></b></li>
                        @*<li id="ps5" class="actionlinlk">@Html.ActionLink("Machine-Paper list", "Index", "PrintMachinePaperList", new { area = "Printing" }, null)<b class="arrow"></b></li>*@
                        @*<li id="ps6" class="actionlinlk">@Html.ActionLink("Printing Product Process", "Index", "PrintingProductProcess", new { area = "Printing" }, null)<b class="arrow"></b></li>*@
                        <li id="ps6" class="actionlinlk">@Html.ActionLink("Printing Process", "Index", "PrintingProcess", new { area = "Printing" }, null)<b class="arrow"></b></li>
                        <li id="ps6" class="actionlinlk">@Html.ActionLink("Printing Material Category", "Index", "PrintingMaterialCategory", new { area = "Printing" }, null)<b class="arrow"></b></li>

                    </ul>



                </li>
            }
            <li class="">
                <a href="#" class="dropdown-toggle">
                    <i class="menu-icon fa fa-tasks"></i>
                    <span class="menu-text">
                        Report
                    </span>

                    <b class="arrow fa fa-angle-down"></b>
                </a>

                <b class="arrow"></b>

                <ul class="submenu">
                    <li id="mega-Manufacturing-921" class="actionlinlk">@Html.ActionLink("Monthly Report", "PrintEstimationMonthlyReport", "PrintingReport", new { area = "Printing" }, null)<b class="arrow"></b></li>
                    <li id="mega-Manufacturing-931" class="actionlinlk">@Html.ActionLink("weekly Report", "PrintEstimationMonthlyReport", "PrintingReport", new { area = "Printing" }, null)<b class="arrow"></b></li>

                </ul>
            </li>
        </ul>
    </li>
   


}
