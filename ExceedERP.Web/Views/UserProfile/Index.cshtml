                                                            .DataSource(dataSource => dataSource
                                                            .Ajax()

                                                            .ServerOperation(false)
                                                            .Events(ev => ev.Error("error_handler(\"Signature\")")
                                                            .RequestStart("onRequestStart(\"Signature\")")
                                                            .RequestEnd("onRequestEnd(\"Signature\")"))

                                                            .Model(model => model.Id(p => p.ApplicationUserSignatureId))
                                                            .Model(model =>
                                                            {
                                                         //model.Field(p => p.UserId).DefaultValue("#=TraderId#");
                                                     })
                                                            .Read(read => read.Action("Signatures_Read", "UserProfile"))
                                                            .Create(create => create.Action("Signatures_Create", "UserProfile"))
                                                            .Update(update => update.Action("Signatures_Update", "UserProfile"))
                                                            .Destroy(des => des.Action("Signatures_Destroy", "UserProfile"))


                                                       )) </text>);



                                       })
)




@helper Signature()
{

    @(Html.Kendo().Grid<ApplicationUserSignature>()
                                                        .Name("Signature#=Id#") // template expression, to be evaluated in the master context
                                                        .Columns(columns =>
                                                        {
                                                            columns.Bound(c => c.Sign)
                                                            .ClientTemplate("<img src='data:image/png;base64,\\#=Image64\\#' class='imgLink' />");
                                                        })
                                                         .ToolBar(toolbar =>
                                                                        {
                                                                            toolbar.Create();

                                                                        })
                                                    .Editable(editable => editable.Mode(GridEditMode.PopUp)
                                                                    .TemplateName("UserSignatureEditor")
                                                                    .Window(w => w.Width(500).Title("Signature")))
                                                                    .Events(ev => ev.Save("OnDrawSignature"))
                                                                    .DataSource(dataSource => dataSource
                                                                    .Ajax()

                                                                    .ServerOperation(false)
                                                    .Events(ev => ev.Error("error_handler(\"Signature#=Id#\")")
                                                    .RequestStart("onRequestStart(\"Signature#=Id#\")")
                                                    .RequestEnd("onRequestEnd(\"Signature#=Id#\")"))

                                                    .Model(model => model.Id(p => p.ApplicationUserSignatureId))
                                                    .Read(read => read.Action("Signatures_Read", "UserProfile", new { id = "#=Id#" }))
                                                    .Create(create => create.Action("Signatures_CreateAdmin", "UserProfile"))
                                                    .Update(update => update.Action("Signatures_UpdateAdmin", "UserProfile"))
                                                    .Destroy(des => des.Action("Signatures_Destroy", "UserProfile"))
                                               ).ToClientTemplate())


}

<script>
    function MakeDefault(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.Id;

        $.ajax({
            type: "POST",
            url: '@Url.Action("MakeDefault", "UserProfile")',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    };

    function MakeBizDefault(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.UserBusinessUnitMapId;

        $.ajax({
            type: "POST",
            url: '@Url.Action("MakeBizDefault", "UserProfile")',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    };
    function OnDrawSignature() {
        var uid = $(".k-edit-form-container").closest("[data-role=window]").data("uid");
        model = $("#Signature").data("kendoGrid").dataSource.getByUid(uid);
        model.set("Sign", $("#hidden").val());
        console.log(model.Sign);

    }
    function onSuccess() {

        //var uid = $(".k-edit-form-container").closest("[data-role=window]").data("uid");
        //model = $("#Signature" + codeid).data("kendoGrid").dataSource.getByUid(uid);
        //model.set("TrId", codeid);
        masterGrid = $("#Signature").data("kendoGrid").dataSource.read();

        var windowCont = $('.k-popup-edit-form.k-window-content');
        return;

        //if it was first click on kendo grid edit button exit function
        //otherwise popup window will be closed immidiatelly

    }
</script>

