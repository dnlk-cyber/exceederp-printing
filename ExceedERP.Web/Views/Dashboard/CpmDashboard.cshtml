    let costOverrunChart = null;

    function initializeCostOverrunProjectSelector() {
        const $ddl = $("#projectSelector");

        if ($ddl.data("kendoDropDownList")) return; // prevent multiple init

        $ddl.kendoDropDownList({
            optionLabel: "Select Project...",
            dataTextField: "name",
            dataValueField: "id",
            dataSource: {
                transport: {
                    read: {
                        url: '/Dashboard/GetAllProjects', // Your endpoint to get projects
                        dataType: "json"
                    }
                }
            },
            change: function () {
                const selectedProjectId = this.value();
                if (selectedProjectId) {
                    loadCostOverrun(selectedProjectId);
                } else {
                    clearCostOverrunChart("Please select a project to view the cost overrun chart.");
                }
            }
        });
    }

    function loadCostOverrun(projectId) {
        $.get('/Dashboard/GetCostOverrunByProject', { projectId: projectId }, function (data) {
            if (data) {
                renderCostOverrunChart(
                    [data.ProjectName],
                    [data.PlannedCost],
                    [data.ActualCost],
                    [data.CostOverRunPercent]
                );
            } else {
                clearCostOverrunChart("No data found for this project.");
            }
        });
    }

    function renderCostOverrunChart(projectNames, plannedCosts, actualCosts, costOverrunPercents) {
        const container = $("#CostOverrunChart").parent();
        container.find("#CostOverrunChart").remove(); // remove old canvas
        container.append(`<canvas id="CostOverrunChart"></canvas>`);

        const ctx = document.getElementById("CostOverrunChart").getContext('2d');

        if (costOverrunChart) {
            costOverrunChart.destroy();
        }

        costOverrunChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: projectNames,
                datasets: [
                    {
                        type: 'bar',
                        label: 'Planned Cost (ETB)',
                        data: plannedCosts,
                        backgroundColor: 'rgba(40, 167, 69, 0.6)',
                        borderColor: 'rgba(40, 167, 69, 1)',
                        yAxisID: 'y'
                    },
                    {
                        type: 'bar',
                        label: 'Actual Cost (ETB)',
                        data: actualCosts,
                        backgroundColor: 'rgba(227, 124, 134, 0.6)',
                        borderColor: 'rgba(227, 124, 134, 0.6)',
                        yAxisID: 'y'
                    },
                    {
                        type: 'line',
                        label: 'Cost Overrun (%)',
                        data: costOverrunPercents,
                        borderColor: '#2196F3',
                        backgroundColor: '#2196F3',
                        yAxisID: 'y1',
                        tension: 0.4,
                        pointRadius: 4,
                        fill: false
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: { position: 'top' },
                    title: {
                        display: true,
                        text: 'Planned vs Actual Cost with Cost Overrun %'
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                if (context.dataset.type === 'line') {
                                    return `${context.dataset.label}: ${context.raw.toFixed(2)}%`;
                                }
                                return `${context.dataset.label}: ${context.raw.toLocaleString()} ETB`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        type: 'linear',
                        position: 'left',
                        title: { display: true, text: 'Cost (ETB)' }
                    },
                    y1: {
                        type: 'linear',
                        position: 'right',
                        grid: { drawOnChartArea: false },
                        title: { display: true, text: 'Cost Overrun (%)' },
                        ticks: {
                            callback: function (value) {
                                return value + '%';
                            }
                        }
                    }
                }
            }
        });
    }

    function clearCostOverrunChart(message) {
        if (costOverrunChart) {
            costOverrunChart.destroy();
            costOverrunChart = null;
        }

        const container = $("#CostOverrunChart").parent();
        $("#CostOverrunChart").remove();

        container.append(`
      <div id="CostOverrunChart" class="text-center text-muted pt-4">
        ${message}
      </div>
    `);
    }

