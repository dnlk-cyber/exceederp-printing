    /// FOR GUNTCHART
    function initGanttProjectSelector() {
        $("#ganttProjectSelector").kendoDropDownList({
            optionLabel: "Select Project...",
            dataTextField: "name",
            dataValueField: "id",
            filter: "contains",
            dataSource: {
                transport: {
                    read: {
                        url: "/Dashboard/GetProjects",
                        dataType: "json"
                    }
                }
            },
            change: function () {
                const projectId = this.value();
                if (projectId) {
                    loadFrappeGanttChart(projectId);
                } else {
                    $("#ganttChartContainer").html("<p>Please select a project to view on Gantt chart.</p>");
                }
            }
        });
    }

    function loadFrappeGanttChart(projectId) {
        $.ajax({
            url: "/Dashboard/GetProjectActivities",
            data: { projectId },
            dataType: "json",
            success: function (data) {
                if (!data || data.length === 0) {
                    $("#ganttChartContainer").html("<p>No activities found for this project.</p>");
                    return;
                }

                const tasks = data.map(item => ({
                    id: item.id.toString(),
                    name: item.title,
                    start: item.start,
                    end: item.end,
                    progress: item.percentComplete * 100,
                    dependencies: item.parentId ? item.parentId.toString() : ""
                }));

                $("#ganttChartContainer").empty().append('<svg id="frappeGantt"></svg>');
                new Gantt("#frappeGantt", tasks, {
                    view_mode: 'Month',
                    custom_popup_html: function (task) {
                        return `
                        <div class="details-container p-2">
                            <h5>${task.name}</h5>
                            <p><strong>Progress:</strong> ${task.progress}%</p>
                            <p><strong>Start:</strong> ${task.start}</p>
                            <p><strong>End:</strong> ${task.end}</p>
                        </div>
                    `;
                    }
                });
            },
            error: function () {
                $("#ganttChartContainer").html("<p>Error loading Gantt chart data.</p>");
            }
        });
    }

    // Initialize after DOM is fully loaded
    window.addEventListener("DOMContentLoaded", function () {
        initGanttProjectSelector();
    });


