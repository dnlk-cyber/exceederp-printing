@using ExceedERP.Web.Controllers

@{
    ViewBag.Title = "CpmDashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/dashboard.css" rel="stylesheet" />
<link href="~/Scripts/styles/frappe-gantt.css" rel="stylesheet" />


<div class="row">
    <div class="col-md-4">
        <div class="box box-solid card-box">
            <div class="box-header with-border">
                <h6 class="box-title">Project Status</h6>
            </div>

            <div class="box-body" style="height: 400px;">
                <canvas id="TotalProjects" style="height: 100% !important; width: 100% !important;"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="box box-solid card-box">
            <div class="box-header with-border">
                <h6 class="box-title">Active Project Category (SD and CAS)  </h6>
            </div>

            <div class="box-body" style="height: 400px;">
                <canvas id="ProjectCategoryId" style="height: 100% !important; width: 100% !important;"></canvas>
            </div>
        </div>
    </div>
    <!-- Chart 3: Project Category by Business Unit -->
    <div class="col-md-4">
        <div class="box box-solid card-box">
            <div class="box-header with-border">
                <h6 class="box-title">Planned and Unplanned Projects</h6>
            </div>
            <div class="box-body" style="height: 400px;">
                <canvas id="PlanedandunplanedId" style="height: 100% !important; width: 100% !important;"></canvas>
            </div>
        </div>
    </div>

</div>
<div class="row">
