<script src="~/Scripts/Chart.bundle.js"></script>
<script src="~/Scripts/Chart.PieceLabel.js"></script>
<script src="~/Scripts/chart.umd.js"></script>
<script src="~/scripts/frappe-gantt.min.js"></script>


<script>
    const vibrantColors = [
        'rgba(255, 99, 132)',   // Red
        'rgba(54, 162, 235)',   // Blue
        'rgba(255, 206, 86)',   // Yellow
        'rgba(75, 192, 192)',   // Green
        'rgba(153, 102, 255)',  // Purple
        'rgba(255, 159, 64)',   // Orange
        'rgba(255, 99, 71)',    // Tomato
        'rgba(124, 252, 0)',    // Lawn Green
        'rgba(0, 255, 255)',    // Cyan
        'rgba(255, 20, 147)',   // Deep Pink
        'rgba(138, 43, 226)',   // Blue Violet
        'rgba(244, 164, 96)',   // Sandy Brown
        'rgba(0, 128, 128)',    // Teal
        'rgba(220, 20, 60)',    // Crimson
        'rgba(255, 140, 0)',    // Dark Orange
        'rgba(75, 0, 130)',     // Indigo
        'rgba(60, 179, 113)',   // Medium Sea Green
        'rgba(0, 191, 255)',    // Deep Sky Blue
        'rgba(218, 112, 214)',  // Orchid
        'rgba(210, 105, 30)'    // Chocolate bv
    ];
    const vibrantBorderColors = [
        'rgba(255, 99, 132, 1)',
        'rgba(54, 162, 235, 1)',
        'rgba(255, 206, 86, 1)',
        'rgba(75, 192, 192, 1)',
        'rgba(153, 102, 255, 1)',
        'rgba(255, 159, 64, 1)',
        'rgba(255, 99, 71, 1)',
        'rgba(124, 252, 0, 1)',
        'rgba(0, 255, 255, 1)',
        'rgba(255, 20, 147, 1)',
        'rgba(138, 43, 226, 1)',
        'rgba(244, 164, 96, 1)',
        'rgba(0, 128, 128, 1)',
        'rgba(220, 20, 60, 1)',
        'rgba(255, 140, 0, 1)',
        'rgba(75, 0, 130, 1)',
        'rgba(60, 179, 113, 1)',
        'rgba(0, 191, 255, 1)',
        'rgba(218, 112, 214, 1)',
        'rgba(210, 105, 30, 1)'
    ];
    window.chartColors = {
        red: 'rgb(255, 99, 132)',
        orange: 'rgb(255, 159, 64)',
        yellow: 'rgb(255, 205, 86)',
        green: 'rgb(75, 192, 192)',

        blue: 'rgb(54, 162, 235)',
        purple: 'rgb(153, 102, 255)',
        grey: 'rgb(201, 203, 207)',
        fuchsia: 'rgb(255, 0, 255)'
    };
    CountProjects();
    ProjectCategory();
    projectCategoryBU();
    loadPlannedUnplannedProjects();
    BUExecutionRevenue();
    PlanRevenuevsActualRevenue();
    ProjectDelay();
    ProjectTimeline();
    GetBUPlanRevenueByMonth();
    Top10PlannedRevenueProjects();
    DisplayTotalPlannedRevenue();
    //GanttChart();
    ExternalAndInter();
    LabInternalExternalProjects();
    ProjectCountByBU();
    initGanttProjectSelector();

function CountProjects() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("CountProjects", "Dashboard", new {area = ""})',
        success: function (result) {
            //render
            var ctx = document.getElementById("TotalProjects").getContext('2d');
            ctx.height = 500;
            var myChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: 'Project Status',
                        data: result.Data,
                        backgroundColor: vibrantColors,
                        borderColor: vibrantBorderColors,
                        borderWidth: 0.2
                    }]
                },
                options: {
                    responsive: true,
                    title: {
                        display: true,
                        text: ['Project Status']
                    },
                    gridLines: {
                        display: false
                    },
                    pieceLabel: {
                        render: 'value',
                        fontColor: ['white', 'white', 'white', 'white', 'white'],
                        precision: 2
                    },
                    legend: {
                        position: 'bottom',
                        fontSize: 8,
                        fullWidth: true,
                        padding: 6,
                        labels: {
                            boxWidth:15
                        }
                    }


                }
            });

        }, //end succ
        error: function (result) {
            alert(result);
        }
        });
    }

   function ProjectCategory(){
    $.ajax({
        type: "GET",
        url: '@Url.Action("GetProjectCategory", "Dashboard", new {area = ""})',
        success: function (result) {

            var ctx = document.getElementById("ProjectCategoryId").getContext('2d');
            ctx.height = 600;
            var colors = ['#00bcd4', '#ff9800', '#4caf50'];
            var myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: result.Labels,  // SD, CAS, Total
                    datasets: [{
                        label: ' SD and CAS Project Category',
                        data: result.Data,
                        backgroundColor: colors,
                        //borderColor: '#000000',
                        borderWidth: 0.2
                    }]
                },
                options: {
                    responsive: true,
                    title: {
                        display: true,
                        text: "Project Category (SD and CAS)"
                    },
                    gridLines: {
                        display: false
                    },
                    pieceLabel: {
                        render: 'value',
                        fontColor: ['green', 'Teal', 'Teal', 'Teal'],
                        precision: 2
                    },
                    legend: {
                        display: false
                    },
                    scales: {
                        xAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString:''
                            },
                            //barPercentage: 0.4,
                            //ticks: {
                            //    min: 0  // Ensure X-axis starts at 0
                            //}
                        }],
                        yAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'Number of Projects'
                            },
                            barPercentage: 0.4,
                            ticks: {
                                min: 0  // Ensure Y-axis starts at 0
                            }
                        }]
                    },
                    maintainAspectRatio: false,
                }
            });
        },
        error: function (result) {
            alert(result);
        }
    });
        }
function projectCategoryBU() {
    $.ajax({
        type: "GET",
        url: '@Url.Action("GetprojectCategoryBU", "Dashboard", new { area = "" })',
        success: function (result) {
            var ctx = document.getElementById("ProjectCategoryBu").getContext('2d');
            ctx.height = 300; // Adjust the height of the chart

            var myChart = new Chart(ctx, {
                type: 'bar', // vertical bar chart
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: 'List of Projects Under Each Business',
                        data: result.Data,
                        backgroundColor: vibrantColors,
                        borderColor: vibrantBorderColors,
                        borderWidth: 0.2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false, // Prevents fixed aspect ratio
                    plugins: {
                        title: {
                            display: true,
                            //text: " Title:-List of Projects Under each Business Unit",
                            // font: {
                            //    size: 15,
                            //    weight: 'bold'
                            //},
                        },
                        legend: {
                            display: false
                        },
                        tooltip: {
                            mode: 'index',
                            intersect: false
                        }
                    },
                    scales: {
                        x: {
                            stacked: true,
                            title: {
                                display: true,
                                text: 'Business Units'
                            },
                            grid: {
                                display: false
                            },
                            ticks: {
                                autoSkip: false,
                                maxRotation: 0 // This prevents label overlap
                            },
                            barPercentage: 0.5, // Reduce width of bars
                            categoryPercentage: 0.6 // Adjust space between bars
                        },
                        y: {
                            stacked: true, // Ensure bars are stacked on y-axis
                            title: {
                                display: true,
                                text: 'Number of Projects'
                            },
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        },
        error: function (result) {
            alert("Failed to load project data.");
        }
    });
        }

  function loadPlannedUnplannedProjects() {
    $.ajax({
        type: "GET",
        url: '@Url.Action("GetPlannedandUnplannedProjects", "Dashboard")',
        success: function (result) {
            var ctx = document.getElementById("PlanedandunplanedId").getContext('2d');
            var colors = ['#00bcd4', '#ff9800', '#4caf50'];
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Planned Projects', 'Unplanned Projects'],
                    datasets: [{
                        data: [result.PlannedProjects, result.UnplannedProjects],
                        backgroundColor: colors,
                        borderColor: colors,//vibrantBorderColors,

                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            //text: 'Planned and Unplanned Projects'
                        },
                        tooltip: {
                            callbacks: {
                                label: function (tooltipItem) {
                                    var value = tooltipItem.raw;
                                    return tooltipItem.label + ': ' + value + ' Projects';
                                }
                            }
                        }
                    }
                }
            });
        },
        error: function () {
            alert("Failed to load project data.");
        }
    });
        }
function BUExecutionRevenue() {
    $.ajax({
        type: "GET",
        url: '@Url.Action("GetUpperandLowerBUExcution", "Dashboard")',
        success: function (result) {
            var ctx = document.getElementById("LowerandupperExcuBuId").getContext('2d');

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: result.Labels,
                    datasets: [
                        {
                            label: 'High Performer Division',
                            data: result.UpperBUData,
                            backgroundColor: 'rgba(0, 123, 255, 0.6)',
                            borderColor: 'rgba(0, 123, 255, 1)',
                            borderWidth: 1
                        },
                        {
                            label: 'Low Performer Division',
                            data: result.LowerBUData,
                            backgroundColor: 'rgba(220, 53, 69, 0.6)',
                            borderColor: 'rgba(220, 53, 69, 1)',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        tooltip: {
                            enabled: true
                        },
                        title: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Execution Amount'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Business Units'
                            }
                        }
                    }
                }
            });
        },
        error: function () {
            alert("Failed to load chart.");
        }
    });
}


function PlanRevenuevsActualRevenue() {
    $.ajax({
        type: "GET",
        url: '@Url.Action("GetPlanRevenuevsActualRevenue", "Dashboard", new { area = "" })',
        success: function (result) {
            console.log(result); // Debug
            const labels = result.Data.map(item => item.Category);
            const plannedData = result.Data.map(item => item.Planned);
            const executedData = result.Data.map(item => item.Executed);
            const ctx = document.getElementById("projectId").getContext("2d");
            new Chart(ctx, {
                type: 'bar', // Vertical is default
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: "Planned",
                            data: plannedData,
                            backgroundColor: '#0077be', // light green
                            borderColor: '#0077be',
                            borderWidth: 1
                        },
                        {
                            label: "Executed",
                            data: executedData,
                            backgroundColor: '#006400', // light blue
                            borderColor: '#006400',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            // text: 'Planned vs Executed Revenue per Project'
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Revenue (ETB)'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Business Unit'
                            }
                        }
                    }
                }
            });
        },
        error: function (error) {
            console.error("Error fetching chart data", error);
        }
    });
}

    function ProjectDelay(){
    $.ajax({
        type: "GET",
        url: '@Url.Action("GetProjectDelay", "Dashboard", new { area = "" })',
        success: function (result) {
            var canvas = document.getElementById("ProjectDelayId");
            if (!canvas) {
                console.error("Canvas element ProjectDelayId not found!");
                return;
            }
            var ctx = canvas.getContext('2d');
            ctx.height = 300;

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: 'Actual Project Progress in % Is',
                        data: result.Data,
                        backgroundColor: vibrantColors,
                        borderColor: vibrantBorderColors,
                        borderWidth: 0.5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            //text: "Top Delayed Projects"
                        },
                        legend: {
                            display: false
                        },
                        tooltip: {
                            mode: 'index',
                            intersect: false
                        }
                    },
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: 'Project Names'
                            },
                            ticks: {
                                autoSkip: false,
                                maxRotation: 45,
                                minRotation: 20
                            },
                            grid: {
                                display: false
                            },
                            barPercentage: 0.5,
                            categoryPercentage: 0.6
                        },
                        y: {
                            title: {
                                display: true,
                                text: 'Progress (%)'
                            },
                            ticks: {
                                beginAtZero: true
                            },
                            grid: {
                                display: true
                            }
                        }
                    }
                }
            });
        },
        error: function () {
            alert("Failed to load delayed project data.");
        }
    });
}

function ProjectTimeline() {
    $.ajax({
        type: "GET",
        url: '@Url.Action("GetProjectsNearToCompletion", "Dashboard", new { area = "" })',
        success: function (result) {
            var ctx = document.getElementById("ProjectTimelineNearTocomplation").getContext('2d');

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: result.Labels, // Project names
                    datasets: [{
                        label: 'Project Completion Progress (%)',
                        data: result.Data, // Progress percentages
                        backgroundColor: result.Data.map(progress =>
                            progress < 50 ? '#f8d7da' : '#28a745' // Red if <50%, Green if >=50%
                        ),
                        borderColor: '#333',
                        borderWidth: 0.2,
                        barThickness: 20
                    }]
                },
                options: {
                    // indexAxis: 'y', // REMOVE or COMMENT this line for vertical bars
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            padding: {
                                top: 10,
                                bottom: 10
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `Progress: ${context.raw}%`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            title: {
                                display: true,
                                text: 'Progress (%)'
                            }
                        },
