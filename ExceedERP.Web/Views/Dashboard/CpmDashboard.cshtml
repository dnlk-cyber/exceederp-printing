                                        <div style="background:#4caf50; width: ${percent}%; height: 100%; border-radius: 3px;"></div>
                                        <span style="position: relative; left: -50%; color: white; font-weight: bold;">${percent}%</span>
                                    </div>`;
                        },
                        width: 130
                    }
                ],
                height: 600,
                views: ["month"],
                showWorkHours: false,
                showWorkDays: false,
                snap: false,
                resizable: true,
                selectable: true
            });
        },
