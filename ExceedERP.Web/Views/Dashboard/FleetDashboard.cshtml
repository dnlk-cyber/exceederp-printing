@using ExceedERP.Web.Controllers
@{
    ViewBag.Title = "FleetDashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/dashboard.css" rel="stylesheet" />

@(Html.Kendo().DropDownList()
     .Name("BranchCode")
     .ValuePrimitive(true)
     .AutoBind(false)
     .HtmlAttributes(new { style = "width:450px" })
     .OptionLabel("Select Branch or project...") // Acts as the "null" value
     .DataTextField("Text")
     .DataValueField("Value")
     .Filter("contains")
     .Events(e =>
     {
         e.Change("onSelectBranch");
     })
     .DataSource(dataSource =>
     {
         dataSource.Read(read => read.Action("GetBranchForDashBoard", "MaintenanceDataProvider", new { area = "Maintenance" }))
                   .ServerFiltering(false);
     })
)
<div class="row">
    <div class="col-sm-7 col-lg-4">

        <div class="demo-section k-content wide">
            <canvas id="countFleetByOwnership" width="400" height="400"></canvas>
        </div>


    </div>
    <div class="col-sm-7 col-lg-4">

        <div class="demo-section k-content wide">
            <canvas id="ownEquipmentByCategory" width="400" height="400"></canvas>
