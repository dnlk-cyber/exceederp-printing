            var ctx = document.getElementById("machinary").getContext('2d');
            ctx.height = 600;
            
            var myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Operational', 'Idle', 'Down'],
                    datasets: [{
                        data: [result.OperationalHour, result.IdleHour, result.DownHour ],
                        backgroundColor: vibrantColors,
                        borderColor: vibrantBorderColors,
                        borderWidth: 3
