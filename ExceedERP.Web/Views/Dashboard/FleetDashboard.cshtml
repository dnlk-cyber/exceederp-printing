    function countFleetByOwnership() {
        var branch = "";
        if ($("#BranchCode").data("kendoDropDownList") != null)
            branch = $("#BranchCode").data("kendoDropDownList").value();
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetFleetOwnershipCount", "Dashboard", new {area = ""})',
            data: { branch: branch },
            success: function (result) {
                //render
                var ctx = document.getElementById("countFleetByOwnership").getContext('2d');
                ctx.height = 600;

                if (myChart1) {
                    myChart1.destroy();
                }
                myChart1 = new Chart(ctx, {
                    type: 'pie',
                    data: {
                        labels: result.Labels,
                        datasets: [{
                            label: 'Fleet Own vs Rental',
                            data: result.Data,
                            backgroundColor: [
                                window.chartColors.green,
                                window.chartColors.blue,
                                window.chartColors.red,
                                window.chartColors.fuchsia
                            ],

                            borderWidth: 3
                        }]
                    },


                    options: {

                        title: {
