    function countFleetByOwnership() {

         $.ajax({
            type: "GET",
            url: '@Url.Action("GetFleetOwnershipCount", "Dashboard", new {area = ""})',
        success: function (result) {
            //render
            var ctx = document.getElementById("countFleetByOwnership").getContext('2d');
            ctx.height = 600;
            var myChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: 'Fleet Own vs Rental',
                        data: result.Data,
                        backgroundColor: [
                            window.chartColors.green,
                            window.chartColors.blue,
                            window.chartColors.red,
                            window.chartColors.fuchsia
                        ],

                        borderWidth: 3
                    }]
                },


                options: {

                    title: {
                        display: true,
                        text: ['Fleet Own vs Rental']
                    },
                    gridLines: {
                        display: false
                    },
                    pieceLabel: {
                        render: 'value',
                        fontColor: ['green', 'white', 'black'],
                        precision: 2
                    },
                    legend: {
                        position: 'bottom',
                        fontSize: 8,
                        fullWidth: true,
                        padding: 6,
                        labels: {
                            boxWidth:15
                        }
                    }


                }
            });

        }, //end succ
        error: function (result) {
            alert(result);
        }
        });
    }


    function ownEquipmentByCategory() {
    $.ajax({
        type: "GET",
        url: '@Url.Action("GetOwnEquipmentByCategoryData", "Dashboard", new { area = "" })',
        success: function (result) {
            // Render chart
            var ctx = document.getElementById("ownEquipmentByCategory").getContext('2d');
            ctx.height = 600;
            
            var myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        data: result.Data,
                        backgroundColor: vibrantColors,
                        borderColor: vibrantBorderColors,
                        borderWidth: 3
                    }]
                },
                options: {
                    title: {
                        display: true,
                        text: "Internal Fleet by Category"
                    },
                    gridLines: {
                        display: false
                    },
                    pieceLabel: {
                        render: 'value',
                        fontColor: ['green', 'white', 'red', "yellow"],
                        precision: 2
                    },
                    legend: {
                        display: false
                    },
                    scales: {
                        xAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'Equipment Type'
                            },
                            ticks: {
                                beginAtZero: true // Start x-axis from 0
                            },
                            barPercentage: 0.4
                        }],
                        yAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'Number of Equipments'
                            },
                            ticks: {
                                beginAtZero: true // Start y-axis from 0
                            },
                            barPercentage: 0.4
                        }]
                    }
                }
            });

        }, //end success
        error: function (result) {
            alert(result);
        }
    });
}


