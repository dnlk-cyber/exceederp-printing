@using ExceedERP.Web.Controllers
@model DashboardViewModel
<style>
	.row{
		margin-top:30px;
		padding: 0 10px;
	}

	.clickable{
		cursor: pointer;   
	}

	.panel-heading span {
		margin-top: -20px;
		font-size: 15px;
	}
</style>

<div class="panel panel-info">
	<div class="panel-heading">
		<h3 class="panel-title">Notifications</h3>
		<span class="pull-right clickable"><i class="glyphicon glyphicon-chevron-up"></i></span>
	</div>
	<div class="panel-body">
		<div class="row">
			<table class="table table-striped table-bordered table-hover">
				<tr>
					<th>
						Time
					</th>
					<th>
						Deadline
					</th>
					<th>
						Description
					</th>
					<th></th>
				</tr>
				@foreach (var item in Model.NotificationList)
				{
					<tr>
						<td>
							@Html.DisplayFor(modelItem => item.AlarmGeneratedTime)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.DeadLine)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.Description)
						</td>
						<td>
							@*@Html.ActionLink("Edit", "Edit", new { id = item.RoleName }) |
								@Html.ActionLink("Delete", "Delete", new { id = item.RoleName })*@
						</td>
					</tr>
				}
			</table>
		</div>

	</div>
</div>



@if (HttpContext.Current.User.IsInRole("HR_Report"))
{
	<div class="panel panel-info">
		<div class="panel-heading">
			<h3 class="panel-title">Human Resource</h3>
			<span class="pull-right clickable"><i class="glyphicon glyphicon-chevron-up"></i></span>
		</div>
		<div class="panel-body">
			<div class="row">
				<div class="col-sm-8 col-lg-4">

					<div class="demo-section k-content wide">
						@(Html.Kendo().Chart<DashboardViewModel>()
							  .Name("chart3")
							  .Title("Head Count")
							  .Legend(legend => legend
								  .Position(ChartLegendPosition.Top)
							  )

							  .Series(series =>
							  {
								  foreach (var def in Model.HrSeries)
								  {
									  series.Bar(def.Data).Name(def.Name);
								  }
							  })
							  .CategoryAxis(axis => axis
								  .Categories(Model.HrCategories)
							  )

							  .ValueAxis(axis => axis.Numeric()
								  .Labels(labels => labels.Format("{0:N0}"))
								  .MajorUnit(50)
							  )
							  .Tooltip(tooltip => tooltip
								  .Visible(true)
								  .Shared(true)
								  .Format("{0:N0}")
							  )
							  )
					</div>


				</div>
				<div class="col-sm-8 col-lg-4">


