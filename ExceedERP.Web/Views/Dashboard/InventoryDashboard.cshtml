@using ExceedERP.Web.Controllers

@{
    ViewBag.Title = "Inventory Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/dashboard.css" rel="stylesheet" />


    <a style="align-content:center;color:white" onclick='return refreshData()' href='#' title="Refresh Data"><i class="fa fa-refresh fa-2x"></i></a>



    <div class="dashboard">
        <div class="row">
            <div class="col-sm-8 col-lg-12 chartcontainer">
                @(Html.Kendo().DropDownList()
                              .Name("StoreCode")
                              .ValuePrimitive(true)
                              .AutoBind(false)
                              .HtmlAttributes(new { style = "width:450px" })
                              .OptionLabel("All Stores")
                              .DataTextField("Name")
                              .DataValueField("StoreCode")
                              .Filter("contains")
                              .Events(e =>
                              {
                                  e.Change("onSelectType");
                              })
                              .DataSource(dataSource =>
                              {
                                  dataSource.Read(read => read.Action("GetAllStores", "DataProvider", new { area = "Inventory" }));
                              })

                     )
                <div class="demo-section k-content wide">

                    <canvas id="itembalances" width="400" height="400"></canvas>
                </div>


            </div>
        </div>
        <div class="row">

            <div class="col-sm-7 col-lg-3 chartcontainer">

                <div class="demo-section k-content wide">
                    <canvas id="srStatus" width="400" height="400" class="chartarea"></canvas>
                </div>


            </div>
            <div class="col-sm-7 col-lg-3 chartcontainer">

                <div class="demo-section k-content wide">
                    <canvas id="issueStatus" width="400" height="400"></canvas>
                </div>


            </div>
            <div class="col-sm-7 col-lg-3 chartcontainer">

                <div class="demo-section k-content wide">
                    <canvas id="itransferSendStatus" width="400" height="400"></canvas>
                </div>


            </div>
            <div class="col-sm-7 col-lg-3 chartcontainer">

                <div class="demo-section k-content wide">
                    <canvas id="itransferReceiveStatus" width="400" height="400"></canvas>
                </div>


            </div>
        </div>
        <div class="row">
            <div class="col-sm-7 col-lg-3 chartcontainer">

                <div class="demo-section k-content wide">
                    <canvas id="storeReturnStatus" width="400" height="400"></canvas>
                </div>


            </div>
            <div class="col-sm-7 col-lg-3 chartcontainer">

                <div class="demo-section k-content wide">
                    <canvas id="grnStatus" width="400" height="400"></canvas>
                </div>


            </div>
            <div class="col-sm-7 col-lg-3 chartcontainer">

                <div class="demo-section k-content wide">
                    <canvas id="inventory" width="400" height="400"></canvas>
                </div>


            </div>
            <div class="col-sm-7 col-lg-3 chartcontainer">

