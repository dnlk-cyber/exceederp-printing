<script src="~/Scripts/Chart.bundle.js"></script>
<script src="~/Scripts/Chart.PieceLabel.js"></script>
<script>

    window.chartColors = {
        red: 'rgb(255, 99, 132)',
        orange: 'rgb(255, 159, 64)',
        yellow: 'rgb(255, 205, 86)',
        green: 'rgb(75, 192, 192)',
        blue: 'rgb(54, 162, 235)',
        purple: 'rgb(153, 102, 255)',
        grey: 'rgb(201, 203, 207)'
    };

    inventory();
    inventoryvalue();


    storerequisition();
    issue();
    transferSend();
    transferReceive();
    grn();
    storeReturnStatus();
    itembalance();


    function onSelectType(e) {
        itembalance();
    }
    function itembalance() {
        var store = "";

        if( $("#StoreCode").data("kendoDropDownList")!=null)
            store = $("#StoreCode").data("kendoDropDownList").value();

        $.ajax({
            type: "GET",
            url: '@Url.Action("GetItemBalances", "Dashboard", new {area = ""})',
            data: { store: store },
            success: function (result) {
            //render
            var ctx = document.getElementById("itembalances").getContext('2d');
            ctx.height = 600;
            var myChart = new Chart(ctx, {
                type: 'horizontalBar',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: 'Item Balance',
                        data: result.Data,
                        backgroundColor: [
                            window.chartColors.red,
                            window.chartColors.orange,
                            window.chartColors.blue,
                            window.chartColors.green,
                            window.chartColors.yellow
                        ],
                        borderColor: [
                            window.chartColors.red,
                            window.chartColors.orange,
                            window.chartColors.blue,
                            window.chartColors.green,
                            window.chartColors.yellow
                        ],
                        borderWidth: 1
                    }]
                },


                options: {

                    title: {
                        display: true,
                        text: 'Item Balance'
                    },
                    gridLines: {
                        display: false
                    },
                    pieceLabel: {
                        render: 'value',
                        fontColor: ['green', 'white', 'red'],
                        precision: 2
                    },
                    legend: {
                        display:false
                    },
                    scales: {
                        yAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'Items'
                            },
                            barPercentage: 0.4
                        }],
                        xAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'Balance'
                            },
                            ticks: {

                                // forces step size to be 5 units
                                stepSize: 1000
                            }
                        }]
                    },
                    maintainAspectRatio: false

                }
            });

        }, //end succ
        error: function (result) {
            alert(result);
        }
        });
    }

     function inventoryvalue() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetInventoryValue", "Dashboard", new {area = ""})',
        success: function (result) {
            //render
            var ctx = document.getElementById("inventoryValue").getContext('2d');
            var myChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: 'Inventory Value (Birr)',
                        data: result.Data,
                        backgroundColor: [
                            window.chartColors.orange,
                            window.chartColors.orange,
                            window.chartColors.blue,
                            window.chartColors.red,
                            window.chartColors.yellow
                        ],
                        borderColor: [
                            window.chartColors.yellow,
                            window.chartColors.orange,
                            window.chartColors.blue,
                            window.chartColors.red,
                            window.chartColors.yellow
                        ],
                        borderWidth: 1
                    }]
                },


                options: {

                    title: {
                        display: true,
                        text: 'Inventory Value (Birr)'
                    },
                    gridLines: {
                        display: false
                    },
                    pieceLabel: {
                        render: function (args) {
                            return args.value;
                        },
                        fontColor: ['green', 'white', 'red'],
                        precision: 2
                    },
                    legend: {
                        position: 'bottom',
                        fontSize: 8,
                        fullWidth: true,
                        padding: 6,
                        labels: {
                            boxWidth:15
                        }
                    }


                }
            });

        }, //end succ
        error: function (result) {
            alert(result);
        }
        });
    }

    function inventory() {
        $.ajax({
