                        fullWidth: true,
                        padding: 6,
                        labels: {
                            boxWidth:15
                        }
                    },
                    hover: {
                        mode: 'nearest',
                        intersect: true
                    }

                }
            });

        }, //end succ
        error: function (result) {
            alert(result);
        }
        });
    }

