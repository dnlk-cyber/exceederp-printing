    function CountEmployee() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetEmployeeCount", "Dashboard", new {area = ""})',
        success: function (result) {
            //render
            var ctx = document.getElementById("employeeCount").getContext('2d');
            ctx.height = 600;
            var myChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: 'Employee Count',
                        data: result.Data,
                        backgroundColor: [
                            window.chartColors.green,
                            window.chartColors.blue,
                            window.chartColors.red,
                            window.chartColors.fuchsia
                        ],
                        //borderColor: [
                        //    window.chartColors.red,
                        //    window.chartColors.orange,
                        //    window.chartColors.yellow,
                        //    window.chartColors.green,
                        //    window.chartColors.blue
                        //],
                        borderWidth: 3
                    }]
                },


                options: {

                    title: {
                        display: true,
                        text: ['Employee Count']
                    },
                    gridLines: {
                        display: false
                    },
                    pieceLabel: {
                        render: 'value',
                        fontColor: ['green', 'white', 'black'],
                        precision: 2
                    },
                    legend: {
                        position: 'bottom',
                        fontSize: 8,
                        fullWidth: true,
                        padding: 6,
                        labels: {
                            boxWidth:15
                        }
                    }


                }
            });

        }, //end succ
        error: function (result) {
            alert(result);
        }
        });
    }




    function PermanentEmployee() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetPermanentEmployee", "Dashboard", new {area = ""})',
        success: function (result) {
            //render
            var ctx = document.getElementById("permanentEmployee").getContext('2d');
            ctx.height = 600;
            var myChart = new Chart(ctx, {
                type: 'horizontalBar',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: "Permanent Employee ",
                        data: result.Data,
                        backgroundColor: [
                            window.chartColors.red,
                            window.chartColors.orange,
                            window.chartColors.blue,
                            window.chartColors.green,
                            window.chartColors.yellow
                        ],
                        borderColor: [
                            window.chartColors.red,
                            window.chartColors.orange,
                            window.chartColors.blue,
                            window.chartColors.green,
                            window.chartColors.yellow
                        ],
                        borderWidth: 3
                    }]
                },


                options: {
                    scales: {
                        x: {
                            beginAtZero: true
                        }
                    },

                    title: {
                        display: true,
                        text: "Permanent Employee "
                    },
                    gridLines: {
                        display: false
                    },
                    pieceLabel: {
                        render: 'value',
                        fontColor: ['green', 'white', 'red', "yellow"],
                        precision: 2
                    },
                    legend: {
                        position: 'bottom',
                        fontSize: 8,
                        fullWidth: true,
                        padding: 6,
                        labels: {
                            boxWidth:15
                        }
                    },
                    scales: {
                        xAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'Number of Employee'
                            },
                            barPercentage: 0.4,

                            
                        }],
                        yAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'Employement Type'
                            },
                            barPercentage: 0.4
                        }]
                    }


                }
            });

        }, //end succ
        error: function (result) {
            alert(result);
        }
        });
    }

