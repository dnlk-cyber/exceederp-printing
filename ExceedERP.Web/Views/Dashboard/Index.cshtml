@using ExceedERP.Web.Controllers
@model DashboardViewModel
<link href="~/Content/kendo/2016.1.112/kendo.fiori.min.css" rel="stylesheet" />
<style>
    .row {
        margin-top: 1px;
        padding: 0 1px;
    }

    .clickable {
        cursor: pointer;
    }

    .panel-heading span {
        margin-top: -5px;
        font-size: 12px;
    }
</style>


<div class="panel panel-info">
    <div class="panel-heading">
        <h3 class="panel-title">Notifications</h3>
        <span class="pull-right clickable"><i class="glyphicon glyphicon-chevron-up"></i></span>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="demo-section k-content wide">
                <table class="table table-striped table-hover">
                    <tr>
                        <th>
                            Time
                        </th>
                        <th>
                            Deadline
                        </th>
                        <th>
                            Description
                        </th>
                        <th></th>
                    </tr>
                    @foreach (var item in Model.NotificationList)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.AlarmGeneratedTime)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DeadLine)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                @*@Html.ActionLink("Edit", "Edit", new { id = item.RoleName }) |
                                @Html.ActionLink("Delete", "Delete", new { id = item.RoleName })*@
                            </td>
                        </tr>
                    }
                </table>
            </div>
        </div>

    </div>
</div>



