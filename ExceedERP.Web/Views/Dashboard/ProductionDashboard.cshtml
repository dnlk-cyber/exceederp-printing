    function productionTypeCount() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetProductionTypeCount", "Dashboard", new {area = "" })',
        success: function (result) {
            //render
            var ctx = document.getElementById("totalProductionCount").getContext('2d');
            ctx.height = 600;
            var myChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: 'Production Count',
                        data: result.Data,
                        backgroundColor: vibrantColors,
                        borderColor: vibrantBorderColors,
                        borderWidth: 3
                    }]
                },


                options: {

                    title: {
                        display: true,
                        text: ['Production Count']
                    },
                    gridLines: {
                        display: false
                    },
                    pieceLabel: {
                        render: 'value',
                        fontColor: ['green', 'white', 'black'],
                        precision: 2
                    },
                    legend: {
                        position: 'bottom',
                        fontSize: 8,
                        fullWidth: true,
                        padding: 6,
                        labels: {
                            boxWidth:15
                        }
                    }


                }
            });

        }, //end succ
        error: function (result) {
            alert(result);
        }
        });
    }

