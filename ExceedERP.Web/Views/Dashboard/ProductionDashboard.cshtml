@using ExceedERP.Web.Controllers
@using ExceedERP.Core.Localization
@{

    ViewBag.Title = Resources.Dashboard;
    Layout = "~/Views/Shared/_Layout.cshtml";


}

<link href="~/Content/dashboard.css" rel="stylesheet" />

<div class="row">
    <div class="col-sm-7 col-lg-12 chartcontainer">

        <div class="demo-section k-content wide">
            <canvas id="branchProductionQty" width="300" height="300"></canvas>
        </div>


    </div>

</div>
<div class="row">

    <div class="col-sm-7 col-lg-12 chartcontainer">

        <div class="demo-section k-content wide">
            <canvas id="productionQtyByCategory" width="300" height="300"></canvas>
        </div>


    </div>

</div>
@(Html.Kendo().DropDownList()
                .Name("categorySelectorDDL")
                //.OptionLabel("Select Project Type...")
                .DataTextField("CategoryName")
                .DataValueField("ProductCategoryId")
                .HtmlAttributes(new { style = "width: 100%;" })
                .SelectedIndex(0)
                .DataSource(dataSource =>
                {
                    dataSource.Read(read => read.Action("GetProductCategory", "ConsProductionDataProvider", new { area = "ConsProduction" }));
                })
                .Events(e =>
                {
                    e.Change("onCategoryChange");
                    e.DataBound("onCategoryChange");

                })
                .Filter("contains")
                .MinLength(2)
                .ValuePrimitive(true)
)
