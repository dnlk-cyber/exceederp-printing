                            barPercentage: 0.4,
                            ticks: {
                                min: 0  // Ensure X-axis starts at 0
                            }
                        }],
                        yAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'Sample No'
                            },
                            barPercentage: 0.4,
                            ticks: {
                                min: 0  // Ensure Y-axis starts at 0
                            }
                        }]
                    },
                    maintainAspectRatio: false,
                }
            });
        },
        error: function (result) {
            alert(result);
        }
    });
