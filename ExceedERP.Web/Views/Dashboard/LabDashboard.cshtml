 function ExternalSamples() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("ExternalSamples", "Dashboard", new {area = "" })',
        success: function (result) {
            //render
            var ctx = document.getElementById("ExternalSamples").getContext('2d');
            ctx.height = 500;
            var myChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: 'External Samples',
                        data: result.Data,
                        backgroundColor: vibrantColors,
                        borderColor: vibrantBorderColors,
                        borderWidth: 0.2
                    }]
                },
                options: {
                    responsive: true,
                    title: {
                        display: true,
                        text: ['Samples']
                    },
                    gridLines: {
                        display: false
                    },
                    pieceLabel: {
                        render: 'value',
                        fontColor: ['white', 'white', 'white', 'white', 'white'],
                        precision: 2
                    },
                    legend: {
                        position: 'bottom',
                        fontSize: 8,
                        fullWidth: true,
                        padding: 6,
                        labels: {
                            boxWidth:15
                        }
                    }


                }
            });

        }, //end succ
        error: function (result) {
            alert(result);
        }
        });
    }

