@using ExceedERP.Web.Controllers

@{
    ViewBag.Title = "LabDashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/dashboard.css" rel="stylesheet" />

<!--part one-->
<div class="row">
    <!-- Chart 1: Total Projects -->
    <div class="col-md-4">
        <div class="box box-solid">
            <div class="box-header with-border">
                <h5 class="box-title">External Samples</h5>
            </div>
            <div class="box-body">
                <canvas id="ExternalSamples" width="300" height="300"></canvas>
            </div>
        </div>
    </div>
    <!-- Chart 2: Project Category (SD and CAS) -->
    <div class="col-md-4">
        <div class="box box-solid">
            <div class="box-header with-border">
                <h5 class="box-title">Internal Samples</h5>
            </div>
            <div class="box-body">
                <canvas id="InternalSamples" width="300" height="300"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Chart 3: Project Category by Business Unit -->
    <div class="col-md-4">
        <div class="box box-solid">
            <div class="box-header with-border">
                <h5 class="box-title">Received Samples</h5>
            </div>
            <div class="box-body">
                <canvas id="ReceivedSamples" width="300" height="300"></canvas>
            </div>
        </div>
    </div>
</div>
<!--part 2-->
<div class="row">
