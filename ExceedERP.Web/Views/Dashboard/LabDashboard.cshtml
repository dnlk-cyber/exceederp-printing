function NearDeadlineExperiments() {
    $.ajax({
        type: "GET",
        url: '@Url.Action("NearDeadlineExperiments", "Dashboard", new { area = "" })',
        success: function (result) {
            var ctx = document.getElementById("NearDeadlineExperiments").getContext('2d');

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: 'Days Remaining',
                        data: result.Data,
                        backgroundColor: result.Data.map(days =>
                            days <= 3 ? '#dc3545' : '#ffc107' // Red if <= 3 days, Yellow otherwise
                        ),
                        borderColor: '#333',
                        borderWidth: 0.5,
                        barPercentage: 0.5 // makes bar thinner relative to space
                    }]
                },
                options: {
                    indexAxis: 'y', // horizontal bars
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            text: "Experiments Near Deadline",
                            padding: {
                                top: 10,
                                bottom: 10
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return `Days Remaining: ${context.raw}`;
                                }
                            }
                        },
                        legend: {
                            display: false // hide legend if not needed
                        }
                    },
                    scales: {
                        x: {
                            type: 'linear',
                            beginAtZero: true,
                            min: 0,
                            max: 7,
                            ticks: {
                                stepSize: 1
                            },
                            title: {
                                display: true,
                                text: 'Days Remaining'
                            }
                        },
                        y: {
                            type: 'linear',
                            beginAtZero: true,
                            min: 0,
                            max: 7,
                            title: {
                                display: true,
                                text: 'Technicians'
                            }
                        }
                    }
                }
            });
        },
        error: function () {
            alert("Failed to load data for experiments near deadline.");
        }
    });
}





