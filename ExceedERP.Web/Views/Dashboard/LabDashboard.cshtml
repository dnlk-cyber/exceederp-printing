                return;
            }
            var ctx = canvas.getContext('2d');
            ctx.height = 300;

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: '',
                        data: result.Data,
                        backgroundColor: vibrantColors,
                        borderColor: vibrantBorderColors,
                        borderWidth: 0.5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            text: "Plan Revenue vs Execution Revenue2"
                        },
                        legend: {
                            display: false
                        },
                        //tooltip: {
                        //    mode: 'index',
                        //    intersect: false
                        //}
                    },
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: 'Plan Revenue vs Execution Revenue3'
                            },
                            ticks: {
                                autoSkip: false,
                                maxRotation: 45,
                                minRotation: 20
                            },
                            grid: {
                                display: false
                            },
                            barPercentage: 0.5,
                            categoryPercentage: 0.6
                        },
                        y: {
                            title: {
                                display: true,
                                text: 'Plan Revenue vs Execution Revenue4'
