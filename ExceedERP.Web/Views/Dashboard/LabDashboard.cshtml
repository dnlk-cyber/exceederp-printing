    function Parameters() {
    $.ajax({
        type: "GET",
        url: '@Url.Action("Parameters", "Dashboard", new { area = "" })',
        success: function (result) {
            var ctx = document.getElementById("parameters").getContext('2d');

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: result.Labels, // Project names
                    datasets: [{
                        label: '',
                        data: result.Data, // Progress percentages
                        backgroundColor: result.Data.map(progress =>
                            progress < 50 ? '#f8d7da' : '#28a745' // Red if <50%, Green if >=50%
                        ),
                        borderColor: '#333',
                        borderWidth: 0.2,
                        barThickness: 20
                    }]
                },
                options: {
                    indexAxis: 'y', // Horizontal bars
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            //text: "Projects Near Completion",
                            //font: {
                            //    size: 20,
                            //    weight: 'bold'
                            //},
