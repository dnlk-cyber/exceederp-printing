function PlanRevenuevsActualRevenue() {
    $.ajax({
        type: "GET",
        url: '@Url.Action("GetPlanRevenuevsActualRevenue", "Dashboard", new { area = "" })',
        success: function (result) {
            console.log(result); // Debu
            const labels = result.Data.map(item => item.Category);
            const plannedData = result.Data.map(item => item.Planned);
            const executedData = result.Data.map(item => item.Executed);
            const ctx = document.getElementById("PlanRevenuevsExecutionRevenue").getContext("2d");
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: "Planned",
                            data: plannedData,
                            backgroundColor: '#00ff21', // blue
                            borderColor: '#00ff21',
                            borderWidth: 0.2

                        },
                        {
                            label: "Executed",
                            data: executedData,
                            backgroundColor: '#ff6a00', // red
                            borderColor: '#ff6a00',
                            borderWidth: 0.2
                        }
                    ]
                },
                options: {
                    indexAxis: 'y', // This makes it horizontal (Gantt-style)
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            //text: 'Planned vs Executed Revenue per Project'
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Revenue (ETB)'
                            }
                        },
                        y: {
                            title: {
                                display: true,
                                text: 'Projects'
                            }
                        }
                    }
                }
            });
        },
        error: function (error) {
            console.error("Error fetching chart data", error);
        }
    });
}
