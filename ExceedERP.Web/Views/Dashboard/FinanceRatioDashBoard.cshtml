                ctx.height = 600;
                var myChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: result.Labels,
                        datasets: [{
                            type: 'line',
                            label: 'Profit',
                            borderColor: window.chartColors.yellow,
                            borderWidth: 3,
                            fill: false,
                            data: result.DataProfit
                        },
                          {
                              type: 'line',
                              label: 'Current Ratio',
                              backgroundColor: window.chartColors.blue,
                              data: result.Current_Ratio,
                              borderColor: 'white',
                              borderWidth: 2
                          }, {
                              type: 'line',
                              label: 'Quick Ratio',
                              backgroundColor: window.chartColors.green,
                              data: result.Quick_Ratio
                          }


                          ,
                          {
                              type: 'line',
                              label: 'Cash Ratio',
                              backgroundColor: window.chartColors.azure,
                              data: result.Cash_Ratio,
                              borderColor: 'white',
                              borderWidth: 2
                          }, {
                              type: 'line',
                              label: 'Net Working Capital Ratio',
                              backgroundColor: window.chartColors.yellow,
                              data: result.Net_Working_Capital_Ratio
                          }

                        ]

                    },


                    options: {

                        title: {
                            display: true,
                            text: 'Liquidity Ratio'
                        },
                        gridLines: {
                            display: false
                        },
                        pieceLabel: {
                            render: 'value',
                            fontColor: ['green', 'white', 'black'],
                            precision: 2
                        },
                        legend: {
                            position: 'bottom',
                            fontSize: 8,
                            fullWidth: true,
                            padding: 6,
                            labels: {
                                boxWidth: 15
                            }
                        },
                        scales: {
                            xAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,
                                    labelString: 'Months'
                                },
                                barPercentage: 0.4
                            }],
                            yAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,

                                    labelString: 'Amount (M ETB)'
                                },
                                ticks: {

                                    // forces step size to be 5 units
                                    stepSize: 100000
                                }
                            }]
                        },
                        maintainAspectRatio: false

                    }
                });

            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function CapitalStructureRatio() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetCapitalStructureRatio", "Dashboard", new { area = "" })',
            success: function (result) {
                //render
                var ctx = document.getElementById("CapitalStructureRatio").getContext('2d');
                ctx.height = 600;
