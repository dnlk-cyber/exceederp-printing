                        },
                          {
                              type: 'line',
                              label: 'Debt To Equity Ratio',
                              backgroundColor: window.chartColors.blue,
                              data: result.Debt_To_Equity_Ratio,
                              borderColor: 'white',
                              borderWidth: 2
                          } ]

                    },


                    options: {

                        title: {
                            display: true,
                            text: 'Capital Structure Ratio'
                        },
