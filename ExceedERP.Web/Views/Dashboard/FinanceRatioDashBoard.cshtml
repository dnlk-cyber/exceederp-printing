                                scaleLabel: {
                                    display: true,
                                    labelString: 'Months'
                                },
                                barPercentage: 0.4
                            }],
                            yAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,

                                    labelString: 'Amount (M ETB)'
                                },
                                ticks: {

                                    // forces step size to be 5 units
                                    stepSize: 10000
                                }
                            }]
                        },
                        maintainAspectRatio: false

                    }
                });

            }, //end succ
            error: function (result) {
