@using ExceedERP.Web.Controllers

@{
    ViewBag.Title = "FinanceDashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/dashboard.css" rel="stylesheet" />
@*(HttpContext.Current.User.IsInRole("Finance_Report"))*@

<a style="align-content:center;color:white" onclick='return refreshData()' href='#' title="Refresh Data"><i class="fa fa-refresh fa-2x"></i></a>

@if (true)
{
    <div class="dashboard">
        <div class="row">


            <div class="col-sm-12  chartcontainer">

                <div class="demo-section k-content wide">
                    <canvas id="ActivityRatio" width="400" height="400"></canvas>
                </div>


            </div>
                </div>
        <div class="row">


            <div class="col-sm-12  chartcontainer">

                <div class="demo-section k-content wide">
                    <canvas id="ProfitabilityRatio" width="400" height="400"></canvas>
                </div>


            </div>
        </div>
        <div class="row">


            <div class="col-sm-12  chartcontainer">

                <div class="demo-section k-content wide">
                    <canvas id="LiquidityRatio" width="400" height="400"></canvas>
                </div>


            </div>
        </div>
        <div class="row">


            <div class="col-sm-12  chartcontainer">

                <div class="demo-section k-content wide">
                    <canvas id="CapitalStructureRatio" width="400" height="400"></canvas>
                </div>


            </div>
        </div>
     
       </div>
}
<script src="~/Scripts/Chart.bundle.js"></script>
<script src="~/Scripts/Chart.PieceLabel.js"></script>
<script>

    window.chartColors = {
        red: 'rgb(255, 99, 132)',
        orange: 'rgb(255, 159, 64)',
        yellow: 'rgb(255, 205, 86)',
        green: 'rgb(75, 192, 192)',
        blue: 'rgb(54, 162, 235)',
        purple: 'rgb(153, 102, 255)',
        grey: 'rgb(201, 203, 207)',
        black: 'rgb(229, 255, 204)',
        azure: 'rgb(0, 255, 255)'
    };

    ActivityRatio();
    LiquidityRatio();
    CapitalStructureRatio();
    ProfitabilityRatio();

    function ActivityRatio() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetActivityRatio", "Dashboard", new { area = "" })',
            success: function (result) {
                //render
                var ctx = document.getElementById("ActivityRatio").getContext('2d');
                ctx.height = 600;
                var myChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: result.Labels,
                        datasets: [{
                            type: 'line',
                            label: 'Average Collection Period',
                            borderColor: window.chartColors.yellow,
                            borderWidth: 3,
                            fill: false,
                            data: result.Average_Collection_Period
                        },
                          {
                              type: 'line',
                              label: 'Asset TurnOver',
                              backgroundColor: window.chartColors.blue,
                              data: result.Asset_TurnOver,
                              borderColor: 'white',
                              borderWidth: 2
                          }, {
                              type: 'line',
                              label: 'Fixed Asset Turnover',
                              backgroundColor: window.chartColors.green,
                              data: result.Fixed_Asset_Turnover
                          }

                          ,
                          {
                              type: 'line',
                              label: 'Receivables TurnOver',
                              backgroundColor: window.chartColors.azure,
                              data: result.Receivables_TurnOver,
                              borderColor: 'white',
                              borderWidth: 2
                          }, {
                              type: 'line',
                              label: 'Inventory Turnover',
                              backgroundColor: window.chartColors.red,
                              data: result.Inventory_TurnOver
                          }
                        ]

                    },


                    options: {

                        title: {
                            display: true,
                            text: 'Activity Ratio'
                        },
                        gridLines: {
                            display: false
                        },
                        pieceLabel: {
                            render: 'value',
                            fontColor: ['green', 'white', 'black'],
                            precision: 2
                        },
                        legend: {
                            position: 'bottom',
                            fontSize: 8,
                            fullWidth: true,
                            padding: 6,
                            labels: {
                                boxWidth: 15
                            }
                        },
                        scales: {
                            xAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,
                                    labelString: 'Months'
                                },
                                barPercentage: 0.4
                            }],
                            yAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,

                                    labelString: 'Amount (M ETB)'
                                },
                                ticks: {

                                    // forces step size to be 5 units
                                    stepSize: 100000
                                }
                            }]
                        },
                        maintainAspectRatio: false

                    }
                });

            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function LiquidityRatio() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetLiquidityRatio", "Dashboard", new { area = "" })',
