    function ProfitabilityRatio() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetProfitabilityRatio", "Dashboard", new { area = "" })',
            success: function (result) {
                //render
                var ctx = document.getElementById("ProfitabilityRatio").getContext('2d');
                ctx.height = 600;
                var myChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: result.Labels,
                        datasets: [{
                            type: 'line',
                            label: 'Gross Profit Margin',
                            borderColor: window.chartColors.red,
                            borderWidth: 3,
                            fill: false,
                            data: result.Gross_Profit_Margin
                        },
                          {
                              type: 'line',
                              label: 'Operating Profit Margin',
                              backgroundColor: window.chartColors.blue,
                              data: result.Operating_Profit_Margin,
                              borderColor: 'white',
                              borderWidth: 2
                          }, {
                              type: 'line',
                              label: 'Net Profit Margin',
                              backgroundColor: window.chartColors.red,
                              data: result.Net_Profit_Margin
                          }

                          , {
                              type: 'line',
                              label: 'Return On Assets',
                              backgroundColor: window.chartColors.yellow,
                              data: result.Return_On_Assets
                          },

                        {
                        type: 'line',
                        label: 'Return On Equity',
                        backgroundColor: window.chartColors.purple,
                        data: result.Return_On_Equity
                    }

                          , {
                    type: 'line',
                    label: 'Cost Of Goods Sold',
                    backgroundColor: window.chartColors.orange,
                    data: result.Cost_Of_Goods_Sold
                }
                        ]

                    },


                    options: {

                        title: {
                            display: true,
                            text: 'Profitability Ratio'
                        },
                        gridLines: {
                            display: false
                        },
                        pieceLabel: {
                            render: 'value',
                            fontColor: ['green', 'white', 'black'],
                            precision: 2
                        },
                        legend: {
                            position: 'bottom',
                            fontSize: 8,
                            fullWidth: true,
                            padding: 6,
                            labels: {
                                boxWidth: 15
                            }
                        },
                        scales: {
                            xAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,
                                    labelString: 'Months'
                                },
                                barPercentage: 0.4
                            }],
                            yAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,

                                    labelString: 'Amount (M ETB)'
                                },
                                ticks: {

                                    // forces step size to be 5 units
                                    stepSize: 1000
                                }
                            }]
                        },
                        maintainAspectRatio: false

                    }
                });

            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
    $(document).on('click', '.panel-heading span.clickable', function (e) {
        var $this = $(this);
        if (!$this.hasClass('panel-collapsed')) {
            $this.parents('.panel').find('.panel-body').slideUp();
            $this.addClass('panel-collapsed');
            $this.find('i').removeClass('glyphicon-chevron-up').addClass('glyphicon-chevron-down');
        } else {
            $this.parents('.panel').find('.panel-body').slideDown();
            $this.removeClass('panel-collapsed');
            $this.find('i').removeClass('glyphicon-chevron-down').addClass('glyphicon-chevron-up');
        }
    })

    function refreshData() {

        $.ajax({
            type: "POST",
            url: '@Url.Action("RefreshFinanceRatioDashboard", "Dashboard")',
            success: function(result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            beforeSend: function () {
                // Show image container
                $("#loading-image").show();
            },
            complete: function (data) {
                // Hide image container
                $("#loading-image").hide();
            },
            error: function(result) {
                alert(result);
            }
        });
    }

</script>
