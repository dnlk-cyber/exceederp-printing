     function otherAccount() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("OtherAccount", "Dashboard", new {area = ""})',
            success: function (result) {


                //console.log(result.DataSet);

            //render
            var ctx = document.getElementById("otherAccount").getContext('2d');
            ctx.height = 600;
                // Prepare datasets with additional properties for better visualization
                var datasets = result.DataSet.map((dataset, index) => ({
                    ...dataset,
                    backgroundColor: vibrantColors[index % vibrantColors.length],
                    borderColor: window.chartColors.purple,
                    borderWidth: 2,
                    tension: 0.1
                }));

                var myChart = new Chart(ctx, {
                    type: 'bar', // Change this to 'line' if you want a line chart
                    data: {
                        labels: result.Labels,
                        datasets: datasets
                    },
                    options: {
                        responsive: true,
                        title: {
                            display: true,
                            text: 'Other Accounts (M ETB)'
                        },
                        scales: {
                            x: {
                                type: 'time',
                                distribution: 'series',
                                ticks: {
                                    source: 'labels'
                                }
                            },
                            y: {
                                title: {
                                    display: true,
                                    text: 'Other Accounts (M ETB)'
                                }
                            }
                        },
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 15
                                }
                            }
                        }
                    }
                });

        }, //end succ
        error: function (result) {
            alert(result);
        }
        });
     }

