    function CaseByCategory() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetCaseByCategory", "Dashboard", new {area = ""})',
            success: function (result) {
                // Render the chart
                var ctx = document.getElementById("casebyCategory").getContext('2d');
                ctx.height = 600;
                var myChart = new Chart(ctx, {
                    type: 'bar', // Change this to 'bar'
                    data: {
                        labels: result.Labels,
                        datasets: [{
                            // label: result.Labels,
                            data: result.Data,
                            backgroundColor: vibrantColors,
                            borderColor: vibrantBorderColors,
                            borderWidth: 3
                        }]
                    },
                    options: {
                        title: {
                            display: true,
                            text: "Case Summary By  Case Categories"
                        },
                        gridLines: {
                            display: false
                        },
                        pieceLabel: {
                            render: 'value',
                            fontColor: ['green', 'white', 'red', 'yellow'],
                            precision: 2
                        },
                        legend: {
                            display: false // Disable legend display
                        },
                        scales: {
                            xAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,
                                    labelString: 'Case Summary By  Case Categories'
                                },
                                barPercentage: 0.4,
                                ticks: {
                                    min: 0 // Ensure X-axis starts at 0
                                }
                            }],
                            yAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,
                                    labelString: 'Cases'
                                },
                                barPercentage: 0.4,
                                ticks: {
                                    min: 0 // Ensure Y-axis starts at 0
                                }
                            }]
                        }
                    }
                });
            },
            error: function (result) {
                alert(result);
            }
        });



    }
