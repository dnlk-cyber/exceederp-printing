    function CountEmployee() {
        var branch = "";
        var businessUnitId = "";
        if ($("#BranchCode").data("kendoDropDownList") != null)
            branch = $("#BranchCode").data("kendoDropDownList").value();
        if ($("#BusinessUnitId").data("kendoDropDownList") != null)
            businessUnitId = $("#BusinessUnitId").data("kendoDropDownList").value();
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetEmployeeCount", "Dashboard", new {area = ""})',
            data: { branch: branch, businessUnitId: businessUnitId },
            success: function (result) {
            //render
            var ctx = document.getElementById("employeeCount").getContext('2d');
            ctx.height = 600;
            var myChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: 'Employee Count',
                        data: result.Data,
                        backgroundColor: vibrantColors,
                        borderColor: vibrantBorderColors,
                        borderWidth: 3
                    }]
                },


                options: {

                    title: {
                        display: true,
                        text: ['Employee Count']
                    },
                    gridLines: {
                        display: false
                    },
                    pieceLabel: {
                        render: 'value',
                        fontColor: ['green', 'white', 'black'],
                        precision: 2
                    },
                    legend: {
                        position: 'bottom',
                        fontSize: 8,
                        fullWidth: true,
                        padding: 6,
                        labels: {
                            boxWidth:15
                        }
                    }


                }
            });

        }, //end succ
        error: function (result) {
            alert(result);
        }
        });
    }




