@using ExceedERP.Web.Controllers

@{
    ViewBag.Title = "HRMDashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/dashboard.css" rel="stylesheet" />
<div>
    @(Html.Kendo().DropDownList()
             .Name("BranchCode")
             .ValuePrimitive(true)
             .AutoBind(false)
             .HtmlAttributes(new { style = "width:300px" })
             .OptionLabel("Select Branch or project...") // Acts as the "null" value
             .DataTextField("Text")
             .DataValueField("Value")
             .Filter("contains")
             .Events(e =>
             {
                 e.Change("onSelectBranch");
             })
             .DataSource(dataSource =>
             {
                 dataSource.Read(read => read.Action("GetBranchForHRDashBoard", "HRMDataProvider", new { area = "HRM" }))
                           .ServerFiltering(false);
             })

    )
     @(Html.Kendo().DropDownListFor(m => m)
            .Name("BusinessUnitId")
            .ValuePrimitive(true)
            .OptionLabel("Select Business Unit...")
            .DataTextField("Name")
            .DataValueField("Code")
            .HtmlAttributes(new { style = "width:300px" })
            .Filter("contains")
            .Events(e =>
            {
                e.Change("onSelectBranch");
            })
            .DataSource(dataSource =>
            {
                dataSource.Read(read => read.Action("GetAllBusinessUnits", "GlobalDataProvider", new { area = "Common" }).Data("sendForgery"))
                                        .ServerFiltering(false);
            })
)
</div>

