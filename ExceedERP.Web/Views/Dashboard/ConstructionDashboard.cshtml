    function addUnpricedProjectsToChartArea() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetProjectCountByStatusData", "ConstructionDashboardDataProvider", new {area = "Construction"})',
            data: {status: "@ProjectStatus.ESTIMATION"},
            success: function (result) {
                var ctx = document.getElementById("unpricedSection").getContext('2d');
                var myChart = new Chart(ctx, {
                    type: 'pie',
                    data: {
                        labels: result.Types,
                        datasets: [{
                            label: 'Project Types',
                            data: result.PCounts,
                            backgroundColor: colorsArray,
                            borderColor: colorsArray,
                            borderWidth: 1
                        }]
                    },
                    options: {

                        title: {
                            display: true,
                            text: 'Unpriced(Estimation) Projects'
                        },
                        gridLines: {
                            display: false
                        },
                        pieceLabel: {
                            render: 'value',
                            //fontColor: ['green', 'white', 'red'],
                            precision: 2
                        },
                        legend: {
                            position: 'bottom',
                            fontSize: 8,
                            fullWidth: true,
                            padding: 6
                        }
                    }
                });

            },
            error: function (result) {
                console(result);
            }
        });
    }

