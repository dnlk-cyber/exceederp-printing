    @(Html.Kendo().DropDownList()
                            .Name("ProjectTypeSelectorDDL")
                            //.OptionLabel("Select Project Type...")
                            .DataTextField("Name")
                            .DataValueField("ConsProjectTypeId")
                            .HtmlAttributes(new { style = "width: 100%;" })
                            .SelectedIndex(0)
                            .DataSource(dataSource =>
                            {
                                dataSource.Read(read => read.Action("GetProjectTypes", "DataProvider", new { area = "Construction" }));
                            })
                            .Events(e =>
                            {
                                e.Change("onProjectTypeChange");
                                e.DataBound("onProjectTypeChange");
                            })
                            .Filter("contains")
                            .MinLength(2)
                            .ValuePrimitive(true)
    )
    <br />
    <br />

    <div class="row">
        <div class="col-sm-12 col-lg-12 chartcontainer">
            <div class="demo-section k-content wide">
                <canvas id="projectContractStatus" width="800" height="700"></canvas>
            </div>
