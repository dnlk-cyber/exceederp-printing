    function addProjectPlanVsAchivementStatus() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetProjectPlanVsAchivementStatus", "ConstructionDashboardDataProvider", new {area = "Construction"})',
            data: { projectTypeId: $("#ProjectTypeSelectorDDL").val()},
            success: function (result) {
                if (planVsAchivementChart) {
                    planVsAchivementChart.destroy();
                }
                var ctx = document.getElementById("planVsAchivement").getContext('2d');
                ctx.Height = 1000;
                planVsAchivementChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: result.Labels,
                        datasets: [
                          {
                              type: 'bar',
                              label: 'Plan',
                              backgroundColor: window.chartColors.blue,
                                data: result.PlannedCost,
                                customDisplay: result.PlannedCostDisplay,
                              borderColor: 'white',
                              borderWidth: 2
                          }, {
                              type: 'bar',
                              label: 'Actual',
                              backgroundColor: window.chartColors.green,
                                data: result.ActualCost,
                                customDisplay: result.ActualCostDisplay,
                              borderColor: 'white',
                              borderWidth: 2
                            }, {
                                type: 'bar',
                                label: 'Variation',
                                borderColor: window.chartColors.yellow,
                                borderWidth: 2,
                                fill: false,
                                data: result.VariationCost,
                                customDisplay: result.VariationCostDisplay,
                            },
                        ]

                    },

                    options: {
                        title: {
                            display: true,
                            text: 'Planned Vs. Actual Project Costs'
                        },
                        gridLines: {
                            display: false
                        },
                        pieceLabel: {
                            render: 'value',
                            fontColor: ['green', 'white', 'black'],
                            precision: 2
                        },
                        legend: {
                            position: 'top',
                            fontSize: 8,
                            fullWidth: true,
                            padding: 6,
                            labels: {
                                boxWidth: 15
                            }
                        },
                        scales: {
                            xAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,
                                    labelString: 'Projects'
                                },
                                //barPercentage: 0.4
                                ticks: {
                                    autoSkip: false,
                                    maxRotation: 90,
                                    minRotation: 30
                                }
                            }],
                            yAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,
                                    labelString: 'Amount (ETH Birr)'
                                },
                                ticks: {
                                    beginAtZero: true,
                                    userCallback: function (value, index, values) {
                                        // Convert the number to a string and splite the string every 3 charaters from the end
                                        value = value.toString();
                                        value = value.split(/(?=(?:...)*$)/);
                                        value = value.join(',');
                                        return value;
                                    }
                                }
                            }]
                        },
                        maintainAspectRatio: false,
                        tooltips: {
                            callbacks: {
                                title: function (tooltipItems, data) {
                                    return data.labels[tooltipItems[0].index]
                                },
                                label: function (tooltipItem, data) {
                                    var value = data.datasets[tooltipItem.datasetIndex].customDisplay[tooltipItem.index];
                                    var label = data.datasets[tooltipItem.datasetIndex].label;
                                    return label + ": " + value;
                                }
                            }
                        }
                    }
                });

            },
            error: function (result) {
                alert(result);
            }
        });
    }

