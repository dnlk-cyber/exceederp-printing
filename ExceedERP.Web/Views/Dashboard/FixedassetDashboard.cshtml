                        borderColor: [
                            window.chartColors.green
                        ],
                        borderWidth: 1
                    }]
                },


                options: {

                    title: {
                        display: true,
                        text: 'PPE Value (M ETB)'
                    },
                    gridLines: {
                        display: false
                    },
                    pieceLabel: {
                        render: function (args) {
                            return args.value;
                        },
                        fontColor: ['green', 'white', 'red'],
                        precision: 2
                    },
                    legend: {
                        display:false
                    },
                    scales: {
                        yAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'M ETB'
                            },
                            barPercentage: 0.4
                        }],
                        xAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: ''
                            },
                            ticks: {

                                // forces step size to be 5 units
                                stepSize: 1000
                            }
                        }]
                    },


                }
            });

        }, //end succ
        error: function (result) {
            alert(result);
        }
