    }

    function fixedasset() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetFixedAssetStatus", "Dashboard", new {area = ""})',
        success: function (result) {
            //render
            var ctx = document.getElementById("fixedasset").getContext('2d');
            var myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: result.Labels,
                    datasets: [{
