   function assetByCondition() {
    $.ajax({
     type: "GET",
     url: '@Url.Action("AssetByCondition", "Dashboard", new {area = ""})',
    success: function (result) {
     //render
     var ctx = document.getElementById("assetbyCondition").getContext('2d');
     ctx.height = 600;
     var myChart = new Chart(ctx, {
         type: 'horizontalBar',
         data: {
             labels: result.Labels,
             datasets: [{
                 label: 'PPE QTY',
                 data: result.Data,
                 backgroundColor: vibrantColors,
                 borderColor: window.chartColors.purple,
                 borderWidth: 1
             }]
         },


         options: {

             title: {
                 display: true,
                 text: 'PPE Quantity By Condition'
             },
             gridLines: {
                 display: false
             },
             pieceLabel: {
                 render: 'value',
                 fontColor: ['green', 'white', 'red'],
                 precision: 2
             },
             legend: {
                 display:false
             },
             scales: {
                 yAxes: [{
                     display: true,
                     scaleLabel: {
                         display: true,
                         labelString: 'Quantity'
                     },
                     barPercentage: 0.4
                 }],
                 xAxes: [{
                     display: true,
                     scaleLabel: {
                         display: true,
                         labelString: 'Status'
                     },
                     ticks: {

                         // forces step size to be 5 units
                         stepSize: 1000
                     }
                 }]
             },
             maintainAspectRatio: false

         }
     });

 }, //end succ
 error: function (result) {
     alert(result);
 }
 });
}
    function assetcount() {



        $.ajax({
            type: "GET",
            url: '@Url.Action("GetFixedAssetItemCount", "Dashboard", new {area = ""})',
        success: function (result) {
            //render
            var ctx = document.getElementById("assetcount").getContext('2d');
            ctx.height = 600;
            var myChart = new Chart(ctx, {
                type: 'horizontalBar',
                data: {
                    labels: result.Labels,
                    datasets: [{
                        label: 'PPE QTY',
                        data: result.Data,
                        backgroundColor: vibrantColors,
                        borderColor: window.chartColors.purple,
                        borderWidth: 1
                    }]
                },


                options: {

                    title: {
                        display: true,
                        text: 'PPE Quantity By Category'
                    },
                    gridLines: {
                        display: false
                    },
                    pieceLabel: {
                        render: 'value',
                        fontColor: ['green', 'white', 'red'],
                        precision: 2
                    },
                    legend: {
                        display:false
                    },
                    scales: {
                        yAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'PPE Category'
                            },
                            barPercentage: 0.4
                        }],
                        xAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'Quantity'
                            },
                            ticks: {

                                // forces step size to be 5 units
                                stepSize: 1000
                            }
                        }]
                    },
                    maintainAspectRatio: false

                }
            });

        }, //end succ
        error: function (result) {
            alert(result);
        }
        });
    }

    function fixedassetvalue() {
        $.ajax({
