@model IEnumerable<string>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Database BackUps</legend>

<h3 style="color:red">@ViewBag.Error</h3>

@using (Html.BeginForm())
{

    <div class="row">
        <div class="form-group">
           <div class="col-md-3">
                @Html.DropDownList("databaseName", (SelectList)ViewBag.DatabaseList, "Please choose database", new { @class = "form-control" })
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary"><i class="fa fa-check"></i> Take New Back Up</button>
            </div>
        </div>
        
     

    </div>


}

<br/>

<table class="table table-striped table-bordered table-condensed table-hover">
    <tr>
        <th>
            Backup File
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item)
            </td>
           
            <td>

                <div class="hidden-sm hidden-xs btn-group">

                    @*<a  onclick="return confirm('Are you sure to restore this file?');" href='@Url.Action("Restore", new { id = item })' class=" btn btn-xs btn-info" title="Restore">
                        <i class="ace-icon fa fa-refresh bigger-120"></i>
                    </a>*@

                </div>
            </td>
        </tr>
    }

</table>