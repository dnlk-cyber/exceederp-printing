@model dynamic
@{
    ViewBag.Title = "Operation Log";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Operation Log ( by default displays last 15 days data)</legend>

<div class="filters">
    From: @(Html.Kendo().DatePicker().Name("fromDate").Value(DateTime.Now.AddDays(-15)))
    To: @(Html.Kendo().DatePicker().Name("toDate").Value(DateTime.Now))
    <button type="button" class="k-primary" onclick="reloadGrid()">Filter</button>
</div>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Global.GlobalOperationLog>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(c => c.IpAddress).Width(70);
        columns.Bound(c => c.UserName).Width(60);
        columns.Bound(c => c.TimeAccessed).Format("{0:dd MMM yyyy hh:mm tt}").Width(120);
        columns.Bound(c => c.Type).Width(80);
        columns.Bound(c => c.Status).Width(50);
        columns.Bound(c => c.Description).Width(300);
    })
    .ToolBar(toolbar => toolbar.Excel())
    .Excel(excel => excel
        .FileName("Operation Log.xlsx")
        .Filterable(true)
        .AllPages(false) // Only export what's loaded, safer
    )
    .HtmlAttributes(new { style = "height: 550px;" })
    .Pageable(p => p
        .Input(true)
        .Numeric(false)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5))
    .Scrollable()
    .Sortable()
    .Filterable()

    .DataSource(dataSource => dataSource
        .Ajax()
        .Sort(sort => sort.Add("TimeAccessed").Descending())
        .PageSize(50)
        .ServerOperation(true)
        .Read(read => read
            .Action("GlobalUserOperationLogs_Read", "GlobalUserAccessLogs")
            .Data("extraFilters") // attach extra params
        )
    )
)

<script>
    function extraFilters() {
        return {
            fromDate: $("#fromDate").data("kendoDatePicker").value(),
            toDate: $("#toDate").data("kendoDatePicker").value()
        };
    }

    function reloadGrid() {
        $("#grid").data("kendoGrid").dataSource.read();
    }
</script>
