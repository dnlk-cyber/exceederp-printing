@using ExceedERP.Core.Domain.Global

@{
    ViewBag.Title = "Export";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Operation Log ( by default displays last 15 days data)</legend>

<div class="filters">
    From: @(Html.Kendo().DatePicker().Name("fromDate").Value(DateTime.Now.AddDays(-15)))
    To: @(Html.Kendo().DatePicker().Name("toDate").Value(DateTime.Now))
    <button type="button" class="k-primary" onclick="reloadGrid()">Filter</button>
</div>



@(Html.Kendo().Grid<GlobalOperationLog>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.IpAddress);
          columns.Bound(c => c.UserName);
          columns.Bound(c => c.TimeAccessed).Format("{0:dd MMMM yyyy hh:mm tt}");
          columns.Bound(c => c.Type);
          columns.Bound(c => c.Status);
          columns.Bound(c => c.Description);

      })
       .HtmlAttributes(new { style = "height: 550px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                               
      .DataSource(dataSource => dataSource
          .Ajax()
         .Sort(sort => sort.Add("GlobalOperationLogId").Descending())
                .Events(events => events
                  .Error("error_handler")
                  .Sync("sync_handler"))
                          .Read(read => read.Action("GlobalUserOperationLogs_Read", "GlobalUserAccessLogs", new { module = "Payroll" }).Data("extraFilters"))
      )
)


<script>
    function extraFilters() {
        return {
            fromDate: $("#fromDate").data("kendoDatePicker").value(),
            toDate: $("#toDate").data("kendoDatePicker").value()
        };
    }

    function reloadGrid() {
        $("#grid").data("kendoGrid").dataSource.read();
    }
</script>




