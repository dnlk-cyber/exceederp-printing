@using ExceedERP.Core.Domain.Global

@{
    ViewBag.Title = "Export";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Delete Log </legend>



@(Html.Kendo().Grid<GlobalExportLog>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.IpAddress).Width(70);
          columns.Bound(c => c.UserName).Width(60);
          columns.Bound(c => c.TimeAccessed).Format("{0:dd MMMM yyyy hh:mm tt}").Width(120);
          columns.Bound(c => c.Type).Width(80);
          columns.Bound(c => c.Status).Width(50);
          columns.Bound(c => c.Description).Width(300);

      })
       .ToolBar(toolbar =>
       {

           toolbar.Excel();
           // toolbar.Pdf();
       })
      .Excel(excel => excel
          .FileName("Delete Log.xlsx")
          .Filterable(true)
          .AllPages(true)
      )
       .HtmlAttributes(new { style = "height: 550px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                                .Groupable()

      .DataSource(dataSource => dataSource
          .Ajax()
           .Sort(sort => sort.Add("GlobalDeleteLogId").Descending())
                .Events(events => events
                  .Error("error_handler")
                  .Sync("sync_handler"))
                          .Read(read => read.Action("GlobalUserDeleteLogs_Read", "GlobalUserAccessLogs"))
      )
)






