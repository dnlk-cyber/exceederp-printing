    function filterByBranch() {
        var branchObject = $("#Branches").data("kendoDropDownList");
        var branchValue = branchObject.value();

        if (branchValue != null) {
            $("#grid").data("kendoGrid").dataSource.read();
        } else {
            alert("Please select Branch or Project.");
        }
    }
