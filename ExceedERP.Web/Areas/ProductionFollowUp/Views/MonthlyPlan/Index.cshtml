        return {
            budgetYearId: $("#BudgetYearId").val()
        };
    }



    $(".k-grid-add").first().on("click", function (e) {
        var grid = $('#grid').data('kendoGrid');
        if (grid.dataSource.view().length > 0) {
            console.log("true");
            e.preventDefault();
            var sorting = grid.dataSource.sort();
            if (sorting) {
                grid.dataSource.sort(null);

            }
            grid.addRow();
        }
    });

