@helper WeeklyPlan()
{
    bool priceEntryMan = HttpContext.Current.User.IsInRole(DailyMarketRoles.DMPriceEntry);
    bool isAdmin = HttpContext.Current.User.IsInRole(DailyMarketRoles.DMPlanApprover);

    string cultureName = "";
    HttpCookie cultureCookie = Request.Cookies["_culture"];
    if (cultureCookie != null)
    {
        cultureName = cultureCookie.Value;
    }
    @(Html.Kendo().Grid<TradeMarketSystem.Core.Model.Daily_Market.WeeklyPlan>
    ()
    .Name("weekly_year_grid_#=MonthlyPlanId#")
    .Columns(columns =>
    {

        if (cultureName.IsCaseInsensitiveEqual("am") || cultureName.IsCaseInsensitiveEqual("or"))
        {
            columns.Bound(c => c.Name).Filterable(f => f.Multi(true).Search(true)).Width(120);
            columns.Bound(c => c.StartDateEth).EditorTemplateName("EthDatePickerTemplate").Filterable(f => f.Multi(true).Search(true)).Width(150);
            columns.Bound(c => c.EndDateEth).EditorTemplateName("EthDatePickerTemplate").Filterable(f => f.Multi(true).Search(true)).Width(150);

        }
        else
        {
            columns.Bound(c => c.Name).Filterable(f => f.Multi(true).Search(true)).Width(120);
            columns.Bound(c => c.StartDate).Filterable(f => f.Multi(true).Search(true)).EditorTemplateName("DatePickerTemplate").Width(120);
            columns.Bound(c => c.EndDate).Filterable(f => f.Multi(true).Search(true)).EditorTemplateName("DatePickerTemplate").Width(120);
        }

        columns.Bound(c => c.Plan).Filterable(f => f.Multi(true).Search(true)).Width(100);
        
        columns.Bound(c => c.User).Filterable(f => f.Multi(true).Search(true)).Width(100);

})
      .Editable(editable => editable.Mode(GridEditMode.InCell))
    .PersistSelection()
    .HtmlAttributes(new { style = "height: 520px;" })
    .Pageable(pageable => pageable
    .Input(true)
    .Numeric(false)
    .Refresh(true)
    .PageSizes(true)
    .ButtonCount(5))
    .Navigatable()
    .Sortable(sortable =>
    {
        sortable.SortMode(GridSortMode.SingleColumn);
    })
    .Filterable()
    .Scrollable()
    .DataSource(dataSource => dataSource
    .Ajax()
    .PageSize(12)
    .Batch(true)
    .ServerOperation(true)
    .Sort(sort =>
    {
        sort.Add(m => m.MonthlyPlanId).Descending();
    })
   .Group(gr => {
       gr.Add(g => g.User);
   })
  
    .Events(ev => ev
    .Error("error_handler(\"weekly_year_grid_#=MonthlyPlanId#\")")
    .RequestStart("onRequestStart(\"weekly_year_grid_#=MonthlyPlanId#\")")
    .RequestEnd("onRequestEnd(\"weekly_year_grid_#=MonthlyPlanId#\")"))
    .Model(model =>
    {

        model.Id(p => p.WeeklyPlanId);
        model.Field(p => p.Name).Editable(false);
        model.Field(p => p.NameAm).Editable(false);
        model.Field(p => p.StartDate).Editable(false);
        model.Field(p => p.StartDateEth).Editable(false);
        model.Field(p => p.EndDate).Editable(false);
        model.Field(p => p.Plan).Editable(false);
        model.Field(p => p.EndDateEth).Editable(false);
        model.Field(p => p.User).Editable(false);
        model.Field(p => p.Actual).Editable(false);
        model.Field(p => p.ApprovedBy).Editable(false);
        model.Field(p => p.Performance).Editable(false);
    })

    .Read(read => read.Action("WeeklyPlanAdmins_Read", "WeeklyPlan", new { id = "#=MonthlyPlanId#" }))

    )

    .ToClientTemplate()

    )
}


