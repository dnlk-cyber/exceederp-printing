                            confirmButtonText: "@Resource.AlertWindow_ConfirmButtonText",
                            //closeOnConfirm: false
                        });
                      toastr.error(result.Message);

                  }
            },
              error: function (result) {

                  toastr.error(result).fadeIn(2000).delay(3000).fadeOut(2000);
            }
        });

                } else {
                }
            });
    }

