                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-custom-delete-command").remove();
                $(this).find(".k-grid-custom-approve-command").remove();
            }

        });
        console.log(10000);
        customDeleteConfirmationGridDataBound(e.sender.element[0].id);

    }

