@using TradeMarketSystem.Core.Localization
@using TradeMarketSystem.Core.Model.Daily_Market
@using Kendo.Mvc.Extensions

@{


    string cultureName = "";
    HttpCookie cultureCookie = Request.Cookies["_culture"];
    if (cultureCookie != null)
    {
        cultureName = cultureCookie.Value;
    }
    bool admin = HttpContext.Current.User.IsInRole("DM_Plan_Approver");
    bool priceEntryMan = HttpContext.Current.User.IsInRole(DailyMarketRoles.DMPriceEntry);

}
@(Html.Kendo().Window()
                .Name("window")
                .Width(600)
                .Height(250)
                .Visible(false)
                        .Modal(true)
                        .Draggable(true)
                .Content(@<text>
<form action="@Url.Action("WeeklyPlan_Reject", "WeeklyPlan", new { area = "DailyMarket" })" method="post" , new { enctype="multipart/form-data" }>
    <input type="hidden" name="monthlyPlanId" id="monthlyPlanId">
    <input type="hidden" name="userName" id="userName">
    <div class="row">
                <div class="col-md-1"></div>

        <div class="col-md-9">


            @(Html.Kendo().Editor().Name("Remark").HtmlAttributes(new { style = "height: 70px" }))
        </div>

    </div>
    <button style="margin-top:15px" type="submit"  class="k-button k-button-icontext k-Secondary k-grid-next pull-right"> Submit</button>

</form>
                </text>)
        .Modal(true)
        .Title("Reason For Reject")
        .Actions(actions => actions.Close())

)
<div class="content-wrapper">
    <section class="content-header">
        <h4><i class="fa fa-list"></i> @TradeMarketSystem.Core.Localization.Resource.DailyMarket_MarketPriceEntryPlan</h4>

    </section>
    <section class="content">

        @(Html.Kendo().Grid<TradeMarketSystem.Core.Model.Daily_Market.YearlyPlan>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.BudgetYearId,(System.Collections.IEnumerable)ViewData["BudgetYears"], "BudgetYearId","Year").EditorTemplateName("BudgetYearTemplate").Filterable(f => f.Multi(true).Search(true)).Width(200);
          if (cultureName.IsCaseInsensitiveEqual("am") || cultureName.IsCaseInsensitiveEqual("or"))
          {
              columns.Bound(c => c.StartDateEth).Filterable(f => f.Multi(true).Search(true)).EditorTemplateName("YearPickerTemplate").Width(120);

              columns.Bound(c => c.EndDateEth).Filterable(f => f.Multi(true).Search(true)).EditorTemplateName("YearPickerTemplate").Width(120);


          }
          else
          {
              columns.Bound(c => c.StartDate).Filterable(f => f.Multi(true).Search(true)).EditorTemplateName("YearPickerTemplate").Width(120);

              columns.Bound(c => c.EndDate).Filterable(f => f.Multi(true).Search(true)).EditorTemplateName("YearPickerTemplate").Width(120);

          }
          columns.Bound(c => c.Plan).Filterable(f => f.Multi(true).Search(true)).Width(100);
          
      })
      
        .Events(ev=>ev.DetailExpand("onYearlyDetailExpand"))

         .Editable(editable => editable.Mode(GridEditMode.InLine))
           .Sortable(sortable => sortable.AllowUnsort(true))

            .HtmlAttributes(new { style = "height: 520px;" })
            .Pageable(pageable => pageable
                     .Input(true)
                     .Numeric(false)
                     .Refresh(true)
                     .PageSizes(true)
                     .ButtonCount(5))

      .Filterable()
      .Scrollable()
       .Sortable(sortable =>
       {
           sortable.SortMode(GridSortMode.SingleColumn);

       })
      .DataSource(dataSource => dataSource
          .Ajax()
          .ServerOperation(true)
          .Sort(sort =>
          {
              sort.Add(m => m.YearlyPlanId).Descending();
          })
          .Events(ev => ev
    .Error("error_handler(\"grid\")")
    .RequestStart("onRequestStart(\"grid\")")
    .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model => {
              model.Id(p => p.YearlyPlanId);
              model.Field(p => p.StartDate).Editable(false);
              model.Field(p => p.EndDate).Editable(false);
              model.Field(p => p.EndDateEth).Editable(false);
              model.Field(p => p.StartDateEth).Editable(false);
              model.Field(p => p.User).Editable(false);
              model.Field(p => p.ApprovedBy).Editable(false);
              model.Field(p => p.Actual).Editable(false);
              model.Field(p => p.Performance).Editable(false);
          } )
          .Read(read => read.Action("MarketPriceEntryPlans_Read", "MarketPriceEntryPlan"))
      ).ClientDetailTemplateId("monthlyPlans")
)

    </section>
</div>


<script id="monthlyPlans" type="text/kendo-tmpl">
     @(Html.Kendo().TabStrip()
      .Name("monthly_tab_#=YearlyPlanId#")
    .SelectedIndex(0)
    .Items(items =>
    {

    items.Add().Text(Resource.DailyMarket_MonthlyPlans).Content(
           @<text>
         @MonthlyPlan()
             </text>
);

         }).ToClientTemplate()

    )
</script>
@helper MonthlyPlan()
{
    bool admin = HttpContext.Current.User.IsInRole(DailyMarketRoles.DMPlanApprover);
    bool priceEntryMan = HttpContext.Current.User.IsInRole(DailyMarketRoles.DMPriceEntry);

    string cultureName = "";
    HttpCookie cultureCookie = Request.Cookies["_culture"];
    if (cultureCookie != null)
    {
        cultureName = cultureCookie.Value;
    }
    @(Html.Kendo().Grid<TradeMarketSystem.Core.Model.Daily_Market.MonthlyPlan>()
      .Name("monthly_grid_#=YearlyPlanId#")
      .Columns(columns =>
      {


          if (cultureName.IsCaseInsensitiveEqual("am") || cultureName.IsCaseInsensitiveEqual("or"))
          {
              columns.ForeignKey(c => c.QuarterlyPlanId, (System.Collections.IEnumerable)ViewData["Quarters"], "QuarterlyPlanId", "NameAm").Hidden(true).Filterable(f => f.Multi(true).Search(true)).Width(200);
              columns.Bound(c => c.NameAm).Filterable(f => f.Multi(true).Search(true)).Width(120);
              columns.Bound(c => c.StartDateEth).Filterable(f => f.Multi(true).Search(true)).Width(120);
              columns.Bound(c => c.EndDateEth).Filterable(f => f.Multi(true).Search(true)).Width(120);
          }
          else
          {
              columns.ForeignKey(c => c.QuarterlyPlanId, (System.Collections.IEnumerable)ViewData["Quarters"], "QuarterlyPlanId", "NameAm").Hidden(true).Filterable(f => f.Multi(true).Search(true)).Width(200);
              columns.Bound(c => c.Name).Filterable(f => f.Multi(true).Search(true)).Width(120);
              columns.Bound(c => c.StartDate).Filterable(f => f.Multi(true).Search(true)).Width(120);
              columns.Bound(c => c.EndDate).Filterable(f => f.Multi(true).Search(true)).Width(120);
          }
          columns.Bound(c => c.Plan).Filterable(f => f.Multi(true).Search(true)).Width(100);
        


      })
      .ToolBar(toolbar =>
      {
         
          toolbar.Save().SaveText(Resource.Grid_SaveChangesButtonText).CancelText(Resource.Grid_CancelButtonText);
      })
      .Events(ev=>ev.DetailExpand("onMonthlyDetailExpand").Edit("onEdit"))
      .Editable(editable => editable.Mode(GridEditMode.InCell))
            .PersistSelection()
          .HtmlAttributes(new { style = "height: 520px;" })
                           .Pageable(pageable => pageable
                                             .Input(true)
                                             .Numeric(false)
                                             .Refresh(true)
                                             .PageSizes(true)
                                             .ButtonCount(5))

          .Navigatable()
          .Sortable(sortable =>
          {
              sortable.SortMode(GridSortMode.SingleColumn);
          })
          .Filterable()
          .Scrollable()
          .DataSource(dataSource => dataSource
              .Ajax()
              .ServerOperation(false)
              .Batch(true)
              .Sort(sort =>
              {
                  sort.Add(m => m.MonthlyPlanId).Ascending();
              })
               .Events(ev => ev
        .Error("error_handler(\"monthly_grid_#=YearlyPlanId#\")")
        .RequestStart("onRequestStart(\"monthly_grid_#=YearlyPlanId#\")")
        .RequestEnd("onRequestEnd(\"monthly_grid_#=YearlyPlanId#\")"))
              .Model(model =>
              {

                  model.Id(p => p.MonthlyPlanId);
                  model.Field(p => p.Name).Editable(false);
                  model.Field(p => p.NameAm).Editable(false);
                  model.Field(p => p.ApprovedBy).Editable(false);
                  model.Field(p => p.StartDate).Editable(false);
                  model.Field(p => p.EndDate).Editable(false);
                  model.Field(p => p.StartDateEth).Editable(false);
                  model.Field(p => p.EndDateEth).Editable(false);
                  model.Field(p => p.User).Editable(false);
                  model.Field(p => p.Actual).Editable(false);
                  model.Field(p => p.Performance).Editable(false);
              })
              .PageSize(12)
              .Group(gr=>gr.Add(g=>g.QuarterlyPlanId))
              .Read(read => read.Action("MonthlyPlans_Read", "MonthlyPlan", new { id = "#=YearlyPlanId#" }))
              .Create(create => create.Action("MonthlyPlans_Create", "MonthlyPlan", new { id = "#=YearlyPlanId#" }))
              .Update(update => update.Action("MonthlyPlans_Update", "MonthlyPlan", new { id = "#=YearlyPlanId#" }))
              .Destroy(destroy => destroy.Action("MonthlyPlans_Destroy", "MonthlyPlan"))

          ).ClientDetailTemplateId("weeklyPlans")
          .ToClientTemplate()


                )
}





<script id="weeklyPlans" type="text/kendo-tmpl">

    #if (IsApproved){#
     @(Html.Kendo().TabStrip()
      .Name("weekly_tab_#=MonthlyPlanId#")
    .SelectedIndex(0)
    .Items(items =>
    {

    items.Add().Text(Resource.DailyMarket_WeeklyPlans).Content(
