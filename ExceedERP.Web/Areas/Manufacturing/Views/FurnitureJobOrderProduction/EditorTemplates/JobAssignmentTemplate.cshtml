<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>Start Date</label>
            <div>
                @(Html.Kendo().DateTimePickerFor(model => model.TaskAssignedDate).HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>End Date</label>
            <div>
                @(Html.Kendo().DateTimePickerFor(model => model.TaskEndDate).HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>
    </div>
</div>