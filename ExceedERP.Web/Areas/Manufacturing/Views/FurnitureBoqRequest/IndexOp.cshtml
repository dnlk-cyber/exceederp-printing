
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<label>Furniture Boq Request</label>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Manufacturing.FurnitureEstimation.FurnitureBoqRequest>()
                .Name("grid")
                .Columns(columns =>
                {
                    columns.Bound(c => c.JobType).Width(100);
                    columns.ForeignKey(c => c.CustomerId, (IEnumerable)ViewData["Customers"], "Code", "Name").Title("Customer").Width(100);
                    columns.Bound(c => c.RequestDate).Width(100);
                    columns.Bound(c => c.Remark).Width(100);
                    columns.Bound(c => c.Status).Width(100);
                    columns.Command(command =>
                    {
                        command.Custom("check").Text(" ").IconClass("fa fa-check").HtmlAttributes(new { @class = "check", title = "Send" }).Click("checkEstimation");
                        //command.Custom("approve").Text(" ").IconClass("fa fa-thumbs-o-up").HtmlAttributes(new { @class = "approve", title = "Approve" }).Click("approveEstimation");
                        //command.Edit().Text(" ").IconClass("fa fa-pencil").HtmlAttributes(new { title = "Edit" });
                        //command.Destroy().Text(" ").IconClass("fa fa-trash").HtmlAttributes(new { title = "Delete" });
                        //command.Custom("reject").Text(" ").IconClass("fa fa-remove").HtmlAttributes(new { @class = "reject", title = "Reject" }).Click("rejectEstimation");
                    }).Width(250);
                })
                //.ToolBar(toolbar =>
                //{
                //    toolbar.Create();
                //})
                .Events(e => e.DataBound("dataBound"))
                .Events(e => e.DetailExpand("detailExpand"))
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Pageable()
                .Filterable()
                .Scrollable(h => h.Height(600))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Sort(s => s.Add(x => x.FurnitureBoqRequestId).Descending())
                    .Model(model =>
                    {
                        model.Id(p => p.FurnitureBoqRequestId);
                        model.Field(p => p.Status).Editable(false);
                    })
                    .Read(read => read.Action("FurnitureBoqRequest_ReadOp", "FurnitureBoqRequest"))
                    //.Create(create => create.Action("FurnitureBoqRequest_Create", "FurnitureBoqRequest"))
                    //.Update(update => update.Action("FurnitureBoqRequest_Update", "FurnitureBoqRequest"))
                    //.Destroy(destroy => destroy.Action("FurnitureBoqRequest_Delete", "FurnitureBoqRequest"))
                ).ClientDetailTemplateId("template"))

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                .Name("tabstrip_#=FurnitureBoqRequestId#")
                                .Items(items =>
                                {
                                    items.Add().Text("Documents").Content(
                                    @<text>
                                        <span class="btn-upload cal">
                                            <input type="button" class="btn btn-primary fa fa-plus" value="Add File" onclick="UploadCompanyDoc(#=FurnitureBoqRequestId#)" />
                                        </span>
                                        @BoqDocs()
                                    </text>);
                                    items.Add().Text("Comments").Content(@<text>@Comment()</text>);
                                        }).ToClientTemplate())
</script>


@helper BoqDocs()
{

    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Manufacturing.FurnitureEstimation.FurnitureBoqDocument>()
                                .Name("CompanyDocument#=FurnitureBoqRequestId#")
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.FileName).ClientTemplate("<a href='/Manufacturing/FurnitureBoqDocument/DownloadCompanyDocument?CompanyDocumentId=\\#=FurnitureBoqDocumentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; \\#=FileName\\# </a>");
                                    columns.Bound(c => c.Description);
                                    columns.Template(e => { }).ClientTemplate("<a href='/Manufacturing/FurnitureBoqDocument/DownloadCompanyDocument?CompanyDocumentId=\\#=FurnitureBoqDocumentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; Download </a>");
                                    columns.Template(e => { }).ClientTemplate("<a href='\\#=ShortPath\\#/\\#=FileName\\#' target='_blank'> <f class = 'fa fa-folder-open'></i> &nbsp;&nbsp; Open</a>");
                                    columns.Command(command =>
                                    {
                                        command.Destroy().Text("Delete");
                                    });
                                })
                                .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Answer").Window(window => { window.Title(""); window.Scrollable(false); }))
                                .Events(e => e.DataBound("detailDataBound"))
                                .Scrollable(h => h.Height("auto"))
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .Sort(sort => sort.Add(c => c.FurnitureBoqDocumentId).Descending())
                                .Events(events =>
                                {
                                    events.Error("error_handler(\"CompanyDocument#=FurnitureBoqRequestId#\")");
                                    events.RequestStart("onRequestStart(\"CompanyDocument#=FurnitureBoqRequestId#\")");
                                    events.RequestEnd("onRequestEnd(\"CompanyDocument#=FurnitureBoqRequestId#\")");
                                })
                                .Model(model => model.Id(p => p.FurnitureBoqDocumentId))
                                .Read(read => read.Action("FurnitureBoqRequest_Read", "FurnitureBoqDocument", new { id = "#=FurnitureBoqRequestId#" }))
                                .Destroy(destroy => destroy.Action("FurnitureBoqRequest_Delete", "FurnitureBoqDocument", new { area = "Manufacturing" }))
                                ).ToClientTemplate())
}
@helper Comment()
{
    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Manufacturing.FurnitureEstimation.FurnitureBoqDocumentComment>()
                            .Name("comment#=FurnitureBoqRequestId#")
                            .Columns(columns =>
                            {
                                columns.Bound(c => c.Comment).Width(100);
                                columns.Bound(c => c.CreatedBy).Width(100).Title("Sender");
                                columns.Bound(c => c.DateCreated).Width(100).Title("Date");
                                columns.Command(command =>
                                {
                                    command.Edit().Text(" ").IconClass("fa fa-pencil").HtmlAttributes(new { title = "Edit" });
                                    command.Destroy().Text(" ").IconClass("fa fa-trash").HtmlAttributes(new { title = "Delete" });
                                }).Width(250);
                            })
                            .ToolBar(toolbar =>
                            {
                                toolbar.Create();
                            })

                            .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("CommentEditorTemplate"))
                            .Pageable()
                            .Filterable()
                            .Scrollable(h => h.Height(600))
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Events(events =>
                                {
                                    events.Error("error_handler(\"comment#=FurnitureBoqRequestId#\")");
                                    events.RequestStart("onRequestStart(\"comment#=FurnitureBoqRequestId#\")");
                                    events.RequestEnd("onRequestEnd(\"comment#=FurnitureBoqRequestId#\")");
                                })
                                .Model(model => model.Id(p => p.FurnitureBoqDocumentCommentId))
                                .Read(read => read.Action("Read", "FurnitureBoqDocumentComment", new { id = "#=FurnitureBoqRequestId#" }))
                                .Create(create => create.Action("Create", "FurnitureBoqDocumentComment", new { id = "#=FurnitureBoqRequestId#" }))
                                .Update(update => update.Action("Update", "FurnitureBoqDocumentComment"))
                                .Destroy(destroy => destroy.Action("Delete", "FurnitureBoqDocumentComment"))
                            ).ToClientTemplate())



}
<script type="text/javascript">
    function checkEstimation(e) {
        if (confirm("Are you sure you want to send?")) {
             var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        $.ajax({
           type: "POST",
            url: '@Url.Action("SendBoqRequest", "FurnitureBoqRequest", new { Area = "Manufacturing" })',
            data: { id: dataItem.FurnitureBoqRequestId },
            success: function (result) {
                if (result.Success) {
                    toastr.success(result.Message);
                    $("#grid").data("kendoGrid").dataSource.read();
                }
                else {
                    toastr.error(result.Message);
                }
           },
           error: function(result) {
               alert(result);
           }
       });
      }
    }

        function approveEstimation(e) {
            if (confirm("Are you sure to approve this estimation form?")) {
             var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        $.ajax({
           type: "POST",
            url: '@Url.Action("ApproveBoqRequest", "FurnitureBoqRequest", new { Area = "Manufacturing" })',
            data: { id: dataItem.FurnitureBoqRequestId },
            success: function (result) {
                if (result.Success) {
                    toastr.success(result.Message);
                    $("#grid").data("kendoGrid").dataSource.read();
                }
                else {
                    toastr.error(result.Message);
                }
           },
           error: function(result) {
               alert(result);
           }
       });
        }
    }
      function rejectEstimation(e) {
            if (confirm("Are you sure to reject this checked estimation form?")) {
             var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        $.ajax({
           type: "POST",
            url: '@Url.Action("RejectBoqRequest", "FurnitureBoqRequest", new { Area = "Manufacturing" })',
            data: { id: dataItem.FurnitureBoqRequestId },
            success: function (result) {
                if (result.Success) {
                    toastr.success(result.Message);
                    $("#grid").data("kendoGrid").dataSource.read();
                }
                else {
                    toastr.error(result.Message);
                }
           },
           error: function(result) {
               alert(result);
           }
       });
        }
    }

    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            $(this).find(".k-grid-check").show();
            if (dataItem.IsSent) {
                $(this).find(".k-grid-check").hide();
            }

        });
    }
    var masterRow;
    var masterGrid;
    var masterDataItem;
    var masterId;
    var isApproved;
    var isChecked;
    var isRejected
    var sendMarginApprove;
    function detailExpand(e) {
        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.FurnitureBoqRequestId;
        isApproved = masterDataItem.IsApproved;
        isRejected = masterDataItem.IsRejected;
        if (isApproved) {
            $(".cal").hide();
        }
    }
    function detailDataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (isApproved || isRejected) {
                $(this).find(".k-grid-delete").hide();
            }

        });
    }
</script>
<script>


    function UploadCompanyDoc(id) {

        $("#FurnitureBoqRequestId").val(id);

        var wnd = $("#UploadCompanyFileWindow").data("kendoWindow");
        wnd.center().open();
    }

    function UploadCompanyFile() {

            $.ajax({
                url: '@Url.Action("UploadCompanyFile", "FurnitureBoqDocument")',
                //contentType: "application/json; charset=utf-8",
                data: function () {
                    var data = new FormData();
                    var kk = $("#CompanyFile");//.get(0).files[0];

                    $.each($("input[type=file]"), function (i, obj) {
                        $.each(obj.files, function (j, file) {
                            data.append('CompanyFile[' + j + ']', file);
                        })
                    });

                   // data.append("CompanyFile", $("#CompanyFile").get(0).files[0]);
                    data.append("furnitureBoqRequestId", $("#FurnitureBoqRequestId").val());
                    data.append("Description", $("#Description").val());
                    return data;
                }(),
                type: 'POST',
                contentType: false,
                processData: false,
                cache: false,
                success: function (result) {
                    var wnd = $("#UploadCompanyFileWindow").data("kendoWindow").close();
                    var id = $("#FurnitureBoqRequestId").val();
                    alert(result);
                    $("#CompanyDocument" + id).data("kendoGrid").dataSource.read();
                }
            });
    }
</script>


@(Html.Kendo().Window().Name("UploadCompanyFileWindow")
                            .Title("Upload Answer")
                            .Visible(false)
                            .Modal(true)
                            .Content(@<text>
                                <input type="hidden" id="FurnitureBoqRequestId" name="FurnitureBoqRequestId" />

                                @*@Html.TextBox("CompanyFile", "", new { type = "file", @class = "form-control" })*@
                                <input type="file" name="CompanyFile" id="CompanyFile[]" class="form-control" multiple />
                                <br />
                                <textarea id="Description" class="form-control"></textarea>
                                <br />
                                <div class="pull-right">
                                    @Html.Kendo().Button().Name("btnTo").Content("Upload").Events(e => e.Click("UploadCompanyFile"))
                                </div>
                            </text>)
                                                                     .Draggable(true)
                                                                     .Width(400))


