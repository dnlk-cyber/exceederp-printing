@model ExceedERP.Core.Domain.Manufacturing.Setting.ManufacturingMaterialCategory



<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>Item Code</label>
            <div>
                @(Html.Kendo().DropDownListFor(m => m.InventoryCategoryCode)
                    .DataTextField("Text")
                    .DataValueField("Value")
                    .AutoBind(true)
                    .ValuePrimitive(true)
                    .DataSource(dataSource =>
                    {
                        dataSource.Read(read => read.Action("GetInventoryItemCategory", "PrintDataProvider", new { Area = "Printing" }).Data("filterCategory"))
                        .ServerFiltering(true);
                    })
                    .Filter("contains")
                    
                    .ValuePrimitive(true)
                    .HtmlAttributes(new { style = "width:100%"})
                )
            </div>
        </div>
    </div>
</div>
