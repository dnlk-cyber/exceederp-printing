
@model ExceedERP.Core.Domain.Manufacturing.Setting.ManufacturingMaterialCategoryItem


<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>Item Code/Name</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.ItemCode)
                            .ValuePrimitive(true)
                            .OptionLabel("Select Item...")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .Filter("contains")
                            .AutoBind(true)
                            
                            .DataSource(dataSource =>
                            {
                                dataSource.Read(read => read.Action("InventoryItems", "PrintDataProvider", new { area = "Printing" }).Data("filterItemCode"))
                                    .ServerFiltering(true);
                            }).HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>UOM</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.UnitOfMeasurement)
                    .ValuePrimitive(true)
                    .OptionLabel("Select unit...")
                    .DataTextField("Text")
                    .DataValueField("Value")
                    .Filter("contains")
                    .AutoBind(true)
                    
                    .DataSource(dataSource =>
                    {
                        dataSource.Read(read => read.Action("GetUoM", "PrintDataProvider", new { area = "Printing" }).Data("filterUoM"))
                            .ServerFiltering(true);
                    }).HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>       
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>Unit Cost*</label>
            <div>
                @(Html.Kendo().NumericTextBoxFor(model => model.UnitPrice).HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>
    </div>

</div>