
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.AR.SalesOrder.ArSalesOrderPaymentSchedule>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Date);
          columns.Bound(c => c.Amount);
          columns.Bound(c => c.Description);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ArSalesOrderPaymentScheduleId))
          .Read(read => read.Action("ArSalesOrderPaymentSchedules_Read", "ArSalesOrderPaymentSchedule"))
          .Create(create => create.Action("ArSalesOrderPaymentSchedules_Create", "ArSalesOrderPaymentSchedule"))
          .Update(update => update.Action("ArSalesOrderPaymentSchedules_Update", "ArSalesOrderPaymentSchedule"))
          .Destroy(destroy => destroy.Action("ArSalesOrderPaymentSchedules_Destroy", "ArSalesOrderPaymentSchedule"))
      ))
