@using ExceedERP.Core.Domain.Finance.Bank
<legend>Bank Records</legend>
@(Html.Kendo().Grid<ReconciliationBankAccount>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.BankAccount);
          columns.Bound(c => c.Type);
          columns.Bound(c => c.Reference);
          columns.Bound(c => c.Debit);
          columns.Bound(c => c.Credit);
          columns.Bound(c => c.Date);
          columns.Bound(c => c.Reconciled).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= Reconciled #' " +
              "# if (Reconciled) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.ReconciledDate);
          columns.Bound(c => c.Check).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= Check #' " +
              "# if (Check) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.OrgBranchName).Hidden(true);
          columns.Bound(c => c.DateCreated).Hidden(true);
          columns.Bound(c => c.LastModified).Hidden(true);
          columns.Bound(c => c.CreatedBy).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Hidden(true);
        
      })
      .ToolBar(toolbar => {
                              toolbar.Excel();
                              // toolbar.Pdf();
      })
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ReconciliationBankAccountId").Descending())
          .Model(
              model =>
              {
                  model.Id(p => p.ReconciliationBankAccountId);
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);


              })
          .Events(events => events
              .Error("error_handler_one")
              .Sync("sync_handler"))
          .Read(read => read.Action("ReconcilationBankAccounts_Read", "ReconciliationBankAccount"))
      ))
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

    function sync_handler(e) {
        this.read();
    }
</script>