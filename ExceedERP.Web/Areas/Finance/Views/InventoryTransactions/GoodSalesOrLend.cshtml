    <br />
    Distribution
    # if (IsOnlineApproved && !IsOnlineTransferred && !IsVoid )
    {#
    <a onclick='return transfer("#=GoodSellingAndLendingID#")' href=' \#' title="Transfer to GL"><i class="fa fa-paper-plane fa-2x"></i></a>
    &nbsp;&nbsp;&nbsp;
    <a onclick='return generateDistribution("#=GoodSellingAndLendingID#")' href=' \#' title="Regenerate Distribution"><i class="fa fa-forward fa-2x"></i></a>
    <br />
    # } #
    @(Html.Kendo().Grid<GoodSellingAndLendingDistribution>()
          .Name("GoodSellingAndLendingDistribution_#=GoodSellingAndLendingID#")
          .Columns(columns =>
          {

              columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(220);
              columns.Bound(c => c.AccountDesc).Width(200);
              columns.Bound(c => c.AdditionalDescription).Width(150);
              columns.Bound(c => c.Debit).Width(100).ClientFooterTemplate("Total Debit: \\#=sum\\# ");
              columns.Bound(c => c.Credit).Width(100).ClientFooterTemplate("Total Credit: \\#=sum\\# ");
              columns.Command(command =>
              {
                  command.Edit();
                  command.Destroy();

              }).ClientFooterTemplate("Difference: \\#=Debit.sum-Credit.sum\\# ");
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create();
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable()
          .Events(x => x.DataBound("onDataBoundDistribution"))
          .DataSource(dataSource => dataSource

              .Ajax()
              .Model(model =>
              {
                  model.Id(p => p.GoodSellingAndLendingDistributionID);
                  model.Field(p => p.AccountDesc).Editable(false);

              })
              .Aggregates(aggregates =>
              {
                  aggregates.Add(p => p.Debit).Sum();
                  aggregates.Add(p => p.Credit).Sum();
              })
              .Events(ev => ev
                  .Error("error_handler(\"GoodSellingAndLendingDistribution_#=GoodSellingAndLendingID#\")")
                  .RequestStart("onRequestStart(\"GoodSellingAndLendingDistribution_#=GoodSellingAndLendingID#\")")
                  .RequestEnd("onRequestEnd(\"GoodSellingAndLendingDistribution_#=GoodSellingAndLendingID#\")"))
              .Read(read => read.Action("GoodSellingAndLendingDistributions_Read", "GoodSellingAndLendingDistribution", new { area = "Inventory", id = "#=GoodSellingAndLendingID#" }))
              .Create(create => create.Action("GoodSellingAndLendingDistributions_Create", "GoodSellingAndLendingDistribution", new { area = "Inventory", id = "#=GoodSellingAndLendingID#" }))
              .Update(read => read.Action("GoodSellingAndLendingDistributions_Update", "GoodSellingAndLendingDistribution", new { area = "Inventory" }))
              .Destroy(destroy => destroy.Action("GoodSellingAndLendingDistributions_Destroy", "GoodSellingAndLendingDistribution", new { area = "Inventory" }))
          ).ToClientTemplate())


</script>



<script>

    function BatchTransfer() {
        var periodObject = $("#PeriodList").data("kendoDropDownList");
        var periodid = periodObject.value();
       
        if (periodid != null) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("BatchtransferGoodSalesOrLend", "InventoryTransactions", new {area = "Finance"})',
                data: { id: periodid },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                beforeSend: function(){
                    // Show image container
                    $("#loading-image").show();
                },
                complete:function(data){
                    // Hide image container
                    $("#loading-image").hide();
                },
                error: function (result) {
                    alert(result);
                }
            });


            $("#grid").data("kendoGrid").dataSource.read();
        } else {
            alert("Please select period.");
        }
        
    }

    function generateDistribution(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("GenerateDistribution", "GoodSellingLending", new { area = "Inventory" })',
            data: {id: id},
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function transfer(id) {
        var desc = prompt("Please enter transaction description:");

        $.ajax({
            type: "POST",
            url: '@Url.Action("TransferDistribution", "GoodSellingLending", new { area = "Inventory" })',
            data: {
                id: id,
                description: desc
            },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
    var storeCode;
    var codeid;

    function onEdit(e) {
        var masterRow = this.wrapper.closest("tr.k-detail-row").prev(".k-master-row");
        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        storeCode = masterDataItem.StoreCode;
        //    codeid = masterDataItem.GoodSellingAndLendingID;
    }


    //}



    function OnIndexCall(elem) {

        var a = codeid;
        $(elem).attr('href', $(elem).attr('href') + '?id=' + a);


    }
   
   
    //function setLang(ItemCode) {
    //    aCode = ItemCode;
    //    $("#ItemCode").val(aCode).trigger("change");
    //}

    function getItems() {
        return {
            storeCode: storeCode
        }
    }
</script>
