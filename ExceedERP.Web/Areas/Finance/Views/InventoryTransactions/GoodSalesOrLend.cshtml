@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Good Sales or lend</legend>

@(Html.Kendo().Grid<GoodSellingAndLending>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.GoodSellingAndLendingID).Title("No.").Width(120).ClientTemplate("#=appendZeros(GoodSellingAndLendingID)#");
          columns.Bound(c => c.SellOrLend).EditorTemplateName("SalesOrLend").Width(100);
          columns.Bound(c => c.StoreCode).EditorTemplateName("Stores").Width(120);
          columns.Bound(c => c.Buyer).Width(120);
          columns.Bound(c => c.BuyerAddress).Width(120);
          columns.Bound(c => c.Date).Width(120);
          columns.Bound(c => c.Remark).Width(90);
          columns.Bound(c => c.Status).Width(90);
      })
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("General_SubLedger_Inventory_BatchTransfer"))
          {
              toolbar.Template(@<text>
                                   <div class="toolbar">

                                       <table>
                                           <tr>
                                               <td>
                                                   <i>Periods:</i>
                                                   @(Html.Kendo().DropDownListFor(m => m)
                                                         .Name("PeriodList")
                                                         .BindTo((IEnumerable) ViewData["PeriodList"])
                                                         .DataTextField("Name")
                                                         .DataValueField("InventoryPeriodId")
                                                         .HtmlAttributes(new {style = "width: 300px;"})
                                                         .ValuePrimitive(true))
                                               </td>
                                               <td>

                                               </td>
                                               <td>

                                                   @(Html.Kendo().Button()
                                                         .Name("btnPost")
                                                         .HtmlAttributes(new {type = "search", @class = "k-primary"})
                                                         .Events(e => e.Click("BatchTransfer"))
                                                         .Content("Batch Transfer"))
                                               </td>
                                           </tr>
                                       </table>

                                   </div>
                                </text>);
          }
      })
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Groupable()
      .Groupable().Events(ev => ev.DetailExpand("detailExpand"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("GoodSellingAndLendingID").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.GoodSellingAndLendingID);
              model.Field(p => p.Status).Editable(false);
              model.Field(p => p.GoodSellingAndLendingID).Editable(false);
          })
          .Read(read => read.Action("GoodSalesOrLend_Read", "InventoryTransactions"))
      ).ClientDetailTemplateId("goodsellordonatetemplate"))


<script id="goodsellordonatetemplate" type="text/Kendo-tmpl">
    @(Html.Kendo().TabStrip().SelectedIndex(0).Name("tabStrip_#=GoodSellingAndLendingID#").Items(items =>
              {
                  items.Add().Text("Detail").Content(
                    @<text>

                        # if (IsOnlineApproved)
                        {#
                        <a href='@Url.Action("GoodSelling", "InventoryPrint",new { area = "Inventory"})/#=GoodSellingAndLendingID#' title="Print"><i class="fa fa-print fa-2x"></i></a>
                        <br />
                        # } #

                        <div>
                            <hr>
                            <dl class="dl-horizontal">
                                <dt>
                                    Good Selling or Lending ID
                                </dt>
                                <dd>
                                    #= GoodSellingAndLendingID #
                                </dd>

                                <dt>
                                    Store
                                </dt>
                                <dd>
                                    #= StoreCode #
                                </dd>

                                <dt>
                                    Status
                                </dt>
                                <dd>
                                    #= Status #
                                </dd>

                               
                                <dt>
                                    Remark
                                </dt>
                                <dd>
                                    #= Remark #
                                </dd>
                                <dt>
                                    CreatedOn
                                </dt>
                                <dd>
                                    #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                </dd>
                                <dt>
                                    CreatedBy
                                </dt>
                                <dd>
                                    #= CreatedBy #
                                </dd>
                                <dt>
                                    Modified By
                                </dt>
                                <dd>
                                    #= ModifiedBy #s
                                </dd>
                                <dt>
                                    Modified Date
                                </dt>
                                <dd>
                                    #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #
                                </dd>
                            </dl>


                        </div>
                    </text>);
                          items.Add().Text("Item").Content(
                            @<text>

                                @(Html.Kendo().Grid<GoodSellingAndLendingItem>()
                                      .Name("GoodSellingAndLendingItem_#=GoodSellingAndLendingID#")
                                      .Columns(columns =>
                                      {
                                          columns.ForeignKey(p => p.ItemCategoryCode, (IEnumerable)ViewData["Category"], "ItemCategoryCode", "Name").Title("Category").EditorTemplateName("ItemCategorySelector").Width(150);
                                          columns.ForeignKey(p => p.ItemCode, (IEnumerable)ViewData["Items"], "ItemCode", "Name").Title("Items").EditorTemplateName("ItemSelector").Width(150);
                                          //columns.Bound(c => c.UOM).EditorTemplateName("UoMDisplay").Width(70); 
                                          columns.Bound(c => c.QuantitySold).Width(70);
                                          columns.Bound(c => c.UnitPurchasingPrice).EditorTemplateName("Currency").Width(70);
                                          columns.Bound(c => c.UnitSellingPrice).EditorTemplateName("Currency").Width(70);
                                          columns.Bound(c => c.TotalSellingPrice).EditorTemplateName("Currency").Width(70);
                                      })

                                      .Events(ev => ev.Edit("onEdit"))
                                      .Events(x => x.DataBound("onDataBoundLines"))
                                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                                      .Scrollable()
                                      .DataSource(dataSource => dataSource
                                          .Ajax()
                                          .Events(ev => ev
                                              .Error("error_handler(\"GoodSellingAndLendingItem_#=GoodSellingAndLendingID#\")")
                                              .RequestStart("onRequestStart(\"GoodSellingAndLendingItem_#=GoodSellingAndLendingID#\")")
                                              .RequestEnd("onRequestEnd(\"GoodSellingAndLendingItem_#=GoodSellingAndLendingID#\")"))

                                          .Model(model => model.Id(p => p.GoodSellingAndLendingItemID))
                                          .Read(read => read.Action("GoodSellingAndLendingItems_Read", "GoodSellingAndLendingItem", new { area = "Inventory", id = "#=GoodSellingAndLendingID#" }))
                                      ).ToClientTemplate())

                            </text>);



                                  items.Add().Text("Validation").Content(
                                    @<text>
                                        @(Html.Kendo().Grid<GoodSellingAndLendingValidation>()
                                              .Name("GoodSellingAndLendingValidation_#=GoodSellingAndLendingID#")
                                              .Columns(columns =>
                                              {
                                                  columns.Bound(c => c.Status).Width(170).EditorTemplateName("ValidationStatus");
                                                  columns.Bound(c => c.Remark).Width(170);

                                              })

                                              .Scrollable()
                                              .Events(x => x.DataBound("onDataBoundFisrtValidation"))
                                              .DataSource(dataSource => dataSource
                                                  .Ajax()
                                                  .Events(ev => ev
                                                      .Error("error_handler(\"GoodSellingAndLendingValidation_#=GoodSellingAndLendingID#\")")
                                                      .RequestStart("onRequestStart(\"GoodSellingAndLendingValidation_#=GoodSellingAndLendingID#\")")
                                                      .RequestEnd("onRequestEnd(\"GoodSellingAndLendingValidation_#=GoodSellingAndLendingID#\")"))

                                                  .Model(model => model.Id(p => p.GoodSellingAndLendingValidationID))
                                                  .Read(read => read.Action("GoodSellingAndLendingValidations_Read", "GoodSellingAndLendingValidation", new { area = "Inventory", id = "#=GoodSellingAndLendingID#" }))
                                              ).ToClientTemplate())

