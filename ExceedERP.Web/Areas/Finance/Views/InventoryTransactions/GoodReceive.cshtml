@using System.Collections
@using ExceedERP.Core.Domain.Inventory

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Good Receive</legend>
@(Html.Kendo().Grid<GoodReceive>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.GoodReceiveId).Title("Receive No.").Width(120).ClientTemplate("#=appendZeros(GoodReceiveId)#");
          columns.ForeignKey(p => p.ReceiveTypeId, (IEnumerable)ViewData["ReeceiveType"], "ReceiveTypeId", "Name").EditorTemplateName("ReceiveTypeSelector").Width(150);
          columns.Bound(p => p.ReceiveRef).EditorTemplateName("ReceiveReferenceSelector").Width(150);
          columns.ForeignKey(p => p.StoreCode, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Width(150).EditorTemplateName("StoreSelectorByKeeper").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(p => p.SupplierName).EditorTemplateName("ReceiveSupplierSelector").Width(150);
          columns.Bound(c => c.SupplierInvoiceNo).Title("Supplier Invoice").Width(150);
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["inventoryPeriods"], "GLPeriodId", "Name").Width(90).Title("Period").EditorTemplateName("InventoryPeriodSelector").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.ReceiveDate).Title("Receive Date").Width(150);
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(150);
          columns.Bound(c => c.Status).Width(150);

      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("General_SubLedger_Inventory_BatchTransfer"))
          {
              toolbar.Template(@<text>
                                   <div class="toolbar">

                                       <table>
                                           <tr>
                                               <td>
                                                   <i>Periods:</i>
                                                   @(Html.Kendo().DropDownListFor(m => m)
                                                         .Name("PeriodList")
                                                         .BindTo((IEnumerable) ViewData["PeriodList"])
                                                         .DataTextField("Name")
                                                         .DataValueField("InventoryPeriodId")
                                                         .HtmlAttributes(new {style = "width: 300px;"})
                                                         .ValuePrimitive(true))
                                               </td>
                                               <td>

                                               </td>
                                               <td>

                                                   @(Html.Kendo().Button()
                                                         .Name("btnPost")
                                                         .HtmlAttributes(new {type = "search", @class = "k-primary"})
                                                         .Events(e => e.Click("BatchTransfer"))
                                                         .Content("Batch Transfer"))
                                               </td>
                                           </tr>
                                       </table>

                                   </div>
                                </text>);
          }
      })
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster").Edit("onMasterEdit"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("GoodReceiveId").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.GoodReceiveId);
              model.Field(p => p.GoodReceiveId).Editable(false);
              model.Field(p => p.Status).Editable(false);
              // model.Field(p => p.ReceiveDate).Editable(false);
              model.Field(p => p.BranchId).Editable(false);

              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.LastModified).Editable(false);

          })
          .Read(read => read.Action("GoodReceives_Read", "InventoryTransactions"))
      )
      .ClientDetailTemplateId("templates"))

