                debugger;
                dataRecive = result;
                dataparamt = result;
                if (result === "Other") {
                    $(".typeselector").hide();
                    $(".supplierSelector").hide();
                    $(".lotselectors").hide();
                }
                if (result === "Tender") {
                    $(".typeselector").show();
