    @*======================================================= GoodReceive Distribution =====================================================*@
    <legend>Distribution</legend>
    # if (IsOnlineApproved && !IsOnlineTransferred && !IsVoid )
    {#
    <a onclick='return transfer("#=GoodReceiveId#")' href=' \#' title="Transfer to GL"><i class="fa fa-paper-plane fa-2x"></i></a>
    &nbsp;&nbsp;&nbsp;
    <a onclick='return generateDistribution("#=GoodReceiveId#")' href=' \#' title="Regenerate Distribution"><i class="fa fa-forward fa-2x"></i></a>
    <br />
    # } #

    @(Html.Kendo().Grid<GoodReceiveDistribution>()
          .Name("GoodReceiveDistribution_#=GoodReceiveId#")
          .Columns(columns =>
          {


              columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(220);
              columns.Bound(c => c.AccountDesc).Width(200);
              columns.Bound(c => c.AdditionalDescription).Width(150);
              columns.Bound(c => c.Debit).Width(100).ClientFooterTemplate("Total Debit: \\#=sum\\# ");
              columns.Bound(c => c.Credit).Width(100).ClientFooterTemplate("Total Credit: \\#=sum\\# ");
              columns.Command(command =>
              {
                  command.Edit();
                  command.Destroy();

              }).ClientFooterTemplate("Difference: \\#=Debit.sum-Credit.sum\\# ");
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create();
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable()
          .Events(x => x.DataBound("onDataBoundDistribution"))
          .DataSource(dataSource => dataSource

              .Ajax()
              .Aggregates(aggregates =>
              {
                  aggregates.Add(p => p.Debit).Sum();
                  aggregates.Add(p => p.Credit).Sum();
              })
              .Events(ev => ev
                  .Error("error_handler(\"GoodReceiveDistribution_#=GoodReceiveId#\")")
                  .RequestStart("onRequestStart(\"GoodReceiveDistribution_#=GoodReceiveId#\")")
                  .RequestEnd("onRequestEnd(\"GoodReceiveDistribution_#=GoodReceiveId#\")"))
              .Model(model =>
              {
                  model.Id(p => p.GoodReceiveDistributionID);
                  model.Field(p => p.AccountDesc).Editable(false);


              })
              .Read(read => read.Action("GoodReceiveDistributions_Read", "GoodReceiveDistribution", new { area = "Inventory", id = "#=GoodReceiveId#" }))
              .Create(create => create.Action("GoodReceiveDistributions_Create", "GoodReceiveDistribution", new { area = "Inventory", id = "#=GoodReceiveId#" }))
              .Update(update => update.Action("GoodReceiveDistributions_Update", "GoodReceiveDistribution", new { area = "Inventory" }))
              .Destroy(destroy => destroy.Action("GoodReceiveDistributions_Destroy", "GoodReceiveDistribution", new { area = "Inventory" }))
          ).ToClientTemplate())

</script>



<script>

    function BatchTransfer() {
        var periodObject = $("#PeriodList").data("kendoDropDownList");
        var periodid = periodObject.value();
       
        if (periodid != null) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("BatchtransferGrn", "InventoryTransactions", new {area = "Finance"})',
                data: { id: periodid },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                beforeSend: function(){
                    // Show image container
                    $("#loading-image").show();
                },
                complete:function(data){
                    // Hide image container
                    $("#loading-image").hide();
                },
                error: function (result) {
                    alert(result);
                }
            });


            $("#grid").data("kendoGrid").dataSource.read();
        } else {
            alert("Please select period.");
        }
        
    }

    function generateDistribution(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("GenerateDistribution", "GoodReceive", new { area = "Inventory" })',
            data: {id: id},
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function transfer(id) {
        var desc = prompt("Please enter transaction description:");

        $.ajax({
            type: "POST",
            url: '@Url.Action("TransferDistribution", "GoodReceive", new { area = "Inventory" })',
            data: {
                id: id,
                description: desc
            },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


