                                                  .RequestStart("onRequestStart(\"IssueFuelValidation#=IssueID#\")")
                                                  .RequestEnd("onRequestEnd(\"IssueFuelValidation#=IssueID#\")"))
                                              .Model(model => model.Id(p => p.IssueValidationID))
                                              .Read(read => read.Action("IssueFuelValidations_Read", "IssueFuelValidation", new { area = "Inventory", id = "#=IssueID#" }))

