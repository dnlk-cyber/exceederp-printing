                                </dd>
                                <dt>
                                    Store
                                </dt>
                                <dd>
                                    #= StoreCode #
                                </dd>

                                <dt>
                                    Work Unit
                                </dt>
                                <dd>
                                    #= OrgStructureId #
                                </dd>
                                <dt>
                                    Project
                                </dt>
                                <dd>
                                    #= BranchId #
                                </dd>
                                <dt>
                                    Machine Reading KM.
                                </dt>
                                <dd>
                                    #= ReadingKM #
                                </dd>
                                <dt>
                                    Issue Date
                                </dt>
