    <legend>Distribution</legend>
    # if (IsOnlineApproved && !IsOnlineTransferred && !IsVoid  )
    {#
    <a onclick='return transferToGl("#=IssueID#")' href=' \#' title="Transfer to GL"><i class="fa fa-paper-plane fa-2x"></i></a>
    &nbsp;&nbsp;&nbsp;
    <a onclick='return generateDistribution("#=IssueID#")' href=' \#' title="Regenerate Distribution"><i class="fa fa-forward fa-2x"></i></a>
    
    <br />
    # } #
    @(Html.Kendo().Grid<IssueDistribution>()
          .Name("IssueDistribution_#=IssueID#")
          .Columns(columns =>
          {


              columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(220);
              columns.Bound(c => c.AccountDesc).Width(200);
              columns.Bound(c => c.AdditionalDescription).Width(150);
              columns.Bound(c => c.Debit).Width(100).ClientFooterTemplate("Total Debit: \\#=sum\\# ");
              columns.Bound(c => c.Credit).Width(100).ClientFooterTemplate("Total Credit: \\#=sum\\# ");
              columns.Command(command =>
              {
                  command.Edit();
                  command.Destroy();

              }).ClientFooterTemplate("Difference: \\#=Debit.sum-Credit.sum\\# ");
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create();
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable()
          .Events(x => x.DataBound("onDataBoundDistribution"))
          .DataSource(dataSource => dataSource

              .Ajax()
              .Events(ev => ev
                  .Error("error_handler(\"IssueDistribution_#=IssueID#\")")
                  .RequestStart("onRequestStart(\"IssueDistribution_#=IssueID#\")")
                  .RequestEnd("onRequestEnd(\"IssueDistribution_#=IssueID#\")"))
              .Aggregates(aggregates =>
              {
                  aggregates.Add(p => p.Debit).Sum();
                  aggregates.Add(p => p.Credit).Sum();
              })
              .Model(model =>
              {
                  model.Id(p => p.IssueDistributionID);
                  model.Field(p => p.AccountDesc).Editable(false);
                  model.Field(p => p.Debit).Editable(false);
                  model.Field(p => p.Credit).Editable(false);
              })
              .Read(read => read.Action("IssueDistributions_Read", "IssueDistribution", new { area = "Inventory", id = "#=IssueID#" }))
              .Create(create => create.Action("IssueDistributions_Create", "IssueDistribution", new { area = "Inventory", id = "#=IssueID#" }))
              .Update(update => update.Action("IssueDistributions_Update", "IssueDistribution", new { area = "Inventory" }))
              .Destroy(destroy => destroy.Action("IssueDistributions_Destroy", "IssueDistribution", new { area = "Inventory" }))
          ).ToClientTemplate())
</script>

<script>

    function BatchTransfer() {
        var periodObject = $("#PeriodList").data("kendoDropDownList");
        var periodid = periodObject.value();
       
        if (periodid != null) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("BatchtransferIssueFuel", "InventoryTransactions", new {area = "Finance"})',
                data: { id: periodid },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                beforeSend: function(){
                    // Show image container
                    $("#loading-image").show();
                },
                complete:function(data){
                    // Hide image container
                    $("#loading-image").hide();
                },
                error: function (result) {
                    alert(result);
                }
            });


            $("#grid").data("kendoGrid").dataSource.read();
        } else {
            alert("Please select period.");
        }
        
    }
    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");

        $.ajax({
            type: "POST",
            url: '@Url.Action("TransferDistribution", "IssueFuel", new { area = "Inventory" })',
            data: {
                id: id,
                description: desc
            },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function generateDistribution(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("GenerateDistribution", "IssueFuel", new { area = "Inventory" })',
            data: {id: id},
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function onSelectOwnerType(e) {

        var grid = $("#grid").data("kendoGrid");
        var owner = $("#Owner").data("kendoDropDownList");
        var ownerValue = owner.value();
        if (ownerValue === "1") {
            grid.hideColumn("SupplierAccountCode");
            grid.showColumn("PlateNo");
        } else if (ownerValue === "0") {
            grid.hideColumn("PlateNo");
            grid.showColumn("SupplierAccountCode");
        }
    }
    function onMasterEdit(e) {
        var grid = $("#grid").data("kendoGrid");
        grid.hideColumn("SupplierAccountCode");
        grid.hideColumn("ReadingKM");

        if (e.model.isNew() === false) {
            $("#StoreRequisitionID").kendoDropDownList({
                enable: false
            });

        }

    }
    function checkboxClicked(e) {

        var isChecked = e.checked;
        var grid = $("#grid").data("kendoGrid");
        if (isChecked) {

            grid.showColumn("ReadingKM");
        } else {
            grid.hideColumn("ReadingKM");
        }

    };


    function onItemEdit(e) {


    }


