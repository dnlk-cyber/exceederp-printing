@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Fuel Issue</legend>

@(Html.Kendo().Grid<Issue>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.IssueID).Title("Issue No.").Width(110).ClientTemplate("#=appendZeros(IssueID)#");
          columns.Bound(c => c.StoreRequisitionID).Title("SR No.").EditorTemplateName("FuelRequisitionSelector").Width(160);
          columns.Bound(c => c.StoreCode).Width(130).EditorTemplateName("StoreReadOnly");
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["inventoryPeriods"], "GLPeriodId", "Name").Width(90).Title("Period").EditorTemplateName("InventoryPeriodSelector");
          columns.Bound(c => c.IssueDate).Title("Issue Date").Width(130);
          columns.Bound(c => c.Owner).Width(130).EditorTemplateName("InternalOrExternal");
          columns.Bound(c => c.PlateNo).Title("Plate No.").Width(130);
          columns.Bound(c => c.Reference).Title("Issue Reference").Width(90);
          columns.Bound(c => c.SupplierAccountCode).Title("Supplier Account").EditorTemplateName("AccountCode").Width(220);
          columns.Bound(c => c.HasReading).Width(130).EditorTemplateName("HasReading").ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= HasReading #' " +
              "# if (HasReading) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.ReadingKM).Title("Reading KM").Width(130);
          columns.Bound(c => c.Remark).Width(150);
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(160).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(180);
          columns.Bound(c => c.Status).Width(110);

      })

      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("General_SubLedger_Inventory_BatchTransfer"))
          {
              toolbar.Template(@<text>
                                   <div class="toolbar">

                                       <table>
                                           <tr>
                                               <td>
                                                   <i>Periods:</i>
                                                   @(Html.Kendo().DropDownListFor(m => m)
                                                         .Name("PeriodList")
                                                         .BindTo((IEnumerable) ViewData["PeriodList"])
                                                         .DataTextField("Name")
                                                         .DataValueField("InventoryPeriodId")
                                                         .HtmlAttributes(new {style = "width: 300px;"})
                                                         .ValuePrimitive(true))
                                               </td>
                                               <td>

                                               </td>
                                               <td>

                                                   @(Html.Kendo().Button()
                                                         .Name("btnPost")
                                                         .HtmlAttributes(new {type = "search", @class = "k-primary"})
                                                         .Events(e => e.Click("BatchTransfer"))
                                                         .Content("Batch Transfer"))
                                               </td>
                                           </tr>
                                       </table>

                                   </div>
                                </text>);
          }
      })
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Groupable()
      .Groupable()
      .Events(ev => ev.DetailExpand("detailExpand").Edit("onMasterEdit"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))

          .Model(model =>
          {
              model.Id(p => p.IssueID);
              model.Field(p => p.IssueID).Editable(false);
              model.Field(p => p.IssueDate).Editable(false);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.OrgStructureId).Editable(false);
              model.Field(p => p.Status).Editable(false);

              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.LastModified).Editable(false);

          })
          .Read(read => read.Action("IssueFuels_Read", "InventoryTransactions"))
      ).ClientDetailTemplateId("issuefueltemplate"))

