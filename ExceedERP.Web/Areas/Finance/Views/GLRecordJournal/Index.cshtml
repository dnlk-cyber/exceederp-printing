@using ExceedERP.Core.Domain.Finance.GL
@using System.Collections
<legend>Journal</legend>
@(Html.Kendo().Grid<GlRecordJournal>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.Bound(c => c.GlRecordJournalId).Title("ID").Width(100).ClientTemplate("#=appendZeros(GlRecordJournalId)#");
              columns.Bound(c => c.JournalName).Width(150);
              columns.Bound(c => c.Description).Width(150);
              columns.Bound(c => c.PeriodName).Width(130).EditorTemplateName("OpenGlPeriodSelector");
              columns.Bound(c => c.CategoryName).Width(130).EditorTemplateName("GLCategory");
              columns.Bound(c => c.JournalNumber).Title("Reference").Width(120);
              columns.Bound(c => c.EffectiveDate).Title("Date").Width(130);
              columns.Bound(c => c.IsVoidDoc).Width(100).Title("Is Void Doc").ClientTemplate(
                  "<input type='checkbox' disabled = 'false' value='#= IsVoidDoc #' " +
                  "# if (IsVoidDoc) { #" +
                  "checked='checked'" +
                  "# } #" +
                  "/>"
                  );
              columns.Bound(c => c.DebitSum).Width(100).Format("{0:n}");
              columns.Bound(c => c.CreatedBy).Width(120);
              columns.Bound(c => c.PaymentReference).Width(100).Title("Pay. Ref.");
              columns.Bound(c => c.InvoiceReferenceDoc).Width(100).Title("Invoice Ref");
              columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Width(100).Title("Branch");
              columns.Bound(c => c.Remark).Width(100);
              columns.Bound(c => c.Status).Width(100);



              columns.Command(command =>
              {

                  command.Edit();
                  command.Destroy();
                  //command.Custom("Send").Click("SendforApproval");
                  //command.Custom("Reverse").Click("Reverse");
                  //command.Custom("Post").Click("PostrJournal");
              }).Width(180);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create();
              toolbar.Excel();
              // toolbar.Pdf();
          })

          .Editable(editable => editable.Mode(GridEditMode.InLine))
       .HtmlAttributes(new { style = "height: 550px;" })
            .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(20))
            .Scrollable()
                 .Selectable(selectable =>
                 {
                     selectable.Mode(GridSelectionMode.Single);
                     selectable.Type(GridSelectionType.Row);
                 })
                            .Sortable(sortable =>
                            {
                                sortable.SortMode(GridSortMode.SingleColumn);
                            })
            .Filterable()
            .ColumnMenu()

           .Events(ev => ev.DetailExpand("detailExpand"))
           .Scrollable(h => h.Height(500))
           .Events(x => x.DataBound("onDataBoundMaster"))
            .ClientDetailTemplateId("templates")
          .DataSource(dataSource => dataSource
              .Ajax()
                  .Sort(sort => sort.Add("GlRecordJournalId").Descending())
              .Events(ev => ev
                  .Error("error_handler(\"grid\")")
                  .RequestStart("onRequestStart(\"grid\")")
                  .RequestEnd("onRequestEnd(\"grid\")"))
              .PageSize(20)
            .Model(
                model =>
                {
                    model.Id(p => p.GlRecordJournalId);
                    model.Field(p => p.GlRecordJournalId).Editable(false);
                    model.Field(p => p.VoidTime).Editable(false);
                    model.Field(p => p.VoidBy).Editable(false);
                    model.Field(p => p.isVoid).Editable(false);
                    model.Field(p => p.OnlineApprovedTime).Editable(false);
                    model.Field(p => p.OnlineApprovedBy).Editable(false);
                    model.Field(p => p.IsOnlineApproved).Editable(false);
                    model.Field(p => p.Status).Editable(false);
                    model.Field(p => p.IsSendForApproval).Editable(false);
                    model.Field(p => p.isPosted).Editable(false);
                    model.Field(p => p.IsUnPosted).Editable(false);
                    model.Field(p => p.isReversed).Editable(false);
                    model.Field(p => p.Posting).Editable(false);
                    model.Field(p => p.IsNonFuncCurrency).Editable(false);

                    model.Field(p => p.SourcesName).Editable(false);
                    model.Field(p => p.FiscalYear).Editable(false);
                    model.Field(p => p.DebitSum).Editable(false);

                    model.Field(p => p.InvoiceReferenceDoc).Editable(false);
                    model.Field(p => p.ReferenceDoc).Editable(false);
                    model.Field(p => p.PaymentReference).Editable(false);

                    model.Field(p => p.BranchId).Editable(false);
                    model.Field(p => p.BusinessUnitId).Editable(false);
                    model.Field(p => p.OrgBranchName).Editable(false);
                    model.Field(p => p.CreatedBy).Editable(false);
                    model.Field(p => p.ModifiedBy).Editable(false);
                    model.Field(p => p.LastModified).Editable(false);
                    model.Field(p => p.DateCreated).Editable(false);


                })

              .Read(read => read.Action("GLRecordJournals_Read", "GLRecordJournal"))
              .Create(create => create.Action("GLRecordJournals_Create", "GLRecordJournal"))
              .Update(update => update.Action("GLRecordJournals_Update", "GLRecordJournal"))
              .Destroy(destroy => destroy.Action("GLRecordJournals_Destroy", "GLRecordJournal"))
          )

)



<script id="templates" type="text/kendo-tmpl">
	@(Html.Kendo().TabStrip()
					.Name("tabStrip#=GlRecordJournalId#")
					.SelectedIndex(0)
					.Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
					.Items(items =>
					{
						items.Add().Text("Journal Detail").Content(@<text>

							<div>
								<p><b>Record Status :#= Status #</b></p>
								# if (!IsOnlineApproved&&!IsSendForApproval)
								{#
								<a onclick='return sendForApproval("#=GlRecordJournalId#")' href=' \#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>

								# } #



								<a target="new" title="Print" href='@Url.Action("GlJournalVoucher", "FinancePrint")/#=GlRecordJournalId#'> <i class="fa fa-print fa-2x"></i>Print</a>
								<br />

								# if (IsOnlineApproved && !isPosted && !IsVoidDoc )
								{#

								<p align="right"><a title="Reverse" href='@Url.Action("Reverse", "GLRecordJournal")/#=GlRecordJournalId#'><i class="fa fa-backward fa-2x"></i>Reverse</a> <br /></p>

								# } #

								@*# if (IsOnlineApproved && !isPosted )
									{#
									<a title="Post" href='@Url.Action("PostLedger", "GLRecordJournal")/#=GlRecordJournalId#'> <i class="fa fa-caret-square-o-down fa-2x"></i>Post</a>
									# } #*@


							</div>
							<div>
								<hr>
								<dl class="dl-horizontal">


									<dt>
										Created On
									</dt>
									<dd>
										#=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

									</dd>
									<dt>
										Created By
									</dt>
									<dd>
										#= CreatedBy #
									</dd>
									<dt>
										Modified By
									</dt>
									<dd>
										#= ModifiedBy #
									</dd>
									<dt>
										Modified Date
									</dt>
									<dd>
										#=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #
									</dd>
								</dl>
							</div>

						</text>
							);
							items.Add().Text("Journal Lines").Content(@<text>
								@(Html.Kendo().Grid<GLRecordJournalDetail>()
											  .Name("GLRecordJournalDetail#=GlRecordJournalId#")
											  .Columns(columns =>
											  {
													  columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(80);
													  columns.Bound(c => c.AccountDesc).Title("Account Description").Width(180);
													  columns.Bound(c => c.AdditionalDescription).Title("Description").Width(80);
													  columns.Bound(c => c.Debit).Width(50).Format("{0:n}").ClientFooterTemplate("\\#=kendo.toString(sum, 'n')\\# ");
													  columns.Bound(c => c.Credit).Width(50).Format("{0:n}").ClientFooterTemplate("\\#=kendo.toString(sum, 'n')\\# ");
													  columns.Command(command =>
													  {

														  command.Edit(); command.Destroy();

													  }).Width(180).ClientFooterTemplate("Difference: \\#=Debit.sum-Credit.sum\\# ");
												  })
											  .ToolBar(toolbar =>
											  {
													  toolbar.Create();
												  })

											  .Editable(editable => editable.Mode(GridEditMode.InLine))
											  .Pageable(pageable => pageable
												  .Input(true)
												  .Numeric(false)
												  .Refresh(true)
												  .PageSizes(true)
												  .ButtonCount(10))
											  .Scrollable()
											  .Sortable()
											  .Filterable()
											  .Events(x => x.DataBound("onDataBoundLines"))
											  .DataSource(dataSource => dataSource
												  .Ajax()
												  .Sort(sort => sort.Add("Debit").Descending())
												  .Aggregates(aggregates =>
												  {
														  aggregates.Add(p => p.Debit).Sum();
														  aggregates.Add(p => p.Credit).Sum();
													  })
												  .Model(
													  model =>
													  {
															  model.Id(p => p.GlRecordJournalDetailId);
															  model.Field(p => p.AccountDesc).Editable(false);
															  model.Field(p => p.OrgBranchName).Editable(false);
															  model.Field(p => p.CreatedBy).Editable(false);
															  model.Field(p => p.ModifiedBy).Editable(false);
															  model.Field(p => p.LastModified).Editable(false);
															  model.Field(p => p.DateCreated).Editable(false);
														  })
												  .Events(ev => ev
													  .Error("error_handler(\"GLRecordJournalDetail#=GlRecordJournalId#\")")
													  .RequestStart("onRequestStart(\"GLRecordJournalDetail#=GlRecordJournalId#\")")
													  .RequestEnd("onRequestEndWithAddRow(\"GLRecordJournalDetail#=GlRecordJournalId#\")"))
												  .Read(read => read.Action("GLRecordJournalDetails_Read", "GlRecordJournalLines", new { id = "#=GlRecordJournalId#" }))
												  .Create(create => create.Action("GLRecordJournalDetails_Create", "GlRecordJournalLines", new { id = "#=GlRecordJournalId#" }))
												  .Update(update => update.Action("GLRecordJournalDetails_Update", "GlRecordJournalLines", new { id = "#=GlRecordJournalId#" }))
												  .Destroy(destroy => destroy.Action("GLRecordJournalDetails_Destroy", "GlRecordJournalLines"))
											  )

											  .ToClientTemplate())
							</text>);

								items.Add().Text("Validation").Content(
									@<text>
										@(Html.Kendo().Grid<GLRecordJournalValidation>()
													  .Name("GLRecordJournalValidation#=GlRecordJournalId#")
													  .Columns(columns =>
													  {
															  columns.Bound(c => c.GlRecordJournalValidationId).Hidden(true);
															  columns.Bound(c => c.Status).EditorTemplateName("ApprovalStatus").Width(150);
															  columns.Bound(c => c.Remark).Width(200);

															  columns.Bound(c => c.DateCreated).Width(200).Title("Time").Format("{0:dd/MM/yyyy}");
															  columns.Bound(c => c.LastModified).Hidden(true);
															  columns.Bound(c => c.CreatedBy).Width(200).Title("User");
															  columns.Bound(c => c.ModifiedBy).Hidden(true);
															  columns.Command(command =>
															  {
																  command.Edit();

															  });

														  })
													  .ToolBar(toolbar =>
													  {
															  toolbar.Create();
														  })
													  .Editable(editable => editable.Mode(GridEditMode.InLine))
													  .Events(x => x.DataBound("onDataBoundFisrtValidation"))

													  .DataSource(dataSource => dataSource
														  .Ajax()
														  .Model(
															  model =>
															  {
																	  model.Id(p => p.GlRecordJournalValidationId);
																	  model.Field(p => p.OrgBranchName).Editable(false);
																	  model.Field(p => p.CreatedBy).Editable(false);
																	  model.Field(p => p.ModifiedBy).Editable(false);
																	  model.Field(p => p.LastModified).Editable(false);
																	  model.Field(p => p.DateCreated).Editable(false);
																  })
														  .Events(events => events
															  .Error("error_handler_one")
															  .Sync("sync_handler"))
														  .Read(read => read.Action("GLRecordJournalValidations_Read", "GlRecordJournalValidation", new { id = "#=GlRecordJournalId#" }))
														  .Create(create => create.Action("GLRecordJournalValidations_Create", "GlRecordJournalValidation", new { id = "#=GlRecordJournalId#" }))
														  .Update(update => update.Action("GLRecordJournalValidations_Update", "GlRecordJournalValidation", new { id = "#=GlRecordJournalId#" }))
														  .Destroy(destroy => destroy.Action("GLRecordJournalValidations_Destroy", "GlRecordJournalValidation"))
													  )
													  .ToClientTemplate())

									</text>);
								})

									.ToClientTemplate()
	)

</script>





<script>

	function sendForApproval(id) {
		var recordStatus = "";

		$.ajax({
			type: "POST",
			url: '@Url.Action("SendforApproval", "GlRecordJournal", new { area = "Finance" })',
			data: { id: id },
			success: function (result) {
				//toastr.success(result.Message);
				alert(result.Message);
				recordStatus = result.Status;
				location.reload(true);
			}, //end succ
			error: function (result) {
				alert(result);
			}
		});
	}

	$("a.sending").click(function (event) {
		//alert("sent");
		//event.preventDefault();

		var item = $(this).text();//$(this).attr('id');
		$.ajax({
			url: '/Finance/JSON/Description',
			type: 'POST',
			data: { id: item },
			success: function (result) {
				if (result.length > 0) {
					for (var i = 0; i < result.length; i++) {
						$("#DescriptionArea").text('');
						$("<a>")
							.append(result[i].Description)
							.appendTo("#DescriptionArea");
					}
				}
				else {
					alert("Description not found");
				}

			}, //end succ
			error: function (result) {
				alert(result);
			}
		}); //end post
	});//end of click

	function PostrJournal(e) {
		var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
		var id = dataItem.GlRecordJournalId;
		$.ajax({
			type: "GET",
			data: id,
			url: '@Url.Action("PostLedger", "GlRecordJournal")/' + id

		});

		$('#grid').data('kendoGrid').dataSource.read();
		$('#grid').data('kendoGrid').refresh();
		location.reload();
	};

	function SendforApproval(e) {
		var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
		var id = dataItem.GlRecordJournalId;
		$.ajax({
			type: "GET",
			data: id,
			url: '@Url.Action("SendforApproval", "GlRecordJournal")/' +id

		});

		$('#grid').data('kendoGrid').dataSource.read();
		$('#grid').data('kendoGrid').refresh();
		location.reload();
	};

	function Reverse(e) {
		var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
		var id = dataItem.GlRecordJournalId;
		$.ajax({
			type: "GET",
			data:id,
			url: '@Url.Action("Reverse", "GlRecordJournal")/' + id

		});

		$('#grid').data('kendoGrid').dataSource.read();
		$('#grid').data('kendoGrid').refresh();
		location.reload();
	};


	function onSelectedPeriod() {
		var periodName = $("#PeriodName").data("kendoDropDownList").value();
		var min = "";
		var max = "";

		$.ajax({
			type: "POST",
			url: '@Url.Action("GetPeriodDateRangeByName", "FinanceDataProvider", new { area = "Finance" })',
			data: { name: periodName },
			success: function (result) {
				min = result.Min;
				max = result.Max;
				//update
				var datepicker = $("#EffectiveDate").data("kendoDatePicker");
				datepicker.setOptions({
					format: "yyyy-MM-dd",
					min:min,
					max:max,
					value: new Date(),
					change: onDOBChange
				});
			}, //end succ
			error: function (result) {
				alert(result);
			}

		});


	}

	function sync_handler(e) {
		var parentData = $('#grid').data("kendoGrid");
		parentData.dataSource.read();
	}



</script>




