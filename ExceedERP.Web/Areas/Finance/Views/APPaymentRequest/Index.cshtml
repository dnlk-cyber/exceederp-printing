<script>
    function GetBalance() {

        $("#LeaveBalance").val(0);
        var employee = $("#EmployeeId").data("kendoDropDownList");
        var empId = employee.value();
        var periods = $("#GlFiscalYearId").data("kendoDropDownList");
        var period = periods.value();

        if (empId.length !== 0 && period.length !== 0)
        {

            $.ajax({
                url: '@Url.Action("GetAmount", "LeaveRequest")',

                data: { period: period, empId: empId },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    var s = r.split(/-/);

                    $("#LeaveBalance").val(s[0]);
                    $("#LeaveBalance").trigger("change");
                }

            });
        }
        else
        {

            $.ajax({
                url: '@Url.Action("GetCurrentEmpBalance", "LeaveRequest")',

                data: { period: period },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    var s = r.split(/-/);

                    $("#LeaveBalance").val(s[0]);
                    $("#LeaveBalance").trigger("change");
                }

            });
        }
    }

</script>
<script>

    function filterEmployees() {
        return {
            text: $("#EmployeeId").data("kendoDropDownList").filterInput.val(),
        }
    }

    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#LeaveRequestgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.LeaveRequestId;
        var gridName = "#RequestesStatusgrid_" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatus", "LeaveRequestStatus")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                }
                else if (r == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else if (r == "Dapproved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", gridName).show();
                }

            }

        });

    }
    function SetEmployee(e) {
        var x = e.checked;
        var dropDown = $("#EmployeeId").data("kendoDropDownList");
        if (x == true) {
            $("#LeaveBalance").val(0);
            $("#LeaveBalance").trigger("change");
            dropDown.enable(true);


        }
        else {
            dropDown.value(0);
            dropDown.enable(false);
        }
        $.ajax({
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("SetEmployee", "LeaveRequest")',
            data: { x: x },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
                if (x==true && r == "0")
                {
                    e.checked = false;
                    dropDown.value(0);
                    dropDown.enable(false);
                    alert("You can not request for other employee!!.\nThere is no employee under your postion.");
                }
              //  $("#EmployeeId").data('kendoComboBox').dataSource.read();
                //$("#EmployeeId").data('kendoComboBox').refresh();
            }

        });


    }
    function valueMapper(options) {
        $.ajax({
            url: "/HRM/HRMDataProvider/Employee_ValueMapper/",
            data: {
                value: options.value || 0,
                status: 1,
                excludeId: -1
            },
            success: function (data) {
                options.success(data);
            }
        });
    }

    function convertValues(value) {
        var data = {};

        value = $.isArray(value) ? value : [value];

        for (var idx = 0; idx < value.length; idx++) {
            data["values[" + idx + "]"] = value[idx];
        }

        return data;
    }
    function IsforOthers() {
        return {
            IsForOther: $("#IsForOther").val()
        };
    }

    function onUploadSuccess(e) {
        var gridname = "#PaymentRequestAttachment" + codeid;
        $(gridname).data("kendoGrid").dataSource.read();
    }

</script>