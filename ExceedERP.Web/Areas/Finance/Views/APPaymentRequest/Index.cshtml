<legend>Payment Reqeust</legend>
@(Html.Kendo().Grid<PaymentRequest>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.Bound(c => c.PaymentRequestId).Title("#").Width(100).ClientTemplate("#=appendZeros(PaymentRequestId)#");
              columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("EmployeeSelector").Width(200).Filterable(ftb => ftb.Multi(true).Search(true));
              if (GlobalHelper.IsPayrollModebranchAndBusinessUnit())
              {
                  columns.ForeignKey(c => c.FromBusinessUnitId, (IEnumerable)ViewData["BusinessUnits"], "BusinessUnitId", "Name").Width(180).EditorTemplateName("BusinessUnitSelector").Filterable(ftb => ftb.Multi(true).Search(true));
              }
              columns.ForeignKey(c => c.FromBranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").Width(180).EditorTemplateName("AllBranchSelector").Filterable(ftb => ftb.Multi(true).Search(true));
              columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.ForeignKey(c => c.OrgStuructureId, (IEnumerable)ViewData["OrgStructure"], "OrgStructureId", "Name").Width(200).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.SupplierId).Width(130).EditorTemplateName("SupplierSelector");
              columns.Bound(c => c.IsNewSupplier).Width(100).Title("New Supplier").ClientTemplate(
                  "<input type='checkbox' disabled = 'true' value='#= IsNewSupplier #' " +
                  "# if (IsNewSupplier) { #" +
                  "checked='checked'" +
                  "# } #" +
                  "/>"
                  );
              columns.Bound(c => c.Supplier).Width(150);
              columns.Bound(c => c.Purchaser).Width(100).EditorTemplateName("PurchaserSelector");
              columns.Bound(c => c.ReasonOfPayment).Width(100);
              columns.Bound(c => c.RequestDate).Width(120);
              columns.Bound(c => c.InvoiceNo).Width(110);
              columns.Bound(c => c.PurchaseRequestNo).Width(100);
              columns.Bound(c => c.PONo).Width(150);
              columns.Bound(c => c.GRN).Width(100);
              columns.Bound(c => c.Remark).Width(100);
              columns.Bound(c => c.Status).Width(150);
              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(190);
          })
          .ToolBar(toolbar =>
          {
              //toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))

          .Sortable(sortable =>
          {
              sortable.SortMode(GridSortMode.SingleColumn);
          })
          .Filterable()

          .Pageable(pageable => pageable
              .Input(true)
              .Numeric(false)
              .Refresh(true)
              .PageSizes(true)
              .ButtonCount(5))
          .Events(ev => ev.DetailExpand("detailExpand"))
          .Events(x => x.DataBound("onDataBoundMaster"))
           .Scrollable(h => h.Height(500))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Sort(sort => sort.Add("PaymentRequestId").Descending())
              .Events(events =>
              {
                  events.Error("error_handler(\"grid\")");
                  events.RequestStart("onRequestStart(\"grid\")");
                  events.RequestEnd("onRequestEnd(\"grid\")");
              })
              .Model(
              model =>
              {
                  model.Id(p => p.PaymentRequestId);
                  model.Field(p => p.PaymentRequestId).Editable(false);
                  model.Field(p => p.BranchId).Editable(false);
                  model.Field(p => p.BusinessUnitId).Editable(false);
                  model.Field(p => p.Paid).Editable(false);
                  model.Field(p => p.FromBusinessUnitId).Editable(false);
                  model.Field(p => p.FromBranchId).Editable(false);
                  model.Field(p => p.CreatedAtBranchId).Editable(false);
                  model.Field(p => p.CreatedAtBusinessUnitId).Editable(false);
                  model.Field(p => p.CreatedAtOrgStructureId).Editable(false);

                  model.Field(p => p.BudgetApprovedBy).Editable(false);
                  model.Field(p => p.IsBudgetApproved).Editable(false);
                  model.Field(p => p.BudgetApprovedTime).Editable(false);

                  model.Field(p => p.CurrentApprovalStep).Editable(false);

                  model.Field(p => p.Paid).Editable(false);
                  model.Field(p => p.PaymentAmount).Editable(false);
                  model.Field(p => p.AmountDue).Editable(false);

                  model.Field(p => p.OrgBranchName).Editable(false);

                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
                  model.Field(p => p.Status).Editable(false);

              })
              .Read(read => read.Action("PaymentRequest_Read", "ApPaymentRequest"))
              .Create(create => create.Action("PaymentRequest_Create", "ApPaymentRequest"))
              .Update(update => update.Action("PaymentRequest_Update", "ApPaymentRequest"))
              .Destroy(destroy => destroy.Action("PaymentRequest_Destroy", "ApPaymentRequest"))
          ).ClientDetailTemplateId("template"))


