<script>
    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "ApPaymentRequest", new {area = "Finance"})',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ApPaymentRequest", new { area = "Finance" })',
            data: { id: id },
            success: function(result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function(result) {
                alert(result);
            }
        });
    }
</script>
