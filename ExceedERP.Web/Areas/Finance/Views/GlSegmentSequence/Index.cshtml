
<legend>Account Segment Sequence</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.GL.GlSegmentSequence>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.FirstSegment).EditorTemplateName("SegmentTypes");
          columns.Bound(c => c.SecondSegment).EditorTemplateName("SegmentTypes");
          columns.Bound(c => c.ThirdSegment).EditorTemplateName("SegmentTypes");
          columns.Bound(c => c.FourthSegment).EditorTemplateName("SegmentTypes");
          columns.Bound(c => c.DateCreated).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.LastModified).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
          columns.Command(command => { command.Edit(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              if (ViewBag.Count <= 0)
                              {toolbar.Create();
                              }
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Sortable()
      .Filterable()
      .Groupable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(
              model =>
              {
                  model.Id(p => p.GlSegmentSequenceId);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);


              })
          .Events(events => events
              .Error("error_handler_one")
              .Sync("sync_handler"))
          .Read(read => read.Action("GlSegmentSequences_Read", "GlSegmentSequence"))
          .Create(create => create.Action("GlSegmentSequences_Create", "GlSegmentSequence"))
          .Update(update => update.Action("GlSegmentSequences_Update", "GlSegmentSequence"))
      ))
