<legend>Petty Cash</legend>
@(Html.Kendo().Grid<ApPettyCash>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.Bound(c => c.ApPettyCashId).ClientTemplate("#=appendZeros(ApPettyCashId)#").Width(100).Title("ID");
              columns.ForeignKey(p => p.ApCashierSetupId, (IEnumerable)ViewData["cashiers"], "ApCashierSetupId", "Description").Width(120).EditorTemplateName("CashierSelector");
              columns.Bound(c => c.PurposeOfPayment).Width(200);
              columns.Bound(c => c.Date).Width(120);
              columns.Bound(c => c.Reference).Width(120);
              columns.Bound(c => c.Status).Width(90);
              columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create();
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
           .HtmlAttributes(new { style = "height: 550px;" })
                .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(20))
                .Scrollable()
                .Sortable()
                .Filterable()
                    .Selectable(selectable =>
                    {
                        selectable.Mode(GridSelectionMode.Single);
                        selectable.Type(GridSelectionType.Row);
                    })
                .Sortable(sortable =>
                {
                    sortable.SortMode(GridSortMode.SingleColumn);
                })
                
                 .Events(ev => ev.Edit("onMasterEdit"))
                 .Events(ev => ev.DetailExpand("detailExpandMasterNew"))
                .Scrollable(h => h.Height(500))
                 .Events(x => x.DataBound("onDataBoundMasterNew"))
          .DataSource(dataSource => dataSource
              .Ajax()
                .Sort(sort => sort.Add("ApPettyCashId").Descending())
                                       .Events(ev => ev
                                                                .Error("error_handler(\"grid\")")
                                                                .RequestStart("onRequestStart(\"grid\")")
                                                                .RequestEnd("onRequestEnd(\"grid\")"))
              .Model(model =>
              {
                  model.Id(p => p.ApPettyCashId);
                  model.Field(p => p.ApPettyCashId).Editable(false);
                  model.Field(p => p.Status).Editable(false);
                  
                  model.Field(p => p.CurrentBalance).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
              })
              .Read(read => read.Action("ApPettyCash_Read", "ApPettyCash"))
              .Create(create => create.Action("ApPettyCash_Create", "ApPettyCash"))
              .Update(update => update.Action("ApPettyCash_Update", "ApPettyCash"))
              .Destroy(destroy => destroy.Action("ApPettyCash_Destroy", "ApPettyCash"))
          ).ClientDetailTemplateId("detailtemplate")
)

