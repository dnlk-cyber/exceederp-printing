@using ExceedERP.Core.Domain.Finance.GL
<legend>Fiscal Year</legend>
@(Html.Kendo().Grid<GlFiscalYear>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.GlFiscalYearId).Hidden(true);
          columns.Bound(c => c.Name).Width(150);
          columns.Bound(c => c.DateFrom).Width(150);
          columns.Bound(c => c.DateTo).Width(150);
          columns.Bound(c => c.Status).EditorTemplateName("PeriodStatus").Width(100);

          columns.Bound(c => c.OrgBranchName).Width(120).Hidden(true);
          columns.Bound(c => c.DateCreated).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.LastModified).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
          columns.Command(command =>
          {
              command.Edit();
              command.Custom("Close").Click("CloseFiscalYear");
              command.Custom("Open").Click("OpenFiscalYear");
          }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
                              toolbar.Excel();
                              // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(10))
      .Scrollable()
      .Sortable()
      .Filterable()
      .Groupable()
      .ClientDetailTemplateId("templates")
      .Events(events => events.Edit("edit"))
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(
              model =>
              {
                  model.Id(p => p.GlFiscalYearId);
                  model.Field(p => p.Status).Editable(false);
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);

              })
          .Events(events => events .Error("error_handler_one"))
          .Read(read => read.Action("GLFiscalYears_Read", "GlFiscalYear"))
          .Create(create => create.Action("GLFiscalYears_Create", "GlFiscalYear"))
          .Update(update => update.Action("GLFiscalYears_Update", "GlFiscalYear"))
          .Destroy(destroy => destroy.Action("GLFiscalYears_Destroy", "GlFiscalYear"))
      )
      .Events(events => events.DataBound("onDataBoundLines")))


<script id="templates" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("GLPeriod#=GlFiscalYearId#")
          .SelectedIndex(0)
          .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
          .Items(items =>
          {

              items.Add().Text("Periods").Content(@<text>
                @(Html.Kendo().Grid<GLPeriod>()
                              .Name("GLPeriod#=GlFiscalYearId#")
                                       .Columns(columns =>
                                      {
                                          columns.Bound(c => c.GLPeriodId).Hidden();
                                          columns.Bound(c => c.Name).Width(100);
                                          columns.Bound(c => c.DateFrom).Width(120);
                                          columns.Bound(c => c.DateTo).Width(120);
                                          columns.Bound(c => c.Status).EditorTemplateName("PeriodStatus").Width(150);
                                          columns.Command(command => 
                                          { 
                                              command.Edit();
                                              command.Custom("Close").Click("ClosePeriods");
                                              command.Custom("Open").Click("OpenPeriod"); 
                                          }).Width(180);
                                      })
                                    .ToolBar(toolbar =>
                                    {
                                        //toolbar.Create();
                                    })

                               .Editable(editable => editable.Mode(GridEditMode.InLine))

                              .Scrollable()
                              .Sortable()
                               .Events(events => events.Edit("edit"))
                              .DataSource(dataSource => dataSource
                              .Ajax()
                              .Model(
                                    model =>
                                    {
                                        model.Id(p => p.GLPeriodId);
                                        model.Field(p => p.Status).Editable(false);
                                        model.Field(p => p.OrgBranchName).Editable(false);
                                        model.Field(p => p.CreatedBy).Editable(false);
                                        model.Field(p => p.ModifiedBy).Editable(false);
                                        model.Field(p => p.LastModified).Editable(false);
                                        model.Field(p => p.DateCreated).Editable(false);

                                    })
                               .Events(events => events .Error("error_handler_one"))
                               .Read(read => read.Action("GLPeriods_Read", "GLPeriod", new { id = "#=GlFiscalYearId#" }))
                               .Create(create => create.Action("GLPeriods_Create", "GLPeriod", new { id = "#=GlFiscalYearId#" }))
                               .Update(update => update.Action("GLPeriods_Update", "GLPeriod", new { id = "#=GlFiscalYearId#" }))
                              .Destroy(destroy => destroy.Action("GLPeriods_Destroy", "GLPeriod"))
                          )
                                  .ToClientTemplate()
                )    
            </text>);


          })

                              .ToClientTemplate()
    )

</script>


<script>

    function edit(e) {
        if (e.model.isNew() === false) {
            $("#Name").attr("readonly", true);
        }
    }

    function CloseFiscalYear(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.GlFiscalYearId;
        $.ajax({

            type: "GET",
            data: id, //I obtained the id properly
            url: '@Url.Action("CloseFiscalYear", "GlFiscalYear")/' + id

        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();
        location.reload();
    };

    function OpenFiscalYear(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.GlFiscalYearId;
        $.ajax({

            type: "GET",
            data: id, //I obtained the id properly
            url: '@Url.Action("OpenFiscalYear", "GlFiscalYear")/' + id

        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();
        location.reload();
    };
</script>

