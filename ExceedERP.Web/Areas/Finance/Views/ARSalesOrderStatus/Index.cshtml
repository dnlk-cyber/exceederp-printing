@using ExceedERP.Core.Domain.Finance.AR.SalesOrder

@(Html.Kendo().Grid<ArSalesOrderStatus>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Date);
          columns.Bound(c => c.OrderStatus);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ArSalesOrderStatusId))
          .Read(read => read.Action("ArSalesOrderStatus_Read", "ArSalesOrderStatus"))
          .Create(create => create.Action("ArSalesOrderStatus_Create", "ArSalesOrderStatus"))
          .Update(update => update.Action("ArSalesOrderStatus_Update", "ArSalesOrderStatus"))
          .Destroy(destroy => destroy.Action("ArSalesOrderStatus_Destroy", "ArSalesOrderStatus"))
      ))
