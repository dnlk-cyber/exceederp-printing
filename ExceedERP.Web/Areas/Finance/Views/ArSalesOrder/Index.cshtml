              items.Add().Text("Distribution").Content(
                  @<text>
            @(Html.Kendo().Grid<ArSalesOrderDistribution>()
                  .Name("ArSalesOrderDistribution#=ArSalesOrderId#")
                  .Columns(columns =>
                  {
                      columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(150);
                      columns.Bound(c => c.AccountDesc).Title("Account Description").Width(200);
                      columns.Bound(c => c.Debit).Width(110).ClientFooterTemplate("Total Debit: \\#=sum\\# ");
                      columns.Bound(c => c.Credit).Width(110).ClientFooterTemplate("Total Credit: \\#=sum\\# ");
                      columns.Bound(c => c.DateCreated).Hidden(true).Width(200).Title("Time").Format("{0:dd/MM/yyyy}");
                      columns.Bound(c => c.LastModified).Hidden(true);
                      columns.Bound(c => c.CreatedBy).Width(200).Title("User").Hidden(true);
                      columns.Bound(c => c.ModifiedBy).Hidden(true);
                      columns.Command(command =>
                      {

                          command.Edit();
                          command.Destroy();

                      }).Width(480).ClientFooterTemplate("Difference: \\#=Debit.sum-Credit.sum\\# ");

                  })
                  .ToolBar(toolbar =>
                  {
                      toolbar.Create();
                  })
                  .Editable(editable => editable.Mode(GridEditMode.InLine))

                  .Sortable(sortable =>
                  {
                      sortable.SortMode(GridSortMode.SingleColumn);
                  })
                                                                                                                                                                                                                  
                  .Scrollable()
                  .DataSource(dataSource => dataSource
                      .Ajax()
                      .Aggregates(aggregates =>
                      {
                          aggregates.Add(p => p.Debit).Sum();
                          aggregates.Add(p => p.Credit).Sum();
                      })
                      .Model(
                          model =>
                          {
                              model.Id(p => p.ArSalesOrderId);
                              model.Field(p => p.AccountDesc).Editable(false);
                              model.Field(p => p.OrgBranchName).Editable(false);
                              model.Field(p => p.CreatedBy).Editable(false);
