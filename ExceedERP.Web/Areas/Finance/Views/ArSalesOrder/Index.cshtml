<script>


    function printCashReceipt(id) {
        var print = confirm("Are you sure you want to generate receipt?");

        if (print) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GenerateCashXml", "ArSalesOrder", new {area = "Finance"})',
            data: {id: id},
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
            });
         }
    }

    function printCreditReceipt(id) {
        var print = confirm("Are you sure you want to generate receipt?");

        if (print) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GenerateCreditXml", "ArSalesOrder", new {area = "Finance"})',
                data: {id: id},
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }


    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "ArSalesOrder", new { area = "Finance" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    
    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ArSalesOrder", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    
    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "ArSalesOrder", new {area = "Finance"})',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function sendForApprovalPartial(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ArSalesOrderPartialPrint", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function onSelect(e) {
        //alert("change");
        var dataItem = this.dataItem(e.item);
        //begin
        var item = dataItem.Code;
        $.ajax({
            url: '/Finance/FinanceDataProvider/GetProductAccount',
            type: 'POST',
            data: { id: item },
            success: function (result) {
                if (result.length > 0) {
                    for (var i = 0; i < result.length; i++) {
                        $("#AccountCode").val(result[i].AccountCode).trigger("change");
                    }
                }
               

            }, //end succ
            error: function (result) {
                alert(result);
            }
        }); //end post
        //end
    }

    function onSelectProductItem(e) {
        //alert("change");
        var dataItem = this.dataItem(e.item);
        //begin
        var item = dataItem.Code;
    

        
        $.ajax({
            url: '/Finance/FinanceDataProvider/GetProductItemPrice',
            type: 'POST',
            data: { id: item },
            success: function (result) {
                if (result.length > 0) {
                    for (var i = 0; i < result.length; i++) {
                        $("#UnitPrice").val(result[i].Price).trigger("change");
                        $("#UoM").val(result[i].Unit).trigger("change");
                    }
                }


            }, //end succ
            error: function (result) {
                alert(result);
            }
            }); //end post
            
        //end
    }

    function onUploadSuccess(e) {
        alert(codeid);
        var gridname = "#ArSalesOrderContract" + codeid;
        $(gridname).data("kendoGrid").dataSource.read();
    }

    function isNewCustomer(obj) {
        if ($(obj).is(":checked")) {
            $("#customernameDiv").show();

        } else {
            $("#customernameDiv").hide();

        }

    }

    

    function filterProductItems() {

        return {
            productid: $("#ItemName").data("kendoDropDownList").value(),
            text: $("#SubItem").data("kendoDropDownList").filterInput.val()
        };
    }

    function filterProductItemsPrint() {

        return {
            id: codeid
        };
    }


    var masterRow;
    var masterGrid;
    var masterDataItem;
    var codeid;
    var isapproved;
    var issecondapproved;
    var isSendForApproval;
    var isOnlineTransferred;
    function detailExpandSalesOrder(e) {
        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.ArSalesOrderId;
        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;
       
    }


   

    function onDataBoundLinesSalesOrder(e) {

        var detailGrid = "#" + e.sender.element[0].id;
        if (isapproved || isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }


    function onDataBoundSalesOrderValidation(e) {

        var detailGrid = "#" + e.sender.element[0].id;

        if (isapproved || !isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
   
        this.table.find(".k-grid-edit").hide();
    }
    function onDataBoundSalesOrderDistribution(e) {

        var detailGrid = "#" + e.sender.element[0].id;

        if (isOnlineTransferred) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        //alert(isOnlineTransferred);
    }


    //partial grid

    var isapprovedPartial;
    var isSendForApprovalPartial;

    function onDataBoundMasterPartial(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid =$("#" + e.sender.element[0].id).data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved || gridData[i].IsSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsSendForApproval && !dataItem.IsOnlineApproved) {
                row.css("background-color", "lightgreen");
            }
            if (!dataItem.IsSendForApproval && !dataItem.IsOnlineApproved) {
                row.css("background-color", "lightskyblue");
            }
        }
    }

    function detailExpandSalesOrderPartial(e) {
        masterRow = e.masterRow;
        masterGrid = $("#" + e.sender.element[0].id).data("kendoGrid");
        var masterDataItemPartial = masterGrid.dataItem(masterRow);
        //codeid = masterDataItem.ArSalesOrderId;
        isapprovedPartial = masterDataItemPartial.IsOnlineApproved;
        isSendForApprovalPartial = masterDataItemPartial.IsSendForApproval;
    }

    function onDataBoundLinesSalesOrderPartial(e) {

        var detailGrid = "#" + e.sender.element[0].id;
        if (isapprovedPartial || isSendForApprovalPartial) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }

    function onDataBoundSalesOrderPartialValidation(e) {

        var detailGrid = "#" + e.sender.element[0].id;

        if (isapprovedPartial || !isSendForApprovalPartial) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
   
        this.table.find(".k-grid-edit").hide();
    }


</script>



