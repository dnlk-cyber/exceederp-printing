@using System.Collections
@using ExceedERP.Core.Domain.Finance.AR
@using ExceedERP.Core.Domain.Finance.AR.SalesOrder
<legend>Sales Orders</legend>
@(Html.Kendo().Grid<ArSalesOrder>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ArSalesOrderId).Title("ID").Width(100).ClientTemplate("#=appendZeros(ArSalesOrderId)#");
          columns.Bound(c => c.OrderType).Width(120).EditorTemplateName("SalesorderTypeSelector");
          columns.Bound(c => c.CustomerId).Width(130);
          columns.Bound(c => c.IsNewCustomer).Width(100).Title("New Customer").ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= IsNewCustomer #' " +
              "# if (IsNewCustomer) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.CustomerName).Width(130);
          columns.Bound(c => c.OrderDate).Width(130);
          columns.Bound(c => c.Station).Width(120);
          columns.ForeignKey(c => c.SalesPersonId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Width(150);
          columns.ForeignKey(c => c.PartnerId, (IEnumerable)ViewData["Partners"], "Code", "Name").Width(150);
          columns.ForeignKey(c => c.PaymentTerm, (IEnumerable)ViewData["terms"], "PaymentTermsDays", "PaymentTermsDays").Width(140).EditorTemplateName("PaymentTermsSelector");
          columns.Bound(c => c.OrderReference).Width(160);
          columns.Bound(c => c.OrderStatus).EditorTemplateName("OrderStatusSelector").Width(120);
          columns.Bound(c => c.Product).Width(100);
          columns.Bound(c => c.Length).Width(100);
          columns.Bound(c => c.Repeatition).Width(100);
          columns.Bound(c => c.CreatedBy).Width(80);
          columns.Bound(c => c.Status).Width(100);

          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
          toolbar.Excel();
      })
      .Events(events => events.DetailExpand("detailExpandSalesOrder"))
      .Events(events => events.DataBound("onDataBoundMaster"))
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Groupable()
      .ClientDetailTemplateId("templates")
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Order").Window(w => w.Title("Sales Order Registration")))
      .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ArSalesOrderId").Descending())
          .Model(
              model =>
              {
                  model.Id(p => p.ArSalesOrderId);
                  model.Field(p => p.ArSalesOrderId).Editable(false);
                  model.Field(p => p.IsPostedToSecondLedger).Editable(false);
                  model.Field(p => p.VoidTime).Editable(false);
                  model.Field(p => p.VoidBy).Editable(false);
                  model.Field(p => p.isVoid).Editable(false);
                  model.Field(p => p.OnlineApprovedTime).Editable(false);
                  model.Field(p => p.OnlineApprovedBy).Editable(false);
                  model.Field(p => p.IsOnlineApproved).Editable(false);
                  model.Field(p => p.Status).Editable(false);
                  model.Field(p => p.IsSendForApproval).Editable(false);
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);


              })
          .Events(events => events
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("ArSalesOrders_Read", "ArSalesOrder"))
          .Create(create => create.Action("ArSalesOrders_Create", "ArSalesOrder"))
          .Update(update => update.Action("ArSalesOrders_Update", "ArSalesOrder"))
          .Destroy(destroy => destroy.Action("ArSalesOrders_Destroy", "ArSalesOrder"))
      ))

