@helper FileUploaderPermit()
{
	@(Html.Kendo().Grid<GLRecordJournalBegDistribution>()
																											  .Name("GLRecordJournalBegDistribution#=GLRecordJournalBegId#")
																											  .Columns(columns =>
																											  {
																												  columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(120);
																												  columns.Bound(c => c.AccountDesc).Title("Account Description").Width(120);
																												  columns.Bound(c => c.AdditionalDescription).Title("Description").Width(100);
																												  columns.Bound(c => c.Debit).Width(50).Format("{0:n}").ClientFooterTemplate("\\#=kendo.toString(sum, 'n')\\# ");
																												  columns.Bound(c => c.Credit).Width(50).Format("{0:n}").ClientFooterTemplate("\\#=kendo.toString(sum, 'n')\\# ");
																												  columns.Command(command =>
																									  {

																										  command.Edit(); command.Destroy();

																									  }).Width(180).ClientFooterTemplate("Difference: \\#=Debit.sum-Credit.sum\\# ");
																											  })
										.ToolBar(t => t.Template(
										@<text>
											<div class="toolbar row">
												<div class="col-md-4">
													<a class="k-button k-button-icontext k-grid-add" href='\#'><span class="k-icon k-i-add"></span> Add new record</a>
													
													
												</div>
												<div class="col-md-4 pull-right">
													@(Html.Kendo().Upload()
																										.Name("files")
																										.Async(a => a.Save("ImportBeginningLines", "GLRecordJournalBeg", new { id = "#=GLRecordJournalBegId #" }))
																										.Events(e => e.Complete("bidSuccess"))
																										.Events(c => c
																				.Upload("OnUpload")
																			)
																			.Events(c => c
																				.Select("OnSelect")
																			)
																										.ShowFileList(false)
																										.ToClientTemplate())
													<a style="color:blue" href="~/Content/Downloads/Templates/Finance/BeginningImport.xlsx">Click to download excel template</a>
												</div>

											</div>
										</text>
																																						))
																																						 .Excel(excel => excel
		  .FileName("Beginning.xlsx")
		  .Filterable(true)
		  .AllPages(true)
	  )

																																							 .Editable(editable => editable.Mode(GridEditMode.InLine))
																																				  .HtmlAttributes(new { style = "height: 600px;" })
																																				  .Pageable(pageable => pageable
																																					  .Input(true)
																																					  .Numeric(false)
																																					  .Refresh(true)
																																					  .PageSizes(true)
																																					  .ButtonCount(10))
																																				  .Scrollable()
																																				  .Sortable()
																																				  .Filterable()
																																				  .Events(x => x.DataBound("onDataBoundLines"))
																																				  .DataSource(dataSource => dataSource
																																					  .Ajax()
																																					  .Sort(sort => sort.Add("Debit").Descending())
																																					  .Aggregates(aggregates =>
																																					  {
																																						  aggregates.Add(p => p.Debit).Sum();
																																						  aggregates.Add(p => p.Credit).Sum();
																																					  })
																																					  .Model(
																																						  model =>
																																						  {
																																							  model.Id(p => p.GLRecordJournalBegDistributionId);
																																							  model.Field(p => p.AccountDesc).Editable(false);
																																							  model.Field(p => p.OrgBranchName).Editable(false);
																																							  model.Field(p => p.CreatedBy).Editable(false);
																																							  model.Field(p => p.ModifiedBy).Editable(false);
																																							  model.Field(p => p.LastModified).Editable(false);
																																							  model.Field(p => p.DateCreated).Editable(false);
																																						  })
																																					  .Events(ev => ev
																																						  .Error("error_handler(\"GLRecordJournalBegDistribution#=GLRecordJournalBegId#\")")
																																						  .RequestStart("onRequestStart(\"GLRecordJournalBegDistribution#=GLRecordJournalBegId#\")")
																																						  .RequestEnd("onRequestEndWithAddRow(\"GLRecordJournalBegDistribution#=GLRecordJournalBegId#\")"))
																																					  .Read(read => read.Action("GLRecordJournalBegDistributions_Read", "GlRecordJournalBegLines", new { id = "#=GLRecordJournalBegId#" }))
																																					  .Create(create => create.Action("GLRecordJournalBegDistributions_Create", "GlRecordJournalBegLines", new { id = "#=GLRecordJournalBegId#" }))
																																					  .Update(update => update.Action("GLRecordJournalBegDistributions_Update", "GlRecordJournalBegLines", new { id = "#=GLRecordJournalBegId#" }))
																																					  .Destroy(destroy => destroy.Action("GLRecordJournalBegDistributions_Destroy", "GlRecordJournalBegLines"))
																																				  )

																																				  .ToClientTemplate())
}



<script>


	function getFiscalYear() {
		return { year: $("#yearSelector").data("kendoDropDownList").value() }
	}

	function OpenOpeningRecord() {

		var periodObject = $("#PeriodList").data("kendoDropDownList");
		var periodid = periodObject.value();

		

		if (periodid != null) {
			$("#btnOpenRecord").attr("disabled", true);
			$.ajax({
				type: "POST",
				url: '@Url.Action("OpenOpeningRecord", "GLRecordJournalBeg", new {area = "Finance"})',
				data: { id: periodid },
				success: function (result) {
					// toastr.warnning(result.Message);
					alert(result.Message);
					location.reload(true);
				}, //end succ
				beforeSend: function(){
					// Show image container
					$("#loading-image").show();
				},
				complete:function(data){
					// Hide image container
					$("#loading-image").hide();
				},
				error: function (result) {
					alert(result);
				}
			});


			$("#grid").data("kendoGrid").dataSource.read();
		} else {
			alert("Please select period.");
		}

	}

	function Close(id) {

		$.ajax({
			type: "POST",
			url: '@Url.Action("Close", "GLRecordJournalBeg", new { area = "Finance" })',
			data: { id: id },
			success: function (result) {
				// toastr.warnning(result.Message);
				alert(result.Message);
				location.reload(true);
			}, //end succ
			beforeSend: function () {
				// Show image container
				$("#loading-image").show();
			},
			complete: function (data) {
				// Hide image container
				$("#loading-image").hide();
			},
			error: function (result) {
				alert(result);
			}
		});
	}

	function Post(id) {

		$.ajax({
			type: "POST",
			url: '@Url.Action("Post", "GLRecordJournalBeg", new { area = "Finance" })',
			data: { id: id },
