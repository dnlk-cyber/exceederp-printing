@using ExceedERP.Core.Domain.Finance.GL
<legend>Beginning Journal</legend>
@(Html.Kendo().Grid<GLRecordJournalBeg>()
							  .Name("grid")
							  .Columns(columns =>
							  {
								  columns.Bound(c => c.GLRecordJournalBegId).Title("ID").Width(100).ClientTemplate("#=appendZeros(GLRecordJournalBegId)#");
								  columns.Bound(c => c.JournalName).Width(150);
								  columns.Bound(c => c.Description).Width(150);
								  columns.Bound(c => c.PeriodName).Width(130).EditorTemplateName("OpenGlPeriodSelector");
								  columns.Bound(c => c.CategoryName).Width(130).EditorTemplateName("GLCategory");
								  columns.Bound(c => c.JournalNumber).Title("Reference").Width(120);
								  columns.Bound(c => c.EffectiveDate).Title("Date").Width(130);

								  //columns.Bound(c => c.DebitSum).Width(100).Format("{0:n}");
								  columns.Bound(c => c.Status).Width(100);



								  columns.Command(command =>
								  {

									 // command.Edit();
						  //command.Destroy();
					  }).Width(180);
							  })
							 .ToolBar(toolbar =>
				  {

					  toolbar.Template(@<text>

						@(Html.Kendo().DropDownList()
											  .OptionLabel("Select Year")
											  .Name("yearSelector")
											  .AutoBind(false)
											  .DataValueField("GlFiscalYearId")
											  .DataTextField("Name")
											  .HtmlAttributes(new { style = "width: 200px;" })
											  .DataSource(dataSource =>
											  {
														dataSource.Read(read => read.Action("GetAllYearsOpenYearSinceBeginning", "GlobalDataProvider", new { area = "Common" }))
												.ServerFiltering(false);
													}))


						@(Html.Kendo().DropDownList()
											  .Name("PeriodList")
											  .AutoBind(false)
											  .DataValueField("GLPeriodId")
											  .DataTextField("Name")
											  .HtmlAttributes(new { style = "width: 200px;" })
											  .ValuePrimitive(true)
											  .DataSource(dataSource =>
											  {
														dataSource.Read(read => read.Action("GetFirstPeriods", "GlobalDataProvider", new { area = "Common" }).Data("getFiscalYear"))
												.ServerFiltering(true);
													})
											  .CascadeFrom("yearSelector"))		   
						


						@Html.Kendo().Button().Name("btnOpenRecord").HtmlAttributes(new { type = "button", @class = "k-primary" }).Content("Open").Events(ev => ev.Click("OpenOpeningRecord"))


					</text>);
						})

									.Editable(editable => editable.Mode(GridEditMode.InLine))
								 .HtmlAttributes(new { style = "height: 700px;" })
									  .Pageable(pageable => pageable
												  .Input(true)
												  .Numeric(false)
												  .Refresh(true)
												  .PageSizes(true)
												  .ButtonCount(20))
									  .Scrollable()
										   .Selectable(selectable =>
										   {
											   selectable.Mode(GridSelectionMode.Single);
											   selectable.Type(GridSelectionType.Row);
										   })
													  .Sortable(sortable =>
													  {
														  sortable.SortMode(GridSortMode.SingleColumn);
													  })

									 .Events(ev => ev.DetailExpand("detailExpand"))
									 .Scrollable(h => h.Height(500))
									 .Events(x => x.DataBound("onDataBoundMaster"))
									  .ClientDetailTemplateId("templates")
									.DataSource(dataSource => dataSource
										.Ajax()
											.Sort(sort => sort.Add("GLRecordJournalBegId").Descending())
										.Events(ev => ev
											.Error("error_handler(\"grid\")")
											.RequestStart("onRequestStart(\"grid\")")
											.RequestEnd("onRequestEnd(\"grid\")"))
										.PageSize(20)
									  .Model(
										  model =>
										  {
											  model.Id(p => p.GLRecordJournalBegId);

											  model.Field(p => p.GLRecordJournalBegId).Editable(false);
											  
											  model.Field(p => p.JournalName).Editable(false);
											  model.Field(p => p.JournalNumber).Editable(false);
											  model.Field(p => p.Description).Editable(false);
											  model.Field(p => p.FiscalYear).Editable(false);
											  model.Field(p => p.PeriodName).Editable(false);
											  model.Field(p => p.CategoryName).Editable(false);
											  model.Field(p => p.ReferenceDoc).Editable(false);
											  model.Field(p => p.EffectiveDate).Editable(false);
											  model.Field(p => p.Status).Editable(false);

											  model.Field(p => p.VoidTime).Editable(false);
											  model.Field(p => p.VoidBy).Editable(false);
											  model.Field(p => p.isVoid).Editable(false);
											  model.Field(p => p.OnlineApprovedTime).Editable(false);
											  model.Field(p => p.OnlineApprovedBy).Editable(false);
											  model.Field(p => p.IsOnlineApproved).Editable(false);
											  model.Field(p => p.Status).Editable(false);
											  model.Field(p => p.isPosted).Editable(false);
											  model.Field(p => p.isReversed).Editable(false);
											  model.Field(p => p.Posting).Editable(false);

											  model.Field(p => p.SourcesName).Editable(false);
											  model.Field(p => p.FiscalYear).Editable(false);
											  model.Field(p => p.DebitSum).Editable(false);

											  model.Field(p => p.InvoiceReferenceDoc).Editable(false);
											  model.Field(p => p.ReferenceDoc).Editable(false);
											  model.Field(p => p.PaymentReference).Editable(false);



											  model.Field(p => p.OrgBranchName).Editable(false);
											  model.Field(p => p.CreatedBy).Editable(false);
											  model.Field(p => p.ModifiedBy).Editable(false);
											  model.Field(p => p.LastModified).Editable(false);
											  model.Field(p => p.DateCreated).Editable(false);


										  })

										.Read(read => read.Action("GLRecordJournalBegs_Read", "GLRecordJournalBeg"))
										.Create(create => create.Action("GLRecordJournalBegs_Create", "GLRecordJournalBeg"))
										.Update(update => update.Action("GLRecordJournalBegs_Update", "GLRecordJournalBeg"))
										.Destroy(destroy => destroy.Action("GLRecordJournalBegs_Destroy", "GLRecordJournalBeg"))
									)

)



