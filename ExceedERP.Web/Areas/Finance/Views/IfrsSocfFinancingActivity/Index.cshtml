@using ExceedERP.Core.Domain.Finance.Report.IFRS

@(Html.Kendo().Grid<IfrsSocfFinancingActivity>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Category);
          columns.Bound(c => c.Description);
          columns.Bound(c => c.AccountFrom);
          columns.Bound(c => c.AccountTo);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.IfrsSocfFinancingActivityId))
          .Read(read => read.Action("IfrsSocfFinancingActivities_Read", "IfrsSocfFinancingActivity"))
          .Create(create => create.Action("IfrsSocfFinancingActivities_Create", "IfrsSocfFinancingActivity"))
          .Update(update => update.Action("IfrsSocfFinancingActivities_Update", "IfrsSocfFinancingActivity"))
          .Destroy(destroy => destroy.Action("IfrsSocfFinancingActivities_Destroy", "IfrsSocfFinancingActivity"))
      ))
