<script>

    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "ApInvoicesManual", new { area = "Finance" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "ApInvoicesManual", new {area = "Finance"})',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ApInvoicesManual", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function GetGrnDataToAP() {
        var grnObject = $("#GRNList").data("kendoDropDownList");
        var grnId = grnObject.value();
        if (grnId.length === 0)
            alert("Please select GRN Number.");
        else {
            $.ajax({
                url: '@Url.Action("GetGrnDataToApInvoicesManual", "ApInvoices")',
                data: { id: grnId },
                type: 'GET',
                cache: false,
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }


            });
        }
    }

    function onSelect(e) {
        //alert("change");
        var dataItem = this.dataItem(e.item);
        //begin
        var item = dataItem.Name;
        $.ajax({
            url: '/Finance/FinanceDataProvider/GetPayableItemsAccount',
            type: 'POST',
            data: { id: item },
            success: function (result) {
                if (result.length > 0) {
                    for (var i = 0; i < result.length; i++) {
                        $("#AccountCode").val(result[i].AccountCode).trigger("change");
                        $("#Description").val(result[i].Description).trigger("change");
                    }
                }
                else {

                }

            }, //end succ
            error: function (result) {
                alert(result);
            }
        }); //end post
        //end
    }


</script>



