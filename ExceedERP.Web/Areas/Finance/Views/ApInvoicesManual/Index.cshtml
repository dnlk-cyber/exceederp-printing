@using System.Collections
@using ExceedERP.Core.Domain.Finance.AP
<legend>Payable Invoices</legend>
@(Html.Kendo().Grid<ApPaybleInvoices>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ApPaybleInvoicesId).Title("ID").Width(100).ClientTemplate("#=appendZeros(ApPaybleInvoicesId)#");
          //columns.ForeignKey(c => c.SupplierId, (IEnumerable)ViewData["suppliers"], "SupplierId", "Name").Title("Supplier").Width(200);
          columns.Bound(c => c.SupplierId).Width(180);
          columns.Bound(c => c.SupplierName).Width(180);
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Purchaser").Width(130).EditorTemplateName("PurchaserSelector");
          columns.Bound(c => c.PurposeOfPayment).Width(170);
          columns.Bound(c => c.InvoiceDate).Width(130).Format("{0:dd/MM/yyyy}");
          columns.Bound(c => c.InvoiceNumber).Width(130);
          columns.Bound(c => c.Type).EditorTemplateName("InvoiceType").Width(140);
          columns.Bound(o => o.PrNo).Width(120).ClientTemplate(
              "# if (PrNo) { #"+
          @Html.ActionLink("#=PrNo#", "PurchaseRequistionPrint", "InventoryPrint", new {area = "Inventory", Id = "#=PrNo#"}, new {@class = "detail-link"}
              ).ToHtmlString()
                 + "# } #" 
                 );
           
          columns.Bound(o => o.PoNum).Width(120).ClientTemplate(
              "# if (PoNum) { #"+
              @Html.ActionLink("#=PoNum#", "PurchaseOrderPrint", "ProcurementPrint", new {area = "Procurement", Id = "#=PoNum#"}, new {@class = "detail-link"}).ToHtmlString()
              + "# } #" 
              );
          columns.Bound(o => o.Grn).Width(120).ClientTemplate(
              "# if (PoNum) { #"+
              @Html.ActionLink("#=Grn#", "Goodreceive", "InventoryPrint", new {area = "Inventory", Id = "#=Grn#"}, new {@class = "detail-link"}).ToHtmlString()
              + "# } #" 
              );
          columns.ForeignKey(c => c.PaymentTerms, (IEnumerable)ViewData["terms"], "PaymentTermsDays", "PaymentTermsDays").Width(130);
          columns.Bound(c => c.Status).Width(80);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Template(
              @<text>

                    <a class="k-button k-button-icontext k-grid-add" href='\#'><span class="k-icon k-i-add"></span> Add new record</a>
                    <button class="k-button k-button-icontext k-grid-excel" href='\#'> <span class="k-icon k-i-excel"></span>Export to Excel</button>

                    @(Html.Kendo().CheckBox()
                                    .Name("checktransfferable")
                                    .Label("Show Transferrable Only")
                                    .HtmlAttributes(new { onchange = "isNotTransferredCheck(this)" })
                    )



                </text>);
      })
      .Excel(excel => excel
          .FileName("AP Manual Invoice.xlsx")
          .Filterable(true)
          .AllPages(true)
      )

      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ApInvoice").Window(w => w.Title("Payable Invoice")))
      .Groupable().Events(ev => ev.DetailExpand("detailExpand"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()

      .Filterable()
      .Groupable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .ClientDetailTemplateId("templates")
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Sort(sort => sort.Add("ApPaybleInvoicesId").Descending()) // <-- initial sort expression
          .Model(
              model =>
              {
                  model.Id(p => p.ApPaybleInvoicesId);
                  model.Field(p => p.ApPaybleInvoicesId).Editable(false);
                  model.Field(p => p.IsPostedToSecondLedger).Editable(false);
                  model.Field(p => p.Source).Editable(false);
              })


          .Read(read => read.Action("APPaybleInvoices_Read", "ApInvoicesManual").Data("passReadData"))
          .Create(create => create.Action("APPaybleInvoices_Create", "ApInvoicesManual"))
          .Update(update => update.Action("APPaybleInvoices_Update", "ApInvoicesManual"))
          .Destroy(destroy => destroy.Action("APPaybleInvoices_Destroy", "ApInvoicesManual"))
      ))

