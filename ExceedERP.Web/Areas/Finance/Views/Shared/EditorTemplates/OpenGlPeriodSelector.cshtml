@(Html.Kendo().DropDownListFor(m => m)
      .ValuePrimitive(true)
      .OptionLabel("Select Period")
      .DataTextField("Name")
      .DataValueField("Name")
      .Filter("contains")
      .DataSource(dataSource =>
      {
          dataSource.Read(read => read.Action("GetOpenGlPeriod", "FinanceDataProvider", new { area = "Finance" }))
              .ServerFiltering(true);
      })

      .Events(e =>
      {
          e.Change("onSelectedPeriod");
      })
         
                             
      )
@Html.ValidationMessageFor(m => m)
