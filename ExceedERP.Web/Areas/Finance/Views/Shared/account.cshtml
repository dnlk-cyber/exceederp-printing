                    @(Html.Kendo().DropDownList()
                          .ValuePrimitive(true)
                          .OptionLabel("...Account...")
                          .DataTextField("desc")
                          .DataValueField("value")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetLocations", "AccountCode"))
                                  .ServerFiltering(true);
                          })
                          )
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.Label("Cost Center", htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @(Html.Kendo().DropDownList()
                          .ValuePrimitive(true)
                          .OptionLabel("...Account...")
                          .DataTextField("desc")
                          .DataValueField("value")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetCostCenter", "AccountCode"))
                                  .ServerFiltering(true);
                          })
                          )
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.Label("Sub Account", htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @(Html.Kendo().DropDownList()
                          .ValuePrimitive(true)
                          .OptionLabel("...Account...")
                          .DataTextField("desc")
                          .DataValueField("value")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetSubAccounts", "AccountCode"))
                                  .ServerFiltering(true);
                          })
                          )
                </div>
            </div>
            <div class="row"></div>
        </div>
    </div>
</div>

