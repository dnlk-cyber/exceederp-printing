@using ExceedERP.Core.Domain.Finance.Common
<legend>Bank Accounts</legend>
@(Html.Kendo().Grid<BankAccount>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.AccountName).Width(150);
        columns.Bound(c => c.AccountNumber).Width(150); ;
        columns.Bound(c => c.BankName).Width(120);
        columns.Bound(c => c.BankBranch).Width(120);
        columns.Bound(c => c.BankAdress).Width(120);
         columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(220);
        columns.Bound(c => c.AccountDesc).Width(150);
        columns.Bound(c => c.AccountControl).Width(140);
        columns.Bound(c => c.AccountUse).Width(120);
        columns.Bound(c => c.Status).Width(120).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= Status #' " +
                  "# if (Status) { #" +
                      "checked='checked'" +
                  "# } #" +
              "/>"
          );
        columns.Bound(c => c.OrgBranchName).Hidden(true);
        columns.Bound(c => c.DateCreated).Hidden(true);
        columns.Bound(c => c.LastModified).Hidden(true);
        columns.Bound(c => c.CreatedBy).Hidden(true);
        columns.Bound(c => c.ModifiedBy).Hidden(true);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
            toolbar.Excel();
           // toolbar.Pdf();
      })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
            .HtmlAttributes(new { style = "height: 550px;" })
                  .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))

                        .Scrollable()
                             .Selectable(selectable =>
                            {
                                selectable.Mode(GridSelectionMode.Single);
                                selectable.Type(GridSelectionType.Row);
                            })
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                        .Filterable()
                        
      .DataSource(dataSource => dataSource
          .Ajax()
              .Sort(sort => sort.Add("BankAccountId").Descending())
              .Model(
                    model =>
                    {
                        model.Id(p => p.BankAccountId);
                        model.Field(p => p.AccountDesc).Editable(false);
                        model.Field(p => p.OrgBranchName).Editable(false);
                        model.Field(p => p.CreatedBy).Editable(false);
                        model.Field(p => p.ModifiedBy).Editable(false);
                        model.Field(p => p.LastModified).Editable(false);
                        model.Field(p => p.DateCreated).Editable(false);


                    })
                  .Events(events => events
                       .Error("error_handler_one")
                      .Sync("sync_handler"))
          .Read(read => read.Action("BankAccounts_Read", "BankAccount"))
          .Create(create => create.Action("BankAccounts_Create", "BankAccount"))
          .Update(update => update.Action("BankAccounts_Update", "BankAccount"))
          .Destroy(destroy => destroy.Action("BankAccounts_Destroy", "BankAccount"))
      )
      )

