              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.Supplier).Width(150).Filterable(ftb => ftb.Multi(true).Search(true));

          columns.ForeignKey(c => c.Purchaser, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameaEnglish").Width(150).EditorTemplateName("PurchaserSelector");
          columns.Bound(c => c.ReasonOfPayment).Width(130);
