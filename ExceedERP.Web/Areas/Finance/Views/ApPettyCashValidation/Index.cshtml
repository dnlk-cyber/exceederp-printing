@using ExceedERP.Core.Domain.Finance.AP.PettyCash

@(Html.Kendo().Grid<ApPettyCashValidation>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Status);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ApPettyCashValidationId))
          .Read(read => read.Action("ApPettyCashValidations_Read", "ApPettyCashValidation"))
          .Create(create => create.Action("ApPettyCashValidations_Create", "ApPettyCashValidation"))
      ))
