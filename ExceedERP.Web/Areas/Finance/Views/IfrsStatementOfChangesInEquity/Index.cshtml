@using ExceedERP.Core.Domain.Finance.Report
@using ExceedERP.Core.Domain.Finance.Report.IFRS
<legend>Statement of Changes in Equity</legend>
@(Html.Kendo().Grid<IfrsStatementOfChangesInEquity>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.IfrsStatementOfChangesInEquityId).Title("ID").Width(100);
          columns.Bound(c => c.Category).EditorTemplateName("EquityCategories").Width(200);
          columns.Bound(c => c.NoteNumber).Width(100);
          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          });
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .ClientDetailTemplateId("templates")
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.IfrsStatementOfChangesInEquityId);
              model.Field(p => p.IfrsStatementOfChangesInEquityId).Editable(false);
          }
          )
          .Model(model => model.Id(p => p.IfrsStatementOfChangesInEquityId))
          .Read(read => read.Action("IfrsStatementOfChangesInEquities_Read", "IfrsStatementOfChangesInEquity"))
          .Create(create => create.Action("IfrsStatementOfChangesInEquities_Create", "IfrsStatementOfChangesInEquity"))
          .Update(update => update.Action("IfrsStatementOfChangesInEquities_Update", "IfrsStatementOfChangesInEquity"))
          .Destroy(destroy => destroy.Action("IfrsStatementOfChangesInEquities_Destroy", "IfrsStatementOfChangesInEquity"))
      )
      .Events(events => events.DataBound("dataBound")))


<script id="templates" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("tabStrip-IfrsStatementOfChangesInEquity#=IfrsStatementOfChangesInEquityId#")
          .SelectedIndex(0)
          .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
          .Items(items =>
          {
              items.Add().Text("Account Ranges").Content(@<text>
                @(Html.Kendo().Grid<IfrsStatementOfChangesInEquityRange>()
                      .Name("IfrsStatementOfChangesInEquityRange#=IfrsStatementOfChangesInEquityId#")
                      .Columns(columns =>
                      {
                          columns.Bound(c => c.AccountFrom).EditorTemplateName("AccountCodeZZZ").Width(220);
                          columns.Bound(c => c.AccountTo).EditorTemplateName("AccountCodeZZZ").Width(220);
                          columns.Command(command =>
                          {
                              command.Edit();
                              command.Destroy();
                          });
                      })
                      .ToolBar(toolbar =>
                      {
                          toolbar.Create();
                      })

                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                     
                      .Scrollable()
                      .Sortable()
                      .DataSource(dataSource => dataSource
                          .Ajax()
                          .Model(
                              model =>
                              {
                                  model.Id(p => p.IfrsStatementOfChangesInEquityId);
                              })
                          .Events(events => events
                              .Error("error_handler_one")
                              .Sync("sync_handler"))
                          .Read(read => read.Action("IfrsStatementOfChangesInEquityRanges_Read", "IfrsStatementOfChangesInEquityRange", new { id = "#=IfrsStatementOfChangesInEquityId#" }))
                          .Create(create => create.Action("IfrsStatementOfChangesInEquityRanges_Create", "IfrsStatementOfChangesInEquityRange", new { id = "#=IfrsStatementOfChangesInEquityId#" }))
                          .Update(update => update.Action("IfrsStatementOfChangesInEquityRanges_Update", "IfrsStatementOfChangesInEquityRange", new { id = "#=IfrsStatementOfChangesInEquityId#" }))
                          .Destroy(destroy => destroy.Action("IfrsStatementOfChangesInEquityRanges_Destroy", "IfrsStatementOfChangesInEquityRange"))
                      )
                      .Events(events => events.DataBound("dataBound"))
                      .ToClientTemplate())
            </text>);

          })

                                                  .ToClientTemplate()
    )

</script>



<script>
    var popupFrom;
    var aCodeFrom;

    var popupTo;
    var aCodeTo;

    function SelectFromAccCode() {
        popupFrom = window.open('/Finance/AccountCode/GLAccountFromSelector', 'WindowPopup', 'top=100, left=400, width=300, height=320,resizable=no,');
        popupFrom.focus();
        return false;
    }

    function setFromAccountCode(accCode) {
        aCodeFrom = accCode;
        $("#AccountFrom").val(aCodeFrom).trigger("change");
    }

    function SelectToAccCode() {
        popupFrom = window.open('/Finance/AccountCode/GLAccountToSelector', 'WindowPopup', 'top=100, left=400, width=300, height=320,resizable=no,');
        popupFrom.focus();
        return false;
    }

    function setToAccountCode(accCode) {
        aCodeTo = accCode;
        $("#AccountTo").val(aCodeTo).trigger("change");
    }

</script>


<script type="text/javascript">

    function dataBound() {
       // this.expandRow(this.tbody.find("tr.k-master-row").first());
    }

    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

            var grid = $("#grid").data("kendoGrid");
            grid.one("dataBinding", function (e) {
                e.preventDefault();
            });
        }
    }

    function sync_handler(e) {
        this.read();
    }
</script>




<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }

    div.k-content {
        overflow: hidden;
        height: auto;
    }
</style>