
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.AR.SalesOrder.ArSalesOrderContract>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.FileName);
          columns.Bound(c => c.FilePath);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ArSalesOrderContractId))
          .Read(read => read.Action("ArSalesOrderContracts_Read", "ArSalesOrderContract"))
          .Create(create => create.Action("ArSalesOrderContracts_Create", "ArSalesOrderContract"))
          .Update(update => update.Action("ArSalesOrderContracts_Update", "ArSalesOrderContract"))
          .Destroy(destroy => destroy.Action("ArSalesOrderContracts_Destroy", "ArSalesOrderContract"))
      ))
