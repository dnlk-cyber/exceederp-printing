@using ExceedERP.Core.Domain.Finance.AR
<legend>Customer Types</legend>
@(Html.Kendo().Grid<ArCustomerType>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.CustomerTypeName).Width(200);
          columns.Bound(c => c.Description).Width(250);
          columns.Bound(c => c.Enable).Width(90).Title("Enable").ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= Enable #' " +
              "# if (Enable) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.DateCreated).Width(150).Hidden(true).Format("{0:dd/MM/yyyy}");
          columns.Bound(c => c.LastModified).Width(150).Hidden(true).Format("{0:dd/MM/yyyy}");
          columns.Bound(c => c.CreatedBy).Width(150).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(150).Hidden(true);
          columns.Command(command => {
                                         command.Edit();
                                         command.Custom("En").Click("Enable");
          }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
                              toolbar.Excel();
                             
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Groupable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model =>
          {
              model.Id(p => p.ArCustomerTypeId);
              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
              model.Field(p => p.LastModified).Editable(false);
              model.Field(p => p.ModifiedBy).Editable(false);
          })
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("ARCustomerTypes_Read", "ArCustomerType"))
          .Create(create => create.Action("ARCustomerTypes_Create", "ArCustomerType"))
          .Update(update => update.Action("ARCustomerTypes_Update", "ArCustomerType"))
          .Destroy(destroy => destroy.Action("ARCustomerTypes_Destroy", "ArCustomerType"))
      ))
<script>

    function Enable(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        
        $.ajax({
            type: "GET",
            data: dataItem.ArCustomerTypeId,
            url: '@Url.Action("Enable_Disable", "ArCustomerType")/' + dataItem.ArCustomerTypeId

        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();
        location.reload();
    };

</script>