@using ExceedERP.Core.Domain.Finance.AR
@(Html.Kendo().Grid<ArInvoiceValidation>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Status);
        columns.Bound(c => c.Remark);
        columns.Bound(c => c.OrgBranchName);
        columns.Bound(c => c.DateCreated);
        columns.Bound(c => c.LastModified);
        columns.Bound(c => c.CreatedBy);
        columns.Bound(c => c.ModifiedBy);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
            toolbar.Excel();
           // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Pageable()
      .Sortable(sortable => {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ArInvoiceValidationId))
          .Read(read => read.Action("ARInvoiceValidations_Read", "ARInvoiceValidation"))
          .Create(create => create.Action("ARInvoiceValidations_Create", "ARInvoiceValidation"))
          .Update(update => update.Action("ARInvoiceValidations_Update", "ARInvoiceValidation"))
          .Destroy(destroy => destroy.Action("ARInvoiceValidations_Destroy", "ARInvoiceValidation"))
      )
)
