@using ExceedERP.Core.Domain.Finance.Report
@using ExceedERP.Core.Domain.Finance.Report.GAAP
<legend>Income Statement</legend>
@(Html.Kendo().Grid<GaapIncomeStatement>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.GaapIncomeStatementId).Title("ID").Width(30);
          columns.Bound(c => c.ReportType).Title("Type").Width(60);
          columns.Command(command =>
          {
              if (ViewBag.Count > 2)
              {
                  return;
              }
              command.Edit(); command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .ClientDetailTemplateId("templates")
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(
              model =>
              {
                  model.Id(p => p.GaapIncomeStatementId);
                  model.Field(p => p.GaapIncomeStatementId).Editable(false);
              })
          .Read(read => read.Action("GaapIncomeStatements_Read", "GaapIncomeStatement"))
          .Create(create => create.Action("GaapIncomeStatements_Create", "GaapIncomeStatement"))
          .Update(update => update.Action("GaapIncomeStatements_Update", "GaapIncomeStatement"))
          .Destroy(destroy => destroy.Action("GaapIncomeStatements_Destroy", "GaapIncomeStatement"))
      ))


<script id="templates" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("GaapIncomeStatementOperationRevenue#=GaapIncomeStatementId#")
          .SelectedIndex(0)
          .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
