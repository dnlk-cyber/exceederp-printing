          {
              items.Add().Text("Revenue").Content(@<text>
                @(Html.Kendo().Grid<GaapIncomeStatementOperationRevenue>()
                      .Name("GaapIncomeStatementOperationRevenue#=GaapIncomeStatementId#")
                      .Columns(columns =>
                      {
                          columns.Bound(c => c.Category).Width(150);
                          columns.Bound(c => c.Description).Width(300);
                          columns.Bound(c => c.NoteNumber).Width(100);
                          columns.Command(command =>
                          {
                              command.Edit();
                              command.Destroy();
                          });
                      })
                      .ToolBar(toolbar =>
                      {
                          toolbar.Create();
                      })

                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                      .HtmlAttributes(new { style = "height: 500px;" })
                      .Scrollable()
                      .Sortable()
                      .ClientDetailTemplateId("revenueTemplates")
                      .DataSource(dataSource => dataSource
                          .Ajax()
                          .Model(
                              model =>
                              {
                                  model.Id(p => p.GaapIncomeStatementOperationRevenueId);
                              })
                          .Events(ev => ev
                              .Error("error_handler(\"GaapIncomeStatementOperationRevenue#=GaapIncomeStatementId#\")")
                              .RequestStart("onRequestStart(\"GaapIncomeStatementOperationRevenue#=GaapIncomeStatementId#\")")
                              .RequestEnd("onRequestEnd(\"GaapIncomeStatementOperationRevenue#=GaapIncomeStatementId#\")"))
                          .Read(read => read.Action("GaapIncomeStatementOperationRevenues_Read", "GaapIncomeStatementOperationRevenue", new { id = "#=GaapIncomeStatementId#" }))
                          .Create(create => create.Action("GaapIncomeStatementOperationRevenues_Create", "GaapIncomeStatementOperationRevenue", new { id = "#=GaapIncomeStatementId#" }))
                          .Update(update => update.Action("GaapIncomeStatementOperationRevenues_Update", "GaapIncomeStatementOperationRevenue", new { id = "#=GaapIncomeStatementId#" }))
                          .Destroy(destroy => destroy.Action("GaapIncomeStatementOperationRevenues_Destroy", "GaapIncomeStatementOperationRevenue"))
                      )
                      
                      .ToClientTemplate())
            </text>);

               items.Add().Text("Expense").Content(@<text>
                @(Html.Kendo().Grid<GaapIncomeStatementOperationExpense>()
                      .Name("GaapIncomeStatementOperationExpense#=GaapIncomeStatementId#")
                      .Columns(columns =>
                      {
                          columns.Bound(c => c.Category).Width(150);
                          columns.Bound(c => c.Description).Width(300);
                          columns.Bound(c => c.NoteNumber).Width(100);
                          columns.Command(command =>
                          {
                              command.Edit();
                              command.Destroy();
                          });
                      })
                      .ToolBar(toolbar =>
                      {
                          toolbar.Create();
                      })

                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                      .HtmlAttributes(new { style = "height: 500px;" })
                      .Scrollable()
                      .Sortable()
                      .ClientDetailTemplateId("expenseTemplates")
                      .DataSource(dataSource => dataSource
                          .Ajax()
                          .Model(
                              model =>
                              {
                                  model.Id(p => p.GaapIncomeStatementOperationExpenseId);
                              })
                          .Events(ev => ev
                              .Error("error_handler(\"GaapIncomeStatementOperationExpense#=GaapIncomeStatementId#\")")
                              .RequestStart("onRequestStart(\"GaapIncomeStatementOperationExpense#=GaapIncomeStatementId#\")")
                              .RequestEnd("onRequestEnd(\"GaapIncomeStatementOperationExpense#=GaapIncomeStatementId#\")"))
                          .Read(read => read.Action("GaapIncomeStatementOperationExpenses_Read", "GaapIncomeStatementOperationExpense", new { id = "#=GaapIncomeStatementId#" }))
                          .Create(create => create.Action("GaapIncomeStatementOperationExpenses_Create", "GaapIncomeStatementOperationExpense", new { id = "#=GaapIncomeStatementId#" }))
                          .Update(update => update.Action("GaapIncomeStatementOperationExpenses_Update", "GaapIncomeStatementOperationExpense", new { id = "#=GaapIncomeStatementId#" }))
                          .Destroy(destroy => destroy.Action("GaapIncomeStatementOperationExpenses_Destroy", "GaapIncomeStatementOperationExpense"))
                      )
                      
                      .ToClientTemplate())
            </text>);

                    

          })
          .ToClientTemplate()
    )

</script>


