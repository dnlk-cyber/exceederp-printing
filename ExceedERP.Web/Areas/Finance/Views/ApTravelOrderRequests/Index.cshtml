                                                        {
                                                            events.Error("error_handler(\"RequestesStatusgrid_#=ApTravelOrderId#\")");
                                                            events.RequestStart("onRequestStart(\"RequestesStatusgrid_#=ApTravelOrderId#\")");
                                                            events.RequestEnd("onRequestEnd(\"RequestesStatusgrid_#=ApTravelOrderId#\")");
                                                        })
                              .Model(model =>
                              {
                                  model.Id(p => p.RequestStatusId);
                                  model.Field(p => p.Date).Editable(false).DefaultValue(DateTime.Today);
                              })

                                      .Read(read => read.Action("RequestesStatus_Read", "RequestesStatus", new { id = "#=ApTravelOrderId#", referenceType = "TravelOrder" }))
                                              .Create(create => create.Action("RequestesStatus_Create", "RequestesStatus", new { id = "#=ApTravelOrderId#", referenceType2 = "TravelOrder" }))
                              .Update(update => update.Action("RequestesStatus_Update", "RequestesStatus"))
                              .Destroy(destroy => destroy.Action("RequestesStatus_Destroy", "RequestesStatus"))
                          ).ToClientTemplate()
                )


            </text>
                  );
              //*****************************************************************************************************//

          }).ToClientTemplate())
</script>

<script type="text/javascript">


    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "ApTravelExpenseClaim", new {area = "Finance"})',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
       }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ApTravelExpenseClaim", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function onTravelOrderSelect(e) {
        //alert("change");
        var dataItem = this.dataItem(e.item);
        //begin
        var item = dataItem.Code;
        $.ajax({
            url: '/Finance/FinanceDataProvider/GetTravelorder',
            type: 'POST',
            data: { id: item },
            success: function (result) {
                if (result.length > 0) {
                    for (var i = 0; i < result.length; i++) {
                        $("#Name").val(result[i].Name).trigger("change");
                        $("#PurposeOfTravel").val(result[i].PurposeOfTravel).trigger("change");
                    }
                }


            }, //end succ
            error: function (result) {
                alert(result);
            }
        }); //end post
        //end
    }





    function onMasterEdit() {

    }


    function IsforOthers() {
        return {
            IsForOther: $("#IsForOther").val()
        };
    }







</script>
