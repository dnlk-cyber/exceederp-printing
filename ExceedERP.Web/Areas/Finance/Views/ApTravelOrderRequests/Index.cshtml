@using System.Collections
@using ExceedERP.Core.Domain.Finance.AP.Travel
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Travel Order Request</legend>
@(Html.Kendo().Grid<ApTravelOrder>()
                  .Name("grid")
                  .Columns(columns =>
                  {
                      //columns.Bound(c => c.ApTravelOrderId).ClientTemplate("#=appendZeros(ApTravelExpenseClaimId)#").Width(100).Title("ID");
                      columns.Bound(c => c.ApTravelOrderId).Width(120);
                      columns.Bound(c => c.Name).Width(120);
                      //columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(160).EditorTemplateName("WorkUnitCostCenterSelector");
                      columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(200);
                      columns.Bound(c => c.PurposeOfTravel).Width(150);
                      //columns.Bound(c => c.ClaimDate).Width(130);
                      columns.Bound(c => c.PaymentMethod).Width(120).EditorTemplateName("PaymentMethodSelectorAP");
                      columns.Bound(c => c.Reference).Width(120);
                      columns.Bound(c => c.Status).Width(90);
                      columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
                  })
                  .ToolBar(toolbar =>
                  {
                      toolbar.Create();
                  })
                .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ExpenseClaim"))//.Window(w => w.Title("Expense Claim")))
                 .HtmlAttributes(new { style = "height: 550px;" })
                                    .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(20))
                                    .Scrollable()
                                    .Sortable()
                                    .Filterable()
                                        .Selectable(selectable =>
                                        {
                                            selectable.Mode(GridSelectionMode.Single);
                                            selectable.Type(GridSelectionType.Row);
                                        })
                                    .Sortable(sortable =>
                                    {
                                        sortable.SortMode(GridSortMode.SingleColumn);
                                    })
                                    .Groupable()
                                     .Events(ev => ev.Edit("onMasterEdit"))
                                    //.Groupable().Events(ev => ev.DetailExpand("detailExpandMasterNew"))
                                    .Scrollable(h => h.Height(500))
                                     .Events(x => x.DataBound("onDataBoundMasterNew"))
                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                    .Sort(sort => sort.Add("ApTravelExpenseClaimId").Descending())
                                                           .Events(ev => ev
                                                        .Error("error_handler(\"grid\")")
                                                        .RequestStart("onRequestStart(\"grid\")")
                                                        .RequestEnd("onRequestEnd(\"grid\")"))
                                  .Model(model =>
                                  {
                                      model.Id(p => p.ApTravelOrderId);
                                      //model.Field(p => p.ApTravelExpenseClaimId).Editable(false);
                                      model.Field(p => p.Name).Editable(false);
                                      model.Field(p => p.OrgStructureId).Editable(false);
                                      model.Field(p => p.BranchId).Editable(false);
                                      model.Field(p => p.PurposeOfTravel).Editable(false);

                                      model.Field(p => p.Status).Editable(false);
                                      model.Field(p => p.CreatedBy).Editable(false);
                                      model.Field(p => p.DateCreated).Editable(false);
                                      model.Field(p => p.ModifiedBy).Editable(false);
                                      model.Field(p => p.LastModified).Editable(false);
                                  })
                      .Model(model => model.Id(p => p.ApTravelOrderId))
                      .Read(read => read.Action("ApTravelOrderRequest_Read", "ApTravelOrderRequest"))
                      .Create(create => create.Action("ApTravelOrderRequest_Create", "ApTravelOrderRequest"))
                      .Update(update => update.Action("ApTravelOrderRequest_Update", "ApTravelOrderRequest"))
                      .Destroy(destroy => destroy.Action("ApTravelOrderRequest_Destroy", "ApTravelOrderRequest"))
                  ).ClientDetailTemplateId("detailtemplate")
)


