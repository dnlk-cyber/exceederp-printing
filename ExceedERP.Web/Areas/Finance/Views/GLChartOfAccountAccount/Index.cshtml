    function Enable(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.Values;
        $.ajax({
            //url: "GLChartOfAccountAccount/Enable_Disable",

            //data: { id: dataItem.Values }
            type: "GET",
            data: dataItem.Values, //I obtained the id properly
            url: '@Url.Action("Enable_Disable", "GlChartOfAccountAccount")/' + dataItem.Values

        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();
        location.reload();
    };
</script>

