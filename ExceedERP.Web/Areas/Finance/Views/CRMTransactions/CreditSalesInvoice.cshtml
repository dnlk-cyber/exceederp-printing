<script>
    var id;
    var masterId;
    var gridName;
    var thingId;
    

    function onDataBound(e) {
        var grid = this;
        var LineitemGrid = $("#LineItems").data("kendoGrid");

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.LastObjectState == "Waiting Administrative Approval" || dataItem.LastObjectState == "WaitingApproval") {
                //$(this).find(".reject").remove();
                //$(this).find(".k-grid-PrintToPos").remove();
                $(this).find(".k-grid-edit").remove();
                //$(this).find(".k-grid-Pay").remove();
                $(this).find(".k-grid-delete").remove();
                //$(this).find(".k-grid-Reject").remove();
                //$(this).addClass("k-state-Issued");
            }
            //if (dataItem.IsReceiptPrinted == true) {
            //    $(this).find(".k-grid-PrintToPos").remove();
            //}
            if (dataItem.LastObjectState == "Forwarded" || dataItem.LastObjectState == "Hold" || dataItem.LastObjectState == "Printed" || dataItem.LastObjectState == "PaymentReceived" || dataItem.LastObjectState == "Product_Issued") {
                $(this).find(".reject").remove();
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-Pay").remove();
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-Reject").remove();
            }
            if (dataItem.LastObjectState == "Forwarded" || dataItem.LastObjectState == "PaymentReceived" || dataItem.LastObjectState == "Product_Issued") {
                $(this).addClass("k-state-approved");
            }
            if (dataItem.LastObjectState == "Hold") {
                $(this).addClass("k-state-hold");
            }
            if (dataItem.LastObjectState == "Printed") {
                $(this).addClass("k-state-printed");
            }
            if (dataItem.LastObjectState == "Rejected") {
                $(this).addClass("k-state-Rejected");
            }
            if (dataItem.IsSendForApproval == false) {
                $(this).find(".reject").remove();
                $(this).find(".k-grid-Pay").remove();
                $(this).find(".k-grid-Reject").remove();
                //$(this).find(".k-grid-PrintToPos").remove();

            }
        });
    }
    
</script>

<script>
    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "CashSalesInvoice", new {area = "CRM"})',
                data: { id: id },
                success: function (result) {
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                },
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
    function regenerateDistribution(id) {
        $.ajax({
                type: "POST",
                url: '@Url.Action("RegenerateDistribution", "CreditsSalesInvoice", new { area = "CRM" })',
                data: {
                    id: id,
                },
                success: function (result) {
                    alert(result.Message);
                    if (result.Status == "OK") {
                        location.reload(true);
                    }
                }, 
                error: function (result) {
                    alert(result);
                }
            });
    }
    function BatchTransfer() {
        var periodObject = $("#PeriodList").data("kendoDropDownList");
        var periodid = periodObject.value();
       
        if (periodid != null) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("BatchtransferCreditSalesInoice", "CRMTransactions", new {area = "Finance"})',
                data: { crmPeriodId: periodid },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                beforeSend: function(){
                    // Show image container
                    $("#loading-image").show();
                },
                complete:function(data){
                    // Hide image container
                    $("#loading-image").hide();
                },
                error: function (result) {
                    alert(result);
                }
            });


            $("#grid").data("kendoGrid").dataSource.read();
        } else {
            alert("Please select period.");
        }
        
    }

    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "CashSalesInvoice", new { area = "CRM" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
    
</script>
