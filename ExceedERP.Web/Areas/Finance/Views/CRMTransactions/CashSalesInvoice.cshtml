<script>

    var headerStoreId = 0;


    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#CashSalesInvoice").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        headerStoreId = masterDataItem.StoreID;

        masterId = masterDataItem.CashSalesInvoiceID;
        var linegridName = "#LineItems_" + masterId;
        var PartialPaymentGrid = "#PartialPayment" + masterId;
        $.ajax({
            url: '@Url.Action("GetStatus", "CashSalesInvoice")',

            data: { Id: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (masterDataItem.IsSendForApproval == true || r == "Forwarded" || r == "PaymentReceived" || r == "Product_Issued") {
                    $(linegridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", linegridName).hide();
                    $(".k-grid-edit", linegridName).hide();
                    $(".k-grid-delete", linegridName).hide();
                }
                if (r == "PaymentReceived") {
                    $(PartialPaymentGrid).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", PartialPaymentGrid).hide();
                    $(".k-grid-edit", PartialPaymentGrid).hide();
                    $(".k-grid-delete", PartialPaymentGrid).hide();
                }


            }

        });

    }
    function getHeaderStoreId() {
        return {
            storeId: headerStoreId
        };
    }
    var index = 0;
    var PopUpMode = "";

    var ItemIndex = 0;


</script>
<script>
    function BatchTransfer() {
        var periodObject = $("#PeriodList").data("kendoDropDownList");
        var periodid = periodObject.value();
       
        if (periodid != null) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("BatchtransferCashSalesInoice", "CRMTransactions", new {area = "Finance"})',
                data: { crmPeriodId: periodid },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                beforeSend: function(){
                    // Show image container
                    $("#loading-image").show();
                },
                complete:function(data){
                    // Hide image container
                    $("#loading-image").hide();
                },
                error: function (result) {
                    alert(result);
                }
            });


            $("#grid").data("kendoGrid").dataSource.read();
        } else {
            alert("Please select period.");
        }
        
    }
    function regenerateDistribution(id) {
        $.ajax({
                type: "POST",
                url: '@Url.Action("RegenerateDistribution", "CashSalesInvoice", new { area = "CRM" })',
                data: {
                    id: id,
                },
                success: function (result) {
                    alert(result.Message);
                    if (result.Status == "OK") {
                        location.reload(true);
                    }
                }, 
                error: function (result) {
                    alert(result);
                }
            });
    }
    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "CashSalesInvoice", new { area = "CRM" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }


</script>
