<style>
    .k-grid table tr.k-state-Issued {
        background: #99e6ff;
        color: #040000;
    }

    .k-grid table tr.k-state-approved {
        background: #99e6ff;
        color: #040000;
    }

    .k-grid table tr.k-state-Rejected {
        background: #fcabab;
        color: #040000;
    }

    .k-grid table tr.k-state-hold {
        background: #ffe699;
