                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a class="navbar-brand" href="#">Finance</a>
        </div>


        <div class="collapse navbar-collapse js-navbar-collapse">
            <ul class="nav navbar-nav">
                <li class="dropdown mega-dropdown">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="fa fa-bars"></i> Actions </a>

                    <ul class="dropdown-menu mega-dropdown-menu row">
                        <li class="col-sm-3">
                            @if (HttpContext.Current.User.IsInRole("General_Ledger_User")
                            || HttpContext.Current.User.IsInRole("General_Ledger_Post_User")
                            || HttpContext.Current.User.IsInRole("General_Ledger_Approver")
                            || HttpContext.Current.User.IsInRole("General_Ledger_Admin")
                            || HttpContext.Current.User.IsInRole("General_Ledger_View"))
                                                        {
                                <ul>
                                    <li class="dropdown-top-header">General Ledger</li>
                                    @if (HttpContext.Current.User.IsInRole("General_Ledger_User")
                                    || HttpContext.Current.User.IsInRole("General_Ledger_Admin")
                                    || HttpContext.Current.User.IsInRole("General_Ledger_Post_User")
                                    || HttpContext.Current.User.IsInRole("General_Ledger_Approver")
                                    || HttpContext.Current.User.IsInRole("General_Ledger_View"))
                                    {
                                        <li class="dropdown-header">Transactions</li>
                                        <li><a href="#">Unique Features</a></li>
                                    }
                                    <li><a href="#">Image Responsive</a></li>
                                    <li><a href="#">Auto Carousel</a></li>
                                    <li><a href="#">Newsletter Form</a></li>
                                    <li><a href="#">Four columns</a></li>
                                    <li class="divider"></li>
                                    <li class="dropdown-header">Tops</li>
                                    <li><a href="#">Good Typography</a></li>
                                </ul>
                            }
                            </li>
                        <li class="col-sm-3">
                            <ul>
                                <li class="dropdown-top-header">GL</li>
                                <li class="dropdown-header">Dresses</li>
                                <li><a href="#">Unique Features</a></li>
                                <li><a href="#">Image Responsive</a></li>
                                <li><a href="#">Auto Carousel</a></li>
                                <li><a href="#">Newsletter Form</a></li>
                                <li><a href="#">Four columns</a></li>
                                <li class="divider"></li>
                                <li class="dropdown-header">Tops</li>
                                <li><a href="#">Good Typography</a></li>
                            </ul>
                        </li>
                        <li class="col-sm-3">
                            <ul>
                                <li class="dropdown-header">Jackets</li>
                                <li><a href="#">Easy to customize</a></li>
                                <li><a href="#">Glyphicons</a></li>
                                <li><a href="#">Pull Right Elements</a></li>
                                <li class="divider"></li>
                                <li class="dropdown-header">Pants</li>
                                <li><a href="#">Coloured Headers</a></li>
                                <li><a href="#">Primary Buttons & Default</a></li>
                                <li><a href="#">Calls to action</a></li>
                            </ul>
                        </li>
                        <li class="col-sm-3">
                            <ul>
                                <li class="dropdown-header">Accessories</li>
                                <li><a href="#">Default Navbar</a></li>
                                <li><a href="#">Lovely Fonts</a></li>
                                <li><a href="#">Responsive Dropdown </a></li>
                                <li class="divider"></li>
                                <li class="dropdown-header">Newsletter</li>
                                
                            </ul>
                        </li>
                    </ul>

                </li>
            </ul>

        </div>
        <!-- /.nav-collapse -->
    </nav>
</div>

<legend> <i class="fa fa-tasks"></i>Actions</legend>

<div class="row">
    <div class="col-sm-2">

        @if (HttpContext.Current.User.IsInRole("General_Ledger_User")
        || HttpContext.Current.User.IsInRole("General_Ledger_Post_User")
        || HttpContext.Current.User.IsInRole("General_Ledger_Approver")
        || HttpContext.Current.User.IsInRole("General_Ledger_Admin")
        || HttpContext.Current.User.IsInRole("General_Ledger_View"))
        {

            <h4> General Ledger</h4>
            <hr />

            if (HttpContext.Current.User.IsInRole("General_Ledger_User")
                 || HttpContext.Current.User.IsInRole("General_Ledger_Admin")
                 || HttpContext.Current.User.IsInRole("General_Ledger_Post_User")
                 || HttpContext.Current.User.IsInRole("General_Ledger_Approver")
                 || HttpContext.Current.User.IsInRole("General_Ledger_View"))
            {
                <h5>Transaction</h5>
                if (HttpContext.Current.User.IsInRole("General_Ledger_User")
                    || HttpContext.Current.User.IsInRole("General_Ledger_Admin")
                     || HttpContext.Current.User.IsInRole("General_Ledger_Approver")
                     || HttpContext.Current.User.IsInRole("General_Ledger_View"))
                {

                    <p>
                        @Html.ActionLink("New Journals", "Index", "GlRecordJournal", new { area = "Finance" }, null)
                    </p>


                }
                if (HttpContext.Current.User.IsInRole("General_Ledger_Post_User")
                || HttpContext.Current.User.IsInRole("General_Ledger_Admin")
                || HttpContext.Current.User.IsInRole("General_Ledger_View"))
                {


                    <p>
                        @Html.ActionLink("Post Journals", "Index", "GlPostJournal", new { area = "Finance" }, null)
                    </p>


                }
                if (HttpContext.Current.User.IsInRole("General_Ledger_User")
                || HttpContext.Current.User.IsInRole("General_Ledger_Admin")
                || HttpContext.Current.User.IsInRole("General_Ledger_Approver")
                || HttpContext.Current.User.IsInRole("General_Ledger_View"))
                {

                    <p>
                        @Html.ActionLink("Posted Journals", "Index", "AccountsTransaction", new { area = "Finance" }, null)
                    </p>
                    <p>
                        @Html.ActionLink("All Approved Journals", "Index", "GlApprovedJournal", new { area = "Finance" }, null)
                    </p>


                }
                if (HttpContext.Current.User.IsInRole("General_Ledger_Post_User")
                || HttpContext.Current.User.IsInRole("General_Ledger_Admin")
                || HttpContext.Current.User.IsInRole("General_Ledger_View"))
                {

                    <p>
                        @Html.ActionLink("Ledger", "Index", "GlLedgerPosting", new { area = "Finance" }, null)
                    </p>

                }

            }

            if (HttpContext.Current.User.IsInRole("General_Ledger_Admin"))
            {

                <h5> GL Setup</h5>

                <p>
                    @Html.ActionLink("Accounts", "Index", "GlChartOfAccountAccount", new { area = "Finance" }, null)
                </p>
                <p>
                    @Html.ActionLink("Account Category", "Index", "GlChartOfAccountCategory", new { area = "Finance" }, null)
                </p>
                <p>
                    @Html.ActionLink("Dynamic Segment", "Index", "GlDynamicCofASegment", new { area = "Finance" }, null)
                </p>
                <p>
                    @Html.ActionLink("Branch Account Map", "Index", "GLBranchAccountMap", new { area = "Finance" }, null)
                </p>
                <p>
                    @Html.ActionLink("Journal Categories", "Index", "GlJournalCategoriers", new { area = "Finance" }, null)
                </p>
                <p>
                    @Html.ActionLink("Cost Allocation Setup", "Index", "GlCostAllocationSetup", new { area = "Finance" }, null)
                </p>
                <p>
                    @Html.ActionLink("Beginning", "Index", "GLRecordJournalBeg", new { area = "Finance" }, null)

                </p>



            }


        }
    </div>
    <div class="col-sm-2">
        AP
    </div>
    <div class="col-sm-2">
        AR
    </div>
    <div class="col-sm-2">
        Bank
    </div>
    <div class="col-sm-2">
        <i class="fa fa-dashboard"></i>Reports
    </div>
    <div class="col-sm-2">
        <i class="fa fa-cogs"></i>Settings
    </div>
</div>

<script>
    jQuery(document).on('click', '.mega-dropdown', function (e) {
        e.stopPropagation()
    })
</script>