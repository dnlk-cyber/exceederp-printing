@using ExceedERP.Core.Domain.Finance.Report.IFRS

@(Html.Kendo().Grid<IfrsSofpEquityAndLiablity>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Category);
          columns.Bound(c => c.Description);
          columns.Bound(c => c.AccountFrom);
          columns.Bound(c => c.AccountTo);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.IfrsSofpEquityAndLiablityId))
          .Read(read => read.Action("IfrsSofpEquityAndLiablities_Read", "IfrsSofpEquityAndLiablity"))
          .Create(create => create.Action("IfrsSofpEquityAndLiablities_Create", "IfrsSofpEquityAndLiablity"))
          .Update(update => update.Action("IfrsSofpEquityAndLiablities_Update", "IfrsSofpEquityAndLiablity"))
          .Destroy(destroy => destroy.Action("IfrsSofpEquityAndLiablities_Destroy", "IfrsSofpEquityAndLiablity"))
      ))
