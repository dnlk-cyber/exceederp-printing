@using System.Collections
@using ExceedERP.Core.Domain.Finance.GL
<legend>Post Journal</legend>
@(Html.Kendo().Grid<GlRecordJournal>()
              .Name("grid")
              .Columns(columns =>
              {
                  columns.Bound(c => c.GlRecordJournalId).Title("ID").Width(100).ClientTemplate("#=appendZeros(GlRecordJournalId)#");
                  columns.Bound(c => c.JournalName).Width(150);
                  columns.Bound(c => c.Description).Width(150);
                  columns.Bound(c => c.PeriodName).Width(120).EditorTemplateName("Period");
                  columns.Bound(c => c.CategoryName).Width(150).EditorTemplateName("GLCategory");
                  columns.Bound(c => c.JournalNumber).Title("Reference").Width(120);
                  columns.Bound(c => c.EffectiveDate).Title("Date").Width(130);
                  columns.Bound(c => c.Remark).Width(100);
                  columns.Bound(c => c.CreatedBy).Width(130);
                  columns.Bound(c => c.isReversed).Width(90).Title("Reversed").ClientTemplate(
                    "<input type='checkbox' disabled = 'true' value='#= isReversed #' " +
                    "# if (isReversed) { #" +
                    "checked='checked'" +
                    "# } #" +
                    "/>"
                    );
                  columns.Bound(c => c.Status).Width(100);
              })
              .ToolBar(toolbar =>
              {

                  toolbar.Template(@<text>

                    @(Html.Kendo().DropDownList()
                                  .OptionLabel("Select Year")
                                  .Name("yearSelector")
                                  .AutoBind(false)
                                  .DataValueField("GlFiscalYearId")
                                  .DataTextField("Name")
                                  .HtmlAttributes(new { style = "width: 200px;" })
                                  .DataSource(dataSource =>
                                  {
                                                               dataSource.Read(read => read.Action("GetOpenYears", "GlobalDataProvider", new { area = "Common" }))
                                                                   .ServerFiltering(false);
                                                           }))


                    @(Html.Kendo().DropDownList()
                                  .Name("PeriodList")
                                  .AutoBind(false)
                                  .DataValueField("GLPeriodId")
                                  .DataTextField("Name")
                                  .HtmlAttributes(new { style = "width: 200px;" })
                                  .ValuePrimitive(true)
                                  .DataSource(dataSource =>
                                  {
                                                               dataSource.Read(read => read.Action("GetOpenPeriods", "GlobalDataProvider", new { area = "Common" }).Data("getFiscalYear"))
                                                                   .ServerFiltering(true);
                                                           })
                                  .CascadeFrom("yearSelector")
                    )

                    @(Html.Kendo().DropDownList()
                                  .OptionLabel("Select Category")
                                  .Name("categorySelector")
                                  .AutoBind(false)
                                  .DataValueField("Category")
                                  .DataTextField("Category")
                                  .BindTo((IEnumerable)ViewData["CategoryList"])
                                  .HtmlAttributes(new { style = "width: 200px;" })
                    )

                    @(Html.Kendo().DropDownList()
                                 .OptionLabel("Select User")
                                 .Name("userSelector")
                                 .AutoBind(false)
                                 .DataValueField("User")
                                 .DataTextField("User")
                                 .BindTo((IEnumerable)ViewData["UserList"])
                                 .HtmlAttributes(new { style = "width: 200px;" })
                    )


                    @Html.Kendo().Button().Name("btnPost").HtmlAttributes(new { type = "button", @class = "k-primary" }).Content("Batch Post").Events(ev => ev.Click("BatchPost"))


                </text>);
                    })
                                  .HtmlAttributes(new { style = "height: 550px;" })
                                  .Pageable(pageable => pageable
                                      .Input(true)
                                      .Numeric(false)
                                      .Refresh(true)
                                      .PageSizes(true)
                                      .ButtonCount(20))
                                  .Scrollable()
                                  .Selectable(selectable =>
                                  {
                                      selectable.Mode(GridSelectionMode.Single);
                                      selectable.Type(GridSelectionType.Row);
                                  })
                                  .Sortable(sortable =>
                                  {
                                      sortable.SortMode(GridSortMode.SingleColumn);
                                  })
                                  .Filterable()
                                  .Groupable()
                                  .Events(ev => ev.DetailExpand("detailExpandPost"))
                                  .Scrollable(h => h.Height(500))
                                  .Events(x => x.DataBound("onDataBoundMaster"))
                                  .ClientDetailTemplateId("templates")
                                  .DataSource(dataSource => dataSource
                                      .Ajax()
                                      .Sort(sort => sort.Add("GlRecordJournalId").Descending())
                                      .PageSize(20)
                                      .Model(
                                          model =>
                                          {
                                              model.Id(p => p.GlRecordJournalId);
                                              model.Field(p => p.GlRecordJournalId).Editable(false);
                                              model.Field(p => p.VoidTime).Editable(false);
                                              model.Field(p => p.VoidBy).Editable(false);
                                              model.Field(p => p.isVoid).Editable(false);
                                              model.Field(p => p.OnlineApprovedTime).Editable(false);
                                              model.Field(p => p.OnlineApprovedBy).Editable(false);
                                              model.Field(p => p.IsOnlineApproved).Editable(false);
                                              model.Field(p => p.Status).Editable(false);
                                              model.Field(p => p.IsSendForApproval).Editable(false);
                                              model.Field(p => p.isPosted).Editable(false);
                                              model.Field(p => p.isReversed).Editable(false);
                                              model.Field(p => p.Posting).Editable(false);

                                              model.Field(p => p.SourcesName).Editable(false);
                                              model.Field(p => p.FiscalYear).Editable(false);


                                              model.Field(p => p.OrgBranchName).Editable(false);
                                              model.Field(p => p.CreatedBy).Editable(false);
                                              model.Field(p => p.ModifiedBy).Editable(false);
                                              model.Field(p => p.LastModified).Editable(false);
                                              model.Field(p => p.DateCreated).Editable(false);


                                          })
                                      .Events(events => events
                                          .Error("error_handler_one")
                                          .Sync("sync_handler"))
                                      .Read(read => read.Action("GlPostJournals_Read", "GlPostJournal"))
                                  ))


<script id="templates" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                            .Name("tabStrip#=GlRecordJournalId#")
                            .SelectedIndex(0)
                            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                            .Items(items =>
                            {
                                items.Add().Text("Journal Detail").Content(@<text>

                                    <div>
                                        <p><b>Record Status :#= Status #</b></p>
                                        # if (!IsSendForApproval&&!IsOnlineApproved)
                                        {#
                                        @*<a class="send" title="Send for Approval" href='@Url.Action("SendForApproval", "GLRecordJournal")/#=GlRecordJournalId#'><i class="fa fa-location-arrow fa-2x"></i>Send for Approval</a> <br />*@
                                        <a onclick='return sendForApproval("#=GlRecordJournalId#")' href=' \#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                        # } #

                                        # if (IsOnlineApproved)
                                        {#
                                        <a target="new" title="Print" href='@Url.Action("GlJournalVoucher", "FinancePrint")/#=GlRecordJournalId#'> <i class="fa fa-print fa-2x"></i>Print</a>
                                        <br />
                                        # } #

                                        # if (IsOnlineApproved && !isPosted)
                                        {#

                                        @*<p align="right"><a title="Reverse" href='@Url.Action("Reverse", "GLRecordJournal")/#=GlRecordJournalId#'><i class="fa fa-backward fa-2x"></i>Reverse</a> <br /></p>*@
                                        <p align="right">
                                            <a onclick='return Reverse("#=GlRecordJournalId#")' href=' \#' title="Reverse"><i class="fa fa-backward fa-2x">Reverse</i></a><br />
                                        </p>

                                        # } #

                                        # if (IsOnlineApproved && !isPosted )
                                        {#

                                        <a onclick='return postLedger("#=GlRecordJournalId#")' href=' \#' title="Post"><i class="fa fa-caret-square-o-down fa-2x"></i>Post</a>
                                        # } #


                                    </div>
                                    <div>
                                        <hr>
                                        <dl class="dl-horizontal">


                                            <dt>
                                                Created On
                                            </dt>
                                            <dd>
                                                #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                            </dd>
                                            <dt>
                                                Created By
                                            </dt>
                                            <dd>
                                                #= CreatedBy #
                                            </dd>
                                            <dt>
                                                Modified By
                                            </dt>
                                            <dd>
                                                #= ModifiedBy #
                                            </dd>
                                            <dt>
                                                Modified Date
                                            </dt>
                                            <dd>
                                                #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #
                                            </dd>
                                        </dl>
                                    </div>

                                </text>
                                            );
                                        items.Add().Text("Journal Lines").Content(@<text>
                                            @(Html.Kendo().Grid<GLRecordJournalDetail>()
                                                                              .Name("GLRecordJournalDetail#=GlRecordJournalId#")
                                                                              .Columns(columns =>
                                                                              {
                                                                                  columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(120);
                                                                                  columns.Bound(c => c.AccountDesc).Title("Account Description").Width(120);
                                                                                  columns.Bound(c => c.AdditionalDescription).Title("Description").Width(100);
                                                                                  columns.Bound(c => c.Debit).Width(50).ClientFooterTemplate("Total Debit: \\#=sum\\# ");
                                                                                  columns.Bound(c => c.Credit).Width(50).ClientFooterTemplate("Total Credit: \\#=sum\\# ");
                                                                                  columns.Command(command =>
                                                                      {

                                                                                          command.Edit();

                                                                                      }).Width(120).ClientFooterTemplate("Difference: \\#=Debit.sum-Credit.sum\\# ");
                                                                              })
                                                                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                              .Pageable(pageable => pageable
                                                                                  .Input(true)
                                                                                  .Numeric(false)
                                                                                  .Refresh(true)
                                                                                  .PageSizes(true)
                                                                                  .ButtonCount(10))
                                                                              .Scrollable()
                                                                              .Sortable()
                                                                              .Filterable()
                                                                              .Events(x => x.DataBound("onDataBoundPostLines"))
                                                                              .DataSource(dataSource => dataSource
                                                                                  .Ajax()
                                                                                  .Aggregates(aggregates =>
                                                                                  {
