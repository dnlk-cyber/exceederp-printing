                                                                          .Sync("sync_handler"))
                                                                      .Read(read => read.Action("GLRecordJournalValidations_Read", "GlRecordJournalValidation", new { id = "#=GlRecordJournalId#" }))

                                                                  )
                                                                  .ToClientTemplate())

                                        </text>);
                                })

                                                .ToClientTemplate()
    )

</script>





<script>



    function postLedger(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("PostLedger", "GlPostJournal", new { area = "Finance" })',
            data: { id: id },
            success: function(result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
               // recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            beforeSend: function(){
                // Show image container
                $("#loading-image").show();
            },
            complete:function(data){
                // Hide image container
                $("#loading-image").hide();
            },
            error: function(result) {
                alert(result);
            }
        });



    }

    function BatchPost() {
        var periodObject = $("#PeriodList").data("kendoDropDownList");
        var periodid = periodObject.value();

        var catObject = $("#categorySelector").data("kendoDropDownList");
        var cat = catObject.value();

        var userObject = $("#userSelector").data("kendoDropDownList");
        var user = userObject.value();

        if (periodid != null) {
            $("#btnPost").attr("disabled", true);
            $.ajax({
                type: "POST",
                url: '@Url.Action("BatchPost", "GlPostJournal", new {area = "Finance"})',
                data: { id: periodid, category:cat,user:user },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                beforeSend: function(){
                    // Show image container
                    $("#loading-image").show();
                },
                complete:function(data){
                    // Hide image container
                    $("#loading-image").hide();
                },
                error: function (result) {
                    alert(result);
                }
            });


            $("#grid").data("kendoGrid").dataSource.read();
        } else {
            alert("Please select period.");
        }

    }

    function getFiscalYear() {
        return { year: $("#yearSelector").data("kendoDropDownList").value() }
    }

    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    var isapproved;
    var issecondapproved;
    var isPosted;

    function detailExpandPost(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        isapproved = masterDataItem.IsOnlineApproved;
        isPosted = masterDataItem.isPosted;
        codeid = masterDataItem.GlRecordJournalId;

    }

    function onDataBoundPostLines(e) {

        var detailGrid = "#" + e.sender.element[0].id;
        if (isapproved) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
        }
        if (isPosted) {
            $(".k-grid-edit", detailGrid).hide();
        }
    }


    $("a.send").click(function (event) {
        //alert("sent");
        //event.preventDefault();

        var item = $(this).text();//$(this).attr('id');
        $.ajax({
            url: '/Finance/JSON/Description',
            type: 'POST',
            data: { id: item },
            success: function (result) {
                if (result.length > 0) {
                    for (var i = 0; i < result.length; i++) {
                        $("#DescriptionArea").text('');
                        $("<a>")
                            .append(result[i].Description)
                            .appendTo("#DescriptionArea");
                    }
                }
                else {
                    alert("Description not found");
                }

            }, //end succ
            error: function (result) {
                alert(result);
            }
        }); //end post
    });//end of click

    function PostrJournal(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.GlRecordJournalId;
        $.ajax({
            type: "GET",
            data: id,
            url: '@Url.Action("PostLedger", "GlPostJournal")/' + id

        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();
        location.reload();
    };

    function SendforApproval(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.GlRecordJournalId;
        $.ajax({
            type: "GET",
            data: id,
            url: '@Url.Action("SendforApproval", "GlRecordJournal")/' +id

        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();
        location.reload();
    };

    function Reverse(id) {
        //var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        //var id = dataItem.GlRecordJournalId;
        $.ajax({
             type: "POST",
            url: '@Url.Action("Reverse", "GlRecordJournal", new { area = "Finance" })',
            data: { id: id },

            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            beforeSend: function () {
                // Show image container
                $("#loading-image").show();
            },
            complete: function (data) {
                // Hide image container
                $("#loading-image").hide();
            },
            error: function (result) {
                alert(result);
            }

        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();
        location.reload();
    };

</script>

<script type="text/javascript">

    function clicked(str) {
        //alert(str);
    }

    //register custom validation rules
    (function ($, kendo) {
        $.extend(true, kendo.ui.validator, {
            rules: { // custom rules
                debitvalidation: function (input, params) {
                    //added
                    var row = input.closest("tr");
                    var grid = row.closest("[data-role=grid]").data("kendoGrid");
                    var dataItem = grid.dataItem(row);

                    //alert(dataItem.Credit);
                    //original
                    input.attr("data-debitvalidation-msg", "Either debit or credit only can have non zero value");
                    if (input.is("[name='Debit']")) {
                        return (!((parseFloat(dataItem.Credit) !== parseFloat(0)) && (parseFloat(dataItem.Debit) !== parseFloat(0))));
                    }
                    return true;
                }
            },
            messages: { //custom rules messages
                debitvalidation: function (input) {
                    // return the message text
                    return input.attr("data-val-debitvalidation");
                }
            }
        });
    })(jQuery, kendo);




    function sync_handler(e) {
        this.read();
    }
</script>


<script>



    $(function () {

        $("#GLRecordJournalDetail table").on("keydown", "tr", function (e) {
            var grid = $("#GLRecordJournalDetail").data("kendoGrid");
            var code = (e.keyCode ? e.keyCode : e.which);

            if (code === 13) { //Enter keycode
                $(e.srcElement).closest("tbody").focus();
                setTimeout(function () {
                    grid.saveRow();
                });
            }
        });
        var grid = $("#grid").data("kendoGrid");
        grid.addRow();
        $(".k-grid-edit-row").appendTo("#GLRecordJournalDetail1 tbody");
    });

    $("#grid").delegate(".details-button", "click", function (e) {
        var row = $(this).closest("tr"),
            grid = $(this).parents("[data-role=grid]").data("kendoGrid"); //gets child grid
        //var model = grid.dataItem(row);
        //console.log(model); //model contains the id
    });
</script>

