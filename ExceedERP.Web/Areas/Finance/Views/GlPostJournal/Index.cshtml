                                                                                  .Read(read => read.Action("GLRecordJournalDetails_Read", "GlRecordJournalLines", new { id = "#=GlRecordJournalId#" }))
                                                                                  .Update(update => update.Action("GLRecordJournalDetails_Update", "GlPostJournal", new { id = "#=GlRecordJournalId#" }))
                                                                              )

                                                                              .ToClientTemplate())
                                        </text>);

                                                items.Add().Text("Validation").Content(
                                        @<text>
                                            @(Html.Kendo().Grid<GLRecordJournalValidation>()
                                                                  .Name("GLRecordJournalValidation#=GlRecordJournalId#")
                                                                  .Columns(columns =>
                                                                  {
                                                                              columns.Bound(c => c.GlRecordJournalValidationId).Hidden(true);
                                                                              columns.Bound(c => c.Status).EditorTemplateName("ApprovalStatus").Width(150);
                                                                              columns.Bound(c => c.Remark).Width(200);

                                                                              columns.Bound(c => c.DateCreated).Width(200).Title("Time").Format("{0:dd/MM/yyyy}");
                                                                              columns.Bound(c => c.LastModified).Hidden(true);
                                                                              columns.Bound(c => c.CreatedBy).Width(200).Title("User");
                                                                              columns.Bound(c => c.ModifiedBy).Hidden(true);
                                                                          })

                                                                  .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                  .Events(x => x.DataBound("onDataBoundFisrtValidation"))
                                                                  .Pageable(pageable => pageable
                                                                      .Input(true)
                                                                      .Numeric(false)
                                                                      .Refresh(true)
                                                                      .PageSizes(true)
                                                                      .ButtonCount(5))
                                                                  .Sortable(sortable =>
                                                                  {
                                                                              sortable.SortMode(GridSortMode.SingleColumn);
                                                                          })
                                                                  .Filterable()
                                                                  .Scrollable()
                                                                  .DataSource(dataSource => dataSource
                                                                      .Ajax()
                                                                      .Model(
                                                                          model =>
