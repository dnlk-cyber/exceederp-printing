@using ExceedERP.Core.Domain.Finance
<legend>Currency</legend>
@(Html.Kendo().Grid<FinSetupCurrency>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Code).Width(135);
          columns.Bound(c => c.Name).Width(100);
          columns.Bound(c => c.Territory).Width(120).Title("Territory");
          columns.Bound(c => c.Enable).Width(150).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= FinSetupCurrencyID #' " +
              "# if (Enable) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          
          columns.Bound(c => c.DateCreated).Format("{0:dd/MM/yyyy}").Width(130).Hidden(true);
          columns.Bound(c => c.LastModified).Format("{0:dd/MM/yyyy}").Width(130).Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(130).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(130).Hidden(true);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
                              //toolbar.Excel();
                              // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Sortable()
      .Filterable()
      .Groupable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(
              model =>
              {
                  model.Id(p => p.FinSetupCurrencyID);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
              })
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("FinSetupCurrencies_Read", "FinSetupCurrency"))
          .Create(create => create.Action("FinSetupCurrencies_Create", "FinSetupCurrency"))
          .Update(update => update.Action("FinSetupCurrencies_Update", "FinSetupCurrency"))
          .Destroy(destroy => destroy.Action("FinSetupCurrencies_Destroy", "FinSetupCurrency"))
      ))


