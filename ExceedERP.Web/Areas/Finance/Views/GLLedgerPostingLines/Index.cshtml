@using ExceedERP.Core.Domain.Finance.GL
@(Html.Kendo().Grid<GLLedgerPosting>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.AccountCode);
          columns.Bound(c => c.AccountDesc);
          columns.Bound(c => c.AccountType);

          columns.Bound(c => c.OrgBranchName).Width(100).Hidden(true);
          columns.Bound(c => c.DateCreated).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.LastModified).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
       
      })
      .ToolBar(toolbar => {
          
                              toolbar.Excel();
                              // toolbar.Pdf();
      })
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Sortable()
      .Filterable()
      
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.GLLedgerPostingID))
          .Read(read => read.Action("GLLedgerPostings_Read", "GlLedgerPostingLines"))
      ))
