
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.AP.Travel.ApTravelOrderAdvancePayment>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Type);
          columns.Bound(c => c.Description);
          columns.Bound(c => c.UoM);
          columns.Bound(c => c.UnitPrice);
          columns.Bound(c => c.Quantity);
          columns.Bound(c => c.Total);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ApTravelOrderAdvancePaymentId))
          .Read(read => read.Action("ApTravelOrderAdvancePayments_Read", "ApTravelOrderAdvancePayment"))
          .Create(create => create.Action("ApTravelOrderAdvancePayments_Create", "ApTravelOrderAdvancePayment"))
          .Update(update => update.Action("ApTravelOrderAdvancePayments_Update", "ApTravelOrderAdvancePayment"))
          .Destroy(destroy => destroy.Action("ApTravelOrderAdvancePayments_Destroy", "ApTravelOrderAdvancePayment"))
      ))
