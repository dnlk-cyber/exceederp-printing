                                                                    .RequestStart("onRequestStart(\"APPaymentValidation#=ApPaymentId#\")")
                                                                    .RequestEnd("onRequestEnd(\"APPaymentValidation#=ApPaymentId#\")"))
                                                                .Read(read => read.Action("APPaymentValidations_Read", "ApPaymentValidation", new { id = "#=ApPaymentId#" }))
                                                                .Create(create => create.Action("APPaymentValidations_Create", "ApPaymentValidation", new { id = "#=ApPaymentId#" }))
                                                                .Update(update => update.Action("APPaymentValidations_Update", "ApPaymentValidation", new { id = "#=ApPaymentId#" }))
                                                                .Destroy(destroy => destroy.Action("APPaymentValidations_Destroy", "ApPaymentValidation"))
                                                            )
                                                            .ToClientTemplate())

                    </text>);




          })

                                                      .ToClientTemplate()
                        )

                    </script>



<script>

    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "ApPayment", new {area = "Finance"})',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendforApproval", "ApPayment", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                //toastr.success(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "ApPayment", new { area = "Finance" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }


   
    

    
    function filterPurchaseReferences() {

        return {
            //purReference: $("#PoType").data("kendoDropDownList").value(),
            text: $("#PurchaseReference").data("kendoDropDownList").filterInput.val()
            //purchaser: $("#EmployeeId").data("kendoDropDownList").value()
        };
    }



  

    function onSelectReferenceNumber(e) {
        //alert("change");
        var id = $("#PurchaseReference").data("kendoDropDownList").value();
        //var source = $("#PoType").data("kendoDropDownList").value();
        // alert(id);
        //begin
        $.ajax({
            url: '/Finance/FinanceDataProvider/GetPaymentRequestData',
            type: 'GET',
            data: { id: id },
            success: function (result) {
                $("#SupplierId").val(result.SupplierId).trigger("change");
                $("#SupplierName").val(result.SupplierName).trigger("change");
                $("#PrepaymentAmount").val(result.Amount).trigger("change");
                $("#PaymentAmount").val(result.Amount).trigger("change");
            }, //end succ
            error: function (result) {
                alert(result);
            }
        }); //end post
        //end
    }

    var isNotTransffered = false;

    function isNotTransferredCheck(obj) {
        if ($(obj).is(":checked")) {
            isNotTransffered = true;
            $("#grid").data("kendoGrid").dataSource.read();

        } else {
            isNotTransffered = false;
            $("#grid").data("kendoGrid").dataSource.read();

        }

    }

    function passReadData() {
        return {
            isNotTransffered: isNotTransffered
        };
    }
</script>

