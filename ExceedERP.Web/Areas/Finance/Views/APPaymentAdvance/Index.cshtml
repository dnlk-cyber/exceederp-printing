                                                        <br />
                                                        # } #

                                                        # if (IsOnlineApproved)
                                                        {#
                                                        <a target="new" href='@Url.Action("ApPayment", "FinancePrint")/#=ApPaymentId#'><i class="fa fa-print fa-2x"></i></a>

                                                        # } #

                                                        # if (IsOnlineApproved && !IsVoid&& !IsOnlineTransferred)
                                                        {#
                                                        &nbsp;  &nbsp;   &nbsp;   <a onclick='return transferToGl("#=ApPaymentId#")' href=' \#' title="Transfer to GL"><i class="fa fa-paper-plane fa-2x"></i></a>
                                                        # } #


                                                    </div>
                                                    <div>
                                                        <hr>
                                                        <dl class="dl-horizontal">


                                                            <dt>
                                                                Created On
                                                            </dt>
                                                            <dd>
                                                                #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                                            </dd>
                                                            <dt>
                                                                Created By
                                                            </dt>
                                                            <dd>
                                                                #= CreatedBy #
                                                            </dd>
                                                            <dt>
                                                                Modified By
                                                            </dt>
                                                            <dd>
                                                                #= ModifiedBy #
                                                            </dd>
                                                            <dt>
                                                                Modified Date
                                                            </dt>
