@using System.Collections
@using System.Security.Policy
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Web.Areas.Finance.Models
<legend>Pre Payments</legend>
@(Html.Kendo().Grid<ApPayment>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ApPaymentId).Title("ID").Width(80).ClientTemplate("#=appendZeros(ApPaymentId)#");
          //columns.Bound(c => c.IsPrepayment).Width(100).Title("Is Prepayment?").ClientTemplate(
          //    "<input type='checkbox' disabled = 'true' value='#= IsPrepayment #' " +
          //    "# if (IsPrepayment) { #" +
          //    "checked='checked'" +
          //    "# } #" +
          //    "/>"
          //    );
          //columns.ForeignKey(c => c.SupplierId, (IEnumerable)ViewData["suppliers"], "SupplierId", "Name").Title("Supplier").Width(200);
          columns.Bound(c => c.PurchaseReference).Width(100);
          columns.Bound(c => c.SupplierId).Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.SupplierName).Width(180).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.PaymentDate).Width(120).Format("{0:dd/MM/yyyy}");
          columns.Bound(c => c.PrepaymentAmount).Width(130);
          columns.Bound(c => c.PaymentMethod).EditorTemplateName("PaymentMethods").Width(130);
          columns.Bound(c => c.PaymentReference).Width(130);
          columns.ForeignKey(p => p.ForBranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").Width(130);
          //columns.Bound(c => c.PoType).Width(110);         
          columns.Bound(c => c.Remark).Width(120);
          columns.Bound(c => c.Status).Width(80);

          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
          toolbar.Template(
                                  @<text>

                    <a class="k-button k-button-icontext k-grid-add" href='\#'><span class="k-icon k-i-add"></span> Add new record</a>
                    @*<button class="k-button k-button-icontext k-grid-excel" href='\#'> <span class="k-icon k-i-excel"></span>Export to Excel</button>*@

                    @(Html.Kendo().CheckBox()
                                    .Name("checktransfferable")
                                    .Label("Show Transferrable Only")
                                    .HtmlAttributes(new { onchange = "isNotTransferredCheck(this)" })
                    )



                </text>);
      })
      .Excel(excel => excel
          .FileName("AP Advance Payment.xlsx")
          .Filterable(true)
          .AllPages(true)
      )
                .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ApPayment").Window(w => w.Title("Pre Payment")))

      .Events(ev => ev.DetailExpand("detailExpand"))
                    .Scrollable(h => h.Height(500))
                     .Events(x => x.DataBound("onDataBoundMaster"))
            .HtmlAttributes(new { style = "height: 600px;" })
                  .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))

                        .Scrollable()
                            .Selectable(selectable =>
                            {
                                selectable.Mode(GridSelectionMode.Single);
                                selectable.Type(GridSelectionType.Row);
                            })
                    .Sortable(sortable =>
                    {
                        sortable.SortMode(GridSortMode.SingleColumn);
                    })
                        .Filterable()

                        .ClientDetailTemplateId("templates")
      .DataSource(dataSource => dataSource
          .Ajax()
                  .Sort(sort => sort.Add("ApPaymentId").Descending())
                  .Model(
                    model =>
                    {
                        model.Id(p => p.ApPaymentId);
                        model.Field(p => p.RemainingBalance).Editable(false);
                        model.Field(p => p.IsSettled).Editable(false);

                        model.Field(p => p.VoidTime).Editable(false);
                        model.Field(p => p.VoidBy).Editable(false);
                        model.Field(p => p.IsVoid).Editable(false);

                        model.Field(p => p.OnlineApprovedTime).Editable(false);
                        model.Field(p => p.OnlineApprovedBy).Editable(false);
                        model.Field(p => p.IsOnlineApproved).Editable(false);
                        model.Field(p => p.Status).Editable(false);

                        model.Field(p => p.IsSendForApproval).Editable(false);
                        model.Field(p => p.IsOnlineTransferred).Editable(false);
                        model.Field(p => p.IsOnlineTransferredBy).Editable(false);
                        model.Field(p => p.OnlineTransferredTime).Editable(false);


                        model.Field(p => p.ForBranchId).Editable(false);
                        model.Field(p => p.BranchId).Editable(false);
                        model.Field(p => p.BusinessUnitId).Editable(false);
                        model.Field(p => p.CreatedAtBranchId).Editable(false);
                        model.Field(p => p.CreatedAtBusinessUnitId).Editable(false);

                        model.Field(p => p.OrgBranchName).Editable(false);
                        model.Field(p => p.CreatedBy).Editable(false);
                        model.Field(p => p.ModifiedBy).Editable(false);
                        model.Field(p => p.LastModified).Editable(false);
                        model.Field(p => p.DateCreated).Editable(false);


                    })
                  .Events(ev => ev
                      .Error("error_handler(\"grid\")")
                      .RequestStart("onRequestStart(\"grid\")")
                      .RequestEnd("onRequestEnd(\"grid\")"))
            .Read(read => read.Action("APPayments_Read", "ApPaymentAdvance").Data("passReadData"))
            .Create(create => create.Action("APPayments_Create", "ApPaymentAdvance"))
            .Update(update => update.Action("APPayments_Update", "ApPaymentAdvance"))
            .Destroy(destroy => destroy.Action("APPayments_Destroy", "ApPaymentAdvance"))
      )
)


                    <script id="templates" type="text/kendo-tmpl">
                        @(Html.Kendo().TabStrip()
                                              .Name("tabStrip#=ApPaymentId#")
