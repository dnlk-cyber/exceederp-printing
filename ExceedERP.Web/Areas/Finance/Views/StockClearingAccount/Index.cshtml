
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.StockClearingAccount>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Type).Width(120);
          columns.Bound(c => c.Description).Width(120);
          columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(220);
          columns.Bound(c => c.Enable).Width(100).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= Enable#' " +
              "# if (Enable) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.OrgBranchName).Hidden();
          columns.Bound(c => c.DateCreated).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.LastModified).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(events => events
              .Error("error_handler_one")
              .Sync("sync_handler"))
          .Model(model => model.Id(p => p.StockClearingAccountId))
          .Read(read => read.Action("StockClearingAccounts_Read", "StockClearingAccount"))
          .Create(create => create.Action("StockClearingAccounts_Create", "StockClearingAccount"))
          .Update(update => update.Action("StockClearingAccounts_Update", "StockClearingAccount"))
          .Destroy(destroy => destroy.Action("StockClearingAccounts_Destroy", "StockClearingAccount"))
      ))
