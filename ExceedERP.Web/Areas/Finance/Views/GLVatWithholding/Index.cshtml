@using ExceedERP.Core.Domain.Finance.GL
<legend>Vat Withholding</legend>
@(Html.Kendo().Grid<GLVatWithholding>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.WithholdingAccountCode).EditorTemplateName("AccountCode").Width(150);
          columns.Bound(c => c.Branch).Hidden();

          columns.Bound(c => c.DateCreated).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.LastModified).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
                             // toolbar.Excel();
                              // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Sortable()
      .Filterable()
      .Groupable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(
              model =>
              {
                  model.Id(p => p.GLVatWithholdingID);
                  model.Field(p => p.Branch).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
              })
          .Events(events => events .Error("error_handler_one"))
          .Read(read => read.Action("GLVatWithholdings_Read", "GlVatWithholding"))
          .Create(create => create.Action("GLVatWithholdings_Create", "GlVatWithholding"))
          .Update(update => update.Action("GLVatWithholdings_Update", "GlVatWithholding"))
          .Destroy(destroy => destroy.Action("GLVatWithholdings_Destroy", "GlVatWithholding"))
      ))

<script type="text/javascript">
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

   


    $(function() {
        //$("#grid table").on("dblclick", "tr", function (e) {
        //    var grid = $("#grid").data("kendoGrid");
        //    grid.editRow($(this));
        //})

        $("#grid table").on("keydown", "tr", function(e) {
            var grid = $("#grid").data("kendoGrid");
            var code = (e.keyCode ? e.keyCode : e.which);

            if (code === 13) { //Enter keycode
                $(e.srcElement).closest("tbody").focus();
                setTimeout(function() {
                    grid.saveRow();
                });
            }
        });
            var grid = $("#grid").data("kendoGrid");
            grid.addRow();
            $(".k-grid-edit-row").appendTo("#grid tbody");
    });
</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 800px;
        height: auto;
    }

    div.k-content {
        overflow: hidden;
        height: auto;
    }

    #popupwrapper img {
        vertical-align: middle;
    }
</style>