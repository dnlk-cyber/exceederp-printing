@using System.Collections
@using ExceedERP.Core.Domain.Finance.AR
<legend>Setup Product Account</legend>
@(Html.Kendo().Grid<ARSetupProductServiceAccount>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Product).Width(150);
          columns.Bound(c => c.Description).Width(200);
          columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(150);

          columns.Bound(c => c.OrgBranchName).Width(100).Hidden(true);
          columns.Bound(c => c.DateCreated).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.LastModified).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
                              //toolbar.Excel();
                              // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Groupable()
      .ClientDetailTemplateId("templates")
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(
              model =>
              {
                  model.Id(p => p.ARSetupProductServiceAccountID);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
              })
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("ARSetupProductServiceAccounts_Read", "ArSetupProductServiceAccount"))
          .Create(create => create.Action("ARSetupProductServiceAccounts_Create", "ArSetupProductServiceAccount"))
          .Update(update => update.Action("ARSetupProductServiceAccounts_Update", "ArSetupProductServiceAccount"))
          .Destroy(destroy => destroy.Action("ARSetupProductServiceAccounts_Destroy", "ArSetupProductServiceAccount"))
      )
      .Events(events => events.DataBound("dataBound")))


<script id="templates" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("tabStrip#=ARSetupProductServiceAccountID#")
                  .SelectedIndex(0)
                  .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                  .Items(items =>
                  {
                     
                            items.Add().Text("Items and Service").Content(@<text>
                                @(Html.Kendo().Grid<ArProductService>()
                                      .Name("ArProductService#=ARSetupProductServiceAccountID#")
                                      .Columns(columns =>
                                      {
                                          columns.Bound(c => c.Code).Width(120);
                                          columns.Bound(c => c.ItemName).Width(150);
                                          columns.Bound(c => c.Description).Width(150);
                                          columns.ForeignKey(p => p.UoM, (IEnumerable)ViewData["Units"], "UoMName", "UoMName").Width(130).EditorTemplateName("Unit");
                                          columns.Bound(c => c.SalesPrice).Width(140);
                                          columns.Bound(c => c.Remark).Width(100);
                                          columns.Bound(c => c.OrgBranchName).Width(100).Hidden(true);
                                          columns.Bound(c => c.DateCreated).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
                                          columns.Bound(c => c.LastModified).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
                                          columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
                                          columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
                                          columns.Command(command =>
                                          {

                                              command.Edit();
                                              command.Destroy();

                                          }).Width(280);
                                      })
                                      .ToolBar(toolbar =>
                                      {
                                          toolbar.Create();
                                      })

                                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                                      .Events(x => x.DataBound("onDataBoundLines"))
                                      .Scrollable()
                                      .Sortable()
                                      .Filterable()
                                      .DataSource(dataSource => dataSource
                                          .Ajax()
                                          .Model(
                                              model =>
                                              {
                                                  model.Id(p => p.ArProductServiceId);
                                                  model.Field(p => p.OrgBranchName).Editable(false);
                                                  model.Field(p => p.CreatedBy).Editable(false);
                                                  model.Field(p => p.ModifiedBy).Editable(false);
                                                  model.Field(p => p.LastModified).Editable(false);
                                                  model.Field(p => p.DateCreated).Editable(false);
                                              })
                                          .Events(events => events
                                              .Error("error_handler(\"ArProductService#=ARSetupProductServiceAccountID#\")")
                                              .RequestStart("onRequestStart(\"ArProductService#=ARSetupProductServiceAccountID#\")")
                                              .RequestEnd("onRequestEnd(\"ArProductService#=ARSetupProductServiceAccountID#\")"))
                                          .Read(read => read.Action("ArProductService_Read", "ArProductService", new { id = "#=ARSetupProductServiceAccountID#" }))
                                          .Create(create => create.Action("ArProductService_Create", "ArProductService", new { id = "#=ARSetupProductServiceAccountID#" }))
                                          .Update(update => update.Action("ArProductService_Update", "ArProductService", new { id = "#=ARSetupProductServiceAccountID#" }))
                                          .Destroy(destroy => destroy.Action("ArProductService_Destroy", "ArProductService"))
                                      )

                                      .ToClientTemplate())
                            </text>);

                                   
    
                                                })

                                                .ToClientTemplate()
    )

</script>
