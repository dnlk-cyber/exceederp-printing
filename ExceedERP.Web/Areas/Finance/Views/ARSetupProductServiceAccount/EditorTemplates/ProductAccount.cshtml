
@model  ExceedERP.Core.Domain.Finance.AR.ARSetupProductServiceAccount
          

@Html.HiddenFor(model => model.ARSetupProductServiceAccountID)
<div class="form">
    <div class="row fullrow">
        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.Product, htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(m => m.Product)
                    @Html.ValidationMessageFor(model => model.Product, "", new {@class = "text-danger"})
                </div>
            </div>
            <div class="row"></div>
        </div>

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Description)
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
        </div>

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.AccountCode, htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @Html.TextBoxFor(model => model.AccountCode)
                    @Html.ValidationMessageFor(model => model.AccountCode, "", new {@class = "text-danger"})
                </div>
            </div>
            <div class="row"></div>
            <div>
                <img src="~/Content/Images/search.png" onclick="SelectAccCode()" />
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var popup;

    function SelectAccCode() {
        popup = window.open('/Finance/AccountCode/GLAccountSelector', 'WindowPopup', 'top=100, left=400, width=300, height=320,resizable=no,');
        popup.focus();
        return false;
    }
</script>






