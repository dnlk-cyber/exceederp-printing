
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.Bank.ReconciliationBankServiceCharge>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Amount);
        columns.Bound(c => c.Date);
        columns.Bound(c => c.Remark);
        columns.Bound(c => c.DateCreated);
        columns.Bound(c => c.LastModified);
        columns.Bound(c => c.CreatedBy);
        columns.Bound(c => c.ModifiedBy);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ReconciliationBankServiceChargeId))
          .Read(read => read.Action("ReconciliationBankServiceCharges_Read", "ReconciliationBankServiceCharge"))
          .Create(create => create.Action("ReconciliationBankServiceCharges_Create", "ReconciliationBankServiceCharge"))
          .Update(update => update.Action("ReconciliationBankServiceCharges_Update", "ReconciliationBankServiceCharge"))
          .Destroy(destroy => destroy.Action("ReconciliationBankServiceCharges_Destroy", "ReconciliationBankServiceCharge"))
      )
)
