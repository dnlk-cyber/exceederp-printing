<script>

    function filterEmployees() {
        return {
            text: $("#EmployeeId").data("kendoDropDownList").filterInput.val(),
        }
    }

    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;

    var isDeptapproved;
    var isDeptSendForApproval;

    function detailExpandMasterDepartment(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.FundTransferId;
        isDeptapproved = masterDataItem.IsDepartmentOnlineApproved;
        isDeptSendForApproval = masterDataItem.IsDepartmentSendForApproval;
    }
    function onDataBoundMasterDepartment(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsDepartmentOnlineApproved || gridData[i].IsDepartmentSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsDepartmentSendForApproval && !dataItem.IsDepartmentOnlineApproved) {
                row.css("background-color", "lightgreen");
            }
            if (!dataItem.IsDepartmentSendForApproval && !dataItem.IsDepartmentOnlineApproved) {
                row.css("background-color", "lightskyblue");
            }

            if (dataItem.IsBudgetApproved) {
                row.css("background-color", "gold");
            }

            if (dataItem.Paid) {
                row.css("background-color", "honeydew");
            }

            if (dataItem.IsVoid) {
                row.css("background-color", "slategray");
                row.css("color", "black");
            }
        }


    }
    function onDataBoundLineDepartment(e) {

        var detailGrid = "#" + e.sender.element[0].id;
        if (isDeptapproved || isDeptSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundValidationDepartment(e) {


        var detailGrid = "#" + e.sender.element[0].id;

        if (isDeptapproved || !isDeptSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }



        this.table.find(".k-grid-edit").hide();
    }

</script>
<script>

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendforDepartmentApproval", "FundTransferRequest", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#FromAmharic").trigger("change");
        $("#ToAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "LeaveRequest")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }

</script>

<script>
    function GetBalance() {

        $("#LeaveBalance").val(0);
        var employee = $("#EmployeeId").data("kendoDropDownList");
        var empId = employee.value();
        var periods = $("#GlFiscalYearId").data("kendoDropDownList");
        var period = periods.value();

        if (empId.length !== 0 && period.length !== 0)
        {

            $.ajax({
                url: '@Url.Action("GetAmount", "LeaveRequest")',

                data: { period: period, empId: empId },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    var s = r.split(/-/);

                    $("#LeaveBalance").val(s[0]);
                    $("#LeaveBalance").trigger("change");
                }

            });
        }
        else
        {

            $.ajax({
                url: '@Url.Action("GetCurrentEmpBalance", "LeaveRequest")',

                data: { period: period },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    var s = r.split(/-/);

                    $("#LeaveBalance").val(s[0]);
                    $("#LeaveBalance").trigger("change");
                }

            });
        }
    }

</script>
<script>

    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#LeaveRequestgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.LeaveRequestId;
        var gridName = "#RequestesStatusgrid_" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatus", "LeaveRequestStatus")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                }
                else if (r == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else if (r == "Dapproved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", gridName).show();
                }

            }

        });

    }
    function SetEmployee(e) {
        var x = e.checked;
        var dropDown = $("#EmployeeId").data("kendoDropDownList");
        if (x == true) {
            $("#LeaveBalance").val(0);
            $("#LeaveBalance").trigger("change");
            dropDown.enable(true);


        }
        else {
            dropDown.value(0);
            dropDown.enable(false);
        }
        $.ajax({
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("SetEmployee", "LeaveRequest")',
            data: { x: x },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
                if (x==true && r == "0")
                {
                    e.checked = false;
                    dropDown.value(0);
                    dropDown.enable(false);
                    alert("You can not request for other employee!!.\nThere is no employee under your postion.");
                }
              //  $("#EmployeeId").data('kendoComboBox').dataSource.read();
                //$("#EmployeeId").data('kendoComboBox').refresh();
            }

        });


    }
    function valueMapper(options) {
        $.ajax({
            url: "/HRM/HRMDataProvider/Employee_ValueMapper/",
            data: {
                value: options.value || 0,
                status: 1,
                excludeId: -1
            },
            success: function (data) {
                options.success(data);
            }
        });
    }

    function convertValues(value) {
        var data = {};

        value = $.isArray(value) ? value : [value];

        for (var idx = 0; idx < value.length; idx++) {
            data["values[" + idx + "]"] = value[idx];
        }

        return data;
    }
    function IsforOthers() {
        return {
            IsForOther: $("#IsForOther").val()
        };
    }

    function onUploadSuccess(e) {
        var gridname = "#FundTransferAttachment" + codeid;
        $(gridname).data("kendoGrid").dataSource.read();
    }

</script>