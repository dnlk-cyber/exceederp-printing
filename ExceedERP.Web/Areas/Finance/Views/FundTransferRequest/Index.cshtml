<legend>Fund Transfer Reqeust  (Self Care)</legend>
@(Html.Kendo().Grid<FundTransfer>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.Bound(c => c.FundTransferId).Title("#").Width(100).ClientTemplate("#=appendZeros(FundTransferId)#");
              columns.Bound(c => c.RequestDate).Width(120);
              columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("EmployeeSelector").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.ReasonOfTransfer).Width(130);
              if (GlobalHelper.IsPayrollModebranchAndBusinessUnit())
              {
                  columns.ForeignKey(c => c.FromBusinessUnitId, (IEnumerable)ViewData["BusinessUnits"], "BusinessUnitId", "Name").Width(180).EditorTemplateName("BusinessUnitSelector");
              }
              columns.ForeignKey(c => c.FromBranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").Width(180).EditorTemplateName("AllBranchSelector");
              columns.ForeignKey(c => c.BankAccountId, (IEnumerable)ViewData["BankAccounts"], "Code", "Name").EditorTemplateName("AllBankAccountSelector").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));

              columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").Width(100);
              columns.ForeignKey(c => c.OrgStuructureId, (IEnumerable)ViewData["OrgStructure"], "OrgStructureId", "Name").Width(180);

              columns.Bound(c => c.Remark).Width(150);
              columns.Bound(c => c.Status).Width(150);
              columns.Command(command =>
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }).Width(190);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))//.TemplateName("LeaveRequest").Window(window => { window.Title(Resources.NavigatorLeave_LeaveRequest); window.Scrollable(false); }))
                                                                   //.Events(events => events.DetailExpand("onDetailExpandUser"))
          .Scrollable(h => h.Height(500))

          .Sortable(sortable =>
          {
              sortable.SortMode(GridSortMode.SingleColumn);
          })
          .Filterable()
          //.Events(e =>
          //{
          //    e.Save("GetDate");
          //    e.Edit("GetDate");
          //})
          .Pageable(pageable => pageable
              .Input(true)
              .Numeric(false)
              .Refresh(true)
              .PageSizes(true)
              .ButtonCount(5))
          .Events(ev => ev.DetailExpand("detailExpandMasterDepartment"))
          .Events(x => x.DataBound("onDataBoundMasterDepartment"))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Sort(sort => sort.Add("FundTransferId").Descending())
               .Model(
              model =>
              {
                  model.Id(p => p.FundTransferId);
                  model.Field(p => p.FundTransferId).Editable(false);
                  model.Field(p => p.BranchId).Editable(false);
                  model.Field(p => p.BusinessUnitId).Editable(false);
                  model.Field(p => p.OrgStuructureId).Editable(false);
                  model.Field(p => p.Paid).Editable(false);

                  model.Field(p => p.CreatedAtBranchId).Editable(false);
                  model.Field(p => p.CreatedAtBusinessUnitId).Editable(false);
                  model.Field(p => p.BudgetApprovedBy).Editable(false);
                  model.Field(p => p.IsBudgetApproved).Editable(false);
                  model.Field(p => p.BudgetApprovedTime).Editable(false);

                  model.Field(p => p.CurrentApprovalStep).Editable(false);

                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
                  model.Field(p => p.Status).Editable(false);

              })
              .Events(events =>
              {
                  events.Error("error_handler(\"grid\")");
                  events.RequestStart("onRequestStart(\"grid\")");
                  events.RequestEnd("onRequestEnd(\"grid\")");
              })


              .Read(read => read.Action("FundTransfer_Read", "FundTransferRequest"))
              .Create(create => create.Action("FundTransfer_Create", "FundTransferRequest"))
              .Update(update => update.Action("FundTransfer_Update", "FundTransferRequest"))
              .Destroy(destroy => destroy.Action("FundTransfer_Destroy", "FundTransferRequest"))
          ).ClientDetailTemplateId("template"))


