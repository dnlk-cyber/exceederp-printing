@using ExceedERP.Core.Domain.Finance.AP
@(Html.Kendo().Grid<ApPaybleInvoiceValidation>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Status);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
                              toolbar.Excel();
                              // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Pageable()
      .Filterable()
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ApPaybleInvoiceValidationId))
          .Read(read => read.Action("APPaybleInvoiceValidations_Read", "ApInvoiceValidation"))
          .Create(create => create.Action("APPaybleInvoiceValidations_Create", "ApInvoiceValidation"))
          .Update(update => update.Action("APPaybleInvoiceValidations_Update", "ApInvoiceValidation"))
          .Destroy(destroy => destroy.Action("APPaybleInvoiceValidations_Destroy", "ApInvoiceValidation"))
      ))
