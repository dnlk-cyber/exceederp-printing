
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.GL.GlSegmentLength>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.AccountLength);
          columns.Bound(c => c.LocationLength);
          columns.Bound(c => c.CostCenterLength);
          columns.Bound(c => c.SubAccountLength);
          columns.Bound(c => c.DateCreated).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.LastModified).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Sortable()
      .Filterable()
      
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(
              model =>
              {
                  model.Id(p => p.GlSegmentLengthId);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);


              })
          .Events(events => events
              .Error("error_handler_one")
              .Sync("sync_handler"))
          .Read(read => read.Action("GlSegmentLengths_Read", "GlSegmentLength"))
          .Create(create => create.Action("GlSegmentLengths_Create", "GlSegmentLength"))
          .Update(update => update.Action("GlSegmentLengths_Update", "GlSegmentLength"))
          .Destroy(destroy => destroy.Action("GlSegmentLengths_Destroy", "GlSegmentLength"))
      ))
