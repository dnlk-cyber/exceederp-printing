
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.JournalSourceMap>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Source);
        columns.Bound(c => c.Remark);
        columns.Bound(c => c.DateCreated);
        columns.Bound(c => c.LastModified);
        columns.Bound(c => c.CreatedBy);
        columns.Bound(c => c.ModifiedBy);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.JournalSourceMapId))
          .Read(read => read.Action("JournalSourceMaps_Read", "JournalSourceMap"))
          .Create(create => create.Action("JournalSourceMaps_Create", "JournalSourceMap"))
          .Update(update => update.Action("JournalSourceMaps_Update", "JournalSourceMap"))
          .Destroy(destroy => destroy.Action("JournalSourceMaps_Destroy", "JournalSourceMap"))
      )
)
