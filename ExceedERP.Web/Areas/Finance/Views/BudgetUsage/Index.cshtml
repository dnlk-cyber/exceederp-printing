@using ExceedERP.Core.Domain.Finance.Budget
@(Html.Kendo().Grid<BudgetUsage>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.BudgetYear);
        columns.Bound(c => c.BudgetMonth);
        columns.Bound(c => c.AccountCode);
        columns.Bound(c => c.AccountDesc);
        columns.Bound(c => c.Unit);
        columns.Bound(c => c.MonthlyActuals);
        columns.Bound(c => c.OrgBranchName);
        columns.Bound(c => c.DateCreated);
        columns.Bound(c => c.LastModified);
        columns.Bound(c => c.CreatedBy);
        columns.Bound(c => c.ModifiedBy);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
            toolbar.Excel();
           // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Pageable()
      .Sortable(sortable => {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.BudgetUsageID))
          .Read(read => read.Action("BudgetUsages_Read", "BudgetUsage"))
          .Create(create => create.Action("BudgetUsages_Create", "BudgetUsage"))
          .Update(update => update.Action("BudgetUsages_Update", "BudgetUsage"))
          .Destroy(destroy => destroy.Action("BudgetUsages_Destroy", "BudgetUsage"))
      )
)
