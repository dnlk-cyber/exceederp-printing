@using System.Collections
@using ExceedERP.Core.Domain.Finance.AP.FundTransfer
@using ExceedERP.Core.Localization
@using ExceedERP.Helpers.Common

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Fund Transfer Receive Confirmation </legend>
@(Html.Kendo().Grid<FundReceive>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.Bound(c => c.FundReceiveId).Title("Receive No.").Width(100).ClientTemplate("#=appendZeros(FundReceiveId)#");
              columns.Bound(c => c.FundTransferId).Title("Transfer No.").Width(100);
              columns.ForeignKey(c => c.BankAccountId, (IEnumerable)ViewData["BankAccounts"], "Code", "Name").EditorTemplateName("AllBankAccountSelector").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
              if (GlobalHelper.IsMultipleBusinessUnit())
              {
                  columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["BusinessUnits"], "BusinessUnitId", "Name").Width(180).EditorTemplateName("BusinessUnitSelector").Filterable(ftb => ftb.Multi(true).Search(true));
              }
              columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.ReceiveDate).Width(120);
              if (GlobalHelper.IsMultipleBusinessUnit())
              {
                  columns.ForeignKey(c => c.FromBusinessUnitId, (IEnumerable)ViewData["BusinessUnits"], "BusinessUnitId", "Name").Width(180).EditorTemplateName("BusinessUnitSelector").Filterable(ftb => ftb.Multi(true).Search(true));
              }
              columns.ForeignKey(c => c.FromBranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").Width(180).EditorTemplateName("AllBranchSelector").Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.AmountReceived).Width(180);

              columns.Bound(c => c.Remark).Width(150);
              columns.Bound(c => c.Status).Width(150);
              columns.Command(command =>
              {
                 // command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  //command.Destroy().Text(Resources.ActionButton_Cancel);
              }).Width(190);
          })
          .ToolBar(toolbar =>
          {

          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))

          .Sortable(sortable =>
          {
              sortable.SortMode(GridSortMode.SingleColumn);
          })
          .Filterable()

          .Pageable(pageable => pageable
              .Input(true)
              .Numeric(false)
              .Refresh(true)
              .PageSizes(true)
              .ButtonCount(5))
          .Events(ev => ev.DetailExpand("detailExpand"))
                      .Events(x => x.DataBound("onDataBoundMaster"))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Sort(sort => sort.Add("FundReceiveId").Descending())
               .Model(
              model =>
              {
                  model.Id(p => p.FundReceiveId);
                  model.Field(p => p.FundReceiveId).Editable(false);
                  model.Field(p => p.BranchId).Editable(false);
                  model.Field(p => p.BusinessUnitId).Editable(false);
                  model.Field(p => p.FromBusinessUnitId).Editable(false);
                  model.Field(p => p.FromBranchId).Editable(false);
                  model.Field(p => p.CreatedAtBranchId).Editable(false);
                  model.Field(p => p.CreatedAtBusinessUnitId).Editable(false);
                  model.Field(p => p.CreatedAtOrgStructureId).Editable(false);


                  model.Field(p => p.CurrentApprovalStep).Editable(false);

                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
                  model.Field(p => p.Status).Editable(false);

              })
              .Events(events =>
              {
                  events.Error("error_handler(\"grid\")");
                  events.RequestStart("onRequestStart(\"grid\")");
                  events.RequestEnd("onRequestEnd(\"grid\")");
              })


              .Read(read => read.Action("FundReceive_Read", "ApFundReceive"))
              .Create(create => create.Action("FundReceive_Create", "ApFundReceive"))
              .Update(update => update.Action("FundReceive_Update", "ApFundReceive"))
              .Destroy(destroy => destroy.Action("FundReceive_Destroy", "ApFundReceive"))
          ).ClientDetailTemplateId("template"))


