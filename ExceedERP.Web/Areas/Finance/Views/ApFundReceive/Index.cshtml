<script type="text/javascript">

    function filterEmployees() {
        return {
            text: $("#EmployeeId").data("kendoDropDownList").filterInput.val(),
        }
    }

    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "ApFundReceive", new {area = "Finance"})',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
       }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ApFundReceive", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

     function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "ApFundReceive", new { area = "Finance" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }










    function onMasterEdit() {

    }


    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    var isapproved;
    var issecondapproved;
    var isSendForApproval;
    var isOnlineTransferred;
    var nextApprover;

    function detailExpandMasterNew(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        //codeid = masterDataItem.StoreRequisitionID;
        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;
        nextApprover = masterDataItem.ForwardedTo;

    }





    function onUploadSuccess(e) {
        var gridname = "#FundReceiveAttachment" + codeid;
        $(gridname).data("kendoGrid").dataSource.read();
    }


</script>