
@using ExceedERP.Core.Domain.Finance.Report
@using ExceedERP.Core.Domain.Finance.Report.IFRS
<legend>Statement of Cash Flow</legend>
@(Html.Kendo().Grid<IfrsStatementOfCashFlow>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.IfrsStatementOfCashFlowId).Title("ID").Width(300);
          columns.Command(command =>
          {
              if (ViewBag.Count > 0)
              {
                  return;
              }
              command.Edit();
              command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          if (ViewBag.Count <= 0)
          {
              toolbar.Create();
          }
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .ClientDetailTemplateId("templates")
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model =>
          {
              model.Id(p => p.IfrsStatementOfCashFlowId);
              model.Field(p => p.IfrsStatementOfCashFlowId).Editable(false);
          }
          )
          .Model(model => model.Id(p => p.IfrsStatementOfCashFlowId))
          .Read(read => read.Action("IfrsStatementOfCashFlows_Read", "IfrsStatementOfCashFlow"))
          .Create(create => create.Action("IfrsStatementOfCashFlows_Create", "IfrsStatementOfCashFlow"))
          .Update(update => update.Action("IfrsStatementOfCashFlows_Update", "IfrsStatementOfCashFlow"))
          .Destroy(destroy => destroy.Action("IfrsStatementOfCashFlows_Destroy", "IfrsStatementOfCashFlow"))
      )
      .Events(events => events.DataBound("dataBound")))

