<legend>Account Category</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.GL.GlChartOfAccountCategory>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.AccountType).Width(150).EditorTemplateName("GLAccountTypes");
          columns.Bound(c => c.AccountSubType).Width(200);
          columns.Bound(c => c.DateCreated).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.LastModified).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          });
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Groupable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(
              model =>
              {
                  model.Id(p => p.GlChartOfAccountCategoryId);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);

              })
          .Events(events => events
              .Error("error_handler_one")
              .Sync("sync_handler"))
          .Read(read => read.Action("GlChartOfAccountCategories_Read", "GlChartOfAccountCategory"))
          .Create(create => create.Action("GlChartOfAccountCategories_Create", "GlChartOfAccountCategory"))
          .Update(update => update.Action("GlChartOfAccountCategories_Update", "GlChartOfAccountCategory"))
          .Destroy(destroy => destroy.Action("GlChartOfAccountCategories_Destroy", "GlChartOfAccountCategory"))
      ))
