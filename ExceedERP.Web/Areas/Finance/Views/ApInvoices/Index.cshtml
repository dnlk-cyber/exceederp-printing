<script>

    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "ApInvoices", new { area = "Finance" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }


    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "ApInvoices", new {area = "Finance"})',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ApInvoices", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function GetGrnDataToAP() {
        var grnObject = $("#GRNList").data("kendoDropDownList");
        var grnId = grnObject.value();
        if (grnId.length === 0)
            alert("Please select GRN Number.");
        else {
            $.ajax({
                url: '@Url.Action("GetGrnDataToAp", "ApInvoices")',
                data: { id: grnId },
                type: 'GET',
                cache: false,
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }


            });
        }
    }



    function filterPurchaseReferences() {

        return {
            //sourceType: $("#PoType").data("kendoDropDownList").value(),
            text: $("#SourceId").data("kendoDropDownList").filterInput.val()
            //purchaser: $("#EmployeeId").data("kendoDropDownList").value()
        };
    }

    function onSelectPaymentRequest(e) {
        //alert("change");
        var id = $("#SourceId").data("kendoDropDownList").value();
        
        // alert(id);
        //begin
        $.ajax({
            url: '/Finance/FinanceDataProvider/GetPaymentRequestData',
            type: 'GET',
            data: { id: id },
            success: function (result) {
                $("#SupplierId").val(result.SupplierId).trigger("change");
                $("#SupplierName").val(result.SupplierName).trigger("change");
                $("#EmployeeId").val(result.ProcurementOfficer).trigger("change");
                $("#PoNum").val(result.PONo).trigger("change");
                $("#InvoiceNumber").val(result.InvoiceNumber).trigger("change");
                $("#InvoiceAmount").val(result.Amount).trigger("change");
                $("#PurposeOfPayment").val(result.Purpose).trigger("change");

            }, //end succ
            error: function (result) {
                alert(result);
            }
        }); //end post
        //end
    }

    function onSelect(e) {
        //alert("change");
        var dataItem = this.dataItem(e.item);
        //begin
        var item = dataItem.Name;
        $.ajax({
            url: '/Finance/FinanceDataProvider/GetPayableItemsAccount',
            type: 'POST',
            data: { id: item },
            success: function (result) {
                if (result.length > 0) {
                    for (var i = 0; i < result.length; i++) {
                        $("#AccountCode").val(result[i].AccountCode).trigger("change");
                        $("#Description").val(result[i].Description).trigger("change");
                    }
                }
                else {

                }

            }, //end succ
            error: function (result) {
                alert(result);
            }
        }); //end post
        //end
    }


</script>




<script type="text/javascript">

    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }
    }

    function dataBoundLines() {


    }

    var isNotTransffered = false;

    function isNotTransferredCheck(obj) {
        if ($(obj).is(":checked")) {
            isNotTransffered = true;
            $("#grid").data("kendoGrid").dataSource.read();

        } else {
            isNotTransffered = false;
            $("#grid").data("kendoGrid").dataSource.read();

        }

    }

    function passReadData() {
        return {
            isNotTransffered: isNotTransffered
        };
    }

</script>