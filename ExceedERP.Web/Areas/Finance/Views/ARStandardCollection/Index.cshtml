<script>

    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "ArStandardCollection", new {area = "Finance"})',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "ArStandardCollection", new { area = "Finance" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ArStandardCollection", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function isNewCustomer(obj) {
        if ($(obj).is(":checked")) {
            $("#customernameDiv").show();

        } else {
            $("#customernameDiv").hide();

        }

    }

    function getCustomerId() {
        return {
            id: codeid,
            text: $("#InvoiceNumber").data("kendoDropDownList").filterInput.val()
        };
    }

    

    function onSelect(e) {
        //alert("change");
        var dataItem = this.dataItem(e.item);
        //begin
        var item = dataItem.Code;
        $.ajax({
            url: '/Finance/FinanceDataProvider/GetInvoiceDueAmount',
            type: 'POST',
            data: { id: item },
            success: function (result) {
                if (result.length > 0) {
                    for (var i = 0; i < result.length; i++) {
                        $("#ApplyAmount").val(result[i].AmountDue).trigger("change");
                    }
                }
                else {

                }

            }, //end succ
            error: function (result) {
                alert(result);
            }
        }); //end post
        //end
    }
</script>

<script>
    var popup;
    var aCode;
    function SelectAccCode() {
        popup = window.open('/Finance/AccountCode/GLAccountSelector', 'WindowPopup', 'top=100, left=400, width=300, height=320,resizable=no,');
        popup.focus();
        return false;
    }

    function setLang(accCode) {
        aCode = accCode;
        $("#AccountCode").val(aCode).trigger("change");
    }


    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    var isapproved;
    var issecondapproved;
    var isSendForApproval;
    var isOnlineTransferred;
    var customerid;

    function detailExpandCollection(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.ArStandardCollectionId;
        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        customerid = masterDataItem.CustomerId;

    }
    function onDataBoundMasterCollection() {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved || gridData[i].IsSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var data = this.dataSource.data();
        $.each(data, function (i, row) {
            if (row.get("IsOnlineApproved") === "true") {
                var element1 = $('tr[data-uid="' + row.uid + '"] ');
                element1.addClass("approved-row");
            }

            if (row.get("IsSecondOnlineApproved") === "true") {
                var element2 = $('tr[data-uid="' + row.uid + '"] ');
                element2.addClass("secondapproved-row");
            }

            if (row.get("IsVoid") === "true") {
                var element3 = $('tr[data-uid="' + row.uid + '"] ');
                element3.addClass("void-row");
            }
        });
    }
    function onDataBoundLinesCollection(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionItem_" + codeid;
        if (isapproved || isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundFisrtValidationCollection(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionValidation_" + codeid;

        if (isapproved || !isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }
    function onDataBoundDistributionCollection(e) {

        var detailGrid = "#" + e.sender.element[0].id;

        if (isOnlineTransferred) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        //alert(isOnlineTransferred);
    }


    var isNotTransffered = false;

    function isNotTransferredCheck(obj) {
        if ($(obj).is(":checked")) {
            isNotTransffered = true;
            $("#grid").data("kendoGrid").dataSource.read();

        } else {
            isNotTransffered = false;
            $("#grid").data("kendoGrid").dataSource.read();

        }

    }

    function passReadData() {
        return {
            isNotTransffered: isNotTransffered
        };
    }

</script>

