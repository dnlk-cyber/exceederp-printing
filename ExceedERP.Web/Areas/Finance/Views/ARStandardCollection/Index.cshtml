@using System.Collections
@using ExceedERP.Core.Domain.Finance.AR
<legend>Standard Collection</legend>
@(Html.Kendo().Grid<ArStandardCollection>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ArStandardCollectionId).Title("ID").Width(80).ClientTemplate("#=appendZeros(ArStandardCollectionId)#");
          columns.Bound(c => c.ReceiptNumber).Width(110);
         
          columns.Bound(c => c.ReceiptDate).Width(110).Format("{0:dd/MM/yyyy}");
          columns.ForeignKey(c => c.ReceiptMethod, (IEnumerable)ViewData["methods"], "Method", "Method").Width(120);
          columns.ForeignKey(c => c.CustomerId, (IEnumerable)ViewData["customers"], "CustomerId", "CompanyName").Width(150);
          columns.Bound(c => c.IsNewCustomer).Width(100).Title("New Customer").ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= IsNewCustomer #' " +
              "# if (IsNewCustomer) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.CustomerName).Width(130);
          columns.Bound(c => c.LineAmount).Format("{0:n2}").Width(120);
          columns.Bound(c => c.TaxAmount).Format("{0:n2}").Width(120);
          columns.Bound(c => c.TotalAmount).Format("{0:n2}").Width(120);
          columns.Bound(c => c.Reference).Width(110);
          columns.Bound(c => c.CreatedBy).Width(100);
          columns.Bound(c => c.Status).Width(100);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(280);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Template(
              @<text>

                    <a class="k-button k-button-icontext k-grid-add" href='\#'><span class="k-icon k-i-add"></span> Add new record</a>
                    <button class="k-button k-button-icontext k-grid-excel" href='\#'> <span class="k-icon k-i-excel"></span>Export to Excel</button>

                    @(Html.Kendo().CheckBox()
                                    .Name("checktransfferable")
                                    .Label("Show Transferrable Only")
                                    .HtmlAttributes(new { onchange = "isNotTransferredCheck(this)" })
                    )



                </text>);
      })
      .Excel(excel => excel
          .FileName("AR Misc Collection.xlsx")
          .Filterable(true)
          .AllPages(true)
      )
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Collection").Window(w => w.Title("Collection Registration")))
        .HtmlAttributes(new { style = "height: 550px;" })
              .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))

                    .Scrollable()
                         .Selectable(selectable =>
                         {
                             selectable.Mode(GridSelectionMode.Single);
                             selectable.Type(GridSelectionType.Row);
                         })
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                    .Filterable()

              .Events(events => events.DetailExpand("detailExpandCollection"))
              .Events(events => events.DataBound("onDataBoundMasterCollection"))
      .DataSource(dataSource => dataSource
          .Ajax()
              .Sort(sort => sort.Add("ArStandardCollectionId").Descending())
              .Model(
                model =>
                {
                    model.Id(p => p.ArStandardCollectionId);
                    model.Field(p => p.ArStandardCollectionId).Editable(false);
                    model.Field(p => p.LineAmount).Editable(false);
                    model.Field(p => p.TaxAmount).Editable(false);
                    model.Field(p => p.TotalAmount).Editable(false);
                    model.Field(p => p.UnidentifiedBalance).Editable(false);
                    model.Field(p => p.AppliedBalance).Editable(false);
                    model.Field(p => p.OnAccountBalance).Editable(false);
                    model.Field(p => p.UnappliedBalance).Editable(false);
                    model.Field(p => p.PrepaymentBalance).Editable(false);
                    model.Field(p => p.BranchId).Editable(false);
                    model.Field(p => p.BusinessUnitId).Editable(false);

                    model.Field(p => p.VoidTime).Editable(false);
                    model.Field(p => p.VoidBy).Editable(false);
                    model.Field(p => p.IsVoid).Editable(false);

                    model.Field(p => p.OnlineApprovedTime).Editable(false);
                    model.Field(p => p.OnlineApprovedBy).Editable(false);
                    model.Field(p => p.IsOnlineApproved).Editable(false);
                    model.Field(p => p.Status).Editable(false);

                    model.Field(p => p.IsSendForApproval).Editable(false);
                    model.Field(p => p.IsOnlineTransferred).Editable(false);
                    model.Field(p => p.IsOnlineTransferredBy).Editable(false);
                    model.Field(p => p.OnlineTransferredTime).Editable(false);

                    model.Field(p => p.OrgBranchName).Editable(false);
                    model.Field(p => p.CreatedBy).Editable(false);
                    model.Field(p => p.ModifiedBy).Editable(false);
                    model.Field(p => p.LastModified).Editable(false);
                    model.Field(p => p.DateCreated).Editable(false);


                })
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("ARStandardCollections_Read", "ARStandardCollection").Data("passReadData"))
          .Create(create => create.Action("ARStandardCollections_Create", "ARStandardCollection"))
          .Update(update => update.Action("ARStandardCollections_Update", "ARStandardCollection"))
          .Destroy(destroy => destroy.Action("ARStandardCollections_Destroy", "ARStandardCollection"))
      )
      .ClientDetailTemplateId("templates")

)

