@using System.Collections
@using ExceedERP.Core.Domain.Finance.Bank
<legend>Book Records</legend>
@(Html.Kendo().Grid<ReconciliationBookAccount>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.AccountCode).Width(150);
          columns.Bound(c => c.Type).Width(100);
          columns.Bound(c => c.ReferenceDoc).Width(160);
          columns.Bound(c => c.Reference).Width(100);
          columns.Bound(c => c.Debit).Format("{0:n}").Width(120);
          columns.Bound(c => c.Credit).Format("{0:n}").Width(120);
          columns.Bound(c => c.Date).Width(120);
          columns.Bound(c => c.Reconciled).Width(100).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= Reconciled #' " +
              "# if (Reconciled) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.ReconciledDate).Width(120);
          //columns.Bound(c => c.Check).Width(120).ClientTemplate(
          //      "<input type='checkbox' disabled = 'true' value='#= Check #' " +
          //          "# if (Check) { #" +
          //              "checked='checked'" +
          //          "# } #" +
          //      "/>"
          //  );
          columns.Bound(c => c.Source).Width(100);
          columns.Bound(c => c.SourceID).Width(100);
          columns.Command(command =>
          {
             // command.Custom("✅").Click("ChangeStatus");
          });
      })
      .ToolBar(toolbar =>
      {
          toolbar.Template(@<text>
                               <div class="toolbar">
               
                                   <table>
                                       <tr>
                                           <td>
                                               <i>Bank:</i>
                                               @(Html.Kendo().DropDownListFor(m => m)
                                                     .OptionLabel("Select Account")
                                                     .Filter("contains")
                                                     .Name("BankList")
                                                     .BindTo((IEnumerable)ViewData["BankList"])
                                                     .DataTextField("AccountName")
                                                     .DataValueField("AccountNumber")
                                                     .HtmlAttributes(new { style = "width: 300px;" })
                                                     .ValuePrimitive(true))
                                           </td>
                                           @*<td>
                                               <i>From:</i>
                                               @(Html.Kendo().DatePicker()
                                                     .Name("From")
                                                     .Value(DateTime.Today))
                                           </td>*@
                                           <td>
                                               @*<i>To:</i>
                                               @(Html.Kendo().DatePicker()
                                                     .Name("To")
                                                     .Value(DateTime.Today))*@
                                               @(Html.Kendo().Button()
                                                     .Name("btnSearch")
                                                     .HtmlAttributes(new { type = "search", @class = "k-primary" })
                                                     .Events(e => e.Click("searchBank"))
                                                     .Content("Search"))
                                           </td>
                                       </tr>
                                   </table>

                               </div>
                            </text>);
      })
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ReconciliationBookAccountId").Descending())
          .Model(
              model =>
              {
                  model.Id(p => p.ReconciliationBookAccountId);
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);


              })
          .Events(events => events
              .Error("error_handler_one")
              .Sync("sync_handler"))
          .Read(read => read.Action("ReconcilationBookAccounts_Read", "ReconciliationBookAccount").Data("passSearchData"))
      ))


<script>
    $(function () {
        var combobox = $('#BankList').data('kendoDropDownList');
       
        combobox.list.width(300);
    });

    function searchBank() {
        var bankObject = $("#BankList").data("kendoDropDownList");
        var bankValue = bankObject.value();
       
        if (bankValue != null) {
            $("#grid").data("kendoGrid").dataSource.read();
        } else {
            alert("Please select bank.");
        }
    }
    function passSearchData() {
        var bankObject = $("#BankList").data("kendoDropDownList");
        var bankValue = bankObject.value();
        return {
            accountnumber: bankValue
        };
    }



 

 
    function ChangeStatus(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        $.ajax({
            type: "GET",
            data: dataItem.ReconciliationBookAccountId, //I obtained the id properly
            url: '@Url.Action("Change", "ReconciliationBookAccount")/' + dataItem.ReconciliationBookAccountId

        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();
        location.reload();
    };
  
    

</script>

<style>
    .borderless td, .borderless th {
    border: none;
}
</style>