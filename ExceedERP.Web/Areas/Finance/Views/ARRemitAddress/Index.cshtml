@using ExceedERP.Core.Domain.Finance.AR
<legend>Remit Address</legend>
@(Html.Kendo().Grid<ARRemitAddress>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Company).Width(130);
          columns.Bound(c => c.Address).Width(130);
          columns.Bound(c => c.PostalCode).Width(130);

          columns.Bound(c => c.OrgBranchName).Width(130).Hidden(true);
          columns.Bound(c => c.DateCreated).Width(130).Hidden(true).Format("{0:dd/MM/yyyy}");
          columns.Bound(c => c.LastModified).Width(130).Hidden(true).Format("{0:dd/MM/yyyy}");
          columns.Bound(c => c.CreatedBy).Width(130).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(130).Hidden(true);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
            toolbar.Excel();
           // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
       .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable()
      .Sortable(sortable => {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(
                model =>
                {
                    model.Id(p => p.ARRemitAddressID);
                    model.Field(p => p.CreatedBy).Editable(false);
                    model.Field(p => p.ModifiedBy).Editable(false);
                    model.Field(p => p.LastModified).Editable(false);
                    model.Field(p => p.DateCreated).Editable(false);
                })
          .Events(events => events .Error("error_handler_one"))
          .Read(read => read.Action("ARRemitAddresses_Read", "ARRemitAddress"))
          .Create(create => create.Action("ARRemitAddresses_Create", "ARRemitAddress"))
          .Update(update => update.Action("ARRemitAddresses_Update", "ARRemitAddress"))
          .Destroy(destroy => destroy.Action("ARRemitAddresses_Destroy", "ARRemitAddress"))
      )
)


<script type="text/javascript">
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }
</script>