@using ExceedERP.Core.Domain.Finance.Common
@(Html.Kendo().Grid<FinInStatementRecord>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.FYear);
          columns.Bound(c => c.Status);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
                              toolbar.Excel();
                              // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Pageable()
      .Sortable(sortable => {
                                sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.FinInStatementRecordID))
          .Read(read => read.Action("FinInStatementRecords_Read", "FinInStatementRecord"))
          .Create(create => create.Action("FinInStatementRecords_Create", "FinInStatementRecord"))
          .Update(update => update.Action("FinInStatementRecords_Update", "FinInStatementRecord"))
          .Destroy(destroy => destroy.Action("FinInStatementRecords_Destroy", "FinInStatementRecord"))
      ))
