@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers.Common
@model ExceedERP.Core.Domain.Finance.AP.ApPayment

@Html.HiddenFor(model => model.ApPaymentId)

<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1">
            
            <div class="form-group">
                @Html.LabelFor(model => model.InvoiceNumber, "Invoice No.", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.InvoiceNumber)
                          .ValuePrimitive(true)
                          .OptionLabel("Select Invoice...")
                          .DataTextField("Name")
                          .DataValueField("Code")
                          .Filter("contains")
                          .Events(e =>
                          {
                              e.Change("onSelectInvoiceNumber");
                          })
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetOpenApInvoices", "FinanceDataProvider", new { area = "Finance" }).Data("filterinvoices"))
                                  .ServerFiltering(true);
                          })
                         
                    )
                    @Html.ValidationMessageFor(model => model.InvoiceNumber, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            
            
            <div class="form-group">
                @Html.LabelFor(model => model.SupplierId, "Supplier ID", htmlAttributes: new {@class = "control-label col-md-8"})
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.SupplierId).HtmlAttributes(new {@disabled = "disabled"})
                    @Html.ValidationMessageFor(model => model.SupplierId, "", new {@class = "text-danger"})
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.SupplierName, "Supplier Name", htmlAttributes: new {@class = "control-label col-md-8"})
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.SupplierName).HtmlAttributes(new {@disabled = "disabled"})
                    @Html.ValidationMessageFor(model => model.SupplierName, "", new {@class = "text-danger"})
                </div>
            </div>
            <div class="row"></div>
            
            <div class="form-group">
                @Html.LabelFor(model => model.InvoiceAmount, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.InvoiceAmount).HtmlAttributes(new {@disabled="disabled"})
                    @Html.ValidationMessageFor(model => model.InvoiceAmount, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            
            
           
            
           
        
        </div>

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.PaymentDate, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().DatePickerFor(model => model.PaymentDate)
                    @Html.ValidationMessageFor(model => model.PaymentDate, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.PaymentAmount, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().NumericTextBoxFor(model => model.PaymentAmount)
                    @Html.ValidationMessageFor(model => model.PaymentAmount, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.PaymentMethod, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.PaymentMethod)
                                  .ValuePrimitive(true)
                                  .OptionLabel("Select method ...")
                                          .DataTextField("Method")
                                          .DataValueField("Method")
                                  .Filter("contains")
                                  .DataSource(dataSource =>
                                  {
                                      dataSource.Read(read => read.Action("GetApPaymentMethods", "FinanceDataProvider", new { area = "Finance" }))
                                          .ServerFiltering(false);
                                  })

                    )
                    @Html.ValidationMessageFor(model => model.PaymentMethod, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>


            <div class="row"></div>

            @*<div class="form-group">
            @Html.LabelFor(model => model.GLTaxRateID, "Tax Type", htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-6">
                @(Html.Kendo().DropDownListFor(model => model.GLTaxRateID)
                      .ValuePrimitive(true)
                      .OptionLabel("Select Tax...")
                      .DataTextField("Name")
                      .DataValueField("GLTaxRateID")
                      .Filter("contains")

                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetApTax", "FinanceDataProvider", new { area = "Finance" }))
                              .ServerFiltering(true);
                      })

                      )
                @Html.ValidationMessageFor(model => model.InvoiceNumber, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="row"></div>*@
            <div class="form-group">
                @Html.LabelFor(model => model.PaymentReference, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.PaymentReference)
                    @Html.ValidationMessageFor(model => model.PaymentReference, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>



        </div>

        <div class="col-md-3 ro1">
            
            
          

            <div class="form-group">
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Remark)
                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.PrepaymentBalance, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.PrepaymentBalance).HtmlAttributes(new {@disabled="disabled"})
                    @Html.ValidationMessageFor(model => model.PrepaymentBalance, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            
              
            <div class="form-group">
                @Html.LabelFor(model => model.OutstandingBalance, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.OutstandingBalance).HtmlAttributes(new {@disabled="disabled", @style = "color: coral;" })
                    @Html.ValidationMessageFor(model => model.OutstandingBalance, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

        </div>
    </div>
</div>
