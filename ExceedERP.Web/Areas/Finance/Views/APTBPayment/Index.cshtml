<script>

    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "APTBPayment", new {area = "Finance"})',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendforApproval", "APTBPayment", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                //toastr.success(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function getName(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetTBName", "APTBPayment", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                $("#supplierName").val(result.Balance).trigger("change");
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function getBalance(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("CheckB", "APTBPayment", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                $("#accountBalance").val(result.Name).trigger("change");               
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "APTBPayment", new { area = "Finance" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }


  

    function filterinvoices() {

        return {
            text: $("#InvoiceNumber").data("kendoDropDownList").filterInput.val()
        };
    }
 
    function onSupplierSelect(e) {

        var dataItem = this.dataItem(e.item);
        //begin
        var supplier = dataItem.Code;
       
        $.ajax({
            url: '/Finance/FinanceDataProvider/GetSupplierBalance',
            type: 'POST',
            data: { id: supplier },
            success: function (result) {
                $("#PrepaymentBalance").val(result.PrepaymentBalance).trigger("change");
                $("#OutstandingBalance").val(result.OutstandingBalance).trigger("change");
            }, //end succ
            error: function (result) {
                alert(result);
            }
        }); //end post
        //end
    }


  

    function onSelectInvoiceNumber(e) {
        //alert("change");
        var id = $("#InvoiceNumber").data("kendoDropDownList").value();
        // alert(id);
        //begin
        $.ajax({
            url: '/Finance/FinanceDataProvider/GetPayableInvoiceData',
            type: 'POST',
            data: { id: id },
            success: function (result) {
               
                $("#InvoiceAmount").val(result.AmountDue).trigger("change");
                $("#SupplierId").val(result.SupplierId).trigger("change");
                $("#SupplierName").val(result.SupplierName).trigger("change");
            }, //end succ
            error: function (result) {
                alert(result);
            }
        }); //end post
        //end
    }

    var isNotTransffered = false;

    function isNotTransferredCheck(obj) {
        if ($(obj).is(":checked")) {
            isNotTransffered = true;
            $("#grid").data("kendoGrid").dataSource.read();

        } else {
            isNotTransffered = false;
            $("#grid").data("kendoGrid").dataSource.read();

        }

    }

    function passReadData() {
        return {
            isNotTransffered: isNotTransffered
        };
    }
</script>

