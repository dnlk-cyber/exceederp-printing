@using ExceedERP.Core.Domain.Finance.GL
<legend>GL Tax Rate</legend>
@(Html.Kendo().Grid<GLTaxRate>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.TaxName).Width(150);
          columns.Bound(c => c.Rate).Title("Rate").Width(100);
          columns.Bound(c => c.CalculatedRate).Title("Calculated Rate").Width(100);
          columns.Bound(c => c.ApplyToAr).Width(80).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= ApplyToAr#' " +
              "# if (ApplyToAr) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.ArAccountCode).EditorTemplateName("AccountCode").Width(220);
          columns.Bound(c => c.ApplyToAp).Width(80).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= ApplyToAp#' " +
              "# if (ApplyToAp) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.ApAccountCode).EditorTemplateName("AccountCode").Width(220);
          columns.Bound(c => c.ApplyToWithholding).Width(120).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= ApplyToWithholding#' " +
              "# if (ApplyToWithholding) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.WithholdingAccountCode).EditorTemplateName("AccountCode").Width(220);
          columns.Bound(c => c.Enable).Width(100).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= Enable#' " +
              "# if (Enable) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );

          columns.Bound(c => c.OrgBranchName).Width(100).Hidden(true);
          columns.Bound(c => c.DateCreated).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.LastModified).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
                              //toolbar.Excel();
                              // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model => model.Id(p => p.GLTaxRateID))
       
          .Read(read => read.Action("GLTaxRates_Read", "GlTaxRate"))
          .Create(create => create.Action("GLTaxRates_Create", "GlTaxRate"))
          .Update(update => update.Action("GLTaxRates_Update", "GlTaxRate"))
          .Destroy(destroy => destroy.Action("GLTaxRates_Destroy", "GlTaxRate"))
      ))


<script type="text/javascript">
    }
    }
</script>

