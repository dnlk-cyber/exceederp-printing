                                                  columns.Bound(c => c.Activity).Width(100);
                                                  columns.Bound(c => c.Amount).Width(90);
                                                  columns.Bound(c => c.RevenueAccount).Title("Account").EditorTemplateName("AccountCode").Width(200);
                                                  columns.Bound(c => c.TaxType).EditorTemplateName("TaxType").Width(140);
                                                  columns.Bound(c => c.TaxAmount).Width(130);
                                                  columns.Bound(c => c.TotalAmount).Width(140);
                                                  columns.Bound(c => c.WithholdingType).Width(150).EditorTemplateName("WithholdingType");
                                                  columns.Bound(c => c.WithholdTax).Width(130).ClientTemplate("<input type='checkbox' disabled = 'true' \\#= WithholdTax ? checked='checked' :'' \\# />");
                                                  columns.Bound(c => c.NetReceipt).Width(120);
                                                  columns.Bound(c => c.Remark).Width(120);
                                                  columns.Command(command =>
                                                  {

                                                      command.Edit();
                                                      command.Destroy();

                                                  }).Width(180);
                                              })
                                              .ToolBar(toolbar =>
                                              {
                                                  toolbar.Create();
                                              })

                                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                                              .Events(x => x.DataBound("onDataBoundLines"))
                                              .Scrollable()
                                              .Sortable()
                                              .Filterable()
                                              .DataSource(dataSource => dataSource
                                                  .Ajax()
                                                         
