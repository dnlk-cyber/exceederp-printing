                                                      .RequestEnd("onRequestEnd(\"ArMiscelaneousCollectionLine#=ARMiscelaneousCollectionID#\")"))
                                                  .Read(read => read.Action("ArMiscelaneousCollectionLines_Read", "ArMiscelaneousCollectionLine", new { id = "#=ARMiscelaneousCollectionID#" }))
                                                  .Create(create => create.Action("ArMiscelaneousCollectionLines_Create", "ArMiscelaneousCollectionLine", new { id = "#=ARMiscelaneousCollectionID#" }))
                                                  .Update(update => update.Action("ArMiscelaneousCollectionLines_Update", "ArMiscelaneousCollectionLine", new { id = "#=ARMiscelaneousCollectionID#" }))
                                                  .Destroy(destroy => destroy.Action("ArMiscelaneousCollectionLines_Destroy", "ArMiscelaneousCollectionLine"))
                                              )

                                              .ToClientTemplate())
                                    </text>);


                                            items.Add().Text("Validation").Content(
                                                    @<text>
                                                        @(Html.Kendo().Grid<ARMiscelaneousCollectionValidation>()
                                                                              .Name("ARMiscelaneousCollectionValidation#=ARMiscelaneousCollectionID#")
                                                                              .Columns(columns =>
                                                                              {
                                                                                          columns.Bound(c => c.ARMiscelaneousCollectionValidationID).Hidden(true);
                                                                                          columns.Bound(c => c.Status).EditorTemplateName("ApprovalStatus").Width(150);
                                                                                          columns.Bound(c => c.Remark).Width(200);

                                                                                          columns.Bound(c => c.DateCreated).Width(200).Title("Time").Format("{0:dd/MM/yyyy}");
                                                                                          columns.Bound(c => c.LastModified).Hidden(true);
                                                                                          columns.Bound(c => c.CreatedBy).Width(200).Title("User");
                                                                                          columns.Bound(c => c.ModifiedBy).Hidden(true);
                                                                                          columns.Command(command =>
                                                                              {
                                                                                                    command.Edit();

                                                                                                });

                                                                                      })
                                                                              .ToolBar(toolbar =>
                                                                              {
                                                                                          toolbar.Create();
                                                                                      })
                                                                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                                                .Events(x => x.DataBound("onDataBoundFisrtValidation"))

                                                                              .Sortable(sortable =>
