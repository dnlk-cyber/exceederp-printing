                                                                                              .Name("ARMiscelaneousCollectionDistribution#=ARMiscelaneousCollectionID#")
                                                                                              .Columns(columns =>
                                                                                              {
                                                                                                          columns.Bound(c => c.ARMiscelaneousCollectionID).Hidden(true);
                                                                                                           columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(150);
                                                                                                          columns.Bound(c => c.AccountDesc).Width(200);
                                                                                                          columns.Bound(c => c.AdditionalDescription).Width(150);
                                                                                                          columns.Bound(c => c.Debit).Width(90).ClientFooterTemplate("Total Debit: \\#=sum\\# ");
                                                                                                          columns.Bound(c => c.Credit).Width(90).ClientFooterTemplate("Total Credit: \\#=sum\\# ");


                                                                                                          columns.Command(command =>
