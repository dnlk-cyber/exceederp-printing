@using ExceedERP.Core.Domain.Finance.AR
@using System.Collections
<legend>Miscellaneous Collection</legend>
@(Html.Kendo().Grid<ARMiscelaneousCollection>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ARMiscelaneousCollectionID).Title("ID").Width(100).ClientTemplate("#=appendZeros(ARMiscelaneousCollectionID)#");
          columns.Bound(c => c.IsDirectCollection).Width(110).Title("Direct Collection").ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= IsDirectCollection #' " +
              "# if (IsDirectCollection) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.CustomerId).Width(110);
          columns.Bound(c => c.IsNewCustomer).Width(100).Title("New Customer").ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= IsNewCustomer #' " +
              "# if (IsNewCustomer) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.CustomerName).Width(130);
          columns.Bound(c => c.ReceiptNumber).Width(110);
          columns.Bound(c => c.ReceiptDate).Width(100).Format("{0:dd/MM/yyyy}");
          columns.Bound(c => c.ReceiptMethod).EditorTemplateName("Methods").Width(120);
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(120);
          columns.Bound(c => c.LineAmount).Format("{0:n2}").Width(140);
          columns.Bound(c => c.TaxAmount).Format("{0:n2}").Width(140);
          columns.Bound(c => c.TotalAmount).Format("{0:n2}").Width(140);
          columns.Bound(c => c.Remark).Width(120);
          columns.Bound(c => c.CreatedBy).Width(100);
          columns.Bound(c => c.Status).Width(130);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Template(
                                  @<text>

                    <a class="k-button k-button-icontext k-grid-add" href='\#'><span class="k-icon k-i-add"></span> Add new record</a>
                    <button class="k-button k-button-icontext k-grid-excel" href='\#'> <span class="k-icon k-i-excel"></span>Export to Excel</button>

                    @(Html.Kendo().CheckBox()
                                    .Name("checktransfferable")
                                    .Label("Show Transferrable Only")
                                    .HtmlAttributes(new { onchange = "isNotTransferredCheck(this)" })
                    )



                </text>);
      })
      .Excel(excel => excel
          .FileName("AR Misc Collection.xlsx")
          .Filterable(true)
          .AllPages(true)
      )
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Collection").Window(w => w.Title("Collection Registration")))
       .HtmlAttributes(new { style = "height: 550px;" })
          .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))

                .Scrollable()
                     .Selectable(selectable =>
                     {
                         selectable.Mode(GridSelectionMode.Single);
                         selectable.Type(GridSelectionType.Row);
                     })
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                .Filterable()
                .Groupable()
               .ClientDetailTemplateId("templates")
                   .Groupable().Events(ev => ev.DetailExpand("detailExpand"))
                    .Scrollable(h => h.Height(500))
                     .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ARMiscelaneousCollectionID").Descending())
          .Model(
              model =>
              {
                  model.Id(p => p.ARMiscelaneousCollectionID);
                  model.Field(p => p.ARMiscelaneousCollectionID).Editable(false);
                  model.Field(p => p.LineAmount).Editable(false);
                  model.Field(p => p.TaxAmount).Editable(false);
                  model.Field(p => p.TotalAmount).Editable(false);
                  model.Field(p => p.IsPostedToSecondLedger).Editable(false);
                  model.Field(p => p.VoidTime).Editable(false);
                  model.Field(p => p.VoidBy).Editable(false);
                  model.Field(p => p.IsVoid).Editable(false);
                  model.Field(p => p.OnlineApprovedTime).Editable(false);
                  model.Field(p => p.OnlineApprovedBy).Editable(false);
                  model.Field(p => p.IsOnlineApproved).Editable(false);
                  model.Field(p => p.Status).Editable(false);
                  model.Field(p => p.IsSendForApproval).Editable(false);
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);


              })
          .Events(events => events
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("ARMiscelaneousCollections_Read", "ARMiscelaneousCollection").Data("passReadData"))
          .Create(create => create.Action("ARMiscelaneousCollections_Create", "ARMiscelaneousCollection"))
          .Update(update => update.Action("ARMiscelaneousCollections_Update", "ARMiscelaneousCollection"))
          .Destroy(destroy => destroy.Action("ARMiscelaneousCollections_Destroy", "ARMiscelaneousCollection"))
      )
)

<script id="templates" type="text/kendo-tmpl">
