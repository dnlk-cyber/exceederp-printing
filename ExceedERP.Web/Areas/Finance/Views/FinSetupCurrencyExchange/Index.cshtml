@using System.Collections
@using ExceedERP.Core.Domain.Finance
<legend>Exchange Rate</legend>
@(Html.Kendo().Grid<FinSetupCurrencyExchange>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.FromCurrency, (IEnumerable)ViewData["currencies"], "Code", "Name").Width(150);
          columns.ForeignKey(c => c.ToCurrency, (IEnumerable)ViewData["currencies"], "Code", "Name").Width(150);
          columns.Bound(c => c.DateFrom).Width(150);
          columns.Bound(c => c.DateTo).Width(150);
          columns.Bound(c => c.RateOne).Width(150);
          columns.Bound(c => c.RateTwo).Width(150);
          
          columns.Bound(c => c.DateCreated).Hidden(true);
          columns.Bound(c => c.LastModified).Hidden(true);
          columns.Bound(c => c.CreatedBy).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Hidden(true);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
                              toolbar.Excel();
                              // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Sortable()
      .Filterable()
      .Groupable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.FinSetupCurrencyExchangeID))
          .Events(events => events .Error("error_handler_one"))
          .Read(read => read.Action("FinSetupCurrencyExchanges_Read", "FinSetupCurrencyExchange"))
          .Create(create => create.Action("FinSetupCurrencyExchanges_Create", "FinSetupCurrencyExchange"))
          .Update(update => update.Action("FinSetupCurrencyExchanges_Update", "FinSetupCurrencyExchange"))
          .Destroy(destroy => destroy.Action("FinSetupCurrencyExchanges_Destroy", "FinSetupCurrencyExchange"))
      ))


<script type="text/javascript">
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }
</script>