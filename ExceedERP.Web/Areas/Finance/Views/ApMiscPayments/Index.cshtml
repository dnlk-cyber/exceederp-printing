<script>

    function getFiscalYear() {
        return { year: $("#yearSelector").data("kendoDropDownList").value() }
    }

function BatchTransfer() {
    var periodObject = $("#PeriodList").data("kendoDropDownList");
    var periodid = periodObject.value();

    if (periodid != null) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("Batchtransfer", "ApMiscPayments", new {area = "Finance"})',
            data: { id: periodid },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            beforeSend: function(){
                // Show image container
                $("#loading-image").show();
            },
            complete:function(data){
                // Hide image container
                $("#loading-image").hide();
            },
            error: function (result) {
                alert(result);
            }
        });


        $("#grid").data("kendoGrid").dataSource.read();
    } else {
        alert("Please select period.");
    }

}
    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "ApMiscPayments", new {area = "Finance"})',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "ApMiscPayments", new { area = "Finance" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendforApproval", "ApMiscPayments", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                //toastr.success(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function isNewSupplier(obj) {
        if ($(obj).is(":checked")) {
            $("#suppliernameDiv").show();

        } else {
            $("#suppliernameDiv").hide();

        }

    }

    //var popup;
    //var aCode;

    //function SelectAccCode() {
    //    popup = window.open('/Finance/AccountCode/GLAccountSelector', 'WindowPopup', 'top=100, left=400, width=300, height=320,resizable=no,');
    //    popup.focus();
    //    return false;
