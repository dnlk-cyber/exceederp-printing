<script>
    function filterEmployees() {
        return {
            text: $("#EmployeeId").data("kendoDropDownList").filterInput.val(),
        }
    }

    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;

    var isDeptapproved;
    var isDeptSendForApproval;

    function detailExpandMasterDepartment(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        // codeid = masterDataItem.PurchaseOrderID;
        isDeptapproved = masterDataItem.IsDepartmentOnlineApproved;
        isDeptSendForApproval = masterDataItem.IsDepartmentSendForApproval;
    }
    function onDataBoundMasterDepartment(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsDepartmentOnlineApproved || gridData[i].IsDepartmentSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsDepartmentSendForApproval && !dataItem.IsDepartmentOnlineApproved) {
                row.css("background-color", "lightgreen");
            }
            if (!dataItem.IsDepartmentSendForApproval && !dataItem.IsDepartmentOnlineApproved) {
                row.css("background-color", "lightskyblue");
            }

            if (dataItem.IsBudgetApproved) {
                row.css("background-color", "gold");
            }

            if (dataItem.Paid) {
                row.css("background-color", "honeydew");
            }

            if (dataItem.IsVoid) {
                row.css("background-color", "slategray");
                row.css("color", "black");
            }
        }


    }
    function onDataBoundLineDepartment(e) {

        var detailGrid = "#" + e.sender.element[0].id;
        if (isDeptapproved || isDeptSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundValidationDepartment(e) {


        var detailGrid = "#" + e.sender.element[0].id;

        if (isDeptapproved || !isDeptSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }



        this.table.find(".k-grid-edit").hide();
    }


     function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendforDepartmentApproval", "TravelOrderRequest", new { area = "Finance" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
</script>