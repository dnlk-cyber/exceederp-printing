<legend> Budget Account Shedule </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.Budget.BudgetAccountShedule>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.BudgetAccountSheduleCategoryId, (System.Collections.IEnumerable)ViewData["BudgetAccountSheduleCategory"], "BudgetAccountSheduleCategoryId", "Name").EditorTemplateName("BudgetScheduleTypeEditor").Width(200);
          columns.Bound(c => c.Remark).Width(150);
          columns.Bound(c => c.Index).Width(100);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 600px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Sortable()
      .Filterable()
      .Scrollable(h => h.Height(500))
      .ClientDetailTemplateId("subCategorytemplate")
      .DataSource(dataSource => dataSource
          .Ajax()
          //.Group(x => x.Add(y => y.Index))
          .Model(model => model.Id(p => p.BudgetAccountSheduleId))
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("BudgetAccountShedule_Read", "BudgetAccountShedule"))
          .Create(create => create.Action("BudgetAccountShedule_Create", "BudgetAccountShedule"))
          .Update(update => update.Action("BudgetAccountShedule_Update", "BudgetAccountShedule"))
          .Destroy(destroy => destroy.Action("BudgetAccountShedule_Destroy", "BudgetAccountShedule"))
      ))


