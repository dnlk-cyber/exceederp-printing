
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.AP.Travel.ApTravelExpenseValidation>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Status);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ApTravelExpenseValidationId))
          .Read(read => read.Action("ApTravelExpenseValidations_Read", "ApTravelExpenseValidation"))
          .Create(create => create.Action("ApTravelExpenseValidations_Create", "ApTravelExpenseValidation"))
          .Update(update => update.Action("ApTravelExpenseValidations_Update", "ApTravelExpenseValidation"))
          .Destroy(destroy => destroy.Action("ApTravelExpenseValidations_Destroy", "ApTravelExpenseValidation"))
      ))
