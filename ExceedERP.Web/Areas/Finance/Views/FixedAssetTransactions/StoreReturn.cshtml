@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Store Return</legend>

@(Html.Kendo().Grid<StoreReturn>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.StoreReturnID).Title("Return No.").Width(130).Width(120).ClientTemplate("#=appendZeros(StoreReturnID)#");
          columns.Bound(c => c.StoreCode).Width(130).EditorTemplateName("StoreSelectorByKeeper");
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["inventoryPeriods"], "GLPeriodId", "Name").Width(90).Title("Period").EditorTemplateName("InventoryPeriodSelector");
          columns.Bound(c => c.ReturnDate).Width(150);
          columns.Bound(c => c.Reason).Width(120);
          columns.Bound(c => c.Remark).Width(120);
          columns.Bound(c => c.Status).Width(80);
      })
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("General_SubLedger_Inventory_BatchTransfer"))
          {
              toolbar.Template(@<text>
                                   <div class="toolbar">

                                       <table>
                                           <tr>
                                               <td>
                                                   <i>Periods:</i>
                                                   @(Html.Kendo().DropDownListFor(m => m)
                                                         .Name("PeriodList")
                                                         .BindTo((IEnumerable) ViewData["PeriodList"])
                                                         .DataTextField("Name")
                                                         .DataValueField("InventoryPeriodId")
                                                         .HtmlAttributes(new {style = "width: 300px;"})
                                                         .ValuePrimitive(true))
                                               </td>
                                               <td>

                                               </td>
                                               <td>

                                                   @(Html.Kendo().Button()
                                                         .Name("btnPost")
                                                         .HtmlAttributes(new {type = "search", @class = "k-primary"})
                                                         .Events(e => e.Click("BatchTransfer"))
                                                         .Content("Batch Transfer"))
                                               </td>
                                           </tr>
                                       </table>

                                   </div>
                                </text>);
          }
      })
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("StoreReturnID").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.StoreReturnID);
              model.Field(p => p.Status).Editable(false);
              model.Field(p => p.StoreReturnID).Editable(false);
          })
          .Read(read => read.Action("StoreReturns_Read", "InventoryTransactions"))
      ).ClientDetailTemplateId("storereturntemplate"))


<script id="storereturntemplate" type="text/Kendo-tmpl">
    @(Html.Kendo().TabStrip().SelectedIndex(0).Name("tabStrip_#=StoreReturnID#").Items(items =>
              {
                  items.Add().Text("Detail").Content(
                    @<text>

                        # if (IsOnlineApproved)
                        {#
                        <a href='@Url.Action("StoreReturnPrint", "InventoryPrint",new { area = "Inventory"})/#=StoreReturnID#' title="Print"><i class="fa fa-print fa-2x"></i></a>
                        <br />
                        # } #

                        <div>
                            <hr>
                            <dl class="dl-horizontal">
                                <dt>
                                    Store Return Number
                                </dt>
                                <dd>
                                    #= StoreReturnID #
                                </dd>

                                <dt>
                                    Store
                                </dt>
                                <dd>
                                    #= StoreCode #
                                </dd>

                                <dt>
                                    Status
                                </dt>
                                <dd>
                                    #= Status #
                                </dd>

                                <dt>
                                    Reason
                                </dt>
                                <dd>
                                    #= Reason #
                                </dd>
                                <dt>
                                    Remark
                                </dt>
                                <dd>
                                    #= Remark #
                                </dd>
                                <dt>
                                    CreatedOn
                                </dt>
                                <dd>
                                    #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy hh:mm tt') #

                                </dd>
                                <dt>
                                    CreatedBy
                                </dt>
                                <dd>
                                    #= CreatedBy #
                                </dd>
                                <dt>
                                    Modified By
                                </dt>
                                <dd>
                                    #= ModifiedBy #s
                                </dd>
                                <dt>
                                    Modified Date
                                </dt>
                                <dd>
                                    #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy hh:mm tt') #
                                </dd>
                            </dl>


                        </div>
                    </text>);
                          items.Add().Text("Item").Content(
                            @<text>

                                @(Html.Kendo().Grid<StoreReturnItems>()
                                      .Name("StoreReturnItem_#=StoreReturnID#")
                                      .Columns(columns =>
                                      {
                                          columns.ForeignKey(p => p.ItemCategoryCode, (IEnumerable)ViewData["Category"], "ItemCategoryCode", "Name").Title("Category").EditorTemplateName("ItemCategorySelector").Width(150);
                                          columns.ForeignKey(p => p.ItemCode, (IEnumerable)ViewData["Items"], "ItemCode", "Name").Title("Items").EditorTemplateName("ItemSelector").Width(150);
                                          columns.Bound(c => c.Quantity).Width(140);
                                      })

                                      .Events(ev => ev.Edit("onEdit"))
                                      .Events(x => x.DataBound("onDataBoundLines"))
                                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                                      .Scrollable()
                                      .DataSource(dataSource => dataSource
                                          .Ajax()
                                          .Events(ev => ev
                                              .Error("error_handler(\"StoreReturnItem_#=StoreReturnID#\")")
                                              .RequestStart("onRequestStart(\"StoreReturnItem_#=StoreReturnID#\")")
                                              .RequestEnd("onRequestEnd(\"StoreReturnItem_#=StoreReturnID#\")"))

                                          .Model(model => model.Id(p => p.StoreReturnItemsID))
                                          .Read(read => read.Action("StoreReturnItems_Read", "StoreReturnItem", new { area = "Inventory", id = "#=StoreReturnID#" }))
                                      ).ToClientTemplate())

                            </text>);



                                  items.Add().Text("Validation").Content(
                                    @<text>
                                        @(Html.Kendo().Grid<StoreReturnValidation>()
                                              .Name("StoreReturnValidation_#=StoreReturnID#")
                                              .Columns(columns =>
                                              {
                                                  columns.Bound(c => c.Status).Width(170).EditorTemplateName("ValidationStatus");
                                                  columns.Bound(c => c.Remark).Width(170);

                                              })

                                              .Scrollable()
                                              .Events(x => x.DataBound("onDataBoundFisrtValidation"))
                                              .DataSource(dataSource => dataSource
                                                  .Ajax()
                                                  .Events(ev => ev
                                                      .Error("error_handler(\"StoreReturnValidation_#=StoreReturnID#\")")
                                                      .RequestStart("onRequestStart(\"StoreReturnValidation_#=StoreReturnID#\")")
                                                      .RequestEnd("onRequestEnd(\"StoreReturnValidation_#=StoreReturnID#\")"))

                                                  .Model(model => model.Id(p => p.StoreReturnValidationID))
                                                  .Read(read => read.Action("StoreReturnValidations_Read", "StoreReturnValidation", new { area = "Inventory", id = "#=StoreReturnID#" }))
                                              ).ToClientTemplate())

                                    </text>);
                                      }).ToClientTemplate())
    <br />
    Distribution
    # if (IsOnlineApproved && !IsOnlineTransferred && !IsVoid )
    {#
    <a onclick='return transfer("#=StoreReturnID#")' href=' \#' title="Transfer to GL"><i class="fa fa-paper-plane fa-2x"></i></a>
    &nbsp;&nbsp;&nbsp;
    <a onclick='return generateDistribution("#=StoreReturnID#")' href=' \#' title="Regenerate Distribution"><i class="fa fa-forward fa-2x"></i></a>
    <br />
    # } #
    @(Html.Kendo().Grid<StoreReturnDistribution>()
          .Name("StoreReturnDistribution_#=StoreReturnID#")
          .Columns(columns =>
          {

              columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(220);
              columns.Bound(c => c.AccountDesc).Width(200);
              columns.Bound(c => c.AdditionalDescription).Width(150);
              columns.Bound(c => c.Debit).Width(100).ClientFooterTemplate("Total Debit: \\#=sum\\# ");
              columns.Bound(c => c.Credit).Width(100).ClientFooterTemplate("Total Credit: \\#=sum\\# ");
              columns.Command(command =>
              {
                  command.Edit();
                  command.Destroy();

              }).ClientFooterTemplate("Difference: \\#=Debit.sum-Credit.sum\\# ");
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create();
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable()
          .Events(x => x.DataBound("onDataBoundDistribution"))
          .DataSource(dataSource => dataSource

              .Ajax()
              .Model(model =>
              {
                  model.Id(p => p.StoreReturnDistributionID);
                  model.Field(p => p.AccountDesc).Editable(false);

              })
              .Aggregates(aggregates =>
              {
                  aggregates.Add(p => p.Debit).Sum();
                  aggregates.Add(p => p.Credit).Sum();
              })
              .Events(ev => ev
                  .Error("error_handler(\"StoreReturnDistribution_#=StoreReturnID#\")")
                  .RequestStart("onRequestStart(\"StoreReturnDistribution_#=StoreReturnID#\")")
                  .RequestEnd("onRequestEnd(\"StoreReturnDistribution_#=StoreReturnID#\")"))
              .Read(read => read.Action("StoreReturnDistributions_Read", "StoreReturnDistribution", new { area = "Inventory", id = "#=StoreReturnID#" }))
              .Create(create => create.Action("StoreReturnDistributions_Create", "StoreReturnDistribution", new { area = "Inventory", id = "#=StoreReturnID#" }))
              .Update(read => read.Action("StoreReturnDistributions_Update", "StoreReturnDistribution", new { area = "Inventory" }))
              .Destroy(destroy => destroy.Action("StoreReturnDistributions_Destroy", "StoreReturnDistribution", new { area = "Inventory" }))
          ).ToClientTemplate())


</script>



<script>

    function BatchTransfer() {
        var periodObject = $("#PeriodList").data("kendoDropDownList");
        var periodid = periodObject.value();
       
        if (periodid != null) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("BatchtransferStoreReturn", "InventoryTransactions", new {area = "Finance"})',
                data: { id: periodid },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                beforeSend: function(){
                    // Show image container
                    $("#loading-image").show();
                },
                complete:function(data){
                    // Hide image container
                    $("#loading-image").hide();
                },
                error: function (result) {
                    alert(result);
                }
            });


            $("#grid").data("kendoGrid").dataSource.read();
        } else {
            alert("Please select period.");
        }
        
    }

    function generateDistribution(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("GenerateDistribution", "StoreReturn", new { area = "Inventory" })',
            data: {id: id},
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function transfer(id) {
        var desc = prompt("Please enter transaction description:");

        $.ajax({
            type: "POST",
            url: '@Url.Action("TransferDistribution", "StoreReturn", new { area = "Inventory" })',
            data: {
                id: id,
                description: desc
            },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
    var storeCode;
    var codeid;

    function onEdit(e) {
        var masterRow = this.wrapper.closest("tr.k-detail-row").prev(".k-master-row");
        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        storeCode = masterDataItem.StoreCode;
        //    codeid = masterDataItem.GoodSellingAndLendingID;
    }


    //}



    function OnIndexCall(elem) {

        var a = codeid;
        $(elem).attr('href', $(elem).attr('href') + '?id=' + a);


    }
   
   
    //function setLang(ItemCode) {
    //    aCode = ItemCode;
    //    $("#ItemCode").val(aCode).trigger("change");
    //}

    function getItems() {
        return {
            storeCode: storeCode
        }
    }
</script>
