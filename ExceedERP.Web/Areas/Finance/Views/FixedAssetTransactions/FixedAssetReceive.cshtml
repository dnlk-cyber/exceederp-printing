<script>

    function BatchTransfer() {
        var periodObject = $("#PeriodList").data("kendoDropDownList");
        var periodid = periodObject.value();

        if (periodid != null) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("BatchtransferGrn", "FixedAssetTransactions", new {area = "Finance"})',
                data: { id: periodid },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                beforeSend: function(){
                    // Show image container
                    $("#loading-image").show();
                },
                complete:function(data){
                    // Hide image container
                    $("#loading-image").hide();
                },
                error: function (result) {
                    alert(result);
                }
            });


            $("#grid").data("kendoGrid").dataSource.read();
        } else {
            alert("Please select period.");
        }

    }

    function generateDistribution(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("GenerateDistribution", "FixedAssetReceive", new { area = "FixedAsset" })',
            data: {id: id},
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function transfer(id) {
        var desc = prompt("Please enter transaction description:");

        $.ajax({
            type: "POST",
            url: '@Url.Action("TransferDistribution", "FixedAssetReceive", new { area = "FixedAsset" })',
            data: {
                id: id,
                description: desc
            },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


