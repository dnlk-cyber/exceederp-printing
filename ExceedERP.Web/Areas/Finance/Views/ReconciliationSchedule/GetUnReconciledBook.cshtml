@model IEnumerable<ExceedERP.Core.Domain.Finance.Bank.ReconciliationBookAccount>
<p align="right"> <b>@ViewBag.UnreconciledBook ETB </b></p>
<table class="table table-striped table-bordered table-condensed table-hover">
    <tr>
        
        <th>
            Reference
        </th>
        <th>
            Debit
        </th>
        <th>
            Credit
        </th>
        <th>
            Date
        </th>
        <th>
            <div id="tabledata-reconciled2"></div>  
        </th>

    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Reference)
            </td>
            <td>
               @Convert.ToDecimal(item.Debit).ToString("#,##0.00")
            </td>
            <td>
                @Convert.ToDecimal(item.Credit).ToString("#,##0.00")
            </td>
            <td>
                @item.Date.ToShortDateString()
            </td>
            <td>
                <div class="hidden-sm hidden-xs btn-group">
                    <a class="reconcile-link1 btn btn-xs btn-success lot-link" data-ajax="true" data-ajax-loading="#loading-reconciled2" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#tabledata-reconciled2" href='@Url.Action("ReconcileBook", new { id = item.ReconciliationBookAccountId })' title="Reconcile">
                        <i class="ace-icon fa fa-check bigger-120"></i>
                    </a>
                </div>  
                @*@Ajax.ActionLink("Reconcile", "ReconcileBook", new { id = item.ReconcilationBookAccountID},
                new AjaxOptions
                {
                    InsertionMode = InsertionMode.Replace,
                    HttpMethod = "GET",
                    UpdateTargetId = "tabledata-reconciled2",
                    LoadingElementId = "loading-reconciled2"
                }, new { @class = "reconcile-link" })*@
                <div id="loading-reconciled2" style="display:none; color:Red; font-weight: bold">
                    <img src="~/Content/Images/load.gif" />
                </div>
                
            </td>
        </tr>
    }

</table>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script>
    $(document).ready(function () {


        // rec Link
        $('.reconcile-link1').click(function (event) {

            event.preventDefault();
            var updateLinkObj = $(this);  //for future use

           
            $.post(updateLinkObj[0].href, function (status) {  //Post to action
                if (status == 'TRUE') {
                    //reconciled
                    updateLinkObj.closest("tr").remove();
                }
                else {
                    //not reconciled
                }
            });
           

        });


    });
</script>