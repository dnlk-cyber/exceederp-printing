@(Html.Kendo().Window().Name("Details")
      .Title("Record Details")
      .Visible(false)
      .Modal(true)
      .Draggable(true)
      .Width(600)      
      )


<script>

    function showDetails(e) {
        e.preventDefault();
                 
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        //alert(dataItem.SourceID);
        var wnd = $("#Details").data("kendoWindow");
        
        wnd.refresh({
            // Url to the action fetching the partial view
            url: "/Finance/ReconciliationSchedule/DrillDownBookSource",
            // The id passed to the action so that model can be found
            data: { id: dataItem.SourceID }
        });
        wnd.center().open();
    }

    function onDataBoundLineBankReconciliation(e) {
        var isapproved = @(Json.Encode(Model.IsOnlineApproved)) === "False" ? false : true;
        var  isSendForApproval=@(Json.Encode(Model.IsSendForApproval)) === "False" ? false : true;
        var detailGrid = "#" + e.sender.element[0].id;

        if (isapproved ||isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
   
    


    function ChangeStatus(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        $.ajax({
            type: "GET",
            data: dataItem.ReconciliationBookAccountId, //I obtained the id properly
            url: '@Url.Action("Change", "ReconciliationBookAccount")/' + dataItem.ReconciliationBookAccountId,
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }

        });

        //$('#gridbook').data('kendoGrid').dataSource.read();
        //$('#gridbook').data('kendoGrid').refresh();
        location.reload();
    };


    function ReconcileBank(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.ReconciliationBankAccountId;
        var reconid = @Model.ReconciliationScheduleId;
        $.ajax({
            type: "POST",
            url: '@Url.Action("ReconcileBank", "ReconciliationSchedule", new { area = "Finance" })',
            data: { id: id, reconid: reconid },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    };

</script>

