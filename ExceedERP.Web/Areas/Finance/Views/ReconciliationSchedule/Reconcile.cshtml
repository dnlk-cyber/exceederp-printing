<legend>Reconciliation</legend>

    <div class="hidden-sm hidden-xs btn-group">
        <a href='@Url.Action("Reconcile", new { id = Model.ReconciliationScheduleId })' class=" btn btn-xs btn-primary" title="Refresh">
            <i class="ace-icon fa fa-refresh bigger-120"></i>
        </a>
        <a href='@Url.Action("BankReconciliationStatement", "FinanceReports", new { id = Model.ReconciliationScheduleId })' class=" btn btn-xs btn-primary" title="Print" target="_blank">
            <i class="ace-icon fa fa-print bigger-120"></i>
        </a>
    </div>

<table class="table table-striped table-bordered table-condensed table-hover">
    <tr style="color:blue;background:lightblue;">
        <th width="25%">
            @Html.DisplayNameFor(model => model.BankAccount)
        </th>
        <td width="25%">
            @Html.DisplayFor(model => model.BankAccount)
        </td>
        <th width="25%">
            @Html.DisplayNameFor(model => model.Date)
        </th>
        <td width="25%">
            @Model.Date.ToShortDateString()
        </td>
    </tr>
    <tr>
    <tr style="color:blue;background:lightblue;">
        <th width="25%">
            @Html.DisplayNameFor(model => model.StatementNum)
        </th>
        <td width="25%">
            @Html.DisplayFor(model => model.StatementNum)
        </td>
        <td width="50%" colspan="2"></td>
    </tr>
    <tr>
        <th colspan="2" style="color:white;background:cadetblue; font-size: 16px;text-align: center">
            Bank
        </th>

        <th colspan="2" style="color:white;background:burlywood; font-size: 16px;text-align: center">
            Book
        </th>

    </tr>
    <tr>
        <th width="25%" style="color:blue;background:cadetblue;">
            @Html.DisplayNameFor(model => model.BankEndingBalance)

        </th>
        <td width="25%" style="color:blue;background:cadetblue;">
            @Convert.ToDecimal(Model.BankEndingBalance).ToString("#,##0.00")
        </td>

        <th width="25%" style="color:blue;background:burlywood;">
            Book Beginning Balance
        </th>
        <td width="25%" style="color:blue;background:burlywood;">
            @*<b>@ViewBag.bookBeginingBalance</b>*@
            @Convert.ToDecimal(ViewBag.bookBeginingBalance).ToString("#,##0.00")
        </td>
    </tr>
    <tr>
        <th width="25%" style="color:blue;background:cadetblue;">
            <b>Total Deposits</b>
        </th>
        <td width="25%" style="color:blue;background:cadetblue;">

            @Convert.ToDecimal(ViewBag.Tdeposit).ToString("#,##0.00")
        </td>
        <th width="25%" style="color:blue;background:burlywood;">
            <b>Add:  Receipts(Dr)</b>
        </th>
        <td width="25%" style="color:blue;background:burlywood;">

            @Convert.ToDecimal(ViewBag.Receipts).ToString("#,##0.00")
        </td>

    </tr>
    <tr>
        <th width="25%" style="color:blue;background:cadetblue;">
            <b>Total Outstanding Payment</b>
        </th>
        <td width="25%" style="color:blue;background:cadetblue;">

            @Convert.ToDecimal(ViewBag.TOutstanding).ToString("#,##0.00")
        </td>
        <th width="25%" style="color:blue;background:burlywood;">
            <b>Less: Payment(Cr)</b>
        </th>
        <td width="25%" style="color:blue;background:burlywood;">

            @Convert.ToDecimal(ViewBag.Payment).ToString("#,##0.00")
        </td>

    </tr>
    <tr>
        <th width="25%" style="color:blue;background:cadetblue;">
            <b>Unreconciled Difference</b>
        </th>
        <td width="25%" style="color:blue;background:cadetblue;">

            @Convert.ToDecimal(ViewBag.TUnreconciledDifference).ToString("#,##0.00")
        </td>

        <th width="25%" style="color:blue;background:burlywood;">
            Book(GL) Ending Balance
        </th>
        <td width="25%" style="color:blue;background:burlywood;">
            @Convert.ToDecimal(ViewBag.bookEndingBalance).ToString("#,##0.00")
        </td>
    </tr>

</table>

