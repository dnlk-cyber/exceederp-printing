@using ExceedERP.Helpers.Common

<legend>Travel Order</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.AP.Travel.ApTravelOrder>()
              .Name("grid")
              .Columns(columns =>
              {
                  columns.Bound(c => c.ApTravelOrderId).ClientTemplate("#=appendZeros(ApTravelOrderId)#").Width(100).Title("ID");
                  columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(200).EditorTemplateName("EmployeeSelector").Filterable(ftb => ftb.Multi(true).Search(true));
                  if (GlobalHelper.IsMultipleBusinessUnit())
                  {
                      columns.ForeignKey(c => c.FromBusinessUnitId, (IEnumerable)ViewData["BusinessUnits"], "BusinessUnitId", "Name").Width(180).EditorTemplateName("BusinessUnitSelector").Filterable(ftb => ftb.Multi(true).Search(true));
                  }
                  columns.ForeignKey(c => c.FromBranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").Width(180).EditorTemplateName("AllBranchSelector").Filterable(ftb => ftb.Multi(true).Search(true));
                  columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(200).Filterable(ftb => ftb.Multi(true).Search(true));
                  columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["Structure"], "OrgStructureId", "Name").Title("Work Unit").Width(160).EditorTemplateName("WorkUnitCostCenterSelector").Filterable(ftb => ftb.Multi(true).Search(true));
                  columns.Bound(c => c.PurposeOfTravel).Width(150);
                  columns.Bound(c => c.RequestDate).Width(130);
                  columns.Bound(c => c.TotalDuration).Width(130);
                  columns.Bound(c => c.AdvanceAmount).Width(120);
                  columns.Bound(c => c.TransportReference).Width(150);
                  columns.Bound(c => c.Reference).Width(150);
                  columns.Bound(c => c.Status).Width(90);
                  columns.Bound(c => c.Paid).Width(90).Title("Paid ?").ClientTemplate(
                  "<input type='checkbox' disabled = 'true' value='#= Paid #' " +
                  "# if (Paid) { #" +
                  "checked='checked'" +
                  "# } #" +
                  "/>"
                  );
                  columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
              })
              .ToolBar(toolbar =>
              {
                  //toolbar.Create();
              })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("TravelOrder").Window(w => w.Title("Travel Order")))
              .HtmlAttributes(new { style = "height: 550px;" })
                        .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(20))
                        .Scrollable()
                        .Sortable()
                        .Filterable()
                            .Selectable(selectable =>
                            {
                                selectable.Mode(GridSelectionMode.Single);
                                selectable.Type(GridSelectionType.Row);
                            })
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })

                         .Events(ev => ev.Edit("onMasterEdit"))

                        .Scrollable(h => h.Height(500))
                         .Events(ev => ev.DetailExpand("detailExpand"))
                      .Events(x => x.DataBound("onDataBoundMaster"))
                  .DataSource(dataSource => dataSource
                      .Ajax()
                        .Sort(sort => sort.Add("ApTravelOrderId").Descending())
                                               .Events(ev => ev
                                            .Error("error_handler(\"grid\")")
                                            .RequestStart("onRequestStart(\"grid\")")
                                            .RequestEnd("onRequestEnd(\"grid\")"))
                      .Model(model =>
                      {
                          model.Id(p => p.ApTravelOrderId);

                          model.Field(p => p.ApTravelOrderId).Editable(false);
                          model.Field(p => p.AdvanceAmount).Editable(false);
                          model.Field(p => p.TotalDuration).Editable(false);
                          model.Field(p => p.Paid).Editable(false);
                          model.Field(p => p.Claimed).Editable(false);
                          model.Field(p => p.Status).Editable(false);
                          model.Field(p => p.OrgStructureId).Editable(false);
                          model.Field(p => p.BranchId).Editable(false);
                          model.Field(p => p.BusinessUnitId).Editable(false);
                          model.Field(p => p.FromBusinessUnitId).Editable(false);
                          model.Field(p => p.FromBranchId).Editable(false);
                          model.Field(p => p.CreatedAtBranchId).Editable(false);
                          model.Field(p => p.CreatedAtBusinessUnitId).Editable(false);
                          model.Field(p => p.CreatedAtOrgStructureId).Editable(false);
                          model.Field(p => p.IsForOther).Editable(false);
                          model.Field(p => p.VehicleDistributionID).Editable(false);
                          model.Field(p => p.CreatedBy).Editable(false);
                          model.Field(p => p.DateCreated).Editable(false);
                          model.Field(p => p.ModifiedBy).Editable(false);
                          model.Field(p => p.LastModified).Editable(false);
                      })
                  .Read(read => read.Action("ApTravelOrders_Read", "ApTravelOrder"))
                  .Create(create => create.Action("ApTravelOrders_Create", "ApTravelOrder"))
                  .Update(update => update.Action("ApTravelOrders_Update", "ApTravelOrder"))
                  .Destroy(destroy => destroy.Action("ApTravelOrders_Destroy", "ApTravelOrder"))
              ).ClientDetailTemplateId("detailtemplate")
)


