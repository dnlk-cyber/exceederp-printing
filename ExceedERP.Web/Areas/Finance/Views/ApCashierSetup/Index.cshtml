@using System.Collections
<legend>Cashier Setup</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.AP.ApCashierSetup>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Cashier).Width(200).EditorTemplateName("SubAccountSelector");
          columns.Bound(c => c.Description).Width(130);
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(150);
          columns.Bound(c => c.AccountCode).Width(200).EditorTemplateName("AccountCode");
          columns.Bound(c => c.IsActive).Width(80).Title("IsActive").ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= IsActive #' " +
              "# if (IsActive) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.ActiveInactiveTime).Width(120);

          columns.Command(command =>
          {
              command.Edit(); /*command.Destroy();*/ 
              command.Custom("En").Click("Enable");
          }).Width(180);
      })
      .ToolBar(toolbar => {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Sortable()
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Scrollable()
      .Events(events => events.Edit("edit"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.ApCashierSetupId);
              model.Field(p => p.ApCashierSetupId).Editable(false);
              model.Field(p => p.ActiveInactiveTime).Editable(false);
              model.Field(p => p.Description).Editable(false);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.LastModified).Editable(false);
          })
          .Read(read => read.Action("CashierSetups_Read", "ApCashierSetup"))
          .Create(create => create.Action("CashierSetups_Create", "ApCashierSetup"))
          .Update(update => update.Action("CashierSetups_Update", "ApCashierSetup"))
          .Destroy(destroy => destroy.Action("CashierSetups_Destroy", "ApCashierSetup"))
      )
)

<script type="text/javascript">

    function Enable(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        $.ajax({
            type: "GET",
            data: dataItem.ApCashierSetupId,
            url: '@Url.Action("Enable_Disable", "ApCashierSetup")/' + dataItem.ApCashierSetupId

        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();
        location.reload();
    };


    function edit(e) {
        if (e.model.isNew() === false) {
            $("#Cashier").attr("readonly", true);
        }
    }
</script>