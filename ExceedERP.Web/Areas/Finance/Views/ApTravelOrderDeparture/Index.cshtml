
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.AP.Travel.ApTravelOrderDeparture>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Type);
          columns.Bound(c => c.From);
          columns.Bound(c => c.To);
          columns.Bound(c => c.Date);
          columns.Bound(c => c.Time);
          columns.Bound(c => c.TransportMode);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ApTravelOrderDepartureId))
          .Read(read => read.Action("ApTravelOrderDepartures_Read", "ApTravelOrderDeparture"))
          .Create(create => create.Action("ApTravelOrderDepartures_Create", "ApTravelOrderDeparture"))
          .Update(update => update.Action("ApTravelOrderDepartures_Update", "ApTravelOrderDeparture"))
          .Destroy(destroy => destroy.Action("ApTravelOrderDepartures_Destroy", "ApTravelOrderDeparture"))
      ))
