@using ExceedERP.Core.Domain.Finance.Report
@using ExceedERP.Core.Domain.Finance.Report.IFRS
@using ExceedERP.Web.Areas.Finance.Controllers
<legend>SCOI</legend>
@(Html.Kendo().Grid<IfrsStatementOfComprehensiveIncome>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.IfrsStatementOfComprehensiveIncomeId).Title("ID").Width(300);
          columns.Command(command =>
          {
              if (ViewBag.Count > 0)
              {
                  return;
              }
              command.Edit();
              command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          if (ViewBag.Count <= 0)
          {
              toolbar.Create();
          }
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .ClientDetailTemplateId("templates")
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model =>
          {
              model.Id(p => p.IfrsStatementOfComprehensiveIncomeId);
              model.Field(p => p.IfrsStatementOfComprehensiveIncomeId).Editable(false);
          }
          )
          .Read(read => read.Action("IfrsStatementOfComprehensiveIncomes_Read", "IfrsStatementOfComprehensiveIncome"))
          .Create(create => create.Action("IfrsStatementOfComprehensiveIncomes_Create", "IfrsStatementOfComprehensiveIncome"))
          .Update(update => update.Action("IfrsStatementOfComprehensiveIncomes_Update", "IfrsStatementOfComprehensiveIncome"))
          .Destroy(destroy => destroy.Action("IfrsStatementOfComprehensiveIncomes_Destroy", "IfrsStatementOfComprehensiveIncome"))
      )
      .Events(events => events.DataBound("dataBound")))

