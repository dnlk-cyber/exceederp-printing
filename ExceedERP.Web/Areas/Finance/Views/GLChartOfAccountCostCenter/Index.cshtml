@using System.Collections
@using ExceedERP.Core.Domain.Finance.GL
<legend> Cost Center</legend>
@(Html.Kendo().Grid<GLChartOfAccountCostCenter>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Values).Width(90);
          columns.Bound(c => c.Description).Width(120);
          columns.ForeignKey(c => c.HasParent, (IEnumerable)ViewData["parents"], "HasParent", "HasParent").Width(120);
          columns.Bound(c => c.Enable).Width(100).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= Values #' " +
              "# if (Enable) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.Parent).Width(100).Title("Is Parent?").ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= Values #' " +
              "# if (Parent) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );

          columns.Bound(c => c.AllowBudgeting).Width(140).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= Values #' " +
              "# if (AllowBudgeting) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.AllowPosting).Width(150).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= Values #' " +
              "# if (AllowPosting) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.Type).Width(120).EditorTemplateName("CostCenterTypes");
          columns.Bound(c => c.OrgBranchName).Width(100).Hidden(true);
          columns.Bound(c => c.DateCreated).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.LastModified).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
          columns.Command(command => { command.Edit(); command.Custom("En").Click("Enable"); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(
              model =>
              {
                  model.Id(p => p.Values);
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);

              })
          .Events(events => events .Error("error_handler_one"))
          .Read(read => read.Action("GLChartOfAccountCostCenters_Read", "GlChartOfAccountCostCenter"))
          .Create(create => create.Action("GLChartOfAccountCostCenters_Create", "GlChartOfAccountCostCenter"))
          .Update(update => update.Action("GLChartOfAccountCostCenters_Update", "GlChartOfAccountCostCenter"))
          .Destroy(destroy => destroy.Action("GLChartOfAccountCostCenters_Destroy", "GlChartOfAccountCostCenter"))
      ))


<script type="text/javascript">
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }
</script>

<script>


    function Enable(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.Values;
        $.ajax({

            type: "GET",
            data: dataItem.Values, //I obtained the id properly
            url: '@Url.Action("Enable_Disable", "GlChartOfAccountCostCenter")/' + dataItem.Values

        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();
        location.reload();
    };
</script>