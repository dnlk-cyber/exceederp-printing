@{
    Layout = "~/Views/Shared/_Popup.cshtml";
}
<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.Label("Account", htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @(Html.Kendo().DropDownList()
                          .Name("Accounts")
                          .HtmlAttributes(new {style = "width:200px"})
                          .ValuePrimitive(true)
                          .OptionLabel("...Account...")
                          .DataTextField("desc")
                          .DataValueField("value")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetAccounts", "AccountCode"))
                                  .ServerFiltering(true);
                          })
                          )
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.Label("Company or Branch", htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @(Html.Kendo().DropDownList()
                          .Name("Location")
                          .ValuePrimitive(true)
                          .OptionLabel("...Branch...")
                          .HtmlAttributes(new {style = "width:200px"})
                          .DataTextField("desc")
                          .DataValueField("value")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetLocations", "AccountCode"))
                                  .ServerFiltering(true);
                          })
                          )
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.Label("Cost Center", htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @(Html.Kendo().DropDownList()
                          .Name("CostCenter")
                          .ValuePrimitive(true)
                          .OptionLabel("...Cost Center...")
                          .HtmlAttributes(new {style = "width:200px"})
                          .DataTextField("desc")
                          .DataValueField("value")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetCostCenter", "AccountCode"))
                                  .ServerFiltering(true);
                          })
                          )
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.Label("Sub Account", htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @(Html.Kendo().DropDownList()
                          .Name("SubAccount")
                          .ValuePrimitive(true)
                          .OptionLabel("...Sub Account...")
                          .HtmlAttributes(new {style = "width:200px"})
                          .DataTextField("desc")
                          .DataValueField("value")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetSubAccounts", "AccountCode"))
                                  .ServerFiltering(true);
                          })
                         )
                </div>
            </div>
            <div class="row"></div>
            <div class="col-md-offset-3 col-md-9">
                <button type="submit" class="saveBtn btn btn-primary" onclick="javascript:changeparent()"><i class="fa fa-suitcase"></i> Submit</button>
            </div>
        </div>
    </div>
</div>



<script language="javascript">

    function changeparent() {
        if ((document.getElementById('Location').value.length == 0) || (document.getElementById('Accounts').value.length == 0) || (document.getElementById('CostCenter').value.length == 0) || (document.getElementById('SubAccount').value.length == 0)) {
            alert("Please select.");
        }
        else {
            var company = document.getElementById('Location').value;
            var account = document.getElementById('Accounts').value;
            var costcenter = document.getElementById('CostCenter').value;
            var subaccount = document.getElementById('SubAccount').value;
            var accCode = account + "-" + company + "-" + costcenter + "-" + subaccount;

            window.opener.document.getElementById('APAccountCode').value = accCode;
            $(window.opener.document.getElementById('APAccountCode')).trigger("change");
            
            window.close();
        }
    }
    function closeWin() {
        document.close();
    }
</script>

<style>
    .k-list-container ul li.k-item{
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .k-list-container ul {
        overflow: hidden!important;
        }
</style>

