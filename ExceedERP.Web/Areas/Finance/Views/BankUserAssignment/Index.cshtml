@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Bank Account User Assignment</legend>

@(Html.Kendo().Grid<BankUserAssignment>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.ForeignKey(p => p.BankAccount, (IEnumerable)ViewData["accounts"], "Code", "Name").Title("Account").Width(400).EditorTemplateName("BankAccounts").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(p => p.User, (IEnumerable)ViewData["users"], "Code", "Name").Title("User").Width(350).EditorTemplateName("AllUserSelector").Filterable(ftb => ftb.Multi(true).Search(true));

          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          });
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Sortable()
      .Filterable()
      
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(
              model =>
              {
                  model.Id(p => p.BankUserAssignmentId);
                  model.Field(p => p.BankUserAssignmentId).Editable(false);
              })
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("BankUserAssignments_Read", "BankUserAssignment"))
          .Create(create => create.Action("BankUserAssignments_Create", "BankUserAssignment"))
          .Update(update => update.Action("BankUserAssignments_Update", "BankUserAssignment"))
          .Destroy(destroy => destroy.Action("BankUserAssignments_Destroy", "BankUserAssignment"))
      ))
