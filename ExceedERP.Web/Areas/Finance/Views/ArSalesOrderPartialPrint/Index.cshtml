
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Finance.AR.SalesOrder.ArSalesOrderPartialPrint>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Date);
          columns.Bound(c => c.Description);
          columns.Bound(c => c.Status);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.IsVoid);
          columns.Bound(c => c.VoidBy);
          columns.Bound(c => c.VoidTime);
          columns.Bound(c => c.IsOnlineApproved);
          columns.Bound(c => c.OnlineApprovedBy);
          columns.Bound(c => c.OnlineApprovedTime);
          columns.Bound(c => c.IsOnlineTransferred);
          columns.Bound(c => c.IsOnlineTransferredBy);
          columns.Bound(c => c.OnlineTransferredTime);
          columns.Bound(c => c.IsSendForApproval);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.SendForApprovalBy);
          columns.Bound(c => c.SendForApprovalTime);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ArSalesOrderPartialPrintId))
          .Read(read => read.Action("ArSalesOrderPartialPrints_Read", "ArSalesOrderPartialPrint"))
          .Create(create => create.Action("ArSalesOrderPartialPrints_Create", "ArSalesOrderPartialPrint"))
          .Update(update => update.Action("ArSalesOrderPartialPrints_Update", "ArSalesOrderPartialPrint"))
          .Destroy(destroy => destroy.Action("ArSalesOrderPartialPrints_Destroy", "ArSalesOrderPartialPrint"))
      ))
