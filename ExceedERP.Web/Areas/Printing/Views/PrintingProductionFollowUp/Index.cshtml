<script type="text/javascript">
    function filterTextMachine() {
        return {
            text: $("#MachineTypeId").data("kendoDropDownList").filterInput.val(),
        }
    }
    function filterUOM() {
        return {
            text: $("#UOM").data("kendoDropDownList").filterInput.val()
        }
    }
    function filterUoM() {
        return {
            text: $("#UoM").data("kendoDropDownList").filterInput.val()
        }
    }
    function filterOperator() {
        return {
            text: $("#OperatorId").data("kendoDropDownList").filterInput.val()
        }
    }

    function filterEmployee() {
        return {
            text: $("#TechnicianId").data("kendoDropDownList").filterInput.val()
        }
    }
    function onPressCategoryChange(e) {
        var pressCategoryValue = this.value(); // Get selected value (1, 2, or 3)
        var labourDropdown = $("#LabourActivity").data("kendoDropDownList");

        // Map PressCategory to LabourActivity ranges
        var ranges = {
            1: [101, 199], // PrePress
            2: [201, 299], // Press
            3: [301, 399]  // PostPress
        };

        var selectedRange = ranges[pressCategoryValue];
        var allOptions = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.Printing.LabourActivity))
        ));

        // Filter options
        var filteredOptions = allOptions.filter(function (item) {
            var val = parseInt(item.Value);
            return val >= selectedRange[0] && val <= selectedRange[1];
        });

        labourDropdown.setDataSource(new kendo.data.DataSource({ data: filteredOptions }));
        labourDropdown.select(0); // Optionally select the first item
    }
</script>
<script type="text/javascript">

    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            $(this).find(".k-grid-reject").hide();
            if (dataItem.IsPrePressChecked) {
                $(this).find(".k-grid-edit").hide();
                $(this).find(".k-grid-check").hide();
                $(this).find(".k-grid-approve").hide();
                $(this).find(".k-grid-reject").hide();
                $(this).find(".k-grid-delete").hide();
            }
            else if (dataItem.IsPrePressApproved) {
                $(this).find(".k-grid-edit").hide();
                $(this).find(".k-grid-check").hide();
                $(this).find(".k-grid-delete").hide();
                $(this).find(".k-grid-reject").show();

                $(this).find(".k-grid-approve").show();
            }
            else {
                $(this).find(".k-grid-approve").hide();
            }

        });
    }
    var masterRow;
    var masterGrid;
    var masterDataItem;
    var codeid;
    var isApproved;
    var isChecked;
    function detailExpand(e) {
        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.PrintingProductionFollowUpId;
        isApproved = masterDataItem.IsPrePressApproved;
        isChecked = masterDataItem.IsPrePressChecked;
        if (isChecked || isApproved) {
            $(".k-grid-add", "#grid_" + codeid).hide();
        }


    }
    
    function detailDataBound(e) {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsOnlineApproved) {
                $(this).find(".k-grid-edit").hide();
                $(this).find(".k-grid-check").hide();
                $(this).find(".k-grid-approve").hide();
                $(this).find(".k-grid-reject").hide();
                $(this).find(".k-grid-delete").hide();
            }
            else if (dataItem.IsSendForApproval) {
                $(this).find(".k-grid-edit").hide();
                $(this).find(".k-grid-check").hide();
                $(this).find(".k-grid-delete").hide();
                $(this).find(".k-grid-reject").show();

                $(this).find(".k-grid-approve").show();
            }
            else {
                $(this).find(".k-grid-approve").hide();
            }
        });

    }
    
    function handleTaskCheck(e) {
        if (confirm("Are you sure this estimation form is to be checked?")) {
             var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        $.ajax({
           type: "POST",
            url: '@Url.Action("CheckFollowupTask", "CheckAndApproval", new { Area = "Printing" })',
            data: { id: dataItem.PrintingProductionFollowUpTaskId },
            success: function (result) {
                if (result.Success) {
                    toastr.success(result.Message);
                    $("#grid").data("kendoGrid").dataSource.read();
                }
                else {
                    toastr.error(result.Message);

                }
           },
           error: function(result) {
               alert(result);
           }
       });
      }
    }
    function handleTaskApprove(e) {
        if (confirm("Are you sure you want to approve?")) {
            var grid = this;
            var dataItem = grid.dataItem(e.currentTarget.closest("tr"));
            var id = dataItem.PrintingProductionFollowUpTaskId;
            $.ajax({
                type: "POST",
                url: '@Url.Action("ApproveFollowupTask", "CheckAndApproval", new { Area = "Printing" })',
                data: { id: id},
                success: function (result) {
                    if (result.Success) {
                        toastr.success(result.Message)
                        $("#grid").data("kendoGrid").dataSource.read();
                    }
                    else {
                        toastr.error(result.Message)
                    }
                },
                error: function (result) {
                    alert(result)
                }
            });
        }
    }
    function handleFollowupCheck(e) {

        if (confirm("Are you sure you this form is checked?")) {
            var grid = this;
            var dataItem = grid.dataItem(e.currentTarget.closest("tr"));
            var id = dataItem.PrintingProductionFollowUpId;
            $.ajax({
                type: "POST",
                url: '@Url.Action("CheckPrePress", "CheckAndApproval", new { Area = "Printing" })',
                data: { id: id},
                success: function (result) {
                    if (result.Success) {
                        toastr.success(result.Message);
                        $("#grid").data("kendoGrid").dataSource.read();
                    }
                    else {
                        toastr.error(result.Message);
                    }
                },
                error: function (result) {
                    alert(result)
                }
            });
        }
    }

      function handleFollowupApprove(e) {
        if (confirm("Are you sure you want to approve?")) {
            var grid = this;
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
            $.ajax({
                type: "POST",
                url: '@Url.Action("ApprovePrePress", "CheckAndApproval", new { Area = "Printing" })',
                data: { id: dataItem.PrintingProductionFollowUpId},
                success: function (result) {
                    if (result.Success) {
                        toastr.success(result.Message)
                        $("#grid").data("kendoGrid").dataSource.read();
                    }
                    else {
                        toastr.error(result.Message)
                    }
                },
                error: function (result) {
                    alert(result)
                }
