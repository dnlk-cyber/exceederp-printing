@helper FollowUpTask()
{
    @(Html.Kendo().Grid<PrintingProductionFollowUpTask>()
        .Name("followup#=PrintingProductionFollowUpId#")
        .Columns(columns =>
        {
            columns.Bound(c => c.PressCategory);
            columns.Bound(c => c.LabourActivity);
            columns.ForeignKey(c => c.MachineTypeId, (IEnumerable)ViewData["Machine"], "Value", "Text");
            columns.ForeignKey(c => c.OperatorId, (IEnumerable)ViewData["Operator"], "Value", "Text");
            columns.Bound(c => c.UoM);
            columns.Bound(c => c.PlannedOutput);
            columns.Bound(c => c.EstimatedHours);
