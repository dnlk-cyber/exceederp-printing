        .ClientDetailTemplateId("tabstrip2")
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(ev => ev.Error("error_handler(\"followup#=PrintingProductionFollowUpId#\")")
                    .RequestStart("onRequestStart(\"followup#=PrintingProductionFollowUpId#\")")
                    .RequestEnd("onRequestEnd(\"followup#=PrintingProductionFollowUpId#\")"))
            .Model(model =>
            {
                model.Id(p => p.PrintingProductionFollowUpTaskId);

            })
            .Read(read => read.Action("Read_PrePress", "PrintingProductionFollowUpTask", new { id = "#=PrintingProductionFollowUpId#" }))
            .Create(create => create.Action("Create", "PrintingProductionFollowUpTask", new { id = "#=PrintingProductionFollowUpId#" }))
            .Update(update => update.Action("Update", "PrintingProductionFollowUpTask"))
            .Destroy(delete => delete.Action("Delete", "PrintingProductionFollowUpTask"))

