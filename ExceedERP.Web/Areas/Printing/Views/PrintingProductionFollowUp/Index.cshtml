<label>Production Follow-Up</label>

@(Html.Kendo().Grid<PrintingProductionFollowUp>()
                                .Name("grid")
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.PrintingJobOrderItemId).Title("Job No.");
                                    columns.ForeignKey(c => c.CustomerId, (IEnumerable)ViewData["Customer"], "Value", "Text").Title("Customer");
                                    columns.Bound(c => c.PrintJobType).Title("Job Type");
                                    columns.Bound(c => c.JobDescription);
                                    columns.ForeignKey(c => c.TextPaperSizeId, (IEnumerable)ViewData["PaperSize"], "Value", "Text").Title("Text Paper");
                                    columns.ForeignKey(c => c.CoverPaperSizeId, (IEnumerable)ViewData["PaperSize"], "Value", "Text").Title("Cover Paper");
                                    columns.Bound(c => c.BindingStyle);
                                    columns.Bound(c => c.Pages);
                                    columns.Bound(c => c.TextNoOfColor);
                                    columns.Bound(c => c.CoverNoOfColor);
                                    columns.Bound(c => c.Quantity);
                                    columns.Bound(c => c.JobDescription);
                                    columns.Command(command =>
                                    {                                       
                                        command.Custom("check").Text(" ").IconClass("fa fa-check").HtmlAttributes(new { @class = "check", title = "check" }).Click("handleFollowupCheck");
                                        command.Custom("approve").Text(" ").IconClass("fa fa-thumbs-o-up").HtmlAttributes(new { @class = "approve", title = "approve" }).Click("handleFollowupApprove");
