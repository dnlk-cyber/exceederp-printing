@model ExceedERP.Core.Domain.Printing.PrintingProduction.PrintingDailyFollowUpLogBook


<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>Activity</label>
            <div>
               @(Html.Kendo().TextBoxFor(model => model.ActivityType).HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>Time Spent (M)</label>
            <div>
                @(Html.Kendo().NumericTextBoxFor(model => model.TimeSpent).HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>
    </div>
</div>