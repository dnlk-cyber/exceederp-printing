@model ExceedERP.Core.Domain.Printing.PrintingOverAllCost


<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>Admin. Cost (%)</label>
            <div>
                @(Html.Kendo().NumericTextBoxFor(model => model.AdminRate).HtmlAttributes(new { style = "width:100%" }).Min(0).Max(1).Max(100))

            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>Overhead Cost (%)</label>
            <div>
                @(Html.Kendo().NumericTextBoxFor(model => model.OverHeadRate).HtmlAttributes(new { style = "width:100%" }).Min(0).Max(1).Max(100))

            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>Graphics Rate</label>
            <div>
                @(Html.Kendo().NumericTextBoxFor(model => model.GraphicsRate).HtmlAttributes(new { style = "width:100%" }).Min(0))

            </div>
        </div>
    </div>
</div>

<style>
    div.k-edit-form-container {
        width: auto;
        height: auto;
    }

    .row .col-sm-12 {
        width: 300px;
    }

    .row {
        margin: auto;
    }
</style>