@model ExceedERP.Core.Domain.Printing.PrintingOverAllCost


<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Admin. Cost (%)</label>
            <div>
                @(Html.Kendo().NumericTextBoxFor(model => model.AdminstrativeCost).HtmlAttributes(new { style = "width:100%" }).Min(0).Max(1))

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Overhead Cost (%)</label>
            <div>
                @(Html.Kendo().NumericTextBoxFor(model => model.OverHeadCost).HtmlAttributes(new { style = "width:100%" }).Min(0).Max(1))

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Graphics Rate</label>
            <div>
                @(Html.Kendo().NumericTextBoxFor(model => model.GraphicsRate).HtmlAttributes(new { style = "width:100%" }).Min(0))

            </div>
        </div>
    </div>  
    <div class="col-sm-2">
        <div class="form-group">
            <label>Graphics VAT</label>
            <div>
                @(Html.Kendo().DropDownListFor(m => m.GLTaxRateID)
                                                            .ValuePrimitive(true)
                                                            .AutoBind(true)
                                                            .Enable(true)
                                                            .OptionLabel("Select Tax rate...")
                                                            .DataTextField("Text")
                                                            .DataValueField("Value")
                                                            .Filter("contains")
                                                            .DataSource(dataSource =>
                                                            {
                                                                dataSource.Read(read => read.Action("GetTaxRate", "ManufacturingDataProvider", new { area = "Manufacturing" }))
                                                                    .ServerFiltering(true);
                                                            }).HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>
    </div>  

</div>