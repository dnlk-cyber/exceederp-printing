@model ExceedERP.Core.Domain.Printing.PrintingProcess


<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>Printing Category*</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.PressCategory)
                                .Name("PressCategory") // explicitly set the name for JavaScript access
                                .DataTextField("Text")
                                .DataValueField("Value")
                                .OptionLabel("Select Press Category")
                                .BindTo(ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.Printing.PressCategory)))
                                .HtmlAttributes(new { style = "width:100%" })
                                .Events(e => e.Change("onPressCategoryChange")) // attach change event
                )
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>Printing Process*</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.LabourActivity)
                               .Name("LabourActivity")
                               .DataTextField("Text")
                               .DataValueField("Value")
                               .AutoBind(true)
                               .OptionLabel("Select Labour Activity")
                               .HtmlAttributes(new { style = "width:100%" })
                )
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>Machine (Optional)</label>
            <div>
                @(Html.Kendo().DropDownListFor(m => m.PrintingMachineTypeId)
                            .ValuePrimitive(true)
                            .OptionLabel("Select ...")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .Filter("contains")
                            .DataSource(dataSource =>
                            {
                                dataSource.Read(read => read.Action("PrintMachineType", "PrintDataProvider", new { area = "Printing" }).Data("filterMachine"))
                                    .ServerFiltering(true);
                            }).HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
            <div class="form-group">
                <label>UOM*</label>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.UOM)
                        .ValuePrimitive(true)
                        .OptionLabel("Select unit...")
                        .DataTextField("Text")
                        .DataValueField("Value")
                        .Filter("contains")

                        .DataSource(dataSource =>
                        {
                            dataSource.Read(read => read.Action("GetUoM", "PrintDataProvider", new { area = "Printing" }).Data("filterUoM"))
                                .ServerFiltering(true);
                        }).HtmlAttributes(new { style = "width:100%" }))
                </div>
            </div>
        </div>
   
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <label>Labor Rate*</label>
            <div>
                @(Html.Kendo().NumericTextBoxFor(model => model.LaborRate).HtmlAttributes(new { style = "width:100%" }).Min(0))
            </div>
        </div>
    </div>
</div>



