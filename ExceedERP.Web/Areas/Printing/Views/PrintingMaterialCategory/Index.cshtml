

<label>Material Category</label>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Printing.PrintingMaterialCategory>()
                  .Name("grid")
                  .Columns(columns =>
                  {
                      // columns.ForeignKey(c => c.InventoryCategoryCode, (IEnumerable)ViewData["ItemCategory"], "Value", "Text");
                      columns.Bound(c => c.InventoryCategoryCode);
                      columns.Bound(c => c.CategoryName);
                      columns.Bound(c => c.CostAccountCode);
                      columns.Bound(c => c.InventoryAccountCode);
                      // columns.Bound(c => c.ProductionAccountCode);
                      columns.Command(command => { /*command.Edit();*/ command.Destroy(); }).Width(180);
                  })
                  .ToolBar(toolbar =>       
                  {
                      toolbar.Create();
                  })
                  .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("InventoryCategoryTemplate"))
                  .Pageable()
                  .Navigatable()
                  .Events(e => e.DetailExpand("detailExpand"))
                  .Sortable(sortable =>
                  {
                      sortable.SortMode(GridSortMode.SingleColumn);
                  })
                  .Filterable()
                  .Scrollable(s => s.Height(400))
                  .DataSource(dataSource => dataSource
                      .Ajax()
                      .Sort(sort => sort.Add(e => e.PrintingMaterialCategoryId).Descending())
                        .Events(ev => ev.Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
                      .Model(model =>
                      {
                          model.Id(p => p.PrintingMaterialCategoryId);
                          model.Field(p => p.CategoryName).Editable(true);
                          model.Field(p => p.CostAccountCode).Editable(false);
                          model.Field(p => p.InventoryAccountCode).Editable(false);


                      })
                      .Read(read => read.Action("Read", "PrintingMaterialCategory"))
                      .Create(create => create.Action("Create", "PrintingMaterialCategory"))
                      .Update(update => update.Action("Update", "PrintingMaterialCategory"))
                      .Destroy(destroy => destroy.Action("Delete", "PrintingMaterialCategory"))
                  ).ClientDetailTemplateId("templateId")
)

<script id="templateId" type="text/x-kendo-template">
    @(Html.Kendo().TabStrip()
                    .Name("Detail_#=PrintingMaterialCategoryId#")
                    .SelectedIndex(0)
                    .Items(items =>
                    {
                        items.Add().Text("Detail").Content(
                    @<text>
                        @Detail()
                    </text>);
                            }).ToClientTemplate())
</script>

@helper Detail()
{
    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Printing.PrintingMaterialCategoryItem>()
                              .Name("grid_#=PrintingMaterialCategoryId#")
                              .Columns(columns =>
                              {
                                  //columns.ForeignKey(c => c.InventorySubCategoryCode, (IEnumerable)ViewData["ItemCategory"], "Value", "Text").EditorTemplateName("SubCategoryTemplate");
                                  columns.Bound(c => c.ItemName);
                                  columns.Bound(c => c.ItemCode);
                                  columns.Bound(c => c.UnitOfMeasurement);
                                  columns.Bound(c => c.UnitPrice).Title("Unit Price (Birr)");
                                  columns.Bound(c => c.Width);
                                  columns.Bound(c => c.Length);
                                  columns.Bound(c => c.Weight).Title("Weight(g)");
                                  columns.Bound(c => c.ConsumptionRate).Title("Consumption Rate");
                                  columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
                              })
                              .ToolBar(toolbar =>
                              {
                                  toolbar.Create();
                              })
                              .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("CategoryItemTemplate"))
                              .Filterable()
                              .Pageable()
                              .Scrollable(s => s.Height(400))

                              .DataSource(dataSource => dataSource
                                   .Ajax()
                                    .Sort(sort => sort.Add(e => e.PrintingMaterialCategoryItemId).Descending())
                                    .Events(ev => ev.Error("error_handler(\"grid_#=PrintingMaterialCategoryId#\")")
                                    .RequestStart("onRequestStart(\"grid_#=PrintingMaterialCategoryId#\")")
                                    .RequestEnd("onRequestEnd(\"grid_#=PrintingMaterialCategoryId#\")"))
                                  .Model(model =>
                                  {
                                      model.Id(p => p.PrintingMaterialCategoryItemId);
                                      model.Field(p => p.InventorySubCategoryCode).Editable(false);
                                      model.Field(p => p.ItemName).Editable(false);
                                      model.Field(p => p.ItemCode).Editable(true);

                                  })
                                  .Read(read => read.Action("PrintingMaterialCategoryItem_Read", "PrintingMaterialCategoryItem", new { id = "#=PrintingMaterialCategoryId#" }))
                                  .Create(create => create.Action("PrintingMaterialCategoryItem_Create", "PrintingMaterialCategoryItem", new { id = "#=PrintingMaterialCategoryId#" }))
                                  .Update(update => update.Action("PrintingMaterialCategoryItem_Update", "PrintingMaterialCategoryItem"))
                                  .Destroy(destroy => destroy.Action("PrintingMaterialCategoryItem_Delete", "PrintingMaterialCategoryItem"))
                              ).ToClientTemplate()
    )
}

<script type="text/javascript">
    var inventoryCategoryCode;
    var materialCatId;
    function detailExpand(e) {
        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);

        materialCatId = masterDataItem.PrintingMaterialCategoryId;
        inventoryCategoryCode = masterDataItem.InventoryCategoryCode;
        
    }
    function filterCategory() {
        return {
            text: $("#InventoryCategoryCode").data("kendoDropDownList").filterInput.val(),
        }
    }

    function filterSubCategory() {
        return {
            categoryCode: $("#InventoryCategoryCode").val,//.data("kendoDropDownList").value(),
            text: $("#InventorySubCategoryCode").data("kendoDropDownList").filterInput.val()
        }
    }

    function filterUoM() {
        return {
            text: $("#UnitOfMeasurement").data("kendoDropDownList").filterInput.val()
        }
    }
    function filterItemCode() {
        return {
            text: $("#ItemCode").data("kendoDropDownList").filterInput.val(),
            itemCode: inventoryCategoryCode
        }
    }
</script>

<style>
    div.k-edit-form-container {
        width: auto;
        height: auto;
    }

    .row .col-sm-12 {
        width: 300px;
    }

    .row {
        margin: auto;
    }
</style>