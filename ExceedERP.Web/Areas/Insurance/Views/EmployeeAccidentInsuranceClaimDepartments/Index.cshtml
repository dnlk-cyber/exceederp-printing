@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Employee Accident Insurance Claims || Department </legend>

@(Html.Kendo().Grid<EmployeeAccidentInsuranceClaim>()
    .Name("grid")
    .Columns(columns =>
    {

        columns.Bound(c => c.EmployeeAccidentInsuranceClaimId).Title("#").Width(60);
        columns.ForeignKey(c => c.EmployeeId, (IEnumerable<EmployeeViewModel>)ViewData["personEmployees"], "EmployeeId", "FullName")
            .EditorTemplateName("ActiveEmployees").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
        columns.ForeignKey(c => c.OrgStructureId, (IEnumerable<OrgStructureViewModel>)ViewData["workUnit"], "OrgStructureId", "Name")
            .Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
        columns.ForeignKey(c => c.BranchId, (IEnumerable<BranchViewModel>)ViewData["branch"], "BranchId", "Name")
            .Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
        columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable<BusinessUnitViewModel>)ViewData["businessUnit"], "BusinessUnitId", "Name")
            .Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
        columns.Bound(c => c.ResponsibilityLevel).Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
        columns.Bound(c => c.EmployementType).Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
        columns.Bound(c => c.CauseOfTheAccident).Width(180);
        columns.Bound(c => c.TypeOfDamageCaussedByAccident).Width(180);
        columns.Bound(c => c.LocationOfAccident).Width(180);
        columns.Bound(c => c.SalaryDailyOrmonthlyBeforeTtheAccident).Width(180);
        columns.Bound(c => c.Remark).Width(110);
        //columns.Bound(c => c.Description).Width(120);
        columns.Command(command =>
        {

            command.Edit().CancelText("Cancel").Text("Edit");
            command.Destroy().Text("Delete");


        }).Title("Action").Width(200);




    })
    .ToolBar(toolbar =>
    {
        toolbar.Create();

    })
    //.Editable(editable => editable.Mode(GridEditMode.PopUp)
    //  .TemplateName("ServiceRequestTemplate")
    //  .Window(win => win.Title("General service works request form").Width(800)))
    .Editable(editable => editable.Mode(GridEditMode.InLine))
    .Pageable()
    .Filterable()
    .Events(ev =>
    {
        ev.DetailExpand("onDetailExpandUser");
        ev.DataBound("onDataBound");

    })
    .Scrollable(s => s.Height(550))
    .DataSource(dataSource => dataSource
        .Ajax()
        .Model(model =>
        {
            model.Id(p => p.EmployeeAccidentInsuranceClaimId);
            model.Field(p => p.OrgStructureId).Editable(false);
            model.Field(p => p.EmployeeAccidentInsuranceClaimId).Editable(false);
            model.Field(p => p.BranchId).Editable(false);
            model.Field(p => p.BusinessUnitId).Editable(false);
            model.Field(p => p.ResponsibilityLevel).Editable(false);
            model.Field(p => p.SalaryDailyOrmonthlyBeforeTtheAccident).Editable(false);
            model.Field(p => p.EmployementType).Editable(false);



        })
        .Events(ev => ev
        .Error("error_handler(\"grid\")")
        .RequestStart("onRequestStart(\"grid\")")
        .RequestEnd("onRequestEnd(\"grid\")"))
        .Read(read => read.Action("EmployeeAccidentInsuranceClaimDepartments_Read", "EmployeeAccidentInsuranceClaimDepartments"))
        .Create(create => create.Action("EmployeeAccidentInsuranceClaimDepartments_Create", "EmployeeAccidentInsuranceClaimDepartments"))
        .Update(update => update.Action("EmployeeAccidentInsuranceClaimDepartments_Update", "EmployeeAccidentInsuranceClaimDepartments"))
        .Destroy(destroy => destroy.Action("EmployeeAccidentInsuranceClaimDepartments_Destroy", "EmployeeAccidentInsuranceClaimDepartments"))
    ).ClientDetailTemplateId("template")
)

