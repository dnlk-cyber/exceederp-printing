<script>
    function sendforapproval(e) {


        var row = $(e.target).closest("tr");
        var grid = $("#grid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.EmployeeAccidentId;


        if (id.length !== 0 )
        {

            $.ajax({
                url: '@Url.Action("SendForApproval", "EmployeeAccidentRequest")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                   // $("#OrgStructureId").val(r).trigger("change");;

                }



            });

        }
    }
</script>
