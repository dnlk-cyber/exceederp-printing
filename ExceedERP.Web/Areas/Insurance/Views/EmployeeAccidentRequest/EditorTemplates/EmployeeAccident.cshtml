<style type="text/css">
    .fontlookBlack9 {
        font-size: 9pt;
        color: black;
        font-family: Arial, Helvetica, sans-serif;
        background-color: #FFFFFF;
        position: relative;
    }
    div.k-edit-form-container {
        width: auto;
    }

    .row .col-sm-2 {
        width: 200px;
    }

    .my-class {
        margin-left: 10px;
    }

    .chkbx {
        pointer-events: none;
    }

    .customer-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-right: 5px;
    }
</style>
