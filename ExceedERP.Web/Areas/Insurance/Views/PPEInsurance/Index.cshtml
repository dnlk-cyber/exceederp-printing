@model ExceedERP.Core.Domain.FleetManagement.FleetRegistration.FleetInsurance
@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>PPE Insurance</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.FleetInsurance>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.InsuranceTypeId, (IEnumerable)ViewData["InsuranceType"], "InsuranceTypeId", "Name").Width(150);
          columns.ForeignKey(c => c.InsuranceCategoryId, (IEnumerable)ViewData["InsuranceCatagory"], "InsuranceCategoryId", "Name").Width(150);
          columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["Equipment"], "FleetsID", "EquipmentName").Width(150);
        
          columns.Bound(o => o.Description).Width(150);
          columns.Bound(o => o.City).Width(150);
          columns.Bound(o => o.DueDate).Width(150);
          columns.Bound(o => o.ExpireDate).Width(150);

          columns.Bound(o => o.InsuranceCompany).Width(150);
          columns.Bound(o => o.PremiumCost).Format("{0:d}").Width(150);
          columns.Bound(o => o.Status).Width(150);


          columns.Command(command =>
          {


              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);

              command.Destroy().Text(Resources.ActionButton_Cancel);

          }).Width(300);

      })
      // .ToolBar(commands => commands.Create())
      //.Events(ev =>
      //{
      //    ev.DataBound("onDataBound"); ev.DetailExpand("onDetailExpand");
      //})
      .Editable(editable =>
      {
          editable.Mode(GridEditMode.PopUp).TemplateName("Insurance");//.Window(x => x.Title("Accident Registration "));
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Accident");
      })
           .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                             .Scrollable(h => h.Height(500))
                                .ClientDetailTemplateId("template")
      .DataSource(dataSource => dataSource
          .Ajax()
          .ServerOperation(false)
          .Model(model =>
          {
              model.Id(p => p.FleetInsuranceID);

          })
                               .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
          .Create(update => update.Action("PPEInsurance_Create", "PPEInsurance"))
          .Read(read => read.Action("PPEInsurance_Read", "PPEInsurance"))
          .Update(update => update.Action("PPEInsurance_Update", "PPEInsurance"))
          .Destroy(update => update.Action("PPEInsurance_Destroy", "PPEInsurance"))
      ))

