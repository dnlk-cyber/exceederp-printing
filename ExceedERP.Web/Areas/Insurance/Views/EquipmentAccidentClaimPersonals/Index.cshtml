                    .Editable(editable => editable.Mode(GridEditMode.InLine))
                    .Scrollable(h => h.Height(500))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Events(events =>
                        {

                            events.Error("error_handler(\"MedicalExpenseRefundApprovalgrid_#=EquipmentAccidentClaimId#\")");
                            events.RequestStart("onRequestStart(\"MedicalExpenseRefundApprovalgrid_#=EquipmentAccidentClaimId#\")");
                            events.RequestEnd("onRequestEnd(\"MedicalExpenseRefundApprovalgrid_#=EquipmentAccidentClaimId#\")");




                        })
                        .Model(model =>
                        {
                            model.Id(p => p.AccidentInsuranceClaimApprovalId);



                        })
                        .Read(read => read.Action("MedicalExpenseRefundValidation_Read", "MedicalExpenseRefundValidation", new { id = "#=EquipmentAccidentClaimId#" }))
                        .Create(create => create.Action("MedicalExpenseRefundValidation_Create", "MedicalExpenseRefundValidation", new { id = "#=EquipmentAccidentClaimId#" }))
                        .Update(update => update.Action("MedicalExpenseRefundValidation_Update", "MedicalExpenseRefundValidation"))
                        .Destroy(destroy => destroy.Action("MedicalExpenseRefundValidation_Destroy", "MedicalExpenseRefundValidation"))
                    ).ToClientTemplate()

