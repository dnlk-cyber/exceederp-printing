@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .Name("ServiceProviderEmployeeId")
        .OptionLabel( Resources.Select)
        .DataTextField("FullNameaEnglish")
        .DataValueField("EmployeeId")
        .Filter("contains")
      .DataSource(dataSource =>
      {
          dataSource.Read(read => read.Action("GetActiveEmployees", "HRMDataProvider", new { area = "HRM" }).Data("filterAssignEmployees"))
              .ServerFiltering(false);
      })
         .ValuePrimitive( true)
)
