@section Scripts {
    <script>
        $(document).ready(function () {
            // Function to toggle visibility and disable state of related fields
            function toggleFieldsVisibility() {
                var isChecked = $('#IsCollissionWithAnotherVehicle').is(':checked');

                // Toggle visibility and disable state for related fields
                $('#CollidedOnerNameGroup, #CollidedAddressGroup, #CollidedPlateNoGroup, #CollidedPhoneGroup').each(function () {
                    $(this).toggle(!isChecked);
                    $('input, select', this).prop('disabled', isChecked);
                });
            }

            // Initial call to set initial state based on checkbox
            toggleFieldsVisibility();

            // Bind change event to checkbox
            $('#IsCollissionWithAnotherVehicle').change(function () {
                toggleFieldsVisibility();
            });
        });
    </script>
}

