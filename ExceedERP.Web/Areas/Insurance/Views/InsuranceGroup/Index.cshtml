@using System.Collections
@using ExceedERP.Core.Domain.Insurance
@using ExceedERP.Core.Localization 

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorHealthAndInsurance_InsuranceGroup</legend>
@(Html.Kendo().Grid<InsuranceGroup>()
          .Name("InsuranceGroupgrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.InsuranceCategoryId, (IEnumerable)ViewData["GroupName"], "InsuranceCategoryId", "Name").Width(200);

          //columns.Bound(c => c.GroupName).Width( 250);
          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["organization"], "OrgStructureId", "Name").EditorTemplateName("OrgSelector").Width(250);
          columns.Bound(c => c.JobTitleName).Width( 250);//, (IEnumerable)ViewData["jobTitle"], "OrgStructureId", "Name").EditorTemplateName("JobTitles").Width(150);
          columns.Bound(c => c.Remark).Width(100);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                  .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("InsuranceGroup").Window(window => { window.Title(@Resources.NavigatorHealthAndInsurance_InsuranceGroup); window.Scrollable(false); }))
        .Scrollable(h => h.Height(500))
                     .Groupable()
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                  .Filterable()
                     .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                   .Events(events =>
                   {

                       events.Error("error_handler(\"InsuranceGroupgrid\")");
                       events.RequestStart("onRequestStart(\"InsuranceGroupgrid\")");
                       events.RequestEnd("onRequestEnd(\"InsuranceGroupgrid\")");
                   })

          .Model(model => model.Id(p => p.InsuranceGroupId))
          .Read(read => read.Action("InsuranceGroup_Read", "InsuranceGroup"))
          .Create(create => create.Action("InsuranceGroup_Create", "InsuranceGroup"))
          .Update(update => update.Action("InsuranceGroup_Update", "InsuranceGroup"))
          .Destroy(destroy => destroy.Action("InsuranceGroup_Destroy", "InsuranceGroup"))
      )
)
