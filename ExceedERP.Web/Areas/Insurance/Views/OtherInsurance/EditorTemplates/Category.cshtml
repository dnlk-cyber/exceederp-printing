@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)






                            .DataTextField("Name")
                             .DataValueField("InsuranceCategoryId")
                             .CascadeFrom("InsuranceTypeId")
                             .OptionLabel(Resources.Select)
          .Filter("contains")
          .DataSource(dataSource =>
          {
              dataSource.Read(read => read.Action("GetInsuranceCategory", "HRMDataProvider", new { area = "HRM" }).Data("filterCategory"))
                  .ServerFiltering(true);
          })

                             .ValuePrimitive(true)
)
