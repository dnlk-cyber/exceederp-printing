@using System.Collections
@using ExceedERP.Core.Domain.Insurance
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorHealthAndInsurance_InsuranceCategory</legend>
@(Html.Kendo().Grid<InsuranceType>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["InsuranceType"], "LookupId", "Description");
              columns.Bound(c => c.InsuranceTypeGroup);
              columns.Bound(c => c.Remark);
              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
          .Groupable()
          .Sortable(sortable =>
          {
              sortable.SortMode(GridSortMode.SingleColumn);

          })
          .Filterable()
          .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Events(events =>
              {

                  events.Error("error_handler(\"grid\")");
                  events.RequestStart("onRequestStart(\"grid\")");
                  events.RequestEnd("onRequestEnd(\"grid\")");

              })

              .Model(model => model.Id(p => p.InsuranceTypeId))
              .Read(read => read.Action("InsuranceType_Read", "InsuranceType"))
              .Create(create => create.Action("InsuranceType_Create", "InsuranceType"))
              .Update(update => update.Action("InsuranceType_Update", "InsuranceType"))
              .Destroy(destroy => destroy.Action("InsuranceType_Destroy", "InsuranceType"))
              ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()                          
        .Name("tabstrip_#=InsuranceTypeId#")
        .SelectedIndex(0)
        .Items(items =>
        {
          items.Add().Text(Resources.NavigatorHealthAndInsurance_InsuranceCategory).Content(
            @<text>
                @(Html.Kendo().Grid<InsuranceCategory>()
                    .Name("InsuranceCategory#=InsuranceTypeId#")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.Name);
                        columns.Bound(c => c.Remark);
                        columns.Command(command =>
                        {
                            command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                            command.Destroy().Text(Resources.ActionButton_Cancel);
                        }).Width(200);


                    })
                    .ToolBar(toolbar =>
                    {
                        toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

                    })
                    .Editable(editable => editable.Mode(GridEditMode.InLine))
                    .Scrollable()
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Events(events =>
                        {

                            events.Error("error_handler(\"InsuranceCategory#=InsuranceTypeId#\")");
                            events.RequestStart("onRequestStart(\"InsuranceCategory#=InsuranceTypeId#\")");
                            events.RequestEnd("onRequestEnd(\"InsuranceCategory#=InsuranceTypeId#\")");


                        })
                        .Model(model => model.Id(p => p.InsuranceCategoryId))
                        .Read(read => read.Action("InsuranceCategory_Read", "InsuranceCategory", new { id = "#=InsuranceTypeId#" }))
                        .Create(create => create.Action("InsuranceCategory_Create", "InsuranceCategory", new { idTwo = "#=InsuranceTypeId#" }))
                        .Update(update => update.Action("InsuranceCategory_Update", "InsuranceCategory"))
                        .Destroy(destroy => destroy.Action("InsuranceCategory_Destroy", "InsuranceCategory"))

                        ).ToClientTemplate()
                        )

                    </text>);


        }).ToClientTemplate())
</script>

