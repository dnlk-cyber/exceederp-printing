@using System.Collections
@using ExceedERP.Core.Domain.Insurance
@using ExceedERP.Core.Localization 
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? true;
}

<legend>@Resources.NavigatorHealthAndInsurance_EmployeeInsurance</legend>
@(Html.Kendo().Grid<Insurance>()
      .Name("Insurancegrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.InsuranceId).Title("#").Width(80);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").Width(200)/*.EditorTemplateName("EmployeeLists")*/.Filterable(ftb => ftb.Multi(true).Search(true)).Width(170);
          columns.Bound(c => c.BirthDate).Width(160);
          columns.ForeignKey(c => c.InsuranceCategoryId, (IEnumerable)ViewData["InsuranceCatagory"], "InsuranceCategoryId", "Name").Width(150);


          if (useEthiopian)
          {
              columns.Bound(c => c.FromAmharic).Width(100);
              columns.Bound(c => c.ToAmharic).Width(100);
          }
          else
          {
              columns.Bound(c => c.From).Width(100);
              columns.Bound(c => c.To).Width(100);
          }
          columns.Bound(c => c.Number).Width(100);
          columns.Bound(c => c.Salary).Width(100);
          columns.Bound(c => c.SumofInsured).Width(120);
          columns.Bound(c => c.Premium).Width(100);
          columns.Command(command =>
          {

              if (HttpContext.Current.User.IsInRole("Insurance_User"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("Insurance_Admin"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("Insurance_User"))
          {

              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
      })

      .Editable(editable => editable.Mode(GridEditMode.PopUp)
      .TemplateName("Insurance").Window(window => {
          window.Title(Resources.NavigatorHealthAndInsurance_EmployeeInsurance);
          window.Scrollable(false); }))
      .Scrollable(h => h.Height(500))
      .Events(x => { x.Edit("GetDate");
          x.Save("GetDate");

      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(x=>x.Add(sort=>sort.InsuranceId).Descending())
          .Events(events =>
          {

              events.Error("error_handler(\"Insurancegrid\")");
              events.RequestStart("onRequestStart(\"Insurancegrid\")");
              events.RequestEnd("onRequestEnd(\"Insurancegrid\")");

          })

          .Model(model =>
          {
              model.Id(p => p.InsuranceId);
              // model.Field(p => p.Number).Editable(false);
              // model.Field(p => p.Salary).Editable(false);
              // model.Field(p => p.Premium).Editable(false);
              //model.Field(p => p.SumofInsured).Editable(false);
          })
          .Read(read => read.Action("Insurance_Read", "Insurance").Data("sendForgery"))
          .Create(create => create.Action("Insurance_Create", "Insurance").Data("sendForgery"))
          .Update(update => update.Action("Insurance_Update", "Insurance").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("Insurance_Destroy", "Insurance").Data("sendForgery"))
      )
)
