<script>
    function GetInsuranceDetail() {
        var InsuranceGroupIds = $("#InsuranceCategoryId").data("kendoDropDownList");
        var group = InsuranceGroupIds.value();
        //var Classes = $("#LookupId").data("kendoDropDownList");
        //var classe = Classes.value();
        $.ajax({
            url: '@Url.Action("GetInsuranceSalary", "Insurance")',

            data: { group: group },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                var filds = r.split(/-/);
                var sal = filds[0];
                var num = filds[1];
                var si = filds[2];
                //var pi = filds[2];
                $("#Number").val(num).trigger("change");
                //$("#Salary").val(sal).trigger("change");
                //$("#Number").trigger("change");
                //$("#Salary").trigger("change");

                //$("#SumofInsured").val(si);
                //$("#Salary").val(sal);
                //$("#Premium").val(pi);
                //$("#SumofInsured").val(si);
            }

        });
    }
    function onEmployeeChange() {
        var employeeId = $("#EmployeeId").data("kendoDropDownList");
        var empId = employeeId.value();
        //var Classes = $("#LookupId").data("kendoDropDownList");
        //var classe = Classes.value();
        $.ajax({
            url: '@Url.Action("GetEmployeeSalary", "Insurance")',

            data: { empId: empId },
            type: 'POST',
            cache: false,
            success: function (result) {
                var filds = result.split(/-/);
                var sal = filds[0];
                var sumInsured = filds[1];
                var Premium = filds[2];
                $("#Salary").val(sal).trigger("change");
                $("#Salary").trigger("change");

                $("#SumofInsured").val(sumInsured);
                $("#SumofInsured").trigger("change");

                $("#Premium").val(Premium);
                $("#Premium").trigger("change");
            }

        });
    }

</script>
<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#FromAmharic").trigger("change");
        $("#ToAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "Insurance")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
