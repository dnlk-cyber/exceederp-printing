@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.Insurance.EmployeeAccident 


<div class="form">
    <div class="row fullrow">
        <div class="col-md-3 ro1">
            <div class="form-group">


                <div>@Html.LabelFor(model => model.EmployeeId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.EmployeeId)
                          .OptionLabel(Resources.Select)
                          .Filter("contains")
                          .MinLength(2)
                          .DataTextField("FullNameWithOutCode")
                          .DataValueField("PersonId")
                          .DataSource(dataSource =>
                          {
                              // dataSource.Read(read => read.Action("GetDepartmentOfHeads", "HRMDataProvider", new { area = "HRM" }))
                              dataSource.Read(read => read.Action("GetEmployee", "HRMDataProvider"))
                                  .ServerFiltering(false);
                          })
                          .ValuePrimitive(true)

                    )
                    @Html.ValidationMessageFor(model => model.EmployeeId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
  

                <div>@Html.LabelFor(model => model.BranchId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.BranchId)
                          .OptionLabel(Resources.Select)
                          .Filter("contains")
                          .MinLength(2)
                          .DataTextField("Name")
                          .DataValueField("BranchId")
                          .DataSource(dataSource =>
                          {
                              // dataSource.Read(read => read.Action("GetDepartmentOfHeads", "HRMDataProvider", new { area = "HRM" }))
                              dataSource.Read(read => read.Action("GetBranches", "HRMDataProvider"))
                                  .ServerFiltering(false);
                          })
                          .ValuePrimitive(true)

                          )
                    @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger" })
                </div>
            </div>
        
            <div class="form-group">
                <div>@Html.LabelFor(model => model.OrgStructureId, htmlAttributes: new {@class = "control-label col-md-8"})</div>
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.OrgStructureId)
                          .OptionLabel(Resources.Select)
                          .Filter("contains")
                          .MinLength(2)
                          .DataTextField("Name")
                          .DataValueField("OrgStructureId")
                          .DataSource(dataSource =>
                          {
                              // dataSource.Read(read => read.Action("GetDepartmentOfHeads", "HRMDataProvider", new { area = "HRM" }))
                              dataSource.Read(read => read.Action("GetDepartments", "HRMDataProvider"))
                                  .ServerFiltering(false);
                          })
                          .ValuePrimitive(true)

                          )
                    @Html.ValidationMessageFor(model => model.OrgStructureId, "", new {@class = "text-danger"})
                </div>
            </div>
       

           
        </div>
        <div class="col-md-3 ro1">

            <div class="form-group">
                <div>@Html.LabelFor(model => model.LookupId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(m => m.LookupId)
                          .DataTextField("Description")
                          .DataValueField("LookupId")
                          .OptionLabel(Resources.Select)
                          //.Filter(FilterType.Contains)
                          .Filter("contains")
                          //.MinLength(2)
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read =>
                              {
                                  read.Action("GetJobTitles", "HRMDataProvider")
                                      .Data("filterCategories");
                              })
                                  .ServerFiltering(true);
                          }).ValuePrimitive(true)

                         

                          .CascadeFrom("OrgStructureId")
                          //.AutoBind(false)
                          // .Enable(false)
                    )
                    @Html.ValidationMessageFor(model => model.LookupId, "", new { @class = "text-danger" })
                </div>

            </div>

            <div class="form-group">
             
                    @Html.LabelFor(model => model.AccidentDateAmh, htmlAttributes: new { @class = "control-label col-md-8" })

                <div class="col-md-6">
                    @Html.TextBoxFor(model => model.AccidentDateAmh, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />

                    @Html.ValidationMessageFor(model => model.AccidentDateAmh, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @*@Html.LabelFor(model => model.IsAtWorkPlace, htmlAttributes: new { @class = "control-label col-md-8" })*@
                <div class="col-md-6">

                    @(Html.Kendo().CheckBoxFor(model => model.IsAtWorkPlace)
                            )
                    @Html.ValidationMessageFor(model => model.IsAtWorkPlace, "", new { @class = "text-danger" })
                </div>
            </div>
           
        </div>
        <div class="col-md-3 ro1">
            <div class="form-group">
                @*@Html.LabelFor(model => model.IsOnDuety, htmlAttributes: new { @class = "control-label col-md-8" })*@
                <div class="col-md-6">
                    @(Html.Kendo().CheckBoxFor(model => model.IsOnDuety)
                          )
                    @Html.ValidationMessageFor(model => model.IsOnDuety, "", new { @class = "text-danger" })
                </div>
            </div>
            <div></div>
            <div class="form-group">
                @Html.LabelFor(model => model.Witness, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().TextBoxFor(model => model.Witness)
                    )
                    @Html.ValidationMessageFor(model => model.Witness, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    </div>

