<legend> Employee Medical Expense Refund|| Personal </legend>
@(Html.Kendo().Grid<EmployeeMedicalExpenseRefund>()
    .Name("grid")
    .Columns(columns =>
    {

        columns.Bound(c => c.EmployeeMedicalExpenseRefundId).Title("#").Width(60);
        columns.ForeignKey(c => c.EmployeeId, (IEnumerable<EmployeeViewModel>)ViewData["personEmployees"], "EmployeeId", "FullName")
            .EditorTemplateName("ActiveEmployees")
            .Filterable(ftb => ftb.Multi(true).Search(true))
            .Width(160);

        columns.ForeignKey(c => c.OrgStructureId, (IEnumerable<OrgStructureViewModel>)ViewData["workUnit"], "OrgStructureId", "Name")
            .Filterable(ftb => ftb.Multi(true).Search(true))
            .Width(120);

        columns.ForeignKey(c => c.BranchId, (IEnumerable<BranchViewModel>)ViewData["branch"], "BranchId", "Name")
            .Filterable(ftb => ftb.Multi(true).Search(true))
            .Width(120);

        columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable<BusinessUnitViewModel>)ViewData["businessUnit"], "BusinessUnitId", "Name")
            .Filterable(ftb => ftb.Multi(true).Search(true))
            .Width(120);

        columns.Bound(c => c.ResponsibilityLevel)
            .Filterable(ftb => ftb.Multi(true).Search(true))
            .Width(140);

        columns.Bound(c => c.EmployementType)
            .Filterable(ftb => ftb.Multi(true).Search(true))
            .Width(140);
        columns.Bound(c => c.DateAm).EditorTemplateName("Calander").Width(130);
        columns.Bound(c => c.NumberOfDocument).Width(120);
        columns.Bound(c => c.AmountInBirr).Width(120);
        //columns.Bound(c => c.Remark).Width(120);
        //columns.Bound(c => c.TotalExpense).Width(130);
        //columns.Bound(c => c.Deduction).Width(130);
        //columns.Bound(c => c.ReasonForDeduction).Width(150);
        //columns.Bound(c => c.NetPay).Width(130);
        columns.Bound(c => c.Remark).Width(110);
        columns.Command(command =>
        {
            command.Edit().UpdateText("save").CancelText("Cancel").Text("Edit");
            command.Destroy().Text("Delete");

        }).Title("Action").Width(200);




    })
    .ToolBar(toolbar =>
    {
       // toolbar.Create();
    })
    //.Editable(editable => editable.Mode(GridEditMode.PopUp)
    //  .TemplateName("ServiceRequestTemplate")
    //  .Window(win => win.Title("General service works request form").Width(800)))
    .Editable(editable => editable.Mode(GridEditMode.InLine))
    .Pageable()
    .Filterable()
    .Events(ev =>
    {
        ev.DetailExpand("onDetailExpandUser");
        ev.DataBound("onDataBound");



    })
    .Scrollable(s => s.Height(550))
    .DataSource(dataSource => dataSource
        .Ajax()
        .Sort(sort=>sort.Add(x=>x.EmployeeMedicalExpenseRefundId).Descending())
        .Model(model =>
        {
            model.Id(p => p.EmployeeMedicalExpenseRefundId);
            model.Field(p => p.EmployeeMedicalExpenseRefundId).Editable(false);
            model.Field(p => p.EmployeeId).Editable(false);
            model.Field(p => p.BranchId).Editable(false);
            model.Field(p => p.BusinessUnitId).Editable(false);
            model.Field(p => p.OrgStructureId).Editable(false);
            model.Field(p => p.ResponsibilityLevel).Editable(false);
            model.Field(p => p.EmployementType).Editable(false);


        })
        .Events(ev => ev
        .Error("error_handler(\"grid\")")
        .RequestStart("onRequestStart(\"grid\")")
        .RequestEnd("onRequestEnd(\"grid\")"))
        .Read(read => read.Action("EmployeeMedicalExpenseRefundPersonals_Read", "EmployeeMedicalExpenseRefundPersonals"))
        .Create(create => create.Action("EmployeeMedicalExpenseRefundPersonals_Create", "EmployeeMedicalExpenseRefundPersonals"))
        .Update(update => update.Action("EmployeeMedicalExpenseRefundPersonals_Update", "EmployeeMedicalExpenseRefundPersonals"))
        .Destroy(destroy => destroy.Action("EmployeeMedicalExpenseRefundPersonals_Destroy", "EmployeeMedicalExpenseRefundPersonals"))
    ).ClientDetailTemplateId("template")
)

