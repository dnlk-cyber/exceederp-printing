                        <input type="hidden" name="masterId" id="masterId">
                        <div class="row">
                            <div class="col-md-10">
                                @Html.TextBox("file", "", new { type = "file", required = "true" })
                                <br />
                            </div>
                        </div>
                        <div>
                            <div class="editor-field">
                                <label>Description</label>
                                @Html.TextArea("Description", null, new { placeholder = "Description", style = "width: 90%; max-width: 90%;height:60%" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-7"></div>
                            <input type="submit" class="btn-primary k-button" value=" Submit " />
                        </div>

                    </form>
                    <div class="pull-right">

                    </div>
                    
            </div>
               
            </text>)
)
<script>
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.EmployeeMedicalExpenseRefundId;
        var gridName = "#MedicalExpenseRefundApprovalgrid_" + masterId;

        if (masterDataItem.IsDepartmentOnlineApproved) {
            $(gridName).find(".k-toolbar").show();
            $(".k-grid-top", gridName).show();
            $(".k-grid-edit", gridName).show();
            $(".k-grid-delete", gridName).hide();

        }
        if (masterDataItem.IsOnlineApproved) {
            $(gridName).find(".k-toolbar").hide(); //hide toolbar
            $(".k-grid-top", gridName).hide();
            $(".k-grid-edit", gridName).hide();
            $(".k-grid-delete", gridName).hide();

        }
        else {
            $(gridName).find(".k-toolbar").show(); //hide toolbar
            $(".k-grid-top", gridName).show();
            $(".k-grid-edit", gridName).show();
            $(".k-grid-delete", gridName).hide();

        }
    
    }

    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsDepartmentOnlineApproved) {

                row.find(".k-grid-delete").remove();
                $(".k-grid-top").show();

            }
            if (dataItem.IsOnlineApproved) {

                row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();
                $(".k-grid-top").show();

            }
            else {

                row.find(".k-grid-delete").remove();

            }


        }
    }
</script>
<script>
    function filterEmployees() {
        return {
            text: $("#EmployeeId").data("kendoDropDownList").filterInput.val(),
        }
    }

    function UploadFile(id) {
        $("#masterId").val(id);
        var wnd = $("#UploadDoc").data("kendoWindow");
        wnd.center().open();
    }
</script>
<script>
    function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApprovalRequest", "EmployeeMedicalExpenseRefundPersonals", new { area = "Insurance" })',
            data: { id: id },
            success: function(result) {
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            },
            error: function(result) {
                alert(result.Message);
            }
        });
    }
</script>
