        .Modal(true)
        .Draggable(true)
        .Width(400).Content(
        @<text>
            <div class="form-group">
                <form action="@Url.Action("UploadIncomingMedicalFiles", "AccidentCreditServiceAttachments", new { })" method="post" , new { enctype="multipart/form-data" }>
                    <input type="hidden" name="masterId" id="masterId">
                    <div class="row">
                        <div class="col-md-10">
                            @Html.TextBox("file", "", new { type = "file", required = "true" })
                            <br />
                        </div>
                    </div>
                    <div>
                        <div class="editor-field">
                            <label>Description</label>
                            @Html.TextArea("Description", null, new { placeholder = "Description", style = "width: 90%; max-width: 90%;height:60%" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-7"></div>
                        <input type="submit" class="btn-primary k-button" value=" Submit " />
                    </div>

                </form>
                <div class="pull-right">

                </div>
            </div>
        </text>)
)
<script>
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.EmployeeAccidentCreditServiceId;
        var gridName = "#MedicalExpenseRefundDepartmentApprovalgrid_" + masterId;
       // var gridNameMaster = "#grid";
       // $(".k-grid-top", gridName).hide();
       
        if (masterDataItem.IsDepartmentOnlineApproved) {
            $(gridName).find(".k-toolbar").hide();
           $(".k-grid-top", gridName).hide();
            $(".k-grid-edit", gridName).hide();
            $(".k-grid-delete", gridName).hide();
            
        }
        if (masterDataItem.IsOnlineApproved) {
            $(gridName).find(".k-toolbar").hide(); //hide toolbar
            $(".k-grid-top", gridName).hide();
            $(".k-grid-edit", gridName).hide();
            $(".k-grid-delete", gridName).hide();
          
        }
        else {
            $(gridName).find(".k-toolbar").show(); //hide toolbar
            $(".k-grid-top", gridName).show();
            $(".k-grid-edit", gridName).show();
            $(".k-grid-delete", gridName).hide();
            //$(".k-grid-edit", gridNameMaster).show();
            //$(".k-grid-delete", gridNameMaster).hide();
        }


    }

    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsDepartmentOnlineApproved ) {

                row.find(".k-grid-delete").remove();
                $(".k-grid-top").show();

            }
            if ( dataItem.IsOnlineApproved) {

                row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();
                $(".k-grid-top").show();

            }
            else {

                row.find(".k-grid-delete").remove();

            }


        }
    }



</script>
