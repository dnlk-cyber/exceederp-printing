<script>
    var planApprovalStatus = {
        draft: @((int)ExceedERP.Core.Domain.Planning.PlanApprovalStatus.Draft),
        departmentSubmitted: @((int)ExceedERP.Core.Domain.Planning.PlanApprovalStatus.DepartmentSubmitted),
        branchApproved: @((int)ExceedERP.Core.Domain.Planning.PlanApprovalStatus.BranchApproved),
        headOfficeApproved: @((int)ExceedERP.Core.Domain.Planning.PlanApprovalStatus.HeadOfficeApproved),
        revisionRequested: @((int)ExceedERP.Core.Domain.Planning.PlanApprovalStatus.RevisionRequested)
    };
    var isGlobalDepartnental = false;
    var masterId = 0;
    var isFirstLevel = false;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#PlanSelfcaregrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        isGlobalDepartnental = masterDataItem.IsDepartnental;
        masterId = masterDataItem.PlanId;


    }
    function onBSCPlanDetailExpand(e)
    {
        var masterRow = e.masterRow;

        var masterGrid = $("#Indicators_grid_" + masterId).data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);
        isFirstLevel = masterDataItem.IsFirstLevelApproved;


    }
    function onCancel(e) {
        //Implement the event handler for Cancel
    }

    function onEdit(e) {
        //Implement the event handler for Edit
    }

    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsDepartnental || isGlobalDepartnental) {
                $(row).css("background-color", "#7FFFD4");
                $(row).find(".k-grid-edit").show();
                $(row).find(".k-grid-delete").remove();

            }
        }
    }
    function onBSCPlanDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (!model.CanEdit) {
                $(this).find(".k-grid-edit").remove();
            }
            if (!model.CanDelete) {
                $(this).find(".k-grid-delete").remove();
            }
            if (!model.CanApprove) {
                $(this).find(".k-grid-cmd-Approve").remove();
            } else {
                var actionText = model.ApprovalStatus === planApprovalStatus.draft ||
                    model.ApprovalStatus === planApprovalStatus.revisionRequested ? "Submit" : "Approve";
                $(this).find(".k-grid-cmd-Approve")
                    .attr("title", model.ApprovalAction)
                    .html('<span class="fa fa-check"></span>' + actionText);
            }
            if (!model.CanRequestRevision) {
                $(this).find(".k-grid-cmd-Revision").remove();
            }
            if (!model.CanAddFeedback) {
                $(this).find(".k-grid-cmd-Feedback").remove();
            }
            if (!model.CanCopy) {
                $(this).find(".k-grid-cmd-Copy").remove();
            }
            if (model.ApprovalStatus === planApprovalStatus.headOfficeApproved) {
                $(this).css("background-color", "#dff0d8");
            }
            if (model.ApprovalStatus === planApprovalStatus.revisionRequested) {
                $(this).css("background-color", "#fcf8e3");
            }
        });
    }
    
    function uploadFile(id) {
        $("#subIndicatorId").val(id);
        var wnd = $("#UploadDoc").data("kendoWindow");
        wnd.center().open();
    }

</script>
