@using ExceedERP.Core.Localization
<legend>Self-Care Plan </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.Plan>()
          .Name("PlanSelfcaregrid")
          .Columns(columns =>
          {
              columns.Bound(c => c.PlanId).Title("S.N").Width(50).Filterable(false);
              columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["GlFiscalYears"], "GlFiscalYearId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(250);
              columns.Bound(c => c.Description).Width(250);
              columns.Bound(c => c.Reason).Width(300).HtmlAttributes(new { style = "white-space: normal; overflow-wrap: anywhere;" });
              columns.Command(command =>
              {
                  command.Edit();
                  //command.Destroy();
              });
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create();
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Pageable()
          .Filterable()
          .Scrollable(h => h.Height(700))
          .Events(events =>
          {
              events.Cancel("onCancel");
              events.Edit("onEdit");
              events.DataBound("onDataBound");
              events.DetailExpand("onDetailExpandUser");
          })
          .DataSource(dataSource => dataSource
              .Ajax()
              .Model(model => { model.Id(p => p.PlanId);
                  model.Field(p => p.PlanId).Editable(false);
                  model.Field(p => p.IsPersonal).Editable(false);
              })
              .Events(ev => ev
                            .Error("error_handler(\"PlanSelfcaregrid\")")
                            .RequestStart("onRequestStart(\"PlanSelfcaregrid\")")
                            .RequestEnd("onRequestEnd(\"PlanSelfcaregrid\")"))
              .Read(read => read.Action("PlanSelfCares_Read", "PlanSelfCares").Data("sendForgery"))
              .Create(create => create.Action("PlanSelfCares_Create", "PlanSelfCares").Data("sendForgery"))
              .Update(update => update.Action("PlanSelfCares_Update", "PlanSelfCares").Data("sendForgery"))
              .Destroy(destroy => destroy.Action("PlanSelfCares_Destroy", "PlanSelfCares").Data("sendForgery"))
          ).ClientDetailTemplateId("self_care_detail_template")
)
<script type="text/kendo-template" id="self_care_detail_template">
    @(Html.Kendo().TabStrip()
                .Name("tab_str_#=PlanId#")
                .SelectedIndex(0)
                .Items(items =>
                {
                items.Add().Text("Objective").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.BSCPlan>()
                        .Name("Indicators_grid_#=PlanId#")
                        .Columns(columns =>
                        {
                                    columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["departmentLists"], "OrgStructureId", "Name").EditorTemplateName("workUnit").Filterable(ftb => ftb.Multi(true).Search(true)).Width(300);

                                    columns.ForeignKey(c => c.ObjectiveId, (IEnumerable)ViewData["Objectives"], "ObjectiveId", "Name").EditorTemplateName("objectives").Filterable(ftb => ftb.Multi(true).Search(true)).Width(400);
                                    columns.Bound(c => c.BranchName).Title("Branch").Width(180);
                                    columns.Bound(c => c.ApprovalStatusText).Title("Approval Status").Width(180);
                                    columns.Bound(c => c.SubmittedBy).Title("Submitted By").Width(180).Hidden();
                                    columns.Bound(c => c.SubmittedTime).Title("Submitted On").Format("{0:yyyy-MM-dd HH:mm}").Width(150).Hidden();
                                    columns.Bound(c => c.BranchApprovedBy).Title("Branch Approved By").Width(180).Hidden();
                                    columns.Bound(c => c.BranchApprovedTime).Title("Branch Approved On").Format("{0:yyyy-MM-dd HH:mm}").Width(150).Hidden();
                                    columns.Bound(c => c.HeadOfficeApprovedBy).Title("Head Office Approved By").Width(180).Hidden();
                                    columns.Bound(c => c.HeadOfficeApprovedTime).Title("Head Office Approved On").Format("{0:yyyy-MM-dd HH:mm}").Width(150).Hidden();

                                    columns.Command(command =>
                                    {
                                        command.Edit();
                                        command.Custom("cmd-Approve").Text("Submit / Approve").IconClass("fa fa-check").Click("ApprovePlan").HtmlAttributes(new { @class = "btn btn-success" });
                                        command.Custom("cmd-Feedback").Text("Add Feedback").IconClass("fa fa-comment").Click("addPlanFeedback").HtmlAttributes(new { @class = "btn btn-primary" });
                                        command.Custom("cmd-Revision").Text("Request Revision").IconClass("fa fa-undo").Click("requestPlanRevision").HtmlAttributes(new { @class = "btn btn-warning" });
                                        command.Custom("cmd-Copy").Text("Aggregate").IconClass("fa fa-copy").Click("copyPlan").HtmlAttributes(new { @class = "btn btn-info" });

                                        command.Destroy();
                                    });
                                })
                                .ToolBar(toolbar =>
                                {
                                    if (ViewBag.CanCreateDepartmentPlan == true)
                                    {
                                        toolbar.Create();
                                    }
                                })
                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .Pageable()
                                .Filterable()
                                .Scrollable(h => h.Height(680))
                                .Events(events =>
                                {
                                    events.Cancel("onCancel");
                                    events.Edit("onEdit");
                                    events.DataBound("onBSCPlanDataBound");
                                    events.DetailExpand("onBSCPlanDetailExpand");
                                })
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Model(model =>
                                    {
                                        model.Id(p => p.BSCPlanId);
                                        model.Field(p => p.BranchName).Editable(false);
                                        model.Field(p => p.ApprovalStatusText).Editable(false);
                                        model.Field(p => p.ApprovalStatus).Editable(false);
                                        model.Field(p => p.SubmittedBy).Editable(false);
                                        model.Field(p => p.SubmittedTime).Editable(false);
                                        model.Field(p => p.BranchApprovedBy).Editable(false);
                                        model.Field(p => p.BranchApprovedTime).Editable(false);
                                        model.Field(p => p.HeadOfficeApprovedBy).Editable(false);
                                        model.Field(p => p.HeadOfficeApprovedTime).Editable(false);
                                    })
                                    .Events(ev => ev
                                                .Error("error_handler(\"Indicators_grid_#=PlanId#\")")
                                                .RequestStart("onRequestStart(\"Indicators_grid_#=PlanId#\")")
                                                .RequestEnd("onRequestEnd(\"Indicators_grid_#=PlanId#\")"))
                                    .Read(read => read.Action("BSCPlanSelfCares_Read", "BSCPlanSelfCares", new { id = "#=PlanId#" }).Data("sendForgery"))
                                    .Create(create => create.Action("BSCPlanSelfCares_Create", "BSCPlanSelfCares", new { id = "#=PlanId#" }).Data("sendForgery"))
                                    .Update(update => update.Action("BSCPlanSelfCares_Update", "BSCPlanSelfCares").Data("sendForgery"))
                                    .Destroy(destroy => destroy.Action("BSCPlanSelfCares_Destroy", "BSCPlanSelfCares").Data("sendForgery"))
                                ).ClientDetailTemplateId("Planning_detail_template")
                                .ToClientTemplate()

                    )


                </text>);

                items.Add().Text("Feedback").Content(@<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.PlanApprovalFeedback>()
                        .Name("Plan_Feedback_grid_#=PlanId#")
                        .Columns(columns =>
                        {
                            columns.Bound(c => c.ActionTime).Title("Date").Format("{0:yyyy-MM-dd HH:mm}").Width(150);
                            columns.Bound(c => c.WorkUnitName).Title("Work Unit").Width(220);
                            columns.Bound(c => c.BranchName).Title("Branch").Width(180);
                            columns.Bound(c => c.ObjectiveName).Title("Objective").Width(280);
                            columns.Bound(c => c.ActionText).Title("Action").Width(150);
                            columns.Bound(c => c.FromStatusText).Title("From").Width(160);
                            columns.Bound(c => c.ToStatusText).Title("To").Width(160);
                            columns.Bound(c => c.Feedback).Title("Feedback").Width(350);
                            columns.Bound(c => c.ActionBy).Title("Action By").Width(180);
                        })
                        .Pageable()
                        .Sortable()
                        .Scrollable(h => h.Height(680))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Model(model => model.Id(p => p.PlanApprovalFeedbackId))
                            .Read(read => read.Action("PlanFeedbacks_Read", "BSCPlanSelfCares", new { planId = "#=PlanId#" }))
                        )
                        .ToClientTemplate()
                    )
                </text>);

                }).ToClientTemplate()
    )
</script>
