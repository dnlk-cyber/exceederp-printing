<script>
    function ApprovePlan(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var feedback = window.prompt((dataItem.ApprovalAction || "Submit / Approve") + "\n\nOptional comment:", "");
        if (feedback === null) {
            return;
        }
        if (feedback.length > 2000) {
            alert("Feedback cannot exceed 2000 characters.");
            return;
        }
          $.ajax({
            type: "POST",
              url: '@Url.Action("ApproveBScPlan", "BSCPlanSelfCares", new { area = "Planning" })',
              data: $.extend({ id: dataItem.BSCPlanId, feedback: feedback }, sendForgery()),
              success: function (result)
              {
                  alert(result.Message);
                  if (result.Status === "OK") {
                      location.reload(true);
                  }
              },
            error: function (result) {
                alert(result.Message);
            }
        });

    }
    function requestPlanRevision(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var feedback = window.prompt("Describe the changes required before this plan can be approved:", "");
        if (feedback === null) {
            return;
        }
        feedback = $.trim(feedback);
        if (!feedback) {
            alert("Feedback is required when requesting a revision.");
            return;
        }
        if (feedback.length > 2000) {
            alert("Feedback cannot exceed 2000 characters.");
            return;
        }

        $.ajax({
            type: "POST",
            url: '@Url.Action("RequestPlanRevision", "BSCPlanSelfCares", new { area = "Planning" })',
            data: $.extend({ id: dataItem.BSCPlanId, feedback: feedback }, sendForgery()),
            success: function (result) {
                alert(result.Message);
                if (result.Status === "OK") {
                    location.reload(true);
                }
            },
            error: function (result) {
                alert(result.Message || "The revision request could not be completed.");
            }
        });
    }
    function addPlanFeedback(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var feedback = window.prompt("Enter feedback for this plan:", "");
        if (feedback === null) {
            return;
        }
        feedback = $.trim(feedback);
        if (!feedback) {
            alert("Feedback is required.");
            return;
        }
        if (feedback.length > 2000) {
            alert("Feedback cannot exceed 2000 characters.");
            return;
        }

        $.ajax({
            type: "POST",
            url: '@Url.Action("AddPlanFeedback", "BSCPlanSelfCares", new { area = "Planning" })',
            data: $.extend({ id: dataItem.BSCPlanId, feedback: feedback }, sendForgery()),
            success: function (result) {
                alert(result.Message);
                if (result.Status === "OK") {
                    location.reload(true);
                }
            },
            error: function (result) {
                alert(result.Message || "The feedback could not be saved.");
            }
        });
    }
    function copyPlan(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var grid = this;
          $.ajax({
            type: "POST",
              url: '@Url.Action("CopyBScPlan", "BSCPlanSelfCares", new { area = "Planning" })',
              data: $.extend({ bscPlanId: dataItem.BSCPlanId }, sendForgery()),
              success: function (result)
              {
                console.log(result);
                  alert(result.Message);
                  location.reload(true);
              },
            error: function (result) {
                alert(result.Message);
            }
        });

    }
</script>
