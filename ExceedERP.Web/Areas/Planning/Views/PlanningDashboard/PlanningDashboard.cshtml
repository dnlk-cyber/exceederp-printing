@using ExceedERP.Core.Localization

@model ExceedERP.Core.Domain.E_Parilament.EPMSDashboardViewModel
@{
    ViewBag.Title = Resources.Ecabinet_DashBoard_E_Cabinet_Dashboard;
}
<div class="content-wrapper">
