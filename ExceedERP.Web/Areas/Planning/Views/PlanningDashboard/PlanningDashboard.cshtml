                                <h3><label id="todaterejectedAgendas"> </label><small>  @Resources.Ecabinet_DashBoard_Rejected_Agenda</small></h3>
                                <p>@Resources.Ecabinet_DashBoard_Approved_and_Rejected_Agendas</p>
                            </div>
                            <div class="icon">
                                <i class="fa fa-check-square"></i>
                            </div>
                            <a href="#" class="small-box-footer">@Resources.Ecabinet_DashBoard_More_info <i class="fa fa-arrow-circle-right"></i></a>
                        </div>
                    </div>
                    <div class="col-sm-4 col-xs-12">
                        <div class="small-box bg-aqua">
                            <div class="inner">
                                @*<h3>@Model.TodateCreditSales.AmountStr<small>ETB</small></h3>*@
                                @*<h3><label id="todateCreditSales"> </label><small>Agenda</small></h3>*@
