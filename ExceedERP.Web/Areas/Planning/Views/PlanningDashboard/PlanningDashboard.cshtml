                                <h3><label id="todateDecided"> </label><small>    @Resources.Ecabinet_DashBoard_Decided_Agenda</small></h3>
                                <p>  @Resources.Ecabinet_DashBoard_On_meeting_and_Decided_Agenda</p>
                            </div>
                            <div class="icon">
                                <i class="fa fa-meetup"></i>
                            </div>
                            <a href="#" class="small-box-footer">@Resources.Ecabinet_DashBoard_More_info <i class="fa fa-arrow-circle-right"></i></a>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-4 chartcontainer">
                        <div class="k-content wide">
                            @*<canvas class="custom-canvas" id="todateTotalSalesBranchDistributionChart" width="400" height="400"></canvas>*@
                            <canvas class="custom-canvas" id="todateTotalAgendaDistributionChart" width="400" height="400"></canvas>
                        </div>
                    </div>
                    <div class="col-sm-4 chartcontainer">
                        <div class="k-content wide">
