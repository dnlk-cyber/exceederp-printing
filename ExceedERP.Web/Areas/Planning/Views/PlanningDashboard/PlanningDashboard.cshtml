    ////function addTotalTodateSalesBranchDistributionToChartArea()
    function addTotalTodateAgendaDistributionToChartArea() {
        $.ajax({
            @*url: '@Url.Action("GetTodateTotalSalesAmount", "ECabinetDashboard", new { area = "EPMS" })',*@
            url: '@Url.Action("GetTodateTotalAgendas", "ECabinetDashboard", new { area = "EPMS" })',
            type: 'POST',
            cache: false,
            success: function (result) {
                //$("#todateTotalSales").text(result);
                $("#todateTotalAgenda").text(result.Agenda);
                $("#todateApprovedAgendas").text(result.ApprovedAgenda);
                $("#todaterejectedAgendas").text(result.RejectedAgenda);
                $("#todateOnMeeting").text(result.AssignedAgenda);
                $("#todateDecided").text(result.DecidedAgenda);
            }
        });
        $.ajax({
            type: "GET",
            @*url: '@Url.Action("GetTodateTotalSalesData", "ECabinetDashboard", new {area = "EPMS" })',*@
            url: '@Url.Action("GetTodateTotalAgendasData", "ECabinetDashboard", new {area = "EPMS" })',
            success: function (result) {
                //var ctx = document.getElementById("todateTotalSalesBranchDistributionChart").getContext('2d');
                var ctx = document.getElementById("todateTotalAgendaDistributionChart").getContext('2d');
                var myChart = new Chart(ctx, {
                    type: 'pie',
                    data: {
                        labels: result.labels,
                        datasets: [{
                            //label: 'Branch',
                            //data: result.Amounts,
                            label: 'Comittes',
                            data: result.datas,
                            backgroundColor: [
                                window.chartColors.green,
                                window.chartColors.orange,
                                window.chartColors.blue,
                                window.chartColors.purple,
                                window.chartColors.yellow,
                                window.chartColors.aqua,
                                window.chartColors.violet,
                                window.chartColors.brown,
                                window.chartColors.indigo,
                                window.chartColors.olive,
                                window.chartColors.lemon,
                                window.chartColors.redwood,
                                window.chartColors.mulberry,
                                window.chartColors.yale,
                                window.chartColors.red,
                                window.chartColors.grey
                            ],
                            borderColor: [
                                window.chartColors.green,
                                window.chartColors.orange,
                                window.chartColors.blue,
                                window.chartColors.purple,
                                window.chartColors.yellow,
                                window.chartColors.aqua,
                                window.chartColors.violet,
                                window.chartColors.brown,
                                window.chartColors.indigo,
                                window.chartColors.olive,
                                window.chartColors.lemon,
                                window.chartColors.redwood,
                                window.chartColors.mulberry,
                                window.chartColors.yale,
                                window.chartColors.red,
                                window.chartColors.grey
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {

                        title: {
                            display: true,
                            //text: 'Total Sales by Branch'
                            text: 'Total Agenda Assigned to Committee '
                        },
                        gridLines: {
                            display: false
                        },
                        pieceLabel: {
                            render: 'percentage',
                            fontColor: ['green', 'white', 'red'],
                            precision: 2,
                            textShadow: true,
                        },
                        legend: {
                            position: 'bottom',
                            fontSize: 8,
                            fullWidth: true,
                            padding: 6
                        }
                    }
                });

            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
    function addApprovedAgendasDistributionToChartArea() {
        $.ajax({
            @*url: '@Url.Action("GetTodateCashSalesAmount", "ECabinetDashboard", new { area = "EPMS" })',*@
            url: '@Url.Action("GetTodateTotalAgendas", "ECabinetDashboard", new { area = "EPMS" })',
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#todateApprovedAgendas").text(result.ApprovedAgenda);
            }
        });
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetMeetindDateWithAgendas", "ECabinetDashboard", new {area = "EPMS" })',
            success: function (result) {
                var ctx = document.getElementById("todateMeetingAndAgendasDistributionChart").getContext('2d');
                var myChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: result.labels,
                        datasets: [{
                            label: 'Agenndas',
                            data: result.datas,
                            backgroundColor: [
                                window.chartColors.green,
                                window.chartColors.orange,
                                window.chartColors.blue,
                                window.chartColors.purple,
                                window.chartColors.yellow,
                                window.chartColors.aqua,
                                window.chartColors.violet,
                                window.chartColors.brown,
                                window.chartColors.indigo,
                                window.chartColors.olive,
                                window.chartColors.lemon,
                                window.chartColors.redwood,
                                window.chartColors.mulberry,
                                window.chartColors.yale,
                                window.chartColors.red,
                                window.chartColors.grey
                            ],
                            borderColor: [
                                window.chartColors.green,
                                window.chartColors.orange,
                                window.chartColors.blue,
                                window.chartColors.purple,
                                window.chartColors.yellow,
                                window.chartColors.aqua,
                                window.chartColors.violet,
                                window.chartColors.brown,
                                window.chartColors.indigo,
                                window.chartColors.olive,
                                window.chartColors.lemon,
                                window.chartColors.redwood,
                                window.chartColors.mulberry,
                                window.chartColors.yale,
                                window.chartColors.red,
                                window.chartColors.grey
                            ],
                            borderWidth: 1
                        }]
                    },


                    options: {
                        scales: {
                            yAxes: [{ ticks: {fixedStepSize:1}}],
                        },
                        title: {
                            display: true,
                            text: 'Agendas By Meeting Date'
                        },
                        gridLines: {
                            display: false
                        },
                        pieceLabel: {
                            render: 'percentage',
                            fontColor: ['green', 'white', 'red'],
                            precision: 1,
                            textShadow: true,
                        },
                        legend: {
                            position: 'bottom',
                            fontSize: 8,
                            fullWidth: true,
                            padding: 6
                        }
                    }
                });

            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
