                                     title="Collapse">
                                 <i class="fa fa-minus"></i>
                             </button>

                    </div>
                *@
            </div>
            <div class="box-body">
                <div class="row">
                    <div class="col-sm-4 col-xs-12">
                        <div class="small-box bg-green">
                            <div class="inner">
                                @*<h3>@Model.TodateTotalSales.AmountStr<small>ETB</small></h3>*@
                                @*<h3><label id="todateTotalSales"> </label><small>Agenda</small></h3>*@
                                <h3><label id="todateTotalAgenda"> </label><small>  @Resources.Ecabinet_DashBoard_Total_Agendas</small></h3>
                                <h3><label id="todateTotalAgenda"> </label><small>  @Resources.Ecabinet_DashBoard_Total_Agendas</small></h3>
                                <p>@Resources.Ecabinet_DashBoard_Total_Agendas</p>
                                @*<hr />
                                    <p>Total Cost = <strong>@Model.TotalProjectsDisplay.TotalCost</strong></p>*@
                            </div>
                            <div class="icon">
                                <i class="fa fa-info-circle"></i>
                            </div>
                            <a href="#" class="small-box-footer">@Resources.Ecabinet_DashBoard_More_info <i class="fa fa-arrow-circle-right"></i></a>
                            @*<a href="/Projects/List?ps=@NGODBConstants.AllProjects" class="small-box-footer">More info <i class="fa fa-arrow-circle-right"></i></a>*@
                        </div>
                    </div>
                    <div class="col-sm-4 col-xs-12">
                        <div class="small-box bg-orange">
                            <div class="inner">
                                @*<h3>@Model.TodateCashSales.AmountStr<small>ETB</small></h3>*@
                                @*<h3><label id="todateCashSales"> </label><small>Agenda</small></h3>*@
