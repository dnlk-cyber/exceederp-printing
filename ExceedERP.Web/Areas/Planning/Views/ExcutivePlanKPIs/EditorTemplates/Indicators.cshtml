
@(Html.Kendo().DropDownListFor(m => m)
            .OptionLabel("Select")
            .DataTextField("Name")
            .DataValueField("IndicatorId")
            .HtmlAttributes(new { style = "width: 300px;" })
            .DataSource(dataSource =>
            {
                dataSource.Read(read => read.Action("GetIndicators", "PlanningDataProvider", new { Area = "Planning" }))
                    .ServerFiltering(false);
            })
            .Filter("contains")
            .MinLength(2)
            .ValuePrimitive(true)
            )
                  
 

    