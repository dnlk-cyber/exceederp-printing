
@(Html.Kendo().DropDownListFor(m => m)
            .OptionLabel("Select")
            .DataTextField("Name")
            .DataValueField("IndicatorId")
            .HtmlAttributes(new { style = "width: 300px;" })
            .BindTo((System.Collections.IEnumerable)ViewData["Indicators"])
            .Filter("contains")
            .ValuePrimitive(true)
            )
                  
 

    