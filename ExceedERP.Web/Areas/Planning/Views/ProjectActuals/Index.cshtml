</script>

@helper projectActualDetail()
{

    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.Project.ProjectMonthlyActual>()
              .Name("project_monthly_actual_grid#=ProjectActualId#")
              .Columns(columns =>
              {
                  columns.ForeignKey(c => c.GLPeriodId,(IEnumerable)ViewData["periods"], "GLPeriodId", "period").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                  columns.Bound(c => c.PlanValue).Width(150);
                  columns.Bound(c => c.ActualValue).Width(150);
                  columns.Command(command => { command.Edit(); });
              })

              .Editable(editable => editable.Mode(GridEditMode.InLine))
              .Pageable()
              .Filterable()
              .Scrollable(h=>h.Height(500))
              .DataSource(dataSource => dataSource
                  .Ajax()
                  .Model(
                      model => { model.Id(p => p.ProjectMonthlyActualId);
                      model.Field(p => p.GLPeriodId).Editable(false);
                      model.Field(p => p.PlanValue).Editable(false);
                      })
                  .Events(ev => ev
                            .Error("error_handler(\"project_monthly_actual_grid#=ProjectActualId#\")")
                            .RequestStart("onRequestStart(\"project_monthly_actual_grid#=ProjectActualId#\")")
                            .RequestEnd("onRequestEnd(\"project_monthly_actual_grid#=ProjectActualId#\")"))
                  .Read(read => read.Action("ProjectMonthlyActuals_Read", "ProjectMonthlyActuals",new { aId = "#=ProjectActualId#" }).Data("sendForgery"))
                  .Create(create => create.Action("ProjectMonthlyActuals_Create", "ProjectMonthlyActuals", new { aId = "#=ProjectActualId#" }).Data("sendForgery"))
                  .Update(update => update.Action("ProjectMonthlyActuals_Update", "ProjectMonthlyActuals").Data("sendForgery"))
                  .Destroy(destroy => destroy.Action("ProjectMonthlyActuals_Destroy", "ProjectMonthlyActuals").Data("sendForgery"))
              ).ClientDetailTemplateId("project_weekly_actual_details")
              .ToClientTemplate()
    )

}
<script type="text/kendo-template" id="project_weekly_actual_details">
    @(Html.Kendo().TabStrip()
        .Name("tab_str_project_weekly_Actual_#=ProjectMonthlyActualId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Project Weekly Actual").Content(
            @<text>
               
            @(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.Project.ProjectWeeklyActual>()
                  .Name("Project_Weekly_Actual_grid#=ProjectMonthlyActualId#")
                  .Columns(columns =>
                  {
                    columns.Bound(c => c.WeekOne).Width(110);
                    columns.Bound(c => c.WeekTwo).Width(110);
                    columns.Bound(c => c.WeekThree).Width(130);
                    columns.Bound(c => c.WeekFour).Width(130);
                    columns.Command(command => { command.Edit(); command.Destroy(); });
                  })
                  .ToolBar(toolbar => {
                        toolbar.Create();
                  })
                  .Editable(editable => editable.Mode(GridEditMode.InLine))
                  .Pageable()
                  .Filterable()
                  .Scrollable(h=>h.Height(500))
                  .DataSource(dataSource => dataSource
                      .Ajax()
                      .Model(model => model.Id(p => p.ProjectWeeklyActualId))
                      .Read(read => read.Action("ProjectWeeklyActuals_Read", "ProjectWeeklyActuals", new { wId = "#=ProjectMonthlyActualId#" }).Data("sendForgery"))
                      .Create(create => create.Action("ProjectWeeklyActuals_Create", "ProjectWeeklyActuals", new { wId = "#=ProjectMonthlyActualId#" }).Data("sendForgery"))
                      .Update(update => update.Action("ProjectWeeklyActuals_Update", "ProjectWeeklyActuals").Data("sendForgery"))
                      .Destroy(destroy => destroy.Action("ProjectWeeklyActuals_Destroy", "ProjectWeeklyActuals").Data("sendForgery"))
                  ).ToClientTemplate()
            )


            </text>);

        }).ToClientTemplate()
    )
</script>
@(Html.Kendo().Window()
    .Name("UploadDoc")
    .Title("Add File")
    .Visible(false)
    .Modal(true)
    .Draggable(true)
    .Width(400).Content(@<text><div class="form-group">
            <form action="@Url.Action("UploadProjectActualDocument", "ProjectActuals", new { })" method="post" , new { enctype="multipart/form-data" }>
                <input type="hidden" name="projectActualId" id="projectActualId">
                <div class="row">
                    <div class="col-md-10">
                        @Html.TextBox("file", "", new { type = "file", required = "true" })
                        <br />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-10">
                        @Html.TextBox("txtValue", null, new { placeholder = Resources.Common_Attachment_FileName })
                        <br />
                    </div>
                </div>
                <div>
                </div>
                <div class="row">
                    <div class="col-lg-7"></div>
                    <input type="submit" class="btn-primary k-button" value="submit" />
                </div>
            </form>
            <div class="pull-right"></div>
        </div>
    </text>)
)
@(Html.Kendo().Window()
    .Name("PlanUploadDoc")
    .Title("Add Plan File")
    .Visible(false)
    .Modal(true)
    .Draggable(true)
    .Width(400).Content(@<text><div class="form-group">
            <form action="@Url.Action("PlanAttachment_Create", "ProjectActuals")" method="post" enctype="multipart/form-data">
                <input type="hidden" name="projectActualId" id="planProjectActualId">
                <div class="row"><div class="col-md-10">@Html.TextBox("file", "", new { type = "file", required = "true" })<br /></div></div>
                <div class="row"><div class="col-md-10">@Html.TextBox("txtValue", null, new { placeholder = Resources.Common_Attachment_FileName })<br /></div></div>
                <div class="row"><div class="col-lg-7"></div><input type="submit" class="btn-primary k-button" value="submit" /></div>
            </form>
        </div>
    </text>)
)
<script>

    function onCancelActual(e) {
        //Implement the event handler for Cancel
        e.sender.dataSource.cancelChanges();
        e.preventDefault();
        e.sender.refresh();
    }

    function onEditActual(e) {
       

    }
    function uploadFile(id) {
        $("#projectActualId").val(id);
        var wnd = $("#UploadDoc").data("kendoWindow");
        wnd.center().open();
    }

    function uploadPlanFile(id) {
        $("#planProjectActualId").val(id);
        $("#PlanUploadDoc").data("kendoWindow").center().open();
    }

 
</script>
<style>
    div.k-edit-form-container {
        width: auto;
    }

    .row .col-sm-2 {
        width: 200px;
