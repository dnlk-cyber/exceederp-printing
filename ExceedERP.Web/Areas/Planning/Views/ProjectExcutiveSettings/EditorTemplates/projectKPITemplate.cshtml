
    <div class="row my-class">
        <div class="col-sm-2">
            <div class="form-group">
                <div>
                    @(Html.Kendo().DropDownListFor(m => m)
                                    .OptionLabel("Select")
                                    .DataTextField("Name")
                                    .DataValueField("ProjectKPIId")
                                    .DataSource(dataSource =>
                                    {
                                        dataSource.Read(read => read.Action("GetProjectKPIs", "PlanningDataProvider", new { Area = "Planning" }))
                                            .ServerFiltering(false);
                                    })
                                    .Filter("contains")
                                    .MinLength(2)
                                    .ValuePrimitive(true)
                    )

                </div>

            </div>
        </div>


    </div>

  
       

    