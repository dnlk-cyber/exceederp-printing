<legend> Self-Care - Project Plan</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.Project.ProjectPlan>()
              .Name("grid")
              .Columns(columns =>
              {
                  columns.Bound(c => c.ProjectPlanId).Title("S.N").Filterable(false).Width(60);
                  columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["FiscalYears"], "GlFiscalYearId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
                  columns.ForeignKey(c => c.ProjectInformationId, (IEnumerable)ViewData["projects"], "ProjectInformationId", "ProjectName").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
                  columns.ForeignKey(c => c.ProjectObjectiveId, (IEnumerable)ViewData["projectObjective"], "ProjectObjectiveId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
                  columns.ForeignKey(c => c.ProjectKPIId, (IEnumerable)ViewData["projectKpIs"], "ProjectKPIId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
                  columns.ForeignKey(c => c.ProjectSubKPIId, (IEnumerable)ViewData["projectSubKpIs"], "ProjectSubKPIId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
                  columns.Bound(c => c.Baseline).Width(90);
                  columns.Bound(c => c.Plan).Width(100);
                  columns.Bound(c => c.Target).Width(90);
                  columns.Bound(c => c.ToDate).Width(100);
                  columns.Bound(c => c.Description).Width(120);
                  columns.Command(command => { command.Edit(); command.Destroy(); }).Width(200);

              })
                .ToolBar(toolbar =>
                {
                    toolbar.Create();
                })
               .Editable(editable =>
               {
                   editable.Mode(GridEditMode.PopUp);
                   editable.TemplateName("projectPlanTemplate");
                   editable.Window(window =>
                   {
                       window.Title("Project Plan Form");
                       window.Draggable(false);
                       window.Scrollable(false);
                       //window.Width(520);
                   });
               })
              .Pageable()
              .Filterable()
              .Scrollable(h => h.Height(550))
              .Events(events =>
              {
                  events.Cancel("onCancelPlan");
                  events.Edit("onEditPlan");
              })
              .DataSource(dataSource => dataSource
                  .Ajax()
                  .Sort(s=>s.Add(x=>x.ProjectPlanId).Descending())
                  .Group(x => x.Add(p => p.GlFiscalYearId))
                  .Model(model => { model.Id(p => p.ProjectPlanId);
                      model.Field(p => p.ProjectPlanId).Editable(false);
                  })
                  .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
                  .Read(read => read.Action("ProjectPlanSelfCares_Read", "ProjectPlanSelfCares"))
                  .Create(create => create.Action("ProjectPlanSelfCares_Create", "ProjectPlanSelfCares"))
                  .Update(update => update.Action("ProjectPlanSelfCares_Update", "ProjectPlanSelfCares"))
                  .Destroy(destroy => destroy.Action("ProjectPlanSelfCares_Destroy", "ProjectPlanSelfCares"))
              ).ClientDetailTemplateId("project_Plan_Self_details")
)

<script type="text/kendo-template" id="project_Plan_Self_details">
    @(Html.Kendo().TabStrip()
                    .Name("selftab_str_#=ProjectPlanId#")
                    .SelectedIndex(0)
                    .Items(items =>
                    {
                        items.Add().Text("Project Plan Detail").Content(
                        @<text>
                            @projectPlanDetails()
                        </text>);

                            }).ToClientTemplate()
    )
</script>

@helper projectPlanDetails()
{
    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.Project.ProjectMonthlyPlan>()
              .Name("Selfproject_monthly_plan_grid_#=ProjectPlanId#")
              .Columns(columns =>
              {
                  columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["periods"], "GLPeriodId", "period").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                  columns.Bound(c => c.Value).Width(100);
                  columns.Command(command => { command.Edit();/* command.Destroy();*/ });
              })
              .Editable(editable => editable.Mode(GridEditMode.InLine))
              .Pageable()
              .Filterable()
              .Scrollable(h => h.Height(500))

              .DataSource(dataSource => dataSource
                  .Ajax()
                  .Model(model => { model.Id(p => p.ProjectMonthlyPlanId);
                      model.Field(p => p.GLPeriodId).Editable(false);
                  })
                  .Read(read => read.Action("ProjectMonthlyPlans_Read", "ProjectMonthlyPlans",new { pMId = "#=ProjectPlanId#" }))
                  .Update(update => update.Action("ProjectMonthlyPlans_Update", "ProjectMonthlyPlans"))
                  .Destroy(destroy => destroy.Action("ProjectMonthlyPlans_Destroy", "ProjectMonthlyPlans"))
              ).ClientDetailTemplateId("project_weekly_plan_self_detail")
              .ToClientTemplate()
    )


}

<script type="text/kendo-template" id="project_weekly_plan_self_detail">
    @(Html.Kendo().TabStrip()
        .Name("Selftab_str_projectweekly_plan_#=ProjectMonthlyPlanId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Project Weekly Plan").Content(
            @<text>
              @(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.Project.ProjectWeeklyPlan>()
              .Name("Self_project_Weekly_Plan_grid_#=ProjectMonthlyPlanId#")
              .Columns(columns =>
              {
                columns.Bound(c => c.WeekOne).Width(100);
                columns.Bound(c => c.WeekTwo).Width(100);
                columns.Bound(c => c.WeekThree).Width(100);
                columns.Bound(c => c.WeekFour).Width(120);
                columns.Command(command => { command.Edit(); command.Destroy(); });
              })
              .ToolBar(toolbar => {
                    toolbar.Create();
              })
              .Editable(editable => editable.Mode(GridEditMode.InLine))
              .Pageable()
              .Filterable()
              .Scrollable(h => h.Height(550))
              .DataSource(dataSource => dataSource
                  .Ajax()
                  .Model(model => model.Id(p => p.ProjectWeeklyPlanId))
                  .Read(read => read.Action("ProjectWeeklyPlans_Read", "ProjectWeeklyPlans", new { mpId = "#=ProjectMonthlyPlanId#" }))
                  .Create(create => create.Action("ProjectWeeklyPlans_Create", "ProjectWeeklyPlans", new { mpId = "#=ProjectMonthlyPlanId#" }))
                  .Update(update => update.Action("ProjectWeeklyPlans_Update", "ProjectWeeklyPlans"))
                  .Destroy(destroy => destroy.Action("ProjectWeeklyPlans_Destroy", "ProjectWeeklyPlans"))
              ).ToClientTemplate()
        )
            </text>);

        }).ToClientTemplate()
    )
</script>

