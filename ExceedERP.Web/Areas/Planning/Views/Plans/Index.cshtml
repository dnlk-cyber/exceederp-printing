@using ExceedERP.Core.Domain.Planning
@using ExceedERP.Core.Localization
<legend>Plan </legend>
@(Html.Kendo().Grid<Plan>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.PlanId).Title("S.N").Width(50).Filterable(false);
          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["GlFiscalYears"], "GlFiscalYearId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(250);
          columns.Bound(c => c.Description).Width(250);
          columns.Bound(c => c.Reason).Width(300).HtmlAttributes(new { style = "white-space: normal; overflow-wrap: anywhere;" });
          columns.Command(command =>
          {
              command.Edit();
              //command.Destroy();

          });


      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Pageable()
        .Filterable()
        .Scrollable(h => h.Height(700))
        .Events(events =>
        {
            events.Cancel("onCancel");
            events.Edit("onEdit");
            events.DataBound("onDataBound");
            events.DetailExpand("onDetailExpandUser");
        })
              .DataSource(dataSource => dataSource
                  .Ajax()
                  .Model(model =>
                  {
                      model.Id(p => p.PlanId);
                      model.Field(p => p.PlanId).Editable(false);
                      model.Field(p => p.IsDepartnental).Editable(false);
                  })
                  .Events(ev => ev
                                .Error("error_handler(\"grid\")")
                                .RequestStart("onRequestStart(\"grid\")")
                                .RequestEnd("onRequestEnd(\"grid\")"))
                  .Read(read => read.Action("Plans_Read", "Plans").Data("sendForgery"))
                  .Create(create => create.Action("Plans_Create", "Plans").Data("sendForgery"))
                  .Update(update => update.Action("Plans_Update", "Plans").Data("sendForgery"))
                  .Destroy(destroy => destroy.Action("Plans_Destroy", "Plans").Data("sendForgery"))
              ).ClientDetailTemplateId("plan_template")
)
<script type="text/kendo-template" id="plan_template">
    @(Html.Kendo().TabStrip()
                .Name("tab_str_#=PlanId#")
                .SelectedIndex(0)
                .Items(items =>
                {
                    items.Add().Text("Objective").Content(
        @<text>
            @(Html.Kendo().Grid<BSCPlan>()
                  .Name("Indicators_grid_#=PlanId#")
                  .Columns(columns =>
                  {
                      columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["departmentLists"], "OrgStructureId", "Name").EditorTemplateName("workUnit").Filterable(ftb => ftb.Multi(true).Search(true)).Width(300);

                      columns.ForeignKey(c => c.ObjectiveId, (IEnumerable)ViewData["Objectives"], "ObjectiveId", "Name").EditorTemplateName("objectives").Filterable(ftb => ftb.Multi(true).Search(true)).Width(400);
                      columns.Bound(c => c.ApprovalStatusText).Title("Approval Status").Width(180);

                      columns.Command(command =>
                      {
                          command.Edit();
                          command.Custom("cmd-Approve")
                              .Text("Approve")
                              .IconClass("fa fa-check")
                              .Click("approvePlan")
                              .HtmlAttributes(new { @class = "btn btn-success" });
                          command.Custom("cmd-Feedback")
                              .Text("Add Feedback")
                              .IconClass("fa fa-comment")
                              .Click("addPlanFeedback")
                              .HtmlAttributes(new { @class = "btn btn-primary" });

                          command.Destroy();
                      }).Width(420);



                  })
                .ToolBar(toolbar =>
                {
                    toolbar.Create();

                })
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Pageable()
                .Filterable()
                .Scrollable(h => h.Height(680))
                .Events(events =>
                {
                    events.Cancel("onCancel");
                    events.Edit("onEdit");
                    events.DataBound("onDataBound");

                })
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Model(model =>
                    {
                        model.Id(p => p.BSCPlanId);
                        model.Field(p => p.ApprovalStatusText).Editable(false);
                    })
                    .Events(ev => ev
                            .Error("error_handler(\"Indicators_grid_#=PlanId#\")")
                            .RequestStart("onRequestStart(\"Indicators_grid_#=PlanId#\")")
                            .RequestEnd("onRequestEnd(\"Indicators_grid_#=PlanId#\")"))
                .Read(read => read.Action("BSCPlans_Read", "BSCPlans", new { id = "#=PlanId#" }).Data("sendForgery"))
                .Create(create => create.Action("BSCPlans_Create", "BSCPlans", new { id = "#=PlanId#" }).Data("sendForgery"))
                .Update(update => update.Action("BSCPlans_Update", "BSCPlans").Data("sendForgery"))
                .Destroy(destroy => destroy.Action("BSCPlans_Destroy", "BSCPlans").Data("sendForgery"))
            ).ClientDetailTemplateId("Planning_detail_template")
            .ToClientTemplate()

            )


        </text>);



                }).ToClientTemplate()
    )
</script>
