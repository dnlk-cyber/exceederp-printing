<script>
    function filterObjective() {
        return {
            workUnitId: $("#OrgStructureId").val()
        };
    }
    function refreshForNewItems(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("RefreshToAddNewAddedItems", "BSCPlans", new { area = "Planning" })',
            data: { id: id },
            success: function (result) {
                //toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function approvePlan(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var feedback = window.prompt("Optional approval feedback:", "");
        if (feedback === null) {
            return;
        }

        feedback = $.trim(feedback);
        if (feedback.length > 2000) {
            alert("Feedback cannot exceed 2000 characters.");
            return;
        }

        $.ajax({
            type: "POST",
            url: '@Url.Action("ApproveBScPlan", "BSCPlans", new { area = "Planning" })',
            data: $.extend({ id: dataItem.BSCPlanId, feedback: feedback }, sendForgery()),
            success: function (result) {
                alert(result.Message);
                if (result.Status === "OK") {
                    e.sender.dataSource.read();
                    refreshPlanFeedback(dataItem.BSCPlanId);
                }
            },
            error: function (result) {
                alert(result.Message || "The plan could not be approved.");
            }
        });
    }

    function refreshPlanFeedback(id) {
        var historyGrid = $("#Plan_Approval_Feedback_grid_" + id).data("kendoGrid");
        if (historyGrid) {
            historyGrid.dataSource.read();
        }
    }

    function addPlanFeedback(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var feedback = window.prompt("Enter feedback for this plan:", "");
        if (feedback === null) {
            return;
        }

        feedback = $.trim(feedback);
        if (!feedback) {
            alert("Feedback is required.");
            return;
        }
        if (feedback.length > 2000) {
            alert("Feedback cannot exceed 2000 characters.");
            return;
        }

        $.ajax({
            type: "POST",
            url: '@Url.Action("AddPlanFeedback", "BSCPlans", new { area = "Planning" })',
            data: $.extend({ id: dataItem.BSCPlanId, feedback: feedback }, sendForgery()),
            success: function (result) {
                alert(result.Message);
                if (result.Status === "OK") {
                    e.sender.dataSource.read();
                    refreshPlanFeedback(dataItem.BSCPlanId);
                }
            },
            error: function (result) {
                alert(result.Message || "The feedback could not be saved.");
            }
        });
    }
</script>
