
@(Html.Kendo().DropDownListFor(m => m)
            .OptionLabel("Select")
            .DataTextField("Name")
            .DataValueField("ObjectiveId")
            .DataSource(dataSource =>
            {
                dataSource.Read(read => read.Action("GetObjectives", "PlanningDataProvider", new { Area = "Planning" }).Data("filterObjective"))
                    .ServerFiltering(true);
            })
            .Filter("contains")
            .MinLength(2)
            .ValuePrimitive(true)
            .CascadeFrom("OrgStructureId")
            )
                  
 

    