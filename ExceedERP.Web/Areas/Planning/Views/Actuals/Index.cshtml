                  {
                    columns.Bound(c => c.WeekOne).Width(110);
                    columns.Bound(c => c.WeekTwo).Width(110);
                    columns.Bound(c => c.WeekThree).Width(130);
                    columns.Bound(c => c.WeekFour).Width(130);
                    columns.Command(command => { command.Edit(); command.Destroy(); });
