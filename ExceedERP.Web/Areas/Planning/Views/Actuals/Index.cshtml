<script>

    function onCancel(e) {
        //Implement the event handler for Cancel
        e.sender.dataSource.cancelChanges();
        e.preventDefault();
        e.sender.refresh();
    }
    function onCancelActualDetail(e) {
        e.sender.dataSource.cancelChanges();
        e.preventDefault();
        e.sender.refresh();
        //Implement the event handler for Cancel
    }

    function onEdit(e) {
        //Implement the event handler for Edit
    }
    function onEditActualDetail(e) {
  



    }
    var fiscalYearId;
    var isGlobalPerdonal = false;

    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        fiscalYearId = masterDataItem.GlFiscalYearId;
        isGlobalPerdonal = masterDataItem.IsPersonal;

    }
    function onDataBound(e)
    {

        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsPersonal || isGlobalPerdonal) {
                $(row).css("background-color", "#7FFFD4");
                $(row).find(".k-grid-edit").remove();
                $(row).find(".k-grid-delete").remove();

            }
           
        }

    }

</script>
