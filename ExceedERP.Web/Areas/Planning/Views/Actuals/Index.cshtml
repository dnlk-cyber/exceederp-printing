@using ExceedERP.Core.Localization
<legend>Actual  </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.Actual>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.Bound(c => c.ActualId).Title("S.N").Filterable(false).Width(80);
              columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["GlFiscalYears"], "GlFiscalYearId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
               // columns.Bound(c => c.IsPersonal).ClientTemplate(
               //                                              "<input type='checkbox' disabled = 'true' value='#= IsPersonal#' " +
               //                                              "# if (IsPersonal) { #" +
               //                                               "checked='checked'" +
               //                                              "# } #" +
               //                                             "/>"
               //                                            ).Width(120);
               // columns.Bound(c => c.IsDepartnental).ClientTemplate(
               //                                             "<input type='checkbox' disabled = 'true' value='#= IsDepartnental#' " +
               //                                            "# if (IsDepartnental) { #" +
               //                                            "checked='checked'" +
               //                                           "# } #" +
               //                                         "/>"
               //                                          ).Width(120); ;
              columns.Bound(c => c.Description).Width(200);

              columns.Command(command =>
              {
                  command.Edit();
                  // command.Custom("cmd-send-request").IconClass("fa fa-refresh").Text("Refresh").Click("refreshActualFromPlanningChange").HtmlAttributes(new { @class = "btn btn-success" });
                  //command.Destroy();
              });
          })
                      .ToolBar(toolbar =>
                      {
                          toolbar.Create();
                      })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Pageable()
          .Filterable()
          .Scrollable(h => h.Height(700))
          .Events(events =>
          {
              events.Cancel("onCancel");
              events.Edit("onEdit");
              events.DataBound("onDataBound");
              events.DetailExpand("onDetailExpand");
          })
          .DataSource(dataSource => dataSource
              .Ajax()
              .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
              .Model(model => { model.Id(p => p.ActualId);
                  model.Field(p => p.ActualId).Editable(false);
                  model.Field(p => p.IsPersonal).Editable(false);
              })
              .Read(read => read.Action("Actuals_Read", "Actuals"))
              .Create(create => create.Action("Actuals_Create", "Actuals"))
              .Update(update => update.Action("Actuals_Update", "Actuals"))
              .Destroy(destroy => destroy.Action("Actuals_Destroy", "Actuals"))
          ).ClientDetailTemplateId("actual_detail_template")
)
<script type="text/kendo-template" id="actual_detail_template">
