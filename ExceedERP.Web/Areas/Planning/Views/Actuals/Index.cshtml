<script>
    function refreshActualFromPlanningChange(e)
    {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        $.ajax({
            type: "POST",
            url: '@Url.Action("RefreshActualDataFromPlanningChanges", "Actuals", new { area = "Planning" })',
            data: { id: dataItem.ActualId },
           success: function(result) {
                    alert(result);
                    location.reload(true);
                },
           error: function(result) {
                    alert(result);
                }
            });
   
    }
    function uploadFile(id) {
        $("#subIndicatorId").val(id);
        var wnd = $("#UploadDoc").data("kendoWindow");
        wnd.center().open();
    }
     function refreshForNewItems(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("RefreshToAddNewAddedItems", "BSCActuals", new { area = "Planning" })',
            data: { id: id },
            success: function (result) {
               // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
</script>
