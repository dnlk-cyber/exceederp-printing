@(Html.Kendo().DropDownListFor(m => m)
                .OptionLabel("---Select----")
                .Filter("contains")
                .DataTextField("Name")
                .DataValueField("OrgStructureId")
                .DataSource(dataSource =>
                {
                    dataSource.Read(read => read.Action("GetWorkUnit", "PlanningDataProvider", new { area = "Planning" }).Data("sendForgery"))
                    .ServerFiltering(false);
                })
            .AutoBind(true)
            .HtmlAttributes(new { style = "width: 280px;" })

)