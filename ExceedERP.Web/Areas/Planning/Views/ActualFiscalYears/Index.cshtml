<legend>Actual Fiscal Year </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.PlanningFiscalYear>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["GlFiscalYears"], "GlFiscalYearId", "Name");
              columns.Bound(c => c.Description);
              columns.Command(command =>
              {
                  command.Edit();
                  command.Destroy();
              }).Width(180);
          })
                      .ToolBar(toolbar =>
                      {
                          toolbar.Create();
                      })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Pageable()
          .Filterable()
          .Scrollable(h => h.Height(550))
          .Events(events =>
          {
              events.Cancel("onCancel");
              events.Edit("onEdit");
              events.DataBound("onDataBound");
          })
          .DataSource(dataSource => dataSource
              .Ajax()
              .Model(model => model.Id(p => p.PlanningFiscalYearId))
              .Read(read => read.Action("ActualFiscalYears_Read", "ActualFiscalYears"))
              .Create(create => create.Action("ActualFiscalYears_Create", "ActualFiscalYears"))
              .Update(update => update.Action("ActualFiscalYears_Update", "ActualFiscalYears"))
              .Destroy(destroy => destroy.Action("ActualFiscalYears_Destroy", "ActualFiscalYears"))
          ).ClientDetailTemplateId("actual_detail_template")
)
<script type="text/kendo-template" id="actual_detail_template">
    @(Html.Kendo().TabStrip()
                .Name("tab_str_#=PlanningFiscalYearId#")
                .SelectedIndex(0)
                .Items(items =>
                {
                items.Add().Text("Indicators").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.BSCPlan>()
                                .Name("Indicators_grid_#=PlanningFiscalYearId#")
                                .Columns(columns =>
                                {
                                        columns.ForeignKey(c => c.ObjectiveId, (IEnumerable)ViewData["Objectives"], "ObjectiveId", "Name").Width(400);

                                        columns.Command(command =>
                                        {
                                            command.Edit();
                                            command.Destroy();
                                        });
                                    })
                                .ToolBar(toolbar =>
                                    {
                                        toolbar.Create();
                                    })
                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .Pageable()
                                .Filterable()
                                .Scrollable(h => h.Height(550))
                                .Events(events =>
                                    {
                                        events.Cancel("onCancel");
                                        events.Edit("onEdit");
                                        events.DataBound("onDataBound");
                                    })
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Model(model => model.Id(p => p.BSCPlanId))
                                    .Read(read => read.Action("BSCPlans_Read", "BSCPlans", new { id = "#=PlanningFiscalYearId#" }))
                                    .Create(create => create.Action("BSCPlans_Create", "BSCPlans", new { id = "#=PlanningFiscalYearId#" }))
                                    .Update(update => update.Action("BSCPlans_Update", "BSCPlans"))
                                    .Destroy(destroy => destroy.Action("BSCPlans_Destroy", "BSCPlans"))
                                ).ClientDetailTemplateId("actual_detail")
                                .ToClientTemplate()

                    )


                </text>);

                }).ToClientTemplate()
    )
</script>
<script type="text/kendo-template" id="actual_detail">
    @(Html.Kendo().TabStrip()
        .Name("tab_str_Planning_#=BSCPlanId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Actual Detail").Content(
            @<text>
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.ActualDetail>()
                        .Name("Planning_grid#=BSCPlanId#")
                        .Columns(columns =>
                        {

                            columns.ForeignKey(c => c.IndicatorId, (IEnumerable)ViewData["Indicators"], "IndicatorId", "Name").Width(150);
                            columns.Bound(c => c.Baseline).Width(90);
                            columns.Bound(c => c.Month1).Width(80);
                            columns.Bound(c => c.Month2).Width(80);
                            columns.Bound(c => c.Month3).Width(100);
                            columns.Bound(c => c.Month4).Width(100);
                            columns.Bound(c => c.Month5).Width(100);
                            columns.Bound(c => c.Month6).Width(100);
                            columns.Bound(c => c.Month7).Width(80);
                            columns.Bound(c => c.Month8).Width(90);
                            columns.Bound(c => c.Month9).Width(80);
                            columns.Bound(c => c.Month10).Width(80);
                            columns.Bound(c => c.Month11).Width(80);
                            columns.Bound(c => c.Month12).Width(80);
                            columns.Bound(c => c.TotalActual).Width(80);
                            columns.Command(command =>
                            {
                                command.Edit();
                                command.Destroy();
                            }).Width(200);
                        })
                        .ToolBar(toolbar =>
                        {
                            toolbar.Create();
                        })
                            .Editable(editable =>
                            {
                                editable.Mode(GridEditMode.PopUp);
                                editable.TemplateName("ActualIndicatorTemplate");
                                editable.Window(window =>
                                {
                                    window.Title("Indicators Form");
                                    window.Draggable(false);
                                    window.Scrollable(false);
                                    //window.Height(400);
                                    window.Width(700);
                                });
                            })
                        .Pageable()
                        .Filterable()
                        .Scrollable(h=>h.Height(550))
                        .Events(events =>
                        {
                            events.Cancel("onCancelActualDetail");
                            events.Edit("onEditActualDetail");
                            events.DataBound("onDataBound");
                        })
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Model(model => model.Id(p => p.ActualDetailId))
                            .Read(read => read.Action("ActualDetails_Read", "ActualDetails", new { aId = "#=BSCPlanId#" }))
                            .Create(create => create.Action("ActualDetails_Create", "ActualDetails", new { aId = "#=BSCPlanId#" }))
                            .Update(update => update.Action("ActualDetails_Update", "ActualDetails"))
                            .Destroy(destroy => destroy.Action("ActualDetails_Destroy", "ActualDetails"))
                        ).ToClientTemplate()

                )


            </text>);

        }).ToClientTemplate()
    )
</script>
<script>

    function onCancel(e) {
        //Implement the event handler for Cancel
        e.sender.dataSource.cancelChanges();
        e.preventDefault();
        e.sender.refresh();
    }
    function onCancelActualDetail(e) {
        e.sender.dataSource.cancelChanges();
        e.preventDefault();
        e.sender.refresh();
        //Implement the event handler for Cancel
    }

    function onEdit(e) {
        //Implement the event handler for Edit
    }
    function onEditActualDetail(e) {
        var month1 = $("#Month1").data("kendoNumericTextBox").value();
        var month2 = $("#Month2").data("kendoNumericTextBox").value();
        var month3 = $("#Month3").data("kendoNumericTextBox").value();
        var month4 = $("#Month4").data("kendoNumericTextBox").value();
        var month5 = $("#Month5").data("kendoNumericTextBox").value();
        var month6 = $("#Month6").data("kendoNumericTextBox").value();
        var month7 = $("#Month7").data("kendoNumericTextBox").value();
        var month8 = $("#Month8").data("kendoNumericTextBox").value();
        var month9 = $("#Month9").data("kendoNumericTextBox").value();
        var month10 = $("#Month10").data("kendoNumericTextBox").value();
        var month11 = $("#Month11").data("kendoNumericTextBox").value();
        var month12 = $("#Month12").data("kendoNumericTextBox").value();
        var totalActual = month1 + month2 + month3 + month4 + month5 + month6 + month7 + month8 + month9 + month10 + month11 + month12;
        $("#TotalActual").val(totalActual).trigger("change");



    }

    function onDataBound(e) {
        //Implement the event handler for DataBound
    }

</script>
<style>
    div.k-edit-form-container {
        width: auto;
    }

    .row .col-sm-2 {
        width: 200px;
    }

    .row {
        margin-bottom: 10px;
        margin-left: 20px;
    }

