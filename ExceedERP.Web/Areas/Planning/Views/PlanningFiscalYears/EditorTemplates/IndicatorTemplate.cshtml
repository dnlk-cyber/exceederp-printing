@model ExceedERP.Core.Domain.Planning.PlanningDetail
<form id="lineForm" method="post">
    <div class="row">
        <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(m => m.IndicatorId)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(m => m.IndicatorId)
                                     .OptionLabel("Select")
                                     .DataTextField("Name")
                                     .DataValueField("IndicatorId")
                                     .DataSource(dataSource =>
                                     {
                                         dataSource.Read(read => read.Action("GetIndicators", "PlanningDataProvider", new { Area = "Planning" }))
                                             .ServerFiltering(false);
                                     })
                                     .Filter("contains")
                                     .MinLength(2)
                                     .ValuePrimitive(true)
                    )
                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(m => m.Baseline)
                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(m => m.Baseline))
                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(m => m.Target)
                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.Target) )

                </div>

            </div>
        </div>
        
    </div>
