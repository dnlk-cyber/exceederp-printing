<legend>Seting| Self-Care Objectives</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.Objective>()
      .Name("objectivegrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ObjectiveId).Title("S.N").Width(60);
          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["departmentLists"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).EditorTemplateName("workUnit").Width(120);
          columns.Bound(c => c.Name).Width(150);
          columns.Bound(c => c.Weight).Width(100);
          columns.Bound(c => c.Description).Width(120);
          columns.Bound(c => c.Remark).Width(100);
          columns.Command(command =>
          {   command.Edit();
              command.Destroy();
          }).Width(200);
      })
      .ToolBar(toolbar => {
          toolbar.Create();
      })
            
      .Events(x => x.DetailExpand("onDetailExpand"))
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Pageable()
      .Filterable()
      .Scrollable(h => h.Height(550))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(s => s.Add(x => x.ObjectiveId).Descending())
          .Model(model => { model.Id(p => p.ObjectiveId);
              model.Field(p => p.ObjectiveId).Editable(false);
          })
          .Read(read => read.Action("ObjectiveSelfCares_Read", "ObjectiveSelfCares").Data("sendForgery"))
          .Create(create => create.Action("ObjectiveSelfCares_Create", "ObjectiveSelfCares").Data("sendForgery"))
          .Update(update => update.Action("ObjectiveSelfCares_Update", "ObjectiveSelfCares").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("ObjectiveSelfCares_Destroy", "ObjectiveSelfCares").Data("sendForgery"))
      ).ClientDetailTemplateId("selfCare_objective_detail")
)

<script type="text/kendo-template" id="selfCare_objective_detail">
    @(Html.Kendo().TabStrip()
        .Name("tab_we_str_#=ObjectiveId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Indicators(Activity)").Content(
            @<text>
               @(Html.Kendo().Grid<ExceedERP.Core.Domain.Planning.Indicator>()
                      .Name("Indicator_grid_#=ObjectiveId#")
                      .Columns(columns =>
                      {

                          columns.ForeignKey(c => c.GlobalIndicatorId, (IEnumerable)ViewData["GlobalIndicators"], "GlobalIndicatorId", "Indicator").EditorTemplateName("GlobalIndicatorTemplate").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
                          columns.Bound(c => c.Name).Width(180);
                          columns.Bound(c => c.Weight).Width(100);
                          columns.Bound(c => c.Unit).EditorTemplateName("UoMTemplate").Width(100);
                          columns.Bound(c => c.KPIType).Width(80);
                          columns.Bound(c => c.HasSubIndicator).ClientTemplate(
                                                            "<input type='checkbox' disabled = 'true' value='\\#= HasSubIndicator\\#' " +
                                                            "\\# if (HasSubIndicator) { \\#" +
                                                            "checked='checked'" +
                                                            "\\# } \\#" +
                                                            "/>"
                                                            ).Width(120);
                          columns.Bound(c => c.IsActive).ClientTemplate(
                                                          "<input type='checkbox' disabled = 'true' value='\\#= IsActive\\#' " +
                                                          "\\# if (IsActive) { \\#" +
                                                          "checked='checked'" +
                                                          "\\# } \\#" +
                                                          "/>"
                                                          ).Width(120);
                          columns.Bound(c => c.Description).Width(150);

                          columns.Command(command =>
                          {
                              command.Edit();
                              command.Custom("").Click("EnableOrDisableActive").Text("Enable or Disable").IconClass("fa fa-check fa2x").HtmlAttributes(new { @class = "btn btn-success", @title = "EnableDisable ", @id = "enableDisable" });
                              command.Destroy();
                          }).Width(300);
                      })
                      .ToolBar(toolbar => {
                          toolbar.Create();
                      })
                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                      .Pageable()
                      .Filterable()
                      .Scrollable(h=>h.Height(550))
                      .DataSource(dataSource => dataSource
                          .Ajax()
                          .Events(ev => ev
                            .Error("error_handler(\"Indicator_grid_#=ObjectiveId#\")")
                            .RequestStart("onRequestStart(\"Indicator_grid_#=ObjectiveId#\")")
                            .RequestEnd("onRequestEnd(\"Indicator_grid_#=ObjectiveId#\")"))
                          .Model(model => {
                              model.Id(p => p.IndicatorId);
                              model.Field(p => p.IndicatorId).Editable(false);
                              model.Field(p => p.Name).Editable(false);
                          })
                          .Read(read => read.Action("Indicators_Read", "Indicators",new { oId= "#=ObjectiveId#" }).Data("sendForgery"))
                          .Create(create => create.Action("Indicators_Create", "Indicators", new { oId = "#=ObjectiveId#" }).Data("sendForgery"))
                          .Update(update => update.Action("Indicators_Update", "Indicators").Data("sendForgery"))
                          .Destroy(destroy => destroy.Action("Indicators_Destroy", "Indicators").Data("sendForgery"))
                      ).ClientDetailTemplateId("indicator_details")
                      .ToClientTemplate()
              )

            </text>);

        }).ToClientTemplate()
    )
</script>
