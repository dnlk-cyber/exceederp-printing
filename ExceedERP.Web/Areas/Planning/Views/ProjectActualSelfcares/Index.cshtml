     function refreshForNewItems(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("RefreshToAddNewAddedItems", "ProjectActuals", new { area = "Planning" })',
            data: { id: id },
            success: function (result) {
                //toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
</script>