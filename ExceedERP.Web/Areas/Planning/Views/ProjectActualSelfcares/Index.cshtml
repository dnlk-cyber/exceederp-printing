                  {
                    columns.Bound(c => c.WeekOne).Width(110);
                    columns.Bound(c => c.WeekTwo).Width(110);
                    columns.Bound(c => c.WeekThree).Width(130);
                    columns.Bound(c => c.WeekFour).Width(130);
                    columns.Command(command => { command.Edit(); command.Destroy(); });
                  })
                  .ToolBar(toolbar => {
                        toolbar.Create();
                  })
                  .Editable(editable => editable.Mode(GridEditMode.InLine))
                  .Pageable()
                  .Filterable()
                  .Scrollable(h=>h.Height(500))
                  .DataSource(dataSource => dataSource
                      .Ajax()

                      .Model(model => model.Id(p => p.ProjectWeeklyActualId))
                      .Read(read => read.Action("ProjectWeeklyActuals_Read", "ProjectWeeklyActuals", new { wId = "#=ProjectMonthlyActualId#" }))
                      .Create(create => create.Action("ProjectWeeklyActuals_Create", "ProjectWeeklyActuals", new { wId = "#=ProjectMonthlyActualId#" }))
                      .Update(update => update.Action("ProjectWeeklyActuals_Update", "ProjectWeeklyActuals"))
                      .Destroy(destroy => destroy.Action("ProjectWeeklyActuals_Destroy", "ProjectWeeklyActuals"))
                  ).ToClientTemplate()
            )


            </text>);

        }).ToClientTemplate()
    )
</script>
