<script>

    function filterRequestor() {
        return {
            text: $("#EmployeeId").data("kendoDropDownList").filterInput.val(),
        }
    }

    function filterEmployees() {
        return {
            text: $("#RecipientId").data("kendoDropDownList").filterInput.val(),
        }
    }

    function hasReading(obj) {
        if ($(obj).is(":checked")) {
            $("#readingDiv").show();
           
        } else {
            $("#readingDiv").hide();
        }

    }
   
    
    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "IssueFuelManual", new { area = "Inventory" })',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }


    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "IssueFuelManual", new { area = "Inventory" })',
            data: { id: id },
            success: function(result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function(result) {
                alert(result);
            }
        });
    }

    function onSelectedPeriod() {
        var periodId = $("#GLPeriodId").data("kendoDropDownList").value();
        var min = "";
        var max = "";
        if (periodId) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetPeriodDateRangeById", "DataProvider", new {area = "Inventory"})',
            data: { id: periodId },
            success: function (result) {
                min = result.Min;
                max = result.Max;
                //update
                var datepicker = $("#IssueDate").data("kendoDatePicker");
                datepicker.setOptions({
                    format: "yyyy-MM-dd",
                    min:min,
                    max:max,
                    value: new Date(),
                    change: onDOBChange
                });
            }, //end succ
            error: function (result) {
                alert(result);
            }

                });
                }

    }

    function filterPeriodsByMyStore() {
        return {
            store: $("#StoreCode").val(),
            text: null
        }
    }

    function onSelectOwnerType(e) {
     
        var grid = $("#grid").data("kendoGrid");
        var owner = $("#Owner").data("kendoDropDownList");
        var ownerValue = owner.value();
       
        if (ownerValue === "1") {
            $("#supplierDiv").show();
        } else if (ownerValue === "0") {
            $("#supplierDiv").hide();
        }
    }
    function onMasterEdit(e) {
        var grid = $("#grid").data("kendoGrid");
        grid.hideColumn("SupplierAccountCode");
        grid.hideColumn("ReadingKM");

        if (e.model.isNew() === false) {
            $("#StoreRequisitionID").kendoDropDownList({
                enable: false
            });

        }
        
    }
    function checkboxClicked(e) {

        var isChecked = e.checked;
        var grid = $("#grid").data("kendoGrid");
        if (isChecked) {

            grid.showColumn("ReadingKM");
        } else {
            grid.hideColumn("ReadingKM");
        }

    };

   
    function onItemEdit(e) {
       

    }

    function onSelectStoreRequisitionID(e) {
        var id = $("#StoreRequisitionID").data("kendoDropDownList").value();
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetStoreRequisitionData", "DataProvider", new { area = "Inventory" })',
            data: { id: id },
            success: function (result) {

                if (result.length > 0) {

                    for (var i = 0; i < result.length; i++) {
                        $("#PlateNo").val(result[i].PlateNo).trigger("change");
                        $("#StoreCode").val(result[i].StoreCode).trigger("change");
                    }
                }
               
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

   
