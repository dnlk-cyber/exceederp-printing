@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Issue Fuel - Manual</legend>

@(Html.Kendo().Grid<Issue>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.IssueID).Title("Issue No.").Width(110).ClientTemplate("#=appendZeros(IssueID)#");
          columns.ForeignKey(p => p.StoreCode, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Width(150).EditorTemplateName("StoreReadOnly").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["inventoryPeriods"], "GLPeriodId", "Name").Width(90).Title("Period").EditorTemplateName("InventoryPeriodSelector").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.IssueDate).Title("Issue Date").Width(100);
          columns.Bound(c => c.Owner).Width(80).EditorTemplateName("InternalOrExternal");
          columns.Bound(c => c.PlateNo).Title("Plate No.").Width(90);
          columns.Bound(c => c.SupplierAccountCode).Title("Supplier Account").EditorTemplateName("AccountCode").Width(120);
          columns.Bound(c => c.HasReading).Width(100).EditorTemplateName("HasReading").ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= HasReading #' " +
              "# if (HasReading) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.ReadingKM).Title("Reading KM").Width(110);
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(160).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(180);
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(130).EditorTemplateName("EmployeeSelector");
          columns.ForeignKey(p => p.RecipientId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Recipient").Width(130).EditorTemplateName("EmployeeSelector");

          columns.ForeignKey(p => p.SupplierId, (IEnumerable)ViewData["Suppliers"], "Code", "Name").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.IsLoan).Width(90).Title("Is Loan?").ClientTemplate(
             "<input type='checkbox' disabled = 'true' value='#= IsLoan #' " +
             "# if (IsLoan) { #" +
             "checked='checked'" +
             "# } #" +
             "/>"
             );
          columns.Bound(c => c.External).Width(90).Title("External ?").ClientTemplate(
             "<input type='checkbox' disabled = 'true' value='#= External #' " +
             "# if (External) { #" +
             "checked='checked'" +
             "# } #" +
             "/>"
             );
          columns.Bound(c => c.ExternalRequesterName).Width(120);
          columns.Bound(c => c.Reference).Width(100);
          columns.Bound(c => c.Remark).Width(100);
          columns.Bound(c => c.Status).Width(100);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("IssueFuel").Window(w => w.Title("Issue Fuel")))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Sortable()
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })

      .Events(ev => ev.DetailExpand("detailExpand").Edit("onMasterEdit"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Sort(sort => sort.Add("IssueID").Descending())
          .Model(model =>
          {
              model.Id(p => p.IssueID);
              model.Field(p => p.IssueID).Editable(false);
              model.Field(p => p.ForBranchId).Editable(false);
              //model.Field(p => p.EmployeeId).Editable(false);
              //model.Field(p => p.IssueDate).Editable(false);
              //model.Field(p => p.BranchId).Editable(false);
              //model.Field(p => p.OrgStructureId).Editable(false);
             // model.Field(p => p.BusinessUnitId).Editable(false);
              model.Field(p => p.Status).Editable(false);
              model.Field(p => p.IssueID).Editable(false);
              model.Field(p => p.IsManual).Editable(false);
              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.LastModified).Editable(false);

          })
          .Read(read => read.Action("IssueFuels_Read", "IssueFuelManual"))
          .Create(create => create.Action("IssueFuels_Create", "IssueFuelManual"))
          .Update(update => update.Action("IssueFuels_Update", "IssueFuelManual"))
          .Destroy(destroy => destroy.Action("IssueFuels_Destroy", "IssueFuelManual"))
      ).ClientDetailTemplateId("issuefueltemplate"))

