                    @Html.Kendo().TextBoxFor(model => model.PlateNo)@*.HtmlAttributes(new { disabled = "disabled" })*@
                    @Html.ValidationMessageFor(model => model.PlateNo, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group" id="supplierDiv" style="display: none">
