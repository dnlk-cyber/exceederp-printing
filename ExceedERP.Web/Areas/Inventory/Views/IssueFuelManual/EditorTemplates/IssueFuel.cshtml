                    @Html.ValidationMessageFor(model => model.SupplierAccountCode, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.EmployeeId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.EmployeeId)
                                  .ValuePrimitive(true)
                                  .OptionLabel("Select Employee")
                                  .DataTextField("FullNameaEnglish")
                                .DataValueField("EmployeeId")
                                .Filter("contains")
                                .DataSource(dataSource =>
                                {
                                    dataSource.Read(read => read.Action("GetAllEmployees", "GlobalDataProvider", new { area = "Common" }).Data("filterRequestor"))
