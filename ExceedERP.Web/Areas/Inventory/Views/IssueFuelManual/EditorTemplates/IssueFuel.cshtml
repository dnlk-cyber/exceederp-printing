                @Html.LabelFor(model => model.Owner, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.Owner)
                                  .ValuePrimitive(true)
                                  .DataTextField("Text")
                                  .DataValueField("Value")
                                  .Events(e =>
                                  {
                                      e.Change("onSelectOwnerType");
                                  })
                                  .BindTo(EnumExtension.EnumToSelectList(typeof(IssueFuelVehicleOwner)))
                    )
                    @Html.ValidationMessageFor(model => model.Owner, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

