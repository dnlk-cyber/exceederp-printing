@using Telerik.Reporting.Charting.Styles
 @{
     Layout = "~/Views/Shared/_Popup.cshtml";
}
<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.Label("Category", htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @(Html.Kendo().DropDownList()
                         .Name("ItemCategoryCode")
                          .OptionLabel("...Category...")
                          .DataTextField("Name")
                          .DataValueField("ItemCategoryCode")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetItemCategory", "DataProvider"))
                                  .ServerFiltering(true);
                          })
                          )
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.Label("Item", htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @(Html.Kendo().DropDownList()
                          .Name("ItemDD")
                           
                          .OptionLabel("...Item...")
                          .DataTextField("Name")
                          .DataValueField("ItemCode")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetStoreItemsByCategory", "DataProvider").Data("getItemcategory"))
                                  .ServerFiltering(true);
                          }).CascadeFrom("ItemCategoryCode")
                          )
                </div>
            </div>
            <div class="row"></div>

            <div class="row"></div>


            <div class="row"></div>
            <div class="col-md-offset-3 col-md-9">
                <button type="submit" class="saveBtn btn btn-primary" onclick="javascript: changeparent()"><i class="fa fa-suitcase"></i> Submit</button>
            </div>
        </div>
    </div>
</div>

<script language="javascript">
    function getItemcategory() {
        var store = opener.storeCode;
        return {
            ItemCategoryCode: $("#ItemCategoryCode").data("kendoDropDownList").value() ,
            StoreCode : store
        };
    }
    function changeparent() {
        
             
        
        var Itemd = document.getElementById('ItemDD').value;
           var ItemCode =  Itemd;
           opener.setLang(ItemCode);
           window.close();
      
    }
    function closeWin() {
        document.close();
    }
</script>