@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Helpers
@model ExceedERP.Core.Domain.Procurement.PR.PurchaseRequisitionItemSpecification

@Html.HiddenFor(model => model.PurchaseRequisitionItemSpecificationId)

<div class="form">
    <div class="row fullrow">

        <div class="col-md-12">
            <div class="form-group">
                @Html.LabelFor(model => model.Specification, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-12">
                    @Html.Kendo().TextBoxFor(model => model.Specification).HtmlAttributes(new { @class = "control-label col-md-8" })
                    @Html.ValidationMessageFor(model => model.Specification, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

           
        </div>
       
    </div>
</div>
