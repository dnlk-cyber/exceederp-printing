@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@{ Layout = "~/Views/Shared/_Layout.cshtml";}
<legend>Item Transfer Receive</legend>

@(Html.Kendo().Grid<ItemTransfer>()
      .Name("grid")
      .Columns(columns =>
      {

          columns.Bound(c => c.ItemTransferID).Title("Transfer No.").Width(110).ClientTemplate("#=appendZeros(ItemTransferID)#");
          columns.Bound(c => c.StoreRequisitionID).Title("Req. No.").EditorTemplateName("TransferStoreRequistion").Width(120);
          columns.Bound(c => c.DocumentRef).Title("Doc Ref No.").Width(100);
          columns.ForeignKey(p => p.FromStore, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Title("From Store").Width(120);
          columns.ForeignKey(p => p.ToStore, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Title("To Store").Width(120);
          columns.Bound(c => c.DriverType).EditorTemplateName("TransferType").Width(130);
          columns.ForeignKey(p => p.DeliveredBy, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Driver Name").Width(140).EditorTemplateName("EmployeeSelector");
          columns.ForeignKey(p => p.SupplierName, (IEnumerable)ViewData["suppliers"], "SupplierId", "Name").Title("Supplier Name").Width(140).EditorTemplateName("SupplierSelector");
          columns.Bound(c => c.PlateNo).Title("Plate No.").Width(110);
          columns.Bound(c => c.ReceiveDate).Title("Receive Date").Width(130);
          columns.Bound(c => c.Remark).Width(90);
          columns.Bound(c => c.Status).Width(80);
          columns.Bound(c => c.GLPeriodId).Hidden().Width(150);
       
          columns.Command(command =>
          {
              //command.Edit();
              //command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar => {
           
                              // toolbar.Excel();
                              //toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Scrollable(height => height.Height(500))
      .Events(events => {
                            events.DetailExpand("detailExpandTransferReceive");
      })
      .Events(x => x.DataBound("onDataBoundMasterTransferReceive"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ItemTransferID").Descending())
          .PageSize(20)
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.ItemTransferID);
              model.Field(p => p.StoreRequisitionID).Editable(false);
              model.Field(p => p.DocumentRef).Editable(false);
              model.Field(p => p.TransferDate).Editable(false);
              model.Field(p => p.FromStore).Editable(false);
              model.Field(p => p.ToStore).Editable(false);
              model.Field(p => p.DeliveredBy).Editable(false);
              model.Field(p => p.PlateNo).Editable(false);
              model.Field(p => p.GLPeriodId).Editable(false);
          })
          .Read(read => read.Action("ItemTransferReceives_Read", "ItemTransferReceive"))
          // .Create(create => create.Action("ItemTransferReceives_Create", "ItemTransferReceive"))
          .Update(update => update.Action("ItemTransferReceives_Update", "ItemTransferReceive"))
      //.Destroy(destroy => destroy.Action("ItemTransferReceives_Destroy", "ItemTransferReceive"))
      ).Reorderable(p => p.Columns(true))
      .Resizable(p => p.Columns(true))
      .ClientDetailTemplateId("Itemtransferreceivetemp"))

