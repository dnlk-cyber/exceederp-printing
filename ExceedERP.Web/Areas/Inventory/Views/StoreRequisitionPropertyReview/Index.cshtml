        //    var row = $(rows[j]); 
        //    var dataItem = e.sender.dataItem(row);

        //    if (dataItem.IsSendForApproval && !dataItem.IsOnlineApproved) {
        //        row.css("background-color", "lightpink");
        //    }

        //    if (dataItem.IsOnlineApproved && !dataItem.IsMiddleSendForApproval) {
        //        row.css("background-color", "lightblue");
        //    }

        //    if (dataItem.IsMiddleSendForApproval && !dataItem.IsMiddleOnlineApproved) {
        //        row.css("background-color", "lightgreen");
        //    }
        //    if (dataItem.IsMiddleOnlineApproved && !dataItem.IsSecondSendForApproval) {
        //        row.css("background-color", "lightskyblue");
        //    }
        //    if (dataItem.IsSecondSendForApproval && !dataItem.IsSecondOnlineApproved) {
        //        row.css("background-color", "lightgreen");
        //    }
        //}

    }
    function onDataBoundPropertyLines(e) {

        var detailGrid = "#" + e.sender.element[0].id;
        $(".k-grid-add", detailGrid).hide();
        $(".k-grid-delete", detailGrid).hide();
        if (issecondapproved) {
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundPropertySecondValidation(e) {
        var detailGrid = "#" + e.sender.element[0].id;
        $(".k-grid-delete", detailGrid).hide();
        if (issecondapproved || !isSecondSendForApproval) {
            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }

    function OnIndexCall(elem) {

        var a = codeid;
        $(elem).attr('href', $(elem).attr('href') + '?id=' + a);


    }




    function onClick(e) {

        var masterRow = this.wrapper.closest("tr.k-detail-row").prev(".k-master-row");
        var masterGrid = $("#grid").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);
        var code = masterDataItem.StoreRequisitionID;
        var tabstrip = $("#tabStrip_4").data("kendoTabstrip");
        $.ajax({
            url: "StoreRequisition/StoreRequisitions_Approval",

            data: { id: code }
        });
    }
