@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Store Requisition Review </legend>

@(Html.Kendo().Grid<StoreRequisition>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.StoreRequisitionID).Title("Request No.").Width(120).Width(120).ClientTemplate("#=appendZeros(StoreRequisitionID)#");
          columns.Bound(c => c.Reference).Title("Reference").Width(120);
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["inventoryPeriods"], "GLPeriodId", "Name").Width(90).Title("Period").EditorTemplateName("InventoryPeriodSelector");
          columns.Bound(c => c.RequestDate).Width(110);
          columns.ForeignKey(p => p.StoreCode, (IEnumerable)ViewData["storesInCompany"], "StoreCode", "Name").Title("Store").Width(150).EditorTemplateName("StoresSelector");
          columns.Bound(c => c.IsTransfer).EditorTemplateName("IsTransferRequest").ClientTemplate("<input type='checkbox' disabled = 'true'  value='#=IsTransfer #' " + " # if (IsTransfer) { #" + "checked='checked'" + "# } #" + " />").Width(100);
          columns.ForeignKey(p => p.ToStoreCode, (IEnumerable)ViewData["storesInCompany"], "StoreCode", "Name").Title("To Store").Width(150).EditorTemplateName("StoresSelector");
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(150);
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(130).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(130).EditorTemplateName("EmployeeSelector");
          columns.Bound(c => c.ModelNo).Width(100);
          columns.Bound(c => c.PlateNo).Width(100);
          columns.Bound(c => c.Remark).Width(100);
          columns.Bound(c => c.Status).Width(80);

          columns.Command(command =>
          {
              command.Edit();
              //command.Destroy();
          }).Width(150);

      }).Filterable()
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .ToolBar(toolbar =>
      {


      })
      .Events(ev => ev.Edit("onMasterEdit"))

      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("StoreRequisition").Window(w => w.Title("Store Requisition")))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Sortable()
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Events(ev => ev.DetailExpand("detailExpandProperty"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMasterProperty"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("StoreRequisitionID").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .PageSize(20)
          .Model(model =>
          {
              model.Id(p => p.StoreRequisitionID);
              model.Field(p => p.StoreRequisitionID).Editable(false);
              model.Field(p => p.IsForOther).Editable(false);
              model.Field(p => p.IsTransfer).Editable(false);
              model.Field(p => p.StoreCode).Editable(false);
              model.Field(p => p.ToStoreCode).Editable(false);
              model.Field(p => p.ModelNo).Editable(false);
              model.Field(p => p.Reference).Editable(false);
              model.Field(p => p.Remark).Editable(false);


              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.GLPeriodId).Editable(false);
              model.Field(p => p.OrgStructureId).Editable(false);
              model.Field(p => p.EmployeeId).Editable(false);
              model.Field(p => p.Status).Editable(false);
              model.Field(p => p.RequestDate).Editable(false);
          })
          .Read(read => read.Action("StoreRequisitionPropertyReviews_Read", "StoreRequisitionPropertyReview"))
          .Create(create => create.Action("StoreRequisitionPropertyReviews_Create", "StoreRequisitionPropertyReview"))
          .Update(update => update.Action("StoreRequisitionPropertyReviews_Update", "StoreRequisitionPropertyReview"))
          .Destroy(destroy => destroy.Action("StoreRequisitionPropertyReviews_Destroy", "StoreRequisitionPropertyReview"))

      ).Resizable(resize => resize.Columns(true))
      .ClientDetailTemplateId("storerequisitions"))

