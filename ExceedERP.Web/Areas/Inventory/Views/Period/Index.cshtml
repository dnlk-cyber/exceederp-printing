 
 @{
     Layout = "~/Views/Shared/_Layout.cshtml";
 }
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Inventory.InventoryPeriod>()
      .Name("grid")
      .Columns(columns =>
      {
      columns.Bound(c => c.Description);
      columns.Bound(c => c.StartDate).Format("{0: dd/MM/yyyy}");
      columns.Bound(c => c.EndDate).Format("{0: dd/MM/yyyy}");
    
      columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text("Add New Period");
            toolbar.Excel();
           // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Pageable()
      .Filterable()
      .Selectable(selectable => {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable => {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Scrollable(height => height.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.InventoryPeriodId))
          .Read(read => read.Action("Periods_Read", "Period"))
          .Create(create => create.Action("Periods_Create", "Period"))
          .Update(update => update.Action("Periods_Update", "Period"))
          .Destroy(destroy => destroy.Action("Periods_Destroy", "Period"))
      )
)
