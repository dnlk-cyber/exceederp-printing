 @model ExceedERP.Core.Domain.Inventory.ItemTransferItem
<form>

  
    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="form-group">

            <div class="col-md-3">
                @Html.LabelFor(model => model.ItemCode)

            </div>
          
              <div class="col-md-3">
          @(Html.Kendo().DropDownListFor(model => model.ItemCode)
          .AutoBind(false)
          .OptionLabel("Select Item...")
          .DataTextField("Name")
          .DataValueField("ItemCode")
          .DataSource(dataSource =>
          {
              dataSource.Read(read => read.Action("GetStoreItems", "DataProvider").Data("getItems"))
                  .ServerFiltering(true);
          })
          )
          @Html.ValidationMessageFor(m => m)
 </div>
        </div>

    </div>


  
    <br />

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="form-group">

            <div class="col-md-3">
                @Html.LabelFor(model => model.PartOrCodeNumber)

            </div>
            <div class="col-md-3">

                @Html.Kendo().TextBoxFor(model => model.PartOrCodeNumber)
 
            </div>
        </div>

    </div>
    <br />

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="form-group">

            <div class="col-md-3">
                @Html.LabelFor(model => model.RequestedQuantity)

            </div>
            <div class="col-md-3">

                @Html.Kendo().TextBoxFor(model => model.RequestedQuantity)
 
            </div>
        </div>

    </div>
    <br />

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="form-group">

            <div class="col-md-3">
                @Html.LabelFor(model => model.ShippedQuantity)

            </div>
            <div class="col-md-3">
                @Html.Kendo().TextBoxFor(model => model.ShippedQuantity)

            </div>
        </div>

    </div>
    <br />

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="form-group">

            <div class="col-md-3">
                @Html.LabelFor(model => model.UPrice)

            </div>
            <div class="col-md-3">
                @Html.Kendo().CurrencyTextBoxFor(model => model.UPrice)
                </div>
        </div>

    </div>
    <br />
    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="form-group">

            <div class="col-md-3">
                @Html.LabelFor(model => model.Remark)

            </div>
            <div class="col-md-3">
                @Html.Kendo().TextBoxFor(model => model.Remark)

            </div>
        </div>

    </div>
</form>
 