    <br />
    Distribution
    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Inventory.ItemTransferDistribution>()
                  .Name("ItemTransferDistribution_#=ItemTransferID#")
                  .Columns(columns =>
                  {
                      columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(200);
                      columns.Bound(c => c.AccountDesc);
                      columns.Bound(c => c.Debit);
                      columns.Bound(c => c.Credit);
                      columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
                  })
                  .ToolBar(toolbar =>
                  {

                  })
                  .Editable(editable => editable.Mode(GridEditMode.InLine))
                  .Scrollable()
                   .Filterable()
                  .DataSource(dataSource => dataSource
                      .Ajax()
                      .Model(model =>
                      {
                          model.Id(p => p.ItemTransferDistributionID);
                          model.Field(p => p.AccountDesc).Editable(false);
                          model.Field(p => p.Credit).Editable(false);
                          model.Field(p => p.Debit).Editable(false);


                      })
                      .Aggregates(aggregate =>
                      {
                          aggregate.Add(p => p.Credit).Sum();
                          aggregate.Add(p => p.Debit).Sum();

                      })
                      .Read(read => read.Action("ItemTransferDistributions_Read", "TransferSendDistribution", new { id = "#=ItemTransferID #" }))
                      .Create(create => create.Action("ItemTransferDistributions_Create", "TransferSendDistribution"))
                      .Update(update => update.Action("ItemTransferDistributions_Update", "TransferSendDistribution"))
                      .Destroy(destroy => destroy.Action("ItemTransferDistributions_Destroy", "TransferSendDistribution"))
                  ).ToClientTemplate())

