@helper PrFileUpload()
{
    @(Html.Kendo().Grid<PurchaseRequisitionAttachment>()
          .Name("PurchaseRequisitionAttachment_#=PurchaseRequisitionID#")
          .Columns(columns =>
          {
              columns.Bound(c => c.FileName).ClientTemplate("<a href='/PurchaseRequisitionAttachment/FileDwonload?id=\\#=PurchaseRequisitionAttachmentId \\#'>\\#=FileName \\#</a>").Width(200);
              columns.Command(command => { command.Edit(); command.Destroy(); }).Width(580);
          })
          .ToolBar(t => t.Template(
              @<text>
                  @(Html.Kendo().Upload()
                        .Name("PurchaseRequisitionAttachments")
                        .Async(a => a.Save("PurchaseRequisitionAttachments_Create", "PurchaseRequisitionAttachment", new { id = "#=PurchaseRequisitionID #" }))
                        .Events(e => e.Complete("prAttachementSuccess"))
                        .ShowFileList(false)
                        .ToClientTemplate())
               </text>
              ))

          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .HtmlAttributes(new { style = "height: 350px;" })
          .Scrollable()
          .Events(x => x.DataBound("onDataBoundLineNew"))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Events(ev => ev
                  .Error("error_handler(\"PurchaseRequisitionAttachment_#=PurchaseRequisitionID#\")")
                  .RequestStart("onRequestStart(\"PurchaseRequisitionAttachment_#=PurchaseRequisitionID#\")")
                  .RequestEnd("onRequestEnd(\"PurchaseRequisitionAttachment_#=PurchaseRequisitionID#\")"))
              .Model(model => model.Id(p => p.PurchaseRequisitionAttachmentId))
              .Read(read => read.Action("PurchaseRequisitionAttachments_Read", "PurchaseRequisitionAttachment", new { id = "#= PurchaseRequisitionID #" }))
              .Create(create => create.Action("PurchaseRequisitionAttachments_Create", "PurchaseRequisitionAttachment", new { id = "#=PurchaseRequisitionID #" }))
              .Update(update => update.Action("PurchaseRequisitionAttachments_Update", "PurchaseRequisitionAttachment" ))
              .Destroy(destroy => destroy.Action("PurchaseRequisitionAttachments_Destroy", "PurchaseRequisitionAttachment"))
          ).ToClientTemplate())
}

<script>

    function prAttachementSuccess(e) {
        var gridname = "#PurchaseRequisitionAttachment_" + codeid;
        $(gridname).data("kendoGrid").dataSource.read();
    }

    function filterItems() {

        return {
            itemCategoryCode: $("#CatCode").data("kendoDropDownList").value(),
            text: $("#ItmCode").data("kendoDropDownList").filterInput.val()
        };
    }

     var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    var isapproved;
    var issecondapproved;
    var isSendForApproval;
    var ismiddleapproved;
    var ismiddleSendForApproval;
    var isOnlineTransferred;
    var nextApprover;

    function detailExpandStockRequisition(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        //codeid = masterDataItem.StoreRequisitionID;
        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        ismiddleapproved = masterDataItem.IsMiddleOnlineApproved;
        ismiddleSendForApproval = masterDataItem.IsMiddleSendForApproval;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;
        nextApprover = masterDataItem.NextApprover;

    }
    function onDataBoundMasterStockRequisition() {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved || gridData[i].IsSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var data = this.dataSource.data();
        $.each(data, function (i, row) {
            if (row.get("IsOnlineApproved") === "true") {
                var element1 = $('tr[data-uid="' + row.uid + '"] ');
                element1.addClass("approved-row");
            }

            if (row.get("IsSecondOnlineApproved") === "true") {
                var element2 = $('tr[data-uid="' + row.uid + '"] ');
                element2.addClass("secondapproved-row");
            }

            if (row.get("IsVoid") === "true") {
                var element3 = $('tr[data-uid="' + row.uid + '"] ');
                element3.addClass("void-row");
            }
        });
    }
    function onDataBoundLinesStockRequisition(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionItem_" + codeid;
        if (isapproved || isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundFisrtValidationStockRequisition(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionValidation_" + codeid;

        if (isapproved || !isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }
    function onDataBoundSecondValidationStockRequisition(e) {
        var detailGrid = "#" + e.sender.element[0].id;

        if (ismiddleapproved || !ismiddleSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        var currentuser =@Html.Raw(Json.Encode(ViewBag.User));

        if (currentuser !== nextApprover)
        {
            $(".k-grid-add", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }


    var supplierTextBox;
    var popup;
    var slectedUser;
    function SelectApprover(e) {

        supplierTextBox = $(e).prev('input').attr('id');
        popup = window.open('/Common/GlobalDataProvider/GetInventorySecondApproverSelector', 'WindowPopup', 'top=100, left=400, width=300, height=220,resizable=no,');
        popup.focus();
        return false;
    }

    function setChoice(user) {
        slectedUser = user;
        $("#" + supplierTextBox).val(slectedUser).trigger("change");
    }


    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "PurchaseRequisitionManual", new { area = "Inventory" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function sendForSecondApproval(id) {
        var recordStatus = "";
        var user = $("#NextApprover").val();
        if (user.length === 0)
            alert("Please select approver");
        else {
            $.ajax({
                type: "POST",
                url: '@Url.Action("SendForSecondApproval", "PurchaseRequisitionManual", new { area = "Inventory" })',
                data: {
                    id: id,
                    user: user
                },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function voidRecord(id) {
    var recordStatus = "";
    var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
    if (conf === true) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("Void", "PurchaseRequisitionManual", new {area = "Inventory" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
}

    function onItemEdit(e) {

        if (e.model.isNew() === false) {
