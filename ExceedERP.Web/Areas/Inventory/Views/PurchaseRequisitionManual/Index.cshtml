@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using ExceedERP.Core.Domain.Procurement.PR
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Manual Purchase Requisition</legend>
@(Html.Kendo().Grid<PurchaseRequisition>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.PurchaseRequisitionID).Title("PR No.").Width(110).ClientTemplate("#=appendZeros(PurchaseRequisitionID)#");
          //columns.Bound(c => c.StoreRequisitionID).Title("SR No.").EditorTemplateName("StoreRequisitionSelector").Width(110);
          columns.Bound(c => c.RequestDate).Width(110);
          columns.Bound(c => c.ReferenceNo).Title("Reference").Width(130);
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(200);

          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(160).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(140).EditorTemplateName("EmployeeSelector");
          // columns.ForeignKey(p => p.ProcurementOfficer, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Procurement Officer").Width(170).EditorTemplateName("EmployeeSelector");
          if (GlobalHelper.IsPayrollModebranchAndBusinessUnit())
          {
              columns.ForeignKey(c => c.ForBusinessUnitId, (IEnumerable)ViewData["BusinessUnits"], "BusinessUnitId", "Name").Width(180).EditorTemplateName("BusinessUnitSelector");
          }
          columns.ForeignKey(p => p.ForBranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(200);
          columns.Bound(c => c.ModelNo).Width(110);
          columns.Bound(c => c.PlateNo).Width(110);
          columns.Bound(c => c.Remark).Width(110);
          columns.Bound(c => c.Status).Width(110);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
              .Events(ev => ev.DetailExpand("detailExpandStockRequisition"))
                .ToolBar(toolbar =>
                {
                    toolbar.Create();
                })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("PurchaseRequisition").Window(w => w.Title("Purchase Requisition")))
             .HtmlAttributes(new { style = "height: 550px;" })
            .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(20))
            .Scrollable()
            .Sortable()
            .Filterable()
                 .Selectable(selectable =>
                 {
                     selectable.Mode(GridSelectionMode.Single);
                     selectable.Type(GridSelectionType.Row);
                 })
                .Sortable(sortable =>
                {
                    sortable.SortMode(GridSortMode.SingleColumn);
                })


           .Events(x => x.DataBound("onDataBoundMasterStockRequisition"))
      .DataSource(dataSource => dataSource
          .Ajax()
                   .Sort(sort => sort.Add("PurchaseRequisitionID").Descending())
                  .Events(ev => ev
                                        .Error("error_handler(\"grid\")")
                                        .RequestStart("onRequestStart(\"grid\")")
                                        .RequestEnd("onRequestEnd(\"grid\")"))
              .Model(model =>
              {
                  model.Id(p => p.PurchaseRequisitionID);
                  model.Field(p => p.PurchaseRequisitionID).Editable(false);
                  model.Field(p => p.StoreRequisitionID).Editable(false);
                  model.Field(p => p.OrgStructureId).Editable(false);
                  model.Field(p => p.BusinessUnitId).Editable(false);
                  // model.Field(p => p.EmployeeId).Editable(false);
                  // model.Field(p => p.BranchId).Editable(false);
                  //model.Field(p => p.ForBranchId).Editable(false);
                  model.Field(p => p.ProcurementOfficer).Editable(false);
                  model.Field(p => p.ModelNo).Editable(false);
                  model.Field(p => p.Status).Editable(false);
              })
          .Read(read => read.Action("PurchaseRequisitions_Read", "PurchaseRequisitionManual"))
          .Create(create => create.Action("PurchaseRequisitions_Create", "PurchaseRequisitionManual"))
          .Update(create => create.Action("PurchaseRequisitions_Update", "PurchaseRequisitionManual"))
          .Destroy(destroy => destroy.Action("PurchaseRequisitions_Destroy", "PurchaseRequisitionManual"))
          ).Resizable(resizable => resizable.Columns(true))
          .ClientDetailTemplateId("purchaserequsitiontemplate")
)

