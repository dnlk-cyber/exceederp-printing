@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Fuel Requisition</legend>

@(Html.Kendo().Grid<StoreRequisition>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.StoreRequisitionID).Title("Request No.").Width(120).ClientTemplate("#=appendZeros(StoreRequisitionID)#");
          columns.Bound(c => c.Reference).Title("Reference").Width(120);
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["inventoryPeriods"], "GLPeriodId", "Name").Width(110).Title("Period").EditorTemplateName("InventoryPeriodSelector");
          columns.Bound(c => c.RequestDate).Width(120);
          columns.ForeignKey(p => p.StoreCode, (IEnumerable)ViewData["storesInCompany"], "StoreCode", "Name").Title("Store").Width(160).EditorTemplateName("StoreSelector");
          columns.Bound(c => c.IsTransfer).EditorTemplateName("IsTransferRequest").ClientTemplate("<input type='checkbox' disabled = 'true'  value='#=IsTransfer #' " + " # if (IsTransfer) { #" + "checked='checked'" + "# } #" + " />").Width(90);
          columns.ForeignKey(p => p.ToStoreCode, (IEnumerable)ViewData["storesInCompany"], "StoreCode", "Name").Title("To Store").Width(160).EditorTemplateName("StoreSelector");
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("AllBranchSelector").Width(200);
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(160).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(160).EditorTemplateName("EmployeeSelector");
          columns.Bound(c => c.IsExternalDriver).ClientTemplate("<input type='checkbox' disabled = 'true'  value='#=IsExternalDriver #' " + " # if (IsExternalDriver) { #" + "checked='checked'" + "# } #" + " />").Width(90);
          columns.Bound(c => c.ExternalDriver).Width(100);
          columns.Bound(c => c.IsForOther).ClientTemplate("<input type='checkbox' disabled = 'true'  value='#=IsForOther #' " + " # if (IsForOther) { #" + "checked='checked'" + "# } #" + " />").Width(90);
          columns.ForeignKey(p => p.ForBranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("AllBranchSelector").Width(200);
          columns.Bound(c => c.PlateNo).Width(100);
          columns.Bound(c => c.Remark).Width(100);
          columns.Bound(c => c.Status).Width(100);

          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          }).Width(180);

      }).Filterable()
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .ToolBar(toolbar =>
      {
          toolbar.Create();

          /*toolbar.Template(@<text>
                        <div class="toolbar row">
                            <div class="col-md-1">
                                <a class="k-button k-button-icontext k-grid-add" href='#'>Add New</a>
                            </div>
                            <div class="col-md-2 pull-right">
                                @(Html.Kendo().Upload()
                                            .Name("file")
                                            .Async(a => a.Save("StoreRequistion_Import", "FuelRequisition"))
                                            .Events(e => e.Complete("onUploadSuccess").Upload("checkFileType"))
                                            .ShowFileList(false)
                                )
                            </div>

                        </div>

                    </text>);*/
      })
      .Events(ev => ev.Edit("onMasterEdit"))

      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("StoreRequisition").Window(w => w.Title("Fuel Requisition")))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Sortable()
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })

      .Events(ev => ev.DetailExpand("detailExpand"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("StoreRequisitionID").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .PageSize(20)
          .Model(model =>
          {
              model.Id(p => p.StoreRequisitionID);
              model.Field(p => p.StoreRequisitionID).Editable(false);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.BusinessUnitId).Editable(false);
              // model.Field(p => p.GLPeriodId).Editable(false);
              model.Field(p => p.OrgStructureId).Editable(false);
              // model.Field(p => p.EmployeeId).Editable(false);

              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.LastModified).Editable(false);
              model.Field(p => p.Status).Editable(false);

              //model.Field(p => p.RequestDate).Editable(false);
          })
          .Read(read => read.Action("FuelRequisitions_Read", "FuelRequisition"))
          .Create(create => create.Action("FuelRequisitions_Create", "FuelRequisition"))
          .Update(update => update.Action("FuelRequisitions_Update", "FuelRequisition"))
          .Destroy(destroy => destroy.Action("FuelRequisitions_Destroy", "FuelRequisition"))

      ).Resizable(resize => resize.Columns(true))
      .ClientDetailTemplateId("FuelRequisitions"))

