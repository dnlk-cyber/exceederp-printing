                          columns.Bound(c => c.FileName).ClientTemplate("<a href='/StoreReturnAttachmentSelfCare/FileDwonload?id=\\#=StoreReturnAttachmentId \\#'>\\#=FileName \\#</a>").Width(200);
                          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(580);
                      })
                      .ToolBar(t => t.Template(
                        @<text>
                            @(Html.Kendo().Upload()
                                          .Name("storeReturnAttachments")
