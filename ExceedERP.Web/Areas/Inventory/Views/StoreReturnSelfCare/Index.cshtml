<script>

    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "StoreReturn", new { area = "Inventory" })',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendforDepartmentApproval", "StoreReturnSelfCare", new { area = "Inventory" })',
            data: { id: id },
            success: function(result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function(result) {
                alert(result);
            }
        });
    }

    function onSelectedPeriod() {
        var periodId = $("#GLPeriodId").data("kendoDropDownList").value();
        var min = "";
        var max = "";
        if (periodId) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetPeriodDateRangeById", "DataProvider", new {area = "Inventory"})',
            data: { id: periodId },
            success: function (result) {
                min = result.Min;
                max = result.Max;
                //update
                var datepicker = $("#ReturnDate").data("kendoDatePicker");
                datepicker.setOptions({
                    format: "yyyy-MM-dd",
                    min:min,
                    max:max,
                    value: new Date(),
                    change: onDOBChange
                });
            }, //end succ
            error: function (result) {
                alert(result);
            }

                });
                }

    }

    function isForOther(obj) {

        if ($(obj).is(":checked")) {
            $("#forbranchDiv").show();

        } else {
            $("#forbranchDiv").hide();
        }

    }

    function bidSuccess() {

    }


    var storeCode;

    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;

    var isDeptapproved;
    var isDeptSendForApproval;

    function detailExpandMasterDepartment(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.StoreReturnID;
        isDeptapproved = masterDataItem.IsDepartmentOnlineApproved;
        isDeptSendForApproval = masterDataItem.IsDepartmentSendForApproval;
    }
    function onDataBoundMasterDepartment(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsDepartmentOnlineApproved || gridData[i].IsDepartmentSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsDepartmentSendForApproval && !dataItem.IsDepartmentOnlineApproved) {
                row.css("background-color", "lightgreen");
            }
            if (!dataItem.IsDepartmentSendForApproval && !dataItem.IsDepartmentOnlineApproved) {
                row.css("background-color", "lightskyblue");
            }

            if (dataItem.IsBudgetApproved) {
                row.css("background-color", "gold");
            }

            if (dataItem.Paid) {
                row.css("background-color", "honeydew");
            }

            if (dataItem.IsVoid) {
                row.css("background-color", "slategray");
                row.css("color", "black");
            }
        }


    }
    function onDataBoundLineDepartment(e) {

        var detailGrid = "#" + e.sender.element[0].id;
        if (isDeptapproved || isDeptSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundValidationDepartment(e) {


        var detailGrid = "#" + e.sender.element[0].id;

        if (isDeptapproved || !isDeptSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }



        this.table.find(".k-grid-edit").hide();
    }

    function onEdit(e) {
        var masterRow = this.wrapper.closest("tr.k-detail-row").prev(".k-master-row");
        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        storeCode = masterDataItem.StoreCode;
        //    codeid = masterDataItem.GoodSellingAndLendingID;
    }


//}



    function OnIndexCall(elem) {

        var a = codeid;
        $(elem).attr('href', $(elem).attr('href') + '?id=' + a);


    }
    var popup;
    var aCode;


    function SelectItemCode() {

        // codeid = masterDataItem.GoodSellingAndLendingID;
        popup = window.open('/Inventory/DataProvider/ItemFiltering', 'WindowPopup', 'top=100, left=400, width=400, height=320,resizable=no,');
        popup.focus();
        return false;
    }

    function setLang(ItemCode) {
        aCode = ItemCode;
        $("#ItemCode").val(aCode).trigger("change");
    }

    function getItems() {
        return {
            storeCode: storeCode
        }
    }
</script>
  
 