@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Store Return (Self Care)</legend>

@(Html.Kendo().Grid<StoreReturn>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.StoreReturnID).Title("Return No.").Width(130).Width(120).ClientTemplate("#=appendZeros(StoreReturnID)#");
          columns.Bound(c => c.Reference).Width(120);
          columns.Bound(c => c.Reason).Width(120);
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(150).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.ForeignKey(p => p.StoreCode, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Width(150).EditorTemplateName("StoreSelectorByKeeper").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["inventoryPeriods"], "GLPeriodId", "Name").Width(120).Title("Period").EditorTemplateName("InventoryPeriodSelector");
          columns.Bound(c => c.ReturnDate).Width(130);
          columns.Bound(c => c.ConfirmationLetter).Width(130);
          columns.Bound(c => c.IsForOther).Width(130).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= IsForOther #' " +
              "# if (IsForOther) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.ForeignKey(p => p.ForBranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").Width(120);
          columns.Bound(c => c.Remark).Width(120);
          columns.Bound(c => c.Status).Width(80);
          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("StoreReturn").Window(w => w.Title("Store Return")))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()

      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Events(ev => ev.DetailExpand("detailExpandMasterDepartment"))
      .Events(x => x.DataBound("onDataBoundMasterDepartment"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("StoreReturnID").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))

          .Model(model =>
          {
              model.Id(p => p.StoreReturnID);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.BusinessUnitId).Editable(false);
              model.Field(p => p.Status).Editable(false);
              //model.Field(p => p.GLPeriodId).Editable(false);
              model.Field(p => p.StoreReturnID).Editable(false);

               model.Field(p => p.DepartmentOnlineApprovedBy).Editable(false);
                model.Field(p => p.DepartmentOnlineApprovedTime).Editable(false);
                model.Field(p => p.DepartmentSendForApprovalBy).Editable(false);
                model.Field(p => p.DepartmentSendForApprovalTime).Editable(false);
                model.Field(p => p.IsDepartmentOnlineApproved).Editable(false);
                model.Field(p => p.IsDepartmentSendForApproval).Editable(false);
          })
          .Read(read => read.Action("StoreReturns_Read", "StoreReturnSelfCare").Data("sendForgery"))
          .Create(create => create.Action("StoreReturns_Create", "StoreReturnSelfCare").Data("sendForgery"))
          .Update(update => update.Action("StoreReturns_Update", "StoreReturnSelfCare").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("StoreReturns_Destroy", "StoreReturnSelfCare").Data("sendForgery"))
      ).ClientDetailTemplateId("storereturntemplate"))


