@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using Kendo.Mvc

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Issue</legend>

@(Html.Kendo().Grid<Issue>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.IssueID).Title("Issue No.").Width(120).ClientTemplate("#=appendZeros(IssueID)#");
          columns.Bound(c => c.StoreRequisitionID).Title("SR No.").EditorTemplateName("StoreRequisitionSelector").Width(160);
          columns.ForeignKey(p => p.StoreCode, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Width(150).EditorTemplateName("StoreReadOnly").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["inventoryPeriods"], "GLPeriodId", "Name").Width(90).Title("Period").EditorTemplateName("InventoryPeriodSelector").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.IssueDate).Title("Issue Date").Width(100);
          columns.Bound(c => c.PlateNo).Title("Plate No.").Width(100);
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(160).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(200);
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(130).EditorTemplateName("EmployeeSelector");
          columns.ForeignKey(p => p.RecipientId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Recipient").Width(130).EditorTemplateName("EmployeeSelector");
          columns.ForeignKey(p => p.SupplierId, (IEnumerable)ViewData["Suppliers"], "Code", "Name").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.Reference).Title("Issue Reference").Width(90);
          columns.Bound(c => c.Remark).Width(90);
          columns.Bound(c => c.Status).Width(90);
          columns.Command(command =>
          {

              command.Edit();
              command.Destroy();


          }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
          /*toolbar.Template(@<text>
            <div class="toolbar row">
                <div class="col-md-1">
                    <a class="k-button k-button-icontext k-grid-add" href='#'>Add New</a>
                </div>

                <div class="col-md-2 pull-right">
                    @(Html.Kendo().Upload()
                                         .Name("file")
                                         .Async(a => a.Save("Issue_Import", "Issue"))
                                         .Events(e => e.Complete("onUploadSuccess").Upload("checkFileType"))
                                         .ShowFileList(false).Events(events => events .Error("error_handler_one"))

                    )
                </div>
                <div class="pull-right">
                    @Html.Kendo().Button().Name("downloadTemplate").Content("Get Template").Events(events => events.Click("downloadTemplateClicked")).HtmlAttributes(new { @class = "btn btn-primary" })
                </div>
            </div>

        </text>);*/
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Issue").Window(w => w.Title("Issue")))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Sortable()
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })

      .Events(ev => ev.Edit("onMasterEdit"))
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("IssueID").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.IssueID);
              model.Field(p => p.EmployeeId).Editable(false);
              // model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.BusinessUnitId).Editable(false);
              //  model.Field(p => p.OrgStructureId).Editable(false);
              model.Field(p => p.Status).Editable(false);
              // model.Field(p => p.GLPeriodId).Editable(false);
              model.Field(p => p.Owner).Editable(false);
              // model.Field(p => p.IssueDate).Editable(false);
              model.Field(p => p.ForBranchId).Editable(false);
              model.Field(p => p.IssueID).Editable(false);
              model.Field(p => p.IsManual).Editable(false);
              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.LastModified).Editable(false);
          })
          .Read(read => read.Action("Issues_Read", "Issue"))
          .Create(create => create.Action("Issues_Create", "Issue"))
          .Update(update => update.Action("Issues_Update", "Issue"))
          .Destroy(destroy => destroy.Action("Issues_Destroy", "Issue"))
      ).Resizable(x => x.Columns(true))
      .ClientDetailTemplateId("issuetemplate"))

