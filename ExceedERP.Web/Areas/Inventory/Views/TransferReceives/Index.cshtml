<script>

    function filterRequestors() {
        return {
            text: $("#DeliveredBy").data("kendoDropDownList").filterInput.val(),
        }
    }

    function onMasterEdit(e) {
        if (e.model.isNew() === false) {
            $("#ItemTransferID").kendoDropDownList({
                enable: false
            });

        }
    }

    function onSelectTransferID(e) {
        var id = $("#ItemTransferID").data("kendoDropDownList");
        var idValue = id.value();
        if (idValue) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetTransferStore", "DataProvider", new {area = "Inventory"})',
            data: { id: idValue },
            success: function (result) {
                if (result.length > 0) {
                    for (var i = 0; i < result.length; i++) {
                        $("#FromStore").val(result[i].FromStore).trigger("change");
                        $("#ToStore").val(result[i].ToStore).trigger("change");
                    }
                }
            }, //end succ
            error: function (result) {
                alert(result);
            }
            });
            }
    }

    function onSelectDriverType(e) {

        var grid = $("#grid").data("kendoGrid");
        var type = $("#DriverType").data("kendoDropDownList");
        var typeValue = type.value();

        if (typeValue === "1") {
            $("#supplierDiv").show();
            $("#employeeDiv").hide();
        } else if (typeValue === "0") {
            $("#supplierDiv").hide();
            $("#employeeDiv").show();
        }
    }


    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "TransferReceives", new { area = "Inventory" })',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "TransferReceives", new { area = "Inventory" })',
            data: { id: id },
            success: function(result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function(result) {
                alert(result);
            }
        });
    }

    function onSelectedPeriod() {
        var periodId = $("#GLPeriodId").data("kendoDropDownList").value();
        var min = "";
        var max = "";
        if (periodId) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetPeriodDateRangeById", "DataProvider", new {area = "Inventory"})',
            data: { id: periodId },
            success: function (result) {
                min = result.Min;
                max = result.Max;
                //update
                var datepicker = $("#ReceiveDate").data("kendoDatePicker");
                datepicker.setOptions({
                    format: "yyyy-MM-dd",
                    min:min,
                    max:max,
                    value: new Date(),
                    change: onDOBChange
                });
            }, //end succ
            error: function (result) {
                alert(result);
            }

                });
                }

    }

    function filterPeriodsByMyStore() {
        return {
            store: $("#ToStore").val(),
            text: null
        }
    }

    var storeCode;
    var codeid;
    function onEdit(e) {
        var masterRow = this.wrapper.closest("tr.k-detail-row").prev(".k-master-row");
        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        storeCode = masterDataItem.StoreCode;
        codeid = masterDataItem.GoodSellingAndLendingID;
    }


    function getItems() {

        return {
            StoreCode: storeCode
        }

    }
  
   
    function OnIndexCall(elem) {
    }

   
</script>