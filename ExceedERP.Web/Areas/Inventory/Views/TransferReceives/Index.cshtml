@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@{ Layout = "~/Views/Shared/_Layout.cshtml";}
<legend>Item Transfer Receive</legend>

@(Html.Kendo().Grid<ItemTransferReceive>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ItemTransferReceiveId).Title("#").Width(120).ClientTemplate("#=appendZeros(ItemTransferReceiveId)#");
          columns.Bound(c => c.ItemTransferID).Title("Trans. Send. No.").Width(110);//.EditorTemplateName("TransferStoreRequistion");
          columns.Bound(c => c.DocumentRef).Title("Doc Ref No.").Width(100);
          columns.ForeignKey(p => p.FromStore, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Title("From Store").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(p => p.ToStore, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Title("To Store").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.DriverType).EditorTemplateName("TransferType").Width(130);
          columns.ForeignKey(p => p.DeliveredBy, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Driver Name").Width(140).EditorTemplateName("EmployeeSelector");
          columns.ForeignKey(p => p.SupplierName, (IEnumerable)ViewData["suppliers"], "SupplierId", "Name").Title("Supplier Name").Width(140).EditorTemplateName("SupplierSelector");
          columns.Bound(c => c.PlateNo).Title("Plate No.").Width(110);
          columns.Bound(c => c.ReceiveDate).Title("Receive Date").Width(130);
          columns.Bound(c => c.Remark).Width(90);
          columns.Bound(c => c.Status).Width(80);
          columns.Bound(c => c.GLPeriodId).Hidden().Width(150);
          columns.Bound(c => c.BranchId).Hidden().Width(100);

          columns.Command(command =>
          {
              command.Edit();
              //command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar =>
      {

          toolbar.Create();
          //toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("TransferReceives").Window(w => w.Title("Transfer Receive")))
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .Filterable()

      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Scrollable(height => height.Height(500))
      .Events(events => {
          events.DetailExpand("detailExpand");
      })
      .Events(ev => ev.Edit("onMasterEdit"))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ItemTransferReceiveId").Descending())
          .PageSize(20)
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.ItemTransferReceiveId);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.BusinessUnitId).Editable(false);
          })
          .Read(read => read.Action("ItemTransferReceives_Read", "TransferReceives"))
          .Create(create => create.Action("ItemTransferReceives_Create", "TransferReceives"))
          .Update(update => update.Action("ItemTransferReceives_Update", "TransferReceives"))
          .Destroy(destroy => destroy.Action("ItemTransferReceives_Destroy", "TransferReceives"))
      )
      .ClientDetailTemplateId("Itemtransferreceivetemp"))

