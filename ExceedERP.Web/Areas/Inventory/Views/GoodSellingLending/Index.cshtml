    @(Html.Kendo().Grid<GoodSellingAndLendingDistribution>()
                      .Name("gsdistribution_#=GoodSellingAndLendingID#")
                      .Columns(columns =>
                      {
                          
                          columns.Bound(c => c.Description);
                          columns.Bound(c => c.AccountDesc);
                          columns.Bound(c => c.Debit);
                          columns.Bound(c => c.Credit);
                          columns.Command(command =>
                          {
                              command.Edit();
                              command.Destroy();
                          }).Width(180);
                      })
                      .ToolBar(toolbar =>
                      {
                          

                      })
                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                      .Pageable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
                      .Scrollable()
                      .DataSource(dataSource => dataSource
                          .Ajax()
                          .Events(ev => ev .Error("error_handler_one").Sync("sync_handler"))
                          .Model(model => model.Id(p => p.GoodSellingAndLendingDistributionID))
                          .Read(read => read.Action("GoodSellingAndLendingDistributions_Read", "GoodSellingAndLendingDistribution", new { id = "#=GoodSellingAndLendingID#" }))
                          .Create(create => create.Action("GoodSellingAndLendingDistributions_Create", "GoodSellingAndLendingDistribution", new { id = "#=GoodSellingAndLendingID#" }))
                          .Update(update => update.Action("GoodSellingAndLendingDistributions_Update", "GoodSellingAndLendingDistribution"))
                          .Destroy(destroy => destroy.Action("GoodSellingAndLendingDistributions_Destroy", "GoodSellingAndLendingDistribution"))
                      ).ToClientTemplate()
    )*@



</script>

<script>
    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "GoodSellingLending", new { area = "Inventory" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function onSelectedPeriod() {
        var periodName = $("#GLPeriodId").data("kendoDropDownList").value();
        var min = "";
        var max = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPeriodDateRangeById", "DataProvider", new { area = "Inventory" })',
            data: { id: periodName },
            success: function (result) {
                min = result.Min;
                max = result.Max;
                //update
                var datepicker = $("#Date").data("kendoDatePicker");
                datepicker.setOptions({
                    format: "yyyy-MM-dd",
                    min:min,
                    max:max,
                    value: new Date(),
                    change: onDOBChange
                });
            }, //end succ
            error: function (result) {
                alert(result);
            }

        });


    }

    


 
</script>