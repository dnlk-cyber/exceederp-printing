                          .Events(ev => ev
                              .Error("error_handler(\"GoodSellingAndLendingValidations_#=GoodSellingAndLendingID#\")")
                              .RequestStart("onRequestStart(\"GoodSellingAndLendingValidations_#=GoodSellingAndLendingID#\")")
                              .RequestEnd("onRequestEnd(\"GoodSellingAndLendingValidations_#=GoodSellingAndLendingID#\")"))
                          .Model(model =>
                          {
                              model.Id(p => p.GoodSellingAndLendingValidationID);
                              model.Field(p => p.CreatedBy).Editable(false);
                              model.Field(p => p.DateCreated).Editable(false);
                              model.Field(p => p.ModifiedBy).Editable(false);
                              model.Field(p => p.LastModified).Editable(false);
                          }
                          )
                          .Read(read => read.Action("GoodSellingAndLendingValidations_Read", "GoodSellingAndLendingValidation", new {id = "#=GoodSellingAndLendingID#"}))
                          .Create(create => create.Action("GoodSellingAndLendingValidations_Create", "GoodSellingAndLendingValidation", new {id = "#=GoodSellingAndLendingID#"}))
                          .Update(update => update.Action("GoodSellingAndLendingValidations_Update", "GoodSellingAndLendingValidation"))
                          .Destroy(destroy => destroy.Action("GoodSellingAndLendingValidations_Destroy", "GoodSellingAndLendingValidation"))
                      ).ToClientTemplate())

            </text>
              );
      }).ToClientTemplate())
    @*<h6>Distribution</h6>  
    # if (IsOnlineApproved && !IsOnlineTransferred )
    {#
    <a href='@Url.Action("GoodSellingLending_OnlineTransfer", "GoodSellingLending")/#=GoodSellingAndLendingID#'>Transfer</a>
    <br />
