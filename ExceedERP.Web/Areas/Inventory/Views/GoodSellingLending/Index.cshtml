            </dt>
            <dd>
              #= Remark #
            </dd>
        </dl>
        
    </div>

            
               </text>
              );

          items.Add().Text("Item").Content(
              @<text>
                @(Html.Kendo().Grid<GoodSellingAndLendingItem>()
                      .Name("GoodSellingAndLendingItem_#=GoodSellingAndLendingID#")
                      .Columns(columns =>
                      {
                          columns.ForeignKey(p => p.ItemCategoryCode, (IEnumerable)ViewData["Category"], "ItemCategoryCode", "Name").Title("Category").EditorTemplateName("ItemCategorySelector").Width(150);
                          columns.ForeignKey(p => p.ItemCode, (IEnumerable)ViewData["Items"], "ItemCode", "Name").Title("Items").EditorTemplateName("ItemSelector").Width(150);
                          //columns.Bound(c => c.UOM).EditorTemplateName("UoMDisplay").Width(70); 
                          columns.Bound(c => c.QuantitySold).Width(70);
                          columns.Bound(c => c.UnitPurchasingPrice).EditorTemplateName("Currency").Width(70);
                          columns.Bound(c => c.UnitSellingPrice).EditorTemplateName("Currency").Width(70);
                          columns.Bound(c => c.TotalSellingPrice).EditorTemplateName("Currency").Width(70);

                          columns.Command(command =>
                          {
                              command.Edit();
                              command.Destroy();
                          }).Width(180);
                      })
                      .ToolBar(toolbar =>
                      {
                          toolbar.Create();
                      })
                      
                      .Events(x => x.DataBound("onDataBoundLines"))
                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                      .Scrollable()
                      .DataSource(dataSource => dataSource
                          .Ajax()
                          .Events(ev => ev
                              .Error("error_handler(\"GoodSellingAndLendingItem_#=GoodSellingAndLendingID#\")")
                              .RequestStart("onRequestStart(\"GoodSellingAndLendingItem_#=GoodSellingAndLendingID#\")")
                              .RequestEnd("onRequestEnd(\"GoodSellingAndLendingItem_#=GoodSellingAndLendingID#\")"))
                          .Model(model =>
                          {
                              model.Id(p => p.GoodSellingAndLendingItemID);
                              model.Field(p => p.TotalSellingPrice).Editable(false);
                              model.Field(p => p.UnitPurchasingPrice).Editable(false);
                          })
                          .Read(read => read.Action("GoodSellingAndLendingItems_Read", "GoodSellingAndLendingItem", new {id = "#=GoodSellingAndLendingID#"}))
                          .Create(create => create.Action("GoodSellingAndLendingItems_Create", "GoodSellingAndLendingItem", new {id = "#=GoodSellingAndLendingID#"}))
                          .Update(update => update.Action("GoodSellingAndLendingItems_Update", "GoodSellingAndLendingItem" ,new {id = "#=GoodSellingAndLendingID#"}))
                          .Destroy(destroy => destroy.Action("GoodSellingAndLendingItems_Destroy", "GoodSellingAndLendingItem" , new {id = "#=GoodSellingAndLendingID#"}))
                      ).ToClientTemplate())

            </text>
              );

        
          items.Add().Text("Validation").Content(
              @<text>
                @(Html.Kendo().Grid<GoodSellingAndLendingValidation>()
                      .Name("GoodSellingAndLendingValidations_#=GoodSellingAndLendingID#")
                      .Columns(columns =>
                      {
