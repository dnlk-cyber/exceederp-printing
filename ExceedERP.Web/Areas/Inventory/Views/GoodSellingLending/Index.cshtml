            # if (IsOnlineApproved)
            {#
            <a href='@Url.Action("GoodSelling", "InventoryPrint")/#=GoodSellingAndLendingID#' title="Print"><i class="fa fa-print fa-2x"></i></a>
            <br />
            # } # 
             
         <div>
        <hr>
        <dl class="dl-horizontal">
            <dt>
                Sell or Lend
            </dt>
            <dd>
                #= SellOrLend #
            </dd>
            <dt>
                Store
            </dt>
            <dd>
             #= StoreCode #
            </dd>
            <dt>
                Buyer's Name
            </dt>
            <dd>
                #= Buyer #

            </dd>
            <dt>
