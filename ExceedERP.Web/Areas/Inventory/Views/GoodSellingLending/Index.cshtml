@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@(Html.Kendo().Grid<GoodSellingAndLending>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.GoodSellingAndLendingID).Title("No.").Width(120).ClientTemplate("#=appendZeros(GoodSellingAndLendingID)#");
          columns.Bound(c => c.SellOrLend).EditorTemplateName("SalesOrLend").Width(100);
          columns.Bound(c => c.StoreCode).EditorTemplateName("Stores").Width(120);
          columns.Bound(c => c.Buyer).Width(120);
          columns.Bound(c => c.BuyerAddress).Width(120);
          columns.Bound(c => c.Date).Width(120);
          columns.Bound(c => c.Remark).Width(90);
          columns.Bound(c => c.Status).Width(90);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("SaleDonateOrLend").Window(w => w.Title("Good Sales or Donate")))
      .Scrollable(h => h.Height(500))
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("GoodSellingAndLendingID").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.GoodSellingAndLendingID);
              model.Field(p => p.Status).Editable(false);
              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.LastModified).Editable(false);

          })
          .PageSize(20)
         
          .Read(read => read.Action("GoodSellingAndLendings_Read", "GoodSellingLending"))
          .Create(create => create.Action("GoodSellingAndLendings_Create", "GoodSellingLending"))
          .Update(update => update.Action("GoodSellingAndLendings_Update", "GoodSellingLending"))
          .Destroy(destroy => destroy.Action("GoodSellingAndLendings_Destroy", "GoodSellingLending"))
      ).ClientDetailTemplateId("goodsellinglending"))

<script id="goodsellinglending" type="text/Kendo">
    @(Html.Kendo().TabStrip().SelectedIndex(0).Name("tabStrip_#=GoodSellingAndLendingID#").Items(items =>
      {
          items.Add().Text("Detail").Content(
