@using System.Collections
<legend>Branch or Project Items Assignment</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Inventory.BranchItemAssignment>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(200);
          columns.ForeignKey(p => p.ItemCategoryCode, (IEnumerable)ViewData["Category"], "ItemCategoryCode", "Name").EditorTemplateName("ItemCategorySelector").Width(200);
          columns.ForeignKey(p => p.ItemCode, (IEnumerable)ViewData["Items"], "ItemCode", "Name").Title("Item Name").EditorTemplateName("ItemSelector").Width(200);
          columns.Bound(c => c.Balance).Width(130);
          columns.Bound(c => c.AvgPrice).Width(130);
          columns.Bound(c => c.DateCreated).Width(150).Hidden(true);
          columns.Bound(c => c.LastModified).Width(150).Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
            
      }).Filterable()
      .ToolBar(toolbar =>
      {
          // toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Sortable()
      .Filterable()
      
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(
              model =>
              {
                  model.Id(p => p.BranchItemAssignmentId);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);


              })
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("BranchItemAssignments_Read", "BranchItemAssignment"))
          .Create(create => create.Action("BranchItemAssignments_Create", "BranchItemAssignment"))
          .Update(update => update.Action("BranchItemAssignments_Update", "BranchItemAssignment"))
          .Destroy(destroy => destroy.Action("BranchItemAssignments_Destroy", "BranchItemAssignment"))
      ))
