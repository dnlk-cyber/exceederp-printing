<legend>Good Receive</legend>
@(Html.Kendo().Grid<GoodReceive>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.GoodReceiveId).Title("Receive No.").Width(120).ClientTemplate("#=appendZeros(GoodReceiveId)#");
          columns.ForeignKey(p => p.ReceiveTypeId, (IEnumerable)ViewData["ReeceiveType"], "ReceiveTypeId", "Name").EditorTemplateName("ReceiveTypeSelector").Width(150);
          columns.Bound(p => p.ReceiveRef).Width(150);//until data entry.EditorTemplateName("ReceiveReferenceSelector");
          columns.Bound(p => p.Reference).Width(130);
          columns.ForeignKey(p => p.StoreCode, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Width(150).EditorTemplateName("StoreSelectorByKeeper");
          columns.Bound(p => p.SupplierId).Width(90);
          columns.Bound(p => p.SupplierName).Width(150);//upto data entry.EditorTemplateName("ReceiveSupplierSelector");
          columns.Bound(c => c.SupplierInvoiceNo).Title("Supplier Invoice").Width(150);
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["inventoryPeriods"], "GLPeriodId", "Name").Width(130).Title("Period").EditorTemplateName("InventoryPeriodSelector");
          columns.Bound(c => c.ReceiveDate).Title("Receive Date").Width(130);

          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(150);
          columns.Bound(c => c.Status).Width(80);

          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar =>
      {

          toolbar.Create();
          /*toolbar.Template(@<text>
            <div class="toolbar row">
                <div class="col-md-1">
                    <a class="k-button k-button-icontext k-grid-add" href='#'>Add New</a>
                </div>
                <div class="col-md-2 pull-right">
                    @(Html.Kendo().Upload()
                                         .Name("file")
                                         .Async(a => a.Save("ReciveImport", "GoodRecive"))
                                         .Events(e => e.Complete("onUploadSuccess").Upload("checkFileType"))
                                         .ShowFileList(false).Events(events => events .Error("error_handler_one"))

                    )
                </div>

            </div>

        </text>);*/
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("GoodReceive").Window(w => w.Title("Good Receive")))

      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Sortable()
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster")
          .Edit("onMasterEdit"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("GoodReceiveId").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.GoodReceiveId);
              model.Field(p => p.GoodReceiveId).Editable(false);
              model.Field(p => p.Status).Editable(false);
              // model.Field(p => p.ReceiveDate).Editable(false);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.BusinessUnitId).Editable(false);
              model.Field(p => p.IsManual).Editable(false);
              // model.Field(p => p.GLPeriodId).Editable(false);
              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.LastModified).Editable(false);

          })
          .Read(read => read.Action("GoodReceives_Read", "GoodReceiveManual"))
          .Create(create => create.Action("GoodReceives_Create", "GoodReceiveManual"))
          .Update(update => update.Action("GoodReceives_Update", "GoodReceiveManual"))
          .Destroy(destroy => destroy.Action("GoodReceives_Destroy", "GoodReceiveManual"))
      )
      .ClientDetailTemplateId("templates"))

