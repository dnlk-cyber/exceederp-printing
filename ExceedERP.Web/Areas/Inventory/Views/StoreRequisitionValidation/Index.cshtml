@using ExceedERP.Core.Domain.Inventory

@(Html.Kendo().Grid<StoreRequisitionValidation>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Status);
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.StoreRequisitionValidationID))
          .Read(read => read.Action("StoreRequisitionValidations_Read", "StoreRequisitionValidation"))
          .Create(create => create.Action("StoreRequisitionValidations_Create", "StoreRequisitionValidation"))
          .Update(update => update.Action("StoreRequisitionValidations_Update", "StoreRequisitionValidation"))
          .Destroy(destroy => destroy.Action("StoreRequisitionValidations_Destroy", "StoreRequisitionValidation"))
      ))
