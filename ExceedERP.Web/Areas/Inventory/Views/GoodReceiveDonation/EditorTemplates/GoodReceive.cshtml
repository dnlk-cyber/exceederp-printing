@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.Inventory.GoodReceive

 
<form>

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">

            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.PurchaseOrderID)
                </div>
                <div>

                    @(Html.Kendo().DropDownListFor(model => model.PurchaseOrderID)
                      .AutoBind(false)
                      .OptionLabel("Select PurchaseOrder...")
                          .DataTextField("PurchaseOrderID")
                          .DataValueField("PurchaseOrderID")
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetPurchaseOrder", "DataProvider"))
                                    .ServerFiltering(true);
                      }))
                    @Html.ValidationMessageFor(model => model.PurchaseOrderID)
                </div>
            </div>
         
        </div>
        <div class="col-md-3">

            <div class="form-group">

                <div class="k-label">
                    @Html.LabelFor(model => model.StoreCode)

                </div>
                <div>

                    @(Html.Kendo().DropDownListFor(model => model.StoreCode)
                          .AutoBind(false)
                          .OptionLabel("Select Store...")
                          .DataTextField("Name")
                          .DataValueField("StoreCode")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetStore", "DataProvider"))
                                  .ServerFiltering(true);
                          })
                    )

                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.SupplierName)

                </div>
                <div>
                  
                    @Html.Kendo().TextBoxFor(model => model.SupplierName)
                    @Html.ValidationMessageFor(model => model.SupplierName)
                </div>
            </div>
        </div>
    </div>


    <br />
    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.SupplierInvoiceNo)
            </div>
            <div class="form-group">
              
                @Html.Kendo().TextBoxFor(model => model.SupplierInvoiceNo)
                @Html.ValidationMessageFor(model => model.SupplierInvoiceNo)
            </div>
        </div>
       
        <div class="col-md-3">
                <div>
                    @Html.LabelFor(model => model.ReceiveDate)
                    
                </div>
                <div class="form-group">
                     
                        @Html.Kendo().DateTimePickerFor(model => model.ReceiveDate)
                        @Html.ValidationMessageFor(model => model.ReceiveDate)
                    </div>
            </div>

        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Remark)


            </div>
            <div class="form-group">
                @Html.Kendo().TextBoxFor(model => model.Remark)
                @Html.ValidationMessageFor(model => model.Remark)
            </div>
        </div>
    </div>

</form>