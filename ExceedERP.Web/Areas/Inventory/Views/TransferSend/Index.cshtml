@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Item Transfer Send</legend>

@(Html.Kendo().Grid<ItemTransfer>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ItemTransferID).Title("Transfer No.").Width(120).ClientTemplate("#=appendZeros(ItemTransferID)#");
          columns.Bound(c => c.StoreRequisitionID).Title("Req. No.").EditorTemplateName("TransferStoreRequistion").Width(110).ClientTemplate("#=appendZeros(StoreRequisitionID)#"); ;
          columns.Bound(c => c.DocumentRef).Title("Doc Ref No.").Width(110);
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["inventoryPeriods"], "GLPeriodId", "Name").Width(110).Title("Period").EditorTemplateName("InventoryPeriodSelector");
          columns.Bound(c => c.TransferDate).Title("Transfer Date").Width(130);
          columns.ForeignKey(p => p.FromStore, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Title("From Store").Width(120);
          columns.ForeignKey(p => p.ToStore, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Title("To Store").Width(120);
          columns.Bound(c => c.DriverType).EditorTemplateName("TransferType").Width(130);
          columns.ForeignKey(p => p.DeliveredBy, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Driver Name").Width(150).EditorTemplateName("EmployeeSelector");
          columns.ForeignKey(p => p.SupplierName, (IEnumerable)ViewData["suppliers"], "SupplierId", "Name").Title("Supplier Name").Width(150).EditorTemplateName("SupplierSelector");
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(130).EditorTemplateName("EmployeeSelector");
          columns.Bound(c => c.PlateNo).Title("Plate No.").Width(130);
          columns.Bound(c => c.Remark).Width(90);
          columns.Bound(c => c.Status).Width(90);
          columns.Bound(c => c.BranchId).Hidden().Width(100);



          columns.Command(command => {
              command.Edit();
              command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Events(ev => ev.DetailExpand("detailExpand").Edit("onMasterEdit"))
      .Sortable()
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })

      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ItemTransfer").Window(w => w.Title("Transfer")))
      .Scrollable(height => height.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ItemTransferID").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.ItemTransferID);
              model.Field(p => p.ItemTransferID).Editable(false);
              model.Field(p => p.FromStore).Editable(false);
              model.Field(p => p.ToStore).Editable(false);
              model.Field(p => p.Status).Editable(false);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.BusinessUnitId).Editable(false);
              model.Field(p => p.EmployeeId).Editable(false);

              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.LastModified).Editable(false);

          })
          .Read(read => read.Action("ItemTransfers_Read", "TransferSend"))
          .Create(create => create.Action("ItemTransfers_Create", "TransferSend"))
          .Update(update => update.Action("ItemTransfers_Update", "TransferSend"))
          .Destroy(destroy => destroy.Action("ItemTransfers_Destroy", "TransferSend"))
      ).Resizable(x => x.Columns(true)).Reorderable(x => x.Columns(true))
      .ClientDetailTemplateId("Itemtransfertemplate"))

