<script>

    function onSelectDriverType(e) {

        var grid = $("#grid").data("kendoGrid");
        var type = $("#DriverType").data("kendoDropDownList");
        var typeValue = type.value();

        if (typeValue === "1") {
            $("#supplierDiv").show();
            $("#employeeDiv").hide();
        } else if (typeValue === "0") {
            $("#supplierDiv").hide();
            $("#employeeDiv").show();
        }
    }

    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "TransferSend", new { area = "Inventory" })',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "TransferSend", new { area = "Inventory" })',
            data: { id: id },
            success: function(result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function(result) {
                alert(result);
            }
        });
    }


    function onSelectedPeriod() {
        var periodId = $("#GLPeriodId").data("kendoDropDownList").value();
        var min = "";
        var max = "";
        if (periodId) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetPeriodDateRangeById", "DataProvider", new {area = "Inventory"})',
            data: { id: periodId },
            success: function (result) {
                min = result.Min;
                max = result.Max;
                //update
                var datepicker = $("#TransferDate").data("kendoDatePicker");
                datepicker.setOptions({
                    format: "yyyy-MM-dd",
                    min:min,
                    max:max,
                    value: new Date(),
                    change: onDOBChange
                });
            }, //end succ
            error: function (result) {
                alert(result);
            }

                });
                }

    }

    function filterPeriodsByMyStore() {
        return {
            store: $("#FromStore").val(),
            text: null
        }
    }

    function onSelectStoreRequisitionID(e) {
        var id = $("#StoreRequisitionID").data("kendoDropDownList").value();

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetTransferStoreCodes", "DataProvider", new { area = "Inventory" })',
            data: { id: id },
            success: function (result) {
                console.log(result);
                if (result.length > 0) {

                    for (var i = 0; i < result.length; i++) {
                        $("#FromStore").val(result[i].FromStoreCode).trigger("change");
                        $("#ToStore").val(result[i].ToStoreCode).trigger("change");
                    }
                }
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });


    }

    function onMasterEdit(e) {
        //var grid = $("#grid").data("kendoGrid");
        //grid.hideColumn("SupplierName");

        if (e.model.isNew() === false) {
            $("#StoreRequisitionID").kendoDropDownList({
                enable: false
            });

        }

    }



