@using ExceedERP.Core.Domain.Inventory

@(Html.Kendo().Grid<PurchaseReturnValidation>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Status);
        columns.Bound(c => c.Remark);
        columns.Bound(c => c.DateCreated);
        columns.Bound(c => c.LastModified);
        columns.Bound(c => c.CreatedBy);
        columns.Bound(c => c.ModifiedBy);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.PurchaseReturnValidationID))
          .Read(read => read.Action("PurchaseReturnValidations_Read", "PurchaseReturnValidation"))
          .Create(create => create.Action("PurchaseReturnValidations_Create", "PurchaseReturnValidation"))
          .Update(update => update.Action("PurchaseReturnValidations_Update", "PurchaseReturnValidation"))
          .Destroy(destroy => destroy.Action("PurchaseReturnValidations_Destroy", "PurchaseReturnValidation"))
      )
)
