<script>
    function GetData() {

        var employee = $("#Sender").data("kendoDropDownList");
        var empId = employee.value();
        $.ajax({
            url: '@Url.Action("GetData", "EmployeeIncoming")',
            data: { empId: empId },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#Shelve").data("kendoDropDownList").value(result.Shelve);
                $("#Shelve").trigger("change");
                $("#Row").data("kendoDropDownList").value(result.Row);
                $("#Row").trigger("change");
                $("#FileNo").data("kendoDropDownList").value(result.FileNo);
                $("#FileNo").trigger("change");
                $("#FolderNo").data("kendoDropDownList").value(result.Folder);
                $("#FolderNo").trigger("change");
            }
        });
    }
    
</script>

<script>

 function OpenAttachementWindow(id) {

     $("#Attachement_EmployeeIncomingId").val(id);

            var wnd = $("#IncomingAttachementWindow").data("kendoWindow");
            wnd.center().open();
    }


    function AttachArchiveFiles() {
        try {
            var ac = '@ArchiveCategory.Employee';
            var lt = '@LetterType.Incoming';
            $.ajax({
                url: '@Url.Action("UploadIncomingLetters_MultipleFile", "ArchiveAttachments")',
                //contentType: "application/json; charset=utf-8",
                data: function () {
                    var data = new FormData();

                   // var kkk = $("#letter").get(0).files[0];
                    var ins = document.getElementById('letter').files.length;
                    for (var x = 0; x < ins; x++) {

                        data.append("letter[" + x + "]", document.getElementById('letter').files[x]);
                    }
                   // data.append("file", $("#letter").get(0).files[0]);
                    data.append("description", $("#description").val());
                    data.append("masterId", $("#Attachement_EmployeeIncomingId").val());
                    data.append("ac", ac);
                    data.append("lt", lt);
                    return data;
                }(),
                type: 'POST',
                contentType: false,
                processData: false,
                cache: false,
                success: function (result) {
                    var wnd = $("#IncomingAttachementWindow").data("kendoWindow");
                    wnd.close();

                    var id = $("#Attachement_EmployeeIncomingId").val();
                    $("#ArchiveAttachementGrid" + id).data("kendoGrid").dataSource.read();
                }
            });
        } catch (e) {
            // alert("Please select the row!!");
        }
    }

</script>


