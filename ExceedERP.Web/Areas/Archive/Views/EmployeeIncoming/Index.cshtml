<legend>@Resources.View_EmployeeIncommingLetterRegistration_Header</legend>
@(Html.Kendo().Grid<EmployeeIncomingLetter>()
          .Name("EmployeeIncomming")
          .Columns(columns =>
          {
              //columns.Bound(c => c.BookNo).Width(150);
              //columns.Bound(c => c.LetterDate).Width(150);
              //columns.Bound(c => c.LetterReferenceNo).Width(200);
              //columns.Bound(c => c.RecivedDate).Width(150);
              columns.ForeignKey(c => c.Sender, (System.Collections.IEnumerable)ViewData["Employee"], "EmployeeId", "FullNameaEnglish").Width(150);
              columns.Bound(c => c.RecivedDateAmharic).Width(150);
              columns.Bound(c => c.RecivedTime).Width(100);
              columns.Bound(c => c.Subject).Width(100);
              columns.Bound(c => c.RoomNo).Width(100);
              columns.Bound(c => c.Shelve).Width(100);
              columns.Bound(c => c.Row).Width(100);
              columns.Bound(c => c.FolderNo).Width(100);
              columns.Bound(c => c.VolumeNo).Width(100);
              columns.Bound(c => c.FileNo).Width(100);

              columns.Command(command =>
              {
                  if (HttpContext.Current.User.IsInRole("Archive_User"))
                  {
                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  }
              }).Width(200);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("NewIncomming").Window(window => { window.Title(""); window.Scrollable(false); }))

          .Scrollable(h => h.Height(500))
          .Groupable()
          .Events(x =>
          {
              x.Edit("GetDate");
              x.Save("GetDate");
              x.DetailExpand("DetailExpand");
              x.DataBound("mainDataBound");
          })
          .Filterable()
          .Pageable(pageable => pageable
              .Input(true)
              .Numeric(false)
              .Refresh(true)
              .PageSizes(true)
              .ButtonCount(5))
              .DataSource(dataSource => dataSource
              .Ajax()
              .Sort(sort => sort.Add(x=>x.EmployeeIncomingLetterId).Descending())
              .Events(events =>
              {
                  events.Error("error_handler(\"EmployeeIncomming\")");
                  events.RequestStart("onRequestStart(\"EmployeeIncomming\")");
                  events.RequestEnd("onRequestEnd(\"EmployeeIncomming\")");
              })

              .Model(model => model.Id(p => p.EmployeeIncomingLetterId))
              .Read(read => read.Action("EmployeeIncoming_Read", "EmployeeIncoming"))
              .Create(create => create.Action("EmployeeIncoming_Create", "EmployeeIncoming"))
              .Update(update => update.Action("EmployeeIncoming_Update", "EmployeeIncoming"))
              .Destroy(destroy => destroy.Action("EmployeeIncoming_Destroy", "EmployeeIncoming"))
          ).ClientDetailTemplateId("template"))

