@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.Archive.EmployeeLetterSender

<div class="form">
    <div class="row fullrow">
       
        <div class="col-md-3 ro1">

            <div class="form-group">
                @Html.LabelFor(model => model.Receiver, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.Receiver)
                      .OptionLabel(Resources.Select)
                      .Filter("contains")
                      .MinLength(2)
                      .DataTextField("Name")
                      .DataValueField("OrgStructureId")
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetDepartments", "ArchiveDataProvider", new { area = "Archive" }))
                         .ServerFiltering(false);
                      })

                       .ValuePrimitive(true)
                    )
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-8" })
               <div class="col-md-6">
                    @*@Html.Kendo().TextBoxFor(model => model.TransferDescription)*@
                 <textarea id="Description" name="Description" cols="40" rows="5"></textarea>             
              </div>
            </div>
        </div>     
    </div>
</div>


<style>
    div.k-edit-form-container {
        width: 300px;
    }
</style>