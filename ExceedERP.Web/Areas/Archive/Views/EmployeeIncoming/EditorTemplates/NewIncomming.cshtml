                                        .DataSource(dataSource =>
                                        {
                                          dataSource.Read(read => read.Action("GetFile", "EmployeeIncoming", new { area = "Archive" }))
                                          .ServerFiltering(false);
                                        })
                                        .Enable(false)
                                        .DataTextField("FileNo")
                                        .DataValueField("FileNo")
                                        .ValuePrimitive(true)
                                     )
                                 </div>
                             </div> 
                           </div>
         <div class="col-md-4 ro1">
                <div class="form-group">

                    @Html.LabelFor(model => model.LetterAmharic, htmlAttributes: new { @class = "control-label col-md-8" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.LetterAmharic, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />

                        @Html.ValidationMessageFor(model => model.LetterAmharic, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.RecivedDateAmharic, htmlAttributes: new { @class = "control-label col-md-8" })

                    <div class="col-md-10">

                        @Html.TextBoxFor(model => model.RecivedDateAmharic, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />

                        @Html.ValidationMessageFor(model => model.RecivedDateAmharic, "", new { @class = "text-danger" })

                    </div>
                </div>          
              
                <div class="form-group">
                    @Html.LabelFor(model => model.RecivedTime, htmlAttributes: new { @class = "control-label col-md-8" })
