            <div class="form-group">
                @Html.LabelFor(model => model.Sender, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.Sender)
                         .DataValueField("EmployeeId")
                         .DataTextField("FullNameAmharic")
                         .OptionLabel(Resources.Select)
                          .Filter("contains")
                          .MinLength(2)
                          .HtmlAttributes(new { style = "width:160px" })
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetAllEmployees", "ArchiveDataProvider", new { area = "Archive" }))
                               .ServerFiltering(false);
                          })
                         .ValuePrimitive(true)
                         .Height(400)
                         .Events(e => e.Change("GetData"))
                    )
                </div>
            </div>

        </div>
        <div class="col-md-3 ro1">                 

            <div class="form-group">
                @Html.LabelFor(model => model.Shelve, htmlAttributes: new { @class = "control-label col-md-8" })

                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.Shelve)
                       .OptionLabel(Resources.Select)
                       .DataSource(dataSource =>
                       {
                           dataSource.Read(read => read.Action("GetShelve", "EmployeeIncoming", new { area = "Archive" }))
                           .ServerFiltering(false);
                       })
                        .Enable(false)
                        .DataTextField("Shelve")
                        .DataValueField("Shelve")
                        .ValuePrimitive(true)
                    )
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.RoomNo, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.RoomNo)
                    @Html.ValidationMessageFor(model => model.RoomNo, "", new { @class = "text-danger" })
                </div>
            </div>    

            <div class="form-group">
                @Html.LabelFor(model => model.Row, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-10">
                    @(Html.Kendo().DropDownListFor(model => model.Row)
                                   .OptionLabel(Resources.Select)
                                   .DataSource(dataSource =>
                                   {
                                       dataSource.Read(read => read.Action("GetRows", "EmployeeIncoming", new { area = "Archive" }))
                                       .ServerFiltering(false);
                                   })
                                      .Enable(false)
                                      .DataTextField("Row")
                                      .DataValueField("Row")
                                      .ValuePrimitive(true)
                    )
                </div>
            </div>


                      <div class="form-group">
                          @Html.LabelFor(model => model.FolderNo, htmlAttributes: new { @class = "control-label col-md-8" })
