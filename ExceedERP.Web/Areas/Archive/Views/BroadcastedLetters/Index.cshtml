  function OpenAttachementWindow(id) {

      $("#Attachement_MultipleEmployeeId").val(id);

      var wnd = $("#MultipleEmployeeAttachementWindow").data("kendoWindow");
            wnd.center().open();
    }


    function AttachEmployeeLetter() {
        try {

            $.ajax({
                url: '@Url.Action("UploadEmployeeLetters", "LetterReceivers")',
                //contentType: "application/json; charset=utf-8",
                data: function () {
                    var data = new FormData();

                    data.append("file", $("#empLetter").get(0).files[0]);
                    data.append("description", $("#description").val());
                    data.append("masterId", $("#Attachement_MultipleEmployeeId").val());
                    return data;
                }(),
                type: 'POST',
                contentType: false,
                processData: false,
                cache: false,
                success: function (result) {
                    var wnd = $("#MultipleEmployeeAttachementWindow").data("kendoWindow");
                    wnd.close();

                    $("#ArchiveAttachementGrid" + institutionIncomingLetterId).data("kendoGrid").dataSource.read();
                }
            });
        } catch (e) {
            // alert("Please select the row!!");
        }
    }

</script>


@(Html.Kendo().Window().Name("MultipleEmployeeAttachementWindow")
    .Title(Resources.HR_ArchiveManagement_Answer)
    .Visible(false)
    .Modal(true)
      .Content(@<text>

        <input type="text" id="Attachement_MultipleEmployeeId" name="Attachement_MultipleEmployeeId" hidden />
        <div class="editor-field">
            @Html.TextBox("empLetter", "", new { type = "file" })
        </div>

        <br />
        <div class="editor-field">
            @Html.TextArea("description", null, new { placeholder = "Description", style = "width: 90%; max-width: 90%;height:60%" })
        </div>
        <br />

        <div class="pull-right">
            @Html.Kendo().Button().Name("btnTo").Content("Upload").Events(e => e.Click("AttachEmployeeLetter"))

        </div>

    </text>)
      .Pinned(true)
      .Draggable(true)
      .Width(300)
)