@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@using System.Collections
@model ExceedERP.Core.Domain.Archive.InstitutionArchiveNo
<div class="form">
    <div class="row fullrow">
        <div class="col-md-3 ro1">

            <div class="form-group">

                @Html.LabelFor(model => model.SubjectTypeId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.SubjectTypeId)
                      .OptionLabel(Resources.Select)
                      .Filter("contains")
                      .MinLength(2)
                       .DataTextField("SubjectTypeName")
                       .DataValueField("SubjectTypeId")
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetSubjectType", "ArchiveDataProvider"))
                              .ServerFiltering(false);
                      })
                      .ValuePrimitive(true)

                    )
                </div>
            </div>
          
            <div class="form-group">

                @Html.LabelFor(model => model.BranchId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.BranchId)
                       .OptionLabel(Resources.Select)
                       .Filter("contains")
                       .MinLength(2)
                        .DataTextField("Name")
                        .DataValueField("BranchId")
                       .DataSource(dataSource =>
                       {
                           dataSource.Read(read => read.Action("GetBranches", "ArchiveDataProvider"))
                               .ServerFiltering(false);
                       })
                       .ValuePrimitive(true)

                    )
                    @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger" })
                </div>
            </div>


          

        </div>
        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.RoomNo, htmlAttributes: new { @class = "control-label col-md-8" })

                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.RoomNo)
                    @Html.ValidationMessageFor(model => model.RoomNo, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Shelve, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">

                    @Html.Kendo().TextBoxFor(model => model.Shelve)
                    @Html.ValidationMessageFor(model => model.Shelve, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Row, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Row)
                    @Html.ValidationMessageFor(model => model.Row, "", new { @class = "text-danger" })
                </div>
            </div> 
        </div>

        <div class="col-md-4 ro1">        

            <div class="form-group">
                @Html.LabelFor(model => model.Folder, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Folder)
                    @Html.ValidationMessageFor(model => model.Folder, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Volume, htmlAttributes: new { @class = "control-label col-md-8" })

                <div class="col-md-10">
                    @Html.Kendo().TextBoxFor(model => model.Volume)
                    @Html.ValidationMessageFor(model => model.Volume, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.FileNo, htmlAttributes: new { @class = "control-label col-md-8" })

                <div class="col-md-10">
                    @Html.Kendo().TextBoxFor(model => model.FileNo)
                    @Html.ValidationMessageFor(model => model.FileNo, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
</div>
