@using System.Collections
@using ExceedERP.Core.Domain.Archive
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorArchiveManagement_PersonalFolderExplorer</legend>
@(Html.Kendo().Grid<PersonalArchiveNo>()
      .Name("PersonalArchiveNogrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("ListOfEmployee").Width(250).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.EmployeeCode).Width(200);
          //columns.ForeignKey(c => c.ZoneId, (IEnumerable)ViewData["Zones"], "ZoneId", "ZoneName").EditorTemplateName("Zone").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "AmharicName").EditorTemplateName("Branch").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
          columns.Bound(c => c.RoomNo).Width(120);
          columns.Bound(c => c.Shelve).Width(120);
          columns.Bound(c => c.Row).Width( 120);
          columns.Bound(c => c.Folder).Width(120);
          columns.Bound(c => c.FileNo).Width( 120);
          columns.Bound(c => c.Volume).Width(120);
          // columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
      toolbar.Template(@<text>
<div class="toolbar">
  
    @*<label class="category-label" for="Folder">@Resources.HR_Archive_SelectFolderNo</label>
    @(Html.Kendo().ComboBox()
       .Name("Folder")
       .Placeholder(Resources.HR_ArchiveManagement_InstitutionArchiveNo_Folder)
       .DataTextField("Folder")
       .DataSource(dataSource =>
       {
         dataSource.Read(read => read.Action("GetFolders", "PersonalFolderExplorer", new { area = "HRM" }))
          .ServerFiltering(false);
       })
       .DataValueField("Folder")
       .AutoBind(false)
       .Events(e => e.Change("Folder"))
       .HtmlAttributes(new { style = "width: 200px;" })
    )*@
  
    

    @item.CustomCommandToolBarButton("Excel", "<span class='k-icon k-i-excel'></span>" + Resources.ActionButton_ExportExcel, "Excel_Export_Save", "PersonalFolderExplorer", "", new { @class = "k-button k-button-icontext k-grid-excel btn btn-primary btn-xs pull-right" });
    @item.CustomCommandToolBarButton("PDF", "<span class='k-icon k-i-pdf'></span>" + Resources.ActionButton_ExportPDF, "Pdf_Export_Save", "PersonalFolderExplorer", "", new { @class = "k-button k-button-icontext k-grid-pdf  btn btn-primary btn-xs pull-right" });

</div>
        </text>);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Scrollable(h => h.Height(500))
         .Groupable()
         .Sortable(sortable =>
         {
             sortable.SortMode(GridSortMode.SingleColumn);
         })
         .Filterable()
         .Pageable(pageable => pageable
         .Input(true)
         .Numeric(false)
         .Refresh(true)
         .PageSizes(true)
         .ButtonCount(5))
      .DataSource(dataSource => dataSource
      .Ajax()
      .Events(events =>
      {
       events.Error("error_handler(\"PersonalArchiveNogrid\")");
       events.RequestStart("onRequestStart(\"PersonalArchiveNogrid\")");
      events.RequestEnd("onRequestEnd(\"PersonalArchiveNogrid\")");
      })                                                                              
       .Model(model => model.Id(p => p.PersonalArchiveNoId))
       .Read(read => read.Action("PersonalArchiveNo_Read", "PersonalFolderExplorer"))
       .Create(create => create.Action("PersonalArchiveNo_Create", "PersonalFolderExplorer"))
       .Update(update => update.Action("PersonalArchiveNo_Update", "PersonalFolderExplorer"))
       .Destroy(destroy => destroy.Action("PersonalArchiveNo_Destroy", "PersonalFolderExplorer"))
      )
)

<script>
    function Employee() {
        var employees = $("#EmployeeId").data("kendoComboBox");
        var employee = employees.value();

        $.ajax({
            url: '@Url.Action("GetEmployee", "PersonalFolderExplorer")',
            //contentType: "application/json; charset=utf-8",
            data: { employee: employee },
            type: 'POST',
            cache: false,
            success: function(result) {
                r = result;
            }

        });
        var value = this.value(),
            grid = $("#PersonalArchiveNogrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "EmployeeId", operator: "eq", value: value });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>

<script>
    function Zone() {
        var zones = $("#ZoneId").data("kendoComboBox");
        var zone = zones.value();

        $.ajax({
            url: '@Url.Action("GetZone", "PersonalFolderExplorer")',
            //contentType: "application/json; charset=utf-8",
            data: { zone: zone },
            type: 'POST',
            cache: false,
            success: function(result) {
                r = result;
            }

        });
        var value = this.value(),
            grid = $("#PersonalArchiveNogrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "ZoneId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>



<script>
    function Folder() {
        var folders = $("#Folder").data("kendoComboBox");
        var folder = folders.value();

        $.ajax({
            url: '@Url.Action("GetFolder", "PersonalFolderExplorer")',
            //contentType: "application/json; charset=utf-8",
            data: { folder: folder },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
            }

        });
        var value = this.value(),
               grid = $("#PersonalArchiveNogrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "Folder", operator: "eq", value: value });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>