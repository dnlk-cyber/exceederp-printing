@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.ArchiveManagement.OutGoing_DepartmentToDepartment

<div class="form">
    <div class="row fullrow">       
        <div class="col-md-12 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.IsForAll, htmlAttributes: new { @class = "control-label col-md-8" })
               <div class="col-md-6">
                    @Html.Kendo().CheckBoxFor(model => model.IsForAll)
              </div>
            </div>
        </div>     
    </div>

    <br />

    <div class="row fullrow">
        <div class="col-md-12 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.Message, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-9">
                    @Html.TextAreaFor(model => model.Message, new { @class="form-control"})
                </div>
            </div>
        </div>
    </div>
</div>


<style>
    div.k-edit-form-container {
        width: 300px;
    }
</style>