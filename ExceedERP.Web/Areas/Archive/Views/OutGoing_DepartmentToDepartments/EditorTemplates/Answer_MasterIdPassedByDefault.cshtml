@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.ArchiveManagement.OutGoing_DepartmentToDepartment_Answer

@using (Html.BeginForm("Answer_Department", "OutGoing_DepartmentToDepartment_Answers", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form">
        <div class="row">
            <div class="col-sm-10">
                <div class="form-group">
                    @Html.TextBox("AnswerFile", "", new { type = "file", @class = "form-control" })
                </div>
            </div>
        </div>
        <input type="hidden" id="MasterId" name="MasterId" value="@Model.MasterId" />

        <div class="row">
            <div class="col-lg-10">
                <div class="form-group">
                    @Html.LabelFor(model => model.Answer, htmlAttributes: new { @class = "control-label col-md-8" })
                    <div class="col-md-12">
                        @(Html.Kendo().EditorFor(model => model.Answer))

                        @Html.ValidationMessageFor(model => model.Answer, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-lg-2"></div>
        </div>      
      
        <br />

        <div class="row">
            <div class="col-lg-10">
                <div class="form-group">
                   <input type="submit" value="Save"  class="btn btn-primary pull-right" style="padding-bottom:1px;padding-top:1px;border-radius:2px;"/>
                </div>
            </div>
           
        </div>      
      
    </div>
}



<style>
    .k-edit-form-container .k-edit-buttons{
        display:none;
    }
</style>