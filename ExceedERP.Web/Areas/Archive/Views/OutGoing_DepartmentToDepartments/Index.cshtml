<legend>Department To Department Out Going Letters</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.ArchiveManagement.OutGoing_DepartmentToDepartment>()
      .Name("OutGoing_DepartmentToDepartmentGrid")
      .Columns(columns =>
      {
          // columns.ForeignKey(c => c.OrgstructureId, (IEnumerable)ViewData["Departments"], "OrgStructureId", "Name").EditorTemplateName("Department");
          columns.Bound(c => c.Message);
          columns.Bound(c => c.IsForAll).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsForAll ? checked='checked' :'' # >");
          columns.Bound(c => c.DateEt);
          columns.Bound(c => c.Time);
          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Send"))
      .Pageable()
      .Filterable()
      .Scrollable(h => h.Height(600))
      .Events(e=>
      {
          e.DataBound("onDataBound");
          e.DetailExpand("onDetailExpand");
      })
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(s=>s.Add(x=>x.OutGoing_DepartmentToDepartmentId).Descending())
          .Model(model => model.Id(p => p.OutGoing_DepartmentToDepartmentId))
          .Read(read => read.Action("OutGoing_DepartmentToDepartments_Read", "OutGoing_DepartmentToDepartments"))
          .Create(create => create.Action("OutGoing_DepartmentToDepartments_Create", "OutGoing_DepartmentToDepartments"))
          .Update(update => update.Action("OutGoing_DepartmentToDepartments_Update", "OutGoing_DepartmentToDepartments"))
          .Destroy(destroy => destroy.Action("OutGoing_DepartmentToDepartments_Destroy", "OutGoing_DepartmentToDepartments"))
      ).ClientDetailTemplateId("detail")
)


