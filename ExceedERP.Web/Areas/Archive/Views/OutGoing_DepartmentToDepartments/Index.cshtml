<script>
    var departmentToDepartmentId_Global = 0;
    var isSent_Global = false;

    function onDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            if (dataItem.IsSent == true) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
            }

        }
    }
  
    function onDetailExpand(e) {

        var masterRow = e.masterRow;
        var masterGrid = $("#OutGoing_DepartmentToDepartmentGrid").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);

        var id = masterDataItem.OutGoing_DepartmentToDepartmentId;
        isSent_Global = masterDataItem.IsSent;

        if (masterDataItem.IsSent == true)
        {
            $("#btnAttachmentId").hide();
            $("#btnFinishSending").hide();
            $("#btnCreateSendTo").hide();
        }
        if (masterDataItem.IsForAll == true)
        {
            $("#btnCreateSendTo").hide();
        }
    }

    function onAttachmentDataBound(e)
    {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            if (isSent_Global == true) {
                row.find(".k-grid-delete").hide();
            }

        }
    }

    function onSendToDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            if (isSent_Global == true) {
                row.find(".k-grid-delete").hide();
            }

        }
    }

    function OpenAttachementWindow(depTodepId) {

        $("#Attachement_DeparmentId").val(depTodepId);
        departmentToDepartmentId_Global = depTodepId;
        var wnd = $("#DepartmentToDepartmentWindow").data("kendoWindow");
        wnd.center().open();
    }

    function FinishSending(id)
    {
          $.ajax({
            url: '@Url.Action("FinishSending", "Receiver_DepartmentToDepartment")',
            data: { id: id },
            type: 'POST',
            cache: false,
            success: function (result) {
                alert(result);
                $("#OutGoing_DepartmentToDepartmentGrid").data("kendoGrid").dataSource.read();
            }
        });
    }

    function AttachDepartmentToDepartmentFiles() {
        try {
            $.ajax({
                url: '@Url.Action("UploadDepartment_MultipleFile", "Attachment_DepartmentToDepartments")',
                data: function () {
                    var data = new FormData();

                    $.each($("input[type=file]"), function (i, obj) {
                        $.each(obj.files, function (j, file) {
                            data.append('letter[' + j + ']', file);
                        })
                    });

                    data.append("masterId", departmentToDepartmentId_Global);
                    return data;
                }(),
                type: 'POST',
                contentType: false,
                processData: false,
                cache: false,
                success: function (result) {
                    var wnd = $("#DepartmentToDepartmentWindow").data("kendoWindow");
                    wnd.close();

                    $("#Attachment_DepartmentToDepartmentGrid" + departmentToDepartmentId_Global).data("kendoGrid").dataSource.read();
                }
            });
        } catch (e) {
            // alert("Please select the row!!");
        }
    }
</script>

