                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord).HtmlAttributes(new { id="btnCreateSendTo"});
             })
             .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Departments"))
             .Scrollable(h => h.Height("auto"))
             .Events(e=>
