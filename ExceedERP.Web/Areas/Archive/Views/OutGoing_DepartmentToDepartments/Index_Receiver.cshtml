<script>
    var departmentToDepartmentId_Global = 0;
    var isSent_Global = false;
    var isAnswered_Global = false;

    function onDetailExpand(e) {

        var masterRow = e.masterRow;
        var masterGrid = $("#OutGoing_DepartmentToDepartmentGrid").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);

        var id = masterDataItem.OutGoing_DepartmentToDepartmentId;
        departmentToDepartmentId_Global = masterDataItem.OutGoing_DepartmentToDepartmentId;
        isSent_Global = masterDataItem.IsSent;

        if (masterDataItem.IsSent == true)
        {
            $("#btnAttachmentId").hide();
           // $("#btnFinishSending").hide();
           // $("#answerattachmentid").hide();
           // $("#btnCreateSendTo").hide();
        }
    }

    function FinishSending(id)
    {
          $.ajax({
            url: '@Url.Action("FinishSending", "Receiver_DepartmentToDepartment")',
            data: { id: id },
            type: 'POST',
            cache: false,
            success: function (result) {
                alert(result);
                $("#OutGoing_DepartmentToDepartmentGrid").data("kendoGrid").dataSource.read();
            }
        });
    }

    function onAnswerDetailExpand(e) {
        try {
            var detailRow = e.detailRow;
            var answerGrid = $("#OutGoing_DepartmentToDepartment_Answer" + departmentToDepartmentId_Global).data("kendoGrid");
            var answerDataItem = answerGrid.dataItem(detailRow);

            var isAnswered = answerDataItem.IsAnswered;
            isAnswered_Global = answerDataItem.IsAnswered;

            if (isAnswered == true) {
                $("#answerattachmentid").hide();
            }
        } catch{}
    }

    function onSendToDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            if (isSent_Global == true) {
                row.find(".k-grid-delete").hide();
            }

        }
    }

    function onAnswerDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            if (dataItem.IsAnswered == true) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
            }

        }
    }

    function onAnswerAttachmentDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            if (isAnswered_Global == true) {
                row.find(".k-grid-delete").hide();
            }

        }
    }


     function FinishAnswering(id)
    {
          $.ajax({
            url: '@Url.Action("FinishAnswering", "OutGoing_DepartmentToDepartment_Answers")',
            data: { id: id },
            type: 'POST',
            cache: false,
            success: function (result) {
                alert(result);
                $("#OutGoing_DepartmentToDepartmentGrid").data("kendoGrid").dataSource.read();
            }
        });
    }

</script>
