               columns.Bound(c => c.FileName).ClientTemplate("<a href='/Archive/Attachment_DepartmentToDepartments/DownloadDepartmentToDepartmentAttachment?attachmentId=\\#=Attachment_DepartmentToDepartmentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; \\#=FileName\\# </a>").Width(150);
               columns.Template(e => { }).ClientTemplate("<a href='/Archive/Attachment_DepartmentToDepartments/DownloadDepartmentToDepartmentAttachment?attachmentId=\\#=Attachment_DepartmentToDepartmentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; Download </a>").Width(80);
