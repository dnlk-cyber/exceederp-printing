<script>

    function DataBoundEmployeeIncomingAnswer(e) {
        e.preventDefault();
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);

            var dataItem = grid.dataItem(row);

            if (dataItem.IsAnswered == true) {
                //row.css("background-color", "green");
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-ApproveAnswer").hide();
                row.find(".k-grid-UploadAnswer").hide();
                $("#answerCreate").hide();
            }
        }
    }

     function ApproveTheAnswer(e) {

         var answerId = this.dataItem($(e.currentTarget).closest("tr")).EmployeeIncomingAnswerId;
         var employeeIncomingId = this.dataItem($(e.currentTarget).closest("tr")).EmployeeIncomingLetterId

        $.ajax({
            url: '@Url.Action("ApproveEmployeeIncomingAnswer", "LettersFromEmployee")',
                data: { id: answerId },
                type: 'POST',
                cache: false,
                success: function (result) {

                    alert(result.Message);

                    $("#EmployeeIncomingAnswer" + employeeIncomingId).data("kendoGrid").dataSource.read();
                }
            });
    }


function UploadAnswer(e) {

    var answerId = this.dataItem($(e.currentTarget).closest("tr")).EmployeeIncomingAnswerId;
        var institutionId = this.dataItem($(e.currentTarget).closest("tr")).EmployeeIncomingLetterId
        $("#Incoming_AnswerId").val(answerId);
        $("#Employee_Incoming_Id").val(institutionId);
        var wnd = $("#UploadAnswerFileWindow").data("kendoWindow");
        wnd.center().open();
    }

    function UploadAnswerFile() {

            $.ajax({
                url: '@Url.Action("UploadAnswerFile", "LettersFromEmployee")',
            //contentType: "application/json; charset=utf-8",
            data: function () {
                var data = new FormData();

                data.append("FileAnswer", $("#FileAnswer").get(0).files[0]);
                data.append("Incoming_AnswerId", $("#Incoming_AnswerId").val());
                return data;
            }(),
            type: 'POST',
            contentType: false,
            processData: false,
            cache: false,
            success: function (result) {
                var wnd = $("#UploadAnswerFileWindow").data("kendoWindow").close();
                var id = $("#Employee_Incoming_Id").val();
                alert(result.Message);
                $("#EmployeeIncomingAnswer" + id).data("kendoGrid").dataSource.read();
            }
        });
    }
</script>

@(Html.Kendo().Window().Name("UploadAnswerFileWindow")
        .Title("Upload Answer")
        .Visible(false)
        .Modal(true)
        .Content(@<text>
            <input type="hidden" id="Incoming_AnswerId" name="Incoming_AnswerId" />
            <input type="hidden" id="Employee_Incoming_Id" name="Employee_Incoming_Id" />
            @Html.TextBox("FileAnswer", "", new { type = "file", @class = "form-control" })

            <br />
            <div class="pull-right">
                @Html.Kendo().Button().Name("btnTo").Content("Upload").Events(e => e.Click("UploadAnswerFile"))
            </div>
        </text>)
         .Draggable(true)
         .Width(300)
)>