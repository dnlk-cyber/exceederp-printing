<script>
    function customAction(e) {
        // initiate call to a controller action
        var grid = $("#RecivedLetters").data("kendoGrid");

        var dataItem = grid.dataItem(grid.select());


        try {
            var BookNo = dataItem.LetterSenderId;
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("UpdateStatus", "EmployeeLetterSender")',
                data: { 'BookNo': dataItem.LetterSenderId },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                    $("#RecivedLetters").data("kendoGrid").dataSource.read();
                    $("#RecivedLetters").data("kendoGrid").refresh();
                }

            });
        } catch (ee) {
            alert("Please select the row first!!");
        }
    }


    function onDataBound(e) {
        var grid = this;
        var answer = $("#btnAnswer");
        var transfer = $("#btnTransfer");
        var customAction = $("#customAction");
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check
            if (dataItem.EnableDisbale === false) {
                //hide buttons using jQuery
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-customAction").text('Enable');
            } else {

                row.find(".k-grid-edit").show();
                row.find(".k-grid-customAction").text('Disable');
            }


            if (dataItem.Status === 0) {
                //answer.hide(true);
                //transfer.hide(true);
                row.css("background-color", "cadetblue");

            } else {
                //answer.show(true);
                //transfer.show(true);
                row.css("background-color",  "gainsboro");

            }


        }
    }
</script>