@using System.Collections
@using ExceedERP.Core.Domain.Archive
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorArchiveManagement_SentLetter</legend>
@(Html.Kendo().Grid<EmployeeLetterSender>()
              .Name("RecivedLetters")
      .Columns(columns =>
      {
          columns.Bound(c => c.Date);
          columns.Bound(c => c.OwnerName);
          columns.Bound(c => c.Sender);
          columns.Bound(c => c.Receiver);
          columns.Bound(c => c.Description);
          columns.Bound(c => c.Status).EditorTemplateName("Status") ;
          columns.Bound(c => c.StatusName).Visible(false);
          columns.Bound(c => c.FileName).ClientTemplate(Html.ActionLink("#=FileName#", "DownloadFile", new { filename = "#=LetterSenderId#" }).ToHtmlString());

          columns.Command(command =>
          {
              command.Custom("Answer").Text(Resources.HR_ArchiveManagement_Answer).Click("Answer");
              command.Custom("Transfer").Text(Resources.HR_ArchiveManagement_Transfer).Click("Transfer");
          }).Width(200);
      })
    
                         .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                  //.Events(ev => ev.DataBinding("onDataBound"))
                            .Scrollable(h => h.Height(500))
                                                  .Selectable(selectable =>
                             {
                                 selectable.Mode(GridSelectionMode.Single);
                                 selectable.Type(GridSelectionType.Row);
                             })
                                         .Groupable()
                                                  .Sortable(sortable =>
                                                  {
                                                      sortable.SortMode(GridSortMode.SingleColumn);
                                                  })
                                      .Filterable()
                                         .Pageable(pageable => pageable
                                                                    .Input(true)
                                                                    .Numeric(false)
                                                                    .Refresh(true)
                                                                    .PageSizes(true)
                                                                    .ButtonCount(5))
                                                                                        .Events(x =>
                                                                                        {
                                                                                            x.Change("CheckDisablity");
                                                                                            x.DataBound("onDataBound");
                                                                                        })
      .DataSource(dataSource => dataSource
          .Ajax()
                               .Events(events =>
                                                                {
                                                                    events.Error("error_handler(\"RecivedLetters\")");
                                                                    events.RequestStart("onRequestStart(\"RecivedLetters\")");
                                                                    events.RequestEnd("onRequestEnd(\"RecivedLetters\")");
                                                                })
                                                                     
          .Model(model => model.Id(p => p.LetterSenderId))
                                                                                          .Read(read => read.Action("EmployeeLetterSender_Read", "EmployeeLetterSender"))
                                                                                          .Create(create => create.Action("EmployeeLetterSender_Create", "EmployeeLetterSender"))
                                                                                          .Update(update => update.Action("EmployeeLetterSender_Update", "EmployeeLetterSender"))
                                                                                          .Destroy(destroy => destroy.Action("EmployeeLetterSender_Destroy", "EmployeeLetterSender"))
      )
)
