    function TransferClick(e) {
        try {


          
            var recivers = $("#Dept").data("kendoComboBox");
            var reciver = recivers.value();
            $.ajax({
                url: '@Url.Action("SetTransfer", "EmployeeLetterSender")',
                //contentType: "application/json; charset=utf-8",
                data: { id: id, reciver: reciver },
                type: 'POST',
