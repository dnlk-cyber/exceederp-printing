    function Answerm() {
        try {
          
            var url = "";
            $.ajax({
                url: '@Url.Action("UploadDocument", "EmployeeLetterSender")',
                //contentType: "application/json; charset=utf-8",
                data: function () {
                    var data = new FormData();

                    data.append("file", $("#file").get(0).files[0]);
                    data.append("url", url);
                    data.append("txtValue", $("#txtValue").val());
                    data.append("txtDecsion", $("#txtDecsion").val());
                    data.append("id", id);
                    return data;
                }(),
                type: 'POST',
                contentType: false,
                processData: false,
                cache: false,
                success: function (result) {
                    var wnd = $("#Answerw").data("kendoWindow");
                    wnd.close();
                    $("#RecivedLetters").data("kendoGrid").dataSource.read();
                    $("#RecivedLetters").data("kendoGrid").refresh();
                }


