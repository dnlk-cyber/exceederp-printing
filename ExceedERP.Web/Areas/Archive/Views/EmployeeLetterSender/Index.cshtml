                    @Html.TextBox("txtValue", null, new { placeholder = Resources.Common_Attachment_FileName, required = true })
                </div>
                <div class="editor-field">
                    @Html.TextArea("txtDecsion", null, new { placeholder = Resources.HR_ArchiveManagement_Decsion ,required=true})
                </div>
                <br />
