        </div>



    </text>)
                .Pinned(true)

                                    .Draggable(true)
                                    .Width(300)
)

@(Html.Kendo().Window().Name("Transferw")
    .Title(Resources.HR_ArchiveManagement_Transfer)
    .Visible(false)
    .Modal(true)
      .Content(@<text>
        @(Html.Kendo().ComboBox()
                          .Name("Dept")
                          .ValuePrimitive(true)
                          .Placeholder(Resources.Select)
                                   .Filter("contains")
              .MinLength(2)
                          .HtmlAttributes(new { style = "width:200px" })
                                          .DataTextField("Name")
                                          .DataValueField("OrgStructureId")
                                                  .BindTo((IEnumerable)ViewData["Departments"])
        )

        @Html.ValidationMessageFor(m => m)
        <br />
        <div class="pull-right">
            @Html.Kendo().Button().Name("btnTo").Content(Resources.HR_ArchiveManagement_TransferTo).Events(e => e.Click("TransferClick"))

        </div>


    </text>)
                                    .Draggable(true)
                                    .Width(300)
      )
<script>
    var statusId = "";
    var popup;
    var id = "";
    function Answer(e) {
        try {
            statusId = e;
            var row = $(e.target).closest("tr");
            var grid = $("#RecivedLetters").data("kendoGrid");
            var dataItem = grid.dataItem(row);
             id = dataItem.LetterSenderId;
            
            var wnd = $("#Answerw").data("kendoWindow");
            wnd.center().open();

        } catch (ex) {
            alert("Please select the row!!");
        }

