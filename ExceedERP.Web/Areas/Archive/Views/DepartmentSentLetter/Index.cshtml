<script>

    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();
    }

</script>
<style>
    div.k-edit-form-container {
        width: 700px;
    }
</style>

<script>
    function GetDate() {

        $("#OutgoingLetterDateAm").trigger("change");
        $("#RecivedDateAmharic").trigger("change");
        $("#LetterAmharic").trigger("change");
    }

</script>

<script>

    var institutionIncomingLetterId_Global;
    var isAnswered_Global = false;

    function DetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#IncommingLetterRegistration").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);
        institutionIncomingLetterId_Global = masterDataItem.InstitutionIncomingLetterId;
    }

    function onAnswerDetailExpand(e) {
        try {
            var detailRow = e.masterRow;
            var answerGrid = $("#InstitutionIncomingAnswer" + institutionIncomingLetterId_Global).data("kendoGrid");
            var answerDataItem = answerGrid.dataItem(detailRow);

            var isAnswered = answerDataItem.IsAnswered;
            isAnswered_Global = answerDataItem.IsAnswered;

            if (isAnswered == true) {
                $(".answerattachmentclass").hide();
            }
        } catch{}
    }

    function DetailDatabound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);

            var dataItem = grid.dataItem(row);
            if (dataItem.IsTransfered == true) {
                row.find(".k-grid-delete").hide();
            }
        }
    }

    function onAnswerAttachmentDataBound(e) {
        try {
            var grid = this;
            var gridRows = grid.tbody.find("tr");
            for (var i = 0; i < gridRows.length; i++) {
                var row = $(gridRows[i]);
                var dataItem = grid.dataItem(row);

                if (isAnswered_Global == true) {
                    row.find(".k-grid-delete").hide();
                }

            }
        } catch{}

    }  

</script>



<script>

    function onDataBound(e) {
        var grid = this;

        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
        }
    }



    function DataBoundIncomingAnswer(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);

            var dataItem = grid.dataItem(row);

            if (dataItem.IsAnswered == true) {
                //row.css("background-color", "green");
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-ApproveAnswer").hide(); 
                row.find(".k-grid-UploadAnswer").hide();
                row.find(".btnReturnAssignment").hide();
                $("#answerCreate").hide();
            }
        }
    }


</script>

<script>

    function ApproveTheAnswer(e) {

        var answerId = this.dataItem($(e.currentTarget).closest("tr")).InstitutionIncomingAnswerId;
        var institutionId = this.dataItem($(e.currentTarget).closest("tr")).InstitutionIncomingId

        $.ajax({
            url: '@Url.Action("ApproveInstitutionIncomingAnswer", "DepartmentSentLetter")',
                data: { id: answerId },
                type: 'POST',
                cache: false,
                success: function (result) {

                    alert(result.Message);

                    $("#InstitutionIncomingAnswer" + institutionId).data("kendoGrid").dataSource.read();
                }
            });
    }

    function ReturenAssignment(e) {
        var letterSenderId = this.dataItem($(e.currentTarget).closest("tr")).LetterSenderId;
        var institutionId = this.dataItem($(e.currentTarget).closest("tr")).InstitutionIncomingId

        $.ajax({
            url: '@Url.Action("ReturenAssignment", "DepartmentSentLetter")',
            data: { id: letterSenderId },
                type: 'POST',
                cache: false,
                success: function (result) {

                    alert(result.Message); 

                    $("#IncommingLetterRegistration").data("kendoGrid").dataSource.read();
                    $("#RecivedLetters_" + institutionId).data("kendoGrid").dataSource.read();
                }
            });
    }

   function UploadAnswer(e) {

        var answerId = this.dataItem($(e.currentTarget).closest("tr")).InstitutionIncomingAnswerId;
        var institutionId = this.dataItem($(e.currentTarget).closest("tr")).InstitutionIncomingId
        $("#Incoming_AnswerId").val(answerId);
        $("#Institution_Incoming_Id").val(institutionId);
        var wnd = $("#UploadAnswerFileWindow").data("kendoWindow");
        wnd.center().open();
    }

    function UploadAnswerFile() {

            $.ajax({
                url: '@Url.Action("UploadAnswerFile", "DepartmentSentLetter")',
                //contentType: "application/json; charset=utf-8",
                data: function () {
                    var data = new FormData();

                    data.append("FileAnswer", $("#FileAnswer").get(0).files[0]);
                    data.append("Incoming_AnswerId", $("#Incoming_AnswerId").val());
                    return data;
                }(),
                type: 'POST',
                contentType: false,
                processData: false,
                cache: false,
                success: function (result) {
                    var wnd = $("#UploadAnswerFileWindow").data("kendoWindow").close();
                    var id = $("#Institution_Incoming_Id").val();
                    alert(result.Message);
                    $("#InstitutionIncomingAnswer" + id).data("kendoGrid").dataSource.read();
                }
            });
    }
</script>

@(Html.Kendo().Window().Name("UploadAnswerFileWindow")
        .Title("Upload Answer")
        .Visible(false)
        .Modal(true)
        .Content(@<text>
            <input type="hidden" id="Incoming_AnswerId" name="Incoming_AnswerId" />
            <input type="hidden" id="Institution_Incoming_Id" name="Institution_Incoming_Id" />
            @Html.TextBox("FileAnswer", "", new { type = "file", @class = "form-control" })

            <br />
            <div class="pull-right">
                @Html.Kendo().Button().Name("btnTo").Content("Upload").Events(e => e.Click("UploadAnswerFile"))
            </div>
        </text>)
         .Draggable(true)
         .Width(300))