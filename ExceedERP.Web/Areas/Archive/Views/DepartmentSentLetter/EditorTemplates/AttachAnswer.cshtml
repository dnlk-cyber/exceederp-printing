@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.ArchiveManagement.Institution.Attachment_Answer_InstitutionIncoming

@using (Html.BeginForm("AttachmentInstitutionIncomingAnswer_MultipleFile", "Attachment_Answer_InstitutionIncomings", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form">
        <div class="row">
            <div class="col-sm-10">
                <div class="form-group">
                    @*@Html.TextBox("AnswerFile", "", new { type = "file", @class = "form-control" })*@
                    <input type="file" name="AnswerFile" id="AnswerFile" multiple class="form-control"/>
                </div>
            </div>
        </div>
        <input type="hidden" id="MasterId" name="MasterId" value="@Model.MasterId" />       
      
        <br />

        <div class="row">
            <div class="col-lg-10">
                <div class="form-group">
                   <input type="submit" value="Save"  class="btn btn-primary pull-right" style="padding-bottom:1px;padding-top:1px;border-radius:2px;"/>
                </div>
            </div>
           
        </div>      
      
    </div>
}



<style>
    .k-edit-form-container .k-edit-buttons{
        display:none;
    }
</style>