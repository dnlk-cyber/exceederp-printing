@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.ArchiveManagement.LetterForMultipleStaff

<div class="form">
    <div class="row fullrow">
       
        <div class="col-md-12 ro1">

            <div class="form-group">
                <div class="col-md-11">
                    <label>Is For All Employees ?  </label>
                    @Html.Kendo().CheckBoxFor(model => model.IsForAllEmployee)
                </div>
            </div>

            <div class="form-group">
                <br /><br /><br />
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().TextBoxFor(model => model.Title))
                </div>
            </div>

        </div>     
    </div>
</div>


<style>
    div.k-edit-form-container {
        width: 300px;
    }
</style>