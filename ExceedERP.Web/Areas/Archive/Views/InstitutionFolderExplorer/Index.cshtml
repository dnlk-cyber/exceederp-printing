@using System.Collections
@using ExceedERP.Core.Domain.Archive
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorArchiveManagement_InstitutionFolderExplorer</legend>
@(Html.Kendo().Grid<InstitutionArchiveNo>()
      .Name("InstitutionArchiveNogrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.SubjectTypeId, (IEnumerable)ViewData["SubjectType"], "SubjectTypeId", "CodeWithName").EditorTemplateName("Institution").Width(200);
          // columns.ForeignKey(c => c.InstitutionTypeId, (IEnumerable)ViewData["InstuType"], "InstitutionTypeId", "InstitutionName").EditorTemplateName("Institution").Width(200);

          //columns.ForeignKey(c => c.ZoneId, (IEnumerable)ViewData["Zones"], "ZoneId", "ZoneName").EditorTemplateName("Zone").Width(120);
          columns.Bound(c => c.RoomNo).Width(150);
          columns.Bound(c => c.Shelve).Width(120);
          columns.Bound(c => c.Row).Width(120);
          columns.Bound(c => c.Folder).Width(150);
          columns.Bound(c => c.Volume).Width(150);
          columns.Bound(c => c.FileNo).Width(150);

          //columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      @*.ToolBar(toolbar =>
      {
      toolbar.Template(@<text>
            <div class="toolbar">
                <label class="category-label" for="InstitutionTypeId"> @Resources.HR_Archive_SelectInstitutionTypeId</label>
                @(Html.Kendo().ComboBox()
                     .Placeholder(Resources.HR_ArchiveManagement_InstitutionType_InstitutionTypeId)
                     .Name("InstitutionTypeId")
                     .BindTo((IEnumerable)ViewData["InstuType"])
                     .DataTextField("InstitutionName")
                     .DataValueField("InstitutionTypeId")
                     .AutoBind(false)
                     .Events(e => e.Change("Zone"))
                     .HtmlAttributes(new { style = "width: 200px;" })                    
                )
                <label class="category-label" for="Folder">@Resources.HR_Archive_SelectFolderNo</label>
                @(Html.Kendo().ComboBox()
                    .Name("Folder")
                    .Placeholder(Resources.HR_ArchiveManagement_InstitutionArchiveNo_Folder)
                    .DataTextField("Folder")
                    .BindTo((IEnumerable)ViewData["Folders"])
                    .DataValueField("Folder")
                    .AutoBind(false)
                    .Events(e => e.Change("Folder"))
                    .HtmlAttributes(new { style = "width: 200px;" })
                )
                

            </div>
        </text>);
      })*@
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Scrollable(h => h.Height(500))
      .Groupable()
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Pageable(pageable => pageable
      .Input(true)
      .Numeric(false)
      .Refresh(true)
      .PageSizes(true)
      .ButtonCount(5))
      .DataSource(dataSource => dataSource
      .Ajax()
      .Sort(a=>a.Add(s=>s.InstiArchiveNoId).Descending())
      .Events(events =>
      {
          events.Error("error_handler(\"InstitutionArchiveNogrid\")");
          events.RequestStart("onRequestStart(\"InstitutionArchiveNogrid\")");
          events.RequestEnd("onRequestEnd(\"InstitutionArchiveNogrid\")");
      })
    
          .Model(model => model.Id(p => p.InstiArchiveNoId))
          .Read(read => read.Action("InstitutionArchiveNo_Read", "InstitutionFolderExplorer"))
          .Create(create => create.Action("InstitutionArchiveNo_Create", "InstitutionFolderExplorer"))
          .Update(update => update.Action("InstitutionArchiveNo_Update", "InstitutionFolderExplorer"))
          .Destroy(destroy => destroy.Action("InstitutionArchiveNo_Destroy", "InstitutionFolderExplorer"))
      )
)
