@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@(Html.Kendo().Grid<OutGoing_DepartmentToStaff>()
      .Name("OutGoing_DepartmentToStaffGrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Message);
          // columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["Departments"], "OrgStructureId", "Name");
          columns.Bound(c => c.IsForAll).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsForAll ? checked='checked' :'' # >");
          columns.Bound(c => c.IsSent).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsSent ? checked='checked' :'' # >");
          columns.Bound(c => c.DateEt);
          columns.Bound(c => c.Time);
          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          });
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Send"))
      .Pageable()
      .Filterable()
      .Scrollable(h => h.Height(600))
      .Events(e=>
      {
          e.DetailExpand("onDetailExpand");
          e.DataBound("onMasterDataBound");
      })
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(s => s.Add(x => x.OutGoing_DepartmentToStaffId).Descending())
          .Model(model => model.Id(p => p.OutGoing_DepartmentToStaffId))
          .Read(read => read.Action("OutGoing_DepartmentToStaffs_Read", "OutGoing_DepartmentToStaff"))
          .Create(create => create.Action("OutGoing_DepartmentToStaffs_Create", "OutGoing_DepartmentToStaff"))
          .Update(update => update.Action("OutGoing_DepartmentToStaffs_Update", "OutGoing_DepartmentToStaff"))
          .Destroy(destroy => destroy.Action("OutGoing_DepartmentToStaffs_Destroy", "OutGoing_DepartmentToStaff"))
     ).ClientDetailTemplateId("detail")
)



