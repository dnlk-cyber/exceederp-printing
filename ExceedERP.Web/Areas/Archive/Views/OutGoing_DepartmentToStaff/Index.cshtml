<script>
    var departmentToStaffId_Global = 0;
    var isSent_Global = false;

    function onDetailExpand(e) {

        var masterRow = e.masterRow;
        var masterGrid = $("#OutGoing_DepartmentToStaffGrid").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);

        departmentToStaffId_Global = masterDataItem.OutGoing_DepartmentToStaffId;
        isSent_Global = masterDataItem.IsSent;

        if (masterDataItem.IsSent == true) {
            $("#btnAttachmentId").hide();
            $("#btnFinishSending").hide();
            $("#btnCreateSendTo").hide();
        }
        if (masterDataItem.IsForAll == true) {
            $("#btnCreateSendTo").hide();
        }
    }

    function OpenAttachementWindow(depToStaffId) {

        $("#Attachement_DeparmentId").val(depToStaffId);
        departmentToStaffId_Global = depToStaffId;
        var wnd = $("#DepartmentToStaffWindow").data("kendoWindow");
        wnd.center().open();
    }

    function onMasterDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            if (dataItem.IsSent == true) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
            }

        }
    }

    function onAttachmentDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            if (isSent_Global == true) {
                row.find(".k-grid-delete").hide();
            }

        }
    }

    function onSendToDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            if (isSent_Global == true) {
                row.find(".k-grid-delete").hide();
            }

        }
    }

    function FinishSending(id)
    {
          $.ajax({
            url: '@Url.Action("FinishSending", "Receiver_DepartmentToStaffs")',
            data: { id: id },
            type: 'POST',
            cache: false,
            success: function (result) {
                alert(result);
                $("#OutGoing_DepartmentToStaffGrid").data("kendoGrid").dataSource.read();
            }
        });
    }


    function AttachDepartmentToStaffFiles() {
        try {
            $.ajax({
                url: '@Url.Action("UploadDepartment_MultipleFile", "Attachment_DepartmentToStaffs")',
                data: function () {
                    var data = new FormData();

                    $.each($("input[type=file]"), function (i, obj) {
                        $.each(obj.files, function (j, file) {
                            data.append('letter[' + j + ']', file);
                        })
                    });

                    data.append("masterId", departmentToStaffId_Global);
                    return data;
                }(),
                type: 'POST',
                contentType: false,
                processData: false,
                cache: false,
                success: function (result) {
                    var wnd = $("#DepartmentToStaffWindow").data("kendoWindow");
                    wnd.close();

                    $("#OutGoing_DepartmentToStaffGrid").data("kendoGrid").dataSource.read();
                }
            });
        } catch (e) {
            // alert("Please select the row!!");
        }
    }

</script>



@(Html.Kendo().Window().Name("DepartmentToStaffWindow")
    .Title("File Attachment")
    .Visible(false)
    .Modal(true)
      .Content(@<text>

        <input type="text" id="Attachement_DeparmentId" name="Attachement_DeparmentId" hidden />
        <div class="editor-field">
            <input type="file" name="letter" id="letter[]" class="form-control" multiple />
        </div>

        <br />

        <div class="pull-right">
            @Html.Kendo().Button().Name("btnTo").Content("Upload").Events(e => e.Click("AttachDepartmentToStaffFiles"))

        </div>

    </text>)
      .Pinned(true)
      .Draggable(true)
      .Width(300)
)