<script>
    function GetDate() {
        $("#RecivedDateAmh").trigger("change");
        $("#LetterDateAmh").trigger("change");
    }
</script>

<script>
    //var statusId = "";
    //var popup;
    //var bookNo = "";
    var institutionIncomingLetterId = 0;
    var isTransfered_Global = false;

    function DetailExpand(e) {

        var masterRow = e.masterRow;
        var masterGrid = $("#IncommingLetterRegistration").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);
        
        institutionIncomingLetterId = masterDataItem.InstitutionIncomingLetterId;
        isTransfered_Global = masterDataItem.IsTransfered;
        if (isTransfered_Global == true)
        {
            $("#btn_SendToDepartment").hide();
            $("#btn_finishAssignment").hide();
        }     
    }    
    
</script>

<script>  
    function onDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            if (dataItem.IsTransfered == true)
            {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
            }           

        }
    }

    function onAttachmentDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            if (isTransfered_Global == true) {
               // row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
            }
        }
    }

    function DetailDatabound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
         var row = $(gridRows[i]);

         var dataItem = grid.dataItem(row);
         if (dataItem.IsTransfered == true)
         {
             row.find(".k-grid-delete").hide();
         }           
        }
    }
</script>

<script>
    function GetData() {
        //var institute = $("#InstitutionTypeId").data("kendoDropDownList").value();
        var subType = $("#SubjectTypeId").data("kendoDropDownList").value();

        $.ajax({
            url: '@Url.Action("GetData", "InstitutionIncomingLetters")',
            //data: { institute: institute },
            data: { subType: subType },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#Shelve").data("kendoDropDownList").value(result.Shelve);
                $("#Shelve").trigger("change");

                $("#Row").data("kendoDropDownList").value(result.Row);
                $("#Row").trigger("change");

                $("#FileNo").data("kendoDropDownList").value(result.FileNo);
                $("#FileNo").trigger("change");

                $("#FolderNo").data("kendoDropDownList").value(result.Folder);
                $("#FolderNo").trigger("change");
            }
        });
    }


    function OpenAttachementWindow() {
        
            $("#Attachement_InstitutionIncomingId").val(institutionIncomingLetterId);

            var wnd = $("#IncomingAttachementWindow").data("kendoWindow");
            wnd.center().open();        
    }


    function AttachArchiveFiles() {
        try {
            var ac = '@ArchiveCategory.Institution';
            var lt = '@LetterType.Incoming';
            $.ajax({
                url: '@Url.Action("UploadIncomingLetters_MultipleFile", "ArchiveAttachments")',
                //contentType: "application/json; charset=utf-8",
                data: function () {
                    var data = new FormData();

                   // var kkk = $("#letter").get(0).files[0];
                    $.each($("input[type=file]"), function (i, obj) {
                        $.each(obj.files, function (j, file) {
                            data.append('letter[' + j + ']', file);
                        })
                    });

                    //data.append("file", $("#letter").get(0).files[0]);
                    data.append("description", $("#description").val());
                    data.append("masterId", institutionIncomingLetterId);
                    data.append("ac", ac);
                    data.append("lt", lt);
                    return data;
                }(),
                type: 'POST',
                contentType: false,
                processData: false,
                cache: false,
                success: function (result) {
                    var wnd = $("#IncomingAttachementWindow").data("kendoWindow");
                    wnd.close();

                    $("#ArchiveAttachementGrid" + institutionIncomingLetterId).data("kendoGrid").dataSource.read();
                    //$("#IncommingLetterRegistration").data("kendoGrid").dataSource.read();
                }
            });
        } catch (e) {
            // alert("Please select the row!!");
        }
    }
    
</script>


