<legend>@Resources.View_IncommingLetterRegistration_Header</legend>
@(Html.Kendo().Grid<InstitutionIncomingLetter>()
      .Name("IncommingLetterRegistration")
      .Columns(columns =>
      {
          columns.Bound(c => c.BookNo).Width(150);
          columns.ForeignKey(c => c.SubjectTypeId, (System.Collections.IEnumerable)ViewData["SubjectType"], "SubjectTypeId", "CodeWithName").Width(200);
          columns.Bound(c => c.LetterDateAmh).Width(150);
          columns.Bound(c => c.RecivedTime).Width(100);
          columns.Bound(c => c.LetterReferenceNo).Width(200);
          columns.Bound(c => c.RecivedDateAmh).Width(150);
          columns.Bound(c => c.SenderName).Width(150);
          columns.Bound(c => c.Subject).Width(150);
          columns.Bound(c => c.FolderNo).Width(150);
          //columns.ForeignKey(c => c.OrgStructureId, (System.Collections.IEnumerable)ViewData["Departments"], "OrgStructureId", "Name").Width(200);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("Archive_User"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  command.Destroy().Text("Delete");
              }
              //if (HttpContext.Current.User.IsInRole("Archive_Admin"))
              //{
              //    command.Custom("customAction").Text(Resources.ActionButton_EnableDisable).Click("customAction");
              //}
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("NewIncoming").Window(window => { window.Title(""); window.Scrollable(false); }))
      .Scrollable(h => h.Height(500))
      .Filterable()
      .Events(x =>
      {
          x.Edit("GetDate");
          x.DataBound("onDataBound");
          x.DetailExpand("DetailExpand");
          x.Save("GetDate");
      })
          .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
          .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(s => s.Add(b => b.InstitutionIncomingLetterId).Descending())
          .Events(events =>
          {
              events.Error("error_handler(\"IncommingLetterRegistration\")");
              events.RequestStart("onRequestStart(\"IncommingLetterRegistration\")");
              events.RequestEnd("onRequestEnd(\"IncommingLetterRegistration\")");
          })

          .Model(model => model.Id(p => p.InstitutionIncomingLetterId))
          .Read(read => read.Action("InstitutionIncomingLetters_Read", "InstitutionIncomingLetters"))
          .Create(create => create.Action("InstitutionIncomingLetters_Create", "InstitutionIncomingLetters"))
          .Update(update => update.Action("InstitutionIncomingLetters_Update", "InstitutionIncomingLetters"))
          .Destroy(destroy => destroy.Action("InstitutionIncomingLetters_Destroy", "InstitutionIncomingLetters"))
      ).ClientDetailTemplateId("template"))

