
@(Html.Kendo().DropDownListFor(m => m)
            .Name("PeriodId")
            .ValuePrimitive(true)
            .OptionLabel("--Months--")
            .DataTextField("Name")
            .DataValueField("GLPeriodId")
            .CascadeFrom("YearId")
            .DataSource(dataSource =>
            {
                dataSource.Read(read => read.Action("GetAllPeriods", "GlPeriod", new { area = "Finance" })
                .Data("filterPeriods"))
                
                .ServerFiltering(true);
            })
            .AutoBind(false)
            .Enable(false)

)
@Html.ValidationMessageFor(m => m)

