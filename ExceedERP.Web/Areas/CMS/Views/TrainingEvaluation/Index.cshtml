<script id="trainee_detail_template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("trainee_tab_str_#=CmsTraineeId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Detail").Content(@<text>
                @*<a class="btn btn-primary k-button k-button-icontext" href='@Url.Action("RegistrationSlip", "CMSPrint")/#=CmsTraineeId#' title="Print Registration Slip"><i class="fa fa-print  fa-2x"></i> &nbsp;&nbsp; Print Registration Slip</a>*@
                @(Html.Kendo().PanelBar()
                    .Name("trainee_panelbar_#=CmsTraineeId#")
                    .ExpandMode(PanelBarExpandMode.Multiple)
                    .Items(panelbar =>
                    {
                        panelbar.Add()
                            .Expanded(true)
                            .Text("Detail")
                            .Content(
                                "<div>" +
                                "<ul>" +
                                "<li> <label> Status: </label> <strong> #=Status != null ? Status: ' '# </strong> </li>" +
                                "<li> <label> Created by: </label> <strong> #=CreatedBy != null ? CreatedBy: ' '# </strong> </li>" +
                                "<li> <label> Created on: </label> #= kendo.toString(DateCreated, 'dd/MM/yyyy H:mm:ss')# </li>" +
                                "<li> <label> Modified by :</label> #= ModifiedBy != null ? ModifiedBy: ''# </li>" +
                                "<li> <label> Last Modified :</label> #= LastModified != null ? kendo.toString(LastModified, 'dd/MM/yyyy H:mm:ss') : ' '# </li>" +
                                "</ul>" +
                                "</div>"
                            );

                    }).ToClientTemplate()
                ) 
            </text>);
            @*items.Add().Text("Barcode").Content(@<text>
                <a class="btn btn-primary k-button k-button-icontext" href='\\#' onclick='return onRegerateBarcodeClick("#=CmsTraineeId#", "#=BarcodeImageName#")' title="Regenerate Barcode"><i class="fa fa-repeat  fa-2x"></i> &nbsp;&nbsp; Regenerate Barcode</a>

                <div class="image-container-box">
                    <img class="rectuangular-large-img" src="~/Content/Images/CMS/Barcodes/#=BarcodeImageName#" />
                </div>
            </text>);
            items.Add().Text("Profile").Content(@<text>
                <div>
                    @ProfileChangeHelper()
                </div>
                <div class="image-container-box">
                    <img class="rectuangular-large-img" src="~/Content/Images/CMS/Profiles/#=ProfilePicFileName#" />
                </div>

            </text>);*@
            items.Add().Text("Training Programs").Content(@<text>
                # if (Status == "@ExceedERP.Core.Domain.CMS.TraineeStatusConstants.OnExamination")
                {#
                    <a class="btn btn-danger k-button k-button-icontext" onclick='return setAsFailedExamination("#=CmsTraineeId#")' href='\#' title=""><i class="fa fa-close fa-1x"></i> &nbsp; Failed Examination</a>
                    <a class="btn btn-success k-button k-button-icontext" onclick='return setAsPassedExamination("#=CmsTraineeId#")' href='\#' title=""><i class="fa fa-check fa-1x"></i> &nbsp; Passed Examination</a>
                    <a class="btn btn-success k-button k-button-icontext" onclick='return insertWeldersPerformanceQualification("#=CmsTraineeId#", "#=RegistrationNumber#")' href='\#' title=""><i class="fa fa-edit fa-1x"></i> &nbsp; Welder's Performance Qualification</a>
                    <a class="btn btn-primary k-button k-button-icontext" href="\#" onclick='return printWeldersPerformanceQualification("#=RegistrationNumber#","#=CmsTraineeId#","#=FullName#" )' title="Print Welder's Performance Qualification"><i class="fa fa-print  fa-1x"></i> &nbsp;&nbsp; Print Welder's Performance Qualification</a>

                    <br />
                    <br />
                # }#
                @TrainingProgramsHelper()
            </text>);
        }).ToClientTemplate()
    )
</script>


@helper TrainingProgramsHelper() { 
        @(Html.Kendo().Grid<ExceedERP.Core.Domain.CMS.TraineeProgram>()
                  .Name("programs_grid_#=CmsTraineeId#")
                  .Columns(columns =>
                  {

                      columns.ForeignKey(c => c.ProgramId, (IEnumerable)ViewData["Programs"], "CMSProgramId", "Name").Width(90).EditorTemplateName("ProgramEditorTemlate");
                      columns.Bound(c => c.TrainingStatus).Width(80).EditorTemplateName("TrainingProgramStatusEditorTemplate");
                      columns.Group(group =>
                      {
                          group.HeaderHtmlAttributes(new { style = "font-weight:bold; text-align:center;" });
                          group.Title("Marks");
                          group.Columns(innerColumns =>
                          {
                              innerColumns.Bound(c => c.TheoreticalExamResult).Width(50);
                              innerColumns.Bound(c => c.PracticalExamResult).Width(50);
                          });
                      });


                      columns.Command(command =>
                      {
                          command.Edit().Text("Edit Marks");
                          //command.Destroy();
                      }).Width(600);
                  })
                  //.ToolBar(toolbar =>
                  //{
                  //    toolbar.Create();
                  //    //toolbar.Excel();
                  //    //toolbar.Pdf();
                  //})

                  .Editable(editable =>
                  {
                      editable.Mode(GridEditMode.InLine);

                      //editable.TemplateName("CompanyEditorTemplate");
                      //editable.Window(window =>
                      //{
                      //    window.Title("Company Registration");
                      //    window.Scrollable(true);
                      //    window.Height(550);
                      //});
                  })
                  .Pageable()
                  .Navigatable()
                  .Selectable(selectable => {
                      selectable.Mode(GridSelectionMode.Single);
                      selectable.Type(GridSelectionType.Row);
                  })
                  .Sortable(sortable => {
                      sortable.SortMode(GridSortMode.SingleColumn);
                  })
                  .Filterable()
                  .Scrollable()
                  .DataSource(dataSource => dataSource
                      .Ajax()
                      .Model(model =>
                      {
                          model.Id(p => p.TraineeProgramId);
                          model.Field(p => p.ProgramId).Editable(false);
                          model.Field(p => p.TrainingStatus).Editable(false);

                      })
                      .Events(ev => ev
                            .Error("error_handler(\"programs_grid_#=CmsTraineeId#\")")
                            .RequestStart("onRequestStart(\"programs_grid_#=CmsTraineeId#\")")
                            .RequestEnd("onRequestEnd(\"programs_grid_#=CmsTraineeId#\")"))

                      .Read(read => read.Action("Data_Read", "TraineeProgram", new { id = "#=CmsTraineeId#" }))
                      .Create(create => create.Action("Data_Create", "TraineeProgram", new { id = "#=CmsTraineeId#" }))
                      .Update(update => update.Action("Data_Update", "TraineeProgram"))
                      .Destroy(destroy => destroy.Action("Data_Destroy", "TraineeProgram"))
                  ).ToClientTemplate()
            )
    }

<script type="text/javascript">
    function setAsPassedExamination(id) {
         $.ajax({
            type: "POST",
            url: '@Url.Action("SetAsPassedExamination", "TrainingEvaluation", new { area = "CMS" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                if (result.Status == "OK") {
                    location.reload(true);
                }
            },
            error: function (result) {
                alert(result);
            }
        });
    }
    function setAsFailedExamination(id) {
         $.ajax({
            type: "POST",
            url: '@Url.Action("SetAsFailedExamination", "TrainingEvaluation", new { area = "CMS" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                if (result.Status == "OK") {
                    location.reload(true);
                }
            },
            error: function (result) {
                alert(result);
            }
        });
    }
    function insertWeldersPerformanceQualification(id, regNumber) {
        window.location.href = `/CMS/TrainingEvaluation/Wps?ti= ${id}&reg=${regNumber}`;
    }
    function printWeldersPerformanceQualification(regNumber, traineeId, fName) {
        window.location.href = `/CMS/CMSPrint/WeldersPerformanceQualification?regn=${regNumber}&ti= ${traineeId}&name=${fName}`;
    }
</script>