@(Html.Kendo().DropDownListFor(m => m)
                .ValuePrimitive(true)
                .OptionLabel("Select...")
                .DataTextField("Name")
                .DataValueField("ISOTypeId")
                .Filter(FilterType.Contains)
                .DataSource(dataSource =>
                {
                    dataSource.Read(read => read.Action("GetAllISOTypes", "CMSDataProvider", new { area = "CMS" }));
                })

)