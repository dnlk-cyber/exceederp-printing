@helper ProfileChangeHelper()
{
    @(Html.Kendo().Upload()
        .Name("files")
        .HtmlAttributes(new { @id= "uploader_#=CmsTraineeId#" })
        .Messages(msg =>
        {
            msg.Select("<i class = \"fa fa-upload\"></i> Upload Photo");
        })
        .ShowFileList(false)
        .Async(s => s.Save("ProfilePicture_Upload", "Trainees", new { id = "#=CmsTraineeId#"})
        )
        //.Events(e => e.Complete("contractAttachementSuccess"))
        .HtmlAttributes(new { accept = "image/*" })
        .Events(events => events.Complete(
                            @<text>
                                function(e) {
                                var ddl = $("\\#trainee_grid").data("kendoGrid");
                                @*var ddl2 = $("\\#company_grid").data("kendoGrid");*@
                                ddl.dataSource.read();
                                @*ddl2.dataSource.read();*@
                                }
                            </text>
                                   ))
               .ToClientTemplate()
    )
}
