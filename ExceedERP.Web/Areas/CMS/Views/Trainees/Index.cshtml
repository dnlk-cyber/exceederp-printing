<legend>Trainees & Companies</legend>
@(Html.Kendo().TabStrip()
    .Name("trainee_tabstrip")
    .SelectedIndex(0)
    .Items(items =>
    {
        items.Add().Text("Trainees").Content(@<text>
            @(Html.Kendo().Grid<ExceedERP.Core.Domain.CMS.CmsTrainee>()
                  .Name("trainee_grid")
                  .Columns(columns =>
                  {
                      columns.Template(c => { }).Width(100)
                      .ClientTemplate("<img class='circular-profile-img-small' src ='" + @Url.Content("~/Content/Images/CMS/Profiles/") + "#=ProfilePicFileName#'/>");
                      columns.Bound(c => c.RegistrationDate).Width(100);
                      columns.Bound(c => c.RegistrationNumber).Width(350);
                      columns.ForeignKey(c => c.CMSProgramId, (IEnumerable)ViewData["Programs"], "CMSProgramId", "Name").Width(100);
                      columns.ForeignKey(c => c.CMSCourseId, (IEnumerable)ViewData["Courses"], "CMSCourseId", "Name").Width(100);
                      //columns.Bound(c => c.FirstName);
                      //columns.Bound(c => c.LastName);
                      //columns.Bound(c => c.MiddleName);
                      columns.Bound(c => c.FullName).Width(100);
                      columns.Bound(c => c.Nationality).Width(100);
                      //columns.Bound(c => c.CompanyName);
                      columns.Bound(c => c.Region).Width(100);
                      columns.Bound(c => c.Address).Width(100);
                      columns.ForeignKey(c => c.CityId, (IEnumerable)ViewData["Cities"], "CityId", "Name").Width(100);
                      columns.Bound(c => c.DateOfBirth).Width(100);
                      columns.Bound(c => c.PhoneNumber).Width(100);
                      columns.Bound(c => c.MobilePhoneNumber).Width(100);
                      columns.Bound(c => c.Email).Width(100);
                      columns.Bound(c => c.PreferedDate).Width(100);
                      columns.Bound(c => c.TrainingVenue).Width(100);

                      columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
                  })
                  .ToolBar(toolbar => {
                      toolbar.Create();
                      toolbar.Excel();
                      toolbar.Pdf();
                  })
                  .Editable(editable =>
                  {
                      editable.Mode(GridEditMode.PopUp);

                      editable.TemplateName("TraineeEditorTemplate");
                      editable.Window(window =>
                      {
                          window.Title("Trainee Registration");
                          window.Scrollable(true);
                          window.Height(550);
                      });
                  })
                  .Pageable(pagable =>
                  {
                      pagable.Enabled(true);
                      pagable.PageSizes(true);
                      pagable.Refresh(true);
                      pagable.ButtonCount(10);
                      pagable.Input(true);
                      pagable.Numeric(false);
                      //pagable.Messages

                  })
                  .Events(ev =>
                  {
                      ev.Edit("onTraineeEdit");
                  })
                  .Navigatable()
                  .Selectable(selectable => {
                      selectable.Mode(GridSelectionMode.Single);
                      selectable.Type(GridSelectionType.Row);
                  })
                  .Sortable(sortable => {
                      sortable.SortMode(GridSortMode.SingleColumn);
                  })
                  .Filterable()
                  .Scrollable(s => s.Height(700))
                  .Events(ev =>
                  {
                      ev.DataBound("onTraineeGridDataBound");
                  })
                  .DataSource(dataSource => dataSource
                      .Ajax()
                      .Model(model => model.Id(p => p.CmsTraineeId))
                      .Events(ev => ev
                            .Error("error_handler(\"trainee_grid\")")
                            .RequestStart("onRequestStart(\"trainee_grid\")")
                            .RequestEnd("onRequestEnd(\"trainee_grid\")"))

                      .Read(read => read.Action("Trainees_Read", "Trainees", new { traineeType = ExceedERP.Core.Domain.CMS.TraineeType.Individual}))
                      .Create(create => create.Action("Trainees_Create", "Trainees", new { traineeType = ExceedERP.Core.Domain.CMS.TraineeType.Individual }))
                      .Update(update => update.Action("Trainees_Update", "Trainees"))
                      .Destroy(destroy => destroy.Action("Trainees_Destroy", "Trainees"))
                  ).ClientDetailTemplateId("trainee_detail_template")
            )
        </text>);
        items.Add().Text("Companies").Content(@<text>
            @(Html.Kendo().Grid<ExceedERP.Core.Domain.CMS.CmsTrainee>()
                  .Name("company_grid")
                  .Columns(columns =>
                  {
                      columns.Template(c => { }).Width(100)
                     .ClientTemplate("<img class='circular-profile-img-small' src ='" + @Url.Content("~/Content/Images/CMS/Profiles/") + "#=ProfilePicFileName#'/>");
                      columns.Bound(c => c.RegistrationDate).Width(100);
                      columns.Bound(c => c.RegistrationNumber).Width(350);
                      columns.ForeignKey(c => c.CMSProgramId, (IEnumerable)ViewData["Programs"], "CMSProgramId", "Name").Width(100);
                      columns.ForeignKey(c => c.CMSCourseId, (IEnumerable)ViewData["Courses"], "CMSCourseId", "Name").Width(100);

                      //columns.Bound(c => c.FullName);
                      columns.Bound(c => c.Nationality).Width(100);
                      columns.Bound(c => c.CompanyName).Width(100);
                      columns.Bound(c => c.Region).Width(100);
                      columns.Bound(c => c.Address).Width(100);
                      columns.ForeignKey(c => c.CityId, (IEnumerable)ViewData["Cities"], "CityId", "Name").Width(100);
                      //columns.Bound(c => c.DateOfBirth);
                      columns.Bound(c => c.PhoneNumber).Width(100);
                      columns.Bound(c => c.MobilePhoneNumber).Width(100);
                      columns.Bound(c => c.Email).Width(100);
                      columns.Bound(c => c.PreferedDate).Width(100);
                      //columns.Bound(c => c.TrainingVenue);

                      columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
                  })
                  .ToolBar(toolbar => {
                      toolbar.Create();
                      toolbar.Excel();
                      toolbar.Pdf();
                  })
                  .Events(ev =>
                  {
                      ev.Edit("onCompanyEdit");
                  })
                  .Editable(editable =>
                  {
                      editable.Mode(GridEditMode.PopUp);

                      editable.TemplateName("CompanyEditorTemplate");
                      editable.Window(window =>
                      {
                          window.Title("Company Registration");
                          window.Scrollable(true);
                          window.Height(550);
                      });
                  })
                  .Pageable()
                  .Navigatable()
                  .Selectable(selectable => {
                      selectable.Mode(GridSelectionMode.Single);
                      selectable.Type(GridSelectionType.Row);
                  })
                  .Sortable(sortable => {
                      sortable.SortMode(GridSortMode.SingleColumn);
                  })
                  .Filterable()
                  .Scrollable(s => s.Height(700))
                  .DataSource(dataSource => dataSource
                      .Ajax()
                      .Model(model => model.Id(p => p.CmsTraineeId))
                      .Events(ev => ev
                            .Error("error_handler(\"company_grid\")")
                            .RequestStart("onRequestStart(\"company_grid\")")
                            .RequestEnd("onRequestEnd(\"company_grid\")"))

                      .Read(read => read.Action("Trainees_Read", "Trainees", new { traineeType = ExceedERP.Core.Domain.CMS.TraineeType.Company }))
                      .Create(create => create.Action("Trainees_Create", "Trainees", new { traineeType = ExceedERP.Core.Domain.CMS.TraineeType.Company }))
                      .Update(update => update.Action("Trainees_Update", "Trainees"))
                      .Destroy(destroy => destroy.Action("Trainees_Destroy", "Trainees"))
                  ).ClientDetailTemplateId("company_detail_template")
            )
        </text>);
    }))

<script id="trainee_detail_template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("trainee_tab_str_#=CmsTraineeId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Detail").Content(@<text>

                <a class="btn btn-primary k-button k-button-icontext" href='@Url.Action("RegistrationSlip", "CMSPrint")/#=CmsTraineeId#' title="Print Registration Slip"><i class="fa fa-print  fa-2x"></i> &nbsp;&nbsp; Print Registration Slip</a>
                #if(Status == "@ExceedERP.Core.Domain.CMS.TraineeStatusConstants.PassedExamination"){#
                    <a class="btn btn-success k-button k-button-icontext" href="\#" onclick='return printCertificate("#=RegistrationNumber#","#=CmsTraineeId#","#=FullName#" )' title="Print Certificate"><i class="fa fa-certificate  fa-2x"></i> &nbsp;&nbsp; Print Certificate</a>
                #}#

                @(Html.Kendo().PanelBar()
                    .Name("trainee_panelbar_#=CmsTraineeId#")
                    .ExpandMode(PanelBarExpandMode.Multiple)
                    .Items(panelbar =>
                    {
                        panelbar.Add()
                            .Expanded(true)
                            .Text("Detail")
                            .Content(
                                "<div>" +
                                "<ul>" +
                                "<li> <label> Status: </label> <strong> #=Status != null ? Status: ' '# </strong> </li>" +
                                "<li> <label> Created by: </label> <strong> #=CreatedBy != null ? CreatedBy: ' '# </strong> </li>" +
                                "<li> <label> Created on: </label> #= kendo.toString(DateCreated, 'dd/MM/yyyy H:mm:ss')# </li>" +
                                "<li> <label> Modified by :</label> #= ModifiedBy != null ? ModifiedBy: ''# </li>" +
                                "<li> <label> Last Modified :</label> #= LastModified != null ? kendo.toString(LastModified, 'dd/MM/yyyy H:mm:ss') : ' '# </li>" +
                                "</ul>" +
                                "</div>"
                            );

                    }).ToClientTemplate()
                ) 
            </text>);
            items.Add().Text("Barcode").Content(@<text>
                <a class="btn btn-primary k-button k-button-icontext" href='\\#' onclick='return onRegerateBarcodeClick("#=CmsTraineeId#", "#=BarcodeImageName#")' title="Regenerate Barcode"><i class="fa fa-repeat  fa-2x"></i> &nbsp;&nbsp; Regenerate Barcode</a>

                <div class="image-container-box">
                    <img class="rectuangular-large-img" src="~/Content/Images/CMS/Barcodes/#=BarcodeImageName#" />
                </div>
            </text>);
            items.Add().Text("Profile").Content(@<text>
                <div>
                    @ProfileChangeHelper()
                </div>
                <div class="image-container-box">
                    <img class="rectuangular-large-img" src="~/Content/Images/CMS/Profiles/#=ProfilePicFileName#" />
                </div>

            </text>);
            items.Add().Text("Registration No. Components").Content(@<text>
                @RegistrationNumberComponentHelper()
            </text>);
            items.Add().Text("Identification").Content(
            @<text>
                @IdentificationTabHelper()
            </text>);
        }).ToClientTemplate()
    )
</script>
