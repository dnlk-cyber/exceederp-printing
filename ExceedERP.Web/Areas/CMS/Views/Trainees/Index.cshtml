<script type="text/javascript">
    function getSelectedRegion() {
        return {
            region: $("#Region").val(), filterString: $("#CityId").data("kendoDropDownList").filterInput.val()
        }
    }
    function printCertificate(regNumber, traineeId, fName) {
        window.location.href = `/CMS/CMSPrint/QualificationCertificate?regn=${regNumber}&ti= ${traineeId}&name=${fName}`;
    }
    function onTraineeEdit(e) {
        if (e.model.isNew()) {
            $("#trainee-profile-container").hide();
            $("#registrationNumberContainer").hide();
        } else {
            $("#trainee-profile-container").show();
            $("#registrationNumberContainer").show();
        }
    }
    function onCompanyEdit(e) {
        if (e.model.isNew()) {
            $("#trainee-profile-container").hide();
            $("#registrationNumberContainer").hide();
        } else {
            $("#trainee-profile-container").show();
            $("#registrationNumberContainer").show();
        }
    }
    function onRegerateBarcodeClick(id, existingBarcodeImage) {
        var canGen = false;
        if (existingBarcodeImage != null) {
            canGen = confirm("Are you sure you want to Generate Barcode?");
        }
        if (canGen == true) {
                canGen
                 $.ajax({
                    type: "POST",
                    url: '@Url.Action("RegenerateBarcode", "Trainees", new { area = "CMS" })',
                    data: { traineeId: id },
                    success: function (result) {
                        alert(result.Message);
                        location.reload(true);
                    },
                    error: function (result) {
                        alert(result);
                    }
                });
            }
    }
    function onTraineeGridDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            if (dataItem.Status === "@ExceedERP.Core.Domain.CMS.TraineeStatusConstants.PassedExamination" || 
                dataItem.Status === "@ExceedERP.Core.Domain.CMS.CompanyStatusConstants.PassedEvaluation") {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.addClass("k-state-PassedEvaluation");
            } else if (dataItem.Status === "@ExceedERP.Core.Domain.CMS.TraineeStatusConstants.FailedExamination" ||
                dataItem.Status === "@ExceedERP.Core.Domain.CMS.CompanyStatusConstants.FailedEvaluation") {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.addClass("k-state-FailedEvaluation");

            }
            //else if (dataItem.Status == "Rejected") {
            //    row.addClass("k-state-Rejected");
            //}
            //else {

            //    row.find(".k-grid-edit").show();
            //    row.find(".k-grid-delete").show();
            //}
        }
    }
</script>

<style>
    .k-grid table tr.k-state-PassedEvaluation {
        background: #b7ff9e;
    }
        .k-grid table tr.k-state-PassedEvaluation.k-alt {
            background: #c6ffb3;
        }

    .k-grid table tr.k-state-FailedEvaluation {
        background: #fac2c2;
    }

        .k-grid table tr.k-state-FailedEvaluation.k-alt {
            background: #f9cfcf;
