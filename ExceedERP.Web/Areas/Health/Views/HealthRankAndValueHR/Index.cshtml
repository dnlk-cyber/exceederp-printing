@using System.Collections
@using ExceedERP.Core.Domain.Health
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Health Value and Payment HR </legend>
@(Html.Kendo().Grid<HealthRankAndValue>()
       .Name("Healthgrid")
       .Columns(columns =>
       {

           columns.Bound(c => c.PaymentRequestId).Title("Request Id ").Width(120);
           // columns.Bound(c => c.EmployeeCode).Width(130).ClientGroupHeaderTemplate("#=value# // Total Used Amount : #=aggregates.UsedAmount.sum#");
           columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["Employee"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("EmployeeList").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));//.ClientGroupFooterTemplate("#=aggregates.UsedAmount.sum#");
           columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
           columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
           columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["FiscalYear"], "GlFiscalYearId", "Name").EditorTemplateName("GLYearSelector").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));//.ClientGroupHeaderTemplate("#=value# //  Used Amount Per Budget Year : #=aggregates.UsedAmount.sum# //  Remaining Per Budget Year : #=aggregates.RemainingAmount.min#");
           columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["Period"], "GLPeriodId", "Name").EditorTemplateName("GLFPeriods").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
           columns.Bound(c => c.RecoredDate).Hidden().Width(120);
           columns.Bound(c => c.ClinicName).Width(120);
           columns.Bound(c => c.DateAmh).EditorTemplateName("Calander").Width(130);
           columns.Bound(c => c.RecoredDateAmh).EditorTemplateName("Calander").Width(130);
           columns.Bound(c => c.AllowedAmount).Width(130);
           columns.Bound(c => c.TotalPaid).Width(130);
           columns.Bound(c => c.UsedAmount).Width(130);
           columns.Bound(c => c.StaffContribution).Width(130);
           columns.Bound(c => c.RemainingAmount).Width(150);
           columns.Bound(c => c.BenefitType).Width(150);
           columns.Bound(c => c.PaymentType).Width(150);
           columns.Bound(c => c.PaymentCoverage).Width(150);
           columns.Bound(c => c.IsOtherBenifit).Hidden();
           columns.Bound(c => c.IsPartnerOrGov).ClientTemplate(
             "<input type='checkbox' disabled = 'true' value='#= IsPartnerOrGov#' " +
             "# if (IsPartnerOrGov) { #" +
             "checked='checked'" +
             "# } #" +
             "/>").Width(140);
           columns.Command(command =>
           {
               //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
               //command.Destroy().Text(Resources.ActionButton_Cancel);

           }).Width(200);


       })
       .ToolBar(toolbar =>
       {
           //toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

       })
       .Editable(editable => editable.Mode(GridEditMode.PopUp)
            .TemplateName("HealthRankAndValue")
            .Window(window =>
            {
                window.Title(Resources.Emyployee_Health_Value);

            }))
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        .Events(ev => {
            ev.DetailExpand("onDetailExpandUser");
            ev.DataBound("onMasterDataBound");
        })
        .Scrollable(h => h.Height(500))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);



        })
        .Filterable()
        .Events(x =>
        {
            x.Edit("GetDate");
            x.Save("GetDate");
        })
        .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))
        .DataSource(dataSource => dataSource
        .Ajax()
        .Aggregates(x =>
        {
            x.Add(f => f.UsedAmount).Sum();
            x.Add(f => f.RemainingAmount).Min();

        })
        .Sort(sort => sort.Add(x => x.HealthRankAndValueId).Descending())
        //.Group(x => x.Add(p => p.EmployeeCode))
        //.Group(x => x.Add(p => p.EmployeeId))
        //.Group(x => x.Add(p => p.GlFiscalYearId))
        .Events(events =>
        {
            events.Error("error_handler(\"Healthgrid\")");
            events.RequestStart("onRequestStart(\"Healthgrid\")");
            events.RequestEnd("onRequestEnd(\"Healthgrid\")");



        })
        .Model(model =>
        {
            model.Id(p => p.HealthRankAndValueId);
            model.Field(p => p.AllowedAmount).Editable(false);
            model.Field(p => p.UsedAmount).Editable(false);
            model.Field(p => p.StaffContribution).Editable(false);
            model.Field(p => p.RemainingAmount).Editable(false);
            model.Field(p => p.BranchId).Editable(false);
            //model.Field(p => p.EmployeeCode).Editable(false);
            model.Field(p => p.PaymentRequestId).Editable(false);


        })
        .Read(read => read.Action("HealthRankAndValue_Read", "HealthRankAndValueHR"))
        .Create(create => create.Action("HealthRankAndValue_Create", "HealthRankAndValueHR"))
        .Update(update => update.Action("HealthRankAndValue_Update", "HealthRankAndValueHR"))
        .Destroy(destroy => destroy.Action("HealthRankAndValue_Destroy", "HealthRankAndValueHR"))
        ).ClientDetailTemplateId("Rank_Value_template")
)

