<script id="Rank_Value_template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_#=HealthRankAndValueId#")
        .SelectedIndex(0)
        .Items(items =>
        {


            items.Add().Text("Validation").Content(
            @<text>
                           
                @(Html.Kendo().Grid<HealthRankAndValueFinalValidation>()
                    .Name("Validation_grid#=HealthRankAndValueId#")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.Status).Width(150);
                        columns.Bound(c => c.Remark).Width(150);
                        columns.Command(command =>
                        {
                            command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit).HtmlAttributes(new { id = "ccEditButton" });
                            command.Destroy().Text(Resources.ActionButton_Cancel).HtmlAttributes(new { id = "ccDeleteButton" });

                        });


                    })
                    .ToolBar(toolbar =>
                    {

                        toolbar.Create().Text(Resources.ActionButton_AddNewRecord).HtmlAttributes(new { id = "ccAddButton" });

                    })
                    .Events(e =>
                    {
                        e.DataBound("onDetailDataBound");

                    })
                    .Editable(editable => editable.Mode(GridEditMode.InLine))
                    .Scrollable()
                    .Selectable()
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Events(events =>
                        {
                            events.Error("error_handler(\"Validation_grid#=HealthRankAndValueId#\")");
                            events.RequestStart("onRequestStart(\"Validation_grid#=HealthRankAndValueId#\")");
                            events.RequestEnd("onRequestEnd(\"Validation_grid#=HealthRankAndValueId#\")");

                        })
                        .Model(model => model.Id(p => p.HealthRankAndValueFinalValidationId))
                        .Read(read => read.Action("HealthRankAndValueValidations_Read", "HealthRankAndValueFinalValidations", new { vId = "#=HealthRankAndValueId#" }))
                        .Create(create => create.Action("HealthRankAndValueValidation_Create", "HealthRankAndValueFinalValidations", new { vId = "#=HealthRankAndValueId#" }))
                        .Update(update => update.Action("HealthRankAndValueValidation_Update", "HealthRankAndValueFinalValidations"))
                        .Destroy(destroy => destroy.Action("HealthRankAndValueValidation_Destroy", "HealthRankAndValueFinalValidations"))
                        ).ToClientTemplate()
                        )

                        </text>);
                        items.Add().Text("Attachments").Content(
                        @<text>
                                                
                                <button onclick='UploadFile(#=HealthRankAndValueId#)' class='fa fa-upload btn btn-primary'>&nbsp;Upload </button>

                            @(Html.Kendo().Grid<HealthAttachment>()
                                    .Name("HealthAttachmentGrid#=HealthRankAndValueId#")
                                    .Columns(columns =>
                                    {

                                        columns.Bound(c => c.FileName).ClientTemplate("<a href='/Health/HealthAttachments/DownloadAttachment?healthAttachmentId=\\#=HealthAttachmentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; \\#=FileName\\# </a>").Width(150);

                                        columns.Template(e => { }).ClientTemplate("<a href='/Health/HealthAttachments/DownloadAttachment?healthAttachmentId=\\#=HealthAttachmentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; Download </a>").Width(100);
                                        columns.Template(e => { }).ClientTemplate("<a href='\\#=ShortPath\\#/\\#=FileName\\#' target='_blank'> <f class = 'fa fa-folder-open'></i> &nbsp;&nbsp; Open</a>").Width(100);

                                        columns.Command(command =>
                                        {
                                            command.Destroy().Text("Delete");
                                        }).Width(300);

                                    })
                                    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("UploadDocument")
                                    .Window(window =>
                                    {
                                        window.Title("");
                                        window.Scrollable(false);
                                    }))
                                    .Scrollable(h => h.Height("auto"))
                                    .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Sort(sort => sort.Add(c => c.HealthAttachmentId).Descending())
                                    .Events(events =>
                                    {
                                        events.Error("error_handler(\"HealthAttachmentGrid#=HealthRankAndValueId#\")");
                                        events.RequestStart("onRequestStart(\"HealthAttachmentGrid#=HealthRankAndValueId#\")");
                                        events.RequestEnd("onRequestEnd(\"HealthAttachmentGrid#=HealthRankAndValueId#\")");
                                    })
                                    .Model(model => model.Id(p => p.HealthAttachmentId))
                                    .Read(read => read.Action("HealthAttachments_Read", "HealthAttachments", new { id = "#=HealthRankAndValueId#", area = "Health" }))
                                    .Create(create => create.Action("HealthAttachments_Create", "HealthAttachments", new { id = "#=HealthRankAndValueId#", area = "Health" }))
                                    .Update(update => update.Action("HealthAttachments_Update", "HealthAttachments"))
                                    .Destroy(destroy => destroy.Action("HealthAttachments_Destroy", "HealthAttachments"))
                                    ).ToClientTemplate())
                        </text>);


                    }).ToClientTemplate()
                    )
</script>


