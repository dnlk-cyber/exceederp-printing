@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.Health.ReferralSheet


<div class="form">
    <div class="row fullrow">
        <div class="col-md-3 ro1">
            <div class="form-group">
                <div>
                    @Html.LabelFor(model => model.DateAmharic, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>
                    @Html.TextBoxFor(model => model.DateAmharic, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />
                    @Html.ValidationMessageFor(model => model.DateAmharic, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div>
                    @Html.LabelFor(model => model.ReferredFrom, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @Html.Kendo().TextBoxFor(model => model.ReferredFrom)
                    @Html.ValidationMessageFor(model => model.ReferredFrom, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">

                <div>
                    @Html.LabelFor(model => model.MainCompanyId, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @(Html.Kendo().DropDownListFor(model => model.MainCompanyId)
                                                             .DataTextField("TradeName")
                                                                              .DataValueField("MainCompanyId")
                                                                          //.BindTo((IEnumerable)ViewData["Hospitals"]))
                                                                          .OptionLabel(Resources.Select)
                                  .Filter("contains")
                                  .MinLength(2)
                                                                         .DataSource(dataSource =>
                                                                         {
                                                                             dataSource.Read(read => read.Action("GetHospitals", "HRMDataProvider"))
                                                                                 .ServerFiltering(false);
                                                                         })
                                  .ValuePrimitive(true))
                                        @Html.ValidationMessageFor(model => model.MainCompanyId, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-3 ro1">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.BriefHistory, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @Html.TextAreaFor(model => model.BriefHistory)
                    @Html.ValidationMessageFor(model => model.BriefHistory, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div>
                    @Html.LabelFor(model => model.PhiscalFindings, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @Html.TextAreaFor(model => model.PhiscalFindings)
                    @Html.ValidationMessageFor(model => model.PhiscalFindings, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <div>
                    @Html.LabelFor(model => model.LabXrayFindings, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @Html.TextAreaFor(model => model.LabXrayFindings)
                    @Html.ValidationMessageFor(model => model.LabXrayFindings, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-2 ro1">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Diagnosis, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @Html.TextAreaFor(model => model.Diagnosis)
                    @Html.ValidationMessageFor(model => model.Diagnosis, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <div>
                    @Html.LabelFor(model => model.TreatmentGiven, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @Html.TextAreaFor(model => model.TreatmentGiven)
                    @Html.ValidationMessageFor(model => model.TreatmentGiven, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <div>
                    @Html.LabelFor(model => model.Recommendation, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @Html.TextAreaFor(model => model.Recommendation)
                    @Html.ValidationMessageFor(model => model.Recommendation, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-2 ro1">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.RecommendedBy, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @Html.Kendo().TextBoxFor(model => model.RecommendedBy)
                    @Html.ValidationMessageFor(model => model.RecommendedBy, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <div>
                    @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @Html.TextAreaFor(model => model.Remark)
                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
</div>
