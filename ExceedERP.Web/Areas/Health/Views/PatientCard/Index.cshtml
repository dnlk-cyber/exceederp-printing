<script>

    var PatientCardDetailId = 0;
    var PatientCardId = 0;
    var masterIdGlobal = 0;


    function AddDrug(e) {
        try {

            var row = $(e.target).closest("tr");
            var grid = $("#PatientCardDetailgrid" + masterIdGlobal).data("kendoGrid");
            var dataItem = grid.dataItem(row);
            PatientCardDetailId = dataItem.PatientCardDetailId;
            PatientCardId = dataItem.PatientId;

            var popGrid = $("#PatientDrugOrderGrid").data("kendoGrid");
            popGrid.dataSource.read();

            var wnd = $("#SendToDespensaryWindow").data("kendoWindow");

            var windowOptions = wnd.options;

            var pos = wnd.wrapper.position();

            var viewPortWidth = $(window).width();
            var wndWidth = windowOptions.width;

            pos.left = viewPortWidth / 2 - wndWidth / 2;


            wnd.wrapper.css({
                left: 256,
                top: 130
            });

            wnd.open();

            wnd.wrapper.css({
                width: 900,
                height: 400
            });

            //////////////////////////////////


            ///////////////////////////////

        } catch (ex) {
            alert("Please select the row!!");
        }
    }

    function filterData() {

        PatientCardId = PatientCardId;
        var cardDetailId = PatientCardDetailId;

        return {

            cardDetailId: cardDetailId,
            PatientCardId: PatientCardId
        };
    }
</script>

