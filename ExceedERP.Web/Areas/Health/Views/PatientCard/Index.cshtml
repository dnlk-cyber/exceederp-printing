        }
    }

</script>

<script>
    function SendToPatientRegister(e) {

       // $('#loading-image').show();
            var row = $(e.target).closest("tr");
        var grid = $("#PatientDrugOrderGrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.PatientDrugOrderId;

        if (id.length !== 0 )
        {
            $.ajax({
                url: '@Url.Action("SendToDespensary", "PatientDrugOrder")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);
                    //$('#loading-image').hide();
                    grid.dataSource.read();
                }
            });

        }
    }
</script>

<script>

    $("#SendToDespensaryPatientRegister").click(function (e) {
            e.preventDefault();
        //put custom logic here
         // $('#loading-image').show();
        var conf = confirm("Are you sure you want to close this process ?");
        if (conf === true) {
            var grid = $("#PatientDrugOrderGrid").data("kendoGrid");
            if (PatientCardId.length !== 0 && PatientCardDetailId.length !== 0) {

                $.ajax({
                    url: '@Url.Action("SendToDespensaryPatientRegister", "PatientDrugOrder")',

                    data: { patientId: PatientCardId, cardDetailId: PatientCardDetailId },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        r = result;
                        alert(r.Message);
                        //$('#loading-image').hide();
                        grid.dataSource.read();
                    }
                });

            }
        }
    });

</script>



