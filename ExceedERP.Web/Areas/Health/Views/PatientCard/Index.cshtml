<legend>@Resources.NavigatorHealthAndInsurance_PatientCard</legend>
@(Html.Kendo().Grid<PatientCard>()
            .Name("PatientCardgrid")
            .Columns(columns =>
             {
                 columns.Bound(c => c.PatientCardId).Width(120);
                 columns.Bound(c => c.DateAmharic).Width(150);
                 columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(200);
                 columns.Bound(c => c.Age).Width(75);
                 columns.Bound(c => c.Sex).Width(90);


                 columns.Command(command =>
     {
                    if (HttpContext.Current.User.IsInRole("Health_User"))
                    {
                        command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                    }
                    if (HttpContext.Current.User.IsInRole("Health_Admin"))
                    {
                        command.Destroy().Text(Resources.ActionButton_Cancel);
                    }
                }).Width(200);
             })
            .ToolBar(toolbar =>
            {
                if (HttpContext.Current.User.IsInRole("Health_User"))
                {

                    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                }
            })
                            .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("PatientCard").Window(window => { window.Title(Resources.NavigatorHealthAndInsurance_PatientCard); window.Scrollable(false); }))
            .Scrollable(h => h.Height(500))
                            .Groupable()
                                    .Sortable(sortable =>
                                    {
                                        sortable.SortMode(GridSortMode.SingleColumn);
                                    })
                        .Filterable()
                        .Events(x =>
                        {
                            x.Save("GetDate");
                            x.Edit("GetDate");
                        })
                        .Events(x =>
                        {
                            x.DataBound("onDataBound");
                            x.DetailExpand("onMasterDetailExpand");
                        })
                            .Pageable(pageable => pageable
                                                    .Input(true)
                                                    .Numeric(false)
                                                    .Refresh(true)
                                                    .PageSizes(true)
                                                    .ButtonCount(5))
            .DataSource(dataSource => dataSource
                .Ajax()
                .Sort(sort => sort.Add("LastModifiedDate").Descending())
                    .Events(events =>
                    {
                        events.Error("error_handler(\"PatientCardgrid\")");
                        events.RequestStart("onRequestStart(\"PatientCardgrid\")");

                        events.RequestEnd("onRequestEnd(\"PatientCardgrid\")");
                    })

                .Model(model => model.Id(p => p.PatientId))
                .Read(read => read.Action("PatientCard_Read", "PatientCard"))
                .Create(create => create.Action("PatientCard_Create", "PatientCard"))
                .Update(update => update.Action("PatientCard_Update", "PatientCard"))
                .Destroy(destroy => destroy.Action("PatientCard_Destroy", "PatientCard"))
                ).ClientDetailTemplateId("template")
)
