<script>
    function Check(e) {
        try {

            var row = $(e.target).closest("tr");
            var grid = $("#PatientCardDetailgrid" + masterIdGlobal).data("kendoGrid");
            var dataItem = grid.dataItem(row);
            PatientCardDetailId = dataItem.PatientCardDetailId;
            PatientCardId = dataItem.PatientId;

            var popGrid = $("#PatientDrugOrderGrid").data("kendoGrid");
            popGrid.dataSource.read();

            var checkWnd = $("#CheckWindow").data("kendoWindow");

            var windowOptions = checkWnd.options;

            var pos = checkWnd.wrapper.position();

            var viewPortWidth = $(window).width();
            var wndWidth = windowOptions.width;

            pos.left = viewPortWidth / 2 - wndWidth / 2;


            checkWnd.wrapper.css({
                left: 256,
                top: 130
            });

            checkWnd.open();

            checkWnd.wrapper.css({
                width: 900,
                height: 400
            });


        } catch (ex) {
            alert("Please select the row!!");
        }
    }
</script>