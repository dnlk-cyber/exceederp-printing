<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#DateAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "PatientCard")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>

<script>
    function GetDetailDate() {

        var x = AssignDate();
        var y = x;
        $("#DateAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "PatientCardDetail")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }

</script>

<script>
    function GetAgeSex() {
        var Employee = $("#EmployeeId").data("kendoDropDownList");
        var emp = Employee.value();
       $.ajax({
            url: '@Url.Action("GetAgeSex", "PatientCard")',

           data: { emp: emp },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                var agse = r.split(/-/);
                $("#Age").val(agse[0]);
                $("#Sex").val(agse[1]);
                $("#PatientCardId").val(agse[2] +"-"+ agse[3] +"-"+ agse[4]);
            }

        });
    }
    function valueMapper(options) {
        $.ajax({
            url: "/HRM/HRMDataProvider/Employee_ValueMapper/",
            data: {
                value: options.value || 0,
                status: 1,
                excludeId: -1
            },
            success: function (data) {
                options.success(data);
            }
        });
    }

    function convertValues(value) {
        var data = {};

        value = $.isArray(value) ? value : [value];

        for (var idx = 0; idx < value.length; idx++) {
            data["values[" + idx + "]"] = value[idx];
        }

        return data;
    }
</script>



<script>
        function SendToLaboratory(e) {

            $('#loading-image').show();
            var row = $(e.target).closest("tr");
            var grid = $("#PatientCardDetailgrid" + masterIdGlobal).data("kendoGrid");
        var dataItem = grid.dataItem(row);
            var id = dataItem.PatientCardDetailId;

        if (id.length !== 0 )
        {
            var conf = confirm("Are you sure you want to sent to Laboratory ?");
            if (conf === true) {
                $.ajax({
                    url: '@Url.Action("SendToLaboratory", "PatientCard")',

                    data: { id: id },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        r = result;
                        alert(r.Message);
                        $('#loading-image').hide();
                        grid.dataSource.read();
                    }
                });
            }
            else {
                $('#loading-image').hide();
                grid.dataSource.read();
            }
        }
    }
</script>

<script>
    function CloseRequest(e) {

        $('#loading-image').show();
            var row = $(e.target).closest("tr");
        var grid = $("#PatientCardDetailgrid" + masterIdGlobal).data("kendoGrid");
        var dataItem = grid.dataItem(row);
            var id = dataItem.PatientCardDetailId;


        if (id.length !== 0 )
        {
            var conf = confirm("Are you sure you want to close this process ?");
            if (conf === true) {
                $.ajax({
                    url: '@Url.Action("CloseRequest", "PatientCard")',

                    data: { id: id },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        r = result;
                        alert(r.Message);
                        $('#loading-image').hide();
                        grid.dataSource.read();
                    }
                });
            }
            else {
                $('#loading-image').hide();
                grid.dataSource.read();
            }
        }
    }
</script>

<script>

    function onDataBound(e) {
        var rows = e.sender.tbody.children();
        masterRowGlobal = rows;
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsSent === true && dataItem.IsTested === false) {

                row.css("background-color", "lightgreen");
            }
            if (dataItem.IsNew === true) {

                row.css("background-color", "lightgreen");
            }
            if (dataItem.IsSent === true && dataItem.IsTested === true) {

                row.css("background-color", "yellow");
            }
            if (dataItem.IsClosed === true) {

                row.css("background-color", "lightgray");
            }
        }

    }

    function patientRegisterDetailDataBound(e) {

        var rows = e.sender.tbody.children();
        var gridDetail = $("#PatientCardDetailgrid" + masterIdGlobal).data("kendoGrid");
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);

            if (dataItem.IsClosed === false && dataItem.IsSentToLaboratory === false && dataItem.IsSentDespensary === false) {

                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").show();
                row.find("#sendforlaboratory").show();
                row.find("#closeproccess").hide();

            }
            if (dataItem.IsClosed === false && dataItem.IsSentToLaboratory === true) {

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find("#sendforlaboratory").hide();
                row.find("#closeproccess").show();

            }

            if (dataItem.IsSentDespensary === true && dataItem.IsClosed === false) {

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find("#sendforlaboratory").hide();
                row.find("#closeproccess").show();

            }
            if (dataItem.IsClosed === true) {

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find("#sendforlaboratory").hide();
                row.find("#closeproccess").hide();

            }

        }
    }

</script>

