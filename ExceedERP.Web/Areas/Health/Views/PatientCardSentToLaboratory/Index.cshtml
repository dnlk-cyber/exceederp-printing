                                        {
                                            x.Save("GetDetailDate");
                                            x.Edit("GetDetailDate");
                                            x.DetailExpand("onPatientCardDetailExpand");
                                        })
                            .ClientDetailTemplateId("laboratory")
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Sort(sort => sort.Add("Date").Descending())
                                            .Events(events =>
                                            {
                                                events.Error("error_handler(\"PatientCardDetailgrid#=PatientId#\")");
                                                events.RequestStart("onRequestStart(\"PatientCardDetailgrid#=PatientId#\")");
                                                events.RequestEnd("onRequestEnd(\"PatientCardDetailgrid#=PatientId#\")");
                                            })

                                .Model(model => model.Id(p => p.PatientCardDetailId))
                                                .Read(read => read.Action("PatientCardDetailSentToLaboratory_Read", "PatientCardDetail", new { id = "#=PatientId#" }))
                                        .Create(create => create.Action("PatientCardDetail_Create", "PatientCardDetail", new { id = "#=PatientId#" }))
                                .Update(update => update.Action("PatientCardDetail_Update", "PatientCardDetail"))
                                .Destroy(destroy => destroy.Action("PatientCardDetail_Destroy", "PatientCardDetail"))
                            ).ToClientTemplate()
                     )


                                                              
                    </text> );





                }).ToClientTemplate())
</script>



