                                         //    if (HttpContext.Current.User.IsInRole("Health_User"))
                                         //    {

                                         //        toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                         //    }
                                         //})
                                         .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("PatientCard").Window(window => { window.Title(Resources.NavigatorHealthAndInsurance_PatientCard); window.Scrollable(false); }))
                            .Scrollable(h => h.Height(500))
