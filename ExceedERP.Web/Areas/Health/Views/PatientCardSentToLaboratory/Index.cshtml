<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#DateAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "PatientCard")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>

<script>
    function GetDetailDate() {

        var x = AssignDate();
        var y = x;
        $("#DateAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "PatientCardDetail")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }

</script>


<script>
    function SendToDoctor(e) {

        $('#loading-image').show();
            var row = $(e.target).closest("tr");
        var grid = $("#LaboratoryTestsPatientCardgrid" + LaboratoryCatagoryPatientCardId).data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.LaboratoryTestPatientCardId;


        if (id.length !== 0 )
        {
            $.ajax({
                url: '@Url.Action("SendToDoctor", "PatientCard")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message)
                    $('#loading-image').hide();
                    grid.dataSource.read();
                }
            });

        }
    }
</script>


<script>

    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsSent === true) {

                row.css("background-color", "lightgreen");
            }
            else if (dataItem.IsNew === true) {

                row.css("background-color", "lightgreen");
            }
            else if (dataItem.IsTested === true) {

                row.css("background-color", "yellow");
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find("#sentfordoctor").hide();
            }
        }

    }

</script>

<script>
    function onDataBoundDetail(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.onDataBoundDetail === true) {

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find("#sentfordoctor").hide();
            }
        }
    }
</script>

<script>

    var PatientId = 0;
    var LaboratoryCatagoryPatientCardId = 0;
    var PatientCardDetailId = 0; 

    function onMasterDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#PatientCardgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        PatientId = masterDataItem.PatientId;
    }

    function onPatientCardDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#PatientCardDetailgrid" + PatientId).data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        PatientCardDetailId = masterDataItem.PatientCardDetailId;
    }

    function onLaboratoryCatagoryPatientCardExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#LaboratoryCatagoryPatientCardgrid" + PatientCardDetailId).data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        LaboratoryCatagoryPatientCardId = masterDataItem.LaboratoryCatagoryPatientCardId;
    }

</script>