                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function(result) {
                alert(result);
            }
        });
    }
    function GetDate() {

        $("#DateAmh").trigger("change");
        $("#RecoredDateAmh").trigger("change");
    }

</script>

<script>
    function onMasterDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsOnlineApproved === true) {

                row.css("background-color", "darkgrey");
                row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();

            }

            else if (dataItem.IsSendForApproval) {

                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").remove();
            }



        }

    }
    function onBranchChange(e) {
        var branchId = $("#BranchId").data("kendoDropDownList").value();
        console.log("the branchId=" + branchId);
    }
    function OpenAttachementWindow() {

        $("#Healthgrid").val(masterId);

        var wnd = $("#IncomingAttachementWindow").data("kendoWindow");
        wnd.center().open();
    }
    function filterperiods() {

        return {
            GlFiscalYearId: $("#GlFiscalYearId").val()
        };
    }


    var masterId = 0;
     function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

         var masterGrid = $("#Healthgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
         masterId = masterDataItem.HealthRankAndValueId;
         var gridName = "#Validation_grid" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatuses", "HealthRankAndValueValidation")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).remove();
                }

                else if (r == "false") {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    //$(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).show();
                    $(".k-grid-delete", gridName).show();
                }
            }

        });

    }
    function onUploadSuccess(e) {
        // Force the rebinding of the Grid on successful upload
        //$("#HealthAttachmentGrid" + masterId).data("kendoGrid").dataSource.read();
    }
    function onDetailDataBound(e) {
        var gridName = "#Validation_grid" + masterId;
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check
            if (dataItem.Status == 0) {

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
              //  $(gridName).find(".k-toolbar").hide(); //hide toolbar
                $(".k-grid-top", gridName).remove();
                row.css("background-color", "gray");
            }
            if (dataItem.IsDirect === false) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find("#approve").hide();
            }

        }
    }
</script>
<script>
    //function onBranch(e) {
    //    var branchId = $("#BranchId").data("kendoDropDownList").value();
    //    console.log("the branchId="+branchId);
    //}
    function EnableDisableBenefitType(e) {
        var x = $('#IsOtherBenifit').is(':checked');;
        if (x == true) {

            $("#BenefitType").data("kendoDropDownList").enable(true);
            // Disable the checkbox
            $("#IsPartnerOrGov").prop("disabled", true);
        }
        else {

            $("#BenefitType").data("kendoDropDownList").enable(false);
            $("#BenefitType").data("kendoDropDownList").enable(false);

            $("#IsPartnerOrGov").prop("disabled", false);

            // $("#ProformaId").data("kendoDropDownList").value(0);//.trigger("change");
            $("#BenefitType").data("kendoDropDownList").val(0);
            $("#BenefitType").trigger("change");
        }

    }

    function AttachArchiveFiles() {
        try {

            $.ajax({
                url: '@Url.Action("UploadIncomingHealthFiles", "HealthAttachments")',
                //contentType: "application/json; charset=utf-8",
                data: function () {
                    var data = new FormData();

                   // var kkk = $("#letter").get(0).files[0];
                    $.each($("input[type=file]"), function (i, obj) {
                        $.each(obj.files, function (j, file) {
                            data.append('letter[' + j + ']', file);
                        })
                    });

                    //data.append("file", $("#letter").get(0).files[0]);
                    data.append("description", $("#description").val());
                    data.append("masterId", masterId);

                    return data;
                }(),
                type: 'POST',
                contentType: false,
                processData: false,
                cache: false,
                success: function (result) {
                    var wnd = $("#IncomingAttachementWindow").data("kendoWindow");
                    wnd.close();

                    $("#HealthAttachmentGrid" + masterId).data("kendoGrid").dataSource.read();
                    //$("#IncommingLetterRegistration").data("kendoGrid").dataSource.read();
                }
            });
        } catch (e) {
            // alert("Please select the row!!");
        }
    }
    function UploadFile(id) {
        $("#masterId").val(id);
        var wnd = $("#UploadDoc").data("kendoWindow");
        wnd.center().open();
    }
</script>


@(Html.Kendo().Window()
            .Name("UploadDoc")
            .Title("Upload File")
            .Visible(false)
            .Modal(true)
            .Draggable(true)
            .Width(400).Content(
            @<text>
                <div class="form-group">
                    <form id="uploadForm" action="@Url.Action("UploadIncomingHealthFiles", "HealthAttachments", new { })" method="post" , new { enctype="multipart/form-data" }>
                        <input type="hidden" name="masterId" id="masterId">
                        <div class="row">
                            <div class="col-md-10">
                                @Html.TextBox("file", "", new { type = "file", required = "true" })
                                <br />
                            </div>
                        </div>
                        <div>
                            <div class="editor-field">
                                @Html.TextArea("Description", null, new { placeholder = "Description", style = "width: 90%; max-width: 90%;height:60%" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-7"></div>
                            <input type="submit" class="btn-primary k-button" value=" Submit " />
                        </div>

                    </form>
                    <div id="uploadMessage" class="message" style="display:none; padding: 10px; border-radius: 5px; margin-top: 10px;">
                        <!-- Success or Error message will be displayed here -->
                    </div>
                </div>
            </text>)
)

<script>
    $(document).ready(function () {
        // Handle form submission via AJAX
        $('#uploadForm').submit(function (event) {
            event.preventDefault(); // Prevent the default form submission

            var formData = new FormData(this);

            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        // If upload was successful, display success message
                        $('#uploadMessage').text(response.message).css('background-color', 'green').css('color', 'white').show();
                    } else {
                        // If upload failed, display error message
                        $('#uploadMessage').text(response.message).css('background-color', 'red').css('color', 'white').show();
                    }

                    // Optionally close the window after some time
                    setTimeout(function () {
                        $('#UploadDoc').data('kendoWindow').close();
                    }, 3000);
                },
                error: function () {
                    // In case of AJAX error, show a generic error message
                    $('#uploadMessage').text('An error occurred while uploading the file. Please try again.').css('background-color', 'red').css('color', 'white').show();
                },
                cache: false,
                contentType: false,
                processData: false
            });
        });
    });
   
    function onBenefitTypeChange(e) {
        var evaluationType = $("#BenefitType").data("kendoDropDownList");
        var dStatus = evaluationType.value();
        if (dStatus == 2) {
            var showField = document.querySelector('.clasToBeShow');
            
            showField.style.display = 'block';
          

        }
        else {
            var hiddenField = document.querySelector('.clasToBeShow');
          

            hiddenField.style.display = 'none';

        }


    }
