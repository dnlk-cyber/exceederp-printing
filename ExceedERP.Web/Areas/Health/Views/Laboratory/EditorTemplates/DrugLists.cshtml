@(Html.Kendo().DropDownListFor(m => m)
                  .ValuePrimitive(true)
                  .OptionLabel("Select")
                      .DataTextField("Description")
                          .DataValueField("DrugListsId")
                          .Filter("contains")
                                .DataSource(dataSource =>
                                {
                                    dataSource.Read(read => read.Action("GetDrugLists", "APTSDataProvider",new { area = "APTS"}))
                                    .ServerFiltering(false);
                                })
)
@Html.ValidationMessageFor(m => m)
