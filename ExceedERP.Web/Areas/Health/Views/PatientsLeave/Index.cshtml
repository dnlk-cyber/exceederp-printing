<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#DateAmharic").trigger("change");
        $("#FromAmharic").trigger("change");
        $("#ToAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "PatientsLeave")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
