@using System.Collections
@using ExceedERP.Core.Localization 
@using ExceedERP.Core.Domain.Health
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorHealthAndInsurance_SickLeave</legend>
@(Html.Kendo().Grid<PatientCard>()
          .Name("PatientCardgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.PatientCardId).Width(120);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(200);
          columns.Bound(c => c.Age).Width(100);
          columns.Bound(c => c.Sex).Width(100);
          //columns.Bound(c => c.).Width(150);
          columns.Bound(c => c.DateAmharic).Width(120);

          columns.Command(command =>
          {
              //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              //command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                 .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("PatientCard").Window(window => { window.Title("Patient Card"); window.Scrollable(false); }))
        .Scrollable(h => h.Height(500))
                     .Groupable()
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                  .Filterable()
                     .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
              .Events(events =>
                        {
                            events.Error("error_handler(\"PatientCardgrid\")");
                            events.RequestStart("onRequestStart(\"PatientCardgrid\")");
                            events.RequestEnd("onRequestEnd(\"PatientCardgrid\")");
                        })
                       
          .Model(model => model.Id(p => p.PatientId))
          .Read(read => read.Action("PatientCard_Read", "PatientCard"))
        // .Create(create => create.Action("PatientCard_Create", "PatientCard"))
        // .Update(update => update.Action("PatientCard_Update", "PatientCard"))
        // .Destroy(destroy => destroy.Action("PatientCard_Destroy", "PatientCard"))
          ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                          .Name("tabstrip_#=PatientId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text(Resources.NavigatorHealthAndInsurance_SickLeave).Content(
                @<text>
                  @*  <legend>Sick Leave</legend>*@
                   
    @(Html.Kendo().Grid<PatientsLeave>()
          .Name("PatientsLeavegrid")
      .Columns(columns =>
      {
          // columns.Bound(c => c.PatientCardId);

          columns.Bound(c => c.FromAmharic);
          columns.Bound(c => c.ToAmharic);
          columns.Bound(c => c.TentativeDiagnosis);
          columns.Bound(c => c.RecommendedRest);
          columns.Bound(c => c.Days);
          columns.Bound(c => c.TreatedBy);
          columns.Bound(c => c.Remark);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("Health_User"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("Health_Admin"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("Health_User"))
          {

              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
      })
                         .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("PatientsLeave").Window(window => { window.Title(Resources.NavigatorHealthAndInsurance_SickLeave); window.Scrollable(false); }))
          .Scrollable(h => h.Height(500))
                  .Events(x => { x.Save("GetDate");
                      x.Edit("GetDate"); })
      //   .Groupable()
      //            .Sortable(sortable =>
      //            {
      //                sortable.SortMode(GridSortMode.SingleColumn);
      //            })
      //.Filterable()
      //   .Pageable(pageable => pageable
      //                              .Input(true)
      //                              .Numeric(false)
      //                              .Refresh(true)
      //                              .PageSizes(true)
      //                              .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                  .Events(events =>
                  {
                      events.Error("error_handler(\"PatientsLeavegrid\")");
                      events.RequestStart("onRequestStart(\"PatientsLeavegrid\")");
                      events.RequestEnd("onRequestEnd(\"PatientsLeavegrid\")");
                  })

          .Model(model => model.Id(p => p.PatientsLeaveId))
                          .Read(read => read.Action("PatientsLeave_Read", "PatientsLeave", new { id = "#=PatientId#" }))
                          .Create(create => create.Action("PatientsLeave_Create", "PatientsLeave", new { id = "#=PatientId#" }))
          .Update(update => update.Action("PatientsLeave_Update", "PatientsLeave"))
          .Destroy(destroy => destroy.Action("PatientsLeave_Destroy", "PatientsLeave"))
      ).ToClientTemplate()
    )

                </text>


                  );
          }).ToClientTemplate())
</script>
