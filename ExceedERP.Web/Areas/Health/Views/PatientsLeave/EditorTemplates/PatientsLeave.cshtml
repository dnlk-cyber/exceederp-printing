@using System.Collections
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.Health.PatientsLeave
@using ExceedERP.Core.Localization



<div class="form">
    <div class="row fullrow">
        <div class="col-md-3 ro1">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.GlFiscalYearId, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>

                    @(Html.Kendo().DropDownListFor(model => model.GlFiscalYearId)
                                      .AutoBind(false)
                                      .OptionLabel(Resources.Select)
                                                        .DataSource(dataSource =>
                                              {
                                                  dataSource.Read(read => read.Action("GetFisicalYear", "HRMDataProvider", new { area = "HRM" }))
                                                                        .ServerFiltering(false);
                                              })
                                                      .DataTextField("Name")
                                                              .DataValueField("GlFiscalYearId")
                                                               .ValuePrimitive(true)
                    )
                </div>
            </div>

            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.FromAmharic, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @Html.TextBoxFor(model => model.FromAmharic, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />

                    @Html.ValidationMessageFor(model => model.FromAmharic, "", new { @class = "text-danger" })
                </div>
            </div>


            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.ToAmharic, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @Html.TextBoxFor(model => model.ToAmharic, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />
                    @Html.ValidationMessageFor(model => model.ToAmharic, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-3 ro1">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Days, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.Days).Enable(false))
                    @Html.ValidationMessageFor(model => model.Days, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <div>
                    @Html.LabelFor(model => model.TreatedBy, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @Html.Kendo().TextBoxFor(model => model.TreatedBy)
                    @Html.ValidationMessageFor(model => model.TreatedBy, "", new { @class = "text-danger" })
                </div>
            </div>
          
            <div class="form-group">
                <div>
                    @Html.LabelFor(model => model.DateAmharic, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>
                    @Html.TextBoxFor(model => model.DateAmharic, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />

                    @Html.ValidationMessageFor(model => model.DateAmharic, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-3 ro1">


            <div class="form-group">
                <div>
                    @Html.LabelFor(model => model.TentativeDiagnosis, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @Html.TextBoxFor(model => model.TentativeDiagnosis)
                    @Html.ValidationMessageFor(model => model.TentativeDiagnosis, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div>
                    @Html.LabelFor(model => model.RecommendedRest, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @Html.TextBoxFor(model => model.RecommendedRest)
                    @Html.ValidationMessageFor(model => model.RecommendedRest, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div>
                    @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @Html.Kendo().TextBoxFor(model => model.Remark)
                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
</div>
</div>