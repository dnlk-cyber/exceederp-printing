<legend>Balance Sheet </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Budget.GAAP.BalanceSheet>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.CategoryType).Hidden();
          columns.ForeignKey(c => c.BalanceSheetCategoryId, (System.Collections.IEnumerable)ViewData["BalanceSheetCategory"], "BalanceSheetCategoryId", "Name").Hidden();
          columns.Bound(c => c.Name).ClientGroupFooterTemplate("Total ").ClientFooterTemplate("Growth");
        
          columns.ForeignKey(c => c.GlFiscalYearId, (System.Collections.IEnumerable)ViewData["FiscalYear"], "GlFiscalYearId", "Name");
          columns.Bound(c => c.First).ClientGroupFooterTemplate("#=sum#").ClientFooterTemplate("#=sum#");
          columns.Bound(c => c.Second).ClientGroupFooterTemplate("#=sum#").ClientFooterTemplate("#=sum#");
          columns.Bound(c => c.Third).ClientGroupFooterTemplate("#=sum#").ClientFooterTemplate("#=sum#");
          columns.Bound(c => c.Fourth).ClientGroupFooterTemplate("#=sum#").ClientFooterTemplate("#=sum#");
          columns.Bound(c => c.FromAccCode);
        columns.Bound(c => c.ToAccCode);
   
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
      })
                    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("BalanceSheetEditor").Window(x=>x.Title("Balance Sheet")))
             .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                                .Scrollable(h => h.Height(500))

      .DataSource(dataSource => dataSource
          .Ajax().ServerOperation(false)
              .Aggregates(aggregates =>
                                {
                                    aggregates.Add(c => c.First).Sum();
                                    aggregates.Add(c => c.Second).Sum();
                                    aggregates.Add(c => c.Third).Sum();
                                    aggregates.Add(c => c.Fourth).Sum();
                               
                                })
          .Group(x=> {  x.Add(y=>y.CategoryType);  x.Add(y=>y.BalanceSheetCategoryId);})
          .Model(model => model.Id(p => p.BalanceSheetId))
              .Read(read => read.Action("BalanceSheets_Read", "BalanceSheet"))
              .Create(create => create.Action("BalanceSheets_Create", "BalanceSheet"))
              .Update(update => update.Action("BalanceSheets_Update", "BalanceSheet"))
              .Destroy(destroy => destroy.Action("BalanceSheets_Destroy", "BalanceSheet"))
      )
)

<style type="text/css">
    div.k-edit-form-container {
        width: 900px;
    }
</style>
