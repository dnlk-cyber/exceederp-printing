@using ExceedERP.Core.Domain.Maintenance;

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="container">
    <nav class="navbar navbar-default">
        <div class="navbar-header">
            <button class="navbar-toggle" type="button" data-toggle="collapse" data-target=".js-navbar-collapse">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a class="navbar-brand" href="#">Mantenance</a>
        </div>


        <div class="collapse navbar-collapse js-navbar-collapse">
            <ul class="nav navbar-nav">
                <li class="dropdown mega-dropdown">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="fa fa-bars"></i> Actions </a>

                    <ul class="dropdown-menu mega-dropdown-menu row">
                        @if (HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceAdmin)
              || HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceRequestor)
              || HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceWorkShopUser)
              || HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceRequestVoider)
              || HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceRequestApprover)
              || HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceOrderUser)
              || HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceServiceApprover)
              || HttpContext.Current.User.IsInRole(MaintenanceRoles.ServiceUser)
              || HttpContext.Current.User.IsInRole(MaintenanceRoles.PeriodicEquipmentInspectionUser)
              || HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceToolsStoreUser)
              || HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceEquipmentRegistrationUser)
              || HttpContext.Current.User.IsInRole(MaintenanceRoles.MileageImportAndExport)

              || HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceReport))

                        {
                            <li class="col-sm-3">
                                <ul>
                                    @if (HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceRequestor)
                                       || HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceRequestApprover)
                                       || HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceOrderUser)
                                       || HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceWorkShopUser)
                                       || HttpContext.Current.User.IsInRole(MaintenanceRoles.ServiceUser)
                                       || HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceServiceApprover))
                                    {
                                        <li class="dropdown-top-header">Work Flow</li>
                                        <li class="divider"></li>

                                        <li>@Html.ActionLink("Equipment Reception Form", "Index", "VehicleReceptionForm", new { area = "Maintenance" }, new { target = "_blank" })</li>


                                        <li>@Html.ActionLink("Maintenance Request", "Index", "JobRequest", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                        <li class="divider"></li>
                                        if (HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceOrderUser))
                                        {
                                            <li class="dropdown-header">Job Order</li>
                                            <li class="divider"></li>
                                            <li>@Html.ActionLink("Open/Pending", "Index", "JobOrder", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                            <li>@Html.ActionLink("Closed", "Index", "JobOrderClosed", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                        }

                                        <li class="divider"></li>
                                        <li class="dropdown-header">Service center</li>
                                        <li class="divider"></li>
                                        if (HttpContext.Current.User.IsInRole(MaintenanceRoles.ServiceUser))
                                        {
                                            <li>@Html.ActionLink("Service Center", "Index", "ServiceCenter", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                            <li>@Html.ActionLink("External Service Center ", "Index", "ExternalServiceCenter", new { area = "Maintenance" }, new { target = "_blank" })</li>

                                        }

                                        <li class="divider"></li>
                                        <li class="dropdown-header">Other</li>
                                        <li class="divider"></li>
                                        if (HttpContext.Current.User.IsInRole(MaintenanceRoles.ServiceUser))
                                        {
                                            <li>@Html.ActionLink("Store Requisitions", "Index", "SparePartStoreRequisition", new { area = "Maintenance" }, new { target = "_blank" })</li>

                                        }
                                        if (HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceWorkShopUser))
                                        {

                                            <li>@Html.ActionLink("Work Shop", "Index", "WorkShop", new { area = "Maintenance" }, new { target = "_blank" })</li>

                                        }

                                    }
                                </ul>
                            </li>
                            if (User.IsInRole(ExceedERP.Core.Domain.CRM.CRMRoles.SalesQuoteSecondApprover))
                            {
                                <li class="col-sm-3">
                                    <ul>
                                        <li class="dropdown-top-header">Sales Vouchers</li>
                                        <li class="divider"></li>
                                        <li>@Html.ActionLink("Sales Quote", "Index", "MntSalesQuote", new { area = "Maintenance" }, new { target = "_blank" })</li>


                                    </ul>
                                </li>
                            }

                            if (HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceAdmin))
                            {

                                <li class="col-sm-3">
                                    <ul>
                                        <li class="dropdown-top-header">Setup</li>
                                        <li class="divider"></li>
                                        <li>@Html.ActionLink("Inspection and Handling", "Index", "VehiclePartDamageType", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                        <li>@Html.ActionLink("Equipment Part", "Index", "VehiclePart", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                        <li>@Html.ActionLink("Maintenance Type", "Index", "MaintenanceType", new { area = "Maintenance" }, new { target = "_blank" })</li>

                                        <li>@Html.ActionLink("Maintenance Center", "Index", "MaintenanceCenter", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                        <li>@Html.ActionLink("Repair Activity", "Index", "RepairType", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                        <li>@Html.ActionLink("Mechanic", "Index", "MechanicCrew", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                        <li>@Html.ActionLink("Maintenance Planner", "Index", "Planner", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                        <li>@Html.ActionLink("Mechanic Type", "Index", "MechanicType", new { area = "Maintenance" }, new { target = "_blank" })</li>


                                    </ul>
                                </li>
                            }

                            if (HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceReport))
                            {
                                <li class="col-sm-3">
                                    <ul>
                                        <li class="dropdown-top-header">Report</li>
                                        <li class="divider"></li>

                                        <li>@Html.ActionLink("Daily/Weekly Maintenance Report ", "DailyMaintenanceReport", "MaintenanceReport", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                        <li>@Html.ActionLink(" Maintenance Report ", "MaintenanceReport", "MaintenanceReport", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                        <li>@Html.ActionLink("Internal Maintenance Cost ", "InternalMaintenanceCost", "MaintenanceReport", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                        <li>@Html.ActionLink(" Maintenance Duration", "MaintenanceDuration", "MaintenanceReport", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                        <li>@Html.ActionLink(" Maintenance Summary", "MaintenanceSummary", "MaintenanceReport", new { area = "Maintenance" }, new { target = "_blank" })</li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                </li>
            </ul>

        </div>
        <!-- /.nav-collapse -->
    </nav>
</div>


<script>
    jQuery(document).on('click', '.mega-dropdown', function (e) {
        e.stopPropagation()
    })
</script>