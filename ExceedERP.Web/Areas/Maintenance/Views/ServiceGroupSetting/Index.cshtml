
@using System.Collections
@using ExceedERP.Core.Domain.Maintenance;
@using ExceedERP.Helpers.Common;
<legend>PM Setting</legend>
@(Html.Kendo().Grid<ServiceGroupSetting>()
                .Name("grid")
               .Columns(
                columns =>
                {
                    columns.Bound(c => c.ServiceGroupName);
                    columns.Bound(c => c.Description);
                    columns.Command(command =>
                    {
                        command.Edit();
                        command.Destroy();

                    });
                }
                )
                .Editable(editable =>
                {
                    editable.Mode(GridEditMode.InLine);
                })
                .Sortable()
                .ToolBar(toolbar => toolbar.Create())
                .DataSource(datasource => datasource
                .Ajax()
                .Model(model => model.Id(m => m.ServiceGroupSettingId))
                 .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
                .Read(read => read.Action("SGSetting_Read", "ServiceGroupSetting", new { area = "Maintenance" }).Data("sendForgery"))
                .Create(create => create.Action("SGSetting_Create", "ServiceGroupSetting", new { area = "Maintenance" }).Data("sendForgery"))
                .Update(update => update.Action("SGSetting_Update", "ServiceGroupSetting", new { area = "Maintenance" }).Data("sendForgery"))
                .Destroy(destroy => destroy.Action("SGSetting_Destroy", "ServiceGroupSetting", new { area = "Maintenance" }).Data("sendForgery"))
                .Sort(x => x.Add("ServiceGroupSettingId").Descending())
                )

    // .ToClientTemplate()
)

