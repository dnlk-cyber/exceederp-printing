
@(Html.Kendo().DropDownListFor(model => model)
              .ValuePrimitive(true)
              .DataTextField("Name")
              .DataValueField("Code")
              .OptionLabel(" Select ")
              .Filter(FilterType.Contains)
                      .DataSource(d => d.Read(r => r.Action("GetSubCategories", "MaintenanceDataProvider").Data("sendForgery")
                      .Data("filterSubCategory"))
                      .ServerFiltering(true)))