@(Html.Kendo().DropDownListFor(model => model)
                    .DataTextField("EquipmentTypeName")
                            .DataValueField("EquipmentTypeID").OptionLabel("Select ")
                    .HtmlAttributes(new { style = "width:100%" })
                    .DataSource(d =>
                    {
                        d.Read(r =>
                        {
                            r.Action("EquipmentTypeDDBind", "EquipmentType").Data("filterEquipmentIdentity");
                        })
                      .ServerFiltering(true);
                    })
              .Enable(true)
              .AutoBind(false)
               .CascadeFrom("EquipmentIdentityId")
)