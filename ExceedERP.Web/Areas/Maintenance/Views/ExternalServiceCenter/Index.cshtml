@(Html.Kendo().Window()
.Name("window")
.Width(400)
.Height(200)
.Visible(false)
.Modal(true)
.Draggable(true)
.Content(@<text>
<form action="@Url.Action("RejectWorkShop", "ServiceCenter", new { area = "Maintenance" })" method="post" , new { enctype="multipart/form-data" }>
<input type="hidden" name="id" id="id">
<div class="row">
<div class="col-md-3">

@Html.Label("Reason:")

@Html.TextArea("RejectionReason", "", new { type = "text" })
</div>

</div>
<button type="submit" class="btn btn-info"><i class="glyphicon glyphicon-ok" aria-hidden="true"></i> Submit</button>

</form>
</text>)
.Modal(true)
.Title("Reason For Reject")
.Actions(actions => actions.Close())

)
<legend>External Service Center</legend>
@(Html.Kendo().Grid<ServiceCenterJob>()
.Name("grid")
.Columns(columns =>
{
columns.Bound(e => e.Num).Width(80);
columns.ForeignKey(e => e.CustomerId, (IEnumerable)ViewData["Customers"], "Code", "Name").Title("Customer").Width(150);
columns.Bound(e => e.IsRework).Width(100).ClientTemplate("<input type='checkbox' disabled = 'true' #: IsRework? checked='checked': checked='' #/>");
columns.Bound(e => e.IsInsured).Width(100).ClientTemplate("<input type='checkbox' disabled = 'true' #: IsInsured? checked='checked': checked='' #/>");

//columns.ForeignKey(e => e.EquipmentInformationId, (IEnumerable)ViewData["EquipmentsList"], "EquipmentInformationId", "LicensePlate").Title("License Place").Width(150);
//columns.Bound(e => e.ProjectName).Title("Location").Width(100);
columns.Bound(e => e.LicensePlate).Width(100);
columns.Bound(e => e.Referance).Width(100);
//columns.Bound(e => e.MaintenanceCenter).Width(200);
columns.ForeignKey(e => e.MaintenanceCenterId, (IEnumerable)ViewData["MaintenanceCenter"], "Id", "Name").Width(140);
columns.ForeignKey(e => e.ServiceCenterId, (IEnumerable)ViewData["ServiceCenter"], "Id", "Name").Width(150);
columns.Bound(e => e.Status).Width(200);
columns.Command(command =>
{
if (HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceServiceRejecter))

{
command.Custom("cmd-aprove-request").Text("&nbsp; Approve").Click("approveWorkShop").HtmlAttributes(new { @class = "approve" }).IconClass("fa fa-ok");
command.Custom("cmd-reject-request").Text("&nbsp; Reject").Click("rejectWorkShop").HtmlAttributes(new { @class = "reject" }).IconClass("fa fa-close");
}
}).Width(100);
})

.Editable(editable =>
{
editable.Mode(GridEditMode.PopUp).TemplateName("JobOrderEditor");
editable.DisplayDeleteConfirmation("Are You Sure To Send For Approval");
})
.HtmlAttributes(new { style = "height: 500px;" })
.Pageable(pageable => pageable
.Input(true)
.Numeric(false)
.Refresh(true)
.PageSizes(true)
.ButtonCount(5))

.Scrollable()
.Sortable()
.Filterable()
.Scrollable(h => h.Height(500))
.ClientDetailTemplateId("template")
.Events(ev => ev.DetailExpand("MasterOnExpand"))
.DataSource(dataSource => dataSource
.Ajax()
.ServerOperation(true).Sort(x => x.Add(s => s.Num).Descending())
.PageSize(10)
.Model(model =>
{
model.Id(p => p.ServiceCenterJobId);
model.Field(p => p.ServiceCenterJobId).Editable(false);
model.Field(p => p.JobOrderID).Editable(false);
}
).Events(ev => ev
.Error("error_handler(\"grid\")")
.RequestStart("onRequestStart(\"grid\")")
.RequestEnd("onRequestEnd(\"grid\")")
)
//.Group(g =>
//{
//    g.Add(gg => gg.Num);
//})

//.Create(update => update.Action("JobOrder_Create", "JobOrder").Data("sendForgery"))
.Read(read => read.Action("ExternalServiceCenter_Read", "ExternalServiceCenter").Data("sendForgery"))
.Update(update => update.Action("JobOrder_Update", "ExternalServiceCenter").Data("sendForgery"))
.Destroy(update => update.Action("JobOrder_Refer", "ExternalServiceCenter").Data("sendForgery"))

)
.Events(events => events.DataBound("dataBound"))
)

