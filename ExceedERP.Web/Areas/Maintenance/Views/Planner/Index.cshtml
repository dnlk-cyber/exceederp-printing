
@{
    ViewBag.Title = "Planner";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend> Maintenance Plan </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Maintenance.Planner>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.PlannerName).Width(140);
        columns.Bound(e => e.TrackByDate).Width(140).ClientTemplate("<input type='checkbox'  disabled='true' value='#=TrackByDate #' " + " # if (TrackByDate) { #" + "checked='checked'" + "# } #" + " />"); ;
        columns.Bound(e => e.TrackByMileage).Width(200).ClientTemplate("<input type='checkbox'  disabled='true' value='#=TrackByMileage #' " + " # if (TrackByMileage) { #" + "checked='checked'" + "# } #" + " />"); ;
        columns.Bound(e => e.DateCrated).Format("{0:d}").Width(200);

        columns.Command(command => { command.Edit(); /*command.Destroy();*/ }).Width(250);


    })
                           .ToolBar(commands => commands.Create())
     .Editable(editable =>
     {
         editable.Window(w => w.Title("Planner"));
         editable.Mode(GridEditMode.PopUp).TemplateName("PlannerEditor");
         editable.DisplayDeleteConfirmation("Are You Sure To Remove Planner");
     })
        .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                                // .Groupable()
                                .Scrollable(h => h.Height(500))
    .DataSource(dataSource => dataSource
        .Ajax()
        .ServerOperation(false)
                   .Model(model =>
                   {
                       model.Id(p => p.PlannerID);

                   }) .Events(ev => ev
                                                         .Error("error_handler(\"grid\")")
                                                         .RequestStart("onRequestStart(\"grid\")")
                                                         .RequestEnd("onRequestEnd(\"grid\")"))
                .Create(update => update.Action("Planner_Create", "Planner"))
                .Read(read => read.Action("Planner_Read", "Planner"))
                .Update(update => update.Action("Planner_Update", "Planner"))
                .Destroy(update => update.Action("Planner_Destroy", "Planner"))
  )
)


<style type="text/css">
    div.k-edit-form-container {
        width: 500px;
    }
</style>
<script type="text/javascript">
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }
    function sync_handler(e) {
        this.read();

    }
    function onClick() {
        $("#grid").data("kendoGrid").addRow();
    }
</script>
