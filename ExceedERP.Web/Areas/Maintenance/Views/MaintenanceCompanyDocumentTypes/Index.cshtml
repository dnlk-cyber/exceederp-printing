
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Maintenance.MaintenanceCompanyDocumentType>()
          .Name("CompanyDocumentTypeGrid")
          .Columns(columns =>
          {
              columns.Bound(c => c.DocumentType);
              columns.Command(command =>
              {
                  command.Edit();
                  command.Destroy();
              });
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create();
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Pageable()
          .Filterable()
          .Scrollable(h => h.Height(600))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Model(model => model.Id(p => p.MaintenanceCompanyDocumentTypeId))
              .Read(read => read.Action("MaintenanceCompanyDocumentTypes_Read", "MaintenanceCompanyDocumentTypes"))
              .Create(create => create.Action("MaintenanceCompanyDocumentTypes_Create", "MaintenanceCompanyDocumentTypes"))
              .Update(update => update.Action("MaintenanceCompanyDocumentTypes_Update", "MaintenanceCompanyDocumentTypes"))
              .Destroy(destroy => destroy.Action("MaintenanceCompanyDocumentTypes_Destroy", "MaintenanceCompanyDocumentTypes"))
            ).ClientDetailTemplateId("template"))

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_#=MaintenanceCompanyDocumentTypeId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Answer").Content(
    @<text>
        <input type="button" class="btn btn-primary fa fa-plus" value="Add File" onclick="UploadCompanyDoc(#=MaintenanceCompanyDocumentTypeId#)" />
        @(Html.Kendo().Grid< ExceedERP.Core.Domain.Maintenance.MaintenanceCompanyDocument> ()
                 .Name("CompanyDocument#=MaintenanceCompanyDocumentTypeId#")
                 .Columns(columns =>
                 {
                     columns.Bound(c => c.FileName).ClientTemplate("<a href='/Maintenance/MaintenanceCompanyDocuments/DownloadCompanyDocument?CompanyDocumentId=\\#=MaintenanceCompanyDocumentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; \\#=FileName\\# </a>");
                     columns.Bound(c => c.Description);

                     columns.Template(e => { }).ClientTemplate("<a href='/Maintenance/MaintenanceCompanyDocuments/DownloadCompanyDocument?CompanyDocumentId=\\#=MaintenanceCompanyDocumentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; Download </a>");
                     columns.Template(e => { }).ClientTemplate("<a href='\\#=ShortPath\\#/\\#=FileName\\#' target='_blank'> <f class = 'fa fa-folder-open'></i> &nbsp;&nbsp; Open</a>");

                     columns.Command(command =>
                     {
                         command.Destroy().Text("Delete");
                     });
                 })

                  .ToolBar(toolbar =>
                  {
                      // toolbar.Create().Text(Resources.ActionButton_AddNewRecord).HtmlAttributes(new { id = "answerCreate" });
                      // toolbar.Custom().Text("Upload Company Doc").HtmlAttributes(new { onClick = "UploadCompanyDoc" });
                  })

                   .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Answer").Window(window => { window.Title(""); window.Scrollable(false); }))
                   .Events(ev =>
                   {
                       ev.DataBound("onDetailDataBound");
                       //ev.Change("CheckDisablity");
                   })
                     .Scrollable(h => h.Height("auto"))
                     .DataSource(dataSource => dataSource
                     .Ajax()
                      .Sort(sort => sort.Add(c => c.MaintenanceCompanyDocumentId).Descending())
                     .Events(events =>
                     {
                         events.Error("error_handler(\"CompanyDocument#=MaintenanceCompanyDocumentTypeId#\")");
                         events.RequestStart("onRequestStart(\"CompanyDocument#=MaintenanceCompanyDocumentTypeId#\")");
                         events.RequestEnd("onRequestEnd(\"CompanyDocument#=MaintenanceCompanyDocumentTypeId#\")");
                     })
                     .Model(model => model.Id(p => p.MaintenanceCompanyDocumentId))
                     .Read(read => read.Action("MaintenanceCompanyDocuments_Read", "MaintenanceCompanyDocuments", new { id = "#=MaintenanceCompanyDocumentTypeId#", area = "Maintenance" }))
                     .Destroy(destroy => destroy.Action("MaintenanceCompanyDocuments_Destroy", "MaintenanceCompanyDocuments", new { area = "Maintenance" }))
                     ).ToClientTemplate())
    </text>
);

        }).ToClientTemplate())
</script>

<script>

    function onDetailDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);

            var dataItem = grid.dataItem(row);
            //if (dataItem.IsTransfered == true) {
            //    row.find(".k-grid-delete").hide();
            //}
        }
    }

    function UploadCompanyDoc(id) {

        $("#MaintenanceCompanyDocumentTypeId").val(id);

        var wnd = $("#UploadCompanyFileWindow").data("kendoWindow");
        wnd.center().open();
    }

    function UploadCompanyFile() {

            $.ajax({
                url: '@Url.Action("UploadCompanyFile", "MaintenanceCompanyDocuments")',
                //contentType: "application/json; charset=utf-8",
                data: function () {
                    var data = new FormData();
                    var kk = $("#CompanyFile");//.get(0).files[0];

                    $.each($("input[type=file]"), function (i, obj) {
                        $.each(obj.files, function (j, file) {
                            data.append('CompanyFile[' + j + ']', file);
                        })
                    });

                   // data.append("CompanyFile", $("#CompanyFile").get(0).files[0]);
                    data.append("CompanyDocumentTypeId", $("#MaintenanceCompanyDocumentTypeId").val());
                    data.append("Description", $("#Description").val());
                    return data;
                }(),
                type: 'POST',
                contentType: false,
                processData: false,
                cache: false,
                success: function (result) {
                    var wnd = $("#UploadCompanyFileWindow").data("kendoWindow").close();
                    var id = $("#MaintenanceCompanyDocumentTypeId").val();
                    alert(result);
                    $("#CompanyDocument" + id).data("kendoGrid").dataSource.read();
                }
            });
    }
</script>

@(Html.Kendo().Window().Name("UploadCompanyFileWindow")
            .Title("Upload Answer")
            .Visible(false)
            .Modal(true)
            .Content(@<text>
                <input type="hidden" id="MaintenanceCompanyDocumentTypeId" name="MaintenanceCompanyDocumentTypeId" />

                @*@Html.TextBox("CompanyFile", "", new { type = "file", @class = "form-control" })*@
                <input type="file" name="CompanyFile" id="CompanyFile[]" class="form-control" multiple />
                <br />
                <textarea id="Description" class="form-control"></textarea>
                <br />
                <div class="pull-right">
                    @Html.Kendo().Button().Name("btnTo").Content("Upload").Events(e => e.Click("UploadCompanyFile"))
                </div>
            </text>)
                     .Draggable(true)
                     .Width(400))