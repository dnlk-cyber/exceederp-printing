
@model ExceedERP.Core.Domain.Maintenance.SparePart
    <div class="row">
        <div class="col-md-1">
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.SpareMaterialCategoryId)
                </div>
                <div>
                    @Html.ValidationMessageFor(model => model.SpareMaterialCategoryId)
                    @(Html.Kendo().DropDownListFor(model => model.SpareMaterialCategoryId)
                            .Name("SpareMaterialCategoryId")
                            .DataTextField("Description")
                            .DataValueField("SpareMaterialCategoryId")
                            .OptionLabel("Select ")
                            .HtmlAttributes(new { style = "width:100%" })
                            .DataSource(d =>
                                d.Read(r => r.Action("GetSparePartAndMaterialCategory", "MaintenanceDataProvider").Data("sendForgery")))
                    )
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.SparePartName)
                </div>
                <div>
                    @Html.Kendo().TextBoxFor(model => model.SparePartName)
                    @Html.ValidationMessageFor(model => model.SparePartName)
                </div>
            </div>
        </div>
        

