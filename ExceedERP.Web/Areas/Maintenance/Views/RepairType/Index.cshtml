    function sync_handler(e) {
        this.read();

    }
    function onClick() {
        $("#grid").data("kendoGrid").addRow();
    }
    function filterCategories() {

        return {
            categoryCode: $("#CategoryCode").val()
        };
    }

    function onChangeTime() {
        console.log(100);
        var standaredTime = $("#StandaredTime").val();
        var payableTime = $("#PayableTime").val();
        var diff = $("#Difference").val(standaredTime - payableTime);
        if (diff.val() < 0) {
            diff=  $("#Difference").val(diff.val() * -1);
        }
        diff.trigger("change");
    }
    function onChangeLabourRate() {

        var labourRateAtCompany = $("#LabourRateAtCompany").val();
        console.log(labourRateAtCompany);

        var payableTime = $("#PayableTime").val();
        var labourRateAtCustomer = $("#LabourRateAtCustomer").val();
        if (payableTime != null) {
            if (labourRateAtCompany != null) {
                var totalAmountAtCompany = $("#TotalAmountCompany").val(labourRateAtCompany * payableTime);
                totalAmountAtCompany.trigger("change");

            }
            if (labourRateAtCustomer != null) {
                var totalAmountAtCustomer = $("#TotalAmountCustomer").val(labourRateAtCustomer * payableTime);
                totalAmountAtCustomer.trigger("change");
            }

        }

    }
</script>
