
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using ExceedERP.Core.Domain.Maintenance
<link href="~/Scripts/Exceed/dist/css/style.css" rel="stylesheet" />
<script src="~/Scripts/Exceed/exceed.js"></script>

<legend>External Maintenance Payment Request</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Maintenance.ExternalMaintenancePaymentRequest>()
                .Name("grid")
                .Columns(columns =>
                {
                    columns.Bound(c => c.JobNum).Width(100);
                    columns.ForeignKey(c => c.FleetId, (IEnumerable)ViewData["Fleet"], "Value", "Text").Width(120).Title("Plate No");
            //columns.ForeignKey(c => c.MaintenanceCenterId, (IEnumerable)ViewData["MaintenanceCenter"], "Value", "Text").Title("maintenance Center");
            columns.ForeignKey(c => c.MaintenanceCenterId, (IEnumerable)ViewData["MaintenanceCenter"], "Value", "Text").EditorTemplateName("MaintenanceCenterSelector").Title("Maintenance Center").Width(120);
                    columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "Value", "Text").Width(120).Title("Branch");
                    columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["BusinessUnit"], "Value", "Text").Width(120).Title("Business Unit");
                    columns.Bound(c => c.EquipmentName).Width(100);
                    columns.Bound(c => c.EnteranceDate).Width(100);
                    columns.Bound(c => c.ExitDate).Width(100);
                    columns.Bound(c => c.TotalAmount).Title("Total Amount").Width(100);
                    columns.Bound(c => c.AmountDue).Title("Amount Due").Width(100);
                    columns.Command(command =>
                    {
                        //command.Custom("approve").Text("Approve").IconClass("fa fa-thumbs-o-up").HtmlAttributes(new { @class = "approve", title = "approve" }).Click("handleApprove");
                        command.Edit();
                        command.Destroy();
                    }).Width(180);
                })
                .Filterable()
                .ToolBar(toolbar => toolbar.Create())
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Events(e => e.DetailExpand("DetailExpand"))
                .Events(e => e.DataBound("onDataBoundExternalPayment"))
                .Pageable()
                .Sortable()
                .Scrollable(e => e.Height(550))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Sort(sort => sort.Add(e => e.ExternalMaintenancePaymenntrequestId).Descending())
                    .Events(ev => ev
                                .Error("error_handler(\"grid\")")
                                .RequestStart("onRequestStart(\"grid\")")
                                .RequestEnd("onRequestEnd(\"grid\")"))
                    .Model(m =>
                    {
                        m.Id(p => p.ExternalMaintenancePaymenntrequestId);
                        m.Field(f => f.JobNum).Editable(false);
                        m.Field(f => f.BranchId).Editable(false);
                        m.Field(f => f.BusinessUnitId).Editable(false);
                        m.Field(f => f.FleetId).Editable(false);
                        m.Field(f => f.EnteranceDate).Editable(false);
                        m.Field(f => f.ExitDate).Editable(false);
                        m.Field(f => f.EquipmentName).Editable(false);
                        m.Field(f => f.TotalAmount).Editable(false);
                        m.Field(f => f.AmountDue).Editable(false);
                    })
                    .Read(read => read.Action("Read", "ExternalMaintenancePaymentRequest").Data("sendForgery"))
                .Create(create => create.Action("Create", "ExternalMaintenancePaymentRequest").Data("sendForgery"))
                .Update(update => update.Action("Update", "ExternalMaintenancePaymentRequest").Data("sendForgery"))
                .Destroy(delete => delete.Action("Delete", "ExternalMaintenancePaymentRequest").Data("sendForgery"))
                ).ClientDetailTemplateId("tabs")
)


