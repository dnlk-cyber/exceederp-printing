                                                                            <div class="box">
                                                                                #if(IsOnlineApproved)
                                                                                {#
                                                                                <a href='@Url.Action("ExternalMaintenancePaymentPrint", "MaintenanceReport")/?id=#=ExternalMaintenancePaymenntrequestId#' title="Print"><i class="fa fa-print  fa-2x"></i></a>
                                                                                #}#
                                                                                <div class="box-col">

                                                                                    # if (!IsSendForApproval)
                                                                                    {#
                                                                                    <a onclick='return sendForApproval("#=ExternalMaintenancePaymenntrequestId#")' href=' \#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                                                                    # }#
                                                                                </div>
                                                                                # if (!IsOnlineApproved)
                                                                                {#
                                                                                <dl class="h6">
                                                                                    <dt>
                                                                                        Next Approver
                                                                                    </dt>
                                                                                    <dd>
                                                                                        #= ForwardedTo # <snap id="user_name_display"></snap>
                                                                                        <a onclick='displayUserName("#=ForwardedTo#")' href=' \#' title="Show Name">Show Name<i class="fa fa-user fa-1x"></i></a> |
                                                                                        <a onclick='SelectNextApprover(this,"#=ExternalMaintenancePaymenntrequestId#","ExternalMaintenanceRequestPayment")' href=' \#' title="Change next approver">Change next approver<i class="fa fa-undo fa-1x"></i></a>
                                                                                        <snap id="new_user_name_display"></snap>
                                                                                    </dd>
                                                                                </dl>
                                                                                # } #
                                                                            </div>
                                                                        </text>);

                                                                                        itemn.Add().Text("Payment Detail")
                    .Content(@<text>@Detail()</text>);
                                                                            itemn.Add().Text("Service Center Jobs")
                        .Content(@<text>@ExternalRequestJob()</text>);
                                                                            itemn.Add().Text("Validation").Content(@<text>
                                                                                @ExteranalRequestValidation()
                                                                            </text>);
                                                                            }).ToClientTemplate())
</script>
