<script type="text/javascript">
    var MCId;
    function onDataBoundExternalPayment() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            var masterDataItem = grid.dataItem(this);
            $(this).find(".k-grid-reject").hide();
            if (masterDataItem.IsOnlineApproved == true) {
                $(this).addClass("k-state-Approved");
                $(this).find(".k-grid-edit").hide();
                $(this).find(".k-grid-delete").hide();
            }
            if (masterDataItem.IsSendForApproval) {
                $(this).find(".k-grid-edit").hide();
                $(this).find(".k-grid-delete").hide();
            }
            if (masterDataItem.IsSendForApproval == true && masterDataItem.IsOnlineApproved == false) {
                $(this).addClass("k-state-waiting-approval");            }
            if (masterDataItem.IsOnlineApproved == false && masterDataItem.IsSendForApproval == false) {
                $(this).addClass("k-state-Rejected");
            }
            if (dataItem.IsOnlineApproved) {

                $(this).find(".k-grid-approve").hide();
                //$(this).find(".k-grid-reject").hide();

            }
            else if (dataItem.IsSendForApproval) {

                $(this).find(".k-grid-approve").show();
            }
            else {
                $(this).find(".k-grid-approve").hide();
            }

        });
    }

     function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ExternalMaintenancePaymentRequest", new { area = "Maintenance" })',
            data: { id: id },
            success: function (result) {
                if (result && result.Message) {
                    alert(result.Message);
                } else {
                    alert("Something went wrong: " + JSON.stringify(result));
                }
                location.reload(true);
            },
            error: function (result) {
                alert(result.Message);
            }
        });
    }


     function handleApprove(e) {
        if (confirm("Are you sure you want to approve?")) {
            var grid = this;
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
            $.ajax({
                type: "POST",
                url: '@Url.Action("Approve", "ExternalMaintenancePaymentRequest", new { Area = "Maintenance" })',
                data: { id: dataItem.ExternalMaintenancePaymenntrequestId},
                success: function (result) {
                    if (result.Success) {
                        toastr.success(result.Message)
                        $("#grid").data("kendoGrid").dataSource.read();
                    }
                    else {
                        toastr.error(result.Message)
                    }
                },
                error: function (result) {
                    alert(result)
                }
            });
        }
    }
    function approveonDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == 1 || dataItem.Status == 0) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-edit").hide();
            }
        });
    }
    function approveJobRequest(e) {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        $.ajax({
            type: "POST",
            url: '@Url.Action("ApproveJobRequest", "ExternalPaymentRequestValidation", new { area = "Maintenance" })',
            data: { id: dataItem.ExternalMaintenancePaymenntrequestId },
            success: function (result) {
                console.log(result.Message);
                //alert(result.Message);
               location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }
    function rejectJobRequest(e) {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        $.ajax({
            type: "POST",
            url: '@Url.Action("RejectJobRequest", "ExternalPaymentRequestValidation", new { area = "Maintenance" })',
            data: { id: dataItem.ExternalMaintenancePaymenntrequestId },
            success: function (result) {
                console.log(result.Message);
                //alert(result.Message);
                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }
    function DetailExpand(e) {
        // Access the data item (row) that was expanded
        var dataItem = this.dataItem(e.masterRow);

        // Assign the value from the MaintenanceCenterId column
        MCId = dataItem.MaintenanceCenterId;
    }
    function FilterMaintenanceCenter() {
        return {
            MaintenanceCenter: MCId,
            Text: $("#ServiceCenterJobId").data("kendoDropDownList").filterInput.val()

        };

    }

</script>
<style type="text/css">
    .k-grid table tr.k-state-Approved {
        background: #dbd9e1;
        color: #040000;
    }

    .k-grid table tr.k-state-Rejected {
        background: #00d0ff;
        color: #040000;
    }

    .k-grid table tr.k-state-waiting-approval {
        background: forestgreen;
        color: #040000;
    }
</style>