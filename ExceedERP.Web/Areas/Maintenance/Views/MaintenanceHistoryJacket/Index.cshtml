
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Maintenance History Jacket</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetViewModel.FleetEquipmentHistoryJacketViewModel>()
                                .Name("grid")
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.EquipmentCategoryName).Title("Equipment Category");
                                    columns.Bound(c => c.EquipmentTypeName).Title("Equipment Type");
                                    columns.Bound(c => c.EquipmentName).Title("Equipment Name");
                                    columns.Bound(c => c.PlateNo).Title("Plate Number");
                                    columns.Bound(c => c.PlateNumber).Title("Chasis Number");
                                    columns.Bound(c => c.SerialNo).Title("Serial Number");
                                })
                                .Filterable()
                                    .Scrollable(h => h.Height(500)).Scrollable()
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Model(model =>
                                    {
                                        model.Id(p => p.FleetId);

                                    })
                                    .Read(read => read.Action("Equipment_Read", "MaintenanceHistoryJacket").Data("sendForgery"))

                                ).ClientDetailTemplateId("tabs")
)
<script id="tabs" type="text/x-kendo-template">
    @(Html.Kendo().TabStrip()
                                        .Name("tabstrip_grid_#=FleetId#")
                                        .SelectedIndex(0)
                                        .Items(itemn =>
                                        {
                                           // itemn.Add().Text("Job Requests").Content(@<text>@JobRequest()</text>);
                                                    itemn.Add().Text("Job Orders").Content(@<text>@ServiceCenterJobs()</text>);
                                                // itemn.Add().Text("Insurance History").Content(@<text>@Insurance()</text>);


                                            }).ToClientTemplate())
</script>
