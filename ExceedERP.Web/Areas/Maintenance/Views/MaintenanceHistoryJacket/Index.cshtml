@helper ServiceCenterJobs()
{
    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Maintenance.JobOrderVM>()
                                                  .Name("Joborder_#=FleetId#")
                                                  .Columns(columns =>
                                                  {
                                                      columns.Bound(c => c.Num).Title("Num");
                                                      columns.Bound(c => c.Description).Title("Job Requested");
                                                      columns.Bound(c => c.MaintenanceCenter).Title("Garage/Center/Project");
                                                      columns.Bound(c => c.RequisitionDate).Title("Requisition Date");
                                                      columns.Bound(c => c.DateIn).Format("{0:yyyy-MM-dd}").Title("Date In");
                                                      columns.Bound(c => c.DateClosed).Format("{0:yyyy-MM-dd}").Title("Date Out");

                                                  })
                                                          .Filterable()
                                                          .Scrollable()
                                                          .DataSource(dataSource => dataSource
                                                              .Ajax()
                                                              .Model(model => model.Id(p => p.JobOrderId))
                                                              .Read(read => read.Action("JobOrder_Read", "MaintenanceHistoryJacket", new { id = "#=FleetId#" }).Data("sendForgery"))

                                                          ).ClientDetailTemplateId("Service").ToClientTemplate()
    )
}
<script id="Service" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                                        .Name("tabstrip_#=JobOrderId#")
                                                        .SelectedIndex(0)
                                                        .Items(items =>
                                                        {
                                                            items.Add().Text("Services")
                                            .Content(
                                        @<text>
                                            @(Html.Kendo().Grid<ExceedERP.Core.Domain.Maintenance.JobServiceVM>()
                                                                               .Name("jobService_#=JobOrderId#")
                                                                               .Columns(columns =>
                                                                               {
                                                                                   columns.Bound(c => c.SparePart).Title("Spare Part").Width(100);
                                                                                   columns.Bound(c => c.UOM).Title("Unit Of Measurment").Width(150);
                                                                                   columns.Bound(c => c.Qty).Title("Qty").Width(100);
                                                                                   columns.Bound(c => c.ServiceGroup).Title("Service Group").Width(100);
                                                                                   columns.Bound(c => c. WorkExcuted).Title("Work Executed").Width(100);
                                                                                   columns.Bound(c => c.Forman).Title("Forman").Width(150);
                                                                                   columns.Bound(c => c.AssignedTechnician).Title("Assigned Technician").Width(150);
                                                                                   columns.Bound(c => c.LabourCost).Title("Labour Cost").Width(150);
                                                                                   columns.Bound(c => c.UnitPrice).Title("Unit Price").Width(100);
                                                                                   columns.Bound(c => c.TotalPrice).Title("Total Price").Width(100);
                                                                               })
                                                                               .Filterable()
                                                                               .Scrollable()
                                                                               .DataSource(dataSource => dataSource
                                                                                   .Ajax()
                                                                                   .Model(model => model.Id(p => p.ServiceCenterJobId))
                                                                                   .Read(read => read.Action("ServiceCenterJob_Read", "MaintenanceHistoryJacket", new { JobOrderId = "#=JobOrderId#" }).Data("sendForgery"))

                                                                               ).ToClientTemplate()
                                            )
                                        </text>);

                                                        }).ToClientTemplate())

</script>