<legend> Maintenance Request</legend>
@(Html.Kendo().Grid<JobRequest>()
.Name("grid")
.Columns(columns =>
{
    columns.Bound(e => e.Num).Title("#").Width(80);
    columns.Bound(e => e.IsPM).Width(100).ClientTemplate("<input type='checkbox' disabled = 'true' #: IsPM? checked='checked': checked='' #/>");
    columns.Bound(e => e.HasInsurance).Width(100).ClientTemplate("<input type='checkbox' disabled = 'true' #: HasInsurance? checked='checked': checked='' #/>");
    columns.Bound(e => e.Source).Width(90);
    columns.Bound(e => e.LicensePlate).Width(120);
    columns.Bound(e => e.EquipmentName).Width(120);
    columns.ForeignKey(e => e.MaintenanceCenterId, (IEnumerable)ViewData["MaintenanceCenter"], "Id", "Name").Width(130);
    columns.ForeignKey(e => e.CustomerId, (IEnumerable)ViewData["Customer"], "OrganizationCustomerID", "TradeName").Width(200);
    //columns.Bound(e => e.CreateJobOrder).Width(200);
    columns.ForeignKey(e => e.RequesterId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Width(200);
    if (GlobalHelper.IsMultipleBusinessUnit())
    {
        columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["BusinessUnits"], "Id", "Name").Width(180).EditorTemplateName("BusinessUnitSelector");
    }
    columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").Width(180).EditorTemplateName("AllBranchSelector");
    columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["Structure"], "OrgStructureId", "Name").Title("Work Unit").Width(160).EditorTemplateName("WorkUnitCostCenterSelector");

    columns.Bound(e => e.DateCreated).Title("Date Created").Format("{0:yyyy-MM-dd}").Width(100);
    columns.Bound(e => e.OnlineApprovedTime).Title("Date Approved").Format("{0:yyyy-MM-dd}").Width(100);
    columns.Bound(e => e.Status).Width(100);
    columns.Bound(e => e.JobOrderStatus).Width(100);
    columns.Bound(e => e.EstmatedCostAmount).Width(100);
    columns.Bound(e => e.CreateJobOrder).Width(100);
    columns.Bound(e => e.LicensePlate).Visible(false);
    columns.Command(command =>
    {
        //command.Edit();
        // command.Destroy();
        //if (userCanEdit)
        //{
        //    command.Custom("cmd-void-request").Text("&nbsp;Void").Click("voidJobRequest").IconClass("fa fa-remove");
        //}
    }).Width(200);

})
//.ToolBar(commands =>
//{
//    commands.Create(); //commands.Excel();
//                       //commands.Pdf();
//})
//            .Editable(editable =>
//{
//    editable.Window(w => w.Title("Customer Request"));
//    editable.Mode(GridEditMode.PopUp).TemplateName("CommonJobRequestEditorTemplate");
//    editable.DisplayDeleteConfirmation("Are You Sure to Delete Job Request? ");
//})
.HtmlAttributes(new { style = "height: 520px;" })

.Pageable(pageable => pageable
.Input(true)
.Numeric(false)
.Refresh(true)
.PageSizes(true)
.ButtonCount(5))
.Scrollable()
.Sortable()
.Filterable()
.Scrollable(h => h.Height(500))
.ClientDetailTemplateId("template")
.Events(ev =>
{
    ev.DetailExpand("onDetailExpandUser");
   // ev.Edit("onJobRequestEdit");
    ev.DataBound("dataBound");
})
.DataSource(dataSource => dataSource
.Ajax()
//.ServerOperation(false)
.Sort(x => x.Add(s => s.Num).Descending())
//.Group(g=>g.Add(c=>c.Source))
.PageSize(5)
.Model(model =>
{
    model.Id(p => p.JobRequestId);
    model.Field(p => p.JobRequestId).Editable(false);
    model.Field(p => p.RequestNumber).Editable(false);
    model.Field(p => p.BranchId).Editable(false);
    model.Field(p => p.BusinessUnitId).Editable(false);
    model.Field(p => p.OrgStructureId).Editable(false);
    model.Field(p => p.EstmatedCostAmount).Editable(false);
})
.Events(ev => ev
.Error("error_handler(\"grid\")")
.RequestStart("onRequestStart(\"grid\")")
.RequestEnd("onRequestEnd(\"grid\")"))
// .Create(update => update.Action("JobRequest_Create", "JobRequest").Data("sendForgery"))
.Read(read => read.Action("JobRequest_Read", "JobRequestDepartment").Data("sendForgery"))
// .Update(update => update.Action("JobRequest_Update", "JobRequest").Data("sendForgery"))
//.Destroy(d => d.Action("JobRequest_Destroy", "JobRequest").Data("sendForgery"))
)
//.Events(events => events.DataBound("dataBound"))
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                .Name("tabStrip_#=JobRequestId#")
                .SelectedIndex(0)
                .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))

                .Items(items =>
                {
                    items.Add().Text("Detail").Content(@<text>

                        # if(CreateJobOrder)
                        {#

                        <a href='@Url.Action("Create_JobOrder", "JobRequest")/?Id=#=JobRequestId#' title="Create Job Order"><i class="fa fa-share-square fa-2x"></i></a>
                        # }#



                    </text>
                                           );
                            items.Add().Text(" Causes  ").Content(@<text>
                                @*<a href='@Url.Action("JobRequest", "PrintJob")/?Id=#=JobRequestId#' title="Print Job Request"><i class="fa fa-print fa-2x"></i></a>
                                    # if (IsSendForApproval == false || IsSendForApproval == "false")
                                    {#
                                    <a onclick='return sendForApproval("#=JobRequestId#")' href=' \#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                    # }#*@
                                @(Html.Kendo().Grid<ExceedERP.Core.Domain.Maintenance.JobCauses>()
                                                                                                .Name("JobCauses_#=JobRequestId#")
                                                                                                .Columns(columns =>
                                                                                                {
                                                                                                                    columns.Bound(o => o.Name).Width(120);
                                                                                                                    columns.Bound(o => o.Description).EditorTemplateName("JobReasonDescEditor").Width(180);
                                                                                                                    columns.Command(command =>
                                                                                                {
                                                                                                                    //command.Edit();
                                                                                                                    // command.Destroy();
                                                                                                                }).Width(200);
                                                                                                                }).Events(ev =>
                                                                                        {
                                                                                                                        ev.DataBound("lineonDataBound");
                                                                                                                    })
                                                                                                // .ToolBar(T => T.Create())
                                                                                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                                                .DataSource(dataSource => dataSource
                                                                                                    .Ajax()
                                                                                                    .PageSize(20)
                                                                                                    .Model(model => model.Id(p => p.JobCausesId)).Events(ev => ev
                                                                                                        .Error("error_handler(\"JobCauses_#=JobRequestId#\")")
                                                                                                        .RequestStart("onRequestStart(\"JobCauses_#=JobRequestId#\")")
                                                                                                        .RequestEnd("onRequestEnd(\"JobCauses_#=JobRequestId#\")"))
                                                                                                    // .Create(create => create.Action("JobCauses_Create", "JobCauses", new { Id = "#=JobRequestId#" }).Data("sendForgery"))
                                                                                                    .Read(read => read.Action("JobCauses_Read", "JobCauses", new { Id = "#=JobRequestId#" }).Data("sendForgery"))
                                                                                                //  .Update(update => update.Action("JobCauses_Update", "JobCauses").Data("sendForgery"))
                                                                                                //.Destroy(d => d.Action("JobCauses_Destroy", "JobCauses").Data("sendForgery"))
                                                                                                )
                                                                                                .ToClientTemplate())
                            </text>
);


                                    items.Add().Text("Department Approval").Content(@<text>
                                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.Maintenance.AdministrativeJobDepartmentApproval>()
                       .Name("JobOrderAdmingrid_#=JobRequestId#")
                       .Columns(columns =>
                       {
                                                   columns.Bound(o => o.Status).EditorTemplateName("ApprovalStatusBind").Width(126);
                                                   columns.Bound(o => o.Remark).Width(160);
                                                   columns.Bound(o => o.CreatedBy).Width(120);
                                                   columns.Bound(o => o.DateCreated).Format("{0:d}").Width(120);
                                                   columns.Command(command =>
                           {
                                                           command.Custom("cmd-approve-request").HtmlAttributes(new { @class = "kendoPrimary" })
                                   .Text("&nbsp;Approve").Click("approveJobRequest").IconClass("fa fa-check");
                                                           command.Custom("cmd-reject-request").HtmlAttributes(new { @class = "kendoDanger" })
                                   .Text("&nbsp;Reject").Click("rejectJobRequest").IconClass("fa fa-close");
                                               // command.Custom().Text("Approve");
                                           }).Width(250);
                                               }).Events(ev =>
                                   {
                                                                   ev.DataBound("approveonDataBound");
                                                               })
                       .Editable(editable => editable.Mode(GridEditMode.InLine))
                       .DataSource(dataSource => dataSource
                       .Ajax()
                       .PageSize(20)
                       .Model(model =>
                       {
                                                   model.Id(p => p.AdministrativeJobDepartmentApprovalID);
                                                   model.Field(p => p.CreatedBy).Editable(false);
                                                   model.Field(p => p.DateCreated).Editable(false);
                                               }).Events(ev => ev
                                   .Error("error_handler(\"JobOrderAdmingrid_#=JobRequestId#\")")
                                   .RequestStart("onRequestStart(\"JobOrderAdmingrid_#=JobRequestId#\")")
                                   .RequestEnd("onRequestEnd(\"JobOrderAdmingrid_#=JobRequestId#\")"))
                       .Create(create => create.Action("Admin_Approve", "JobRequestDepartment", new { Id = "#=JobRequestId#" }).Data("sendForgery"))
                       .Read(read => read.Action("Admin_Read", "JobRequestDepartment", new { Id = "#=JobRequestId#" }).Data("sendForgery"))
                       // .Update(update => update.Action("Admin_Approve", "JobRequestDepartment", new { Id = "#=JobRequestId#" }).Data("sendForgery"))
                       )
                       .ToClientTemplate())
                                    </text>
);
                                        })
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .ToClientTemplate())
</script>





<script>
