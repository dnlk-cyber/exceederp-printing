                }
                else if (dataItem.Status == "Closed") {

                    $(this).find(".k-grid-cmd-rework-request").show();
                    $(this).find(".k-grid-cmd-deliver-request").show();

                }
                else if (dataItem.Status == "Delivered") {
                    $(this).find(".k-grid-cmd-rework-request").show();

                }

                else {
                    $(this).find(".k-grid-delete").show(); //////////--------///////////
                    $(this).find(".k-grid-cmd-reject-request").show();

                }
            }

            else if (dataItem.Status == "Closed") {
                $(this).find(".k-grid-cmd-rework-request").show();
                $(this).find(".k-grid-cmd-deliver-request").show();
            }
            else if (dataItem.Status == "Delivered") {
                $(this).find(".k-grid-cmd-rework-request").show();
            }

            if (dataItem.IsSubmittedToServiceCenter && !dataItem.IsSecondOnlineApproved) {
                $(this).find(".k-grid-cmd-reject-request").show();
                $(this).find(".k-grid-delete").show(); ////////////////----------------///////////

            }
            else {
                $(this).find(".k-grid-cmd-reject-request").hide();
                $(this).find(".k-grid-delete").hide();

            }


        });
    }

