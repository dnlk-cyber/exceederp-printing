<script>
    function filterCategories() {
        var dropdownlist = $("#ItemCode").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            categoryId: $("#ItemCategoryCode").val(),
            filterText: filterInput.val()
        };
    }
    function filterSubCategory() {
        var dropdownlist = $("#SubCategoryCode").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            jobOrderId: masterId,
            filterText: filterInput.val()

        };
    }
    function filterSubCategories() {
        var dropdownlist = $("#ServiceGroup").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        var Code = $("#SubCategoryCode").val();
        return {
            subCategoryCode: Code,
            jobOrderId: masterId,
            filterText: filterInput.val()


        };

    }
    function filterServices() {
        var dropdownlist = $("#JobOrderDetailId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        var categoryCode = $("#SubCategoryCode").val();
        var serviceGroup = $("#ServiceGroup").val();
        return {
            subCategoryCode: categoryCode,
            serviceGroup: serviceGroup,
            jobOrderId: masterId,
            filterText: filterInput.val()


        };

    }

    function filterJobService() {
        return {
            jobOrderId: masterId
        };
    }
    var masterId;
    var fleetPlate;
    var IsApproved;
    var IsSecondSendForApproval;
    var IsOnlineTransfered;

    function OnExpand(e) {
        var masterRow = e.masterRow;

