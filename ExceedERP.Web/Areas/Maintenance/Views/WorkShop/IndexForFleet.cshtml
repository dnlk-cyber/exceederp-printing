function approveCanibalizationRequest(e) {
e.preventDefault(); // Prevent default button behavior
var childGrid = $(e.currentTarget).closest(".k-grid").data("kendoGrid"); // Get the child grid instance
var row = $(e.currentTarget).closest("tr"); // Find the closest row
var dataItem = childGrid.dataItem(row); // Get data from the row
if (!dataItem || !dataItem.CanibalizationId) {
alert("Could not find the CanibalizationId in the child grid.");
return;
}
var CanibalizationIdd = dataItem.CanibalizationId; // Extr
$.ajax({
type: "POST",
url: '@Url.Action("ApproveRequest", "CanibalizationDepartment", new { area = "Maintenance" })',
data: { id: CanibalizationIdd },
success: function (result) {
// console.log(result.Message);
alert(result.Message);
// location.reload(true);
},
error: function (result) {
alert(result);
}
});
}
function rejectCanibalizationRequest(e) {
