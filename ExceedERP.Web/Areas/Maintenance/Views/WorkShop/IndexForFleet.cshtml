};

}

function filterJobService() {
return {
jobOrderId: masterId
};
}
var masterId;
var fleetPlate;
var IsApproved;
var IsSecondSendForApproval;
var IsOnlineTransfered;

function OnExpand(e) {
var masterRow = e.masterRow;

var masterGrid = $("#grid").data("kendoGrid");

var dataItem = masterGrid.dataItem(masterRow);
masterId = dataItem.ServiceCenterJobId;
fleetPlate = dataItem.VoidBy;
IsApproved = dataItem.IsSecondOnlineApproved;
IsSecondSendForApproval = dataItem.IsSecondSendForApproval;
IsOnlineTransfered = dataItem.IsOnlineTransferred;
}

function onChange() {
var unitPrice = $("#UnitPrice").val();
var quantity = $("#Quantity").val();
$("#TotalPrice").prop("readonly", true);
$("#TotalPrice").val(unitPrice * quantity).trigger("change");
// $("#TotalPrice").prop('readonly', true);

}
function ServiceDataBound() {
this.expandRow(this.tbody.find("tr.k-master-row").first());
var grid = this;

grid.tbody.find("tr[role='row']").each(function () {
var dataItem = grid.dataItem(this);

if (IsOnlineTransfered||IsSubmitted) {
$(this).find(".k-grid-edit").remove();
$(this).find(".k-grid-delete").remove();
}
});
}

function submitWorkShop(jobId) {
$.ajax({
type: "POST",
url: '@Url.Action("SubmitWorkShop", "WorkShop", new { area = "Maintenance" })',
data: { Id: jobId },
success: function(result) {
alert(result.Message);
if (result.Status == "Success") {
location.reload(true);
}
