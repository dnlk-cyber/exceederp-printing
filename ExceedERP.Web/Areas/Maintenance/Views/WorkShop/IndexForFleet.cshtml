@helper CanablizationApproval()
{
    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Maintenance.CanibalizationApproval>()
                                .Name("Canibalizationgrid_#=CanibalizationId#")
                                .Columns(columns => // No parameters needed here
                                {
                                    columns.Bound(c => c.CanibalizationApprovalId).Title("Approval ID");
                                    columns.Bound(c => c.Status).Title("Status");
                                    columns.Bound(c => c.Remark).Title("Remark");
                                    columns.Bound(c => c.CreatedBy).Title("Created By");
                                    columns.Bound(c => c.DateCreated).Title("Date Created");
                                    columns.Command(command =>
                        {
                            command.Custom("cmd-approve-request").HtmlAttributes(new { @class = "kendoPrimary" })
                .Text("&nbsp;Approve").Click("approveJobRequest").IconClass("fa fa-check");
                            command.Custom("cmd-reject-request").HtmlAttributes(new { @class = "kendoDanger" })
                .Text("&nbsp;Reject").Click("rejectJobRequest").IconClass("fa fa-close");
            //command.Custom().Text("Approve");
        }).Width(250);
                                }).Events(ev =>
                                {
                                    ev.DataBound("approveonDataBound");
                                })
                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .PageSize(20)
                                .Model(model =>
                                {
                                    model.Id(p => p.CanibalizationApprovalId);
                                    model.Field(p => p.CreatedBy).Editable(false);
                                    model.Field(p => p.DateCreated).Editable(false);
                                }).Events(ev => ev
                                .Error("error_handler(\"Canibalizationgrid_#=CanibalizationId#\")")
                                .RequestStart("onRequestStart(\"Canibalizationgrid_#=CanibalizationId#\")")
                                .RequestEnd("onRequestEnd(\"Canibalizationgrid_#=CanibalizationId#\")"))
                                .Create(create => create.Action("Admin_Approve", "Canibalization", new { Id = "#=CanibalizationId#" }).Data("sendForgery"))
                                .Read(read => read.Action("Admin_Read", "Canibalization", new { Id = "#=CanibalizationId#" }).Data("sendForgery"))
                                .Update(update => update.Action("Admin_Approve", "Canibalization", new { Id = "#=CanibalizationId#" }).Data("sendForgery"))
                                )
                                .ToClientTemplate())
}
