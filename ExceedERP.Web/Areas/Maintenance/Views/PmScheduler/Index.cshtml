
@{
    ViewBag.Title = "Index";
}
@using ExceedERP.Core.Domain.Maintenance;
<legend>PM Schedule</legend>
@(Html.Kendo().Grid<PmScheduler>()
                    .Name("grid")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.EquipmentNameId).Title("Name").Width(120);
                        columns.ForeignKey(c => c.FleetId, (IEnumerable)ViewData["PlatesList"], "Code", "Name").EditorTemplateName("PlatesForPmSelector").Title("Plate/Serial No").Width(120);
                        columns.Bound(c => c.Location).Title("Location").Width(120);
                        columns.ForeignKey(c => c.TaskId, (IEnumerable)ViewData["Services"], "Code", "Name").EditorTemplateName("PMRepairTypeSelector").Title("PM Task Description").Width(120);
                        columns.ForeignKey(c => c.PmSettingId, (IEnumerable)ViewData["PmSetting"], "Code", "Name").EditorTemplateName("PMSettingSelector").Title("PM Type").Width(120);
                        columns.Bound(c => c.LastPmDate).Title("Last PM Date").Width(120);
                        columns.Bound(c => c.NextPmDate).Title("Next PM Date").Width(120);
                        columns.Bound(c => c.DateFrequency).Title("Frequency(Date)").Width(120);
                        columns.Bound(c => c.LastPmKM).Title("Last PM Km or Hr").Width(120);
                        columns.Bound(c => c.NextPmKM).Title("Next PM Km or Hr").Width(120);
                        columns.Bound(c => c.KMFrequency).Title("Frequency(KM)").Width(120);
                        columns.Bound(c => c.IsExpired).Title("Completion").Width(120);
                        columns.Bound(c => c.WorkDelay).Title("Work Delay").Width(120);
                        columns.Bound(c => c.DelayReason).Title("/Delay Reason").Width(120);
                        columns.Command(command =>
                        {
                            command.Edit();
                            command.Destroy();
                        }).Width(120).Title("Action");
                    })
                    .Events(ev => ev.DataBound("PmDatabound"))
                    .ToolBar(toolbar =>
        {
            toolbar.Template(@<text>
                <!-- Always visible -->
                <a class="k-button k-button-icontext k-grid-add" href="#">
                    <span class="k-icon k-i-plus"></span>
                    Add New Record
                </a>
                <!-- Conditional content -->
                    

                    <button class="k-button k-primary" onclick="generateSchedule()">
                        Generate Next Schedule
                    </button>
                            
               

            </text>);
                })
                            .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
                                        .Scrollable()
                                        .Sortable()
                                        .Filterable()
                                        .Scrollable(h => h.Height(500))
                            .Editable(editable => editable.Mode(GridEditMode.InLine))
                            .DataSource(datasource => datasource
                            .Ajax()
                            .Model(model =>
                            {
                                model.Id(m => m.PmSchedulerId);
                                model.Field(f => f.EquipmentNameId).Editable(false);
                            })
                            .Events(ev => ev.Error("error_handler(\"grid\")")
                                        .RequestStart("onRequestStart(\"grid\")")
                                        .RequestEnd("onRequestEnd(\"grid\")"))
                            .Create(create => create.Action("PmScheduler_Create", "PmScheduler").Data("sendForgery"))
                            .Read(read => read.Action("PmScheduler_Read", "PmScheduler").Data("sendForgery"))
                            .Update(update => update.Action("PmScheduler_Update", "PmScheduler").Data("sendForgery"))
                            .Destroy(d => d.Action("PmScheduler_Destroy", "PmScheduler").Data("sendForgery"))
                            .Sort(s => s.Add(x => x.PmSchedulerId).Descending()
                                        )
                            )
                         .ClientDetailTemplateId("FileAttachment")
            //.ToClientTemplate()


)

<script type="text/kendo-tmpl" id="FileAttachment">
    @(Html.Kendo().TabStrip()
                    .Name("FileUpload_#=PmSchedulerId#")
                    .SelectedIndex(0)
                    .Items(items =>
                    {
                        items.Add().Text("Link to SOP")
                        .Content(
                        @<text>
                            @FileUpload()
                        </text>);

                            }).ToClientTemplate())

</script>
@helper FileUpload()
{
    <text>
        @(Html.Kendo().Grid<SOPDocument>()
                                        .Name("SOPDocument#=PmSchedulerId#")

                                        .Columns(columns =>
                                        {
                                            columns.Bound(x => x.SOPDocumentId).Hidden(true);
                                            columns.Bound(c => c.FileName).ClientTemplate("<a href='/Maintenance/PmScheduler/DownloadSOPDocument?SOPDocumentIdentification=\\#=SOPDocumentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; \\#=FileName\\# </a>").Width(200);
                                // columns.Bound(c => c.FileName).ClientTemplate("<a href='/App_Data/Bolo/BoloDocReg1?CompanyDocumentId=\\#=BoloRegistrationDocumentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; \\#=FileName\\# </a>").Width(200);

                                columns.Command(command =>
                                        {
                                //command.Edit();
                                command.Destroy();
                                        }).Width(580);
                                        })
                                      .ToolBar(t => t.Template(
                                                @<text>
                                                    @(Html.Kendo().Upload()
                                                                                    .Name("attachments")
                                                                                 .Async(a => a.Save("SOPAttachment_Create", "PmScheduler", new { id = "#=PmSchedulerId#" }))
                                                                                    //  .Async(a => a.Save("BoloRegistrationAttachment_Create", "FleetBoloRegistration", new { id = "#=PmSchedulerId #" }))
                                                                                    .Events(e => e.Complete("onUploadSuccess").Select("function(e) { globalOnSelect(e, ['.jpg', '.png', '.pdf'], 2 * 1024 * 1024); }")
                                                                                    .Error("onUploadError")
                                                                                    )
                                                                                    .ShowFileList(false)
                                                                                    .ToClientTemplate()
                                                    )
                                                </text>
                                                               ))

                                                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                .HtmlAttributes(new { style = "height: 350px;" })
                                                                .Sortable(sortable =>
                                                                {
                                                                    sortable.SortMode(GridSortMode.SingleColumn);
                                                                })
                                                                .Scrollable()
                                                                .Pageable(pageable => pageable
                                                                .Input(true)
                                                                .Numeric(false)
                                                                .Refresh(true)
                                                                .PageSizes(true)
                                                                .ButtonCount(5))
                                                                // .Events(x => x.DataBound("onDataBoundLines"))
                                                                .DataSource(dataSource => dataSource
                                                                .Ajax()
                                                                .Events(ev => ev
                                                                    .Error("error_handler(\"SOPDocument#=PmSchedulerId#\")")
                                                                    .RequestStart("onRequestStart(\"SOPDocument#=PmSchedulerId#\")")
                                                                    .RequestEnd("onRequestEnd(\"SOPDocument#=PmSchedulerId#\")"))
                                                                    .Model(model => model.Id(p => p.SOPDocumentId))
                                                                    .Read(read => read.Action("SOPDoc_Read", "PmScheduler", new { id = "#=PmSchedulerId#", area = "Maintenance" }).Data("sendForgery"))
                                                                    .Destroy(destroy => destroy.Action("SOPDoc_Delete", "PmScheduler", new { area = "Maintenance" }).Data("sendForgery"))
                                                                    ).ToClientTemplate()
        )
    </text>

}

<script>
    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    function onUploadSuccess(e) {
        var gridname = "#SOPDocument" + codeid;
        $(gridname).data("kendoGrid").dataSource.read();
    }
    function onUploadError(e) {

    }
    function globalOnSelect(e) {

    }
    function filterPlateNumber() {
        var dropdownlist = $("#FleetId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            filter: filterInput.val()

        };
    }

    function FilterRepairType() {
        var dropdownlist = $("#TaskId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            RepiarTypeName: filterInput.val()
        };
    }

    function generateSchedule() {
    $.ajax({
        url: '@Url.Action("GenerateSchedule", "PmScheduler")',
        type: "POST",
        success: function (response) {
            if (response.Result == "OK") {
                alert(response.Message);
                $("#grid").data("kendoGrid").dataSource.read();
            }
        },
        error: function () {
            alert("Error generating schedule");
        }
    });
}
    function IsExpiredDataBound() {
        var grid = $("#PmSchedulerGrid").data("kendoGrid");
        var data = grid.dataSource.view(); // Get the currently displayed data

        var currentDate = new Date();

        data.forEach(function (row) {
            var nextPmDate = new Date(row.NextPmDate);
            if (nextPmDate < currentDate && !row.IsExpired) {
                $.ajax({
                    url: "/PmScheduler/PmSchedulerExpired",
                    type: "POST",
                    data: { id: row.PmSchedulerId },
                    success: function () {
                        row.IsExpired = true; // Update the grid data
                        grid.refresh();
                    },
                    error: function () {
                        console.error("Error updating expired status.");
                    }
                });
            }
        });
    }
    function PmDatabound() {
        var grid = this;
        var now = new Date();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);

            if (dataItem.NextPmDate) {
                var nextPmDate = new Date(dataItem.NextPmDate);

                if (nextPmDate < now) {
                    $(this).addClass("k-state-Expired");
                }
            }
        });
    }

</script>
<style type="text/css">


    .k-grid table tr.k-state-Expired {
        background: #ff6a00;
        color: #040000;
    }
</style>