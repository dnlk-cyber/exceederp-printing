@model ExceedERP.Core.Domain.Maintenance.MaintenancePlanDetail
<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Month</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.GlPeriodId)
                                                  .OptionLabel("Select Period")
                                                  .AutoBind(true)
                                                  .DataValueField("Value")
                                                  .DataTextField("Text")

                                                  .DataSource(dataSource =>
                                                  {
                                                      dataSource.Read(read => read.Action("GetGlPeriodForPlanAndEvaluation", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery").Data("getFiscalYear"))
                                                      .ServerFiltering(true);
                                                  }).Enable(false)
                )
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>CM Quantity</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.CMQuantity).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            <label>PM Quantity</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.PMQuantity).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            <label>PM Material Cost</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.PMMaterialCost).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
</div>

<div class="row">

    <div class="col-sm-2">
        <div class="form-group">
            <label>PM Labor Cost</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.PMLaborCost).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            <label>CM Material Cost</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.CMMaterialCost).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>CM Labor Cost</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.CMLaborCost).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
</div>


