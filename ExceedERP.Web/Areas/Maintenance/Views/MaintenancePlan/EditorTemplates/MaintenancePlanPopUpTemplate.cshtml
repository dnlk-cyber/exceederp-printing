
@model ExceedERP.Core.Domain.Maintenance.MaintenancePlan
@{ 
    bool IsMIDROC = (ViewBag.setting as string) == "MIDROC";
}
<div class="row">
    @if (IsMIDROC == false)
    {
    <div class="col-sm-2">
        <div class="form-group">
            <label>Maintenance Center</label>
            <div>

                @(Html.Kendo().DropDownListFor(model => model.MaintenanceCenterId)

                                .HtmlAttributes(new { @class = "form-control" })
                                .DataTextField("Name")
                                .DataValueField("Id")
                                .OptionLabel("Select...")
                                .HtmlAttributes(new { style = "width:100%" })
                                .DataSource(d =>
                                {
                                    d.Read(r =>
                                    {
                                        r.Action("GetAllMaintenanceCentersById", "MaintenanceCenter");
                                    })
                                    .ServerFiltering(false);
                                }).ValuePrimitive(true)
                )
            </div>
        </div>

    </div> 
    <div class="col-sm-2">
        <div class="form-group">
            <label>Service Center</label>
            <div>

                @(Html.Kendo().DropDownListFor(model=>model.ServiceCenterId)
                .DataValueField("Value")
                .DataTextField("Text")
                .Filter("Contains")
                .CascadeFrom("MaintenanceCenterId")
                .OptionLabel("Select serviceCenter")
                .DataSource(d => d.Read(r => r.Action("GetAllServicesForMechanic", "MaintenanceDataProvider").Data("filterMaintenanceCenter")).ServerFiltering(true)
                )
                 )
            </div>
        </div>

    </div>
    }
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Category</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentCategoryId)
                .DataTextField("Name")
                .DataValueField("Id")
                .Filter(FilterType.Contains)
                .OptionLabel("Select Category")
                .HtmlAttributes(new { style = "width:100%" })
                .DataSource(d => d.Read(r => r.Action("GetEquipmentIdentities", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery"))
                .ServerFiltering(false)))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Type</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentTypeId)
                 .DataTextField("Name")
                 .DataValueField("Id")
                 .OptionLabel("Select Equipment Type")
                 .Filter(FilterType.Contains)
                 .DataSource(d =>
                 {
                     d.Read(r =>
                     {
                         r.Action("GetEquipmentTypes", "FleetManagementDataProvider", new { area = "FleetManagement" })
                         .Data("filterCategory");
                     })
                     .ServerFiltering(true);
                 })
                 .Enable(false)
                 .AutoBind(false)
                 .CascadeFrom("EquipmentCategoryId")
                )
            </div>
        </div>
    </div>
    <div class="row">
        @if (IsMIDROC == true)
        {
        <div class="col-sm-2">
            <div class="form-group">
                <label>Equipment Name</label>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.EquipmentNameId)
                .AutoBind(true)
                .Enable(false)
                 .ValuePrimitive(true)
                .DataTextField("Name")
                .DataValueField("Id")
                .Filter(FilterType.Contains)
                .OptionLabel("Select")
                .DataSource(d => d.Read(r => r.Action("GetEquipmentNamesNullable", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery")
                .Data("filterEquipmentNames"))
                .ServerFiltering(true))
                .CascadeFrom("EquipmentTypeId"))
                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <label>Plate No</label>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.FleetId)
                  .ValuePrimitive(true)
                  .OptionLabel("Select Equipment...")
                  .DataTextField("PlateNumber")
                  //.Events(ev => ev.Change("SelectOperator"))
                  .DataValueField("FleetsID")
                  .Filter("contains")
                  .MinLength(2)
                  .CascadeFrom("EquipmentNameId")
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetFleetIdTimesheetNew", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery")
                      .Data("handleFleetId"))
                          .ServerFiltering(true);
                  }).HtmlAttributes(new { style = "width:100%" })
                    )

                </div>
            </div>
        </div>
        }
        <div class="col-sm-2">
            <div class="form-group">
                <label>Fiscal year</label>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.GlFiscalYearId)
                            .OptionLabel("Select Year")
                            .AutoBind(false)
                            .DataValueField("GlFiscalYearId")
                            .DataTextField("Name")
                            .DataSource(dataSource =>
                            {
                                dataSource.Read(read => read.Action("GetOpenYears", "GlobalDataProvider", new { area = "Common" }).Data("sendForgery"))
                                 .ServerFiltering(false);
                            }))
                </div>
            </div>
        </div>

    </div>
    @if (IsMIDROC == false)
    {
<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Total Quantity</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.TotalQuantity).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Ava. Quantity</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.AverageAvailableQuantity).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            <label>Av. PM Cost</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.AverageMaintenanceCostPM).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Av. CM Cost</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.AverageMaintenanceCostCM).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
</div>
    }


