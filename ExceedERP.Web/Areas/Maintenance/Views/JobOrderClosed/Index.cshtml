<legend>Job Orders</legend>
@(Html.Kendo().Window()
                    .Name("window")
                    .Width(400)
                    .Height(200)
                    .Visible(false)
                    .Modal(true)
                    .Draggable(true)
                    .Content(@<text>
                        <form action="@Url.Action("RejectJobOrderClosing", "ServiceCenter", new { area = "Maintenance" })" method="post" , new { enctype="multipart/form-data" }>
                            <input type="hidden" name="id" id="id">
                            <div class="row">
                                <div class="col-md-3">

                                    @Html.Label("Reason:")

                                    @Html.TextArea("RejectionReason", "", new { type = "text" })
                                </div>

                            </div>
                            <button type="submit" onclick="getJobOrderId()" class="btn btn-info"><i class="glyphicon glyphicon-ok" aria-hidden="true"></i> Submit</button>

                        </form>
                    </text>)
                                                        .Modal(true)
                                                        .Title("Reason For Reject")
                                                        .Actions(actions => actions.Close())

)
@(Html.Kendo().Grid<JobOrder>()
                    .Name("grid")
                    .Columns(columns =>
                    {
                        columns.Bound(e => e.Num).Width(80);
                        columns.ForeignKey(e => e.CustomerId, (IEnumerable)ViewData["Customers"], "Code", "Name").Title("Customer").Width(150);
                        columns.Bound(e => e.LicensePlate).Width(100);
                        columns.Bound(e => e.EquipmentName).Width(100);
                        columns.Bound(e => e.IsRework).Width(100).ClientTemplate("<input type='checkbox' disabled = 'true' #: IsRework? checked='checked': checked='' #/>");
                        columns.ForeignKey(e => e.RequesterId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Width(120);
                        if (GlobalHelper.IsMultipleBusinessUnit())
                        {
                            columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["BusinessUnits"], "Id", "Name").Width(120).EditorTemplateName("BusinessUnitSelector");
                        }
                        columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branches"], "Id", "Name").Width(120).EditorTemplateName("AllBranchSelector");
                        columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["Structure"], "OrgStructureId", "Name").Title("Work Unit").Width(120).EditorTemplateName("WorkUnitCostCenterSelector");

                        columns.ForeignKey(e => e.MaintenanceCenterId, (IEnumerable)ViewData["MaintenanceCenter"], "Id", "Name").Width(120);
                        columns.Bound(e => e.DateCreated).Title("Date Created").Format("{0:yyyy-MM-dd}").Width(100);
                        columns.Bound(e => e.OnlineApprovedTime).Title("Date Approved").Format("{0:yyyy-MM-dd}").Width(100);
                        columns.Bound(e => e.SecondOnlineApprovedTime).Title("Date Closed").Format("{0:yyyy-MM-dd}").Width(100); columns.Bound(e => e.Status).Width(100);
                        columns.Bound(e => e.Status).Width(100);
                        columns.Bound(e => e.Referance).Width(100);
                        columns.Bound(e => e.RemarkAfterDelivery).Width(130);


                        columns.Command(command =>
                        {

                            command.Custom("cmd-rework-request").Text("&nbsp;Rework").Click("reworkJobOrder").IconClass("fa fa-repeat");
                            if (HttpContext.Current.User.IsInRole(MaintenanceRoles.GarageHead))
                            {
                                command.Custom("cmd-deliver-request").Text("&nbsp;Authorize And Deliver").Click("deliverJobOrder").IconClass("fa fa-truck");
                            }
                            command.Destroy().Text(" Approve & Close").IconClass("fa fa-check");
                            command.Custom("cmd-reject-request").Text("&nbsp; Reject").Click("rejectJobOrderClosingRequest").IconClass("fa fa-close");
                            command.Custom("cmd-open-request").Text("&nbsp; Open").Click("openJobOrder").IconClass("fa fa-open");
                        }).Width(250);


                    })

                    .Editable(editable =>
                    {
                        editable.Mode(GridEditMode.PopUp).TemplateName("JobOrderEditor").Window(x => x.Title("Job Order "));
                        editable.Window(w => w.Title(" Job Order"));
                        editable.DisplayDeleteConfirmation("Are You Sure To Close Job Order");
                    })
                    .HtmlAttributes(new { style = "height: 500px;" })
                    .Pageable(pageable => pageable
                    .Input(true)
                    .Numeric(false)
                    .Refresh(true)
                    .PageSizes(true)
                    .ButtonCount(5))
                    .Scrollable()
                    .Sortable()
                    .Filterable()
                    .Scrollable(h => h.Height(500))
                    .ClientDetailTemplateId("template")
                    .Events(ev => ev.DetailExpand("onDetailExpandUser"))
                    .DataSource(dataSource => dataSource
                    .Ajax()
                    .ServerOperation(true)

                    .Sort(x => x.Add(s => s.Num).Descending())

                    .PageSize(10)
                    .Model(model =>
                    {
                        model.Id(p => p.JobOrderID);
                        model.Field(p => p.JobOrderID).Editable(false);
                        model.Field(p => p.BranchId).Editable(false);
                        model.Field(p => p.OrgStructureId).Editable(false);
                        model.Field(p => p.BusinessUnitId).Editable(false);
                    }
                    ).Events(ev => ev
                    .Error("error_handler(\"grid\")")
                    .RequestStart("onRequestStart(\"grid\")")
                    .RequestEnd("onRequestEnd(\"grid\")"))
                    .Create(update => update.Action("JobOrder_Create", "JobOrderClosed").Data("sendForgery"))
                    .Read(read => read.Action("JobOrderClosed_Read", "JobOrderClosed").Data("sendForgery"))
                    .Update(update => update.Action("JobOrder_Update", "JobOrderClosed").Data("sendForgery"))
                    .Destroy(update => update.Action("JobOrder_Destroy", "JobOrderClosed").Data("sendForgery"))
                    )
                    .Events(events => events.DataBound("dataBound"))
)

