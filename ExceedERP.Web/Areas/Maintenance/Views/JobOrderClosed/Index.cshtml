<script type="text/javascript">
    var Referance;
    var IsPm;
    var masterId;
    var IsOnlineApproved;
    var maintenanceCenterId;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        IsOnlineApproved = masterDataItem.IsOnlineApproved;
        maintenanceCenterId = masterDataItem.MaintenanceCenterId;
        Referance = masterDataItem.Referance;
        IsPm = masterDataItem.IsPM;
        var Id = masterDataItem.JobOrderID;
         masterId = masterDataItem.JobOrderID;
        var JobServicegrid = "#JobServicegrid_" + Id;
         var Technicalgrid = "#Technicalgrid_" + Id;


            $.ajax({
            url: '@Url.Action("JobOrderExtra_Read", "JobOrder")',

                data: { Id: Id  },
            type: 'GET',
            cache: false,
            success: function (list) {
                for (var i = 0 ; i < list.length; i++) {

                    $("#CostChart" + Id).kendoChart({
                        title: {
                            text: " Cost Information Summary "
                        },
                        legend: {
                            position: "right"
                        }, theme: "material",
                        seriesDefaults: {
                            labels: {
                                template: " ",
                                position: "outsideEnd",
                                visible: true,
                                background: "transparent"
                            }
                        },
                        series: [{
                            type: "pie",
                            data: [{
                                category: "Spare Part & Material",
                                value: list[i].SpareCost
                            },
                            //{
                            //    category: "Tyre",
                            //    value: list[i].TyreCost
                            //},
                            //{
                            //    category: "Battery",
                            //    value: list[i].BatteryCost
                            //},
                            //{
                            //    category: "Salvage",
                            //    value: list[i].SalvageCost
                            //},
                            //{
                            //    category: "Oil & Lubricant",
                            //    value: list[i].OilCost
                            //},
                            //{
                            //    category: "Other",
                            //    value: list[i].OtherCost
                            //    },
                           {
                         category: "Labour",
                                    value: list[i].LabourCost
                     }]
                        }],
                        tooltip: {
                            visible: true,
                            template: "#= category # - #= kendo.format('{0:P}', percentage) #"
                        }
                    });



             $("#EfficencyGauge" + Id).kendoRadialGauge({

                 pointer: {
                     value: kendo.toString(list[i].Efficiency, 'N2')
                 },
                 theme: "bootstrap",
                 scale: {
                     minorUnit: 5,
                     startAngle: -30,
                     endAngle: 210,
                     max: 100,
                     labels: {
                         position:  "inside"
                     },
                     ranges: [
                         {
                             from: 0,
                             to: 30,
                             color: "#ffc700"
                         }, {
                             from: 30,
                             to: 60,
                             color: "#ff7a00"
                         }, {
                             from: 60,
                             to: 100,
                             color: "#c20000"
                         }
                     ]
                 }
             });

                }
            }
        });





        $.ajax({
            url: '@Url.Action("GetJobStatus", "JobOrder")',

            data: { Id: Id },
            type: 'POST',
            cache: false,
           success: function (r) {


                if (masterDataItem.IsSendForApproval ==  true ) {
                    $(JobServicegrid).find(".k-toolbar").hide(); //hide toolbar
                    //$(".k-grid-top", JobServicegrid).hide();
                    $(".k-grid-edit", JobServicegrid).hide();
                    $(".k-grid-delete", JobServicegrid).hide();
                    $(".cmd-reject-request", JobServicegrid).hide();
                    $(".cmd-open-request", JobServicegrid).hide();
                }
                if (masterDataItem.IsOnlineApproved == true) {
                    $(Technicalgrid).find(".k-toolbar").hide(); //hide toolbar
                    //$(".k-grid-top", Technicalgrid).hide();
                    $(".k-grid-edit", Technicalgrid).hide();
                    $(".k-grid-delete", Technicalgrid).hide();
                    $(".cmd-reject-request", Technicalgrid).hide();
                    $(".cmd-open-request", Technicalgrid).hide();

                }



            }

        });

       $.ajax({
            type: "GET",
            url: '@Url.Action("UpdateJO", "JobOrder", new { area= "Maintenance" })',
            dataType: "json",
            
            success: function (result) {
                console.log(result);
            },
            error: function (result) {
                console.log(result);
            }
 
        });
    }

    function dataBound() {
      //  this.expandRow(this.tbody.find("tr.k-master-row").first());
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {

            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Rejected")
            {

                $(this).css("background-color", "#F75D59");


            }
            if (dataItem.Status == "Closed") {

                $(this).addClass("k-state-FleetApproved");
            }
                if (dataItem.Progress < 30) {
                    $(this).find(".progress" + dataItem.Num).kendoProgressBar({
                        value: dataItem.Progress , text : dataItem.Progress +" %" , css: {
                            "background-color": "#EE9F05",
                            "border-color": "#EE9F05"
                        }
                    });
                }
                if (dataItem.Progress > 30 && dataItem.Progress < 70) {
                    $(this).find(".progress" + dataItem.Num).kendoProgressBar({
                        value: dataItem.Progress , text : dataItem.Progress +" %" , css: {
                            "background-color": "#428bca",
                            "border-color": "#428bca"
                        }
                    });
                }
                if ( dataItem.Progress > 70) {

                    $(this).find(".progress" + dataItem.Num + dataItem.Num).kendoProgressBar({
                        value: dataItem.Progress , text : dataItem.Progress +" %" , css: {
                            "background-color": "#8EBC00",
                            "border-color": "#8EBC00"
                        }
                    });
            }

            $(this).find(".k-grid-edit").hide();
            $(this).find(".k-grid-delete").hide();
            $(this).find(".k-grid-cmd-reject-request").hide();
            $(this).find(".k-grid-cmd-open-request").hide();
            $(this).find(".k-grid-cmd-rework-request").hide();
            $(this).find(".k-grid-cmd-deliver-request").hide();
            if (dataItem.IsOnlineTransferred == true) {
                if (dataItem.Status == "Rejected") {

                    // $(this).find(".k-grid-edit").show();
                    //$(this).find(".k-grid-delete").show();
                    $(this).find(".k-grid-cmd-open-request").show();

                }
                else if (dataItem.Status == "Closed") {

                    $(this).find(".k-grid-cmd-rework-request").show();
                    $(this).find(".k-grid-cmd-deliver-request").show();

                }
                else if (dataItem.Status == "Delivered") {
                    $(this).find(".k-grid-cmd-rework-request").show();

                }

                else {
                  $(this).find(".k-grid-delete").show();
                    $(this).find(".k-grid-cmd-reject-request").show();

                }
            }

            else if (dataItem.Status =="Closed")
               {
                $(this).find(".k-grid-cmd-rework-request").show();
                $(this).find(".k-grid-cmd-deliver-request").show();
            }
            else if (dataItem.Status == "Delivered")
            {
                $(this).find(".k-grid-cmd-rework-request").show();
            }

            if (dataItem.IsSubmittedToServiceCenter && !dataItem.IsSecondOnlineApproved) {
                $(this).find(".k-grid-cmd-reject-request").show();
                $(this).find(".k-grid-delete").show();

            }
            else {
                $(this).find(".k-grid-cmd-reject-request").hide();
                $(this).find(".k-grid-delete").hide();

            }


        });
    }

    function approveonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsOnlineApproved == true) {
                console.log(true);
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-cmd-open-request").hide();

            }
            if (dataItem.Status == 1) {
                console.log(false);

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-cmd-open-request").hide();
            }
            if (dataItem.Status == 0) {
                console.log(false);

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-cmd-open-request").hide();
            }



        });
    }
