

<div>
    @(Html.Kendo().DropDownListFor(model => model)
          .DataTextField("Name")
          .DataValueField("Code")
          .OptionLabel(" Select ")
          .Filter(FilterType.Contains)
                    .CascadeFrom("ServiceGroup")
                  .DataSource(d => d.Read(r => r.Action("GetServices", "MaintenanceDataProvider")
                  .Data("filterServices"))
                  .ServerFiltering(true)))
                  @*.DataSource(d => d.Read(r => r.Action("ServiceDDBind", "InspectionRegistration").Data("filterSerivce")).ServerFiltering(false)))*@
</div>
