@model ExceedERP.Core.Domain.Maintenance.JobOrder



<div class="demo-section k-content">
    <form>

        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.ProjectName)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.ProjectName)
                        @Html.ValidationMessageFor(model => model.ProjectName)
                    </div>

                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @(Html.LabelFor(model => model.EquipmentInformationId))
                        @*@(Html.Kendo().DropDownListFor(model => model.FleetsID).Name("FleetsID")
                                      .DataTextField("PlateNumber")
                                      .DataValueField("FleetsID").OptionLabel(" Select Equipment")
                                      .DataSource(d => d.Read(r => r.Action("FleetsDDBind", "EquipmentRegistration").Data("sendForgery"))))*@
                    </div>
                    <div>
                        @(Html.Kendo().DropDownListFor(model => model.EquipmentInformationId)
                                                    .Name("EquipmentInformationId")
                                                    .DataTextField("LicensePlate")
                                                    .DataValueField("EquipmentInformationId")
                                                    .OptionLabel(" Select ")
                                                    .Filter(FilterType.Contains)
                                                    .DataSource(d => d.Read(r =>
                                                        r.Action("GetEquipmentInformation", "EquipmentInformation"))
                                                        .ServerFiltering(false))
                                //.Events(ev => ev.Change("BindFleetDetail"))
                        )
                    </div>

                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-md-1">
            </div>

            <div class="col-md-9">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.InspectorComments)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.InspectorComments).HtmlAttributes(new { @class = "form-control" }).Name("InspectorComments").HtmlAttributes(new { style = "width:100%" })
                        @Html.ValidationMessageFor(model => model.InspectorComments)
                    </div>

                </div>
            </div>
        </div>
    </form>

</div>



