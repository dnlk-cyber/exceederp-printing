<h4> Vehicle Reception Form </h4>
@using ExceedERP.DataAccess.Context
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var checkIsECWC = (string)ViewData["ECWCSetting"];
    bool isECWC = (checkIsECWC == "ECWC");

}

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Maintenance.VehicleReceptionForm>()
              .Name("grid")
              .Columns(columns =>
              {
                  columns.Bound(x => x.Source);
                  //columns.Bound(x => x.IsSendForApproval).Hidden().Width(90);
                  columns.ForeignKey(e => e.CustomerId, (IEnumerable)ViewData["Customer"], "OrganizationCustomerID", "TradeName").Filterable(ft => ft.Search(true)).Width(150);
                  columns.ForeignKey(e => e.TechnicianAssignedId, (IEnumerable)ViewData["Employee"], "Code", "Name").Title("Inspector").Width(150);
                  columns.ForeignKey(c => c.VehicleCategoryId, (IEnumerable)ViewData["category"], "Id", "Name").Title("Category").Width(120);
                  columns.Bound(c => c.DateCreated).Title("Date").Format("{0:yyyy-MM-dd}").Width(80);
                  columns.Bound(c => c.PlateNo).Width(80);
                  columns.Bound(c => c.VehicleType).Width(80);
                  columns.Bound(c => c.VehicleModel).Title("Vehicle Model").Width(80);
                  columns.Bound(c => c.Mileage).Width(100);
                  columns.Bound(c => c.Fuel).Width(100);
                  columns.Bound(c => c.DateCreated).Width(100);
                  columns.Bound(c => c.ReferenceNumber).Width(150);
                  columns.Bound(c => c.Remark).Width(150);
                  columns.Bound(c => c.IsOnlineApproved).Width(150);
                  columns.Command(command => { command.Edit(); command.Destroy(); }).Width(200);

              })
            .ToolBar(toolbar =>
            {
                toolbar.Create();
    //toolbar.Excel();
})
            // .Events(ev=>ev.DataBound("dataBound"))

            .Scrollable(s => s.Height(600))
            .Sortable()
            .Filterable()
            .Editable(editable => editable.Mode(GridEditMode.PopUp)
            .Window(w => w.Width(600).Title("Vehicle Reception Form"))
            .TemplateName("VehicleReceptionForm"))
            .Events(ev => ev.DataBound("ReceptionDataBound"))
            .Events(ev => ev.DetailExpand("detailExpand"))
            .Pageable(pageable => pageable
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5))
            .DataSource(dataSource => dataSource
            .Ajax()
            .Events(ev => ev.Error("error_handler(\"grid\")")
            .RequestStart("onRequestStart(\"grid\")")
            .RequestEnd("onRequestEnd(\"grid\")"))

            .Model(model =>
            {
                model.Id(p => p.VehicleReceptionFormId);
    // model.Field(p => p.VehicleModel).Editable(false);
    //model.Field(p => p.ReferenceNumber).Editable(false);
})
            .Read(read => read.Action("VehicleReceptionForm_Read", "VehicleReceptionForm").Data("sendForgery"))
            .Create(create => create.Action("VehicleReceptionForm_Create", "VehicleReceptionForm").Data("sendForgery"))
            .Update(update => update.Action("VehicleReceptionForm_Update", "VehicleReceptionForm").Data("sendForgery"))
            .Destroy(destroy => destroy.Action("VehicleReceptionForm_Destroy", "VehicleReceptionForm").Data("sendForgery"))
            .Sort(sort =>
            {
                sort.Add(m => m.VehicleReceptionFormId).Descending();
            }).PageSize(10))
            .ClientDetailTemplateId("detailTemplate"))


