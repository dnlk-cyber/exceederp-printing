<h4> Vehicle Reception Form </h4>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Maintenance.VehicleReceptionForm>()
              .Name("grid")
              .Columns(columns =>
              {
                  columns.Bound(x=>x.Source);
                  columns.ForeignKey(e => e.CustomerId, (IEnumerable)ViewData["Customer"], "OrganizationCustomerID", "TradeName").Width(150);
                  columns.ForeignKey(e => e.TechnicianAssignedId, (IEnumerable)ViewData["Employee"], "Code", "Name").Width(150);
                  columns.ForeignKey(c => c.VehicleCategoryId, (IEnumerable)ViewData["category"], "Id", "Name").Title("Category").Width(120);
                  columns.Bound(c => c.DateCreated).Title("Date").Format("{0:yyyy-MM-dd}").Width(80);
                  columns.Bound(c => c.PlateNo).Width(80);
                  columns.Bound(c => c.VehicleType).Width(80);
                  columns.Bound(c => c.VehicleModel).Width(80);
                  columns.Bound(c => c.Mileage).Width(100);
                  columns.Bound(c => c.Fuel).Width(100);
                  columns.Bound(c => c.Remark).Width(150);

                  columns.Command(command => { command.Edit(); command.Destroy(); }).Width(200);

              })
            .ToolBar(toolbar =>
            {
                toolbar.Create();
                //toolbar.Excel();
            })
            .Events(ev=>ev.DataBound("dataBound"))
            .Scrollable(s => s.Height(600))
            .Sortable()
            .Filterable()
            .Editable(editable => editable.Mode(GridEditMode.PopUp)
            .Window(w => w.Width(600).Title("Vehicle Reception Form"))
            .TemplateName("VehicleReceptionForm"))
            .Pageable(pageable => pageable
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5))
            .DataSource(dataSource => dataSource
            .Ajax()
            .Events(ev => ev.Error("error_handler(\"grid\")")
            .RequestStart("onRequestStart(\"grid\")")
            .RequestEnd("onRequestEnd(\"grid\")"))
            .ServerOperation(false)
            .Model(model =>
            {
                model.Id(p => p.VehicleReceptionFormId);
                model.Field(p => p.VehicleModel).Editable(false);
                model.Field(p => p.VehicleType).Editable(false);
            })
            .Read(read => read.Action("VehicleReceptionForm_Read", "VehicleReceptionForm"))
            .Create(create => create.Action("VehicleReceptionForm_Create", "VehicleReceptionForm"))
            .Update(update => update.Action("VehicleReceptionForm_Update", "VehicleReceptionForm"))
            .Destroy(destroy => destroy.Action("VehicleReceptionForm_Destroy", "VehicleReceptionForm"))
            .Sort(sort =>
            {
                sort.Add(m => m.VehicleReceptionFormId).Descending();
            }).PageSize(10))
            .ClientDetailTemplateId("detailTemplate"))


<script id="detailTemplate" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()

               .Name("tabStrip_#=VehicleReceptionFormId#")
               .SelectedIndex(0)
               .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
               .Items(items =>
               {
                   items.Add().Text("Vehicle Part Management").Content(@<text>
                     <a href='@Url.Action("Print", "VehicleReceptionForm")/#=VehicleReceptionFormId#' title="Print"><i class="fa fa-print  fa-2x"></i></a>
                     @(Html.Kendo().Grid<ExceedERP.Core.Domain.Maintenance.VehiclePartManagement>()
                     .Name("vehicle_part_management_#=VehicleReceptionFormId#")
                     .Columns(columns =>
                     {
                         columns.ForeignKey(e => e.VehiclePartId, (IEnumerable)ViewData["VehicleParts"], "VehiclePartId", "Name")
                         .Title("Vehicle Part").Width(150);
                         columns.Bound(c => c.Quantity);
                         columns.ForeignKey(e => e.VehiclePartDamageTypeId, (IEnumerable)ViewData["VehiclePartDamageType"], "VehiclePartDamageTypeId", "Code_Name")
                         .EditorTemplateName("VehiclePartDamageTypeMapping")
                         .Title("Vehicle Part Damage Type").Width(150);
                         columns.Bound(c => c.Remark);

                     })
                   .ToolBar(toolbar =>
                   {
                       toolbar.Save();
                   })

                   .Scrollable(s => s.Height(600))
                   .Sortable()
                   .Filterable()
                   .Editable(editable => editable.Mode(GridEditMode.InCell))
                   .Pageable(pageable => pageable
                   .Refresh(true)
                   .PageSizes(true)
                   .ButtonCount(5))
                   .DataSource(dataSource => dataSource
                   .Ajax()
                   .Batch(true)

                   .Events(ev => ev.Error("error_handler(\"vehicle_part_management_#=VehicleReceptionFormId#\")")
                   .RequestStart("onRequestStart(\"vehicle_part_management_#=VehicleReceptionFormId#\")")
                   .RequestEnd("onRequestEnd(\"vehicle_part_management_#=VehicleReceptionFormId#\")"))
                   .ServerOperation(false)
                   .Model(model => model.Id(p => p.VehiclePartManagementId))
                   .Read(read => read.Action("VehiclePartManagement_Read", "VehiclePartManagement", new { id = "#=VehicleReceptionFormId #" }))
                   .Create(create => create.Action("VehiclePartManagement_Create", "VehiclePartManagement", new { id = "#=VehicleReceptionFormId #" }))
                   .Update(update => update.Action("VehiclePartManagement_Update", "VehiclePartManagement"))
                   .Destroy(destroy => destroy.Action("VehiclePartManagement_Destroy", "VehiclePartManagement"))
                   .Sort(sort =>
                   {
                       sort.Add(m => m.VehicleReceptionFormId).Descending();
                   }).PageSize(10))
                   .ToClientTemplate()
                       )
                   </text>);
                       }).ToClientTemplate())


</script>

<script>
    function SourceSelectorChanged(e) {
        var dd = $("#Source").data("kendoDropDownList");
        if (dd) {
            var selectedValue = dd.value();
           // alert("selected Value : " + selectedValue);
            if (selectedValue == 1) {
                $("#CustomerId").data("kendoDropDownList").enable(false);
                $("#CustomerId").val(null);
            } else if (selectedValue == 0) {
                $("#CustomerId").data("kendoDropDownList").enable(true);
            }
        }
    }
    function dataBound() {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
        function filterPlateNos() {
            return {
                customerId: $("#CustomerId").val(),
                text: $("#PlateNo").data("kendoDropDownList").filterInput.val(),
                source: $("#Source").val(),

            };

    } 
    function filterCategories() {
        return {
            text: $("#VehicleCategoryId").data("kendoDropDownList").filterInput.val(),
            //search: $("#VehicleCategoryId").val()
        };
    }
    function getModelType() {
        var plateNo = $("#PlateNo").val()
        console.log(plateNo);
         $.ajax({
                type: 'GET',
             url: '@Url.Action("GetEquipmentModel", "MaintenanceDataProvider")',
             data: {
                 plateNo: plateNo,

             },
                 async: false,
             success: function (result) {
                 data = result;
                 $("#VehicleType").val(data.GroupName).trigger("change");
                 $("#VehicleModel").val(data.DeviceNumber).trigger("change");


                 
            }
            });
    }
    //function getModel() {
    //    $("#VehicelType").val(data.GroupName).trigger("change");
    //    $("#VehicelModel").val(data.DeviceNumber).trigger("change");
    //}
</script>
