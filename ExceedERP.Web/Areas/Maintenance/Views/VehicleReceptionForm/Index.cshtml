}

<script>
    var CheckIfIsRequest = false; // GLOBAL scope

    function ReceptionDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            var isApproved = dataItem.IsSendForApproval === true || dataItem.IsSendForApproval === "true";
            CheckIfIsRequest = dataItem.IsSendForApproval;
            if (isApproved) {
                $(this).find(".k-grid-edit").remove();   // lowercase
                $(this).find(".k-grid-delete").remove(); // lowercase
                CheckIfIsRequest = true;
            }
        });
    }
    var codeid;
    var isApproved = false;
    var isMasterSendForApproval = false;
    var isMasterApproved = false;
    function detailExpand(e) {
        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.VehicleReceptionFormId;
        if (masterDataItem.IsOnlineApproved==true) {
            isApproved = true;
            isMasterApproved = true;
        }
