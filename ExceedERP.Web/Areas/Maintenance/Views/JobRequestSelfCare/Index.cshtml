<script>
    var Status;
    var iii = false;

    function approveJobRequest(e) {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        if (iii) {
            return 0;
        }
        iii = true;

        $.ajax({
            type: "POST",
            url: '@Url.Action("ApproveJobRequest", "JobRequestSelfCare", new { area = "Maintenance" })',
            data: { id: masterId },
            success: function (result) {
                console.log(result.Message);
                //alert(result.Message);
               location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }
    function rejectJobRequest(e) {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        $.ajax({
            type: "POST",
            url: '@Url.Action("RejectJobRequest", "JobRequest", new { area = "Maintenance" })',
            data: { id: masterId },
            success: function (result) {
                console.log(result.Message);
                //alert(result.Message);
                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }
    function dataBound() {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());
        var grid = this;


        grid.tbody.find("tr[role='row']").each(function () {
            var masterDataItem = grid.dataItem(this);

            isapproved = masterDataItem.IsOnlineApproved;
            isSendForApproval = masterDataItem.IsSendForApproval;

            issecondapproved = masterDataItem.IsSecondOnlineApproved;
            Status = masterDataItem.Status;
            if (masterDataItem.IsOnlineApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
            if (masterDataItem.IsSendForApproval == true) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            if (masterDataItem.Status == "Approve") {
                $(this).find(".k-grid-cmd-void-request").show();

            }
            else {
                $(this).find(".k-grid-cmd-void-request").hide();

            }
        });


    }


</script>


<script type="text/javascript">

    function sendForApproval(id) {
       var recordStatus = "";

       $.ajax({
           type: "POST",
           url: '@Url.Action("SendForOnlineApproval", "JobRequest", new { area = "Maintenance" })',
           data: { id: id },
           success: function(result) {
                alert(result);
                location.reload(true);
           },
           error: function(result) {
               alert(result);
           }
       });
   }
    function BindFleetDetail() {

        var Fleetsobj = $("#FleetsID").data("kendoDropDownList");
        var fleetID = Fleetsobj.value();
        $.ajax({
            url: '@Url.Action("FleetsJobRequestDDBind", "EquipmentRegistration")',
            data: { Id: fleetID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r != 0) {
                    var s = r.split(/_/);
                    $("#Odometer").val(s[3]);
                    $("#AssetNum").val(s[4]);
                    $("#Model").val(s[5]);
                    $("#EquipmentType").val(s[8]);
                    $("#OperatorName").val(s[7]);
                    $("#ProjectName").val(s[6]);
                    $("#EquipmentName").val(s[9]);

                } else {
                    $("#EquipmentName").val("");
                    $("#Odometer").val("");
                    $("#AssetNum").val("");
                    $("#Model").val("");
                    $("#EquipmentType").val("");
                    $("#OperatorName").val("");
                    $("#ProjectName").val("");

                }
            }

        });

    }

</script>


<script type="text/javascript">
    var IsApproved;
    var IsSendForApproval;
    var HeaderStat;
    function filterPlateNos() {
        return {
            CustomerId: $("#CustomerId").val()
        };
    }
   function voidJobRequest()
            {
          $.ajax({
           type: "POST",
           url: '@Url.Action("VoidJobRequest", "JobRequest", new { area = "Maintenance" })',
              data: { id: masterId },
           success: function(result) {
                alert(result);
                location.reload(true);
           },
           error: function(result) {
               alert(result);
           }
       });
          }

    var expandedRow;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        IsApproved = masterDataItem.IsOnlineApproved;
        IsSendForApproval = masterDataItem.IsSendForApproval;
        masterId = masterDataItem.JobRequestId;

        var linegridName = "#JobCauses_" + masterId;
        var firstValidationgridName = "#JobServicegrid_" + masterId;
        var SecondValidationgridName = "#JobOrderAdmingrid_" + masterId;

                if (masterDataItem.IsSendForApproval == true) {

                      $(".k-grid-top", linegridName).hide();
                    $(".k-grid-edit", linegridName).hide();
                    $(".k-grid-delete", linegridName).hide();

                    $(".k-grid-top", firstValidationgridName).hide();
                    $(".k-grid-edit", firstValidationgridName).hide();
                    $(".k-grid-delete", firstValidationgridName).hide();
                }
                if (masterDataItem.IsOnlineApproved == true) {


                    $(".k-grid-top", SecondValidationgridName).hide();
                    $(".k-grid-edit", SecondValidationgridName).hide();
                    $(".k-grid-delete", SecondValidationgridName).hide();
                }


        // Only one open at a time
        if (expandedRow != null && expandedRow[0] != e.masterRow[0]) {
            masterGrid.collapseRow(expandedRow);
        }
        expandedRow = e.masterRow;
    }
    function approveonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if ( IsApproved == true) {
                 $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            if (dataItem.Status == 0) {
                console.log(dataItem.Status );
                $(this).find(".k-grid-cmd-approve-request").hide();
                $(this).find(".k-grid-cmd-reject-request").hide();
            }
            else if (dataItem.Status == 1) {
                $(this).find(".k-grid-cmd-approve-request").hide();
                $(this).find(".k-grid-cmd-reject-request").hide();
            }
            else {
                $(this).find(".k-grid-cmd-approve-request").show();
                $(this).find(".k-grid-cmd-reject-request").show();
            }



        });
    }

    function lineonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (IsSendForApproval == true) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }



        });
    }
    function onJobRequestEdit(e) {
        var src = $("#Source").data("kendoDropDownList");

        if (src.value() == 0) {
            var dd = $("#LicensePlate").data("kendoDropDownList");

            if (dd) {
                $("#internalEquipmentLicensePlateContainer").show();
                $("#externalEquipmentLicensePlateContainer").show();
                $("#CustomerId").data("kendoDropDownList").enable(false);

            }
        }
    }
    function SourceSelectorDataBound(e) {
        var src = $("#Source").data("kendoDropDownList");
        if (src.value() == 1) {
            var dd = $("#LicensePlate").data("kendoDropDownList");
            console.log(dd);
            if (dd) {
              //  $("#internalEquipmentLicensePlateContainer").hide();
                $("#externalEquipmentLicensePlateContainer").show();
                $("#CustomerId").data("kendoDropDownList").enable(true);

                //$("#customerId").show();

            }
        }
    }
    function onCustomerSelect() {
        var dd = $("#CustomerId").data("kendoDropDownList");
        var license = $("#LicensePlate").data("kendoDropDownList");

        var customer = dd.value();
        console.log(customer);
        return $.getJSON("/EquipmentInformation/GetEquipmentInformation/" + customer,
            function (data) {
                $("#LicensePlate").kendoComboBox({
                    dataTextField: "LicensePlate",
                    dataValueField: "LicensePlate",
                    dataSource: data,

                })
            });
                  }
    function SourceSelectorChanged(e) {
        var dd = $("#Source").data("kendoComboBox");

        if (dd) {
            var selectedValue = dd.value();
            //alert("selected Value : " + selectedValue);
            if (selectedValue == 0) {

                // its internal equipment
                $("#internalEquipmentLicensePlateContainer").show();
                $("#externalEquipmentLicensePlateContainer").hide();
                $("#CustomerId").data("kendoDropDownList").enable(false);

                //$("#customerId").hide();
                $("#CustomerId").val(null);


            } else if (selectedValue == 1) {
                // external equipment
                //$("#internalEquipmentLicensePlateContainer").hide();
                $("#externalEquipmentLicensePlateContainer").show();
                $("#CustomerId").data("kendoDropDownList").enable(true);

               // $("#customerId").show();

            }
        }
    }

    function handlePlateNoChange() {
        var pId = $("#LicensePlate").data("kendoDropDownList").value();
        $.ajax({
            type: "GET",
            url: "@Url.Action("EquipmentNameReturn", "JobRequest")",
            dataType: "json",
            data: { plateNo: pId },
            success: function (result) {
                console.log(result);


                $('#EquipmentName').val(result.EquipmentName).trigger("change");
            },
            error: function (result) {
                console.log(result);
            }

        });
    }
    function filterEmployees() {
        return {
            text: $("#RequesterId").data("kendoDropDownList").filterInput.val(),
        }
    }
    function handlePlaeteNoSerialNoSearch() {
        return {
            
            text: $("#LicensePlate").data("kendoDropDownList").filterInput.val(),
        }
    }

    
    function handleJobRequestSource() {
        return {
            source: $("#Source").val(),
            text: $("#LicensePlate").data("kendoDropDownList").filterInput.val(),
        }
    }
</script>



