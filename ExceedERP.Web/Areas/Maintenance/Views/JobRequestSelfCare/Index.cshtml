
@using System.Collections
@using ExceedERP.Core.Domain.Maintenance;
@using ExceedERP.Helpers.Common;
@{
    bool userCanEdit;

    if (HttpContext.Current.User.IsInRole(MaintenanceRoles.MaintenanceRequestVoider))
    {
        userCanEdit = true;

    }
    else
    {
        userCanEdit = false;
    }
}

<legend> Maintenance Request</legend>
@(Html.Kendo().Grid<JobRequest>()
        .Name("grid")
            .Columns(columns =>
            {
                columns.Bound(e => e.Num).Title("#").Width(80);
                columns.Bound(e => e.IsPM).Width(100).ClientTemplate("<input type='checkbox' disabled = 'true' #: IsPM? checked='checked': checked='' #/>");
                columns.Bound(e => e.Source).Width(90);

                columns.Bound(e => e.LicensePlate).Width(120);
                columns.Bound(e => e.EquipmentName).Width(120);
                columns.ForeignKey(e => e.MaintenanceCenterId, (IEnumerable)ViewData["MaintenanceCenter"], "Id", "Name").Width(130);
                columns.ForeignKey(e => e.CustomerId, (IEnumerable)ViewData["Customer"], "OrganizationCustomerID", "TradeName").Width(200);

                columns.ForeignKey(e => e.RequesterId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Width(200);
                if (GlobalHelper.IsMultipleBusinessUnit())
                {
                    columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["BusinessUnits"], "BusinessUnitId", "Name").Width(180).EditorTemplateName("BusinessUnitSelector");
                }
                columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").Width(180).EditorTemplateName("AllBranchSelector");
                columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["Structure"], "OrgStructureId", "Name").Title("Work Unit").Width(160).EditorTemplateName("WorkUnitCostCenterSelector");
                
                columns.Bound(e => e.DateCreated).Title("Date Created").Format("{0:yyyy-MM-dd}").Width(100);
                columns.Bound(e => e.OnlineApprovedTime).Title("Date Approved").Format("{0:yyyy-MM-dd}").Width(100);
                columns.Bound(e => e.Status).Width(100);

                columns.Bound(e => e.LicensePlate).Visible(false);
                columns.Command(command =>
                {
                    command.Edit();
                    command.Destroy();
                    if (userCanEdit)
                    {
                        command.Custom("cmd-void-request").Text("&nbsp;Void").Click("voidJobRequest").IconClass("fa fa-remove");
                    }
                }).Width(200);

            })
        .ToolBar(commands =>
        {
            commands.Create(); //commands.Excel();
                               //commands.Pdf();
        }).Editable(editable =>
        {
        editable.Window(w => w.Title("Customer Request"));
        editable.Mode(GridEditMode.PopUp).TemplateName("CommonJobRequestEditorTemplate");
        editable.DisplayDeleteConfirmation("Are You Sure to Delete Job Request? ");
        })
        .HtmlAttributes(new { style = "height: 520px;" })

        .Pageable(pageable => pageable
                .Input(true)
                .Numeric(false)
                .Refresh(true)
                .PageSizes(true)
                .ButtonCount(5))
        .Scrollable()
        .Sortable()
        .Filterable()
        .Scrollable(h => h.Height(500))
        .ClientDetailTemplateId("template")
        .Events(ev =>
        {
            ev.DetailExpand("onDetailExpandUser");
            ev.Edit("onJobRequestEdit");
            ev.DataBound("dataBound");
        })
        .DataSource(dataSource => dataSource
                .Ajax()
                .ServerOperation(false)
                .Sort(x => x.Add(s => s.Num).Descending())
                //.Group(g=>g.Add(c=>c.Source))
                .PageSize(20)
                .Model(model =>
                {
                    model.Id(p => p.JobRequestId);
                    model.Field(p => p.JobRequestId).Editable(false);
                    model.Field(p => p.RequestNumber).Editable(false);
                    model.Field(p => p.BranchId).Editable(false);
                    model.Field(p => p.BusinessUnitId).Editable(false);
                    model.Field(p => p.OrgStructureId).Editable(false);
                })
                .Events(ev => ev
                    .Error("error_handler(\"grid\")")
                    .RequestStart("onRequestStart(\"grid\")")
                    .RequestEnd("onRequestEnd(\"grid\")"))
                .Create(update => update.Action("JobRequest_Create", "JobRequest"))
                .Read(read => read.Action("JobRequest_Read", "JobRequest"))
                .Update(update => update.Action("JobRequest_Update", "JobRequest"))
                .Destroy(d => d.Action("JobRequest_Destroy", "JobRequest"))
            )
    //.Events(events => events.DataBound("dataBound"))
)
