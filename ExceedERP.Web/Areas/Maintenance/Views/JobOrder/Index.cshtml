<script type="text/javascript">
var Referance;
var IsPm;
var masterId;
    var IsOnlineApproved=false;
    var IsMasterOnlineApproved=false;
    var IsMasterFirstOnlineApproved=false;
    var IsMasterSendForApproval=false;
var maintenanceCenterId;
function onDetailExpandUser(e) {
var masterRow = e.masterRow;
var masterGrid = $("#grid").data("kendoGrid");
var masterDataItem = masterGrid.dataItem(masterRow);
    IsOnlineApproved = masterDataItem.IsOnlineApproved;
    IsMasterOnlineApproved = masterDataItem.IsSecondOnlineApproved;
    IsMasterFirstOnlineApproved = masterDataItem.IsOnlineApproved;
    IsMasterSendForApproval = masterDataItem.IsSendForApproval;
    
maintenanceCenterId = masterDataItem.MaintenanceCenterId;
Referance = masterDataItem.Referance;
IsPm = masterDataItem.IsPM;
var Id = masterDataItem.JobOrderID;
masterId = masterDataItem.JobOrderID;
var JobServicegrid = "#JobServicegrid_" + Id;
var Technicalgrid = "#Technicalgrid_" + Id;


$.ajax({
url: '@Url.Action("JobOrderExtra_Read", "JobOrder")',

data: { Id: Id  },
type: 'GET',
cache: false,
success: function (list) {
for (var i = 0 ; i < list.length; i++) {

$("#CostChart" + Id).kendoChart({
title: {
text: " Cost Information Summary "
},
legend: {
position: "right"
}, theme: "material",
seriesDefaults: {
labels: {
template: " ",
position: "outsideEnd",
visible: true,
background: "transparent"
}
},
series: [{
type: "pie",
data: [{
category: "Spare Part & Material",
value: list[i].SpareCost
},
{
category: "Labour",
value: list[i].LabourCost
}]
}],
tooltip: {
visible: true,
template: "#= category # - #= kendo.format('{0:P}', percentage) #"
}
});



$("#EfficencyGauge" + Id).kendoRadialGauge({

pointer: {
value: kendo.toString(list[i].Efficiency, 'N2')
},
theme: "bootstrap",
scale: {
minorUnit: 5,
startAngle: -30,
endAngle: 210,
max: 100,
labels: {
position:  "inside"
},
ranges: [
{
from: 0,
to: 30,
color: "#ffc700"
}, {
from: 30,
to: 60,
color: "#ff7a00"
}, {
from: 60,
to: 100,
color: "#c20000"
}
]
}
});

