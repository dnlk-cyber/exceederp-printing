
@{
    ViewBag.Title = "Mechanic Crew";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend> Mechanic Crew </legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Maintenance.MechanicCrew>()
        .Name("grid")
        .Columns(columns =>
        {
            columns.ForeignKey(e => e.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).EditorTemplateName("MechanicSelector").Width(150);
            columns.ForeignKey(e => e.MaintenanceCenterId, (IEnumerable)ViewData["MaintenanceCenter"], "Value", "Text").Filterable(ftb => ftb.Multi(true).Search(true)).EditorTemplateName("MaintenanceCenterSelector").Width(150);
            columns.ForeignKey(e => e.ServiceCenterId, (IEnumerable)ViewData["ServiceCenters"], "Value", "Text").Filterable(ftb => ftb.Multi(true).Search(true)).EditorTemplateName("ServiceCenterSelector").Width(150);
            columns.Bound(e => e.MechanicType).EditorTemplateName("MechanicTypeMapping").Width(120);
            columns.Bound(e => e.HourlyWage).Width(120);
            columns.Bound(e => e.Status).Title("Status").Width(120);
            columns.Command(command => { command.Edit(); /*command.Destroy();*/
                command.Custom("ToggleCrew").Text("Toggle").IconClass("fa fa-thumbs-o-up").HtmlAttributes(new { @class = "approve", title = "Toggle" }).Click("ToggleMechanics");
            }).Width(250);
        })
         //.ToolBar(commands => commands.Create())
         .ToolBar(toolbar =>
         {

         toolbar.Template(@<text>
                    <div class="toolbar row">
                        <div class="col-md-3">
                            <a class="k-button k-button-icontext k-grid-add" href='\#'><span class="k-icon k-i-add"></span> Add new record</a>

                            @(Html.Kendo().Button()
                                         .Name("btnRefreashMechanic")
                                         .HtmlAttributes(new { type = "search", @class = "k-primary" })
                                         .Events(e => e.Click("refreshMechanicCrew"))
                                         .Content("Refresh Mechanic"))
                        </div>

                    </div>

                </text>);
                    })

               .Editable(editable =>
               {
                   editable.Mode(GridEditMode.InLine);
                   editable.DisplayDeleteConfirmation("Are You Sure To Remove Mechanic Crew");
               })
                  .HtmlAttributes(new { style = "height: 520px;" })
                                    .Pageable(pageable => pageable
                                                      .Input(true)
                                                      .Numeric(false)
                                                      .Refresh(true)
                                                      .PageSizes(true)
                                                      .ButtonCount(5))

                                          .Scrollable()
                                          .Sortable()
                                          .Filterable()
                                          
                                          .Scrollable(h => h.Height(500))
              .DataSource(dataSource => dataSource
                  .Ajax()
                 
                         .Model(model =>
                         {
                             model.Id(p => p.MechanicCrewID);
                             model.Field(f => f.HourlyWage).Editable(false);
                             model.Field(f => f.SectionId).DefaultValue(Guid.Empty);

                         }).Events(ev => ev
                          .Error("error_handler(\"grid\")")
                          .RequestStart("onRequestStart(\"grid\")")
                          .RequestEnd("onRequestEnd(\"grid\")"))
                          .Create(update => update.Action("MechanicCrew_Create", "MechanicCrew").Data("sendForgery"))
                          .Read(read => read.Action("MechanicCrew_Read", "MechanicCrew").Data("sendForgery"))
                          .Update(update => update.Action("MechanicCrew_Update", "MechanicCrew").Data("sendForgery"))
                          .Destroy(update => update.Action("MechanicCrew_Destroy", "MechanicCrew").Data("sendForgery"))
            )
)

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>

<script>
    function refreshMechanicCrew() {
        
        $.ajax(
            {
                type: "POST",
                url: '@Url.Action("RefreshMechanic", "MechanicCrew")',
                success: function (result) {
                    alert(result);
                } });
    }
    function GetJobTitle() {
        var Operator = $("#EmployeeId").data("kendoDropDownList").value();
        $.ajax({
            type: "GET",
            data: { Emp: Operator },
            url: '@Url.Action("GetPlacmentCategory", "FleetDataProvider")',
            success: function (result) {

                $("#JobTitle").val(result);
            }
        });


        $.ajax({
            type: "GET",
            data: { Emp: Operator },
            url: '@Url.Action("GetSuperVisor", "FleetDataProvider")',
            success: function (result) {
                if (result != "") {
                    $("#SupervisorName").val(result);
                    $("#SupervisorName").text(result);
                    $("#SupervisorName").focus();
                }
                else {
                    $("#SupervisorName").val("Not Assigned");
                    $("#SupervisorName").focus();
                }

            }
        });
    }
     function ToggleMechanics(e) {
        if (confirm("Are you sure you want to change status?")) {
            var grid = this;
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
            $.ajax({
                type: "POST",
                url: '@Url.Action("TogleCrew", "MechanicCrew", new { Area = "Maintenance" })',
                data: { id: dataItem.MechanicCrewID},
                success: function (result) {
                    if (result.Success) {
                        toastr.success(result.Message)
                        $("#grid").data("kendoGrid").dataSource.read();
                    }
                    else {
                        toastr.error(result.Message)
                    }
                },
                error: function (result) {
                    alert(result)
                }
            });
        }
    }
    function filterEmployees() {
        return {
            text: $("#EmployeeId").data("kendoDropDownList").filterInput.val(),
        }

        
    }
    function FilterServices() {
        return {
            MaintenanceCenter: $("#MaintenanceCenterId").val()
        }
    }
</script>