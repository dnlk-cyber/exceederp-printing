@(Html.Kendo().DropDownListFor(m => m)
                      .AutoBind(false)
                      .OptionLabel("--Select Employees--")
                      .DataTextField("FullNameaEnglish")
                      .DataValueField("EmployeeId")
                        .Filter("contains")
                            .ValuePrimitive(true)
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetActiveEmployeesFromGroup", "InfoDeskDataProvider", new { area = "InfoDesk" }).Data("sendForgery").Data("filterEmployee"))
                                    .ServerFiltering(false);
                      })

)
@Html.ValidationMessageFor(m => m)