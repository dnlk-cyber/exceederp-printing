@using ExceedERP.Core.Domain.InfoDesk
<legend>Ticket Types</legend>
@(Html.Kendo().Grid<TicketType_HelpDesk>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Type).Width(150);
          columns.Bound(c => c.TicketCode).Width(150);
          columns.Bound(c => c.TicketCategory).Width(150);
          columns.Bound(c => c.TicketPriority).Width(150);
          columns.Bound(c => c.EstimatedCost).Width(160);
          columns.Bound(c => c.DueDays).Width(150);
          columns.Bound(c => c.Description).Width(150);
          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          }).Width(200);
      })
      .ToolBar(toolbar => {
          toolbar.Create();
      })
          .HtmlAttributes(new { style = "height: 520px;" })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
       .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))
                        .Sortable(sortable => {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
      .Filterable()
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => { model.Id(p => p.TicketType_HelpDeskId);
              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
              model.Field(p => p.LastModified).Editable(false);

          })
          .Read(read => read.Action("TicketTypes_Read", "TicketType").Data("sendForgery"))
          .Create(create => create.Action("TicketTypes_Create", "TicketType").Data("sendForgery"))
          .Update(update => update.Action("TicketTypes_Update", "TicketType").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("TicketTypes_Destroy", "TicketType").Data("sendForgery"))
      )
)
