<script>
    function FilterTicket(e) {
        event.preventDefault();
        var Status = $("#Status").data("kendoDropDownList").value();
        var grid = $('#grid').data('kendoGrid');


        if (Status != "") {
            grid.dataSource.filter({ field: "Status", operator: "eq", value: Status });
        } else {
            grid.dataSource.filter({});
        }
    }

    function FilterBySpecTicket(e) {
        event.preventDefault();
        var SpecificTicketTypeId = $("#SpecificTicketTypeId").data("kendoDropDownList").value();
        var grid = $('#grid').data('kendoGrid');


        if (SpecificTicketTypeId != 0) {
            grid.dataSource.filter({ field: "Specific Ticket Type", operator: "eq", value: SpecificTicketTypeId });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>