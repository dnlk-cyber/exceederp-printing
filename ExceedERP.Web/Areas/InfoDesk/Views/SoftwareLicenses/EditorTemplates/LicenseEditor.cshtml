                @Html.ValidationMessageFor(model => model.LicenseStatus, "", new { @class = "text-danger" })

            </div>
        </div>
    </div>

    <div class="col-sm-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.UsageLimitations, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>
                    @(Html.TextAreaFor(m => m.UsageLimitations, new { @class = "textarea-class" }))
                    @Html.ValidationMessageFor(model => model.UsageLimitations, "", new { @class = "text-danger" })

                </div>
            </div>
        </div>

</div>
<div class="row my-class">
    <div class="col-sm-2">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.SupportContact, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div>
