<style>
    div.k-edit-form-container {
        width: auto;
    }

    .row .col-sm-3 {
        width: 200px;
    }

    .row .col-sm-2 {
        width: 200px;
    }

    .my-class {
        margin-left: 30px;
    }

    .chkbx {
        pointer-events: none;
    }



    .kendo-textbox {
        width: 200px;
        height: 50px;
    }

    .textarea-class {
        width: 200px;
        height: 50px;
    }
</style>
<script>
    function onDataBound(e) {
        var grid = this;
        var Checkgrid = $("#grid").data("kendoGrid");
        var gridData = Checkgrid.dataSource.view();
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.LicenseStatus == "0" ) {
                $(this).css("background-color", "deepskyblue");

            }
            if (dataItem.LicenseStatus == "1") {
                $(this).css("background-color", "lightgray");
            }
            if (dataItem.LicenseStatus == "2") {
                $(this).css("background-color", "limegreen");
            }
            if (dataItem.LicenseStatus == "3") {
                $(this).css("background-color", "powderblue");
            }

            if (dataItem.LicenseStatus == "4") {
                $(this).css("background-color", "olive");
                $(this).find(".k-grid-close").remove();

            }
            if (dataItem.LicenseStatus == "5") {
                $(this).css("background-color", "lightpink");
                $(this).find(".k-grid-close").remove();

            }

        });
    }

</script>