<script>

     function AssignTicket(id) {

         if (confirm('Are you sure you want to finish assigning')) {
             $.ajax({
                 url: '@Url.Action("Assign", "AssignTicket")',

                 data: { id: id },
                 type: 'POST',
                 cache: false,
                 success: function (result) {
                     r = result;

                     alert("Successfully Assigned");
                     // $("#Salary").val(r);
                 }

             });
         }

           
    }

</script>


<script>

     var CurtomerTicketId_Global = 0;

     function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        CurtomerTicketId_Global = masterDataItem.CustomerTicket_HelpDeskId;

        masterId = masterDataItem.CustomerTicket_HelpDeskId;

        var gridName = "#Assigngrid_" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatus", "AssignTicket")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", gridName).show();
                }

            }

        });

     }



    function ApproveSolved(e) {

        var masterId = CurtomerTicketId_Global;

        var row = $(e.target).closest("tr");
        var grid = $("#Assigngrid_" + masterId).data("kendoGrid");
        var dataItem = grid.dataItem(row);
       // var masterId = dataItem.CustomerTicket_HelpDeskId;
        var childId = dataItem.AssignTicket_HelpDeskId;

        if (confirm('Are you sure you want approve the solved issue')) {
            $.ajax({
                url: '@Url.Action("ApproveSolved", "AssignTicket")',

                data: { childId: childId },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    if (r === "true") {
                        alert("Successfully Approved");
                    }
                    else if (r === "false") {
                        alert("Already Approved before");
                    }
                    else if (r === "faild") {
                        alert("Faild to Approve");
                    }

                    //var grid = $("#EmployeePerformancegrid").data("kendoGrid");
                    var masterGrid = $("#grid").data("kendoGrid");
                    masterGrid.dataSource.read();
                }

            });
        }
    }
</script>



<script>


    function DetailDataBound(e) {
        var grid = this;

        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);

            var dataItem = grid.dataItem(row);

          
            if (dataItem.IsSendForClosing === true && dataItem.IsAssigned === true  && dataItem.IsSolved === false) {
              
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-solved").show();
                row.css("background-color", "yellow");

                //$(".k-grid-top", gridName).hide();

            }
            else if (dataItem.IsSendForClosing === false && dataItem.IsAssigned === true && dataItem.IsSolved === false) {

                row.find(".k-grid-edit").hide();
                 row.find(".k-grid-solved").hide();
               // row.css("background-color", "yellow");

                //$(".k-grid-top", gridName).hide();

            }
            else if (dataItem.IsSolved === true) {
                //answer.hide(true);
                //transfer.hide(true);

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-solved").hide();
                row.css("background-color", "gray");

                //$(".k-grid-top", gridName).hide();

            }
            else {
                //  row.find(".k-grid-edit").show();
                // row.css("background-color", "red");
            }
        }
    }
</script>

<script>
    ///////// for master row actions

     function CloseTicket(e) {
         var dataItem = this.dataItem($(e.currentTarget).closest("tr"));

         var id = dataItem.CustomerTicket_HelpDeskId;

         if (confirm('Are you sure you want to close this ticket'))
            {
             try {
                 //var BookNo = dataItem.BookNo;
                 $.ajax({
                     //contentType: "application/json; charset=utf-8",
                     url: '@Url.Action("CloseTicket", "AssignTicket")',
                     data: { mid: id },
                     type: 'POST',
                     cache: false,
                     success: function (result) {
                         r = result;
                         $("#grid").data("kendoGrid").dataSource.read();
                     }

                 });
             } catch (ee) {
                 alert("Please select the row first!!");
             }
         }
       }



     function onMasterDataBound(e) {

         var rows = e.sender.tbody.children();

         var masterRow = e.masterRow;

         var masterGrid = $("#grid").data("kendoGrid");

             for (var j = 0; j < rows.length; j++) {
                 var row = $(rows[j]);
                 var dataItem = e.sender.dataItem(row);
                 //if (dataItem.IsClosed === true) {

                 //    row.css("background-color", "gray");

                 //    row.find(".k-grid-closeT").hide();

                 //}
                 if (dataItem.Status == "0") {
                     row.find(".k-grid-closeT").hide();
                 }
                 if (dataItem.Status == "1") {
                     row.find(".k-grid-closeT").hide();
                     row.css("background-color", "yellow");
                 }
                 if (dataItem.Status == "2") {
                     row.find(".k-grid-closeT").show();
                     row.css("background-color", "aqua");
                 }
                 if (dataItem.Status == "3") {
                     row.find(".k-grid-closeT").hide();
                     row.css("background-color", "gray");
                 }
                 if (dataItem.Status == "4") {
                     row.find(".k-grid-closeT").hide();
                     row.css("background-color", "red");
                 }
                 if (dataItem.Status == "5") {
                     row.find(".k-grid-closeT").hide();
                     row.css("background-color", "gold");
                 }
                 if (dataItem.IsClosed) {
                     row.find(".k-grid-closeT").hide();
                     row.css("background-color", "gray");
                 }
             }


     }

</script>

