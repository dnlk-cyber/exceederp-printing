        columns.ForeignKey(c => c.EmployeeId, (System.Collections.IEnumerable)ViewData["Employees"], "EmployeeId", "FullNameaEnglish").Title("Requester").Filterable(ftb => ftb.Multi(true).Search(true)).Width(180);
        columns.ForeignKey(c => c.BranchId, (IEnumerable<BranchVM>)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
        columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable<BussinesUnitVM>)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
        columns.ForeignKey(c => c.OrgStructureId, (IEnumerable<OrgStructureVM>)ViewData["workunits"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
        columns.Bound(c => c.DueDate).Width(120);
        columns.Bound(c => c.OverDue).Width(120);
        columns.Bound(c => c.Description).Width(150);
        columns.Bound(c => c.TicketPriority).HtmlAttributes(new { style = "background-color:#:PriorityColor#;" }).Width(160);
        columns.ForeignKey(c => c.SupportGroup_HelpDeskId, (System.Collections.IEnumerable)ViewData["Group"], "SupportGroup_HelpDeskId", "Name").Title("Group").Filterable(ftb => ftb.Multi(true).Search(true)).Width(180);
        columns.Bound(c => c.TicketStatus)/*.HtmlAttributes(new { style = "background-color:#:StatusColor#;" })*/.Width(160);
        columns.Bound(c => c.Rate).Width(120);
        columns.Bound(c => c.ClosedDate).Width(100).Title("Closed Date");
        columns.Bound(c => c.RequesterIPAddress).Width(150);
        columns.Command(
            command =>
            {
                command.Custom("Assign").Text("Assign").Click("assignTicket").HtmlAttributes(new { @class = "btn btn-primary", @title = "assign Ticket " });
                command.Custom("closeT").Text("Close Ticket").Click("CloseTicket").HtmlAttributes(new { @class = "btn btn-danger", @title = "Close Ticket " });
            }).Width(180);
    })
     .Events(ev =>
     {
         ev.DataBound("onMasterDataBound");
         ev.DetailExpand("onDetailExpandUser");
     })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("CustomerTicketEditor").Window(window =>
    {
        window.Title("Open Customer Ticket");
        window.Scrollable(false);

    }))
    .HtmlAttributes(new { style = "height: 520px;" })
    .Pageable(pageable => pageable
    .Input(true)
    .Numeric(false)
    .Refresh(true)
    .PageSizes(true)
    .ButtonCount(5))

    .Scrollable()
    .Sortable()
    .Filterable()
    // .Groupable().Events(ev => ev.DetailExpand("MasterOnExpand"))
    //.Events(events => events.DetailExpand("onDetailExpandUser"))
    .Scrollable(h => h.Height(500))
    .DataSource(dataSource => dataSource
    .Ajax()
    .Sort(x => x.Add(s => s.DateCreated).Descending())
    //  .Group(x => x.Add(p => p.Status))
    .Model(model =>
    {
        model.Id(p => p.CustomerTicket_HelpDeskId);
        model.Field(p => p.TicketStatus).Editable(false);
        model.Field(p => p.LastModified).Editable(false);

        model.Field(p => p.ModifiedBy).Editable(false);
        model.Field(p => p.DateCreated).Editable(false);
        model.Field(p => p.CreatedBy).Editable(false);
        model.Field(p => p.TicketPriority);
    })
    .Events(ev => ev
    .Error("error_handler(\"grid\")")
    .RequestStart("onRequestStart(\"grid\")")
    .RequestEnd("onRequestEnd(\"grid\")"))
    .Read(read => read.Action("CustomerPendingTickets_Read", "CustomerTicket", new { area = "InfoDesk" }).Data("sendForgery"))
    .Create(create => create.Action("CustomerTickets_Create", "CustomerTicket", new { area = "InfoDesk" }).Data("sendForgery"))
    .Update(update => update.Action("CustomerTickets_Update", "CustomerTicket", new { area = "InfoDesk" }).Data("sendForgery"))
    .Destroy(destroy => destroy.Action("CustomerTickets_Destroy", "CustomerTicket", new { area = "InfoDesk" }).Data("sendForgery"))
    ).ClientDetailTemplateId("template")
)
