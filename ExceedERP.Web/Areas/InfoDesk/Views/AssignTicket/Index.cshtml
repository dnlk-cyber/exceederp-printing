      {
          // columns.Bound(c => c.AssignTicketId).Width(50);

          columns.ForeignKey(c => c.AssinedTo, (System.Collections.IEnumerable)ViewData["AssignTo"], "EmployeeId", "FullNameaEnglish").Title("Assigned To").EditorTemplateName("EmployeesListFromGroup").Width(140);
          columns.Bound(c => c.Role).Width(100);
          columns.Bound(c => c.AssignedDate).Width(100);
          // columns.Bound(c => c.Age).Width(80);
          columns.Bound(c => c.Solution).Width(200);



          // columns.Command(command => { command.Custom("SendForClosing").Text(" Send For Closing ").Click("SendForClosing").HtmlAttributes(new { @class = " glyphicon-envelope btn-Success k-grid-sendforclose  " });
          columns.Command(command =>
          {
              command.Custom("solved").Text(" ").Click("ApproveSolved").IconClass("k-icon k-i-check").HtmlAttributes(new { @class = "btn btn-success ", title = "Approve Solved", });

              command.Edit();
