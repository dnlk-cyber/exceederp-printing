          ev.DataBound("DetailDataBound");

      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))

       .ClientDetailTemplateId("MaterialsUsed")

              //    }))

              .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model =>
          {
              model.Id(p => p.AssignTicket_HelpDeskId);
              model.Field(p => p.AssignTicket_HelpDeskId).Editable(false);
              model.Field(p => p.Age).Editable(false);
              model.Field(p => p.AssignedDate).Editable(false);
              model.Field(p => p.Solution).Editable(false);

          })
              .Events(ev => ev
                                .Error("error_handler(\"Assigngrid_#=CustomerTicket_HelpDeskId#\")")
                                .RequestStart("onRequestStart(\"Assigngrid_#=CustomerTicket_HelpDeskId#\")")
                                .RequestEnd("onRequestEnd(\"Assigngrid_#=CustomerTicket_HelpDeskId#\")"))

                          .Read(read => read.Action("AssignTickets_Read", "AssignTicket", new { Id = "#=CustomerTicket_HelpDeskId#" }))
                          .Create(create => create.Action("AssignTickets_Create", "AssignTicket", new { Id = "#=CustomerTicket_HelpDeskId#" }))
          .Update(update => update.Action("AssignTickets_Update", "AssignTicket"))
          .Destroy(destroy => destroy.Action("AssignTickets_Destroy", "AssignTicket"))
      ).ToClientTemplate()
                )

            </text>
            );


        //*****************************************************************************************************//
    }).ToClientTemplate())
</script>




