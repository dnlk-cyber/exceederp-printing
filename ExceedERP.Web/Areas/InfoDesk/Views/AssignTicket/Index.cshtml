@using ExceedERP.Core.Domain.InfoDesk.Support
@model ExceedERP.Core.Domain.InfoDesk.Support.CustomerTicket_HelpDesk
<legend>Assign Ticket</legend>


@if (ViewBag.StateMsg != null)
{
    <div class="  alert-danger">
        <p>
            @ViewBag.StateMsg
        </p>
    </div>
}
@(Html.Kendo().Grid<CustomerTicket_HelpDesk>
    ()
    .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(c => c.CustomerTicket_HelpDeskId).Width(50).Title("#");
        columns.ForeignKey(c => c.SpecificTicketTypeId, (System.Collections.IEnumerable)ViewData["TicketTypes"], "TicketType_HelpDeskId", "Description").EditorTemplateName("SpecificTicket").Width(200);
        columns.ForeignKey(c => c.EmployeeId, (System.Collections.IEnumerable)ViewData["Employees"], "EmployeeId", "FullNameaEnglish").Title("Requester").Width(180);

        columns.Bound(c => c.Description).Width(150);
        columns.Bound(c => c.Priority).HtmlAttributes(new { style = "background-color:#:PriorityColor#;" }).Width(160);
        columns.Bound(c => c.TicketGroup).Width(160);
        columns.Bound(c => c.Status)/*.HtmlAttributes(new { style = "background-color:#:StatusColor#;" })*/.Width(160);
        columns.Bound(c => c.Rate).Width(120);

        columns.Command(
            command =>
            {
                command.Custom("closeT").Text("Close Ticket").Click("CloseTicket").HtmlAttributes(new { @class = "btn btn-danger", @title = "Close Ticket " });
            }).Width(180);
    })
     .Events(ev =>
     {
         ev.DataBound("onMasterDataBound");
         ev.DetailExpand("onDetailExpandUser");
     })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("CustomerTicketEditor").Window(window =>
    {
        window.Title("Open Customer Ticket");
        window.Scrollable(false);

    }))
    .HtmlAttributes(new { style = "height: 520px;" })
    .Pageable(pageable => pageable
    .Input(true)
    .Numeric(false)
    .Refresh(true)
    .PageSizes(true)
    .ButtonCount(5))

    .Scrollable()
    .Sortable()
    .Filterable()
    // .Groupable().Events(ev => ev.DetailExpand("MasterOnExpand"))
    //.Events(events => events.DetailExpand("onDetailExpandUser"))
    .Scrollable(h => h.Height(500))
    .DataSource(dataSource => dataSource
    .Ajax()
    .Sort(x => x.Add(s => s.DateCreated).Descending())
    //  .Group(x => x.Add(p => p.Status))
    .Model(model =>
    {
        model.Id(p => p.CustomerTicket_HelpDeskId);
        model.Field(p => p.Status).Editable(false);
        model.Field(p => p.LastModified).Editable(false);

        model.Field(p => p.ModifiedBy).Editable(false);
        model.Field(p => p.DateCreated).Editable(false);
        model.Field(p => p.CreatedBy).Editable(false);
    })
    .Events(ev => ev
    .Error("error_handler(\"grid\")")
    .RequestStart("onRequestStart(\"grid\")")
    .RequestEnd("onRequestEnd(\"grid\")"))
        .Read(read => read.Action("CustomerPendingTickets_Read", "CustomerTicket", new { area = "InfoDesk" }))
    //.Create(create => create.Action("CustomerTickets_Create", "CustomerTicket", new { area = "InfoDesk" }))
    //.Update(update => update.Action("CustomerTickets_Update", "CustomerTicket", new { area = "InfoDesk" }))
    //.Destroy(destroy => destroy.Action("CustomerTickets_Destroy", "CustomerTicket", new { area = "InfoDesk" }))
    ).ClientDetailTemplateId("template")
)


