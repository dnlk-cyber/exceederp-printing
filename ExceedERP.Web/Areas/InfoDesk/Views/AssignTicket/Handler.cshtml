                       //   columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox' \\#=IsActive? checked='checked': checked='' \\# class='checkbox'  />").Width(80);
                         //             columns.Bound(c => c.IsTransfer).ClientTemplate("<input type='checkbox' \\#=IsTransfer? checked='checked': checked='' \\# class='checkbox'  />").Width(80);
                         //             columns.ForeignKey(c => c.TransferTo, (System.Collections.IEnumerable)ViewData["SysUsers"], "CustomerID", "CustomerName").EditorTemplateName("GroupMemberEditor").Width(120);

                                      columns.Bound(c => c.Age).Width(80);

                                      columns.Command(command => { command.Custom("SendForClosing").Text(" Send For Closing ").Click("SendForClosing").HtmlAttributes(new { @class = " glyphicon-envelope btn-Success k-grid-sendforclose  " }); command.Edit(); command.Destroy(); }).Width(250);
                                  })
                          .Events(ev =>
                                                                  {

                                                                              ev.DataBound("LineonDataBound");

                                                                          }).Editable(editable => editable.Mode(GridEditMode.InLine))


                                                                            //    }))

                                                                            .Scrollable(h => h.Height(500))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Model(model =>
                                  {
                                              model.Id(p => p.AssignTicketId);
