                        </text>
                                );

                             
                         //*****************************************************************************************************//
                     }).ToClientTemplate())
</script>


<script>

    function UpdateStatus(e) {


        var wnd = $("#Details").data("kendoWindow");
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));

        //wnd.content(detailsTemplate(dataItem));
        $("#CustomerTicketID").val(dataItem.CustomerTicketID);
        wnd.center().open();
    }

    function SendForClosing(e) {


        var wnd = $("#SendDetails").data("kendoWindow");
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));

        //wnd.content(detailsTemplate(dataItem));
        $("#AssignTicketId").val(dataItem.AssignTicketId);
        wnd.center().open();
    }

    function LineonDataBound(e) {
        var grid = this;


        var Checkgrid = $("#Assigngrid_" + masterId).data("kendoGrid");
        var gridData = Checkgrid.dataSource.view();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsClosed == true) {
                $(this).find(".k-grid-sendforclose ").remove();
            }


        });
    }
    var masterId;
    var Group;
    function MasterOnExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.CustomerTicketID;
        Group = masterDataItem.TicketGroup;

    }
    function MemeberGroup() {
        return {
            Group: Group
        };
    }

    function onDataBound(e) {
        var grid = this;


        var Checkgrid = $("#grid").data("kendoGrid");
        var gridData = Checkgrid.dataSource.view();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsSendForClosing == false)
            {
                $(this).find(".k-grid-finalize ").remove();
            }

            if (dataItem.Status == "3") {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-update").remove();

            }
        });
    }
</script>


@(Html.Kendo().Window().Name("Details")
                  .Title(" Update Ticket Status ")
        .Visible(false)
        .Modal(true)
        .Draggable(true)
        .Width(600).Content(@<text><div class="form-group">

                <form action="@Url.Action("UpdateStatus", "AssignTicket")" method="post">

                    <input type="hidden" name="Id" id="CustomerTicketID">
                    <label>Status :</label>
                    @(Html.Kendo().DropDownListFor(model => model)
                                .HtmlAttributes(new { @class = "form-control" }).Name("Name")
                                .DataTextField("Name").DataValueField("StatusTypeId")
                                .OptionLabel("Select")
                                .DataSource(d =>
                                                {
                                                    d.Read(r => { r.Action("GetStatusType", "InfoDeskDataProvider"); })

                         .ServerFiltering(true);
                                                }).AutoBind(true)
                                    .Template("<span class=\"k-state-default\" > <p style=\"background-color:#:data.Color#;\">  #: data.Name #</p></span>")
                                    .HtmlAttributes(new { @required = "required" }))
                    <br />
                    <textarea type="text" name="Name" cols="80" rows="10" value="" placeholder="Remark Here..."></textarea>
                    <input type="submit" class="btn-primary k-button" value=" Update " />

                </form>
            </div></text>))


@(Html.Kendo().Window().Name("SendDetails")
                  .Title(" Send For Closing ")
        .Visible(false)
        .Modal(true)
        .Draggable(true)
        .Width(600).Content(@<text><div class="form-group">

                <form action="@Url.Action("SendForClosing", "AssignTicket",new { val="handler"})" method="post">

                    <input type="hidden" name="Id" id="AssignTicketId">
                    <br />
                    <textarea type="text" name="Name" cols="80" rows="10" value="" placeholder="Remark Here..."></textarea>
                    <input type="submit" class="btn-primary k-button" value=" Send " />

                </form>
            </div></text>))


