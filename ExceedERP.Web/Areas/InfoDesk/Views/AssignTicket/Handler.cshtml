@using ExceedERP.Core.Domain.InfoDesk.Support
@model ExceedERP.Core.Domain.InfoDesk.Support.CustomerTicket



@if (ViewBag.StateMsg != null)
{
    <div class="  alert-danger">
        <p>
            @ViewBag.StateMsg
        </p>
    </div>
}
@(Html.Kendo().Grid<CustomerTicket>
        ()
        .Name("grid")
        .Columns(columns =>
        {
            columns.Bound(c => c.CustomerTicketID).Width(50).Title("#");
            //columns.ForeignKey(c => c.CustomerID, (System.Collections.IEnumerable)ViewData["CustomerList"], "CustomerID", "CustomerName").EditorTemplateName("AcceptedCustomer").Title("Customer").Width(150);
            //columns.Bound(c => c.TicketType).Width(170);
            columns.ForeignKey(c => c.SpecificTicketTypeId, (System.Collections.IEnumerable)ViewData["TicketTypes"], "TicketTypeId", "Description").EditorTemplateName("SpecificTicket").Width(200);

            columns.Bound(c => c.Description).Width(120);
            columns.Bound(c => c.Priority).HtmlAttributes(new { style = "background-color:#:PriorityColor#;" }).Width(120);
            //columns.ForeignKey(c => c.TicketDefintion, (System.Collections.IEnumerable)ViewData["TicketDefActivity"], "TicketActivityDefinitionID", "Description").EditorTemplateName("TicketActivityDefinition").Width(150);

            columns.Bound(c => c.StatusType).HtmlAttributes(new { style = "background-color:#:StatusColor#;" }).Width(120);
            columns.Bound(c => c.TicketGroup);
            //columns.Bound(c => c.Source).Width(150);


            //  columns.Command(command => { command.Custom("UpdateStatus").Text(" Update Status").Click("UpdateStatus").HtmlAttributes(new { @class = " glyphicon-envelope btn-warning k-grid-finalize  " }); }).Width(180);
        })
      .Events(ev =>
      {

          ev.DataBound("onDataBound");

      })
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("CustomerTicketEditor").Window(window =>
        {
            window.Title("Open Customer Ticket");
            window.Scrollable(false);

        }))
        .HtmlAttributes(new { style = "height: 520px;" })
        .Pageable(pageable => pageable
        .Input(true)
        .Numeric(false)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5))

        .Scrollable()
        .Sortable()
        .Filterable()
             .Groupable().Events(ev => ev.DetailExpand("MasterOnExpand"))
        .Scrollable(h => h.Height(500))
        .DataSource(dataSource => dataSource
        .Ajax()
        .Sort(x => x.Add(s => s.DateCreated).Descending())
        //  .Group(x => x.Add(p => p.Status))
        .Model(model =>
        {
            model.Id(p => p.CustomerTicketID);
            model.Field(p => p.Status).Editable(false);
            model.Field(p => p.LastModified).Editable(false);

            model.Field(p => p.ModifiedBy).Editable(false);
            model.Field(p => p.DateCreated).Editable(false);
            model.Field(p => p.CreatedBy).Editable(false);
        })
        .Events(ev => ev
        .Error("error_handler(\"grid\")")
        .RequestStart("onRequestStart(\"grid\")")
        .RequestEnd("onRequestEnd(\"grid\")"))
            .Read(read => read.Action("CustomerPendingTickets_Read", "CustomerTicket",new { val="handler"}))
        .Create(create => create.Action("CustomerTickets_Create", "CustomerTicket"))
        .Update(update => update.Action("CustomerTickets_Update", "CustomerTicket"))
        .Destroy(destroy => destroy.Action("CustomerTickets_Destroy", "CustomerTicket"))
        ).ClientDetailTemplateId("template")
)







