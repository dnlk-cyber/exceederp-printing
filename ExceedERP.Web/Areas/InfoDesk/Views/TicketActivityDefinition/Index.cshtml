@using ExceedERP.Core.Domain.InfoDesk.Support
<legend>Ticket Activity Definition</legend>
@(Html.Kendo().Grid<TicketActivityDefinition_HelpDesk>()
          .Name("grid")
      .Columns(columns =>
      { 
          columns.Bound(c => c.Index).EditorTemplateName("Integer").Width(80);
        columns.Bound(c => c.TicketActivityStatus).EditorTemplateName("TicketActivityStatusEditor").Width(100).Title("Activity Type");
        columns.Bound(c => c.Description).Width(120);
        columns.Bound(c => c.CanFinalize).ClientTemplate("<input type='checkbox'  disabled='true' value='#=CanFinalize #' " + " # if (CanFinalize) { #" + "checked='checked'" + "# } #" + " />").Title("Can Finalize").Width(80);
        columns.Bound(c => c.Remark).Width(150);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
    })
      .ToolBar(toolbar => {
        toolbar.Create();
    })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
           .HtmlAttributes(new { style = "height: 520px;" })
                                  .Pageable(pageable => pageable
                                                    .Input(true)
                                                    .Numeric(false)
                                                    .Refresh(true)
                                                    .PageSizes(true)
                                                    .ButtonCount(5))

                                        .Scrollable()
                                        .Sortable()
                                        .Filterable()
                               
                                        .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.TicketActivityDefinition_HelpDeskId))
              .Events(ev => ev
                                 .Error("error_handler(\"grid\")")
                              .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("TicketActivityDefinitions_Read", "TicketActivityDefinition").Data("sendForgery"))
          .Create(create => create.Action("TicketActivityDefinitions_Create", "TicketActivityDefinition").Data("sendForgery"))
          .Update(update => update.Action("TicketActivityDefinitions_Update", "TicketActivityDefinition").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("TicketActivityDefinitions_Destroy", "TicketActivityDefinition").Data("sendForgery"))
      )
)
 