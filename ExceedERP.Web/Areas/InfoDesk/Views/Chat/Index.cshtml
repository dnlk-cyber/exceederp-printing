@{
    ViewBag.Title = "Messages";
}

<h2>Messages</h2>

<label for="receiverDropdown">Conversation</label>
<select id="receiverDropdown" class="form-control" style="max-width: 360px;" disabled>
    <option value="">Select a user</option>
</select>
<p id="chatStatus" role="status">Loading users...</p>

<div id="chatBox" style="max-width: 720px; height: 400px; overflow-y: auto; border: 1px solid #ccc; padding: 10px;">
    <ul id="chatMessages"></ul>
</div>

<form id="sendMessageForm">
    <label for="messageInput">Message</label>
    <input type="text" id="messageInput" class="k-textbox" placeholder="Type a message..." disabled />
    <button id="sendButton" type="submit" class="k-button k-primary" disabled>Send</button>
</form>

<script>
    $(function () {
        var receiver = $("#receiverDropdown");
        var messages = $("#chatMessages");
        var status = $("#chatStatus");
        var input = $("#messageInput");
        var sendButton = $("#sendButton");
        var currentUserId;
        var historyRequest;
        var sending = false;

        $.when(
            $.getJSON('@Url.Action("GetMyUserId", "Chat", new { area = "InfoDesk" })'),
            $.getJSON('@Url.Action("GetUsers", "Chat", new { area = "InfoDesk" })')
        ).done(function (currentUserResponse, usersResponse) {
            var currentUser = currentUserResponse[0][0];
            if (!currentUser) {
                status.text("Your user account could not be loaded.");
                return;
            }

            currentUserId = currentUser.UserId;
            $.each(usersResponse[0], function (_, user) {
                if (user.UserId !== currentUserId) {
                    $("<option>").val(user.UserId).text(user.Name).appendTo(receiver);
                }
            });
            receiver.prop("disabled", false);
            status.text("Select a user to open your conversation.");
        }).fail(function () {
            status.text("Could not load users. Reload the page to retry.");
        });

        function loadHistory() {
            if (historyRequest) {
                historyRequest.abort();
            }

            var receiverId = receiver.val();
            messages.empty();
            input.prop("disabled", !receiverId);
            sendButton.prop("disabled", !receiverId || sending);
            if (!receiverId) {
                status.text("Select a user to open your conversation.");
                return;
            }

            status.text("Loading messages...");
            historyRequest = $.ajax({
                url: '@Url.Action("GetChatHistory", "Chat", new { area = "InfoDesk" })',
                data: { user2Id: receiverId },
                dataType: "json",
                cache: false
            }).done(function (history) {
                status.text(history.length ? "" : "No messages in this conversation yet.");
                $.each(history, function (_, message) {
                    var ownMessage = message.SenderId === currentUserId;
                    $("<li>").addClass(ownMessage ? "sent-message" : "received-message")
                        .append($("<strong>").text(ownMessage ? "Me:" : message.Sender))
                        .append($("<span>").text(" " + message.Content + " "))
                        .append($("<small>").text("(" + message.Timestamp + ")"))
                        .appendTo(messages);
                });
                var chatBox = $("#chatBox")[0];
                chatBox.scrollTop = chatBox.scrollHeight;
            }).fail(function (_, reason) {
                if (reason !== "abort") {
                    status.text("Could not load this conversation. Select it again to retry.");
                }
            });
        }

        receiver.on("change", loadHistory);
        $("#sendMessageForm").on("submit", function (event) {
            event.preventDefault();
            var receiverId = receiver.val();
            var content = input.val().trim();
            if (!receiverId || !content || sending || !window.confirm("Send this message?")) {
                return;
            }

            sending = true;
            receiver.prop("disabled", true);
            sendButton.prop("disabled", true);
            $.post('@Url.Action("InsertMessage", "Chat", new { area = "InfoDesk" })', {
                senderId: currentUserId,
                receiverId: receiverId,
                content: content
            }).done(function (result) {
                if (!result.success) {
                    status.text(result.message || "Could not send the message.");
                    return;
                }
                if (input.val().trim() === content) {
                    input.val("");
                }
                loadHistory();
            }).fail(function () {
                status.text("Could not confirm that the message was sent.");
            }).always(function () {
                sending = false;
                receiver.prop("disabled", false);
                sendButton.prop("disabled", !receiver.val());
            });
        });
    });
</script>
