@using System.Collections;
@using ExceedERP.Core.Domain.InfoDesk.ChangeManagement
<legend> Change Requests </legend>
@(Html.Kendo().Grid<ChangeRequest>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ChangeRequestId).Width(90).Title("#");
          columns.ForeignKey(c => c.RequestorId, (System.Collections.IEnumerable)ViewData["Employees"], "RequestorId", "FullNameaEnglish").Width(150);
          columns.ForeignKey(c => c.ApproverId, (System.Collections.IEnumerable)ViewData["Employees"], "ApproverId", "FullNameaEnglish").Width(150);
          columns.Bound(c => c.Title).Width(150);
          columns.Bound(c => c.ChangeType).Width(150);
          columns.Bound(c => c.ChangeStatus).Width(150);
          columns.Bound(c => c.PlannedStartDate).Width(150);
          columns.Bound(c => c.PlannedEndDate).Width(150);
          columns.Bound(c => c.Description).Width(150);
          columns.Bound(c => c.RequestDate).Width(130);
          columns.Bound(c => c.ImpactAnalysis).Width(120);
          columns.Bound(c => c.ImplementationTeam).Width(120);
          columns.Bound(c => c.RollbackPlan).Width(120);
          columns.Bound(c => c.RiskAssessment).Width(120);
          columns.Bound(c => c.Description).Width(120);
          columns.Bound(c => c.Remark).Width(120);
          columns.Command(command =>
          {

              command.Edit();
              command.Destroy();
              //command.Custom("confirm").Text("Confirm").Click("Confirmation").HtmlAttributes(new { @class = "btn-success" });

          }).Width(250);

      })
      .ToolBar(toolbar =>
      {
         toolbar.Create();
      })
      .Events(ev =>
      {
          ev.DataBound("onDataBound");
          ev.DetailExpand("onExpand");

      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("changeEditor").Window(window =>
      {
          window.Title("change Request Form");
          window.Scrollable(false);

      }))
      .HtmlAttributes(new { style = "height: 520px;" })
      .Pageable(pageable => pageable
        .Input(true)
        .Numeric(false)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5))
      .Scrollable()
      .Sortable()
      .Filterable()
      .Scrollable(h => h.Height(500))
   .DataSource(dataSource => dataSource
        .Ajax()
        .Sort(x => x.Add(s => s.DateCreated).Descending())
       //  .Group(x => x.Add(p => p.Status))
       .Model(model =>
       {
           model.Id(p => p.ChangeRequestId);
           model.Field(p => p.ChangeRequestId).Editable(false);
           model.Field(p => p.LastModified).Editable(false);
           model.Field(p => p.ModifiedBy).Editable(false);
           model.Field(p => p.DateCreated).Editable(false);
           model.Field(p => p.CreatedBy).Editable(false);

       })
        .Events(ev => ev
        .Error("error_handler(\"grid\")")
        .RequestStart("onRequestStart(\"grid\")")
        .RequestEnd("onRequestEnd(\"grid\")"))
    .Read(read => read.Action("ChangeRequests_Read", "ChangeRequests").Data("sendForgery"))
    .Create(create => create.Action("ChangeRequests_Create", "ChangeRequests").Data("sendForgery"))
    .Update(update => update.Action("ChangeRequests_Update", "ChangeRequests").Data("sendForgery"))
    .Destroy(destroy => destroy.Action("ChangeRequests_Destroy", "ChangeRequests").Data("sendForgery"))
).ClientDetailTemplateId("template")
)


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_#=ChangeRequestId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Detail  ").Content(
          @<text>
            # if (IsSendForApproval){#
                @*<a href='@Url.Action("ITSupportReport", "HelpDeskReport")/?id=#=ChangeRequestId#' title="Print"><i class="fa fa-print fa-2x"></i></a>*@
            #} if (!IsSendForApproval){#
            @*<a onclick='return sendForApproval("#=ChangeRequestId#")' href=' \#' title="Send For approval"><i class="fa fa-share-square fa-2x"></i></a>*@
            #}#
            <dl class="dl-horizontal">
                <dt>
                    Created On
                </dt>
                <dd>
                    #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #
                </dd>
                <dt>
                    Created By
                </dt>
                <dd>
                    #= CreatedBy #
                </dd>
                <dt>
                    Request Date
                </dt>
                <dd>
                    #=kendo.toString(kendo.parseDate(RequestDate), 'dd/MM/yyyy') #
                </dd>
                <dt>
                    Modified By
                </dt>
                <dd>
                    #= ModifiedBy #
                </dd>
                <dt>
                    Modified Date
                </dt>
                <dd>
                    #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #
                </dd>
                <dt>
                    Remark
                </dt>
                <dd>
                   #= Remark #

                </dd>
            </dl>
        </text>);
        items.Add().Text(" Change  Task").Content(
        @<text>
            @(Html.Kendo().Grid<ChangeTask>()
                .Name("Assigngrid_#=ChangeRequestId#")
                .Columns(columns =>
                {


                    columns.Bound(c => c.CompletionDate).Width(180);
                    columns.ForeignKey(c => c.OrgStructureId, (System.Collections.IEnumerable)ViewData["orgStructure"], "OrgStructureId", "Name")
                            .EditorTemplateName("Department")
                            .Filterable(ftb => ftb.Multi(true).Search(true)).Width(180);
                    columns.ForeignKey(c => c.EmployeeId, (System.Collections.IEnumerable)ViewData["Employees"], "EmployeeId", "FullNameaEnglish").Width(180);
                    columns.Bound(c => c.Description).Width(180);
                    columns.Command(command =>
                    {

                        command.Edit();
                        command.Destroy();

                    })/*.Width(250)*/;

                })
                 .ToolBar(toolbar =>
                 {
                     toolbar.Create();
                 })
                  .Events(ev =>
                  {
                      ev.DataBound("onDetailDataBound");
                      //ev.DetailExpand("onExpand");


                  })
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Scrollable(h => h.Height(500))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Model(model =>
                    {
                        model.Id(p => p.ChangeTaskId);
                        model.Field(p => p.EmployeeId);


                    })
                    .Events(ev => ev
                            .Error("error_handler(\"Assigngrid_#=ChangeRequestId#\")")
                            .RequestStart("onRequestStart(\"Assigngrid_#=ChangeRequestId#\")")
                            .RequestEnd("onRequestEnd(\"Assigngrid_#=ChangeRequestId#\")"))
                        .Read(read => read.Action("ChangeTasks_Read", "ChangeTasks", new { id = "#=ChangeRequestId#" }).Data("sendForgery"))
                        .Create(create => create.Action("ChangeTasks_Create", "ChangeTasks", new { id = "#=ChangeRequestId#" }).Data("sendForgery"))
                        .Update(update => update.Action("ChangeTasks_Update", "ChangeTasks").Data("sendForgery"))
                        .Destroy(destroy => destroy.Action("ChangeTasks_Destroy", "ChangeTasks").Data("sendForgery"))
                        ).ToClientTemplate())
        </text>);
        items.Add().Text("Approval  ").Content(
        @<text>
        @(Html.Kendo().Grid<ChangeApproval>()
            .Name("ChangeApprovalgrid_#=ChangeRequestId#")
            .Columns(columns =>
            {


                columns.Bound(c => c.Status).Width(200);
                columns.Bound(c => c.Remark).Width(200);


                columns.Command(command =>
                {

                    command.Edit();
                    command.Destroy();

                })/*.Width(250)*/;
            })
              .ToolBar(toolbar =>
              {
                  toolbar.Create();
              })
            .Editable(editable => editable.Mode(GridEditMode.InLine))
                    .Scrollable(h => h.Height(500))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Model(model =>
                        {
                            model.Id(p => p.ChangeApprovalId);
                        })
                    .Events(ev => ev
                            .Error("error_handler(\"ChangeApprovalgrid_#=ChangeRequestId#\")")
                            .RequestStart("onRequestStart(\"ChangeApprovalgrid_#=ChangeRequestId#\")")
                            .RequestEnd("onRequestEnd(\"ChangeApprovalgrid_#=ChangeRequestId#\")"))
                        .Read(read => read.Action("ChangeApprovals_Read", "ChangeApprovals", new { Id = "#=ChangeRequestId#" }).Data("sendForgery"))
                        .Create(create => create.Action("ChangeApprovals_Create", "ChangeApprovals", new { Id = "#=ChangeRequestId#" }).Data("sendForgery"))
                        .Update(update => update.Action("ChangeApprovals_Update", "ChangeApprovals").Data("sendForgery"))
                        .Destroy(destroy => destroy.Action("ChangeApprovals_Destroy", "ChangeApprovals").Data("sendForgery"))
                        ).ToClientTemplate())
        </text>);
        }).ToClientTemplate())
</script>
<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
