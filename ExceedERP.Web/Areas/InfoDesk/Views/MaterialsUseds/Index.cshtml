@model IEnumerable<ExceedERP.Core.Domain.InfoDesk.Support.MaterialsUsed>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.MaterialItemsId)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AssignedTicketId)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CustomerTicketId)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Remark)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.MaterialItemsId)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.AssignedTicketId)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CustomerTicketId)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Remark)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.MaterialsUsedId }) |
            @Html.ActionLink("Details", "Details", new { id=item.MaterialsUsedId }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.MaterialsUsedId })
        </td>
    </tr>
}

</table>
