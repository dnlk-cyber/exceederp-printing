@(Html.Kendo().DropDownListFor(m => m)
                     // .AutoBind(false)
                      .OptionLabel("--Select Materials Used--")
                      .DataTextField("ItemName")
                      .DataValueField("MaterialItemsId")
                        .Filter("contains")
                            .ValuePrimitive(true)
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetMaterials", "Handler"))
                                    .ServerFiltering(false);
                      })

)
@Html.ValidationMessageFor(m => m)