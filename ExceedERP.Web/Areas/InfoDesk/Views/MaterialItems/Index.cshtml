<legend>Material Items</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.InfoDesk.Support.MaterialItems>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ItemName).Width(200);
          columns.ForeignKey(c => c.CategoryId, (System.Collections.IEnumerable)ViewData["category"], "Code", "Name").EditorTemplateName("Category").Width(200);
          columns.ForeignKey(c => c.InventoryItemId, (System.Collections.IEnumerable)ViewData["inventoryItems"], "Code", "Name").EditorTemplateName("GetItem").Width(200);

          //columns.ForeignKey(c => c.CategoryId);
          //columns.Bound(c => c.InventoryItemId).EditorTemplateName("Item");
          columns.Bound(c => c.Remark).Width(120);
          columns.Command(command => {
              command.Edit();
              command.Destroy();
          })/*.Width(180)*/;
      })
      .ToolBar(toolbar => {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Navigatable()
      .Filterable()
       .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.MaterialItemsId))
          .Read(read => read.Action("MaterialItems_Read", "MaterialItems").Data("sendForgery"))
          .Create(create => create.Action("MaterialItems_Create", "MaterialItems").Data("sendForgery"))
          .Update(update => update.Action("MaterialItems_Update", "MaterialItems").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("MaterialItems_Destroy", "MaterialItems").Data("sendForgery"))
      )
)

<script>
    function getItemCode() {
        return {
            code: $("#CategoryId").val()
        };

    }
</script>