                                dataSource.Read(read => read.Action("StatusAwaitingDDBind", "InfoDeskDataProvider"));

                            }).ValuePrimitive(true).Template("<span class=\"k-state-default\" > <p style=\"background-color:#:data.Color#;\">  #: data.Name #</p></span>")
                    )
                    @Html.ValidationMessageFor(model => model.StatusType)
                </div>

            </div>
        </div>



    </div>
    <br />*@

    <div class="row">

        <div class="col-md-3">
            <p id="p"></p>
        </div>


        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Description)
                </div>
                <div>
                    @Html.TextAreaFor(model => model.Description, 3, 30, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Description)


                </div>
            </div>
        </div>




       

  

