@using ExceedERP.Core.Domain.InfoDesk.Support
@using ExceedERP.Core.Domain.CRM
@model ExceedERP.Core.Domain.InfoDesk.Support.CustomerTicket_HelpDesk
@using ExceedERP.Core.Domain.InfoDesk
<form>

    <div class="row">
        <div class="col-md-3">

        </div>

        <div class="col-md-3">

            <div class="form-group">
                <div class="k-label">
                    @Html.Label("Ticket Type")
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.SpecificTicketTypeId)


                          .OptionLabel("Select Specific Ticket ...")
                          .DataTextField("Type")
                          .Filter("contains")
                          .DataValueField("TicketType_HelpDeskId")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetSpecificTicket", "InfoDeskDataProvider"));

                          }).ValuePrimitive(true))
                </div>
            </div>
        </div>


    </div>
  

    <div class="row">
        <div class="col-md-3">
        </div>

        <div class="col-md-3">

            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Priority)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.Priority)
                      .AutoBind(false)
                      .OptionLabel("Select")
                                .DataTextField("Name")
                                      .DataValueField("Name").DataSource(dataSource =>
                                      {
                                          dataSource.Read(read => read.Action("GetPriorityType", "InfoDeskDataProvider"));

                                      }).ValuePrimitive(true).Template("<span class=\"k-state-default\" > <p style=\"background-color:#:data.Color#;\">#: data.Name #</p></span>")
                    )
                    @Html.ValidationMessageFor(model => model.Priority)
                </div>

            </div>
        </div>



    </div>

    <div class="row">

        <div class="col-md-3">

        </div>

        <div class="col-md-3">

            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.SupportGroupId)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.SupportGroupId)
                           .AutoBind(false)
                           .OptionLabel("Select")
                           .DataTextField("Name")
                                   .DataValueField("SupportGroup_HelpDeskId")
                           .DataSource(dataSource =>
                           {
                               dataSource.Read(read => read.Action("GetSupportGroup", "InfoDeskDataProvider"));

                           }).ValuePrimitive(true))
                    @Html.ValidationMessageFor(model => model.SupportGroupId)
                </div>
            </div>
        </div>
    </div>

