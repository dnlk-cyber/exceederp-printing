<script>
    function DisableSlider() {
        $("#Rate").data("kendoSlider").value(0);
        $("#Rate").data("kendoSlider").enable(false);
    }

    function EnableSlider() {
        $("#Rate").data("kendoSlider").enable(true);
    }
</script>

@(Html.Kendo().Window().Name("Details")
                      .Title(" Confirm If The Problem Solved ")
            .Visible(false)
            .Modal(true)
            .Draggable(true)
            .Width(400).Content(@<text><div class="form-group">
                    <form action="@Url.Action("Confirmation", "SelfCareOpenTickets")" method="post">
                        <input type="hidden" name="Id" id="CustomerTicket_HelpDeskId">
                        <div class="row">

                            <div class="col-lg-10">

                                <div class="demo-section k-content">
                                    <h5>Is Solved ?</h5>
                                    @(Html.Kendo().RadioButtonFor(model => model)
                                       .Name("IsConfirmedByTheRequester")
                                       .Value("true")
                                       .Label("Yes").HtmlAttributes(new { @onchange = "EnableSlider()" })

                                    )
                                    &nbsp; &nbsp; &nbsp;
                                    @(Html.Kendo().RadioButtonFor(model => model)
                                       .Name("IsConfirmedByTheRequester")
                                       .Value("false")
                                       .Label("No").HtmlAttributes(new { @onchange = "DisableSlider()" })
                                    )
                                </div>
                                <div class="demo-section k-content">
                                    <h5>Rating</h5>
                                    @(Html.Kendo().Slider()
                                          .Name("Rate")
                                          .Min(1)
                                          .Max(5)
                                          .IncreaseButtonTitle("Right")
                                          .DecreaseButtonTitle("Left")
                                          .SmallStep(1)
                                          .LargeStep(1)
                                    )
                                </div>
                            </div>


                            @*<div class="col-lg-3">
                                    <textarea type="text" name="Remark" cols="80" rows="10" placeholder="Remark Here..."></textarea>
                                </div>*@
                        </div>
                        <div class="row">
                            <div class="col-lg-7"></div>
                            <input type="submit" class="btn-primary k-button" value=" Update " onclick="return confirm('Are you sure to confirm?');" />
                        </div>
                    </form>
                </div></text>)
)

<style>
    .demo-section {
        text-align: center;
    }
</style>


<script>
    function onMasterDataBound(e) {

        var rows = e.sender.tbody.children();

        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsClosed === true) {

                row.css("background-color", "gray");

                row.find(".k-grid-closeT").hide();

            } else {
                // row.css("background-color", "green");
            }

        }


    }
</script>