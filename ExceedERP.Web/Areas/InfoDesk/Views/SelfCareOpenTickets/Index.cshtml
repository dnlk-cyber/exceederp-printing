@using ExceedERP.Core.Domain.InfoDesk.Support
@model ExceedERP.Core.Domain.InfoDesk.Support.CustomerTicket_HelpDesk

<legend> Opne Ticket Self Care</legend>
@(Html.Kendo().Grid<CustomerTicket_HelpDesk>()
                          .Name("grid")
                      .Columns(columns =>
                      {
                          columns.Bound(c => c.CustomerTicket_HelpDeskId).Width(50).Title("#");
                          columns.ForeignKey(c => c.SpecificTicketTypeId, (System.Collections.IEnumerable)ViewData["TicketTypes"], "TicketType_HelpDeskId", "Type").EditorTemplateName("SpecificTicket").Title("Ticket Type").Filterable(ftb => ftb.Multi(true).Search(true)).Width(180);
                          columns.ForeignKey(c => c.EmployeeId, (System.Collections.IEnumerable)ViewData["Employees"], "EmployeeId", "FullNameaEnglish").Title("Requester").Filterable(ftb => ftb.Multi(true).Search(true)).Width(180);

                          columns.Bound(c => c.Description).Width(180);
                          columns.Bound(c => c.Priority).HtmlAttributes(new { style = "background-color:#:PriorityColor#;" }).Width(100);

                          columns.ForeignKey(c => c.SupportGroupId, (System.Collections.IEnumerable)ViewData["Group"], "SupportGroup_HelpDeskId", "Name").Title("Group").Filterable(ftb => ftb.Multi(true).Search(true)).Width(180);

                          columns.Bound(c => c.Status)/*.HtmlAttributes(new { style = "background-color:#:StatusColor#;" })*/.Width(100);
                          columns.Bound(c => c.RequesterIPAddress).Width(120);

                          //  columns.Bound(c => c.AgeOfTicket).Width(150);
                          columns.Command(command =>
                          {
                              command.Edit();
                              command.Destroy();
                              command.Custom("confirm").Text("Confirm").Click("Confirmation").HtmlAttributes(new { @class = "btn-success" });

                          }).Width(200);
                      })
                      .ToolBar(toolbar =>
                      {
                          toolbar.Create();

                      }).Events(ev =>
                      {

                          ev.DataBound("onDataBound");
                          // ev.DetailExpand("onExpand");
                      })
                      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("CustomerTicketEditor").Window(window =>
                      {
                          window.Title("Open Ticket");
                          window.Scrollable(false);



                      }))
                           .HtmlAttributes(new { style = "height: 520px;" })
                               .Pageable(pageable => pageable
                                                 .Input(true)
                                                 .Numeric(false)
                                                 .Refresh(true)
                                                 .PageSizes(true)
                                                 .ButtonCount(5))

                                     .Scrollable()
                                     .Sortable()
                                     .Filterable()

                                     .Scrollable(h => h.Height(500))
                      .DataSource(dataSource => dataSource
                          .Ajax()
                           .Sort(x => x.Add(s => s.DateCreated).Descending())
                              //  .Group(x => x.Add(p => p.Status))
                              .Model(model =>
                              {
                                  model.Id(p => p.CustomerTicket_HelpDeskId);
                                  model.Field(p => p.Status).Editable(false);
                                  model.Field(p => p.LastModified).Editable(false);

                                  model.Field(p => p.ModifiedBy).Editable(false);
                                  model.Field(p => p.DateCreated).Editable(false);
                                  model.Field(p => p.CreatedBy).Editable(false);

                              })
                              .Events(ev => ev
                                     .Error("error_handler(\"grid\")")
                                     .RequestStart("onRequestStart(\"grid\")")
                                     .RequestEnd("onRequestEnd(\"grid\")"))

                          .Read(read => read.Action("SelfCareOpenTickets_Read", "SelfCareOpenTickets").Data("sendForgery"))
                          .Create(create => create.Action("SelfCareOpenTickets_Create", "SelfCareOpenTickets").Data("sendForgery"))
                          .Update(update => update.Action("SelfCareOpenTickets_Update", "SelfCareOpenTickets").Data("sendForgery"))
                          .Destroy(destroy => destroy.Action("SelfCareOpenTickets_Destroy", "SelfCareOpenTickets").Data("sendForgery"))
                        ).ClientDetailTemplateId("template")
)







<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                               .Name("tabstrip_#=CustomerTicket_HelpDeskId#")
                          .SelectedIndex(0)
                          .Items(items =>
                           {
                               items.Add().Text("  Detail  ").Content(
                                @<text>
                                    <dl class="dl-horizontal">


                                        <dt>
                                            Created On
                                        </dt>
                                        <dd>
                                            #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                        </dd>
                                        <dt>
                                            Created By
                                        </dt>
                                        <dd>
                                            #= CreatedBy #
                                        </dd>

                                        <dt>
                                            DueDate
                                        </dt>
                                        <dd>
                                            #=kendo.toString(kendo.parseDate(DueDate), 'dd/MM/yyyy') #

                                        </dd>



                                        <dt>
                                            Modified By
                                        </dt>
                                        <dd>
                                            #= ModifiedBy #
                                        </dd>
                                        <dt>
                                            Modified Date
                                        </dt>
                                        <dd>
                                            #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #
                                        </dd>
                                        <dt>
                                            Remark
                                        </dt>
                                        <dd>
                                            @Html.LabelFor(model => model.Remark)

                                        </dd>
                                    </dl>
                                </text>
                                              );

                                       items.Add().Text("  Ticket  ").Content(
                                @<text>

                                    @(Html.Kendo().Grid<AssignTicket_HelpDesk>()
                                                                      .Name("Assigngrid_#=CustomerTicket_HelpDeskId#")
                                                          .Columns(columns =>
                                                          {
                                                          // columns.Bound(c => c.AssignTicket_HelpDeskId).Width(100);

                                                          columns.ForeignKey(c => c.AssinedTo, (System.Collections.IEnumerable)ViewData["AssignTo"], "EmployeeId", "FullNameaEnglish").Title("Assigned To").EditorTemplateName("EmployeesList");
                                                                      columns.Bound(c => c.Role);
                                                                      columns.Bound(c => c.AssignedDate);
                                                          // columns.Bound(c => c.Age).Width(80);
                                                          columns.Bound(c => c.Solution);


                                                                  })


                                                          .Editable(editable => editable.Mode(GridEditMode.InLine))

                                                           .ClientDetailTemplateId("MaterialsUsed")

                                                                      //    }))

                                                                      .Scrollable(h => h.Height(500))
                                                          .DataSource(dataSource => dataSource
                                                              .Ajax()
                                                              .Model(model =>
                                                              {
                                                                          model.Id(p => p.AssignTicket_HelpDeskId);
                                                                          model.Field(p => p.AssignTicket_HelpDeskId).Editable(false);
                                                                          model.Field(p => p.Age).Editable(false);
                                                                          model.Field(p => p.AssinedTo).Editable(false);

                                                                          model.Field(p => p.Role).Editable(false);
                                                                          model.Field(p => p.AssignedDate).Editable(false);
                                                                      })
                                                                  .Events(ev => ev
                                                                     .Error("error_handler(\"Assigngrid_#=CustomerTicket_HelpDeskId#\")")
                                                                     .RequestStart("onRequestStart(\"Assigngrid_#=CustomerTicket_HelpDeskId#\")")
                                                                     .RequestEnd("onRequestEnd(\"Assigngrid_#=CustomerTicket_HelpDeskId#\")"))

                                                              .Read(read => read.Action("AssignedHandlerForSelfCare_Read", "AssignTicket", new { Id = "#=CustomerTicket_HelpDeskId#" }).Data("sendForgery"))
                                                              .Create(create => create.Action("AssignTickets_Create", "AssignTicket", new { Id = "#=CustomerTicket_HelpDeskId#" }).Data("sendForgery"))
                                                              .Update(update => update.Action("Handler_Update", "Handler").Data("sendForgery"))
                                                              .Destroy(destroy => destroy.Action("AssignTickets_Destroy", "AssignTicket").Data("sendForgery"))
                                                          ).ToClientTemplate()
                                    )

                                </text>
                                          );

                           }).ToClientTemplate())


</script>



<script id="MaterialsUsed" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                           .Name("tabstrip_#AssignTicket_HelpDeskId#")
              .SelectedIndex(0)
              .Items(items =>
              {
                  items.Add().Text("Materials Used").Content(
                    @<text>
                        @* <legend>Measurement</legend>*@
                        @(Html.Kendo().Grid<MaterialsUsed>()
                                            .Name("MaterialUsed_#=AssignTicket_HelpDeskId#")
                         .Columns(columns =>
                         {
                                     columns.ForeignKey(c => c.MaterialItemsId, (System.Collections.IEnumerable)ViewData["Materials"], "MaterialItemsId", "ItemName").Title("Material Used").EditorTemplateName("MaterialUsedList");
                                     columns.Bound(c => c.Quantity);
                                     columns.Bound(c => c.Remark);
                                  
                          })
                                


                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Scrollable(h => h.Height(500))
                          .DataSource(dataSource => dataSource
                              .Ajax()

                                             .Events(events =>
                                             {
                                                         events.Error("error_handler(\"MaterialUsed_#=AssignTicket_HelpDeskId#\")");
                                                         events.RequestStart("onRequestStart(\"MaterialUsed_#=AssignTicket_HelpDeskId#\")");
                                                         events.RequestEnd("onRequestEnd(\"MaterialUsed_#=AssignTicket_HelpDeskId#\")");
                                                     })
                                                                      
                                     .Model(model =>
                                     {
                                                 model.Id(p => p.MaterialsUsedId);

                                             }
                                         )
                                                                            .Read(read => read.Action("MaterialsUseds_Read", "MaterialsUseds", new { id = "#=AssignTicket_HelpDeskId#" }).Data("sendForgery"))
                                                                            .Create(create => create.Action("MaterialsUseds_Create", "MaterialsUseds", new { id = "#=AssignTicket_HelpDeskId#" }).Data("sendForgery"))
                                                                            .Update(update => update.Action("MaterialsUseds_Update", "MaterialsUseds").Data("sendForgery"))
                                                                            .Destroy(destroy => destroy.Action("MaterialsUseds_Destroy", "MaterialsUseds").Data("sendForgery"))
                                                                ).ToClientTemplate()
                        )


                    </text>


                               );

                      }).ToClientTemplate())
</script>





