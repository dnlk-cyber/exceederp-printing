                 });*@

            if (dataItem.Status != "0") {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-update").remove();

                }
            if (dataItem.Status == "0") {
                $(this).find(".k-grid-confirm").hide();
            }
            if (dataItem.Status == "1") {
                $(this).find(".k-grid-edit").show();
                $(this).find(".k-grid-confirm").show();
                $(this).css("background-color", "yellow");
            }
            if (dataItem.Status == "1") {
                $(this).find(".k-grid-edit").show();
                $(this).find(".k-grid-confirm").hide();
                $(this).css("background-color", "yellow");
            }
            if (dataItem.Status == "2") {
                $(this).find(".k-grid-edit").show();
                $(this).find(".k-grid-confirm").hide();
                $(this).css("background-color", "aqua");
            }

            if (dataItem.Status == "3") {
                $(this).find(".k-grid-edit").show();
                $(this).find(".k-grid-confirm").hide();
                $(this).css("background-color", "gray");
            }
            if (dataItem.Status == "4") {
                $(this).find(".k-grid-edit").show();
                $(this).find(".k-grid-confirm").show();
                $(this).css("background-color", "red");
            }
            if (dataItem.Status == "5") {
                $(this).find(".k-grid-edit").show();
                $(this).find(".k-grid-confirm").show();
                $(this).css("background-color", "gold");
            }
            if (dataItem.IsClosed) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-confirm").hide();
                $(this).css("background-color", "gray");
            }
        });
       // grid.data("kendoGrid").dataSource.read();
