@using ExceedERP.Core.Domain.InfoDesk.Support
@using ExceedERP.Core.Domain.CRM
@model ExceedERP.Core.Domain.InfoDesk.Support.CustomerTicket_HelpDesk
@using ExceedERP.Core.Domain.InfoDesk
<form>
    <div class="container-fluid p-3">

        <!-- Row 1 -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="form-group">
                    <label class="k-label">@Html.Label("Ticket Type")</label>
                    @(Html.Kendo().DropDownListFor(model => model.TicketType_HelpDeskId)
                                .OptionLabel("Select Specific Ticket ...")
                                .DataTextField("Type")
                                .DataValueField("TicketType_HelpDeskId")
                                .Filter("contains")
                                .DataSource(source => source.Read(read => read.Action("GetSpecificTicket", "InfoDeskDataProvider").Data("sendForgery")))
                                .ValuePrimitive(true))
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label class="k-label">@Html.LabelFor(model => model.SupportGroup_HelpDeskId)</label>
                    @(Html.Kendo().DropDownListFor(model => model.SupportGroup_HelpDeskId)
                                .AutoBind(false)
                                .OptionLabel("Select")
                                .DataTextField("Name")
                                .DataValueField("SupportGroup_HelpDeskId")
                                .DataSource(source => source.Read(read => read.Action("GetSupportGroup", "InfoDeskDataProvider").Data("sendForgery")))
                                .ValuePrimitive(true))
                    @Html.ValidationMessageFor(model => model.SupportGroup_HelpDeskId)
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label class="k-label">@Html.LabelFor(model => model.FixedAssetCategoryId)</label>
                    @(Html.Kendo().DropDownListFor(model => model.FixedAssetCategoryId)
                                .OptionLabel("Select category...")
                                .DataTextField("Name")
                                .DataValueField("FixedAssetCategoryID")
                                .Filter("contains")
                                .ValuePrimitive(true)
                                .DataSource(source => source.Read(read => read.Action("GetCategory", "FixedAssetDataProvider", new { area = "FixedAsset" }))
                                                            .ServerFiltering(false)))
                    @Html.ValidationMessageFor(model => model.FixedAssetCategoryId, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <!-- Row 2 -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="form-group">
                    <label class="k-label">@Html.LabelFor(model => model.FixedAssetSubCategoryId)</label>
                    @(Html.Kendo().DropDownListFor(model => model.FixedAssetSubCategoryId)
                                .OptionLabel("Select Sub Category...")
                                .DataTextField("Name")
                                .DataValueField("FixedAssetSubCategoryID")
                                .Filter("contains")
                                .ValuePrimitive(true)
                                .CascadeFrom("FixedAssetCategoryId")
                                .DataSource(source => source.Read(read => read.Action("GetSubCategory", "FixedAssetDataProvider", new { area = "FixedAsset" }).Data("filterSubCategory"))
                                                            .ServerFiltering(true)))
                    @Html.ValidationMessageFor(model => model.FixedAssetSubCategoryId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label class="k-label">@Html.LabelFor(model => model.AssetRegistrationId)</label>
                    @(Html.Kendo().DropDownListFor(model => model.AssetRegistrationId)
                                .AutoBind(false)
                                .OptionLabel("Select Asset...")
                                .DataTextField("Name")
                                .DataValueField("AssetRegistrationId")
                                .Filter("contains")
                                .ValuePrimitive(true)
                                .CascadeFrom("FixedAssetSubCategoryId")
                                .Events(e => e.Change("onSelectFixedAssetId"))
                                .DataSource(source => source.Read(read => read.Action("GetFixedAssetForReturn", "FixedAssetDataProvider", new { area = "FixedAsset" }).Data("filterAssetsForReturn"))
                                                            .ServerFiltering(true)))
                    @Html.ValidationMessageFor(model => model.AssetRegistrationId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label class="k-label">@Html.LabelFor(model => model.ItemName)</label>
                    @(Html.Kendo().TextBoxFor(model => model.ItemName))
                    @Html.ValidationMessageFor(model => model.ItemName)
                </div>
            </div>
        </div>

        <!-- Row 3 -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="form-group">
                    <label class="k-label">@Html.LabelFor(model => model.TagNo)</label>
                    @(Html.Kendo().TextBoxFor(model => model.TagNo))
                    @Html.ValidationMessageFor(model => model.TagNo)
                </div>
            </div>
        </div>

        <!-- Row 4: Description -->
        <div class="row mb-4">
            <div class="col-md-1"></div>
            <div class="col-md-9">
                <div class="form-group">
                    <label class="k-label">@Html.LabelFor(model => model.Description)</label>
                    @Html.TextAreaFor(model => model.Description, new {
                        @class = "form-control rounded p-2",
                        style = "height:100px;font-family:Arial;color:red;"
                    })
                </div>
            </div>
        </div>

    </div>


</form>
