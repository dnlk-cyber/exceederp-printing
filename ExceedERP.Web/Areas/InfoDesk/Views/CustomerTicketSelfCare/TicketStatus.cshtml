@using ExceedERP.Core.Domain.InfoDesk.Support
@model ExceedERP.Core.Domain.InfoDesk.Support.CustomerTicket_HelpDesk
    <legend> Ticket Status</legend>
    <div class="row">
        <span class="panel">
            <label> Status :</label>  @(Html.Kendo().DropDownListFor(m => m.TicketStatus).Events(x => x.Change("FilterTicket")).OptionLabel("Select ")
.DataTextField("Text")
        .DataValueField("Value")
.BindTo(ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.Common.FinalizeType)))
         .ValuePrimitive(true)
            )
        </span>
    </div>
@(Html.Kendo().Grid<CustomerTicket_HelpDesk>()
          .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.CustomerTicket_HelpDeskId).Width(70).Title("#");
          // columns.ForeignKey(c => c.CustomerID, (System.Collections.IEnumerable)ViewData["CustomerList"], "CustomerID", "CustomerName").Width(150);
          columns.ForeignKey(c => c.TicketType_HelpDeskId, (System.Collections.IEnumerable)ViewData["TicketTypes"], "TicketType_HelpDeskId", "type").EditorTemplateName("SpecificTicket").Filterable(ftb => ftb.Multi(true).Search(true)).Width(180);
          columns.Bound(c => c.TicketPriority).HtmlAttributes(new { style = "background-color:#:PriorityColor#;" });
          //columns.Bound(c => c.StatusType); /*.HtmlAttributes(new { style = "background-color:#:StatusColor#;" })*/
          columns.Bound(c => c.SupportGroup_HelpDeskId);
          // columns.Bound(c => c.Source).Width(170);
          //   columns.Bound(c => c.DateRecieved).Width(170);
          //columns.Bound(c => c.DueDate).Width(150);
          columns.Bound(c => c.TicketStatus).Width(120);
          columns.Bound(c => c.Description).Width(190);
          columns.Bound(c => c.AssignedDate).Width(100).Title("Assigned Date");
          columns.Bound(c => c.ClosedDate).Width(100).Title("Closed Date");
          //columns.Bound(c => c.AgeOfTicket).Width(150);
          columns.Command(command => { }).Width(10);
      }).ToolBar(t => { t.Excel(); t.Pdf(); })
           .HtmlAttributes(new { style = "height: 520px;" })
           .Pageable(pageable => pageable
                 .Input(true)
                 .Numeric(false)
                 .Refresh(true)
                 .PageSizes(true)
                 .ButtonCount(5))
                 .Scrollable()
                 .Sortable()
                 .Filterable()
                 .Groupable()
                 .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.CustomerTicket_HelpDeskId))
              .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
              .Read(read => read.Action("CustomerTickets_Read", "CustomerTicket").Data("sendForgery"))
      )
)



<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>

<script>
    function FilterTicket(e) {
        event.preventDefault();
        var Status = $("#Status").data("kendoDropDownList").value();
          var grid = $('#grid').data('kendoGrid');
        

        if (Status != "") {
            grid.dataSource.filter({ field: "Status", operator: "eq", value: Status });
        } else {
            grid.dataSource.filter({});
        }
    }
     
    function FilterBySpecTicket(e) {
        event.preventDefault();
        var SpecificTicketTypeId= $("#SpecificTicketTypeId").data("kendoDropDownList").value();
        var grid = $('#grid').data('kendoGrid');


        if (SpecificTicketTypeId != 0) {
            grid.dataSource.filter({ field: "Specific Ticket Type", operator: "eq", value: SpecificTicketTypeId });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>