<script>
    function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "CustomerTicketSelfCare", new { area = "InfoDesk" })',
            data: { id: id },
            success: function(result) {
                alert(result.Message);
                location.reload(true);
            },
            error: function(result) {
                alert(result.Message);
            }
        });
    }
</script>
<script>
      function filterAssetsForReturn() {
       
        return {
            subCategoryCode: $("#FixedAssetSubCategoryId").val(),
            text: $("#AssetRegistrationId").data("kendoDropDownList").filterInput.val()
        };
    }

    function filterSubCategory() {

        return {
            categoryCode: $("#FixedAssetCategoryId").data("kendoDropDownList").value(),
            text: $("#FixedAssetSubCategoryId").data("kendoDropDownList").filterInput.val()
        };
    }

    function onSelectFixedAssetId() {
    var id = $("#AssetRegistrationId").data("kendoDropDownList").value();

    if (!id) return; // Skip if no selection

    $.ajax({
        type: "POST",
        url: '@Url.Action("GetAssetDetails", "FixedAssetDataProvider", new { area = "FixedAsset" })',
        data: { id: id },
        success: function (result) {
            // Fill form fields with returned asset data
            $("#TagNo").val(result.Tag).trigger("change");
            $("#ItemName").val(result.Name).trigger("change");
        },
        error: function (xhr, status, error) {
            console.error("Asset fetch failed:", error);
            alert("Unable to fetch asset details.");
        }
    });

    }

