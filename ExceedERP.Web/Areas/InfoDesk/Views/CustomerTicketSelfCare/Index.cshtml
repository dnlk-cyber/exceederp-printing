<script>
      //   if ($("#Source").val() == 1) {
       // }
    function onDataBound(e) {
        var grid = this;
        var Checkgrid = $("#grid").data("kendoGrid");
        var gridData = Checkgrid.dataSource.view();
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.TicketStatus != "0") {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-update").remove();
            }
            //if (dataItem.TicketStatus == "0") {
            //    $(this).find(".k-grid-confirm").show();
            //}
            //if (dataItem.Status == "1") {
            //    $(this).find(".k-grid-confirm").show();
            //    $(this).css("background-color", "yellow");
            //}
            if (dataItem.TicketStatus == "0") {
                $(this).find(".k-grid-confirm").hide();
                //$(this).find(".k-grid-delete").remove();
            }
            if (dataItem.Status == "1") {
                $(this).find(".k-grid-confirm").hide();
                $(this).css("background-color", "yellow");
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-update").remove();
            }
            if (dataItem.TicketStatus == "1") {
                $(this).find(".k-grid-confirm").hide();
                $(this).css("background-color", "yellow");
            }
            if (dataItem.TicketStatus == "2") {
                $(this).find(".k-grid-confirm").show();
                $(this).css("background-color", "aqua");
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-update").remove();
            }
            if (dataItem.TicketStatus == "3") {
                $(this).find(".k-grid-confirm").hide();
                $(this).css("background-color", "gray");
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-update").remove();
            }
           
            if (dataItem.TicketStatus == "4") {
                $(this).find(".k-grid-confirm").show();
                $(this).css("background-color", "red");
            }
            if (dataItem.TicketStatus == "5") {
                $(this).find(".k-grid-confirm").show();
                $(this).css("background-color", "gold");
            }
            if (dataItem.TicketStatus == "6") {
                $(this).css("background-color", "Orange");
            }
            if (dataItem.IsClosed) {
                $(this).find(".k-grid-confirm").hide();
                $(this).css("background-color", "gray");
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-update").remove();
            }
        });
    }
    function changeSource() {
        var value = $("#Source").val();
        if (value == 1) {
            $(".employee").removeClass("hidden");
        }
        if (value != 1 && !($(".employee").hasClass("hidden"))) {
            $(".employee").addClass("hidden");
        }
    }
    function filterCustomer() {
        return {
            CustomerId: $("#CustomerID").val()
        };
    }
</script>
