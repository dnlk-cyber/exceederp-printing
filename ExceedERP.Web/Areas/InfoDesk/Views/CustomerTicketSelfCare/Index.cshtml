@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.InfoDesk.Support
@model ExceedERP.Core.Domain.InfoDesk.Support.CustomerTicket_HelpDesk


<legend> Open Ticket</legend>
<div class="row">
    <p>
        <span class="fa fa-circle" style="color:yellow;"></span>&nbsp;&nbsp;Ticket Assigned &nbsp;&nbsp;
        <span class="fa fa-circle" style="color:aqua;"></span>&nbsp;&nbsp;Ticket Solved &nbsp;&nbsp;
        <span class="fa fa-circle" style="color:gray;"></span>&nbsp;&nbsp;Ticket Closed &nbsp;&nbsp;
        <span class="fa fa-circle" style="color:red;"></span>&nbsp;&nbsp;Ticket Not-Solved &nbsp;&nbsp;
        <span class="fa fa-circle" style="color:gold;"></span>&nbsp;&nbsp;Ticket Confirmed &nbsp;&nbsp;
        <span class="fa fa-circle" style="color:orange;"></span>&nbsp;&nbsp;Ticket Pending .&nbsp;&nbsp;
    </p>
</div>
@(Html.Kendo().Grid<CustomerTicket_HelpDesk>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.CustomerTicket_HelpDeskId).Title("#").Width(50);
          columns.ForeignKey(c => c.TicketType_HelpDeskId, (System.Collections.IEnumerable)ViewData["TicketTypes"], "TicketType_HelpDeskId", "Type")
                                    .EditorTemplateName("SpecificTicket")
                                    .Filterable(ftb => ftb.Multi(true).Search(true))
                                    .Width(150);
          columns.ForeignKey(c => c.EmployeeId, (System.Collections.IEnumerable)ViewData["Employees"], "EmployeeId", "FullNameaEnglish")
                                    .Filterable(ftb => ftb.Multi(true).Search(true))
                                    .Width(140);
          columns.ForeignKey(c => c.BranchId, (System.Collections.IEnumerable)ViewData["branchs"], "BranchId", "Name")
                             .Filterable(ftb => ftb.Multi(true).Search(true))
                             .Width(130);
          columns.ForeignKey(c => c.BusinessUnitId, (System.Collections.IEnumerable)ViewData["bUnit"], "BusinessUnitId", "Name")
                             .Filterable(ftb => ftb.Multi(true).Search(true))
                             .Width(130);
          columns.ForeignKey(c => c.OrgStructureId, (System.Collections.IEnumerable)ViewData["orgStructure"], "OrgStructureId", "Name")
                             .Filterable(ftb => ftb.Multi(true).Search(true))
                             .Width(130);
          columns.Bound(c => c.Description).Width(150);
          columns.Bound(c => c.TicketPriority).HtmlAttributes(new { style = "background-color:#:PriorityColor#;" })
                                .Filterable(ftb => ftb.Multi(true).Search(true))
                                .Width(100);
          columns.ForeignKey(c => c.SupportGroup_HelpDeskId, (System.Collections.IEnumerable)ViewData["Group"], "SupportGroup_HelpDeskId", "Name")
             .Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
          columns.Bound(c => c.TicketStatus)/*.HtmlAttributes(new { style = "background-color:#:StatusColor#;" })*/.Width(100);
          columns.Bound(c => c.DueDate).Width(120);
          columns.Bound(c => c.OverDue).Width(120);
          columns.Bound(c => c.RequesterIPAddress).Width(120);
          columns.ForeignKey(p => p.FixedAssetCategoryId, (System.Collections.IEnumerable)ViewData["Category"], "FixedAssetCategoryId", "CategoryName").Title("Category").EditorTemplateName("FixedAssetCategorySelector").Width(130);
          columns.ForeignKey(p => p.FixedAssetSubCategoryId, (System.Collections.IEnumerable)ViewData["SubCategory"], "FixedAssetSubCategoryID", "SubCategoryName").Title("Sub Category").EditorTemplateName("FixedAssetSubCategorySelector").Width(130);
          columns.ForeignKey(p => p.AssetRegistrationId, (System.Collections.IEnumerable)ViewData["FixedAsset"], "AssetRegistrationId", "Name").Title("Item").EditorTemplateName("FixedAssetReturnSelector").Width(130);
          columns.Bound(c => c.ItemName).Width(120);
          columns.Bound(c => c.TagNo).Width(120);
          columns.Bound(c => c.Remark).Width(120);
          columns.ForeignKey(c => c.AssignedTo, (System.Collections.IEnumerable)ViewData["Employees"], "AssignedTo", "FullNameaEnglish")
                                  .Filterable(ftb => ftb.Multi(true).Search(true))
                                  .Width(140);
          columns.Bound(c => c.ClosedDate).Width(100).Title("Closed Date");
          columns.Bound(c => c.Rate).Width(120);
          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
              command.Custom("confirm").Text("Confirm").Click("Confirmation").HtmlAttributes(new { @class = "btn-success" });
          }).Width(250);

      })
         .ToolBar(toolbar =>
         {
             toolbar.Create();
         }).Events(ev =>
         {
             ev.DataBound("onDataBound");
             ev.DetailExpand("onExpand");
         })
         .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("CustomerTicketEditor").Window(window =>
         {
             window.Title("Open Ticket");
             window.Scrollable(false);
         }))
              .HtmlAttributes(new { style = "height: 520px;" })
              .Pageable(pageable => pageable
                  .Input(true)
                  .Numeric(false)
                  .Refresh(true)
                  .PageSizes(true)
                  .ButtonCount(5))
              .Scrollable()
              .Sortable()
              .Filterable()
              .Scrollable(h => h.Height(500))
         .DataSource(dataSource => dataSource
             .Ajax()
              .Sort(x => x.Add(s => s.DateCreated).Descending())
                 //  .Group(x => x.Add(p => p.Status))
                 .Model(model =>
                 {
                     model.Id(p => p.CustomerTicket_HelpDeskId);
                     model.Field(p => p.TicketStatus).Editable(false);
                     model.Field(p => p.LastModified).Editable(false);
                     model.Field(p => p.ModifiedBy).Editable(false);
                     model.Field(p => p.DateCreated).Editable(false);
                     model.Field(p => p.CreatedBy).Editable(false);
                 })
                 .Events(ev => ev
                   .Error("error_handler(\"grid\")")
                   .RequestStart("onRequestStart(\"grid\")")
                   .RequestEnd("onRequestEnd(\"grid\")"))
             .Read(read => read.Action("CustomerTickets_Read", "CustomerTicketSelfCare").Data("sendForgery"))
             .Create(create => create.Action("CustomerTickets_Create", "CustomerTicketSelfCare").Data("sendForgery"))
             .Update(update => update.Action("CustomerTickets_Update", "CustomerTicketSelfCare").Data("sendForgery"))
             .Destroy(destroy => destroy.Action("CustomerTickets_Destroy", "CustomerTicketSelfCare").Data("sendForgery"))
           ).ClientDetailTemplateId("template")
)


