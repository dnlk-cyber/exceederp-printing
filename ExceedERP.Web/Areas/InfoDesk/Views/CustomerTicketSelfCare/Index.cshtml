<script>
    function onMasterDataBound(e) {
        var rows = e.sender.tbody.children();
        var masterRow = e.masterRow;
        var masterGrid = $("#grid").data("kendoGrid");
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsClosed === true) {
                row.css("background-color", "gray");
                //row.find(".k-grid-closeT").hide();
            }
            if (dataItem.Status == "4") {
              row.css("background-color", "red");
            }
        }
    }
    function UploadFile(id) {
        $("#masterId").val(id);
        var wnd = $("#UploadDoc").data("kendoWindow");
        wnd.center().open();
    }

</script>
@(Html.Kendo().Window()
        .Name("UploadDoc")
        .Title("Upload File")
        .Visible(false)
        .Modal(true)
        .Draggable(true)
        .Width(400).Content(
        @<text>
            <div class="form-group">
                <form action="@Url.Action("UploadSingleFiles", "CustomerTicketSelfCare", new { })" method="post" , new { enctype="multipart/form-data" }>
                    <input type="hidden" name="masterId" id="masterId">
                    <div class="row">
                        <div class="col-md-10">
                            @Html.TextBox("file", "", new { type = "file", required = "true" })
                            <br />
                        </div>
