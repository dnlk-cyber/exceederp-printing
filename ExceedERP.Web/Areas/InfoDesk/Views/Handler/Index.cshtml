@using ExceedERP.Core.Domain.InfoDesk.Support
@model ExceedERP.Core.Domain.InfoDesk.Support.CustomerTicket_HelpDesk


<legend>Handler</legend>
<hr/>

@(Html.Kendo().Grid<CustomerTicket_HelpDesk>
        ()
        .Name("grid")
        .Columns(columns =>
        {
            columns.Bound(c => c.CustomerTicket_HelpDeskId).Width(50).Title("#");
            columns.ForeignKey(c => c.EmployeeId, (System.Collections.IEnumerable)ViewData["Employees"], "EmployeeId", "FullNameaEnglish").Title("Requester").Width(180);

            columns.Bound(c => c.Description).Width(120);
            columns.Bound(c => c.Priority).HtmlAttributes(new { style = "background-color:#:PriorityColor#;" }).Width(70);
            //columns.ForeignKey(c => c.TicketDefintion, (System.Collections.IEnumerable)ViewData["TicketDefActivity"], "TicketActivityDefinitionID", "Description").EditorTemplateName("TicketActivityDefinition").Width(150);

            columns.Bound(c => c.Status)/*.HtmlAttributes(new { style = "background-color:#:StatusColor#;" })*/.Width(80);
            columns.Bound(c => c.TicketGroup).Width(120);


            //columns.Command(
            //    command => {
            //        command.Edit().UpdateText("Update").CancelText("Cancel").Text("Edit");
            //    }).Width(200);
        })

        .Editable(editable => editable.Mode(GridEditMode.InLine).TemplateName("CustomerTicketEditor").Window(window =>
        {
            window.Title("Open Customer Ticket");
            window.Scrollable(false);

        }))
        .HtmlAttributes(new { style = "height: 520px;" })

         .Events(events =>
         {
             events.DetailExpand("onDetailExpandUser");
             events.DataBound("onMasterDataBound");
         })

        .Pageable(pageable => pageable
        .Input(true)
        .Numeric(false)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5))

        .Scrollable()
        .Sortable()
        .Filterable()
        //   .Groupable().Events(ev => ev.DetailExpand("MasterOnExpand"))
        .Scrollable(h => h.Height(500))
        .DataSource(dataSource => dataSource
        .Ajax()
        .Sort(x => x.Add(s => s.DateCreated).Descending())
        //  .Group(x => x.Add(p => p.Status))
        .Model(model =>
        {
            model.Id(p => p.CustomerTicket_HelpDeskId);
            model.Field(p => p.Status).Editable(false);
            model.Field(p => p.LastModified).Editable(false);

            model.Field(p => p.ModifiedBy).Editable(false);
            model.Field(p => p.DateCreated).Editable(false);
            model.Field(p => p.CreatedBy).Editable(false);
            model.Field(p => p.CustomerTicket_HelpDeskId).Editable(false);
            model.Field(p => p.Description).Editable(false);
            model.Field(p => p.Priority).Editable(false);
            // model.Field(p => p.StatusType).Editable(false);
            model.Field(p => p.TicketGroup).Editable(false);
        })
        .Events(ev => ev
        .Error("error_handler(\"grid\")")
        .RequestStart("onRequestStart(\"grid\")")
        .RequestEnd("onRequestEnd(\"grid\")"))
            .Read(read => read.Action("CustomerPendingTickets_Read", "Handler"))
        //.Create(create => create.Action("CustomerTickets_Create", "Handler"))
        //.Update(update => update.Action("CustomerTickets_Update", "Handler"))
        //.Destroy(destroy => destroy.Action("CustomerTickets_Destroy", "Handler"))
        ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                                            .Name("tabstrip_#=CustomerTicket_HelpDeskId#")
            .SelectedIndex(0)
            .Items(items =>
            {
            items.Add().Text("  Ticket  ").Content(
                @<text>

                    @(Html.Kendo().Grid<AssignTicket_HelpDesk>()
                                      .Name("Assigngrid_#=CustomerTicket_HelpDeskId#")
                          .Columns(columns =>
                          {
                              // columns.Bound(c => c.AssignTicket_HelpDeskId).Width(100);

                              columns.ForeignKey(c => c.AssinedTo, (System.Collections.IEnumerable)ViewData["AssignTo"], "EmployeeId", "FullNameaEnglish").Title("Assigned To").EditorTemplateName("EmployeesList").Width(120);
                              columns.Bound(c => c.Role).Width(100);
                              columns.Bound(c => c.AssignedDate).Width(100);
                              // columns.Bound(c => c.Age).Width(80);
                              columns.Bound(c => c.Solution).Width(120);

                              columns.Command(command =>
                              {
                                  command.Edit();
                                  command.Custom("sendF").Text(" ").Click("SendForClosing").IconClass("k-icon k-i-forward").HtmlAttributes(new { @class = "btn btn-primary ", title = "Send for Closing", id = "sendForApproval" });

                              }).Width(180);
                          })

                          .Events(ev =>
                          {
                              ev.DataBound("DetailDataBound");
                               ev.DetailExpand("OnDetailDetailExpand");

                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))

                           .ClientDetailTemplateId("MaterialsUsed")

                                      //    }))

                                      .Scrollable(h => h.Height(500))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Model(model =>
                              {
                                  model.Id(p => p.AssignTicket_HelpDeskId);
                                  model.Field(p => p.AssignTicket_HelpDeskId).Editable(false);
                                  model.Field(p => p.Age).Editable(false);
                                  model.Field(p => p.AssinedTo).Editable(false);

                                  model.Field(p => p.Role).Editable(false);
                                  model.Field(p => p.AssignedDate).Editable(false);
                              })
                                  .Events(ev => ev
                                     .Error("error_handler(\"Assigngrid_#=CustomerTicket_HelpDeskId#\")")
                                     .RequestStart("onRequestStart(\"Assigngrid_#=CustomerTicket_HelpDeskId#\")")
                                     .RequestEnd("onRequestEnd(\"Assigngrid_#=CustomerTicket_HelpDeskId#\")"))

                              .Read(read => read.Action("AssignedHandler_Read", "AssignTicket", new { Id = "#=CustomerTicket_HelpDeskId#" }))
                              .Create(create => create.Action("AssignTickets_Create", "AssignTicket", new { Id = "#=CustomerTicket_HelpDeskId#" }))
                              .Update(update => update.Action("Handler_Update", "Handler"))
                              .Destroy(destroy => destroy.Action("AssignTickets_Destroy", "AssignTicket"))
                          ).ToClientTemplate()
                    )

                </text>
                                );


                //*****************************************************************************************************//
            }).ToClientTemplate())
</script>



