@using ExceedERP.Core.Domain.InfoDesk.Support
<legend>Handler</legend>
<hr/>
@(Html.Kendo().Grid<CustomerTicket_HelpDesk>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.CustomerTicket_HelpDeskId).Width(50).Title("#");
          columns.ForeignKey(c => c.EmployeeId, (System.Collections.IEnumerable)ViewData["Employees"], "EmployeeId", "FullNameaEnglish").Title("Requester").Filterable(ftb => ftb.Multi(true).Search(true)).Width(180);
          columns.Bound(c => c.DueDate).Width(120);
          columns.Bound(c => c.OverDue).Width(120);
          columns.Bound(c => c.Description).Width(120);
          columns.Bound(c => c.TicketPriority).HtmlAttributes(new { style = "background-color:#:PriorityColor#;" }).Width(70);
          columns.Bound(c => c.TicketStatus)/*.HtmlAttributes(new { style = "background-color:#:StatusColor#;" })*/.Width(80);
          columns.ForeignKey(c => c.SupportGroup_HelpDeskId, (System.Collections.IEnumerable)ViewData["Group"], "SupportGroup_HelpDeskId", "Name").Title("Group").Filterable(ftb => ftb.Multi(true).Search(true)).Width(180);
          columns.Bound(c => c.RequesterIPAddress).Width(150);
          columns.Bound(c => c.PendingReason).Width(150);
          columns.Command(
             command =>
             {
                 command.Custom("pend").Text("Pend").Click("pendTicket").HtmlAttributes(new { @class = "btn btn-primary", @title = "pend Ticket " });

                 //command.Edit().UpdateText("Update").CancelText("Cancel").Text("Edit");

             }).Width(200);


      })
      .Editable(editable => editable.Mode(GridEditMode.InLine).TemplateName("CustomerTicketEditor").Window(window =>
      {
          window.Title("Open Customer Ticket");
          window.Scrollable(false);

      }))
      .HtmlAttributes(new { style = "height: 520px;" })
      .Events(events =>
      {
          events.DetailExpand("onDetailExpandUser");
          events.DataBound("onMasterDataBound");
      })
      .Pageable(pageable => pageable
      .Input(true)
      .Numeric(false)
      .Refresh(true)
      .PageSizes(true)
      .ButtonCount(5))
      .Scrollable()
      .Sortable()
      .Filterable()
        //   .Groupable().Events(ev => ev.DetailExpand("MasterOnExpand"))
        .Scrollable(h => h.Height(500))
        .DataSource(dataSource => dataSource
        .Ajax()
        .Sort(x => x.Add(s => s.DateCreated).Descending())
        //  .Group(x => x.Add(p => p.Status))
        .Model(model =>
        {
            model.Id(p => p.CustomerTicket_HelpDeskId);
            model.Field(p => p.TicketStatus).Editable(false);
            model.Field(p => p.LastModified).Editable(false);
            model.Field(p => p.ModifiedBy).Editable(false);
            model.Field(p => p.DateCreated).Editable(false);
            model.Field(p => p.CreatedBy).Editable(false);
            model.Field(p => p.CustomerTicket_HelpDeskId).Editable(false);
            model.Field(p => p.Description).Editable(false);
            model.Field(p => p.TicketPriority).Editable(false);
            // model.Field(p => p.StatusType).Editable(false);
            model.Field(p => p.SupportGroup_HelpDeskId).Editable(false);
        })
        .Events(ev => ev
        .Error("error_handler(\"grid\")")
        .RequestStart("onRequestStart(\"grid\")")
        .RequestEnd("onRequestEnd(\"grid\")"))
        .Read(read => read.Action("Handler_Read", "Handler").Data("sendForgery"))
        //.Create(create => create.Action("CustomerTickets_Create", "Handler").Data("sendForgery"))
        //.Update(update => update.Action("CustomerTickets_Update", "Handler").Data("sendForgery"))
        //.Destroy(destroy => destroy.Action("CustomerTickets_Destroy", "Handler").Data("sendForgery"))
        ).ClientDetailTemplateId("template")
)
