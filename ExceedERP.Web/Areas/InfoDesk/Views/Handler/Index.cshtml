<script>
    function DetailDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            if (dataItem.IsSendForClosing) {
                //answer.hide(true);
                //transfer.hide(true);
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-sendF").hide();
                row.css("background-color", "yellow");
                //$(".k-grid-top", gridName).hide();
            }
            if (dataItem.IsSolved) {
                //answer.hide(true);
                //transfer.hide(true);
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-sendF").hide();
                row.css("background-color", "gray");
                //$(".k-grid-top", gridName).hide();
            }
            //else {
            //      //row.find(".k-grid-edit").show();
            //    // row.css("background-color", "red");
            //}
        }
    }
    function onMasterDataBound(e) {
        var rows = e.sender.tbody.children();
        var masterRow = e.masterRow;
        var masterGrid = $("#grid").data("kendoGrid");
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.TicketStatus == "0") {
                row.find(".k-grid-edit").show();

            }
            if (dataItem.TicketStatus == "1") {
                row.find(".k-grid-edit").show();
                row.find(".k-grid-pend").show();
                row.css("background-color", "yellow");
            }
            if (dataItem.TicketStatus == "2") {
                row.find(".k-grid-edit").show();
                row.find(".k-grid-pend").hide();
                row.css("background-color", "aqua");
            }
            if (dataItem.TicketStatus == "3") {

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-pend").hide();
                row.css("background-color", "gray");
            }
            if (dataItem.TicketStatus == "4") {
                row.find(".k-grid-edit").hide();
               // row.find(".k-grid-closeT").hide();
                row.css("background-color", "red");
            }
            if (dataItem.TicketStatus == "5") {
                row.find(".k-grid-edit").show();

                // row.find(".k-grid-closeT").hide();
                row.css("background-color", "gold");
            }
            if (dataItem.TicketStatus == "6") {
                $(this).css("background-color", "Orange");
                row.find(".k-grid-pend").hide();

            }
            if (dataItem.IsClosed) {
                row.find(".k-grid-edit").hide();
               // row.find(".k-grid-closeT").hide();
                row.css("background-color", "gray");
            }
        }
    }
</script>
<script>   
     function OnDetailDetailExpand(e) {
         e.preventDefault();
         // debugger;         
         var masterRow = e.masterRow;         
         var masterGrid = $("#Assigngrid_" + CurtomerTicketId_Global).data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);         
         masterId = masterDataItem.CustomerTicket_HelpDeskId;
        var gridName = "#MaterialUsed_" + masterId;
        //   var detailGrid = $(gridName).data("kendoGrid");
        console.log("first");
        $.ajax({
            url: '@Url.Action("CheckStatus", "Handler")',
            data: { masterId: CurtomerTicketId_Global },
            type: 'POST',
            cache: false,
            success: function (result) {
                console.log("second");
                r = result;
                if (r == "true") {
                    console.log("second -second ");
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", gridName).show();
                }
                console.log("third");
            }
        });
    }
    function pendTicket(e)
    {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        if (!dataItem) {
            alert("Please select a row first!");
            return;
        }

        var id = dataItem.CustomerTicket_HelpDeskId;

        if (confirm("Are you sure you want to pend this ticket?")) {
            var acceptedReason = prompt("Please provide a reason for Pending:");
        
            // Check if the user entered a reason
            if (!acceptedReason || acceptedReason.trim() === "") {
                alert("Pending reason is required.");
                return;
            }

            $.ajax({
                url: '@Url.Action("PendingTicket", "Handler")',
                type: 'POST',
                data: { id: id, reason: acceptedReason }, // ✅ Fixed typo (reason instead of resaon)
                cache: false,
                success: function (result) {
                    alert(result.Message);
                    $("#grid").data("kendoGrid").dataSource.read(); // ✅ Refresh grid after success
                },
                error: function (xhr, status, error) {
                    alert("Error: " + xhr.responseText);
                }
            });
        }

    }

