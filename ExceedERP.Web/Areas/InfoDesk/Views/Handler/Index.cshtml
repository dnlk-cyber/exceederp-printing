<script id="MaterialsUsed___" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
      .Name("tabstrip_#AssignTicket_HelpDeskId#")
      .SelectedIndex(0)
      .Items(items =>
      {
          items.Add().Text("Materials Used").Content(
            @<text>
                @(Html.Kendo().Grid<MaterialsUsed>()
                 .Name("MaterialUsed_#=AssignTicket_HelpDeskId#")
                 .Columns(columns =>
                 {
                     columns.ForeignKey(c => c.MaterialItemsId, (System.Collections.IEnumerable)ViewData["Materials"], "MaterialItemsId", "ItemName").Title("Material Used").EditorTemplateName("MaterialUsedList").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                     columns.Bound(c => c.Quantity).Width(120);
                     columns.Bound(c => c.Remark).Width(120);
                     columns.Command(command =>
                     {
                         command.Edit(); command.Destroy();
                     }).Width(180);
                 })
                  .ToolBar(toolbar =>
                  {
                      toolbar.Create();
                  })


