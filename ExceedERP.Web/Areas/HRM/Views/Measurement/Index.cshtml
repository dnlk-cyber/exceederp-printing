@using System.Collections
@using System.Security.AccessControl
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Measurement</legend>
@(Html.Kendo().Grid<Measurement>()
          .Name("Measurementgrid")
      .Columns(columns =>
      {
        columns.Bound(c => c.MesPercentageofWeight);
        columns.Bound(c => c.Remark);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
               .Events(events =>
                                                                             {
                                                                                 events.Error("error_handler(\"Measurementgrid\")");
                                                                                 events.RequestStart("onRequestStart(\"Measurementgrid\")");
                                                                                 events.RequestEnd("onRequestEnd(\"Measurementgrid\")");
                                                                             })
                      
          .Model(model => model.Id(p => p.MeasurementId))
          .Read(read => read.Action("Measurements_Read", "Measurement"))
          .Create(create => create.Action("Measurements_Create", "Measurement"))
          .Update(update => update.Action("Measurements_Update", "Measurement"))
          .Destroy(destroy => destroy.Action("Measurements_Destroy", "Measurement"))
      )
)
