<script>
    function GetDepartment() {

        var Titles = $("#OrgStructureId").data("kendoDropDownList");
        var OrgId = Titles.value();
        var jobs = $("#LookupId").data("kendoDropDownList");
        var title = jobs.value();
        $.ajax({
            url: '@Url.Action("GetDepartments", "EmployeePlacmentWithOJ")',

            data: { OrgId: OrgId, title: title },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                var s = r.split(/-/);

                $("#Salary").val(s[0]);
                $("#RankId").val(Number( s[1]));
                $("#StepId").val(Number(s[2]));
            }

        });
    }

</script>
