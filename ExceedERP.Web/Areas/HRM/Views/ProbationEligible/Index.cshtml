<script>

    function onDataBound(e) {

        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check

            if (dataItem.isCurrent === true && dataItem.IsPend === false) {
                row.find("#pend").show();
                row.find("#unpend").hide();
            }
            else if (dataItem.isCurrent === true && dataItem.IsPend === true) {
                row.css("background-color", "gray");
                row.find("#pend").hide();
                row.find("#unpend").show();
            }
            else if (dataItem.isCurrent === false) {
                row.find("#pend").hide();
                row.find("#unpend").hide();
            }
            if (dataItem.IsApprove === true) {
                row.find("#approveplacement").hide();
            }
            if (dataItem.IsApprove === false) {
                row.css("background-color", "#FF842D");

            }
            if (dataItem.Age > 60) {

                row.css("background-color", "olive");

            }
        }
    }

    function updateProbationEligible(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.ProbationPerformanceId;

    if (id.length !== 0) {
        $('#loading-image').show();

        $.ajax({
            url: '@Url.Action("UpdateEmployeeProbationStatus", "ProbationEligible")',
            data: { id: id },
            type: 'POST',
            cache: false,
            success: function (result) {
                alert(result.Message);
                $('#loading-image').hide();
                grid.dataSource.read();
            },
            error: function (xhr, status, error) {
                console.error("Error:", error);
                alert("An error occurred while processing your request.");
                $('#loading-image').hide();
            }
        });
    } else {
        alert("Invalid ID.");
    }
}

