<script>
    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (model.IsAcceptedByEmployee || model.IsRejectedByEmployee) {
                $(this).find(".k-grid-cmd-approve-request").hide();
                $(this).find(".k-grid-cmd-reject-request").hide();
            }

        });


    }


</script>

<script>
    function evaluationAcceptByEmployee(e) {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        var year = dataItem.GlFiscalYearId;
        var period = dataItem.GlPeriodId;
        var employee = dataItem.EmployeeId;
        var employeePerformanceId = dataItem.EmployeePerformanceId;
        var AcceptedReason = prompt("Please provide a reason for Acceptance:");

        $('#loading-image').show(); {
            var conf = confirm("Are you sure you want to approve this quarter performance evaluation");
            if (conf === true) {
                $('#loading-image').show();

                $.ajax({
                    url: '@Url.Action("AcceptedEvaluation", "EmployeePerformancePersonalSummaries")',
                    //contentType: "application/json; charset=utf-8",
                    //data: { year: year, period: period, employee: employee, reason: AcceptedReason},
                    data: { employeePerformanceId: employeePerformanceId, reason: AcceptedReason},
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        r = result;
                        $('#loading-image').hide();
                        if (r === "true") {
                            alert("Successfully Approved");
                            grid.dataSource.read();
                        }
                        else {
                            alert("not Approved");
                            grid.dataSource.read();
                        }

                    },
                    error: function (xhr, status, error) {
                        $('#loading-image').hide();
                        alert("An error occurred: " + error);
                    }

                });
            }

        }

    }

