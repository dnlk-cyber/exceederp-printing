    //rejection re
    function RejectionReasons(e) {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));

        var yearId = dataItem.GlFiscalYearId;
        var periodId = dataItem.GlPeriodId;
        var employeeId = dataItem.EmployeeId;
        var employeePerformanceId = dataItem.EmployeePerformanceId;

        // Prompt the user for rejection reason
        var rejectionReason = prompt("Please provide a reason for rejection:");

        if (rejectionReason !== null) {
            // Perform further actions with rejectionReason, e.g., send it to the server
            $.ajax({
                url: '@Url.Action("RejectionReason_Create", "EmployeePerformancePersonalSummaries")',
                method: 'POST',
                //data: { yearId: yearId, periodId: periodId, employeeId: employeeId, reason: rejectionReason },
                data: { employeePerformanceId: employeePerformanceId, reason: rejectionReason },
                success: function (response) {
                    // Handle success
                    alert("Employee rejected with reason: " + rejectionReason);
                },
                error: function (error) {
                    // Handle error
                    alert("Error occurred during rejection.");
                }
            });
        }
        else {
            // User canceled the rejection
            alert("Rejection canceled by the user.");
        }
    }
</script>

