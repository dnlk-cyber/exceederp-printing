
@using System.Collections
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPerformance_EmployeePerformance</legend>
@(Html.Kendo().Grid<EmployeePerformance>()
            .Name("EmployeePerformancegrid")
            .Columns(columns =>
            {
                columns.Bound(c => c.EmployeePerformanceId).Title("#").Width(80);
                columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").Width(200).EditorTemplateName("EmployeeLists").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["fiscalYearList"], "GlFiscalYearId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).EditorTemplateName("GLYearSelector").Width(120);
                columns.ForeignKey(c => c.GlPeriodId, (IEnumerable)ViewData["Period"], "QuarterId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                columns.ForeignKey(c => c.EvaluationCriteriaTypeId, (IEnumerable)ViewData["EvalutionCrateria"], "MeasurementDefinitionId", "Name").Width(170);
                columns.Bound(c => c.Weight).Width(80);
                columns.Bound(c => c.Result).Width(80);
                columns.Bound(c => c.Date).Width(120);
                columns.Bound(c => c.DeadLine).Width(120);
                columns.Bound(c => c.IsApproved).ClientTemplate(
                    "<input type='checkbox' disabled = 'true' value='#=IsApproved#' " +
                    "#if(IsApproved) { #" +
                    "checked='checked'" +
                    "# } #" +
                    "/>").Title("Is Submitted").Width(120);
                columns.Bound(c => c.IsAcceptedByEmployee).ClientTemplate(
                    "<input type='checkbox' disabled = 'true' value='#=IsAcceptedByEmployee#' " +
                    "#if(IsAcceptedByEmployee) { #" +
                    "checked='checked'" +
                    "# } #" +
                    "/>").Title("Is Accepted").Width(120);
                columns.Bound(c => c.IsRejectedByEmployee).ClientTemplate(
                    "<input type='checkbox' disabled = 'true' value='#=IsRejectedByEmployee#' " +
                    "#if(IsRejectedByEmployee) { #" +
                    "checked='checked'" +
                    "# } #" +
                    "/>").Title("Is Rejected").Width(120);
                columns.Bound(c => c.Remark).Width(80);


                columns.Command(command =>
                {
                    command.Custom("cmd-approve-request").IconClass("fa fa-check ").Text("Accept").Click("evaluationAcceptByEmployee").HtmlAttributes(new { @class = "btn btn-success" });
                    command.Custom("cmd-reject-request").Text(Resources.Enum_RequestStatus_REJECT).IconClass("fa fa-close").Click("RejectionReasons").HtmlAttributes(new { @class = "btn btn-danger" });


                }).Width(100);

            })

            .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Filterable()
            .Scrollable(h => h.Height("auto"))
            .Events(ev => ev.DataBound("onDataBound"))
            .Pageable(pageable => pageable
                //.Input(true)
                // .Numeric(false)
                .Refresh(true)
                //.PageSizes(true)
                // .ButtonCount(5)
                )

            .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events =>
                {
                    events.Error("error_handler(\"EmployeePerformancegrid\")");
                    events.RequestStart("onRequestStart(\"EmployeePerformancegrid\")");
                    events.RequestEnd("onRequestEnd(\"EmployeePerformancegrid\")");
                })
                .Model(model =>
                {
                    model.Id(p => p.EmployeePerformanceId);
                    model.Field(p => p.EmployeePerformanceId).Editable(false);
                    model.Field(p => p.Result).Editable(false);


                })
            .Read(read => read.Action("EmployeePerformancePersonalSummaries_Read", "EmployeePerformancePersonalSummaries"))
            ).ClientDetailTemplateId("employee_performance_template")
)

