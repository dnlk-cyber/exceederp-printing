                  .Name("ReferralFormgrid_#=MedicalRequestId#")
      .Columns(columns =>
      {

          columns.Bound(c => c.ReferredDateAmharic).EditorTemplateName("Calander").Width(120);
          columns.Bound(c => c.ReferredTime).Width(120);
          columns.Bound(c => c.ReturnedDateAmharic).EditorTemplateName("Calander").Width(120);
          columns.Bound(c => c.ReturnedTime).Width(150);
          columns.Bound(c => c.Remark).Width(120);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                  .Editable(editable => editable.Mode(GridEditMode.InLine ))//.TemplateName("ReferralForm").Window(window => { window.Title("Transfer Patient to clinic"); window.Scrollable(false); }))
          .Scrollable(h => h.Height(500))
    .Events(x =>
    {
        x.Edit("GetDate");
        x.Save("GetDate");
    })
      .DataSource(dataSource => dataSource
          .Ajax()
                    .Events(events =>
                    {
                        events.Error("error_handler(\"ReferralFormgrid_#=MedicalRequestId#\")");
                        events.RequestStart("onRequestStart(\"ReferralFormgrid_#=MedicalRequestId#\")");
                        events.RequestEnd("onRequestEnd(\"ReferralFormgrid_#=MedicalRequestId#\")");
                    })

          .Model(model => model.Id(p => p.ReferralFormId))
          .Read(read => read.Action("ReferralForm_Read", "ReferralForm",new {id ="#=MedicalRequestId#"}))
          .Create(create => create.Action("ReferralForm_Create", "ReferralForm",new {id ="#=MedicalRequestId#"}))
          .Update(update => update.Action("ReferralForm_Update", "ReferralForm"))
          .Destroy(destroy => destroy.Action("ReferralForm_Destroy", "ReferralForm"))
      ).ToClientTemplate()
    )
                   )


                </text>
                  );
              //*****************************************************************************************************//

          }).ToClientTemplate())
</script>

