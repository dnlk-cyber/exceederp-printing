@using System.Collections
@using ExceedERP.Core.Domain.HRM.HealthAndInsurance
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization 
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorSelfCare_MedicalRequests</legend>
@(Html.Kendo().Grid<MedicalRequest>()
          .Name("MedicalRequestgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(200);
        columns.Bound(c => c.DateAmharic).Width(200);
        columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["OrgStructureId"], "OrgStructureId", "Name").EditorTemplateName("Organization").Width(250);
        columns.Bound(c => c.Remark);
        columns.Command(command =>
        {
            
            
            //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel);
        }).Width(180);
      })
      .ToolBar(toolbar => {
           // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("MedicalRequest").Window(window => { window.Title(Resources.NavigatorSelfCare_MedicalRequests); window.Scrollable(false); }))
        .Scrollable(h => h.Height(500))
                         .Groupable()
                                  .Sortable(sortable =>
                                  {
                                      sortable.SortMode(GridSortMode.SingleColumn);
                                  })
                                       .Events(events => events.DetailExpand("onDetailExpandUser"))
                      .Filterable()
                           .Events(events => events.DetailExpand("onDetailExpandUser"))
                         .Pageable(pageable => pageable
                                                    .Input(true)
                                                    .Numeric(false)
                                                    .Refresh(true)
                                                    .PageSizes(true)
                                                    .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Events(events =>
    {
        events.Error("error_handler(\"MedicalRequestgrid\")");
        events.RequestStart("onRequestStart(\"MedicalRequestgrid\")");
        events.RequestEnd("onRequestEnd(\"MedicalRequestgrid\")");
    })
                        
          .Model(model => model.Id(p => p.MedicalRequestId))
              .Read(read => read.Action("MedicalRequest_Read", "MedicalRequestStatus"))
              .Create(create => create.Action("MedicalRequest_Create", "MedicalRequestStatus"))
              .Update(update => update.Action("MedicalRequest_Update", "MedicalRequestStatus"))
              .Destroy(destroy => destroy.Action("MedicalRequest_Destroy", "MedicalRequestStatus"))
          ).ClientDetailTemplateId("template")
      )


<script id="template" type="text/kendo-tmpl">
