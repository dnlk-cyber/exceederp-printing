    function sync_handler(e) {
        this.read();
    }
        function AssignDate() {
            var list = AssignDates();
            return list;
        }
      function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#ReferredDateAmharic").trigger("change");
        $("#ReturnedDateAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
