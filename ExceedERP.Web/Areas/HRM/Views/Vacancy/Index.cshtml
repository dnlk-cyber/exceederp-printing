<Script>
    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsActive == false) {

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-close").hide();
                row.find(".k-grid-open").show();
                row.css("background-color", "gray");
            }
            else {
                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").show();
                row.find(".k-grid-close").show();
                row.find(".k-grid-open").hide();
                row.css("background-color", "");
            }
            //if (dataItem.Status === 0) {

            //    row.css("background-color", "red");

            //} else {
            //    row.css("background-color", "green");
            //}

        }

    }
    function AssignDate() {
        var list = AssignDates();
        return list;
    }
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#FromVacAm").trigger("change");
        $("#ToVacAm").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "Vacancy")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
</Script>
