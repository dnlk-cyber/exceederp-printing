<script>
    function terminate(e) {

        var row = $(e.target).closest("tr");
        var grid = $("#VaccancyPlangrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.VacancyId;

        if (id.length !== 0) {
            $.ajax({
                url: '@Url.Action("Close", "Vacancy")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;

                        alert(r);

                    grid.dataSource.read();
                }



            });

        }
    }

    function forchOpen(e) {

        var row = $(e.target).closest("tr");
        var grid = $("#VaccancyPlangrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.VacancyId;

        if (id.length !== 0 )
        {
            $.ajax({
                url: '@Url.Action("ForceOpen", "Vacancy")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;

                        alert(r);

                    grid.dataSource.read();
                }



            });

        }
    }
</script>
<script>
    function GetWorkUnits() {
        $("#OrgStructureId").val(0);
        var BranchId = $("#BranchId").data("kendoDropDownList");
        var branch = BranchId.value();



        if (branch.length !== 0 )
        {

            $.ajax({
                url: '@Url.Action("GetWorkUnitFromRecruitmentPlan", "HRMDataProvider")',

                data: { branch: branch},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    $("#OrgStructureId").val(r).trigger("change");
                }



            });

        }
    }

</script>
