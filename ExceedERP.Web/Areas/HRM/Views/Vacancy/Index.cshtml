<legend >@Resources.Navigator_Recruitment_Vacancy</legend>

@(Html.Kendo().Grid<Vacancy>()
      .Name("VaccancyPlangrid")
      .Columns(columns =>
      {
          //columns.Bound(c => c.VacancyId).Width(130);
          @*columns.Bound(c => c.IsComplete).Template(@<text></text>).ClientTemplate("<input type='checkbox' #= Check ? checked='checked':'' # class='chkbx' />")
                              .HeaderTemplate("<input type='checkbox' id='masterCheckBox' onclick='checkAll(this)'/>").Width(60);*@
          columns.Bound(c => c.VaccancyCode).Width(120);
          columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsActive ? checked='checked' :'' # >").Width(100);
          columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "AmharicName").EditorTemplateName("BranchSelectorFromPlan").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
          //columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").EditorTemplateName("OrganizationDept").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
          // columns.ForeignKey(c => c.RecruitmentPlanId, (IEnumerable)ViewData["Recruitments"], "RecruitmentPlanId", "JobTitle").EditorTemplateName("RecruitmentPlan").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
          // columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLYearSelector").Width(80);
          columns.Bound(c => c.RecruSource).EditorTemplateName("Enum").Width(150);
          //columns.Bound(c => c.FromVacAm).EditorTemplateName("Calander").Width(150);
          //columns.Bound(c => c.ToVacAm).EditorTemplateName("Calander").Width(150);
          columns.Bound(c => c.From).Width(150);
          columns.Bound(c => c.To).Width(150);
          // columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["Media"], "LookupId", "Description").Width(90).EditorTemplateName("Media");
          columns.Bound(c => c.VacancyType).EditorTemplateName("Enum").Width(120);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
              {
                  command.Custom("open").Text(Resources.Button_Force_Open).Click("forchOpen");
                  command.Custom("close").Text(Resources.Payroll_Process_Close).Click("terminate");

                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("HR_Recruitment_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          }).Width(300);

      })

      .ToolBar(toolbar =>
      {


      toolbar.Template(@<text>
                               
  @if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
  {
 
      @item.CreateButton(Resources.ActionButton_AddNewRecord)
      @*@item.SaveButton()*@
  }

        </text>);


      })

      .Filterable()
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Vacancy"))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })

                .Events(e =>
                {
                    e.Save("GetDate");
                    e.Edit("GetDate");
                    e.DataBound("onDataBound");
                })
      .Scrollable(h => h.Height(500))
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .DataSource(dataSource => dataSource
                .Ajax()
              //.Batch(true)
              //.ServerOperation(false)
              .Sort(sort => sort.Add("VacancyId").Descending())
          .Events(events =>
          {
              events.Error("error_handler(\"VaccancyPlangrid\")");
              events.RequestStart("onRequestStart(\"VaccancyPlangrid\")");
              events.RequestEnd("onRequestEnd(\"VaccancyPlangrid\")");
          })

                      .Model(model =>
                      {
                          model.Id(p => p.VacancyId);
                          model.Field(p => p.VacancyId).Editable (false);
                          model.Field(p => p.VaccancyCode).Editable(false);

                      })
               .Read(read => read.Action("VaccancyPlans_Read", "Vacancy", new { Area = "HRM" }))
            .Create(create => create.Action("VaccancyPlans_Create", "Vacancy", new { Area = "HRM"}))
          .Update(update => update.Action("VaccancyPlans_Update", "Vacancy"))
           //.Update(update => update.Action("ChangingStatus_Edit", "Vacancy"))
           .Destroy(destroy => destroy.Action("VaccancyPlans_Destroy", "Vacancy"))
      ).ClientDetailTemplateId("Interviwers")
)


