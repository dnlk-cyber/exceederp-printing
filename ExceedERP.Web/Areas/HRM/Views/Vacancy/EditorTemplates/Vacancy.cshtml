@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.RecruitmentManagment.Vacancy 


<div class="form">
    <div class="row fullrow">
        <div class="col-md-3 ro1">
            <div class="form-group">

                <div>@Html.LabelFor(model => model.BranchId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.BranchId)
                                                  .OptionLabel(Resources.Select)
                                                  .Filter("contains")
                                                  .MinLength(2)
                                                   .DataTextField("Name")
                                                        .DataValueField("BranchId")
                                                  .DataSource(dataSource =>
                                                  {
                                                      dataSource.Read(read => read.Action("GetAllBranchs", "HRMDataProvider"))
                                                          .ServerFiltering(false);
                                                  })
                                                  .ValuePrimitive(true)

                    )
                    @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger" })
                </div>
            </div>

            @Html.LabelFor(model => model.Department, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-6">
                @(Html.Kendo().DropDownListFor(model => model.Department)
                                   .OptionLabel(Resources.Select)
                                   .Filter("contains")
                                   .MinLength(2)
                                    .CascadeFrom("BranchId")
                                    .DataTextField("Name")
                                         .DataValueField("OrgStructureId")
                                   .DataSource(dataSource =>
                                   {
                                       dataSource.Read(read => read.Action("GetDepartments", "HRMDataProvider").Data("filterWorkunit"))
                                           .ServerFiltering(true);
                                   })
                                   .ValuePrimitive(true)

                )
                @Html.ValidationMessageFor(model => model.Department, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.JobTitle, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.JobTitle)
                                     .OptionLabel(Resources.Select)
                                     .Filter("contains")
                                     .MinLength(2)
                                     .CascadeFrom("Department")
                                      .DataTextField("Description")
                                           .DataValueField("LookupId")
                                     .DataSource(dataSource =>
                                     {
                                         dataSource.Read(read => read.Action("GetJobTitle", "HRMDataProvider").Data("filterJobTitle"))
                                             .ServerFiltering(true);
                                     })
                                     .ValuePrimitive(true)

                    )
                    @Html.ValidationMessageFor(model => model.JobTitle, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.RecruSource, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.RecruSource)
                                     .OptionLabel(Resources.Select)
                                     .Filter("contains")
                                     .MinLength(2)
                                      .DataTextField("Name")
                                           .DataValueField("Value")
                                     .DataSource(dataSource =>
                                     {
                                         dataSource.Read(read => read.Action("GetRecruitmentSource", "Vacancy"))
                                             .ServerFiltering(false);
                                     })
                                     .ValuePrimitive(true)

                    )
                    @Html.ValidationMessageFor(model => model.RecruSource, "", new { @class = "text-danger" })
                </div>
            </div>

