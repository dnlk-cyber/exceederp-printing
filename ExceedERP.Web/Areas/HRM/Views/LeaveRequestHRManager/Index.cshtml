@using System.Collections
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? true;
}
<legend>@Resources.NavigatorLeave_LeaveRequests</legend>

<!-- Status Legend -->
<div class="well well-sm" style="background: #fff; border-radius: 4px; margin-bottom: 12px; padding: 8px 15px;">
    <span class="fa fa-circle" style="color: #6b7280;"></span> Final Approved &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #10b981;"></span> Department Approved &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #0284c7;"></span> Waiting for Approval &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #f59e0b;"></span> Pending &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #ef4444;"></span> Rejected
</div>

@(Html.Kendo().Grid<LeaveRequest>()
              .Name("LeaveRequestgrid")
              .Columns(columns =>
              {
                  columns.Bound(c => c.LeaveRequestId).Width(100).Title("Request Id");
                  columns.Bound(c => c.EmployeeCode).Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                  columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                  columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
                  columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                  columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["jobTitle"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
                  columns.Bound(c => c.Type).EditorTemplateName("LeaveType").Width(100);
                  columns.Bound(c => c.Day).Width(80);
                  columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Width(80);
                  if (useEthiopian)
                  {
                      columns.Bound(c => c.FromAmharic).EditorTemplateName("Calander").Width(100);
                      columns.Bound(c => c.ToAmharic).EditorTemplateName("Calander").Width(100);
                  }
                  else
                  {
                      columns.Bound(c => c.From).Width(100);
                      columns.Bound(c => c.To).Width(100);
                  }
                  columns.Bound(c => c.LeaveBalance).Width(110);
                  columns.Bound(c => c.LeaveDays).Width(100);
                  columns.Bound(c => c.Status).Width(100);
                  columns.Bound(c => c.Reason).Width(150);
                  columns.Bound(c => c.Day).Width(80);
                  columns.Command(command =>
                  {
                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  }).Width(120);
              })
            .ToolBar(toolbar =>
            {
            })
            .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("LeaveRequest").Window(window => { window.Title(Resources.NavigatorLeave_LeaveRequest); window.Scrollable(false); }))
            .Events(events =>
            {
                events.DetailExpand("onDetailExpandUser");
                events.DataBound("onDataBound");
            })
            .Scrollable(h => h.Height(500))
            .Sortable(sortable =>
            {
                sortable.SortMode(GridSortMode.SingleColumn);
            })
            .Filterable()
            .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
            .DataSource(dataSource => dataSource
                      .Ajax()
                      .Sort(sort => sort.Add("LeaveRequestId").Descending())
                      .Events(events =>
                      {
                          events.Error("error_handler(\"LeaveRequestgrid\")");
                          events.RequestStart("onRequestStart(\"LeaveRequestgrid\")");
                          events.RequestEnd("onRequestEnd(\"LeaveRequestgrid\")");
                      })
                      .Model(model => model.Id(p => p.LeaveRequestId))
                      .Read(read => read.Action("LeaveRequest_Read", "LeaveRequestHRManager").Data("sendForgery"))
                      .Update(update => update.Action("LeaveRequest_Update", "LeaveRequestHRManager").Data("sendForgery"))
                      ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=LeaveRequestId#")
          .SelectedIndex(0)
          .Items(items =>
          {
                         items.Add().Text(Resources.HR_RequestStatus).Content(
                        @<text>
                            @(Html.Kendo().Grid<RequestesStatus>()
                                .Name("RequestesStatusgrid_#=LeaveRequestId#")
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.DateReqStatAm).Width(120);
                                    columns.Bound(c => c.Status).EditorTemplateName("EnumWithoutWaitingForApprovalAndApprove").Width(200);
                                    columns.ForeignKey(c => c.ApproverId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                                    columns.ForeignKey(c => c.ApproverDepartment, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                                    columns.Bound(c => c.Remark).Width(100);
                                    columns.Command(command =>
                                    {
                                        command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                    }).Width(400);

                                })
                                .ToolBar(toolbar =>
                                {
                                    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                })
                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .Scrollable()
                                .Events(e =>
                                {
                                    e.DataBound("onRequestesStatusDataBound");
                                    e.Edit("onRequestesStatusEdit");
                                })
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Events(events =>
                                    {
                                        events.Error("error_handler(\"RequestesStatusgrid_#=LeaveRequestId#\")");
                                        events.RequestStart("onRequestStart(\"RequestesStatusgrid_#=LeaveRequestId#\")");
                                        events.RequestEnd("onRequestEnd(\"RequestesStatusgrid_#=LeaveRequestId#\")");
                                    })
                                    .Model(model =>
                                    {
                                        model.Id(p => p.RequestStatusId);
                                        model.Field(p => p.Date).Editable(false).DefaultValue(DateTime.Today);
                                        model.Field(p => p.DateReqStatAm).Editable(false);
                                        model.Field(p => p.ApproverId).Editable(false);
                                        model.Field(p => p.ApproverDepartment).Editable(false);
                                    })
                                    .Read(read => read.Action("RequestesStatus_Read", "RequestesStatus", new { area = "HRM", id = "#=LeaveRequestId#", referenceType = "Leave" }).Data("sendForgery"))
                                    .Create(create => create.Action("RequestesStatus_Create", "RequestesStatus", new { area = "HRM", id = "#=LeaveRequestId#", referenceType2 = "Leave" }).Data("sendForgery"))
                                    .Update(update => update.Action("RequestesStatus_Update", "RequestesStatus").Data("sendForgery"))
                                    .Destroy(destroy => destroy.Action("RequestesStatus_Destroy", "RequestesStatus").Data("sendForgery"))
                                    ).ToClientTemplate())
                    <a href='@Url.Action("LeaveRequestLetter", "PrintableLetter")/?id=#=LeaveRequestId#' title="Print"><i class="fa fa-print fa-2x"></i></a>
                </text>);

                items.Add().Text("HR Manager Validation").Content(
                @<text>
                    @HRManagerValidation()
                </text>);

                items.Add().Text(Resources.Navigator_Company_UploadDocument).Content(
                @<text>
                    @documentAttachment()
                </text>);

          }).ToClientTemplate())

</script>

@helper HRManagerValidation()
{
    @(Html.Kendo().Grid<LeaveRequestHRManagerValidation>()
                           .Name("LeaveRequestHRManagerValidationGrid_#=LeaveRequestId#")
                           .Columns(columns =>
                           {
                               columns.Bound(c => c.Status).Width(150);
                               columns.Bound(c => c.DateCreated).Title("Date").Width(150);
                               columns.Bound(c => c.CreatedBy).Title("User").Width(150);
                               columns.Bound(c => c.Remark).Width(150);
                               columns.Command(command =>
                               {
                                   command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                   command.Destroy().Text(Resources.ActionButton_Cancel);
                               });
                           })
                           .ToolBar(toolbar =>
                           {
                               toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                           })
                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .Scrollable(h => h.Height(500))
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                        .Filterable()
                        .Events(x => x.DataBound("onDataBoundValidationHRManager"))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Events(events =>
                            {
                                events.Error("error_handler(\"LeaveRequestHRManagerValidationGrid_#=LeaveRequestId#\")");
                                events.RequestStart("onRequestStart(\"LeaveRequestHRManagerValidationGrid_#=LeaveRequestId#\")");
                                events.RequestEnd("onRequestEnd(\"LeaveRequestHRManagerValidationGrid_#=LeaveRequestId#\")");
                            })
                           .Model(model =>
                           {
                               model.Id(p => p.LeaveRequestHRManagerValidationId);
                               model.Field(p => p.CreatedBy).Editable(false);
                               model.Field(p => p.DateCreated).Editable(false);
                           })
                            .Read(read => read.Action("LeaveRequestHRManagerValidations_Read", "LeaveRequestHRManagerValidations", new { Area = "HRM", reqId = "#=LeaveRequestId#" }).Data("sendForgery"))
                            .Create(create => create.Action("LeaveRequestHRManagerValidations_Create", "LeaveRequestHRManagerValidations", new { Area = "HRM", reqId = "#=LeaveRequestId#" }).Data("sendForgery"))
                            .Update(update => update.Action("LeaveRequestHRManagerValidations_Update", "LeaveRequestHRManagerValidations").Data("sendForgery"))
                            .Destroy(destroy => destroy.Action("LeaveRequestHRManagerValidations_Destroy", "LeaveRequestHRManagerValidations").Data("sendForgery"))
                            ).ToClientTemplate()
    )
}

@helper documentAttachment()
{
    @(Html.Kendo().Grid<LeaveRequestAttachement>()
                .Name("LeaveRequestAttachementGrid#=LeaveRequestId#")
                .Columns(columns =>
                {
                    columns.Bound(c => c.FileName).ClientTemplate("<a href='/HRM/LeaveRequestAttachements/DownloadAttachment?attachmentId=\\#=LeaveRequestAttachementId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; \\#=FileName\\# </a>").Width(150);
                    columns.Bound(c => c.Description).Width(100);
                    columns.Template(e => { }).ClientTemplate("<a href='/HRM/LeaveRequestAttachements/DownloadAttachment?attachmentId=\\#=LeaveRequestAttachementId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; Download </a>").Width(100);
                    columns.Template(e => { }).ClientTemplate("<a href='\\#=ShortPath\\#/\\#=FileName\\#' target='_blank'> <f class = 'fa fa-folder-open'></i> &nbsp;&nbsp; Open</a>").Width(100);
                    columns.Command(command =>
                    {
                        command.Destroy().Text("Delete");
                    }).Width(300);

                })
            .ToolBar(toolbar =>
            {
            toolbar.Template(@<text>
                @Html.Kendo().Upload().Name("file").Async(a => a.Save("LeaveRequestAttachements_Create", "LeaveRequestAttachements", new { area = "HRM", id = "#=LeaveRequestId#" })).Events(e => e.Complete("onUploadSuccess")
                                                                                                                                                                        .Select("function(e) { globalOnSelect(e, ['.jpg', '.png', '.pdf'], 50 * 1024 * 1024); }")
                                                                                                                                                                        .Error("onUploadError")).ShowFileList(false).ToClientTemplate()
            </text>);
                    })
                    .Scrollable(h => h.Height("auto"))
                    .DataSource(dataSource => dataSource
                    .Ajax()
                    .Events(events =>
                    {
                        events.Error("error_handler(\"LeaveRequestAttachementGrid#=LeaveRequestId#\")");
                        events.RequestStart("onRequestStart(\"LeaveRequestAttachementGrid#=LeaveRequestId#\")");
                        events.RequestEnd("onRequestEnd(\"LeaveRequestAttachementGrid#=LeaveRequestId#\")");
                    })
                    .Model(model => model.Id(p => p.LeaveRequestAttachementId))
                    .Read(read => read.Action("LeaveRequestAttachements_Read", "LeaveRequestAttachements", new { id = "#=LeaveRequestId#" }).Data("sendForgery"))
                    .Create(create => create.Action("LeaveRequestAttachements_Create", "LeaveRequestAttachements", new { id = "#=LeaveRequestId#" }).Data("sendForgery"))
                    .Update(update => update.Action("LeaveRequestAttachements_Update", "LeaveRequestAttachements").Data("sendForgery"))
                    .Destroy(destroy => destroy.Action("LeaveRequestAttachements_Destroy", "LeaveRequestAttachements").Data("sendForgery"))
                    ).ToClientTemplate())
}

<script>
    var masterId = 0;
    var isHRManagerApproved = false;

    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;
        var masterGrid = $("#LeaveRequestgrid").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.LeaveRequestId;
        isHRManagerApproved = masterDataItem.IsHRManagerApproved;

        var gridName = "#RequestesStatusgrid_" + masterId;
        var HRGridName = "#LeaveRequestHRManagerValidationGrid_" + masterId;
        var attachmentGridName = "#LeaveRequestAttachementGrid" + masterId;

        if ( masterDataItem.IsHRManagerApproved == true)
        {

            $(HRGridName).find(".k-toolbar").hide();
            $(".k-grid-top", HRGridName).hide();
            $(".k-grid-edit", HRGridName).hide();
            $(".k-grid-delete", HRGridName).hide();
        }
        if (masterDataItem.IsOnlineApproved == true )
        {
            $(gridName).find(".k-toolbar").hide();
            $(".k-grid-top", gridName).hide();
            $(".k-grid-edit", gridName).hide();
            $(".k-grid-delete", gridName).hide();

            $(attachmentGridName).find(".k-grid-toolbar").hide();
            $(".k-grid-delete", attachmentGridName).hide();

        }
        else if (masterDataItem.IsDepartmentOnlineApproved == true) {
            $(gridName).find(".k-toolbar").hide();
            $(".k-grid-top", gridName).hide();
            $(".k-grid-edit", gridName).hide();
            $(".k-grid-delete", gridName).hide();

            $(attachmentGridName).find(".k-grid-toolbar").hide();
            $(".k-grid-delete", attachmentGridName).hide();

            $(HRGridName).find(".k-toolbar").show();
            $(".k-grid-top", HRGridName).show();
            $(".k-grid-edit", HRGridName).hide();
            $(".k-grid-delete", HRGridName).hide();
        }
    }

    function onDataBoundValidationHRManager(e) {
        var detailGrid = "#" + e.sender.element[0].id;
        if (isHRManagerApproved == true) {
            $(".k-grid-add", detailGrid).hide();
            $(".k-upload-button", detailGrid).hide();
            $(".k-dropzone", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
        this.table.find(".k-grid-edit").hide();
        this.table.find(".k-grid-delete").hide();
    }

    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var model = grid.dataItem(this);
            if (!model) return;

            var $row = $(this);
            $row.removeClass("row-approved row-dept-approved");

            if (model.IsOnlineApproved || model.IsHRManagerApproved) {
                $row.addClass("row-approved");
                $row.find(".k-grid-edit").remove();
            }
            else if (model.Status === "DEPARTMENT_APPROVAL" || model.IsDepartmentOnlineApproved == true) {
                $row.addClass("row-dept-approved");
            }
        });
    }

    function onRequestesStatusDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (model.Status == 0 || model.Status == 1 || model.Status == 2 || model.Status == 3 || model.Status == 4) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

    function onRequestesStatusEdit(e) { }

    function onUploadSuccess(e) {
        $("#LeaveRequestAttachementGrid" + masterId).data("kendoGrid").dataSource.read();
    }
</script>

<style type="text/css">
    .row-approved {
        background-color: #e5e7eb !important;
    }

    .row-dept-approved {
        background-color: #d1fae5 !important;
    }

    .k-grid tbody tr.row-approved:hover,
    .k-grid tbody tr.row-approved.k-state-hover {
        background-color: #cbd5e1 !important;
    }

    .k-grid tbody tr.row-dept-approved:hover,
    .k-grid tbody tr.row-dept-approved.k-state-hover {
        background-color: #a7f3d0 !important;
    }
</style>
