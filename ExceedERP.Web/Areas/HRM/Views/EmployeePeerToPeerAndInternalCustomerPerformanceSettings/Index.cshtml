@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.Rpt_EmployeePerformance @Resources.Settings</legend>
@(Html.Kendo().Grid<EmployeePeerToPeerAndInternalCustomerPerformanceSetting>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.Bound(c => c.EmployeePeerToPeerAndInternalCustomerPerformanceSettingId).Title("S.N").Width(80);
              columns.Bound(c => c.IsPeerToPeerHasMultipleEvaluator).ClientTemplate(
                                     "<input type='checkbox' disabled = 'true' value='#= IsPeerToPeerHasMultipleEvaluator#' " +
                                     "# if (IsPeerToPeerHasMultipleEvaluator) { #" +
                                     "checked='checked'" +
                                     "# } #" +
                                     "/>"
                                     ).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(150);
              columns.Bound(c => c.IsInternalCustomerHasMultipleEvaluator).ClientTemplate(
                                     "<input type='checkbox' disabled = 'true' value='#= IsInternalCustomerHasMultipleEvaluator#' " +
                                     "# if (IsInternalCustomerHasMultipleEvaluator) { #" +
                                     "checked='checked'" +
                                     "# } #" +
                                     "/>"
                                     ).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(150);
              //columns.Bound(c => c.IsPeerToPeerHasMultipleEvaluator).Width(200);
              //columns.Bound(c => c.IsInternalCustomerHasMultipleEvaluator).Width(200);
              columns.Bound(c => c.CreatedBy).Width(150);
              columns.Bound(c => c.DateCreated).Width(150);

              columns.Command(command =>
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  command.Destroy().Text(Resources.ActionButton_Cancel);//
              }).Width(200);

          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })

          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Selectable(selectable =>
          {
              selectable.Mode(GridSelectionMode.Single);
              selectable.Type(GridSelectionType.Row);

          })
          .Scrollable(h => h.Height(500))
          .Sortable(sortable =>
          {
              sortable.SortMode(GridSortMode.SingleColumn);

          })
          .Filterable()
          .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
           .DataSource(dataSource => dataSource
                  .Ajax()
                  .Events(events =>
                  {
                      events.Error("error_handler(\"grid\")");
                      events.RequestStart("onRequestStart(\"grid\")");
                      events.RequestEnd("onRequestEnd(\"grid\")");

                  })

                  .Model(model => {
                      model.Id(p => p.EmployeePeerToPeerAndInternalCustomerPerformanceSettingId);
                      model.Field(p => p.EmployeePeerToPeerAndInternalCustomerPerformanceSettingId).Editable(false);
                      model.Field(p => p.DateCreated).Editable(false);
                      model.Field(p => p.CreatedBy).Editable(false);
                  })
                  .Read(read => read.Action("Read", "EmployeePeerToPeerAndInternalCustomerPerformanceSettings").Data("sendForgery"))
                  .Create(create => create.Action("Create", "EmployeePeerToPeerAndInternalCustomerPerformanceSettings").Data("sendForgery"))
                  .Update(update => update.Action("Update", "EmployeePeerToPeerAndInternalCustomerPerformanceSettings").Data("sendForgery"))
                  .Destroy(destroy => destroy.Action("Destroy", "EmployeePeerToPeerAndInternalCustomerPerformanceSettings").Data("sendForgery"))
              )
)
