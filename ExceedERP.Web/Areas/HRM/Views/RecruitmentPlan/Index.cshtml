          columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "AmharicName").EditorTemplateName("BranchSelector").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
          columns.ForeignKey(c => c.WorkUnitId, (IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").EditorTemplateName("OrganizationDept").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["organization"], "OrgStructureId", "Name").EditorTemplateName("OrgSelector").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
          //columns.Bound(c => c.JobtitleName).Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["Jobtitles"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
          columns.Bound(c => c.NoOfVacantPost).Width(120);
          columns.Bound(c => c.EduLevel).Width(150);
          columns.Bound(c => c.FromAmharic).EditorTemplateName("Calander").Width(150);
          columns.Bound(c => c.ToAmharic).EditorTemplateName("Calander").Width(150);
          columns.Bound(c => c.RecruitmentType).EditorTemplateName("Enum").Width(150);
          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLYearSelector").Width(100);

          columns.ForeignKey(c => c.RankId, (IEnumerable)ViewData["RankList"], "RankId", "RankName").EditorTemplateName("Rank").Width(100);
          columns.Bound(c => c.Remark).Width(100);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
          }).Width(200);
      })
     .ToolBar(toolbar =>
     {

     //toolbar.Excel().Text(Resources.ActionButton_ExportExcel);
     //toolbar.Pdf().Text(Resources.ActionButton_ExportPDF);
     toolbar.Template(@<text>
<div class="toolbar">
    <label class="category-label">@Resources.HR_RecruitmentManagment_Vacancy_BranchId</label>
    @(Html.Kendo().ComboBox()
                                                 .Placeholder(Resources.HR_RecruitmentManagment_Vacancy_BranchId)
