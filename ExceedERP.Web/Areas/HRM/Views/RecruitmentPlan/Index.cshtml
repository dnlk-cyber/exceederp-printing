    @if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
                {
        @item.CustomCommandToolBarButton("Excel", "<span class='k-icon k-i-excel'></span>" + Resources.ActionButton_ExportExcel, "Excel_Export_Save", "RecruitmentPlan", "", new { @class = "k-button k-button-icontext k-grid-excel btn btn-primary btn-xs pull-right" });
        @item.CustomCommandToolBarButton("PDF", "<span class='k-icon k-i-pdf'></span>" + Resources.ActionButton_ExportPDF, "Pdf_Export_Save", "RecruitmentPlan", "", new { @class = "k-button k-button-icontext k-grid-pdf  btn btn-primary btn-xs pull-right" });
                }
</div>
         
        </text>);
         
      })
                           .Excel(excel => excel
                                  .FileName(Resources.Navigator_Recruitment_RecruitmentPlan + ".xlsx")
                                        .Filterable(true)
                                              .AllPages(true)
                                                // .ProxyURL(Url.Action("Excel_Export_Save", "RecruitmentPlan"))
                                                       )
                                                     .Pdf(pdf => pdf
                                                            .AllPages()
                                                    .FileName(Resources.Navigator_Recruitment_RecruitmentPlan + ".pdf")
                                            //    .ProxyURL(Url.Action("Pdf_Export_Save", "RecruitmentPlan"))
                                                        )
                                   .Editable(editable => editable.Mode(GridEditMode.InLine))//.TemplateName("RecruitmentPlan").Window(window => { window.Title("Recruitment Plan"); window.Scrollable(false); }))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                             .Scrollable(h => h.Height(500))
                                 .Groupable()
                                          .Sortable(sortable =>
                                          {
                                              sortable.SortMode(GridSortMode.SingleColumn);
                                          })
                              .Filterable()
                                   .Events(e =>
                                                       {
                                                           e.Save("GetDate");
                                                           e.Edit("GetDate");
                                                       })
                                 .Pageable(pageable => pageable
                                                            .Input(true)
                                                            .Numeric(false)
                                                            .Refresh(true)
                                                            .PageSizes(true)
                                                            .ButtonCount(5))
                      .DataSource(dataSource => dataSource
                          .Ajax()
                                              .Sort(sort => sort.Add("DateCreated").Descending()) 
 .Events(events =>
 {
events.Error("error_handler(\"RecruitmentPlanGrid\")");
events.RequestStart("onRequestStart(\"RecruitmentPlanGrid\")");
events.RequestEnd("onRequestEnd(\"RecruitmentPlanGrid\")");
 })
                                                                     
                              .Model(model =>
                              {
                                  model.Id(p => p.RecruitmentPlanId);
                                  model.Field(p => p.EduLevel).Editable(false);
                                  model.Field(p => p.Experience).Editable(false);
                                  model.Field(p => p.RelevantExp).Editable(false);
                                  model.Field(p => p.SpecialSkill).Editable(false);
                                  model.Field(p => p.PlannedSalary).Editable(false);
                                  model.Field(p => p.NoOfVacantPost).Editable(false);
                                  model.Field(p => p.LookupId).Editable(false);
                                  model.Field(p => p.OrgStructureId).Editable(false);
                                  model.Field(p => p.BranchId).Editable(false);
                                  model.Field(p => p.WorkUnitId).Editable(false); model.Field(p => p.JobtitleName).Editable(false);

                              })
                              .Read(read => read.Action("RecruitmentPlans_Read", "RecruitmentPlan"))
                             .Create(create => create.Action("RecruitmentPlans_Create", "RecruitmentPlan"))
                              .Update(update => update.Action("RecruitmentPlans_Update", "RecruitmentPlan"))
                              .Destroy(destroy => destroy.Action("RecruitmentPlans_Destroy", "RecruitmentPlan"))
                      )
    )
