    <script>
        function filterCategories() {
            return {
                OrgStructureId: $("#OrgStructureId").val()
            };
        }

    </script>
    <script>
        function GetDetail() {
            $("#NoOfVacantPost").val(0);
            $("#PlannedSalary").val(0);
            $("#RelevantExp").val("");
            $("#SpecialSkill").val("");
            $("#Experience").val("");
            $("#EduLevel").val("");
            var Titles = $("#OrgStructureId").data("kendoComboBox");
            var OrgId = Titles.value();
            var jobs = $("#LookupId").data("kendoComboBox");
            var title = jobs.value();
            $.ajax({
                url: '@Url.Action("GetDetail", "RecruitmentPlan")',

                data: { OrgId: OrgId, title: title },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    var s = r.split(/-/);

                    $("#PlannedSalary").val(s[0]);
                    $("#RelevantExp").val(s[1]);
                    $("#SpecialSkill").val(s[2]);
                    $("#Experience").val(s[3]);
                    $("#EduLevel").val(s[4]);
                    $("#NoOfVacantPost").val(s[5]);
                }

            });
        }

    </script>
    <script>
        function GetDate() {

            var x = AssignDate();
            var y = x;
            $("#FromAmharic").trigger("change");
            $("#ToAmharic").trigger("change");
            for (var o in y) {
                $.ajax({
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("SetDate", "RecruitmentPlan")',
                    data: { name: y[o].id, value: y[o].date },
                    type: 'GET',
                    cache: false,
                    success: function (result) {
                        r = result;
                    }

                });
            }
        }

    </script>
    <script>
        function AssignDate() {
            var list = AssignDates();
            return list;
        }

    </script>
<script>
    function Branch() {


        var value = this.value(),
            grid = $("#RecruitmentPlanGrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "BranchId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>

<script>

        function Refresh(e) {
            console.log("call");
        try {
            var br = $("#BranchId").data("kendoComboBox");
            var branch = br.value();
            console.log("branch:" + branch);
            $.ajax({
                url: '@Url.Action("PrepareRecruitmentPlans", "RecruitmentPlan", new { area = "HRM" })',
                //contentType: "application/json; charset=utf-8",
                data: {branch:branch },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(result.Message);

                },
                error: function (result) {
                       
                    alert(result);

                }

            });
            
        } catch (e) {
            alert("Please select the row!!");
        }

    }

</script>