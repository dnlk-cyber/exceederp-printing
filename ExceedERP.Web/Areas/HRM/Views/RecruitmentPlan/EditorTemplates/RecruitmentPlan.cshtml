@using System.Collections
@using ExceedERP.Helpers.Common
@using ExceedERP.Core.Localization
@using ExceedERP.Web.Areas.HRM.Controllers
@using ExceedERP.Web.Areas.HRM.Controllers.Company
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.HRMPlan.RecruitmentPlan

<form>

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div>@Html.LabelFor(model => model.OrgStructureId, htmlAttributes: new { @class = "control-label col-md-8" })</div>

                @(Html.Kendo().DropDownListFor(model => model.OrgStructureId)
                  .OptionLabel(Resources.Select)
                  .DataTextField("Name")
                  .DataValueField("OrgStructureId")
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetDepartments", "HRMDataProvider", new { area = "HRM" }))
                              .ServerFiltering(false);
                      })
                  .ValuePrimitive(true)

                )
                @Html.ValidationMessageFor(model => model.OrgStructureId, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">

            <div class="form-group">
                <div>@Html.LabelFor(model => model.LookupId, htmlAttributes: new { @class = "control-label col-md-8" })</div>

                @(Html.Kendo().DropDownListFor(m => m.LookupId)
                              .DataTextField("Description")
                                    .DataValueField("LookupId")
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetJobTitle", "HRMDataProvider")
                                            .Data("filterCategories");
                                    });
                                    //  .ServerFiltering(true);
                                })
                                        .Events(e => e.Change("GetDetail"))
                                                                         .CascadeFrom("OrgStructureId")
                          .AutoBind(false)
                        .Enable(false)
                )
                @Html.ValidationMessageFor(model => model.LookupId, "", new { @class = "text-danger" })
            </div>

        </div>
        <div class="col-md-3">

            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.NoOfVacantPost, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @(Html.Kendo().TextBoxFor(model => model.NoOfVacantPost).Enable(false))
                    @Html.ValidationMessageFor(model => model.NoOfVacantPost, "", new { @class = "text-danger" })
                </div>
            </div>

        </div>
        
    </div>

    <br />

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.EduLevel, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>

                    @(Html.Kendo().TextBoxFor(model => model.EduLevel)
                    .Enable(false))
                    @Html.ValidationMessageFor(model => model.EduLevel, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-3">

            <div class="form-group">

                <div class="k-label">
                    @Html.LabelFor(model => model.RelevantExp, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @Html.TextAreaFor(model => model.RelevantExp, htmlAttributes: new { disabled = "true" })
                            
                    @Html.ValidationMessageFor(model => model.RelevantExp, "", new { @class = "text-danger" })

                </div>
            </div>
        </div>        
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.SpecialSkill, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>

                    @Html.TextAreaFor(model => model.SpecialSkill, htmlAttributes: new { disabled = "true" })
                            
                    @Html.ValidationMessageFor(model => model.SpecialSkill, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <br />

<div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.Experience, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>

                @(Html.TextAreaFor(model => model.Experience, htmlAttributes: new { disabled = "true" })
                       )
                @Html.ValidationMessageFor(model => model.Experience, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
   
  
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.PlannedSalary, htmlAttributes: new {@class = "control-label col-md-8"})

            </div>
            <div>

                @(Html.Kendo().TextBoxFor(model => model.PlannedSalary)
                .Enable(false))
                @Html.ValidationMessageFor(model => model.PlannedSalary, "", new {@class = "text-danger"})
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.RecruitmentType, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>

                @(Html.Kendo().DropDownListFor(m => m.RecruitmentType)
                  .DataTextField("Text")
                  .DataValueField("Value")
                           .ValuePrimitive(true)
                  .BindTo(EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.Common.EmployeeStatus)))
                )
                @Html.ValidationMessageFor(model => model.RecruitmentType, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    
   

</div>
    <div class="row">
        <div class="col-md-1">

        </div>

       
