            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model., htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @Html.TextBoxFor(model => model.RecruiTimeAmharic, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />
                   
                    @Html.ValidationMessageFor(model => model.RecruiTimeAmharic, "", new { @class = "text-danger" })
