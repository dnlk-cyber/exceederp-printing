@using System.Collections
@using System.Security.AccessControl
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorTraining_EducationRequests</legend>
@(Html.Kendo().Grid<EducationRequest>()
          .Name("EducationRequestgrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").Filterable(ftb => ftb.Multi(true).Search(true)).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(200);

          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["Depo"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).EditorTemplateName("Department").Width(200);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["EduLevel"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).EditorTemplateName("EducationLevel").Width(150);
          columns.Bound(c => c.EducationType).Width(100);
          columns.Bound(c => c.DateAmharic).Width(150);
          columns.Bound(c => c.Remark).Width(150);
         // columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
        

         toolbar.Template(@<text>
<div class="toolbar" style="">
   
        @item.CustomCommandToolBarButton("Excel", "<span class='k-icon k-i-excel'></span>" + Resources.ActionButton_ExportExcel, "Excel_Export_Save", "EmployeeProfile", "", new { @class = "k-button k-button-icontext k-grid-excel btn btn-primary btn-xs pull-right" })
        @item.CustomCommandToolBarButton("PDF", "<span class='k-icon k-i-pdf'></span>" + Resources.ActionButton_ExportPDF, "Pdf_Export_Save", "EmployeeProfile", "", new { @class = "k-button k-button-icontext k-grid-pdf  btn btn-primary btn-xs pull-right" })
       


               
   
</div>
        </text>);


      })
                 .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("EducationRequest").Window(window => { window.Title(Resources.NavigatorTraining_EducationRequest); window.Scrollable(false); }))
         .Selectable(selectable =>
         {
             selectable.Mode(GridSelectionMode.Single);
             selectable.Type(GridSelectionType.Row);
         })
               .Events(e =>
               {
                   e.Save("GetDate");
                   e.Edit("GetDate");
                   e.DetailExpand("onDetailExpandUser");
               })
             .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                             .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Events(events =>
               {
                   events.Error("error_handler(\"EducationRequestgrid\")");
                   events.RequestStart("onRequestStart(\"EducationRequestgrid\")");
                   events.RequestEnd("onRequestEnd(\"EducationRequestgrid\")");
               })


         .Model(model => model.Id(p => p.EducationRequestId))
          .Read(read => read.Action("EducationRequests_Read", "EducationRequestStatus"))
          .Create(create => create.Action("EducationRequests_Create", "EducationRequestStatus"))
          .Update(update => update.Action("EducationRequests_Update", "EducationRequestStatus"))
          .Destroy(destroy => destroy.Action("EducationRequests_Destroy", "EducationRequestStatus"))
          ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("tabstrip_#=EducationRequestId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text(Resources.HR_RequestStatus).Content(
                @<text>
                    @*  <legend>Status</legend>*@

                    @(Html.Kendo().Grid<RequestesStatus>()
                          .Name("RequestesStatusgrid_#=EducationRequestId#")
                          .Columns(columns =>
                          {
                              //columns.Bound(c => c.RequestId);
                              columns.Bound(c => c.DateReqStatAm).Width(100);
                              columns.Bound(c => c.Status).EditorTemplateName("EnumWithoutDepApprove").Width(200);
                              columns.Bound(c => c.Remark).Width(100);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(400);
                          })
                          //.ToolBar(toolbar =>
                          //{
                          //    toolbar.Custom().Action("SendForApproval", "EducationRequestStatus").Text(Resources.HR_Send_For_Approval);
                          //})
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Scrollable()
                          .DataSource(dataSource => dataSource
                              .Ajax()
                                       .Events(events =>
                                       {
                                           events.Error("error_handler(\"RequestesStatusgrid_#=EducationRequestId#\")");
                                           events.RequestStart("onRequestStart(\"RequestesStatusgrid_#=EducationRequestId#\")");
                                           events.RequestEnd("onRequestEnd(\"RequestesStatusgrid_#=EducationRequestId#\")");
                                       })

                                      .Model(model =>
                                      {
                                          model.Id(p => p.RequestStatusId);
                                          model.Field(p => p.Date).Editable(false).DefaultValue(DateTime.Today);
                                      })

                                             .Read(read => read.Action("RequestesStatus_Read", "RequestesStatus", new { id = "#=EducationRequestId#", referenceType = "Education" }))
                                              .Create(create => create.Action("RequestesStatus_Create", "RequestesStatus", new { id = "#=EducationRequestId#", referenceType2 = "Education" }))
                                                  .Update(update => update.Action("RequestesStatus_Update", "RequestesStatus"))
                                                  .Destroy(destroy => destroy.Action("RequestesStatus_Destroy", "RequestesStatus"))
                          ).ToClientTemplate()
                    )


                </text>
                  );
              //*****************************************************************************************************//

          }).ToClientTemplate())
</script>
