<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#DateHoAmhaic").trigger("change");

        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "Holiday")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>