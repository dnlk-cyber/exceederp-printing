<script type="text/javascript">
    $(function () {
        $('#PlacementInActiveBatchVMtGrid').on('click', '.chkbx', function () {
            var checked = $(this).is(':checked');
            var grid = $('#PlacementInActiveBatchVMtGrid').data().kendoGrid;
            var dataItem = grid.dataItem($(this).closest('tr'));
            dataItem.set('Check', checked);
        })
    })

    function checkAll(ele) {
        var state = $(ele).is(':checked');
        var grid = $('#PlacementInActiveBatchVMtGrid').data().kendoGrid;
        $.each(grid.dataSource.view(), function () {
            if (this['Check'] != state)
                this.dirty = true;
            this['Check'] = state;
        });
        grid.refresh();
    }

</script>


<script>
    function BranchChange() {
        var value = this.value(),
            grid = $("#PlacementInActiveBatchVMtGrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "BranchId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>


<script>
    function DeActivatePlacements() {

        var branch = $("#Project_BranchId").data("kendoDropDownList");
        var branchId = branch.value();

        $('#loading-image').hide();

            $.ajax({
            url: '@Url.Action("DeActivateEmployeesByBranch", "EmployeePlacmentWithJ")',
            contentType: "application/json; charset=utf-8",
            data: { branchId: branchId },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;

                alert(r.Message);
                $('#loading-image').hide();

            }

        });
    }
</script>
