@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.Payroll
@using ExceedERP.Core.Domain.HRM.Payroll.Setting
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend >@Resources.NavigatorPayrollSetup_PayrollEmployeeAccount</legend>
@(Html.Kendo().Grid<PayrollEmployeeAccount>()
          .Name("PayrollEmployeeAccountGrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("PayrollListOfEmployee").Width(260)
          .Filterable(f => {
              f.Search(true);
              f.Multi(true);
          });
          columns.ForeignKey(c => c.CostCenterAccountCode, (System.Collections.IEnumerable)ViewData["costCenter"], "Values", "Description").EditorTemplateName("CostCenter").Width(220); //(IEnumerable)ViewData["CostAcc"], "GlchartAccunt", "GlValue"
          columns.ForeignKey(c => c.SubAccCode, (System.Collections.IEnumerable)ViewData["SubAccCode"], "Values", "Description").EditorTemplateName("Location").Width(220);
          columns.Bound(c => c.Remark).Width(150);
          //columns.Bound(c => c.StaffAdvanceAccountCode).Title("Staff Advance Acc.code").EditorTemplateName("StaffAdvance").Width(220);
          //columns.Bound(c => c.StaffLoanAccountCode).Title("Staff Loan Acc.code").EditorTemplateName("StaffLoan").Width(220); 

          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })

      .ToolBar(toolbar => {
          toolbar.Template(
                                  @<text>

                                      <a class="k-button k-button-icontext k-grid-add" href='\#'><span class="k-icon k-i-add"></span> Add new record</a>
                                      <button class="k-button k-button-icontext k-grid-excel" href='\#'> <span class="k-icon k-i-excel"></span>Export to Excel</button>

                                      @(Html.Kendo().Button()
                                            .Name("btnRefresh")
                                            .HtmlAttributes(new { type = "button", @class = "k-primary" })
                                            .Events(e => e.Click("Refresh"))
                                            .Content("Referesh Data"))


                                   </text>);
      })
      .Excel(excel => excel
          .FileName("Employee Cost Center.xlsx")
          .Filterable(true)
          .AllPages(true)
      )
            //.ToolBar(toolbar => {
            //      toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
            //                        toolbar.Excel();
            //})
            .Editable(editable => editable.Mode(GridEditMode.InLine))//.TemplateName("PayrollEmployeeAccount").Window(window => { window.Title("Employee Account"); window.Scrollable(false); }))
           .Scrollable(h => h.Height(500))
             .Groupable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          // .Events(e => e.Save("OnEdit"))

          .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
                                             .Events(e =>
                                             {
                                                 e.Edit("onChange");

                                             })
              .Selectable()
      .DataSource(dataSource => dataSource
          .Ajax()
              .Events(events =>
              {
                  events.Error("error_handler(\"PayrollEmployeeAccountGrid\")");
                  events.RequestStart("onRequestStart(\"PayrollEmployeeAccountGrid\")");
                  events.RequestEnd("onRequestEnd(\"PayrollEmployeeAccountGrid\")");
              })

          .Model(model => model.Id(p => p.PayrollEmployeeAccountId))
          .Read(read => read.Action("PayrollEmployeeAccounts_Read", "PayrollEmployeeAccount"))
          .Create(create => create.Action("PayrollEmployeeAccounts_Create", "PayrollEmployeeAccount"))
          .Update(update => update.Action("PayrollEmployeeAccounts_Update", "PayrollEmployeeAccount"))
          .Destroy(destroy => destroy.Action("PayrollEmployeeAccounts_Destroy", "PayrollEmployeeAccount"))
      )
)
<script>
    

    function Refresh(e) {
        $('#loading-image').show();
           
        $.ajax({
            url: '@Url.Action("Refresh", "PayrollEmployeeAccount")',
            contentType: "application/json; charset=utf-8",
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                $('#loading-image').hide();
                $("#PayrollEmployeeAccountGrid").data("kendoGrid").dataSource.read();
                   
            },
            error: function (error) {
                alert(error);

            }

        });

    }

    function sync_handler(e) {
        this.read();

    }
    function OnEdit(e) {
        try {
            var grid = e.sender._data[0];
          //  var selectedRows = this.select();
           // var rowData = this.dataItem(grid.data[0]);
          //  var rowData = grid.data[0];
            var id = grid.EmployeeId;
        $.ajax({
            url: '@Url.Action("FileterEmployee", "PayrollEmployeeAccount")',
            //contentType: "application/json; charset=utf-8",
            data: { id: id },
            type: 'POST',
            cache: false,
            success: function(result) {
                r = result;
                if (r === "0") {
                    alert("The Employee Cost center is already registered!!");
                }
            }


        });
    } catch (e) {
      //  alert("Please select the row!!");
    }

    }
</script>
<style>
    div.k-edit-form-container {
        width: 700px;
    }
</style>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }

    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>


<script>

    var popup;
    var aCode;
    var templbtn;

    function SelectLocation() {
        templbtn = "acc";
        var wnd = $("#Location").data("kendoWindow");
        wnd.center().open();
    }


    //function SelectDebator() {
       
    //    var wnd = $("#Debator").data("kendoWindow");
    //    wnd.center().open();
    //}

    //function SelectLoan() {

    //    var wnd = $("#Loan").data("kendoWindow");
    //    wnd.center().open();
    //}
    function SelectCostCneter() {
       
        var wnd = $("#CostCneterAccount").data("kendoWindow");
        wnd.center().open();
    }
    

    function onChange(e) {

        var id = e.sender.dataItem(e.container).SubAccCode;
    
        var id2 = e.sender.dataItem(e.container).CostCenterAccountCode;
       
        $("#SubAccounts").data("kendoComboBox").value(id);
        $("#CostAccount").data("kendoComboBox").value(id2);
        //$("#SubAccounts").data("kendoComboBox").value(s[3]);
        //$("#Accounts").data("kendoComboBox").value(s[0]);
      


    }

    function Costclicked(e) {

        var account = $("#CostAccount").data("kendoComboBox").value();
        var glAcc = account;
        if (account !== "") {
            
            $("#CostCenterAccountCode").val(glAcc).trigger("change");
           var window = $("#CostCneterAccount").data("kendoWindow");
            window.close();
        }
        else
        {
            alert("Please select all the neccessary Fields");
        }

    }
   
   
    function Locationclicked(e) {

        var account = $("#SubAccounts").data("kendoComboBox").value();
        var glAcc = account;
        if (account !== "") {

            $("#SubAccCode").val(glAcc).trigger("change");
            var window = $("#Location").data("kendoWindow");
            window.close();
        }
        else {
            alert("Please select all the neccessary Fields");
        }

    }
   
</script>
@(Html.Kendo().Window().Name("CostCneterAccount")
    .Title("Cost Center Account")
    .Visible(false)
    .Modal(true)
      .Content(@<text>
        @(Html.Kendo().ComboBox()
                                  .Name("CostAccount")
                          .HtmlAttributes(new { style = "width:200px" })
                          .ValuePrimitive(true)
                          .Placeholder("Account...")
                                    .MinLength(2)
                                                     .Filter("contains")
                                  .DataTextField("GlchartAccunt")
                                  .DataValueField("GlValue")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetCostCenter", "EmployeeAccount", new { area = "HRM" }));
                              
                             // .ServerFiltering(true);
                          })
              )

@Html.ValidationMessageFor(m => m)
<br />
<div class="pull-right">
    @Html.Kendo().Button().Name("btncost").Content("Submit").Events(ev => ev.Click("Costclicked"))

</div>

</text>)
    .Draggable(true)
    .Width(300)
      )

@(Html.Kendo().Window().Name("Location")
        .Title("Sub Account")
    .Visible(false)
    .Modal(true)
      .Content(@<text>
      @(Html.Kendo().ComboBox()
                          .Name("SubAccounts")
                          .ValuePrimitive(true)
                          .Placeholder("SubAccount...")
                                   .Filter("contains")
              .MinLength(2)
                          .HtmlAttributes(new { style = "width:200px" })
                                  .DataTextField("GlchartSubAccunt")
                                  .DataValueField("GlValue")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetSubAccountCode", "PayrollAcounts", new {area = "HRM"}));
                              // .ServerFiltering(true);
                          })
    )

        @Html.ValidationMessageFor(m => m)
        <br />
        <div class="pull-right">
            @Html.Kendo().Button().Name("btnLocation").Content("Submit").Events(ev => ev.Click("Locationclicked"))

        </div>

    </text>)
                    .Draggable(true)
                    .Width(300)
)