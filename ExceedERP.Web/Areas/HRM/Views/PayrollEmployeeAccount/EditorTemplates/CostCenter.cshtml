@using System.Collections


@(Html.Kendo().DropDownListFor(x => x)

                            .DataValueField("Value")
                            .DataTextField("Name")
                            .OptionLabel("Select Cost Center")
                            .AutoBind(true)
                              .ValuePrimitive(true)
                             .Filter("contains")
                            .DataSource(
                    read => read.Read(re => re.Action("GetCostCenter", "EmployeeAccount"))))






