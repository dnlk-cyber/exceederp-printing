<script>
    function updateEmployeeAge(element) {
        var $button = $(element);
        var $icon = $button.find('i');
        var originalIcon = $icon.attr('class');

        // Show loading spinner
        $icon.attr('class', 'fa fa-spinner fa-spin');
        $button.prop('disabled', true);
        $('#loading-image').show();
        $.ajax({
            url: '@Url.Action("UpdateEmployeeAge", "EmployeePlacmentWithOJ")',
            type: 'POST',
            dataType: 'json',
            success: function (response) {
                alert(response.message);
                $('#loading-image').hide();
                $button.prop('disabled', false);
            },
            error: function (xhr, status, error) {
                alert('An error occurred while updating age. Please try again.');
                $('#loading-image').hide();
                $button.prop('disabled', false);
            },
            complete: function () {
                // Restore original button state
                $icon.attr('class', originalIcon);
                $button.prop('disabled', false);
            }
        });
    }

    function updateEmployeeSalary(element)
    {
        var $button = $(element);
        var $icon = $button.find('i');
        var originalIcon = $icon.attr('class');

        // Prompt for optional New Assignment Date
        var newAssignmentDate = prompt("Optional: Enter New Assignment Date (YYYY-MM-DD) to update alongside salary, or click OK to only update salary:");

        // If user clicks "Cancel", abort operation
        if (newAssignmentDate === null) {
            return;
        }

        newAssignmentDate = newAssignmentDate.trim();

        var confirmMessage = newAssignmentDate !== "" ? "Are you sure you want to refresh salary and set Assignment Date to " + newAssignmentDate + "?" : "Are you sure you want to refresh salary for all current placements?";

        if (!confirm(confirmMessage)) {
            return;
        }

        // Spinner ON
        $icon.attr('class', 'fa fa-spinner fa-spin');
        $button.prop('disabled', true);
        $('#loading-image').show();

        $.ajax({
            url: '@Url.Action("UpdateEmployeeSalary", "EmployeePlacmentWithOJ")',
            type: 'POST',
            dataType: 'json',
            data: { 
                newAssignmentDate: newAssignmentDate // Pass optional date string
            },
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (response) {
                alert(response.Message);
            },
            error: function (xhr) {
                console.log(xhr.responseText);
                alert('An error occurred while refreshing salary. Please try again.');
            },
            complete: function () {
                $('#loading-image').hide();
                $icon.attr('class', originalIcon);
                $button.prop('disabled', false);
            }
        });

    }
