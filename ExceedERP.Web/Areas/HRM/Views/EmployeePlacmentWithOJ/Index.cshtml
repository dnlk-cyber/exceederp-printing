<script>
    function onDataBound(e)
    {

        var grid = this;
        grid.tbody.find("tr").each(function () {

            var row = $(this);
            var dataItem = grid.dataItem(row);

            // =========================
            // Row Background Colors
            // =========================

            if (dataItem.IsToBePromoted) {
                row.css("background-color", "deepskyblue");
            }

            if (dataItem.IsApprove === false) {
                row.css("background-color", "darkorange");
            }

            if (dataItem.isCurrent === true && dataItem.IsPend === true) {
                row.css("background-color", "gray");
            }

            if (dataItem.Age >= 60) {
                row.css("background-color", "olive");
            }

            // =========================
            // Pend / UnPend Buttons
            // =========================

            if (dataItem.isCurrent === true) {

                if (dataItem.IsPend === false) {
                    row.find("#pend").show();
                    row.find("#unpend").hide();
                }
                else {
                    row.find("#pend").hide();
                    row.find("#unpend").show();
                }

            } else {
                row.find("#pend").hide();
                row.find("#unpend").hide();
            }

            // =========================
            // Edit/Delete/Approve Logic
            // =========================

            if (dataItem.IsEditable === true) {
                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").remove();
            }
            if (dataItem.IsChecked === true) {
                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").remove();
                row.find(".checkplacement").hide();

            }

            if (dataItem.IsApprove === true)
            {

                row.find(".checkplacement").hide();
                row.find(".approveplacement").hide();
                //row.find("#approveplacement").hide();
                row.find(".k-grid-delete").remove();

                if (dataItem.IsEditable === false)
                {

                    row.find("#editplacement").show();
                    row.find(".k-grid-edit").remove();

                }
                else
                {

                    row.find("#editplacement").hide();
                    row.find(".k-grid-edit").show();
                }

            }

            if (dataItem.IsApprove === false)
            {
                row.find("#editplacement").hide();
                row.find(".approveplacement").show();
               // row.find("#approveplacement").show();

            }

        });
    }

