@helper documentAttachment()
{
    @*<button onclick='UploadFile(#=EmployeeId#)' class='fa fa-upload btn btn-primary'>&nbsp;Upload </button>*@

    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Common.HRM.Attachment>()
                    .Name("AttachmentGrid#=PlacementId#")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.FileName).ClientTemplate("<a href='/HRM/EmployeePlacmentWithOJ/DownloadAttachment?attachmentId=\\#=AttachmentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; \\#=FileName\\# </a>").Width(150);
                        // columns.Bound(c => c.FileName).ClientTemplate(Html.ActionLink("\\#=FileName\\#", "DownloadFile", new { filename = "\\#=LetterSenderId\\#" }).ToHtmlString());
                        columns.Bound(c => c.Description).Width(100);
                        columns.Template(e => { }).ClientTemplate("<a href='/HRM/EmployeePlacmentWithOJ/DownloadAttachment?attachmentId=\\#=AttachmentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; Download </a>").Width(80);
                        columns.Template(e => { }).ClientTemplate("<a href='\\#=URL\\#/\\#=FileName\\#' target='_blank'> <f class = 'fa fa-folder-open'></i> &nbsp;&nbsp; Open</a>").Width(80);
                        columns.Command(command =>
                        {
                            command.Destroy().Text("Delete");

                        }).Width(300);



                    })
                    .ToolBar(toolbar =>
                    {
                    toolbar.Template(@<text>
                        @Html.Kendo().Upload().Name("file").Async(a => a.Save("AttachmentTemplateFiles_Create", "Attachment", new { Area = "Common", attachmentReferenceType = "DOCUMENT", id = "#=EmployeeId#", fileOwner = "#=EmployeeId#" })).Events(e => e.Complete("onUploadSuccess")
                                                                                                                    .Select("function(e) { globalOnSelect(e, ['.jpg', '.png', '.pdf'], 2 * 1024 * 1024); }")
                                                                        .Error("onUploadError")).ShowFileList(false).ToClientTemplate()
                    </text>);

                    })
                .Scrollable(h => h.Height("auto"))
                //.Events(ev =>
                //{
                //    ev.DataBound("onAttachmentDataBound");
                //})
                .DataSource(dataSource => dataSource
                .Ajax()
                .Sort(sort => sort.Add(c => c.AttachmentId).Descending())
                .Events(events =>
                {
                    events.Error("error_handler(\"AttachmentGrid#=PlacementId#\")");
                    events.RequestStart("onRequestStart(\"AttachmentGrid#=PlacementId#\")");
                    events.RequestEnd("onRequestEnd(\"AttachmentGrid#=PlacementId#\")");
                })
                .Model(model => model.Id(p => p.AttachmentId))
                    .Model(model => model.Id(p => p.AttachmentId))
                    .Read(read => read.Action("Attachments_Read", "Attachment", new { Area = "Common", attachmentReferenceType = "DOCUMENT", id = "#=EmployeeId#", fileOwner = "#=EmployeeId#" }).Data("sendForgery"))
                    .Create(create => create.Action("Attachments_Create", "Attachment", new { Area = "Common", attachmentReferenceType = "DOCUMENT", id = "#=EmployeeId#", fileOwner = "#=EmployeeId#" }).Data("sendForgery"))
                    .Destroy(destroy => destroy.Action("Attachments_Destroy", "EmployeeProfile").Data("sendForgery"))
                ).ToClientTemplate())
}

@helper placementAfterSystem()
{
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? true;
    @(Html.Kendo().Grid<PlacementAfterSystem>()
            .Name("placementAfterSystem_#=PlacementId#")
            .Columns(columns =>
            {

                columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["AllJobTitles"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
                if (useEthiopian)
                {
                    columns.Bound(c => c.FromAm).EditorTemplateName("Calander").Width(100);
                    columns.Bound(c => c.ToAm).EditorTemplateName("Calander").Width(100);
                }
                else
                {
                    columns.Bound(c => c.From).Width(100);
                    columns.Bound(c => c.To).Width(100);
                }


                columns.ForeignKey(c => c.RankId, (IEnumerable)ViewData["RankList"], "RankId", "RankName").EditorTemplateName("Rank").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
                columns.ForeignKey(c => c.StepId, (IEnumerable)ViewData["StepList"], "StepId", "StepName").EditorTemplateName("Step").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
                columns.Bound(c => c.Salary).Width(80);
                columns.Bound(c => c.AssignmentType).Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                columns.Bound(c => c.EmployementType).Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                columns.Bound(c => c.ResponsibilityLevel).Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                columns.Bound(c => c.IsHead).ClientTemplate(
                    "<input type='checkbox' disabled = 'true' value='\\#= IsHead\\#' " +
                    "\\# if (IsHead) { \\#" +
                    "checked='checked'" +
                    "\\# } \\#" +"/>").HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(150);
            })
            .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable()
            .Selectable()
            .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events =>
                {
                    events.Error("error_handler(\"placementAfterSystem_#=PlacementId#\")");
                    events.RequestStart("onRequestStart(\"placementAfterSystem_#=PlacementId#\")");
                    events.RequestEnd("onRequestEnd(\"placementAfterSystem_#=PlacementId#\")");

                })
                .Model(model => model.Id(p => p.PlacementAfterSystemId))
                .Read(read => read.Action("PlacementAfterSystem_Read", "EmployeePlacmentWithOJ", new { id = "#=EmployeeId#" }).Data("sendForgery"))

                ).ToClientTemplate()
    )
}
<script>

   
    function autoCompleteHeadOnChange()
    {
        var employeeId = $("#EmployeeId").data("kendoDropDownList").value();
        var branchId = $("#BranchId").data("kendoDropDownList").value();
        var orgId = $("#OrgStructureId").data("kendoDropDownList").value();
        var businessId = $("#BusinessUnitId").data("kendoDropDownList").value();

        if (employeeId && orgId && branchId && businessId) {
            $.ajax({
                url: '@Url.Action("AutoCompleteHead", "EmployeePlacmentWithOJ")',
                type: 'GET',
                data: {
                    employeeId: employeeId,
                    orgId: orgId,
                    branId: branchId,
                    businUinitId: businessId
                },
                success: function (result) {
                    var headDropDown = $("#HeadId").data("kendoDropDownList");

                    if (result && result.headId) {
                        headDropDown.value(result.headId);
                        headDropDown.text(result.fullName);
                    } else {
                        headDropDown.value("");
                        headDropDown.text("");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching head info:", error);
                }
            });

        }

    }

    function handleButtonClick(e)
    {
        e.preventDefault(); // Prevent default form submission behavior

        var fromGrade = $("#FromGrade").data("kendoDropDownList").value();
        var toGrade = $("#ToGrade").data("kendoDropDownList").value();
        var fromStep = $("#FromStep").data("kendoDropDownList").value();
        var toStep = $("#ToStep").data("kendoDropDownList").value(); // Corrected typo in variable name

        // Check conditions sequentially and return if any condition fails
        if (fromGrade === "") {
            alert("Please select From grade first");
            return;
        }
        if (toGrade === "") {
            alert("Please select the to Grade first");
            return;
        }
        if (fromStep === "") {
            alert("Please select from step");
            return;
        }
        if (toStep === "") {
            alert("Please select the to step");
            return;
        }
        if (toStep === fromStep && fromGrade === toGrade) {
            alert(" ‘From’ and ‘To’ steps and grades cannot be the same. Please select different values.");
            return;
        }
        $('#loading-image').show();
        $.ajax({
            url: '@Url.Action("GetPromoteEmployee", "EmployeePlacmentWithOJ")',
            data: { fromRank: fromGrade, toRank: toGrade, fromStep: fromStep, toStep: toStep },
            type: 'POST',
            cache: false,
            success: function(result) {
                alert(result);
                location.reload();
            }
        });
    }
    function filterParam() {
        return {
            gradeId: $("#FromGrade").val(),
            stepId: $("#FromStep").val(),
        };
    }
</script>
