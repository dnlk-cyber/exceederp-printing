@using System.Collections
@using System.Security.AccessControl
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isManual = ViewData["isManual"] != null && (bool)ViewData["isManual"];
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? true;
    bool autoReg = ViewData["autoEmployeeReg"] as bool? ?? false;
    bool autoExempt = ViewData["autoEmployeeExempt"] as bool? ?? false;
    bool needChecker = ViewData["placementChecker"] as bool? ?? false;

}
<div class="epwoj-page-header">
    <i class="fa fa-sitemap"></i>
    <legend>@Resources.NavigatorPlacment_EmployeePlacment</legend>
</div>
<div class="row">
    <p>
        <span class="fa fa-circle" style="color:gray;"></span>&nbsp;&nbsp;@Resources.HR_Allowance_AllowancePerEmployee_Pend,&nbsp;&nbsp;
        <span class="fa fa-circle" style="color:olive;"></span>&nbsp;&nbsp;@Resources.Rpt_RetirementNotification &nbsp;&nbsp;
        <span class="fa fa-circle" style="color:darkorange;"></span>&nbsp;&nbsp; @Resources.Unapproved_Employees &nbsp;&nbsp;
        <a href="javascript:void(0);"
           onclick="updateEmployeeAge(this)"
           class="btn btn-link btn-xs">
            <i class="fa fa-refresh"></i>
            @Resources.ActionButton_Update @Resources.Age
        </a>
        <a href="javascript:void(0);"
           onclick="updateEmployeeSalary(this)"
           class="btn btn-link btn-xs">
            <i class="fa fa-refresh"></i> @Resources.ActionButton_Update @Resources.Rpt_Salary
        </a>

        <a href="javascript:void(0);"
           onclick="updateEmployeeProbation(this)"
           class="btn btn-link btn-xs">
            <i class="fa fa-refresh"></i> @Resources.ActionButton_Update @Resources.Employee @Resources.Probation
        </a>

    </p>
</div>

<div class="epwoj-grid-wrapper">
@(Html.Kendo().Grid<Placement>()
        .Name("PlacementGrid")
        .Columns(columns =>
        {
            columns.Bound(c => c.EmployeeCode).Width(120);
            columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Width(180);
            columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Title(Resources.Placement_FullName).Width(150);
            columns.ForeignKey(c => c.HeadId, (IEnumerable)ViewData["EmployeeList"], "HeadId", "FullNameaEnglish").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
            columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
            columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
            columns.ForeignKey(c => c.ParentOrgStructureId, (System.Collections.IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(170);
            columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
            columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["AllJobTitles"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
            columns.Bound(c => c.IsHead).ClientTemplate("<input type='checkbox' disabled = 'true' value='#=IsHead#' " +
                                                                     "# if (IsHead) { #" +
                                                                     "checked='checked'" +"# } #" +"/>").Width(130);

            if (useEthiopian)
            {
                columns.Bound(c => c.HireDate).Width(120);
                columns.Bound(c => c.AssignmentDateAmharic).Width(160);
                columns.Bound(c => c.SalarChangeDateAmharic).Width(100);
                columns.Bound(c => c.NextSalaryChangeDateAmharic).Width(100);
            }
            else
            {
                columns.Bound(c => c.HireDateGorg).Width(100);
                columns.Bound(c => c.AssignmentDate).Width(160);
                columns.Bound(c => c.SalarChangeDate).Width(100);
                columns.Bound(c => c.NextSalaryChangeDate).Width(100);
            }
            columns.ForeignKey(c => c.RankId, (IEnumerable)ViewData["RankList"], "RankId", "RankName").EditorTemplateName("Rank").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
            columns.ForeignKey(c => c.StepId, (IEnumerable)ViewData["StepList"], "StepId", "StepName").EditorTemplateName("Step").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
            columns.Bound(c => c.Salary).Width(80);
            columns.Bound(c => c.AssignmentType).Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
            columns.Bound(c => c.EmployementType).Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
            columns.Bound(c => c.isCurrent).ClientTemplate("<input type='checkbox' disabled='true' value='#=isCurrent #' " + " # if (isCurrent) { #" + "checked='checked'" + "# } #" + " />").Width(100);
            columns.Bound(c => c.IsApprove).ClientTemplate(
                "<input type='checkbox' disabled = 'true' value='#= IsApprove#' " +
                "# if (IsApprove) { #" +
                "checked='checked'" +
                "# } #" +
                "/>").Width(100);
            columns.Bound(c => c.IsPend).ClientTemplate(
                "<input type='checkbox' disabled = 'true' value='#= IsPend#' " +
                "# if (IsPend) { #" +
                "checked='checked'" +
                "# } #" +
                "/>").Width(100);
            columns.Bound(c => c.ResponsibilityLevel).Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
            columns.Bound(c => c.Age).ClientTemplate("#= Math.floor(Age) #").Width(100);
            columns.Bound(c => c.Gender).Format("{0:0}").Width(100);
            columns.ForeignKey(c => c.EmployeeTypeId, (IEnumerable)ViewData["employeeType"], "EmployeeTypeId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
            columns.Bound(c => c.Remark).Width(100);
            columns.Command(command =>
            {

                if (HttpContext.Current.User.IsInRole("HR_Placement_User") 
                || HttpContext.Current.User.IsInRole("HR_Admin") 
                || HttpContext.Current.User.IsInRole("HR_Placement_Editor"))
                {
                    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit).HtmlAttributes(new { @id = "modify" });
                    command.Custom("").Click("Pend").Text(Resources.HR_Allowance_AllowancePerEmployee_Pend).IconClass("fa fa-remove fa4x").HtmlAttributes(new { @class = "btn btn-yellow", @title = "Pend the employee to stop payroll processing ", @id = "pend" });
                    command.Custom("").Click("UnPend").Text(Resources.HR_Allowance_AllowancePerEmployee_UnPend).IconClass("fa fa-check fa4x").HtmlAttributes(new { @class = "btn btn-white", @title = "Remove the employee from pend lists to start payroll processing ", @id = "unpend" });
                }
                if (needChecker)
                {
                    if (HttpContext.Current.User.IsInRole("PlacementChecker") ||
                   HttpContext.Current.User.IsInRole("HR_Placement_User")
                   || HttpContext.Current.User.IsInRole("HR_Admin"))
                    {
                        command.Custom("")
                            .Click("CheckPlacement")
                            .Text("Check")
                            .IconClass("fa fa-check")
                            .HtmlAttributes(new
                            {
                                @class = "btn btn-primary checkplacement",
                                @title = "Check Placement",
                                @id = "checkplacement"
                            });
                    }
                }

                if (HttpContext.Current.User.IsInRole("PlacementApprover") || HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Placement_User"))
                {
                    command.Custom("").Click("ApprovePlacement").Text(Resources.ActionButton_Approve).IconClass("fa fa-check fa4x").HtmlAttributes(new { @class = "btn btn-success approveplacement", @title = "Approve Placement ", @id = "approveplacement" });
                }

                if (HttpContext.Current.User.IsInRole("HR_Placement_Editor") || HttpContext.Current.User.IsInRole("HR_Admin"))
                {

                    command.Custom("editPlacement").Click("setPlacementAsEditable").Text(Resources.Enable_Editing)
                        .IconClass("fa fa-key fa-2x")
                        .HtmlAttributes(new
                        {
                            @class = "btn btn-primary",
                            @title = "Enable editing for those who have the Placement role",
                            @id = "editplacement"
                        });
                }
                if (HttpContext.Current.User.IsInRole("HR_Placement_Admin")
                || HttpContext.Current.User.IsInRole("HR_Admin")
                || HttpContext.Current.User.IsInRole("HR_Placement_Editor"))
                {
                    command.Destroy().Text(Resources.ActionButton_Cancel);
                }

            }).Width(350);


        })
        .ToolBar(toolbar =>
        {
            if (HttpContext.Current.User.IsInRole("HR_Placement_User"))
            {
                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
            }

            if (HttpContext.Current.User.IsInRole("GenerateDayAbsent"))
            {
            }
            if (HttpContext.Current.User.IsInRole("HR_Placement_Admin")
            || HttpContext.Current.User.IsInRole("HR_Admin")
            || HttpContext.Current.User.IsInRole("HR_Placement_User"))
            {
                toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });

            }
        })
        .Excel(excel => excel
        .FileName(Resources.NavigatorPlacment_EmployeePlacment + ".xlsx")
        .Filterable(true)
        .AllPages(true)
        .ProxyURL(Url.Action("Excel_Export_Save", "EmployeePlacmentWithOJ")))
        .Editable(editable => editable.Mode(GridEditMode.PopUp)
                        .TemplateName("Placement")
                        .Window(window =>
                        {
                            window.Title(Resources.NavigatorPlacment_EmployeePlacment);
                            window.Scrollable(false);
                        }))
        .Scrollable(h => h.Height(550))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Filterable()
        .Events(e =>
        {
            e.DataBound("onDataBound");
            e.DetailExpand("onDetailExpandUser");
            e.Cancel("onCancel");


        })
        .Pageable(pageable => pageable
        .Input(true)
        .Numeric(false)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Sort(sort => sort.Add(s => s.PlacementId).Descending())
            .Events(events =>
            {
                events.Error("error_handler(\"PlacementGrid\")");
                events.RequestStart("onRequestStart(\"PlacementGrid\")");
                events.RequestEnd("onRequestEnd(\"PlacementGrid\")");
            })
            .Model(model =>
            {
                model.Id(p => p.PlacementId);
                model.Field(p => p.AssignmentType).DefaultValue(-1);
                model.Field(p => p.ResponsibilityLevel).DefaultValue(-1);
                model.Field(p => p.EmployementType).DefaultValue(-1);
            })
            .Read(read => read.Action("Placements_Read", "EmployeePlacmentWithOJ").Data("sendForgery"))
            .Create(create => create.Action("Placements_Create", "EmployeePlacmentWithOJ").Data("sendForgery"))
            .Update(update => update.Action("Placements_Update", "EmployeePlacmentWithOJ").Data("sendForgery"))
            .Destroy(destroy => destroy.Action("Placements_Destroy", "EmployeePlacmentWithOJ").Data("sendForgery"))
            ).ClientDetailTemplateId("template")
)
</div>



