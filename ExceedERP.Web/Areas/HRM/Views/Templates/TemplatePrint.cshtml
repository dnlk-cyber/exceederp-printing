                pendingImages[j].onerror = imageReady;
            }

            // Never leave the print button stuck if a browser does not fire an
            // image event for a data URL.
            setTimeout(printNow, 2000);
        }

        function executeIsolatedPrint() {
            var printArea = document.getElementById("isolatedPrintArea");
            if (!printArea) return;

            var existingIframe = document.getElementById("templatePrintIframe");
            if (existingIframe) {
                document.body.removeChild(existingIframe);
            }

            var iframe = document.createElement("iframe");
            iframe.id = "templatePrintIframe";
            iframe.style.position = "fixed";
            iframe.style.right = "0";
            iframe.style.bottom = "0";
            iframe.style.width = "0";
            iframe.style.height = "0";
            iframe.style.border = "0";
            document.body.appendChild(iframe);

            var doc = iframe.contentWindow.document;
            doc.open();
            doc.write('<!DOCTYPE html><html><head><title>Print Preview</title>');
            doc.write('<style>' +
                '@@page { size: A4 portrait; margin: 12mm 15mm 24mm 15mm; }' +
                '* { box-sizing: border-box; }' +
                'body { margin: 0; padding: 0; color: #111; font-family: "Nyala", "Abyssinica SIL", "Segoe UI", Arial, sans-serif; font-size: 15px; background: #fff; }' +
                '.template-actions-bar { display: none !important; }' +
                // Reserves room for the fixed footer banner so text wraps to a new page instead of being hidden behind it.
                '#isolatedPrintArea { width: 100% !important; max-width: 100% !important; margin: 0; padding: 0 0 30mm 0; position: relative; }' +
                '@Html.Raw(watermarkPrintCss)' +
                '.t-header-container { border-bottom: 2.5px solid #1b4d89; padding-bottom: 8px; margin-bottom: 12px; background: #fff; position: relative; z-index: 1; }' +
                '.t-top-banner { display: flex; align-items: center; justify-content: space-between; }' +
                '.t-org-name-en { font-family: "Arial Black", Arial, sans-serif; font-size: 18px; font-weight: 900; color: #1b4d89; margin: 0; }' +
                '.t-org-name-am { font-size: 17px; font-weight: bold; color: #1b4d89; margin: 0; }' +
                '.t-meta-container { display: flex; justify-content: flex-end; margin-top: 10px; margin-bottom: 15px; }' +
                '.meta-box { font-size: 13px; color: #1b4d89; font-weight: bold; line-height: 1.4; }' +
                '.meta-row { display: flex; align-items: baseline; justify-content: flex-end; margin-bottom: 6px; }' +
                '.meta-label { text-align: right; margin-right: 10px; font-size: 12px; }' +
                '.meta-line { display: inline-block; border-bottom: 1px solid #1b4d89; width: 160px; }' +
                '.t-letter-body { text-align: justify; font-size: 15px; line-height: 1.7; margin-top: 10px; }' +
                '.t-footer-banner { border-top: 2px solid #1b4d89; padding-top: 8px; display: flex; align-items: center; justify-content: space-between; gap: 14px; font-size: 10px; color: #333; background: #fff; position: fixed; left: 0; right: 0; bottom: 0; }' +
                '.t-footer-col { flex: 1; }' +
                '.t-footer-col div { margin-bottom: 3px; white-space: nowrap; }' +
                '.t-footer-contact i, .t-footer-address i { width: 12px; display: inline-block; text-align: center; margin-right: 4px; color: #e0701e; }' +
                '.t-footer-contact div, .t-footer-address div { color: #e0701e; font-weight: 600; }' +
                '.t-footer-qr { flex: 0 0 auto; display: flex; gap: 8px; justify-content: flex-end; }' +
                '.t-qr { width: 46px; height: 46px; -webkit-print-color-adjust: exact; print-color-adjust: exact; }' +
                '.t-qr img { width: 46px; height: 46px; display: block; }' +
                '</style>');
            doc.write('<link rel="stylesheet" href="@Url.Content("~/Content/ace/font-awesome/4.2.0/css/font-awesome.min.css")">');
            doc.write('</head><body>');
            doc.write(getPrintAreaWithStaticQr(printArea));
            doc.write('</body></html>');
            doc.close();
            printIframeWhenReady(iframe);
        }
