    <script>
        // Kendo QR codes are SVG/canvas; as plain <img> they print even when the browser's "Background graphics" option is off.
        function getPrintAreaWithStaticQr(printArea) {
            var clone = printArea.cloneNode(true);
            $(printArea).find(".t-qr").each(function () {
                var src = null;
                var svg = this.querySelector("svg");
                var canvas = this.querySelector("canvas");
                if (svg) {
                    var xml = new XMLSerializer().serializeToString(svg);
                    src = "data:image/svg+xml;base64," + btoa(unescape(encodeURIComponent(xml)));
