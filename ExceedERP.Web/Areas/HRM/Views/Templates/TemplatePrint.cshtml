@model ExceedERP.Reporting.HRM.HRM.Letters.ExpLetter
@{
    Layout = null;

    var logoSrc = Model != null ? GetImageSrc(Model.LogoFile) : null;
    var sigSrc = Model != null ? GetImageSrc(Model.SignatureFile) : null;
    var watermarkSrc = !string.IsNullOrEmpty(ViewBag.WaterMarkUrl as string) ? ViewBag.WaterMarkUrl as string : logoSrc;
    var headerImageSrc = ViewBag.HeaderImageUrl as string;
    var fallbackLogoSrc = !string.IsNullOrEmpty(logoSrc) ? logoSrc : (ViewBag.IsoLogoSrc as string);

    // Bundled banner used until an admin configures a TemplateHeaderImage in HeaderImageUrl.
    const string defaultHeaderImagePath = "~/Content/Image/WaterMark/header-image-2.png";
    var defaultHeaderImageSrc = System.IO.File.Exists(Server.MapPath(defaultHeaderImagePath)) ? Url.Content(defaultHeaderImagePath) : null;

    // Updated QR Code Image path (pointing to qrcode.png)
    var staticQrPath = Url.Content("~/Content/Images/qrcode.png");

    var watermarkPrintCss = string.IsNullOrEmpty(watermarkSrc) ? "" :
        "* { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; color-adjust: exact !important; } " +
        "#isolatedPrintArea::before { content: \"\"; position: fixed; top: 20vh; left: 0; right: 0; bottom: 12vh; background-image: url(" + watermarkSrc + "); background-repeat: no-repeat; background-position: center; background-size: 100% 100%; image-rendering: -webkit-optimize-contrast; opacity: 0.35; mix-blend-mode: multiply; z-index: 0; pointer-events: none; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }";
}

@functions {
    public string GetImageSrc(byte[] imageBytes)
    {
        if (imageBytes == null || imageBytes.Length == 0) return null;
        return "data:image/png;base64," + Convert.ToBase64String(imageBytes);
    }

    public string GetImageSrc(string base64Data)
    {
        if (string.IsNullOrWhiteSpace(base64Data)) return null;
        if (base64Data.StartsWith("data:image", StringComparison.OrdinalIgnoreCase)) return base64Data;
        return "data:image/png;base64," + base64Data.Trim();
    }
}

<style>
    #isolatedPrintArea {
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        padding: 10px 16px;
        color: #111;
        background: #fff;
        position: relative;
        font-family: 'Nyala', 'Abyssinica SIL', 'Segoe UI', Arial, sans-serif;
        font-size: 14px;
        line-height: 1.5;
    }

    @@media (min-width: 640px) {
        #isolatedPrintArea {
            max-width: 900px;
            padding: 15px 32px;
            font-size: 15px;
        }
    }

    @@media print {
        #isolatedPrintArea {
            padding-bottom: 25mm;
        }
    }

    #isolatedPrintArea * {
        box-sizing: border-box;
    }

    .template-actions-bar {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-bottom: 8px;
        padding-bottom: 6px;
        border-bottom: 1px solid #e5e7eb;
    }

    .btn-template-print {
        background-color: #1b4d89;
        color: #fff;
        border: none;
        padding: 6px 14px;
        border-radius: 4px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-template-print:hover {
        background-color: #143a68;
        color: #fff;
    }

    @if (!string.IsNullOrEmpty(watermarkSrc)) {
        <text>
        #isolatedPrintArea::before, #isolatedPrintArea {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color-adjust: exact !important;
        }

        #isolatedPrintArea::before {
            content: "";
            position: absolute;
            top: 20vh;
            left: 0;
            right: 0;
            bottom: 12vh;
            background-image: url('@watermarkSrc');
            background-repeat: no-repeat;
            background-position: center;
            background-size: 100% 100%;
            image-rendering: -webkit-optimize-contrast;
            opacity: 0.35;
            mix-blend-mode: multiply;
            z-index: 0;
            pointer-events: none;
        }
        </text>
    }

    .print-table {
        width: 100%;
        border-collapse: collapse;
    }

    .print-table thead {
        display: table-header-group;
    }

    .t-header-container {
        border-bottom: 2px solid #1b4d89;
        padding-bottom: 4px;
        margin-bottom: 6px;
        position: relative;
        background: #fff;
        z-index: 1;
    }

    .t-top-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .t-org-name-en {
        font-family: 'Arial Black', Arial, sans-serif;
        font-size: 18px;
        font-weight: 900;
        color: #1b4d89;
        margin: 0;
    }

    .t-org-name-am {
        font-size: 17px;
        font-weight: bold;
        color: #1b4d89;
        margin: 0;
    }

    .t-meta-container {
        display: flex;
        justify-content: flex-end;
        margin-top: 4px;
        margin-bottom: 8px;
        position: relative;
        z-index: 1;
    }

    .meta-box {
        font-size: 13px;
        color: #1b4d89;
        font-weight: bold;
        line-height: 1.3;
    }

    .meta-row {
        display: flex;
        align-items: baseline;
        justify-content: flex-end;
        margin-bottom: 4px;
    }

    .meta-label {
        text-align: right;
        margin-right: 10px;
        font-size: 12px;
    }

    .meta-line {
        display: inline-block;
        border-bottom: 1px solid #1b4d89;
        width: 160px;
    }

    .t-letter-body {
        text-align: justify;
        line-height: 1.5;
        margin-top: 4px;
        position: relative;
        z-index: 1;
    }

    .t-letter-body p {
        margin-bottom: 8px;
    }

    .t-footer-banner {
        border-top: 2px solid #1b4d89;
        margin-top: 15px;
        padding-top: 6px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        font-size: 10px;
        color: #333;
        position: relative;
        background: #fff;
        z-index: 1;
    }

    .t-footer-col {
        flex: 1;
    }

    .t-footer-col div {
        margin-bottom: 2px;
        white-space: nowrap;
    }

    .t-footer-contact i,
    .t-footer-address i {
        width: 12px;
        display: inline-block;
        text-align: center;
        margin-right: 4px;
        color: #e0701e;
    }

    .t-footer-contact div,
    .t-footer-address div {
        color: #e0701e;
        font-weight: 600;
    }

    .t-footer-qr {
        flex: 0 0 auto;
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .t-qr {
        width: 42px;
        height: 42px;
    }

    .t-qr img {
        width: 42px;
        height: 42px;
        object-fit: contain;
        display: block;
    }
</style>

<div id="isolatedPrintArea">
    <div class="template-actions-bar">
        <button type="button" class="btn-template-print" onclick="executeIsolatedPrint()">
            <i class="fa fa-print"></i> Print Letter
        </button>
    </div>

    <table class="print-table">
        <thead>
            <tr>
                <td>
                    <!-- Header -->
                    <div class="t-header-container">
                        @if (!string.IsNullOrEmpty(headerImageSrc))
                        {
                            <img src="@headerImageSrc" style="width: 100%; height: auto; display: block;" alt="Header" />
                        }
                        else if (!string.IsNullOrEmpty(defaultHeaderImageSrc))
                        {
                            <img src="@defaultHeaderImageSrc" style="width: 100%; height: auto; display: block;" alt="Header" />
                        }
                        else
                        {
                            <div class="t-top-banner">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    @if (!string.IsNullOrEmpty(fallbackLogoSrc))
                                    {
                                        <img src="@fallbackLogoSrc" style="height: 44px; width: auto; object-fit: contain;" alt="Logo" />
                                    }
                                    <div>
                                        <h1 class="t-org-name-en">@(Model != null && !string.IsNullOrEmpty(Model.EnglishName) ? Model.EnglishName : (Model != null ? Model.Name : ""))</h1>
                                        <small style="color: #e0701e; font-weight: bold; font-size: 9px; letter-spacing: 1px;">WE BUILD YOUR CHOICE!</small>
                                    </div>
                                </div>
                                <div style="text-align: right;">
                                    <div class="t-org-name-am">@(Model != null && !string.IsNullOrEmpty(Model.AmharicName) ? Model.AmharicName : "ኤምሲጂ ኮንስትራክሽን ኃ/የተ/የግ/ማህበር")</div>
                                    <small style="color: #e0701e; font-size: 9px;">ምርጫዎትን እንገነባለን!</small>
                                </div>
                            </div>
                        }
                    </div>
                </td>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <!-- Meta Info Top Right -->
                    <div class="t-meta-container">
                        <div class="meta-box">
                            <div class="meta-row">
                                <div class="meta-label">Ref. No<br />ቁጥር</div>
                                <span class="meta-line"></span>
                            </div>
                            <div class="meta-row">
                                <div class="meta-label">Date<br />ቀን</div>
                                <span class="meta-line"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Letter Body -->
                    <div class="t-letter-body">
                        @if (Model != null && !string.IsNullOrEmpty(Model.Experience))
                        {
                            @Html.Raw(HttpUtility.HtmlDecode(Model.Experience))
                        }
                    </div>
                </td>
            </tr>
        </tbody>
    </table>

    <!-- Footer Banner -->
    @{
        var footerWebsite = Model != null && !string.IsNullOrEmpty(Model.WebSite) ? Model.WebSite : "www.mcg.et";
        var footerEmail = Model != null && !string.IsNullOrEmpty(Model.Email) ? Model.Email : "mcgcon.et@gmail.com";
        var footerAddress = Model != null && !string.IsNullOrEmpty(Model.Address) ? Model.Address : "ADDIS ABABA / ETHIOPIA";
        var addressLine1 = footerAddress;
        var addressLine2 = "";
        var addressSplit = -1;
        for (int i = 0; i < footerAddress.Length; i++)
        {
            if (footerAddress[i] == ',' && (addressSplit < 0 || Math.Abs(i - footerAddress.Length / 2) < Math.Abs(addressSplit - footerAddress.Length / 2)))
            {
                addressSplit = i;
            }
        }
        if (addressSplit >= 0 && addressSplit < footerAddress.Length - 1)
        {
            addressLine1 = footerAddress.Substring(0, addressSplit + 1).Trim();
            addressLine2 = footerAddress.Substring(addressSplit + 1).Trim();
        }
    }
    <div class="t-footer-banner">
        <div class="t-footer-col t-footer-contact">
            <div><i class="fa fa-envelope"></i> @footerEmail</div>
            <div><i class="fa fa-globe"></i> @footerWebsite</div>
            <div><i class="fa fa-phone"></i> @(Model != null && !string.IsNullOrEmpty(Model.Tel) ? Model.Tel : "+251-111-7233-04")</div>
        </div>
        <div class="t-footer-col t-footer-address">
            <div>
                <i class="fa fa-map-marker" style="vertical-align: top;"></i><span style="display: inline-block; vertical-align: top;">
                    @(addressLine1)@if (!string.IsNullOrEmpty(addressLine2))
                {<br />@(addressLine2)}
                </span>
            </div>
        </div>
        <div class="t-footer-col t-footer-qr">
            <div class="t-qr"><img src="@staticQrPath" alt="QR Code" /></div>
            <div class="t-qr"><img src="@staticQrPath" alt="QR Code" /></div>
        </div>
    </div>
</div>

<script>
    function printIframeWhenReady(iframe) {
        var printStarted = false;
        var printNow = function () {
            if (printStarted) return;
            printStarted = true;
            iframe.contentWindow.focus();
            iframe.contentWindow.print();
        };
        var images = iframe.contentDocument ? iframe.contentDocument.images : [];
        var pendingImages = [];

        for (var i = 0; i < images.length; i++) {
            if (!images[i].complete) {
                pendingImages.push(images[i]);
            }
        }

        if (pendingImages.length === 0) {
            setTimeout(printNow, 100);
            return;
        }

        var remaining = pendingImages.length;
        var imageReady = function () {
            remaining--;
            if (remaining <= 0) {
                setTimeout(printNow, 100);
            }
        };

        for (var j = 0; j < pendingImages.length; j++) {
            pendingImages[j].onload = imageReady;
            pendingImages[j].onerror = imageReady;
        }

        setTimeout(printNow, 2000);
    }

    function executeIsolatedPrint() {
        var printArea = document.getElementById("isolatedPrintArea");
        if (!printArea) return;

        var existingIframe = document.getElementById("templatePrintIframe");
        if (existingIframe) {
            document.body.removeChild(existingIframe);
        }

        var iframe = document.createElement("iframe");
        iframe.id = "templatePrintIframe";
        iframe.style.position = "fixed";
        iframe.style.right = "0";
        iframe.style.bottom = "0";
        iframe.style.width = "0";
        iframe.style.height = "0";
        iframe.style.border = "0";
        document.body.appendChild(iframe);

        var doc = iframe.contentWindow.document;
        doc.open();
        doc.write('<!DOCTYPE html><html><head><title></title>');
        doc.write('<style>' +
            '@@page { size: A4 portrait; margin: 8mm 15mm 12mm 15mm; }' +
            '* { box-sizing: border-box; }' +
            'body { margin: 0; padding: 0; color: #111; font-family: "Nyala", "Abyssinica SIL", "Segoe UI", Arial, sans-serif; font-size: 15px; background: #fff; }' +
            '.template-actions-bar { display: none !important; }' +
            '#isolatedPrintArea { width: 100% !important; max-width: 100% !important; margin: 0; padding: 0; position: relative; }' +
            'table { width: 100%; border-collapse: collapse; }' +
            'thead { display: table-header-group; }' +
            '@Html.Raw(watermarkPrintCss)' +
            '.t-header-container { border-bottom: 2px solid #1b4d89; padding-bottom: 4px; margin-bottom: 6px; background: #fff; position: relative; z-index: 1; }' +
            '.t-top-banner { display: flex; align-items: center; justify-content: space-between; }' +
            '.t-org-name-en { font-family: "Arial Black", Arial, sans-serif; font-size: 18px; font-weight: 900; color: #1b4d89; margin: 0; }' +
            '.t-org-name-am { font-size: 17px; font-weight: bold; color: #1b4d89; margin: 0; }' +
            '.t-meta-container { display: flex; justify-content: flex-end; margin-top: 4px; margin-bottom: 8px; }' +
            '.meta-box { font-size: 13px; color: #1b4d89; font-weight: bold; line-height: 1.3; }' +
            '.meta-row { display: flex; align-items: baseline; justify-content: flex-end; margin-bottom: 4px; }' +
            '.meta-label { text-align: right; margin-right: 10px; font-size: 12px; }' +
            '.meta-line { display: inline-block; border-bottom: 1px solid #1b4d89; width: 160px; }' +
            '.t-letter-body { text-align: justify; font-size: 15px; line-height: 1.5; margin-top: 4px; }' +
            '.t-letter-body p { margin-bottom: 8px; }' +
            '.t-footer-banner { border-top: 2px solid #1b4d89; padding-top: 6px; display: flex; align-items: center; justify-content: space-between; gap: 14px; font-size: 10px; color: #333; background: #fff; position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; }' +
            '.t-footer-col { flex: 1; }' +
            '.t-footer-col div { margin-bottom: 2px; white-space: nowrap; }' +
            '.t-footer-contact i, .t-footer-address i { width: 12px; display: inline-block; text-align: center; margin-right: 4px; color: #e0701e; }' +
            '.t-footer-contact div, .t-footer-address div { color: #e0701e; font-weight: 600; }' +
            '.t-footer-qr { flex: 0 0 auto; display: flex; gap: 8px; justify-content: flex-end; }' +
            '.t-qr { width: 42px; height: 42px; -webkit-print-color-adjust: exact; print-color-adjust: exact; }' +
            '.t-qr img { width: 42px; height: 42px; display: block; object-fit: contain; }' +
            '</style>');
        doc.write('<link rel="stylesheet" href="@Url.Content("~/Content/ace/font-awesome/4.2.0/css/font-awesome.min.css")">');
        doc.write('</head><body>');
        doc.write(printArea.outerHTML);
        doc.write('</body></html>');
        doc.close();
        printIframeWhenReady(iframe);
    }
</script>


