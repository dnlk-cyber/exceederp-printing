@model ExceedERP.Core.Domain.HRM.Templates.Template

@{
                ViewBag.Title = "Create";
                Layout = "~/Views/Shared/_Layout.cshtml";
}


<legend>Create Templates here</legend>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
<div class="form">
    <div class="row fullrow">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.TemplateType, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EnumDropDownListFor(model => model.TemplateType, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.TemplateType, "", new { @class = "text-danger" })
            </div>
        </div>
        <div>&nbsp;</div>
        <div class="form-group">
            @Html.LabelFor(model => model.Document, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <textarea name="Document" id="Document" cols="200" rows="15" ></textarea>
                @Html.ValidationMessageFor(model => model.Document, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>
