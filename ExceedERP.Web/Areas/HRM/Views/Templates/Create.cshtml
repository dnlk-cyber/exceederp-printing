@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.Templates.Template

@{
    ViewBag.Title = Resources.Create_Templates_here;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var recordKeyItems = Enum.GetValues(typeof(ExceedERP.Core.Domain.HRM.Templates.RecordKeyType))
        .Cast<Enum>()
        .Select(e => e.ToString())
        .OrderBy(e => e)
        .ToList();
}

<div class="template-page">
    <div class="template-page-header">
        <div>
            <h3><i class="fa fa-file-alt"></i> @Resources.Create_Templates_here</h3>
            <p>Design a document template for <strong>Telerik reports</strong> and printable <strong>HTML letters</strong>. Insert replaceable keys and they'll be substituted with real employee/record data when the template is printed.</p>
        </div>
        @Html.ActionLink(Resources.Action_Button_Back_to_List, "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="template-meta-card">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        @Html.LabelFor(model => model.TemplateType, htmlAttributes: new { @class = "control-label" })
                        @Html.EnumDropDownListFor(model => model.TemplateType, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.TemplateType, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        @Html.LabelFor(model => model.TemplateTypeSettingId, htmlAttributes: new { @class = "control-label" })
                        @( Html.Kendo().DropDownListFor(m => m.TemplateTypeSettingId)
                                                .OptionLabel(Resources.Select)
                                                .DataTextField("TemplateType")
                                                .DataValueField("TemplateTypeSettingId")
                                                .Filter("contains")
                                                    .DataSource(dataSource =>
                                                    {
                                                        dataSource.Read(read => read.Action("GetTeplateType", "Templates", new { area = "HRM" }).Data("sendForgery"))
                                                        .ServerFiltering(false);
                                                    })
                                                        .ValuePrimitive(true)
                        )
                        @Html.ValidationMessageFor(model => model.TemplateType, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.Title, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        <div class="row template-editor-row">
            <div class="col-md-8">
                <div class="template-section-card">
                    <h5><i class="fa fa-edit"></i> Document Content @if (!string.IsNullOrEmpty(ViewBag.WaterMarkUrl as string)) { <span class="template-watermark-badge" title="The company watermark shows faintly behind your text, matching the printed output"><i class="fa fa-tint"></i> Watermark preview on</span> }</h5>
                    <div class="form-group">
                        @(Html.Kendo().EditorFor(model => model.Document)
                                    .Name("Document")
                                    .HtmlAttributes(new { style = "width:100%" })
                                    .Tools(tools => tools
                                        .Clear()
                                        .FontName(font => font
                                            .Add("Nyala", "Nyala")
                                            .Add("Abyssinica SIL", "Abyssinica SIL")
                                            .Add("Times New Roman", "Times New Roman")
                                            .Add("Calibri", "Calibri")
                                            .Add("Cambria", "Cambria")
                                            .Add("Garuda", "Garuda")
                                            .Add("Garamond", "Garamond")
                                            .Add("Georgia", "Georgia")
                                            .Add("Arial", "Arial")
                                            .Add("Helvetica", "Helvetica")
                                            .Add("Tahoma", "Tahoma")
                                            .Add("Verdana", "Verdana")
                                            .Add("Trebuchet MS", "Trebuchet MS")
                                            .Add("Century Gothic", "Century Gothic")
                                            .Add("Ebrima", "Ebrima")
                                            .Add("Segoe UI", "Segoe UI")
                                            .Add("Open Sans", "Open Sans")
                                            .Add("Roboto", "Roboto")
                                        )
                                        .FontSize()
                                        .Formatting()
                                        .Bold()
                                        .Italic()
                                        .Underline()
                                        .Strikethrough()
                                        .SubScript()
                                        .SuperScript()
                                        .BackColor()
                                        .CleanFormatting()
                                        .JustifyLeft()
                                        .JustifyCenter()
                                        .JustifyRight()
                                        .JustifyFull()
                                        .InsertUnorderedList()
                                        .InsertOrderedList()
                                        .Outdent()
                                        .Indent()
                                        .TableEditing()
                                        .CreateLink()
                                        .Unlink()
                                        .ViewHtml()
                                    )
                        )
                        @Html.ValidationMessageFor(model => model.Document, "", new { @class = "text-danger" })
                    </div>                
                </div>
            </div>
            <div class="col-md-4">
                <div class="template-keys-card">
                    <h5><i class="fa fa-key"></i> Replaceable Keys</h5>
                    <input type="text" id="keySearch" class="form-control form-control-sm" placeholder="Search keys..." />
                    <div class="key-chip-list" id="keyChipList">
                        @foreach (var key in recordKeyItems)
                        {
                            <span class="key-chip" data-key="@key" title="Click to insert -@key-">-@key-</span>
                        }
                    </div>
                    <small class="text-muted"><i class="fa fa-info-circle"></i> Click a key to insert it at the cursor position in the editor.</small>
                    <div class="key-insert-toast" id="keyInsertToast"></div>
                </div>
            </div>
        </div>

        <div class="template-actions-footer">
            @Html.ActionLink(Resources.Action_Button_Back_to_List, "Index", null, new { @class = "btn btn-light" })
            <input type="submit" value="@Resources.ActionButton_AddNewRecord" class="btn btn-primary" />
        </div>
    }
</div>

<style>
    .template-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    .template-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 100%);
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 18px 22px;
        margin-bottom: 18px;
    }

        .template-page-header h3 {
            margin: 0 0 4px 0;
            color: #1e293b;
        }

        .template-page-header p {
            margin: 0;
            color: #64748b;
            font-size: 13px;
            max-width: 640px;
        }

    .template-meta-card,
    .template-section-card,
    .template-keys-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,.04);
    }

    .template-editor-row {
        margin-left: 0;
        margin-right: 0;
    }

    .template-section-card h5,
    .template-keys-card h5 {
        margin-top: 0;
        margin-bottom: 12px;
        color: #1e293b;
        font-weight: 600;
    }

    .template-watermark-badge {
        float: right;
        font-size: 11px;
        font-weight: 600;
        color: #0e7490;
        background: #ecfeff;
        border: 1px solid #a5f3fc;
        border-radius: 20px;
        padding: 3px 10px;
    }

    .key-chip-list {
        max-height: 420px;
        overflow-y: auto;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 4px 0 10px 0;
        margin-top: 10px;
    }

    .key-chip {
        cursor: pointer;
        user-select: none;
        background: #eef2ff;
        color: #3730a3;
        border: 1px solid #c7d2fe;
        border-radius: 20px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        transition: background-color .15s ease, color .15s ease, transform .15s ease;
    }

        .key-chip:hover {
            background: #4f46e5;
            color: #fff;
            border-color: #4f46e5;
            transform: translateY(-1px);
        }

        .key-chip.is-hidden {
            display: none;
        }

    .key-insert-toast {
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: #1e293b;
        color: #fff;
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 13px;
        opacity: 0;
        pointer-events: none;
        transition: opacity .25s ease;
        z-index: 2000;
    }

        .key-insert-toast.show {
            opacity: 1;
        }

    .template-actions-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 14px 0;
        border-top: 1px solid #e2e8f0;
    }

    .form-group {
        margin-bottom: 20px;
    }

    :root {
        --document-editor-height: 70vh;
    }

    /* Kendo Editor renders as <table class="k-editor"> > <td class="k-editable-area"> > iframe/textarea.k-content */
    .k-editor {
        width: 100% !important;
        height: var(--document-editor-height) !important;
        min-height: 260px;
    }

    .k-editor .k-editable-area .k-content {
        width: 100% !important;
        height: 100% !important;
        box-sizing: border-box;
    }

    /* Tablets */
    @@media (max-width: 991px) {
        :root {
            --document-editor-height: 55vh;
        }
    }

    /* Mobile phones */
    @@media (max-width: 575px) {
        :root {
            --document-editor-height: 45vh;
        }

        .template-editor-row {
            flex-direction: column-reverse;
        }

        .key-chip-list {
            max-height: 220px;
        }
    }
    /* Ensure Kendo Editor iframe body inherits Ge'ez fonts */
    .k-editor-content body {
        font-family: 'Nyala', 'Abyssinica SIL', 'Segoe UI', Arial, sans-serif !important;
        font-size: 15px;
    }
</style>

<script type="text/javascript">
    var templateWaterMarkUrl = @Html.Raw(!string.IsNullOrEmpty(ViewBag.WaterMarkUrl as string) ? "\"" + ViewBag.WaterMarkUrl + "\"" : "null");

    function applyDocumentEditorWatermark() {
        if (!templateWaterMarkUrl) return;
        var editor = $("#Document").data("kendoEditor");
        if (!editor) return;
        var doc = editor.document;
        if (!doc || !doc.body || $(doc.body).find("#docWatermark").length) return;

        $(doc.body).css("position", "relative");
        var img = doc.createElement("img");
        img.id = "docWatermark";
        img.src = templateWaterMarkUrl;
        img.style.cssText = "position:absolute; top:120px; left:50%; transform:translateX(-50%); width:260px; opacity:0.09; pointer-events:none; z-index:-1;";
        doc.body.insertBefore(img, doc.body.firstChild);
    }

    document.addEventListener("DOMContentLoaded", function () {
        applyDocumentEditorWatermark();

        function showToast(text) {
            var toast = document.getElementById("keyInsertToast");
            toast.textContent = text;
            toast.classList.add("show");
            clearTimeout(toast._hideTimer);
            toast._hideTimer = setTimeout(function () { toast.classList.remove("show"); }, 1400);
        }

        function insertKey(key) {
            var editor = $("#Document").data("kendoEditor");
            if (editor) {
                editor.exec("inserthtml", { value: "-" + key + "-" });
                editor.focus();
                showToast("Inserted -" + key + "-");
            }
        }

        document.querySelectorAll(".key-chip").forEach(function (chip) {
            chip.addEventListener("click", function () {
                insertKey(chip.getAttribute("data-key"));
            });
        });

        var search = document.getElementById("keySearch");
        search.addEventListener("input", function () {
            var term = search.value.trim().toLowerCase();
            document.querySelectorAll(".key-chip").forEach(function (chip) {
                var match = chip.getAttribute("data-key").toLowerCase().indexOf(term) !== -1;
                chip.classList.toggle("is-hidden", !match);
            });
        });
    });
    $(document).ready(function () {
        var editor = $("#Document").data("kendoEditor");
        if (editor) {
            // Build the line spacing control layout
            var lineSpacingHtml = '<span class="k-tool-group" style="padding: 2px 6px; display: inline-flex; align-items: center; gap: 5px; border-left: 1px solid #c5c5c5; margin-left: 4px;">' +
                '<span style="font-size: 11px; font-weight: 600; color: #444;">Line Height:</span>' +
                '<select id="editorLineSpacing" class="form-control input-sm" style="height: 24px; padding: 0 4px; font-size: 11px; display: inline-block; width: auto; background: #fff; border: 1px solid #ccc; border-radius: 3px;">' +
                '<option value="1.0">1.0 (Single)</option>' +
                '<option value="1.15">1.15</option>' +
                '<option value="1.5" selected>1.5 (Standard)</option>' +
                '<option value="2.0">2.0 (Double)</option>' +
                '</select></span>';

            // Append it cleanly to the Kendo Editor toolbar
            $(editor.wrapper).find(".k-editor-toolbar").append(lineSpacingHtml);

            // Bind the change event to modify line-height of the active paragraph/block
            $(document).on("change", "#editorLineSpacing", function () {
                var val = $(this).val();
                var range = editor.getSelection();
                var container = range.commonAncestorContainer;

                var $node = $(container).closest("p, div, li, h1, h2, h3");
                if ($node.length === 0) {
                    $node = $(editor.body);
                }
                $node.css("line-height", val);
                editor.trigger("change");
            });
        }
    });
</script>
