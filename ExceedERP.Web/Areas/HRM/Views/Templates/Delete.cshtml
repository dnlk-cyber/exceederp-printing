@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.Templates.Template

@{
    ViewBag.Title = Resources.ActionButton_Cancel;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="template-page">
    <div class="template-page-header template-page-header-danger">
        <div>
            <h3><i class="fa fa-exclamation-triangle"></i> @Resources.ActionButton_Cancel</h3>
            <p>@Resources.Are_you_sure_you_want_to_delete_this</p>
        </div>
        @Html.ActionLink(Resources.Action_Button_Back_to_List, "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>

    <div class="template-meta-card">
        <div class="row">
            <div class="col-md-4">
                <label class="template-detail-label">@Html.DisplayNameFor(model => model.TemplateType)</label>
                <div class="template-detail-value">@Html.DisplayFor(model => model.TemplateType)</div>
            </div>
            <div class="col-md-4">
                <label class="template-detail-label">@Html.DisplayNameFor(model => model.Title)</label>
                <div class="template-detail-value">@Html.DisplayFor(model => model.Title)</div>
            </div>
            <div class="col-md-4">
                <label class="template-detail-label">@Html.DisplayNameFor(model => model.TempOne)</label>
                <div class="template-detail-value">@Html.DisplayFor(model => model.TempOne)</div>
            </div>
        </div>
    </div>

    <div class="template-section-card">
        <h5><i class="fa fa-eye"></i> Document Preview</h5>
        <div class="template-document-preview">
            <div style="position: relative; z-index: 1;">
            @Html.Raw(HttpUtility.HtmlDecode(HttpUtility.HtmlDecode(Model.Document)))
            </div>
        </div>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="template-actions-footer">
            @Html.ActionLink(Resources.Action_Button_Back_to_List, "Index", null, new { @class = "btn btn-light" })
            <input type="submit" value="@Resources.ActionButton_Cancel" class="btn btn-danger" />
        </div>
    }
</div>

<style>
    .template-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    .template-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 100%);
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 18px 22px;
        margin-bottom: 18px;
    }

    .template-page-header-danger {
        background: linear-gradient(135deg, #fef2f2 0%, #f8fafc 100%);
        border-color: #fecaca;
    }

        .template-page-header h3 {
            margin: 0 0 4px 0;
            color: #1e293b;
        }

        .template-page-header-danger h3 {
            color: #991b1b;
        }

        .template-page-header p {
            margin: 0;
            color: #64748b;
            font-size: 13px;
            max-width: 640px;
        }

    .template-meta-card,
    .template-section-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,.04);
    }

    .template-section-card h5 {
        margin-top: 0;
        margin-bottom: 12px;
        color: #1e293b;
        font-weight: 600;
    }

    .template-detail-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #94a3b8;
        margin-bottom: 4px;
    }

    .template-detail-value {
        font-size: 14px;
        color: #1e293b;
        font-weight: 600;
        word-wrap: break-word;
    }

    .template-document-preview {
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        padding: 16px;
        background: #f8fafc;
        white-space: pre-wrap;
        position: relative;
        overflow: hidden;
    }

        .template-document-preview::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 260px;
            height: 260px;
            background-image: url('@ViewBag.WaterMarkUrl');
            background-repeat: no-repeat;
            background-position: center;
            background-size: contain;
            opacity: 0.09;
            pointer-events: none;
        }

    .template-actions-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 14px 0;
        border-top: 1px solid #e2e8f0;
    }
</style>
