@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.Templates.Template

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@Resources.ActionButton_Cancel</h2>

<h3>@Resources.Are_you_sure_you_want_to_delete_this</h3>
<div>
    <h4>@Resources.Templates</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.TempOne)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TempOne)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.TemplateType)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TemplateType)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Document)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Document)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Delete" class="btn btn-default" /> |
            @Html.ActionLink(Resources.Action_Button_Back_to_List, "Index")
        </div>
    }
</div>
