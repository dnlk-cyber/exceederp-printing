@using System.Collections
@using ExceedERP.Core.Domain.HRM.LeaveManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.NavigatorLeave_LeavePayable @Resources.Settings</Legend>
@(Html.Kendo().Grid<LeavePayableSetting>()
          .Name("LeavePayableSetting_grid")
          .Columns(columns =>
          {
              columns.Bound(c => c.CurrentValue).Width(200);
              columns.Bound(c => c.EnableTaxableAllowance)
                     .Title("Enable Taxable Allowance")
                     .ClientTemplate("<input type='checkbox' disabled='true' value='#=EnableTaxableAllowance#' " +
                                     "# if (EnableTaxableAllowance) { # checked='checked' # } # />")
                     .Width(160);
              columns.Command(command =>
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }).Width(200);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(500))
                .Groupable()
                .Sortable(sortable =>
                {
                    sortable.SortMode(GridSortMode.SingleColumn);
                })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
                  .Events(events =>
                  {
                      events.Error("error_handler(\"LeavePayableSetting_grid\")");
                      events.RequestStart("onRequestStart(\"LeavePayableSetting_grid\")");
                      events.RequestEnd("onRequestEnd(\"LeavePayableSetting_grid\")");
                  })

              .Model(model => model.Id(p => p.LeavePayableSettingId))
              .Read(read => read.Action("LeavePayableSetting_Read", "LeavePayableSetting").Data("sendForgery"))
              .Create(create => create.Action("LeavePayableSetting_Create", "LeavePayableSetting").Data("sendForgery"))
              .Update(update => update.Action("LeavePayableSetting_Update", "LeavePayableSetting").Data("sendForgery"))
              .Destroy(destroy => destroy.Action("LeavePayableSetting_Destroy", "LeavePayableSetting").Data("sendForgery"))
          )
)
