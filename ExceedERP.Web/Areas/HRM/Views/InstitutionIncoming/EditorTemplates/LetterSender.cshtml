@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.LetterSender   


<form>

<div class="row">
    <div class="col-md-1">

    </div>
   
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.Date, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>
                @Html.Kendo().DatePickerFor(model => model.Date)
                @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.Receiver, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.Receiver)
                   .ValuePrimitive(true)
                  .OptionLabel(Resources.Select)
                                          .DataTextField("UserName")
                                                  .DataValueField("UserName")
                                                 .BindTo((IEnumerable)ViewData["Users"])

                )
            </div>
        </div>
    </div>
</div>

<br/>



    <div class="row">
        <div class="col-md-1">

        </div>
      
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.Description)
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div class="editor-label">
                @Html.LabelFor(model => model.File)
            </div>
            <div class="editor-field">
                @Html.TextBoxFor(model => model.File, new { type = "file" })
                @Html.ValidationMessageFor(model => model.File)
            </div>
        </div>
      


    </div>
    </div>
    <br />

   
</form>
