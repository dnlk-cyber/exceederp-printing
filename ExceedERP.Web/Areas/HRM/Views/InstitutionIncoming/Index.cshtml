</script>

<script>
    var statusId = "";
    var popup;
    var bookNo = "";
    var enableDisable ;
    function DetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#IncommingLetterRegistration").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        bookNo = masterDataItem.BookNo;
        enableDisable = masterDataItem.EnableDisbale;
    }
    function Answer(e) {
        try {
            statusId = e;
           
        
            

           
            var wnd = $("#Answerw").data("kendoWindow");
            wnd.center().open();
           
        } catch (ex) {
            alert("Please select the row!!");
        }

    }
    function Answerm() {
        try {

           
            var url = "";
            $.ajax({
                url: '@Url.Action("UploadDocument", "InstitutionIncoming")',
                //contentType: "application/json; charset=utf-8",
                data: function () {
                    var data = new FormData();
                    
                    data.append("file", $("#file").get(0).files[0]);
                    data.append("url", url);
                    data.append("txtValue", $("#txtValue").val());
                    data.append("txtDecsion", $("#txtDecsion").val());
                    data.append("id", bookNo);
                    return data;
                }(),
                type: 'POST',
                contentType: false,
                processData: false,
                cache: false,
                success: function (result) {
                    var wnd = $("#Answerw").data("kendoWindow");
                    wnd.close();
                    $("#IncommingLetterRegistration").data("kendoGrid").dataSource.read();
                    $("#IncommingLetterRegistration").data("kendoGrid").refresh();
                }


            });
        } catch (e) {
            // alert("Please select the row!!");
        }

    }

   

   

    function Transfer(e) {
        try {
        
           
            var wnd = $("#Transferw").data("kendoWindow");
            wnd.center().open();

           

        } catch (ex) {
            alert("Please select the row!!");
        }
    }

    function TransferClick(e) {
        try {
          

           
            var recivers = $("#Dept").data("kendoComboBox");
            var reciver = recivers.value();
              var desc = $("#txtDescription").val();
            $.ajax({
                url: '@Url.Action("SetTransfer", "InstitutionIncoming")',
                //contentType: "application/json; charset=utf-8",
                data: { id: bookNo, reciver: reciver, desc: desc },
                type: 'POST',
                cache: false,
                success: function(result) {
                    var wnd = $("#Transferw").data("kendoWindow");
                    wnd.close();
                    $("#IncommingLetterRegistration").data("kendoGrid").dataSource.read();
                    $("#IncommingLetterRegistration").data("kendoGrid").refresh();
                }


            });

        } catch (ex) {
            alert("Please select the row!!");
        }

    }
</script>



<script>
    function customAction(e) {
        var row = $(e.target).closest("tr");


        var grid = $("#IncommingLetterRegistration").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        try {

            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("UpdateStatus", "InstitutionIncoming")',
                data: { 'BookNo': dataItem.BookNo },
                type: 'GET',
                cache: false,
                success: function(result) {
                    r = result;
                    $("#IncommingLetterRegistration").data("kendoGrid").dataSource.read();
                    $("#IncommingLetterRegistration").data("kendoGrid").refresh();
                }

            });
        } catch (ee) {
            alert("Please select the row first!!");
        }
    }


    function onDataBound(e) {
        var grid = this;
        //var answer = $("#btnAnswer");
        //var transfer = $("#btnTransfer");
        //var customAction = $("#customAction");
        //var enable=@Resources.ActionButton_Enable;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check
            if (dataItem.EnableDisbale === false) {
                //hide buttons using jQuery
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-customAction").text('ይከፈት');
            } else {

                row.find(".k-grid-edit").show();
                row.find(".k-grid-customAction").text('ይዘጋ');
            }


            if (dataItem.Status === 0) {
                //answer.hide(true);
                //transfer.hide(true);
                row.css("background-color", "green");

            } else {
                //answer.show(true);
                //transfer.show(true);
                row.css("background-color", "grey");

            }


        }
    }

    function DetailDatabound(e) {
        var grid = this;

       

        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);

            var dataItem = grid.dataItem(row);
            //perform your custom check
            //if (dataItem.EnableDisbale === false) {
            //    //hide buttons using jQuery
            //    row.find(".k-grid-edit").hide();
            //    row.find(".k-grid-customAction").text('Enable');
            //} else {

            //    row.find(".k-grid-edit").show();
            //    row.find(".k-grid-customAction").text('Disable');
            //}
            if (enableDisable === true) {
                if (dataItem.CurrentStatus === 0) {
                    //answer.hide(true);
                    //transfer.hide(true);
                    row.css("background-color", "green");
                    row.find(".k-grid-delete").show();
                    row.find(".k-grid-Answer").show();
                    row.find(".k-grid-Transfer").show();

                } else if (dataItem.CurrentStatus === 1) {
                    //answer.show(true);
                    //transfer.show(true);
                    row.css("background-color", "grey");
                    row.find(".k-grid-delete").hide();
                    row.find(".k-grid-Answer").hide();
                    row.find(".k-grid-Transfer").show();

                } else if (dataItem.CurrentStatus === 2) {
                    //answer.show(true);
                    //transfer.show(true);
                    row.css("background-color", "grey");
                    row.find(".k-grid-delete").hide();
                    row.find(".k-grid-Answer").hide();
                    row.find(".k-grid-Transfer").hide();

                } else {
                    row.find(".k-grid-delete").show();
                    row.find(".k-grid-Answer").show();
                    row.find(".k-grid-Transfer").show();
                }
            }
            else {
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-Answer").hide();
                row.find(".k-grid-Transfer").hide();
            }
           } 
        
   

    }
</script>
