            background-color: #f9fafb;
        }

        #Measurementgrid.k-grid .k-grid-header th.k-header {
            font-weight: 600;
            color: #1f2937;
        }

        #Measurementgrid.k-grid .k-grid-content tr:nth-child(even) {
            background-color: #fafbfc;
        }

        #Measurementgrid.k-grid .k-grid-content tr:hover {
            background-color: #eef4fb;
        }

    @@media (max-width: 767px) {
