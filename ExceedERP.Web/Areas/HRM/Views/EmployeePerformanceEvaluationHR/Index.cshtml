@using System.Collections
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="epe-page-header">
    <i class="fa fa-bar-chart"></i>
    <legend>@Resources.NavigatorPerformance_EmployeePerformance</legend>
</div>

<div class="epe-toolbar">
    <div class="epe-toolbar-title"><i class="fa fa-filter"></i> Filter Criteria</div>
    <div class="row">

        <div class="col-md-2 col-sm-6 col-xs-12">

            <label class="category-label" @*for="Period"*@>Year</label>

            @(Html.Kendo().DropDownListFor(m => m)
                        .Name("GlFiscalYearId")
                        //.Placeholder("Period")
                        .OptionLabel(Resources.Select)
                        .Filter("contains")
                        .DataTextField("Name")
                        .DataValueField("GlFiscalYearId")
                        .DataSource(dataSource =>
                        {
                            dataSource.Read(read => read.Action("GetFiscalYearForPerformance", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery"))
                                .ServerFiltering(false);
                        })
                        .HtmlAttributes(new { style = "width: 100%;" })

            )

        </div>

        <div class="col-md-2 col-sm-6 col-xs-12">

            <label class="category-label" for="Period">@Resources.HR_PerformanceManagment_EmployeeMeasurementDefinition_PeriodId</label>

            @(Html.Kendo().DropDownListFor(m => m)
                  .Name("Period")
                  //.Placeholder("Period")
                  .OptionLabel(Resources.Select)
                  .Filter("contains")
                  .CascadeFrom("GlFiscalYearId")
                  .DataTextField("Name")
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetPeriodOrQuarterList", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery").Data("filterPeriod"))
                      .ServerFiltering(true);

                  })
                  .DataValueField("QuarterId")
                  .AutoBind(false)
                  .Events(e => e.Change("Period"))
                  .HtmlAttributes(new { style = "width: 100%;" })

            )

        </div>

        <div class="col-md-2 col-sm-6 col-xs-12">

            <label class="category-label" for="EmployeeId">@Resources.HR_PerformanceManagment_EmployeeMeasurementDefinition_PersonEmployee</label>
            @(Html.Kendo().DropDownListFor(m => m)
                        .Name("EmployeeId")
                        .OptionLabel(Resources.Select)
                        .Filter("contains")
                        .DataTextField("FullNameaEnglish")
                        .DataValueField("EmployeeId")
                        .Events(e => e.Change("EmployeeId"))
                        .DataSource(dataSource =>
                        {
                            dataSource.Read(read => read.Action("GetAllEmployeesForPerformance", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery").Data("filterEmployeeBranch"))
                            .ServerFiltering(true);

                        })
                        .HtmlAttributes(new { style = "width: 100%;" })
            )

        </div>
        <div class="col-md-2 col-sm-6 col-xs-12">
            <label class="category-label" for="Role">Evaluation-Level</label>

            @(Html.Kendo().DropDownListFor(m => m)
                        .Name("Evaluation")
                        .OptionLabel(Resources.Select)
                        //.Placeholder("Evaluation Level")
                        .DataTextField("Text")
                        .BindTo(EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.HRM.PerformanceManagment.EvaluationTypeLevel)))
                        .DataValueField("Value")
                        .Filter("contains")
                        //.Events(x => x.Change("onCriteriaChange"))
                        .AutoBind(false)
                        //.Events(e => e.Change("Roles"))
                        .HtmlAttributes(new { style = "width: 100%;" })

            )
        </div>
        <div class="col-md-2 col-sm-6 col-xs-12">
            <label class="category-label" for="CriteriaCategoryId">@Resources.Rpt_Criteria @Resources.Common_Lookup_Category</label>
            @(Html.Kendo().DropDownListFor(m => m)
                                .Name("CriteriaCategoryId")
                                .OptionLabel(Resources.Select)
                                // .Placeholder("Type")
                                //.CascadeFrom("Evaluation")
                                .DataTextField("Name")
                                //.BindTo((IEnumerable)ViewData["EvaluationTypes"])
                                .DataValueField("CriteriaCategoryId")
                                .Filter("contains")
                               // .AutoBind(false)
                                .DataSource(dataSource =>
                                {
                                    dataSource.Read(read => read.Action("GetCriteriaCategory", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery")/*.Data("filterEvaluationCriteria")*/)
                                    .ServerFiltering(false);
                                })
                                .HtmlAttributes(new { style = "width: 100%;" })
            )
        </div>

        <div class="col-md-2 col-sm-6 col-xs-12">
            <label class="category-label" for="EvaluationCriteriaId">@Resources.HR_PerformanceManagment_EmployeePerformance_EvaluationType</label>
            @(Html.Kendo().DropDownListFor(m => m)
                                .Name("EvaluationCriteriaId")
                                .OptionLabel(Resources.Select)
                                // .Placeholder("Type")
                                .CascadeFrom("Evaluation")
                                .CascadeFrom("CriteriaCategoryId")
                                .DataTextField("Name")
                                //.BindTo((IEnumerable)ViewData["EvaluationTypes"])
                                .DataValueField("MeasurementDefinitionId")
                                .Filter("contains")
                                // .AutoBind(false)
                                .DataSource(dataSource =>
                                {
                                    dataSource.Read(read => read.Action("GetCorporateOrSectorEvaluationCriterias", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery").Data("filterEvaluationCriteria"))
                                    .ServerFiltering(true);
                                })
                                .HtmlAttributes(new { style = "width: 100%;" })
            )
        </div>

        <div class="col-md-2 col-sm-6 col-xs-12">

            <label class="category-label">&nbsp;</label>

            @(Html.Kendo().Button()
                        .Name("btnRefresh")
                        .HtmlAttributes(new { type = "button", @class = "k-primary epe-btn" })
                        .Events(e => e.Click("Process"))
                        .Content(Resources.Show))

        </div>
    </div>
</div>

