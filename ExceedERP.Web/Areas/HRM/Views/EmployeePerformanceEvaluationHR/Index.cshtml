        <div class="col-md-10">

            <div class="epe-grid-wrapper">
            @(Html.Kendo().Grid<EmployeeMeasurement>()
                  .Name("Measurementgrid")
                  .Columns(columns =>
                  {
                      columns.ForeignKey(c => c.MeasurmentId, (IEnumerable)ViewData["Measurments"], "MeasurementId", "MeasurementName").Width(200);
                      columns.Bound(c => c.Weight).Width(80);
                      columns.Bound(c => c.Result).Width(80);
