@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.TrainingEducation.CourseTracking

<div class="form">
<div class="row fullrow">
    <div class="col-md-3 ro1">
        <div class="form-group">
       
            @Html.LabelFor(model => model.GlFiscalYearId, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-6">
                @(Html.Kendo().DropDownListFor(model => model.GlFiscalYearId)
                      
                      .OptionLabel(Resources.Select)
                      .Filter("contains")
                      .DataTextField("Name")
                      .DataValueField("GlFiscalYearId")
                      .ValuePrimitive(true)
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetFisicalYear", "HRMDataProvider", new { area = "HRM" }))
                              .ServerFiltering(false);
                      })
                      )
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.LookupId, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-6">
          
                @(Html.Kendo().DropDownListFor(model => model.LookupId)
                      .ValuePrimitive(true)
                      .OptionLabel(Resources.Select)
                      .Filter("contains")
                      .DataTextField("Description")
                      .DataValueField("LookupId")
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetCourseList", "HRMDataProvider"))
                              .ServerFiltering(false);
                      }))
                @Html.ValidationMessageFor(model => model.LookupId)
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.MainCompanyId, htmlAttributes: new { @class = "control-label col-md-8" })

            <div class="col-md-6">
                @(Html.Kendo().DropDownListFor(model => model.MainCompanyId)
                      .ValuePrimitive(true)
                      .Filter("contains")
                      .OptionLabel(Resources.Select)
                      .DataTextField("TradeName")
                      .DataValueField("MainCompanyId")
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetTrainingProvider", "HRMDataProvider"))
                              .ServerFiltering(false);
                      }))
                @Html.ValidationMessageFor(model => model.MainCompanyId, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.TrainingPlanId, htmlAttributes: new { @class = "control-label col-md-8" })

            <div class="col-md-6">

                @(Html.Kendo().DropDownListFor(model => model.TrainingPlanId)
                      .ValuePrimitive(true)
                      .Filter("contains")
                      .OptionLabel(Resources.Select)

                      .DataTextField("Name")
                      .DataValueField("TrainingPlanId")
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetTrainingPlan", "HRMDataProvider", new { area = "HRM" }))
                              .ServerFiltering(false);
                      })
                      )
            </div>
        </div>

     
    </div>
    <div class="col-md-3 ro1">
      
        <div class="form-group">

            @Html.LabelFor(model => model.TrainingLocation, htmlAttributes: new { @class = "control-label col-md-8" })

            <div class="col-md-6">

                @(Html.EnumDropDownListFor(model => model.TrainingLocation, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 140px" })
                    
                      )

            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.TrainingType, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-6">
                @(Html.EnumDropDownListFor(model => model.TrainingType, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 140px" })
                    
                      )

            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.TrainingTerm, htmlAttributes: new { @class = "control-label col-md-8" })

            <div class="col-md-6">

                @(Html.EnumDropDownListFor(model => model.TrainingTerm, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 140px" })

                      )

            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.Cost, htmlAttributes: new { @class = "control-label col-md-8" })

            <div class="col-md-6">
                @Html.Kendo().TextBoxFor(model => model.Cost)
                @Html.ValidationMessageFor(model => model.Cost, "", new { @class = "text-danger" })

            </div>
        </div>
        
    </div>
    <div class="col-md-4 ro1">

        <div class="form-group">
            @Html.LabelFor(model => model.FromAmharic, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.FromAmharic, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />

                @Html.ValidationMessageFor(model => model.FromAmharic, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">

            @Html.LabelFor(model => model.ToAmharic, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.ToAmharic, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />

                @Html.ValidationMessageFor(model => model.ToAmharic, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.NoOfTrainee, htmlAttributes: new { @class = "control-label col-md-8" })

            <div class="col-md-6">
                @Html.Kendo().TextBoxFor(model => model.NoOfTrainee)
                @Html.ValidationMessageFor(model => model.NoOfTrainee, "", new { @class = "text-danger" })

            </div>
        </div>

        <div class="row"></div><br />

        <div class="form-group">

            <div class="col-md-6">
                @Html.Kendo().CheckBoxFor(model => model.IsOnJob)
                @Html.ValidationMessageFor(model => model.IsOnJob, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

   </div></div>