<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#FromAmharic").trigger("change");
        $("#ToAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "CourseTracking")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }

</script>
<script>
    function Branch() {


        var value = this.value(),
            grid = $("#CourseTrackingGrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "OrgBranchName", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>