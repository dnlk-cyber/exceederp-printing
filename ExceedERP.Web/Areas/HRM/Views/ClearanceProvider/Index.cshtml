@using System.Collections
@using ExceedERP.Core.Domain.HRM.Company
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.Navigator_Company_ClearanceProvider</legend>
@(Html.Kendo().Grid<ClearanceProvider>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").EditorTemplateName("Organization").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["clearanceType"], "LookupId", "Description").EditorTemplateName("ClearanceType").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
          columns.Bound(c => c.Name).EditorTemplateName("DepartmentAutoComplate").Width(170);
          columns.Bound(c => c.Remark).Width(100);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Company_User"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Company_Admin"))
              {
                  command.Custom("cmd-approve").Click("hrApproval").Text("Approve").IconClass("fa fa-check fa4x").HtmlAttributes(new { @class = "btn btn-success", @title = "Approve  ", @id = "approve" });

                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          }).Width(250);
      })
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("HR_Company_User"))
          {
               toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);

      })
      .Events(ev =>
      {
          ev.DataBound("onDataBound");
          ev.DetailExpand("onDetailExpandUser");
      })
      .Scrollable(h => h.Height(500))
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);

      })
      .Filterable()
      .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))
     .DataSource(dataSource => dataSource
          .Ajax()
          .Events(events =>
          {
              events.Error("error_handler(\"grid\")");
              events.RequestStart("onRequestStart(\"grid\")");
              events.RequestEnd("onRequestEnd(\"grid\")");
          })
          .Model(model => model.Id(p => p.ClearanceProviderId))
          .Read(read => read.Action("ClearanceProvideres_Read", "ClearanceProvider"))
          .Create(create => create.Action("ClearanceProvideres_Create", "ClearanceProvider"))
          .Update(update => update.Action("ClearanceProvideres_Update", "ClearanceProvider"))
          .Destroy(destroy => destroy.Action("ClearanceProvideres_Destroy", "ClearanceProvider"))
      ).ClientDetailTemplateId("detailtemplate")

)

<script id="detailtemplate" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=ClearanceProviderId#")
          .SelectedIndex(0)
          .Items(items =>
          {
                items.Add().Text("Clearance Provider Detail").Content(
                @<text>
                    @(Html.Kendo().Grid<ClearanceProviderDetail>()
                        .Name("ClearanceProviderDetailgrid_#=ClearanceProviderId#")
                        .Columns(columns =>
                        {
                            columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").EditorTemplateName("Organization").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                            columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["JobTitle"], "LookupId", "Description").EditorTemplateName("jobTitle").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                            columns.ForeignKey(c => c.HeadId, (IEnumerable)ViewData["EmployeeList"], "HeadId", "FullNameaEnglish").EditorTemplateName("ActiveEmployeeForClearances").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);

                            columns.Command(command =>
                            {

                                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);

                                command.Destroy().Text(Resources.ActionButton_Cancel);

                            }).Width(200);

                        })
                        .ToolBar(toolbar =>
                        {
                            if (HttpContext.Current.User.IsInRole("HR_Discipline_User"))
                            {
                                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                            }
                        })
                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .Selectable(selectable =>
                        {
                            selectable.Mode(GridSelectionMode.Single);
                            selectable.Type(GridSelectionType.Row);
                        })


                            .Scrollable(h => h.Height(350))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            //.Events(events =>
                            //{
                            //    events.Error("error_handler(\"ClearanceProviderDetailgrid_#=ClearanceProviderId#\")");
                            //    events.RequestStart("onRequestStart(\"ClearanceProviderDetailgrid_#=ClearanceProviderId#\")");
                            //    events.RequestEnd("onRequestEnd(\"ClearanceProviderDetailgrid_#=ClearanceProviderId#\")");
                            //})

                            .Model(model => model.Id(p => p.ClearanceProviderId))
                            .Read(read => read.Action("ClearanceProviderDetails_Read", "ClearanceProviderDetails", new { cPId = "#=ClearanceProviderId#" }))
                            .Create(create => create.Action("ClearanceProviderDetails_Create", "ClearanceProviderDetails", new { cPId = "#=ClearanceProviderId#" }))
                            .Update(update => update.Action("ClearanceProviderDetails_Update", "ClearanceProviderDetails"))
                            .Destroy(destroy => destroy.Action("ClearanceProviderDetails_Destroy", "ClearanceProviderDetails"))
                        ).ToClientTemplate()
                        )

                </text>);


          }).ToClientTemplate())

</script>

