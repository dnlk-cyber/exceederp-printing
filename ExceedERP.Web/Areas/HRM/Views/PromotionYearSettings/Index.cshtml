@using System.Collections
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Localization
@{
               
                Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>Promotion Setting</Legend>
@(Html.Kendo().Grid<PromotionYearSetting>()
          .Name("promotiongrid")
          .Columns(columns =>
          {
              columns.Bound(c => c.PromotionYearSettingId).Title("#").Width(80);
              columns.Bound(c => c.NumberOfPromotionYears).Width(150);
              columns.Bound(c => c.StepAmountsToPromote).Width(150);

              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
                  .Events(events =>
                  {
                      events.Error("error_handler(\"promotiongrid\")");
                      events.RequestStart("onRequestStart(\"promotiongrid\")");
                      events.RequestEnd("onRequestEnd(\"promotiongrid\")");
                  })

              .Model(model => {
                  model.Id(p => p.PromotionYearSettingId);
                  model.Field(p => p.PromotionYearSettingId).Editable(false);
              })
              .Read(read => read.Action("PromotionYearSettings_Read", "PromotionYearSettings"))
              .Create(create => create.Action("PromotionYearSettings_Create", "PromotionYearSettings"))
              .Update(update => update.Action("PromotionYearSettings_Update", "PromotionYearSettings"))
              .Destroy(destroy => destroy.Action("PromotionYearSettings_Destroy", "PromotionYearSettings"))
          )
)
