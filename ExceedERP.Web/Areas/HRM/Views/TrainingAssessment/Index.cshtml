<script>
       function RejectRequest(e) {
           
           var row = $(e.target).closest("tr");
           var grid = $("#TrainingAssessmentgrid").data("kendoGrid");
           var dataItem = grid.dataItem(row);
           var id = dataItem.AssesmentId;
           
            $.ajax({
               // contentType: "application/json; charset=utf-8",
                url: '@Url.Action("RejectRequest", "TrainingAssessment")',
                data: { id: id},
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);

                    grid.dataSource.read();
                }

            });       
    }
</script>
