              columns.ForeignKey(c => c.RequiredTraining, (IEnumerable)ViewData["TargetGroup"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150).Width(120);

              columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["CourseList"], "LookupId", "Description").EditorTemplateName("Course").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150).Width(120);
              columns.ForeignKey(c => c.Type, (IEnumerable)ViewData["TraTypeList"], "LookupId", "Description").EditorTemplateName("TrainingType").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150).Width(120);
              // columns.Bound(c => c.Remark).Width(250);

              columns.Command(command =>
              {
                  command.Custom("reject").Text("Reject").Click("RejectRequest").HtmlAttributes(new { @class = "fa fa-male btn btn-danger" });
                  //command.Edit();
                  //command.Destroy();
              }).Width(180);
          })
          .ToolBar(toolbar =>
          {

          toolbar.Template(@<text>
         
            @if (HttpContext.Current.User.IsInRole("HR_Training_User"))
            {
                @item.SaveButton()
            }
        </text>);
          })
          // .Events(ev => ev.DataBound("onDataBound"))
          // .Events(ev => ev.DataBound("MasteronDataBound"))

          .Editable(editable => editable.Mode(GridEditMode.InCell))
                   .Selectable(selectable =>
                   {
                       selectable.Mode(GridSelectionMode.Single);
                       selectable.Type(GridSelectionType.Row);
                   })
                               .Scrollable(h => h.Height(400))
                                  .Groupable()
               //.Sortable(sortable =>
               //{
               //    sortable.SortMode(GridSortMode.SingleColumn);
               //})
               .Filterable()

               .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                              .Refresh(true)
                             .PageSizes(true)
                               .ButtonCount(5))
                                .DataSource(dataSource => dataSource
                                    .Ajax()


                                        .Batch(true)
                                              .Events(events =>
                                              {
                                                  events.Error("error_handler(\"TrainingAssessmentgrid\")");
                                                  events.RequestStart("onRequestStart(\"TrainingAssessmentgrid\")");
                                                  events.RequestEnd("onRequestEnd(\"TrainingAssessmentgrid\")");
                                              })

                                    .Model(model =>
                                    {
                                        model.Id(p => p.TrainingAssessmentViewModelId);

                                        model.Field(p => p.OrgStructureId).Editable(false);
                                        model.Field(p => p.RequiredTraining).Editable(false);
                                        // model.Field(p => p.NoOfStaff).Editable(false);
                                        model.Field(p => p.LookupId).Editable(false);
                                        model.Field(p => p.GlFiscalYearId).Editable(false);
                                        model.Field(p => p.Type).Editable(false);

                                    })
              .Read(read => read.Action("TrainingAssessments_Read", "TrainingAssessment"))
                 .Create(create => create.Action("Transfer_Create", "TrainingAssessment"))
                .Update(update => update.Action("Transfer_Create", "TrainingAssessment"))

                          )

)
