@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPayroll_OverTimeTransfer </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.Payroll.OverTimeTransfer>()
          .Name("OverTimeTransfergrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Check).ClientTemplate("<input type='checkbox' #= Check ? checked='checked':'' # class='chkbx' />")
                    .HeaderTemplate("<input type='checkbox' id='masterCheckBox' onclick='checkAll(this)'/>").Width(200);
          //columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["Employees"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width (200);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["Employees"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("EmployeeLists").Width(260);

          columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["PeriodList"], "GLPeriodId", "Name").EditorTemplateName("GLPeriodSelector").Width(150);
          columns.Bound(c => c.NormalHours).Width(150);
          columns.Bound(c => c.NightHours).Width(150);
          columns.Bound(c => c.HolidayHours).Width(150);
          columns.Bound(c => c.RestdayHours).Width(150);
          //  columns.Command(command => { command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
          // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          toolbar.Save().SaveText("Transfer");
      })
         .Editable(editable => editable.Mode(GridEditMode.InCell))
            .Scrollable(h => h.Height(500))
                                                 .Groupable()
                                                 //.Sortable(sortable =>
                                                 //{
                                                 //    sortable.SortMode(GridSortMode.SingleColumn);
                                                 //})
                                                 // .Filterable()
                                                 .Pageable(pageable => pageable
                                                                            .Input(true)
                                                                            .Numeric(false)
                                                                            .Refresh(true)
                                                                            .PageSizes(true)
                                                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("OverTimeTransferId").Descending())
               .Batch(true)
                       .Events(events =>
                       {
                           events.Error("error_handler(\"OverTimeTransfergrid\")");
                           events.RequestStart("onRequestStart(\"OverTimeTransfergrid\")");
                           events.RequestEnd("onRequestEnd(\"OverTimeTransfergrid\")");
                       })

          .Model(model => model.Id(p => p.OverTimeTransferId))
              .Read(read => read.Action("OverTimeTransfers_Read", "OverTimeTransfer"))
                      .Create(create => create.Action("Editing_Create", "OverTimeTransfer"))
                      .Update(update => update.Action("Editing_Create", "OverTimeTransfer"))
              .Destroy(destroy => destroy.Action("OverTimeTransfers_Destroy", "OverTimeTransfer"))
          )//.ClientDetailTemplateId("template")
      )

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                          .Name("tabstrip_#=OverTimeTransferId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text(Resources.Details).Content(
                @<text>


                  @(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.Payroll.OverTime>()
                  .Name("OverTimegrid_#=OverTimeTransferId#")
      .Columns(columns =>
      {
         // columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(200);
          //columns.ForeignKey(c => c.PeriodId, (IEnumerable)ViewData["PeriodList"], "PeriodId", "PeriodName").EditorTemplateName("Period").Width(120);
          columns.Bound(c => c.NormalHours).Width(100);
          columns.Bound(c => c.NightHours).Width(100);
          columns.Bound(c => c.HolidayHours).Width(100);
          columns.Bound(c => c.RestdayHours).Width(100);
          //columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Scrollable(h => h.Height(500))
            
      .DataSource(dataSource => dataSource
          .Ajax()
                      .Events(events =>
                                                                                                            {
                                                                                                                events.Error("error_handler(\"OverTimegrid_#=OverTimeTransferId#\")");
                                                                                                                events.RequestStart("onRequestStart(\"OverTimegrid_#=OverTimeTransferId#\")");
                                                                                                                events.RequestEnd("onRequestEnd(\"OverTimegrid_#=OverTimeTransferId#\")");
                                                                                                            }) 
               
          .Model(model => model.Id(p => p.OverTimeId))
                                                  .Read(read => read.Action("OverTimes_Read", "OverTimeTrasferDetail", new { id = "#=EmployeeId#", period = "#=GLPeriodId#", tId = "#=OverTimeTransferId#" }))
                                  .Create(create => create.Action("OverTimes_Create", "OverTimeTrasferDetail", new { idTwo = "#=EmployeeId#", periodTwo = "#=GLPeriodId#", tIdTwo = "#=OverTimeTransferId#" }))
                  .Update(update => update.Action("OverTimes_Update", "OverTimeTrasferDetail"))
                  .Destroy(destroy => destroy.Action("OverTimes_Destroy", "OverTimeTrasferDetail"))
      ).ToClientTemplate()
                )



                </text>
                  );
           


          }).ToClientTemplate())
</script>

<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
    $(function () {
        $('#OverTimeTransfergrid').on('click', '.chkbx', function () {
            var checked = $(this).is(':checked');
            var grid = $('#OverTimeTransfergrid').data().kendoGrid;
            var dataItem = grid.dataItem($(this).closest('tr'));
            dataItem.set('Check', checked);
        })
    })
    function checkAll(ele) {
        var state = $(ele).is(':checked');
        var grid = $('#OverTimeTransfergrid').data().kendoGrid;
        $.each(grid.dataSource.view(), function () {
            if (this['Check'] != state)
                this.dirty = true;
            this['Check'] = state;
        });
        grid.refresh();
    }
    function checkAll(ele) {
        var state = $(ele).is(':checked');
        var grid = $('#OverTimeTransfergrid').data().kendoGrid;
        $.each(grid.dataSource.view(), function () {
            if (this['Check'] != state)
                this.dirty = true;
            this['Check'] = state;
        });
        grid.refresh();
    }
</script>

