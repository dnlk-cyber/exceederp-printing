@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.Payroll .Advance 


<form>

<div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.EmployeeId, htmlAttributes: new {@class = "control-label col-md-8"})

            </div>
            <div>

                @(Html.Kendo().DropDownListFor(model => model.EmployeeId)
                        //  .Name("EmployeeId")
                                              .DataValueField("PersonId")
                        .DataTextField("FullName")
                           .OptionLabel("Select Employee..")
                            .Filter("contains")
                            .MinLength(2)

                            .HtmlAttributes(new { style = "width:260px" })
                            .Virtual(v => v.ValueMapper("valueMapper").ItemHeight(26))
                        .DataSource(source =>
                        {
                            source.Custom()
                                  .ServerFiltering(true)
                                  .ServerPaging(true)
                                  .Type("aspnetmvc-ajax")
                                  .Transport(transport => transport.Read(r => r.Action("GetEmployees", "Loan")))
                                  .Schema(schema =>
                                  {
                                      schema.Data("Data")
                                            .Total("Total");
                                  });
                        })

                                           .ValuePrimitive(true)


                                                                  .Height(400)
                                                                          .HeaderTemplate("<div class=\"dropdown-header k-widget k-header\">" +
                                                        "<span>Photo</span>" +
                                                        "<span>Full Name</span>" +
                                                    "</div>")
                                                            .Template(@"<div class='Employee-photo' style='background-image: url(" + Url.Content("~/Content/Images/") + "#:data.PersonId#-Photo/" + "#:data.PersonId#.jpg" + ");'></div>" +
                                                            "<div class='Employee-name'>#:FullName#</div>")
                )



            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.GLPeriodId, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>

                @(Html.Kendo().DropDownListFor(model => model.GLPeriodId)
                  .AutoBind(false)
                  .OptionLabel(Resources.Select)
                          .DataTextField("Name")
                                  .DataValueField("GLPeriodId")
                                   .ValuePrimitive(true)
                                        .DataSource(dataSource =>
                                          {
                                              dataSource.Read(read => read.Action("GetPeriod", "HRMDataProvider", new { area = "HRM" }))
                                                                    .ServerFiltering(false);
                                          }))
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.AdvanceAmount, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">
            @Html.Kendo().TextBoxFor(model => model.AdvanceAmount)
            @Html.ValidationMessageFor(model => model.AdvanceAmount, "", new { @class = "text-danger" })
        </div>
    </div>
   

</div>

<br/>


<div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.Months, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>
                @Html.Kendo().TextBoxFor(model => model.Months)
                @Html.ValidationMessageFor(model => model.Months, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">

            @Html.TextAreaFor(model => model.Description)
            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <div>
           @Html.LabelFor(model => model.MonthlyAmount, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">

            @(Html.Kendo().TextBoxFor(model => model.MonthlyAmount)
        .Enable(false))
            @Html.ValidationMessageFor(model => model.MonthlyAmount, "", new { @class = "text-danger" })
        </div>
    </div>
  
  


</div>
<br/>

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Balance, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.Balance)
        .Enable(false))
                    @Html.ValidationMessageFor(model => model.Balance, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
     
        <div class="col-md-3">
            <div>
             @*   @Html.LabelFor(model => model.JumpHoliday, htmlAttributes: new { @class = "control-label col-md-8" })*@
            </div>
            <div class="form-group">

                @Html.Kendo().CheckBoxFor(model => model.JumpHoliday)
                @Html.ValidationMessageFor(model => model.JumpHoliday, "", new { @class = "text-danger" })
            </div>
        </div>
       
        <div class="col-md-3">
            @*<div>
                @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>*@
            <div class="form-group">

                @Html.Kendo().CheckBoxFor(model => model.IsActive)
                @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
            </div>
        </div>


    </div>
    <br />

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.TextAreaFor(model => model.Remark)
                @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
            </div>
        </div>
      
    </div>
</form>
<style >
    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>