@(Html.Kendo().Grid<FixedContribution>()
          .Name("FixedContribution")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullName").EditorTemplateName("PayrollListOfEmployee").Width(260).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(c => c.ContributionTypeId, (IEnumerable)ViewData["Contribution"], "ContributionTypeId", "Description").EditorTemplateName("ContributionType").Width(150);
          columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["PeriodList"], "GLPeriodId", "Name").EditorTemplateName("GLPeriod").Width(120);
       //   columns.Bound(c => c.AmtPercnet).EditorTemplateName("Enum").Width(150);
          columns.Bound(c => c.AmountPercent).Width(150);
         // columns.Bound(c => c.NetGross).EditorTemplateName ("Enum").Width(150);
        
        columns.Bound(c => c.Amount).Width( 100);
        columns.Bound(c => c.Months).Width( 100);
        columns.Bound(c => c.MonthlyAmount).Width(150);
        columns.Bound(c => c.Balance ).Width(120);
        //columns.Bound(c => c.ApplyToAll).ClientTemplate("<input type='checkbox'  disabled='true' value='#=ApplyToAll #' " + " # if (ApplyToAll) { #" + "checked='checked'" + "# } #" + " />").Width(180);
        columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsActive #' " + " # if (IsActive) { #" + "checked='checked'" + "# } #" + " />").Width(130);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
                              toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
      })
                   .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("FixedContribution").Window(window => { window.Title(Resources.NavigatorPayroll_FixedContribution); window.Scrollable(false); }))
      .Excel(excel => excel
          .FileName(Resources.NavigatorPayroll_FixedContribution + ".xlsx")
          .Filterable(true)
          .AllPages(true)
          .ProxyURL(Url.Action("Excel_Export_Save", "FixedContribution"))
      )
      .Pdf(pdf => pdf
          .AllPages()
          .FileName(Resources.NavigatorPayroll_FixedContribution + ".pdf")
          .ProxyURL(Url.Action("Pdf_Export_Save", "FixedContribution"))
      )
      .Selectable(selectable => {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
      })
          .Scrollable(h => h.Height(500))
              
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                  .Filterable()
                     .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
              .Events(events =>
     {

         events.Error("error_handler(\"FixedContribution\")");
         events.RequestStart("onRequestStart(\"FixedContribution\")");
         events.RequestEnd("onRequestEnd(\"FixedContribution\")");
     })
                     
          .Model(model =>
          {
              model.Id(p => p.FixedContributionId);
              model.Field(p => p.MonthlyAmount).Editable(false);
              model.Field(p => p.Balance).Editable(false);
          })
          .Read(read => read.Action("FixedContributions_Read", "FixedContribution"))
          .Create(create => create.Action("FixedContributions_Create", "FixedContribution"))
          .Update(update => update.Action("FixedContributions_Update", "FixedContribution"))
          .Destroy(destroy => destroy.Action("FixedContributions_Destroy", "FixedContribution"))
      )
)
