<script >
    function Change(e)
    {

       // var amt = $("#AmtPercnet").data("kendoDropDownList");
        var x = e.value;
        if(x=="1")
        {
            $("#AmountPercent").prop("disabled", false).addClass("k-state-disabled");
            $("#NetGross").prop("disabled", false).addClass("k-state-disabled");
        }
        else
        {
            $("#AmountPercent").prop("disabled", true).addClass("k-state-disabled");
            $("#NetGross").prop("disabled", true).addClass("k-state-disabled");
        }
    }
</script>
