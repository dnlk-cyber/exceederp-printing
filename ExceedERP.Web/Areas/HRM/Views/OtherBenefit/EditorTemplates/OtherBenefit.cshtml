@using System.Collections
@using ExceedERP.Web.Areas.HRM.Controllers
@using ExceedERP.Web.Areas.HRM.Controllers.Company
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.Allowance.OtherBenefit 
@using ExceedERP.Core.Localization
<br />
<form>

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div>@Html.LabelFor(model => model.LookupId, htmlAttributes: new {@class = "control-label col-md-8"})</div>

                @(Html.Kendo().DropDownListFor(m => m.LookupId)
                      .DataTextField("Description")
                      .DataValueField("LookupId")
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetAllowance", "HRMDataProvider", new { area = "HRM" }))
                              .ServerFiltering(false);
                      })
                      .ValuePrimitive(true)
                      )
                @Html.ValidationMessageFor(model => model.LookupId, "", new { @class = "text-danger" })
            </div>
            </div>
            <div class="col-md-3">

                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.BenefitName, htmlAttributes: new { @class = "control-label col-md-8" })
                    </div>
                    <div>

                        @(Html.Kendo().DropDownListFor(model => model.BenefitName)
                    .ValuePrimitive(true)
                    .OptionLabel(Resources.Select)
                                    .DataValueField("LookupId")
                                            .DataTextField("Description")
                              .DataSource(dataSource =>
                              {
                                  dataSource.Read(read => read.Action("GetBenefit", "HRMDataProvider", new { area = "HRM" }))
                                      .ServerFiltering(false);
                              }))
                        @Html.ValidationMessageFor(model => model.BenefitName, "", new { @class = "text-danger" })
                    </div>
                </div>

            </div>
            <div class="col-md-3">

                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.UnitofMeasurement, htmlAttributes: new { @class = "control-label col-md-8" })
                    </div>
                    <div>

                        @(Html.Kendo().DropDownListFor(model => model.UnitofMeasurement)
                    .ValuePrimitive(true)
                    .OptionLabel(Resources.Select)
                                    .DataValueField("LookupId")
                                            .DataTextField("Description")
                              .DataSource(dataSource =>
                              {
                                  dataSource.Read(read => read.Action("GetUOM", "HRMDataProvider", new { area = "HRM" }))
                                      .ServerFiltering(false);
                              }))
                        @Html.ValidationMessageFor(model => model.UnitofMeasurement, "", new { @class = "text-danger" })
                    </div>
                </div>

            </div>
        </div>



    <br />

    <div class="row">
        <div class="col-md-1">

        </div>
       



        <div class="col-md-3">

            <div class="form-group">

                <div class="k-label">
                    @Html.LabelFor(model => model.Quantity, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @Html.Kendo().TextBoxFor(model => model.Quantity)
                    @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger" })

                </div>
            </div>
        </div>



        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.TimeInterval, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>

                    @Html.Kendo().TextBoxFor(model => model.TimeInterval)
                    @Html.ValidationMessageFor(model => model.TimeInterval, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <br />

    <div class="row">
        <div class="col-md-1">

        </div>


        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>

                    @Html.TextAreaFor(model => model.Remark)
                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
</form>

<style>
    div.k-edit-form-container {
        width: 700px;
    }
</style>


