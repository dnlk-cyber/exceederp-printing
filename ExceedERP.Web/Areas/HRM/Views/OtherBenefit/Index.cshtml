`@using System.Collections
@using ExceedERP.Core.Domain.HRM.Allowance
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorBenefit_OtherBenefit</legend>
@(Html.Kendo().Grid<OtherBenefit>()
          .Name("OtherBenefitgrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["jobTitle"], "LookupId", "Description").EditorTemplateName("JobTitles").Width(120);
          columns.ForeignKey(c => c.BenefitName, (IEnumerable)ViewData["Benefits"], "LookupId", "Description").EditorTemplateName("Benefits").Width(150);
          columns.ForeignKey(c => c.UnitofMeasurement, (IEnumerable)ViewData["UOM"], "LookupId", "Description").EditorTemplateName("UnitOfMeasurement").Width(150);
        columns.Bound(c => c.Quantity).Width (100);
        columns.Bound(c => c.TimeInterval).Width (120);
        //columns.Bound(c => c.Remark);
        columns.Command(command =>
        {
            if (HttpContext.Current.User.IsInRole("HR_Benefit_User"))
            {
                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
            }
            if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Benefit_Admin"))
            {
                command.Destroy().Text(Resources.ActionButton_Cancel);
            }
        }).Width(200);
      })
      .ToolBar(toolbar => {
                              if (HttpContext.Current.User.IsInRole("HR_Benefit_User"))
                              {
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              }
      })
                       .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("OtherBenefit").Window(window => { window.Title(Resources.NavigatorBenefit_OtherBenefit); window.Scrollable(false); }))
          .Scrollable(h => h.Height(500))
             .Groupable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                 .Events(events =>
                                {
                                    events.Error("error_handler(\"OtherBenefitgrid\")");
                                    events.RequestStart("onRequestStart(\"OtherBenefitgrid\")");
                                    events.RequestEnd("onRequestEnd(\"OtherBenefitgrid\")");
                                })
                      
          .Model(model => model.Id(p => p.OtherBenefitId))
          .Read(read => read.Action("OtherBenefits_Read", "OtherBenefit"))
          .Create(create => create.Action("OtherBenefits_Create", "OtherBenefit"))
          .Update(update => update.Action("OtherBenefits_Update", "OtherBenefit"))
          .Destroy(destroy => destroy.Action("OtherBenefits_Destroy", "OtherBenefit"))
      )
)
