@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.Common.HRM.Address
<form>
  
   
   
    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Category, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.EnumDropDownListFor(model => model.Category, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 140px", onchange = "Change(this)" })                                 
                          
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Value, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.Value) 
                @Html.ValidationMessageFor(model => model.Value, "", new { @class = "text-danger" })
                
                
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div class="form-group">
                              
                 @Html.TextAreaFor(model => model.Remark) 
                 @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
            </div>
        </div>

    </div>
 

</form>
