     function AssignDate() {
            var list = AssignDates();
            return list;
        }
      function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#FromDateAm").trigger("change");
        $("#ToDateAm").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "ReferralForm")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
    function sync_handler(e) {
        this.read();

    }
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#OverTimeRequestgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.OverTimeRequestId;
        var gridName = "#RequestesStatusgrid_" + masterId;
       // var empgrid = "#OverTimeRequestEmployee" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatus", "OverTimeRequest")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                     $(gridName).find(".k-toolbar").hide(); //hide toolbar
                     $(".k-grid-top", gridName).hide();

                    //$(".k-grid-Dept", gridName).show();
                    //$(".k-grid-Send", gridName).hide();
                    //$(empgrid).find(".k-toolbar").hide(); //hide toolbar
                    //$(".k-grid-top", empgrid).hide();
                }
                else if (r == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                    $(".k-grid-Dept", gridName).hide();
                    $(empgrid).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", empgrid).hide();
                    $(".k-grid-edit", empgrid).hide();
                    $(".k-grid-delete", empgrid).hide();
                }
                else if (r == "Dapproved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();

                    $(".k-button .k-grid-Dept", gridName).hide();

                    $(empgrid).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", empgrid).hide();
                    $(".k-grid-edit", empgrid).hide();
                    $(".k-grid-delete", empgrid).hide();
                }
                else {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", gridName).show();
                    $(".k-grid-Dept", gridName).hide();
                    $(".k-grid-Send", gridName).show();
                    $(empgrid).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", empgrid).show();
                }

            }

        });

    }
</script>

