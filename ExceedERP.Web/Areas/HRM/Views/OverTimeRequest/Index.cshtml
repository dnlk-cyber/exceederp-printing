@using System.Collections
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization 
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.HR_SelfCare_OverTimeRequest_OverTimeRequest</legend>
@(Html.Kendo().Grid<OverTimeRequest>()
      .Name("OverTimeRequestgrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["organization"], "OrgStructureId", "Name").EditorTemplateName("Organization").Width(150);
          columns.Bound(c => c.Description).Width(100);
          columns.Bound(c => c.Type).EditorTemplateName("Enum").Width(130);
          columns.Bound(c => c.FromDateAm).EditorTemplateName("Calander").Width(180);//.Format("{0:yyyy-MM-dd}");
          columns.Bound(c => c.ToDateAm).EditorTemplateName("Calander").Width(180);//.Format("{0:yyyy-MM-dd}");
          columns.Bound(c => c.FromTime).Width(100);//.Format("{0:hh:mm:ss}");
          columns.Bound(c => c.ToTime).Width(100);//.Format("{0:hh:mm:ss}");

          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(200);
      })
      .ToolBar(toolbar => {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
             .Events(events => events.DetailExpand("onDetailExpandUser"))
             .Editable(editable => editable.Mode(GridEditMode.InLine))
             .Scrollable(h => h.Height(500))
               .Groupable()
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
            .Filterable()
               .Pageable(pageable => pageable
                    .Input(true)
                    .Numeric(false)
                    .Refresh(true)
                    .PageSizes(true)
                    .ButtonCount(5))
                       .Events(x =>
                       {
                           x.Edit("GetDate");
                           x.Save("GetDate");
                       })
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(s=>s.Add(x=>x.OverTimeRequestId).Descending())
                .Events(events =>
                {
                    events.Error("error_handler(\"OverTimeRequestgrid\")");
                    events.RequestStart("onRequestStart(\"OverTimeRequestgrid\")");
                    events.RequestEnd("onRequestEnd(\"OverTimeRequestgrid\")");
                })

          .Model(model => model.Id(p => p.OverTimeRequestId))
          .Read(read => read.Action("OverTimeRequest_Read", "OverTimeRequest"))
          .Create(create => create.Action("OverTimeRequest_Create", "OverTimeRequest"))
          .Update(update => update.Action("OverTimeRequest_Update", "OverTimeRequest"))
          .Destroy(destroy => destroy.Action("OverTimeRequest_Destroy", "OverTimeRequest"))
              ).ClientDetailTemplateId("template")
      )

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                  .Name("tabstrip_#=OverTimeRequestId#")
          .SelectedIndex(0)
          .Items(items =>
          {

              items.Add().Text(Resources.HR_SelfCare_OverTimeRequest_Emploees).Content(
                @<text>
                    @(Html.Kendo().Grid<OverTimeRequestEmployee>()
                          .Name("OverTimeRequestEmployee#=OverTimeRequestId#")
                          .Columns(columns =>
                          {
                              columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("ListOfEmployee").Width(300);
                             
                              columns.Bound(c => c.Remark);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                   command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(180);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              //toolbar.Custom().Action("SendForApproval", "OverTimeRequest").Text("Send For Approval").Name("Send");
                          })
                                   //.Events(e =>
                                   //{
                                     
                                   //    e.DataBound("onDataBound");
                                    
                                   //})
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Scrollable()
                          .DataSource(dataSource => dataSource
                              .Ajax()
                                      .Events(events =>
                                           {
                                               events.Error("error_handler(\"OverTimeRequestEmployee#=OverTimeRequestId#\")");
                                               events.RequestStart("onRequestStart(\"OverTimeRequestEmployee#=OverTimeRequestId#\")");
                                               events.RequestEnd("onRequestEnd(\"OverTimeRequestEmployee#=OverTimeRequestId#\")");
                                           }) 
                                         
                                           .Model(model =>                                            
                                              {
                                                  model.Id(p => p.OverTimeRequestEmployeeId);
                                                  
                                              })
                   .Read(read => read.Action("OverTimeRequestEmployee_Read", "OverTimeRequestEmployee", new { id = "#=OverTimeRequestId#" }))
                   .Create(create => create.Action("OverTimeRequestEmployee_Create", "OverTimeRequestEmployee", new { id = "#=OverTimeRequestId#" }))
                  .Update(update => update.Action("OverTimeRequestEmployee_Update", "OverTimeRequestEmployee"))
                  .Destroy(destroy => destroy.Action("OverTimeRequestEmployee_Destroy", "OverTimeRequestEmployee"))
                          ).ToClientTemplate()
                    )


                </text>
                  );

              items.Add().Text(Resources .HR_RequestStatus ).Content(
                @<text>


                    @(Html.Kendo().Grid<RequestesStatus>()
                                          .Name("RequestesStatusgrid_#=OverTimeRequestId#")
                          .Columns(columns =>
                          {
                              //columns.Bound(c => c.RequestId);
                              columns.Bound(c => c.DateReqStatAm).Width(150);
                              columns.Bound(c => c.Status).EditorTemplateName("Enum").Width(300);
                              columns.Bound(c => c.Remark).Width(150);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);//
                              }).Width(180);
                          })
                          .ToolBar(toolbar =>
                          {
                            
                              toolbar.Custom().Action("SendForApproval", "OverTimeRequest").Text(Resources.HR_Send_For_Approval);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Scrollable()
                          .DataSource(dataSource => dataSource
                              .Ajax()
                                        .Events(events =>
                                             {
                                                 events.Error("error_handler(\"RequestesStatusgrid_#=OverTimeRequestId#\")");
                                                 events.RequestStart("onRequestStart(\"RequestesStatusgrid_#=OverTimeRequestId#\")");
                                                 events.RequestEnd("onRequestEnd(\"RequestesStatusgrid_#=OverTimeRequestId#\")");
                                             }) 
                                                                     
           .Model(model =>
                                              {
                                                  model.Id(p => p.RequestStatusId);
                                                  model.Field(p => p.Date).Editable(false).DefaultValue(DateTime.Today);
                                              })
                                            .Read(read => read.Action("RequestesStatus_Read", "RequestesStatus", new { id = "#=OverTimeRequestId#", referenceType = "OverTime" }))
                                          .Create(create => create.Action("RequestesStatus_Create", "RequestesStatus", new { id = "#=OverTimeRequestId#", referenceType2 = "OverTime" }))
                                                  .Update(update => update.Action("RequestesStatus_Update", "RequestesStatus"))
                                                  .Destroy(destroy => destroy.Action("RequestesStatus_Destroy", "RequestesStatus"))
                          ).ToClientTemplate()
                    )


                </text>
                  );
          }).ToClientTemplate())
</script>

