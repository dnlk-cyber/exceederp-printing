@using System.Collections
@using ExceedERP.Core.Domain.HRM.Payroll.Setting
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@(Html.Kendo().TabStrip()
      .Name("tabstrip")
      .Animation(animation =>
            animation.Open(effect =>
                effect.Fade(FadeDirection.In)))
       .Items(tabstrip =>
         {
         tabstrip.Add().Text(Resources.NavigatorBenefit_Delegation+" "+ Resources.Settings)
               .Selected(true)
               .Content(@<text>

             <legend>@Resources.NavigatorBenefit_Delegation  @Resources.Settings  </legend>
                    @(Html.Kendo().Grid<DelegationBenefitSetting>()
                              .Name("DelegationBenefitSetting")
                              .Columns(columns =>
                              {
                                  columns.Bound(c => c.DelegationBenefitSettingId).Title("#").Width(80);
                                  columns.Bound(c => c.FromDays).Width(120);
                                  columns.Bound(c => c.ToDays).Width(120);
                                  columns.Bound(c => c.PayableSalaryInPercent).Width(150);
                                  columns.Command(command =>
                                  {
                                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                      command.Destroy().Text(Resources.ActionButton_Cancel);
                                  }).Width(200);

                              })
                              .ToolBar(toolbar =>
                              {
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              })
                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                              .Scrollable(h => h.Height(500))
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);


                              })
                              .Filterable()
                              .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .Events(events =>
                                  {
                                      events.Error("error_handler(\"DelegationBenefitSetting\")");
                                      events.RequestStart("onRequestStart(\"DelegationBenefitSetting\")");
                                      events.RequestEnd("onRequestEnd(\"DelegationBenefitSetting\")");

                                  })
                                  .Model(model =>
                                  {
                                      model.Id(p => p.DelegationBenefitSettingId);
                                      model.Field(p => p.DelegationBenefitSettingId).Editable(false);
                                  })
                                  .Read(read => read.Action("Read", "DelegationBenefitSettings").Data("sendForgery"))
                                  .Create(create => create.Action("Create", "DelegationBenefitSettings").Data("sendForgery"))
                                  .Update(update => update.Action("Update", "DelegationBenefitSettings").Data("sendForgery"))
                                  .Destroy(destroy => destroy.Action("Destroy", "DelegationBenefitSettings").Data("sendForgery"))
                              )
                    )

    </text>);

