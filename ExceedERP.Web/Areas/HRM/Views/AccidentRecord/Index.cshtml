    function sync_handler(e) {
        this.read();

    }
    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }
    function onChange(e) {
        var grid = e.sender;
        var selectedRows = this.select();
        var rowData = this.dataItem(selectedRows[0]);
        var id = rowData.AttachmentID;
        $.ajax({
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("Download", "AccidentRecord")',
            data: { 'id': id },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
            }

        });
    }
</script>
<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#DateAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "AccidentRecord")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }

</script>