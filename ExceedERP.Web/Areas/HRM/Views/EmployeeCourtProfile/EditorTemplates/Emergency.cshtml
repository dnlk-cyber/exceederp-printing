@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.EmployeeDetail.Emergency 
<form>
  
   
   
    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

              
                @Html.Kendo().TextBoxFor(model => model.Name)
                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })

      
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.LookupId , htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">
                @(Html.Kendo().DropDownListFor(model => model.LookupId)
                         .OptionLabel(Resources.Select)
                                    .DataTextField("Description")
                                            .DataValueField("LookupId")
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetRelationshipList", "HRMDataProvider", new { area = "HRM" }))
                              .ServerFiltering(false);
                      }))
                            .ValuePrimitive(true)
)
                @Html.ValidationMessageFor(model => model.LookupId, "", new { @class = "text-danger" })
              


            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.HomePhoneNo, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

               @Html.Kendo().MaskedTextBoxFor(x => x.HomePhoneNo).Mask("(+999) 000-00-00-00")
                @Html.ValidationMessageFor(model => model.HomePhoneNo, "", new { @class = "text-danger" })
                
                
            </div>
        </div>
      
    </div>
    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.WorkPhoneno, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">


                @Html.Kendo().MaskedTextBoxFor(x => x.WorkPhoneno).Mask("(+999) 000-00-00-00")
                @Html.ValidationMessageFor(model => model.WorkPhoneno, "", new { @class = "text-danger" })


            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.MobilePhoneNo, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().MaskedTextBoxFor(x => x.MobilePhoneNo).Mask("(+999) 000-00-00-00")
                @Html.ValidationMessageFor(model => model.MobilePhoneNo, "", new { @class = "text-danger" })


            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div class="form-group">

                @Html.TextAreaFor(model => model.Remark)
                @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
            </div>
        </div>

    </div>


</form>
