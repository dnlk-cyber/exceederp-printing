              .Create(create => create.Action("Person_Employee_Create", "PersonalProfile"))
              .Update(update => update.Action("Person_Employee_Update", "PersonalProfile"))
              .Destroy(destroy => destroy.Action("Person_Employee_Destroy", "PersonalProfile"))

          ).ClientDetailTemplateId("template")

)
