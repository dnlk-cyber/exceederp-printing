@using System.Collections
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.NavigatorRecruitment_RecruitmentRequest</Legend>
@(Html.Kendo().Grid<RecruitmentRequest>()
                  .Name("RecruitmentRequestgrid")
              .Columns(columns =>
              {
                  columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").EditorTemplateName("Branch").Width(150);
                  columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["Departments"], "OrgStructureId", "Name").EditorTemplateName("Department").Width(150);
                  columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLPeriodSelector").Width(80);

                  columns.Bound(c => c.EmploymentType).EditorTemplateName("Enum").Width(120);
                  columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["jobTitles"], "LookupId", "Description").EditorTemplateName("JobTitles").Width(150);
                  columns.Bound(c => c.PlanType).EditorTemplateName("Enum").Width(110);
                  columns.Bound(c => c.NoOfShouldBeStaff).Width(135);
                  columns.Bound(c => c.NoOfCurrentStaff).Width(130);

                  columns.Bound(c => c.NoOfVaccantPostion).Title(Resources.Recruitment_Requested_Vacancy).Width(140);

                  columns.Command(command =>
                  {
                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                      command.Destroy().Text(Resources.ActionButton_Cancel);
                  }).Width(200);
              })
              .ToolBar(toolbar =>
              {
                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
              })
                                .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Request").Window(window => { window.Title(Resources.NavigatorRecruitment_RecruitmentRequest); window.Scrollable(false); }))
                                    .Events(events => events.DetailExpand("onDetailExpandUser"))
                   .HtmlAttributes(new { style = "height: 550px;" })
                                       .Groupable()
                                      .Sortable(sortable =>
                                      {
                                          sortable.SortMode(GridSortMode.SingleColumn);
                                      })
                                       .Filterable()
                                      .Scrollable()
                                  .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
              .DataSource(dataSource => dataSource
                  .Ajax()
                          .Sort(sort => sort.Add("DateCreated").Descending())
                       .Events(events =>
                       {
                           events.Error("error_handler(\"RecruitmentRequestgrid\")");
                           events.RequestStart("onRequestStart(\"RecruitmentRequestgrid\")");
                           events.RequestEnd("onRequestEnd(\"RecruitmentRequestgrid\")");
                       })

                  .Model(model =>
                  {
                      model.Id(p => p.RecruitmentRequestId);
                      model.Field(p => p.NoOfCurrentStaff).Editable(false);
                      model.Field(p => p.NoOfShouldBeStaff).Editable(false);

                  })
                  .Read(read => read.Action("RecruitmentRequest_Read", "RecruitmentRequest"))
                  .Create(create => create.Action("RecruitmentRequest_Create", "RecruitmentRequest"))
                  .Update(update => update.Action("RecruitmentRequest_Update", "RecruitmentRequest"))
                  .Destroy(destroy => destroy.Action("RecruitmentRequest_Destroy", "RecruitmentRequest"))
                  ).ClientDetailTemplateId("template")
)



<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                          .Name("tabstrip_#=RecruitmentRequestId#")
                          .SelectedIndex(0)
                          .Items(items =>
                          {
                              items.Add().Text(Resources.HR_RequestStatus).Content(
                                @<text>
                                    @*<legend>Status</legend>*@

                            <a href='@Url.Action("RecruitmentRequestLetter", "PrintableLetter")/?id=#=RecruitmentRequestId#' title="Print"><i class="fa fa-print fa-2x"></i></a>
                             
                     @(Html.Kendo().Grid<RequestesStatus>()
                                       .Name("RequestesStatusgrid_#=RecruitmentRequestId#")
                               .Columns(columns =>
                               {
                               //columns.Bound(c => c.RequestId);
                               columns.Bound(c => c.DateReqStatAm).Width(100);
                                           columns.Bound(c => c.Status).EditorTemplateName("EnumWithoutApprove").Width(100);
                                           columns.ForeignKey(c => c.ApproverId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").Width(130).Filterable(ftb => ftb.Multi(true).Search(true));
                                           columns.ForeignKey(c => c.ApproverDepartment, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                                           columns.Bound(c => c.Remark).Width(70);
                                           columns.Command(command =>
                                           {
                                               command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit).HtmlAttributes(new { id = "requestStatusUpdateButton" });
                                               command.Destroy().Text(Resources.ActionButton_Cancel);
                                           }).Width(400);
                                       })
                               .ToolBar(toolbar =>
                               {
                                         //  toolbar.Create().HtmlAttributes(new { id = "StatusCreateButton" });
                                           toolbar.Custom().Action("SendForApproval", "RecruitmentRequest").Text("").IconClass("fa fa-share-square fa-2x").HtmlAttributes(new { title = "Send For Approval", id = "StatusSendForApprovalButton" });
                                       })
                                .Events(events =>
                                {
                                //  events.DataBound("onDetailDataBound");
                                events.Edit("onStatusEdit");
                                        })
                               .Editable(editable => editable.Mode(GridEditMode.InLine))
                               .Scrollable()
                               .DataSource(dataSource => dataSource
                                   .Ajax()
                                           .Events(events =>
                                           {
                                                       events.Error("error_handler(\"RequestesStatusgrid_#=RecruitmentRequestId#\")");
                                                       events.RequestStart("onRequestStart(\"RequestesStatusgrid_#=RecruitmentRequestId#\")");
                                                       events.RequestEnd("onRequestEnd(\"RequestesStatusgrid_#=RecruitmentRequestId#\")");
                                                   })

                                           .Model(model =>
                                           {
                                                       model.Id(p => p.RequestStatusId);
                                                       model.Field(p => p.Date).Editable(false).DefaultValue(DateTime.Today);
                                                       model.Field(p => p.DateReqStatAm).Editable(false);
                                                       model.Field(p => p.ApproverDepartment).Editable(false);
                                                       model.Field(p => p.ApproverId).Editable(false);
                                                   })

                                  .Read(read => read.Action("RequestesStatus_Read", "RequestesStatus", new { id = "#=RecruitmentRequestId#", referenceType = "Recruitment" }))
                                 .Create(create => create.Action("RequestesStatus_Create", "RequestesStatus", new { id = "#=RecruitmentRequestId#", referenceType2 = "Recruitment" }))
                                               .Update(update => update.Action("RequestesStatus_Update", "RequestesStatus"))
                                               .Destroy(destroy => destroy.Action("RequestesStatus_Destroy", "RequestesStatus"))
                               ).ToClientTemplate()
                                    )


                                </text>
                                                  );
                          //*****************************************************************************************************//

                      }).ToClientTemplate())
</script>
