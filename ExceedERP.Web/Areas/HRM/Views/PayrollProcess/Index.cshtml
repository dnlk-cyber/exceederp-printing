<script>
    function Process() {
        var periods = $("#GLPeriodId").data("kendoComboBox");
        var branchs = $("#BranchId").data("kendoComboBox");
        var save = $("#btnSave").data("kendoButton");
        try {
            if ($('#btnSave').length > 0) {
                save.enable(false);
            }
            $('body').addClass('waiting');
            var period = periods.value();
            var branchid = branchs.value();
            //var passProgress = $("#progressBar").data("kendoProgressBar");
            //passProgress.value(0);
            //passProgress.value(20);
            //passProgress.value(40);
            //passProgress.value(55);

            //var interval = setInterval(function () {
            //    if (passProgress.value() <50) {

            //        passProgress.value(passProgress.value() + 1);
            //    }

            //    else {
            //        clearInterval(interval);
            //    }
            //}, 100);
            $.ajax({
                url: '@Url.Action("ProcessPayroll", "PayrollProcess")',
                //contentType: "application/json; charset=utf-8",
                data: { period: period, branchid: branchid},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                  
                  //  alert("Successfully Processed");
                    $("#Periodgrid").data("kendoGrid").dataSource.read();
                    $("#Periodgrid").data("kendoGrid").refresh();
                    $("#GLPeriodId").data("kendoComboBox").refresh();
                    $("#BranchId").data("kendoComboBox").refresh();
                    $("#GLPeriodId").data("kendoComboBox").dataSource.read();
                    $("#BranchId").data("kendoComboBox").dataSource.read();
                    if ($('#btnSave').length > 0) {
                        save.enable(true);
                    }
                    $('body').removeClass('waiting');
                }

                
            });
           
           
           
        } catch (e) {
            alert("Please select Period and Branch!!");
        }
        //});
    }
    function ProcessAll() {
        var periods = $("#GLPeriodId").data("kendoComboBox");
        var branchs = $("#BranchId").data("kendoComboBox");
        var save = $("#btnAllProcess").data("kendoButton");
        try {
            if ($('#btnAllProcess').length > 0) {
                save.enable(false);
            }
            $('body').addClass('waiting');
            var period = periods.value();
            var branchid = branchs.value();
           
            $.ajax({
                url: '@Url.Action("ProcessPayroll", "PayrollProcess")',
                //contentType: "application/json; charset=utf-8",
                data: { period: period,branchid:0, all: "all" },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;

                    //  alert("Successfully Processed");
                    $("#Periodgrid").data("kendoGrid").dataSource.read();
                    $("#Periodgrid").data("kendoGrid").refresh();
                    $("#GLPeriodId").data("kendoComboBox").refresh();
                    $("#BranchId").data("kendoComboBox").refresh();
                    $("#GLPeriodId").data("kendoComboBox").dataSource.read();
                    $("#BranchId").data("kendoComboBox").dataSource.read();
                    if ($('#btnAllProcess').length > 0) {
                        save.enable(true);
                    }
                    $('body').removeClass('waiting');
                }


            });



        } catch (e) {
            alert("Please select Period");
        }
        //});
    }
</script>
