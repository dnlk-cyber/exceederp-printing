<script>
    function CheckDisablity(e) {
        var save = $("#btnSave").data("kendoButton");
        var allsave = $("#btnAllProcess").data("kendoButton");
        var reverse = $("#btnReverse").data("kendoButton");
        var distribute = $("#btnDistribut").data("kendoButton");
        var close = $("#btnclose").data("kendoButton");
        var transfer = $("#btnTransfer").data("kendoButton");
        var grid = $("#Periodgrid").data("kendoGrid");
        var sendmail = $("#btnSendMail").data("kendoButton");
        var dataItem = grid.dataItem(grid.select());
        var id = dataItem.GLPeriodId;
        var branchid = dataItem.BranchId;
        $.ajax({
            url: '@Url.Action("CheckStatus", "PayrollProcess")',
            contentType: "application/json; charset=utf-8",
            data: { 'id': id, 'branchid': branchid },
            type: 'GET',
            cache: false,
            success: function(result) {
                r = result;
                if (r == "c") {
                    if ($('#btnSave').length > 0) {
                        save.enable(false);
                    }
                    if ($('#btnAllProcess').length > 0) {
                        allsave.enable(false);
                    }
                    if ($('#btnReverse').length > 0) {
                        reverse.enable(false);
                    }
                    if ($('#btnclose').length > 0) {
                    close.enable(false);
                   }

                    if ($('#btnTransfer').length > 0) {
                        transfer.enable(true);
                    }
                    if ($('#btnSendMail').length > 0) {
                        sendmail.enable(true);
                    }
                    //}

                    if ($('#btnDistribut').length > 0) {
                        distribute.enable(true);
}
                }
                else if (r == "t") {
                    if ($('#btnSave').length > 0) {
                        save.enable(false);
                    }
                    if ($('#btnAllProcess').length > 0) {
                        allsave.enable(false);
                    }
                    if ($('#btnReverse').length > 0) {
                        reverse.enable(false);
                    } if ($('#btnclose').length > 0) {
                    close.enable(false);
              }

                    if ($('#btnTransfer').length > 0) {
                        transfer.enable(false);
                    }
                    if ($('#btnSendMail').length > 0) {
                        sendmail.enable(true);
                    }
                    if ($('#btnDistribut').length > 0) {

                        distribute.enable(true);
                    }
                }
                else if (r == "n") {
                    if ($('#btnSave').length > 0) {
                        save.enable(true);
                    }
                    if ($('#btnAllProcess').length > 0) {
                        allsave.enable(false);
                    }
                    if ($('#btnReverse').length > 0) {
                        reverse.enable(false);
                    } if ($('#btnclose').length > 0) {
                        close.enable(false);
}

                    if ($('#btnSendMail').length > 0) {
                        sendmail.enable(false);
                    }
                    if ($('#btnTransfer').length > 0) {
                        transfer.enable(false);
                    }
                    if ($('#btnDistribut').length > 0) {
                        distribute.enable(false);
                    }
                } else {
                    if ($('#btnSave').length > 0) {
                        save.enable(false);
                    }
                    if ($('#btnAllProcess').length > 0) {
                        allsave.enable(false);
                    }
                    if ($('#btnReverse').length > 0) {
                        reverse.enable(true);
                    }
                    if ($('#btnclose').length > 0) {
                        close.enable(true);
}
                    if ($('#btnTransfer').length > 0) {
                        transfer.enable(false);
                    }

                    if ($('#btnSendMail').length > 0) {
                        sendmail.enable(false);
                    }
                    if ($('#btnDistribut').length > 0) {
                        distribute.enable(true);
}
                }
            }

        });


    }
</script>

