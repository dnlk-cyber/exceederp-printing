<script>
    //
    // Global variables to be used on distribution regenerating
    var selectedBranchId = 0;
    var selectedPeriodId = 0;
    //var statusOfSelectedPayrollPeriodStatus= 3 // set to 3(transfered) by default

    function Distributions(e) {
        try {
            var grid = $("#Periodgrid").data("kendoGrid");

            var dataItem = grid.dataItem(grid.select());
            var id = dataItem.GLPeriodId;
            var branchid = dataItem.BranchId;
            // update global variables to current selected row
            selectedBranchId = branchid;
            selectedPeriodId = id;

            var stat = dataItem.Status;
            if (stat == 3) {
                $("#regenerate-distribution-button").attr("disabled", true);
            }
            else {
                $("#regenerate-distribution-button").attr("disabled", false);
            }
            var save = $("#btnDistribut").data("kendoButton");
            if ($('#btnDistribut').length > 0) {
                save.enable(false);
            }
            $('#divWaitingPanel').show();
            //$('#divWaitingPanel').center().open();
            //var passProgress = $("#progressBar").data("kendoProgressBar");
            //passProgress.value(0);
            //passProgress.value(20);
            //passProgress.value(40);
            //passProgress.value(55);

            $.ajax({
                url: '@Url.Action("Distribution", "PayrollProcess")',
               // contentType: "application/json; charset=utf-8",
                data: { 'id': id, 'branchid': branchid },
                type: 'POST',
                cache: false,
                success: function (result) {
                    var r = result;
                    $("#Periodgrid").data("kendoGrid").dataSource.read();
                    $("#Periodgrid").data("kendoGrid").refresh();
                   
                    
                    if (r === "true") {
                        $("#PayrollDistributiongrid").data("kendoGrid").dataSource.read();
                        $("#PayrollDistributiongrid").data("kendoGrid").refresh();
                        var wnd = $("#DisWindow").data("kendoWindow");
                        wnd.center().open();
                        $('#divWaitingPanel').hide();

                    } 
                    else if (r === "false") {
                        alert("Distribution is not done.Please check payroll account assignment!!");
                        $('#divWaitingPanel').hide();
                    }
                    if ($('#btnDistribut').length > 0) {
                        save.enable(true);
                    }
                    $('#divWaitingPanel').hide();
                } ,
                beforeSend: function () {
                    // Show image container
                    $("#loading-image").show();
                },
                complete: function (data) {
                    // Hide image container
                    $("#loading-image").hide();
                },
                error: function (result) {
                    alert(result);
                }
                 
            });

        } catch (ee) {
            alert("Please select the row!!");
        }
    }
   function onReGenerateButtonclick(e) {
        $("#regenerate-distribution-button").attr("disabled", true);
        //if (btn) {
        //    btn.enable(false);
        //}
        //var grid = $("#Periodgrid").data("kendoGrid");
        //var dataItem = grid.dataItem(grid.select());
        //var id = dataItem.GLPeriodId;
        //var branchid = dataItem.BranchId;
        if (confirm("Are you sure you want to regenerate distribution? Existing Distribution data will be deleted.")) {
            $.ajax({
                url: '@Url.Action("RegenerateDistribution", "PayrollProcess")',
                data: { id: selectedPeriodId, branchId: selectedBranchId, },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    $("#PayrollDistributiongrid").data("kendoGrid").dataSource.read();
                    $("#PayrollDistributiongrid").data("kendoGrid").refresh();

                    $("#regenerate-distribution-button").attr("disabled", false);
                },
                beforeSend: function () {
                    // Show image container
                    $("#loading-image").show();
                },
                complete: function (data) {
                    // Hide image container
                    $("#loading-image").hide();
                },
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
</script>

