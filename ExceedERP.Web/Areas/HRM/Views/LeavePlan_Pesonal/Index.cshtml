@using System.Collections
@using ExceedERP.Core.Domain.HRM.HRMPlan
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? true;
}

<style type="text/css">
    /* Modal container and general styling */
    div.k-edit-form-container {
        width: 100% !important;
        max-width: 900px !important;
        padding: 15px 25px !important;
    }

    .k-window {
        max-width: 95vw !important;
    }

    /* Status Pills */
    .lp-status-pill {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-approved {
        background-color: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }

    .status-dept {
        background-color: #ecfdf5;
        color: #047857;
        border: 1px solid #6ee7b7;
    }

    .status-waiting {
        background-color: #e0f2fe;
        color: #0369a1;
        border: 1px solid #bae6fd;
    }

    .status-pending {
        background-color: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .status-rejected {
        background-color: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    /* Base Row Colors */
    .row-approved {
        background-color: #e5e7eb !important;
    }

    .row-dept-approved {
        background-color: #d1fae5 !important;
    }

    .row-waiting {
        background-color: #e0f2fe !important;
    }

    .row-pending {
        background-color: #fef3c7 !important;
    }

    .row-rejected {
        background-color: #fee2e2 !important;
    }

    /* Dynamic Hover States */
    .k-grid tbody tr.row-approved:hover,
    .k-grid tbody tr.row-approved.k-state-hover {
        background-color: #cbd5e1 !important;
        cursor: pointer;
    }

    .k-grid tbody tr.row-dept-approved:hover,
    .k-grid tbody tr.row-dept-approved.k-state-hover {
        background-color: #a7f3d0 !important;
        cursor: pointer;
    }

    .k-grid tbody tr.row-waiting:hover,
    .k-grid tbody tr.row-waiting.k-state-hover {
        background-color: #bae6fd !important;
        cursor: pointer;
    }

    .k-grid tbody tr.row-pending:hover,
    .k-grid tbody tr.row-pending.k-state-hover {
        background-color: #fde68a !important;
        cursor: pointer;
    }

    .k-grid tbody tr.row-rejected:hover,
    .k-grid tbody tr.row-rejected.k-state-hover {
        background-color: #fecaca !important;
        cursor: pointer;
    }

    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>

<legend>@Resources.NavigatorLeave_LeavePlan || @Resources.SelfCare_Personal_Self_Service</legend>

<!-- Top Status Legend Card -->
<div class="well well-sm" style="background: #fff; border-radius: 4px; margin-bottom: 12px; padding: 8px 15px; border: 1px solid #e2e8f0;">
    <span class="fa fa-circle" style="color: #6b7280;"></span> Final Approved &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #10b981;"></span> Department Approved &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #0284c7;"></span> Waiting for Approval &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #f59e0b;"></span> Pending &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #ef4444;"></span> Rejected
</div>

@(Html.Kendo().Grid<LeavePlan>()
          .Name("LeavePlangrid")
          .Columns(columns =>
          {
              columns.Bound(c => c.EmployeeCode).Width(120);
              columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish")
                     .EditorTemplateName("EmployeeEditor")
                     .Filterable(ftb => ftb.Multi(true).Search(true))
                     .Width(210);
              columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name")
                     .EditorTemplateName("GLFPeriod")
                     .Filterable(ftb => ftb.Multi(true).Search(true))
                     .Width(120);
              columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["Period"], "GLPeriodId", "Name")
                     .EditorTemplateName("GLPeriodSelector")
                     .Filterable(ftb => ftb.Multi(true).Search(true))
                     .Width(120);

              if (useEthiopian)
              {
                  columns.Bound(c => c.FromAmharic).EditorTemplateName("Calander").Width(130);
                  columns.Bound(c => c.ToAmharic).EditorTemplateName("Calander").Width(130);
              }
              else
              {
                  columns.Bound(c => c.From).Format("{0:dd/MM/yyyy}").Width(110);
                  columns.Bound(c => c.To).Format("{0:dd/MM/yyyy}").Width(110);
              }

              columns.Bound(c => c.Day).Width(90);
              columns.Bound(c => c.LeaveAmount).Title("Leave Days").Width(100);
              columns.Bound(c => c.Remark).Width(140);

              columns.Bound(c => c.IsOnlineApproved).Title("Approved").ClientTemplate(
                  "<input type='checkbox' disabled='true' value='\\#=IsOnlineApproved\\#' " +
                  "\\# if (IsOnlineApproved) { \\# checked='checked' \\# } \\# />").Width(90);

              columns.Command(command =>
              {
                  if (HttpContext.Current.User.IsInRole("HR_Leave_User")
                   || HttpContext.Current.User.IsInRole("HR_Manager_SelfService")
                   || HttpContext.Current.User.IsInRole("HR_Employee_SelfService"))
                  {
                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  }

                  if (HttpContext.Current.User.IsInRole("HR_Employee_SelfService")
                   || HttpContext.Current.User.IsInRole("HR_Leave_User")
                   || HttpContext.Current.User.IsInRole("HR_Manager_SelfService"))
                  {
                      command.Destroy().Text(Resources.ActionButton_Cancel);
                  }
              }).Width(180);
          })
          .ToolBar(toolbar =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Leave_User")
               || HttpContext.Current.User.IsInRole("HR_Manager_SelfService")
               || HttpContext.Current.User.IsInRole("HR_Employee_SelfService"))
              {
                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
              }

              if (HttpContext.Current.User.IsInRole("HR_Employee_SelfService")
               || HttpContext.Current.User.IsInRole("HR_Leave_User")
               || HttpContext.Current.User.IsInRole("HR_Manager_SelfService"))
              {
                  toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
                  toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
              }
          })
          .Excel(excel => excel
              .FileName(Resources.NavigatorLeave_LeavePlan + ".xlsx")
              .Filterable(true)
              .AllPages(true)
              .ProxyURL(Url.Action("Excel_Export_Save", "LeavePlan")))
          .Pdf(pdf => pdf
              .AllPages()
              .FileName(Resources.NavigatorLeave_LeavePlan + ".pdf")
              .ProxyURL(Url.Action("Pdf_Export_Save", "LeavePlan")))
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
          .Groupable()
          .Sortable(sortable => sortable.SortMode(GridSortMode.SingleColumn))
          .Filterable()
          .Events(ev =>
          {
              ev.DetailExpand("onDetailExpandUser");
              ev.DataBound("onDataBound");
              ev.Edit("GetDate");
              ev.Save("GetDate");
          })
          .Pageable(pageable => pageable
              .Input(true)
              .Numeric(false)
              .Refresh(true)
              .PageSizes(true)
              .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Sort(srt => srt.Add(x => x.LeavePlanId).Descending())
              .Events(events =>
              {
                  events.Error("error_handler(\"LeavePlangrid\")");
                  events.RequestStart("onRequestStart(\"LeavePlangrid\")");
                  events.RequestEnd("onRequestEnd(\"LeavePlangrid\")");
              })
              .Model(model =>
              {
                  model.Id(p => p.LeavePlanId);
                  model.Field(p => p.LeavePlanId).Editable(false);
                  model.Field(p => p.EmployeeCode).Editable(false);
                  model.Field(p => p.EmployeeId).Editable(false);
                  model.Field(p => p.IsOnlineApproved).Editable(false);
              })
              .Read(read => read.Action("LeavePlan_Pesonal_Read", "LeavePlan_Pesonal").Data("sendForgery"))
              .Create(create => create.Action("LeavePlan_Pesonal_Create", "LeavePlan_Pesonal").Data("sendForgery"))
              .Update(update => update.Action("LeavePlan_Pesonal_Update", "LeavePlan_Pesonal").Data("sendForgery"))
              .Destroy(destroy => destroy.Action("LeavePlan_Pesonal_Destroy", "LeavePlan_Pesonal").Data("sendForgery"))
          )
          .ClientDetailTemplateId("leave_plan_template")
)

<!-- Master-Detail Template -->
<script id="leave_plan_template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                .Name("tabstrip_#=LeavePlanId#")
                .SelectedIndex(0)
                .Items(items =>
                {
                    items.Add().Text("Department Validation").Content(
                    @<text>
                        @(Html.Kendo().Grid<LeavePlanValidation>()
                                    .Name("LeavePlanValidationgrid_#=LeavePlanId#")
                                    .Columns(columns =>
                                    {
                                                columns.Bound(c => c.Status).Width(180);
                                                columns.Bound(c => c.Remark).Width(250);
                                            })
                                    .Editable(editable => editable.Mode(GridEditMode.InLine))
                                    .Scrollable(h => h.Height(250))
                                    .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Events(events =>
                                        {
                                                    events.Error("error_handler(\"LeavePlanValidationgrid_#=LeavePlanId#\")");
                                                    events.RequestStart("onRequestStart(\"LeavePlanValidationgrid_#=LeavePlanId#\")");
                                                    events.RequestEnd("onRequestEnd(\"LeavePlanValidationgrid_#=LeavePlanId#\")");
                                                })
                                        .Model(model => model.Id(p => p.LeavePlanValidationId))
                                        .Read(read => read.Action("LeavePlanDeparmentalValidation_Read", "LeavePlanDeparmentalValidation", new { gId = "#=LeavePlanId#" }).Data("sendForgery"))
                                        .Create(create => create.Action("LeavePlanDeparmentalValidation_Create", "LeavePlanDeparmentalValidation", new { gId = "#=LeavePlanId#" }).Data("sendForgery"))
                                        .Update(update => update.Action("LeavePlanDeparmentalValidation_Update", "LeavePlanDeparmentalValidation").Data("sendForgery"))
                                        .Destroy(destroy => destroy.Action("LeavePlanDeparmentalValidation_Destroy", "LeavePlanDeparmentalValidation").Data("sendForgery"))
                                    ).ToClientTemplate()
                        )

                        <div style="margin-top: 10px;">
                            # if (!IsSendForApproval) { #
                            <a onclick='return sendForApproval("#=LeavePlanId#")' class="btn btn-xs btn-primary" title="@Resources.HR_Send_For_Approval">
                                <i class="fa fa-share-square"></i> @Resources.HR_Send_For_Approval
                            </a>&nbsp;&nbsp;
                            # } #
                            <a href='@Url.Action("LeavePlanPrintOut", "PrintableLetter", new { area = "HRM" })/?id=#=LeavePlanId#' class="btn btn-xs btn-default" title="Print" target="_blank">
                                <i class="fa fa-print"></i> Print Plan
                            </a>
                        </div>
                    </text>);

                            items.Add().Text(Resources.Details).Content(
                            @<text>
                                <div style="padding: 12px; background: rgb(250, 250, 250); border-radius: 4px;">
                                    <ul style="list-style: none; padding-left: 0; line-height: 24px; margin-bottom: 0;">
                                        <li><strong>Created By:</strong> #=CreatedBy #</li>
                                        <li><strong>Created Date:</strong> #=DateCreated #</li>
                                        <li><strong>Modified By:</strong> #=ModifiedBy #</li>
                                        <li><strong>Last Modified Date:</strong> #=LastModified #</li>
                                    </ul>
                                </div>
                            </text>);
                                }).ToClientTemplate())
</script>

<script>
    var masterId = 0;

    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;
        var masterGrid = $("#LeavePlangrid").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.LeavePlanId;

        var gridName = "#LeavePlanValidationgrid_" + masterId;
        if (masterDataItem.IsDepartmentOnlineApproved || masterDataItem.IsSendForApproval) {
            $(gridName).find(".k-toolbar").hide();
            $(".k-grid-top", gridName).hide();
            $(".k-grid-edit", gridName).hide();
            $(".k-grid-delete", gridName).hide();
        }
    }

    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var model = grid.dataItem(this);
            var $row = $(this);

            $row.removeClass("row-approved row-dept-approved row-waiting row-pending row-rejected");

            // 1. Final Approved
            if (model.IsOnlineApproved === true) {
                $row.addClass("row-approved");
                $row.find(".k-grid-edit, .k-grid-delete").remove();
            }
            // 2. Department Approved
            else if (model.IsDepartmentOnlineApproved === true) {
                $row.addClass("row-dept-approved");
                $row.find(".k-grid-edit, .k-grid-delete").remove();
            }
            // 3. Waiting for Approval (Sent)
            else if (model.IsSendForApproval === true) {
                $row.addClass("row-waiting");
                $row.find(".k-grid-edit, .k-grid-delete").remove();
            }
            // 4. Rejected
            else if (model.IsRejected === true) {
                $row.addClass("row-rejected");
            }
            // 5. Pending / Draft
            else {
                $row.addClass("row-pending");
            }
        });
    }

    function sendForApproval(id) {
        if (!confirm("Are you sure you want to send this leave plan for approval?")) return;

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApprovalRequest", "LeavePlan_Pesonal", new { area = "HRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                $("#LeavePlangrid").data("kendoGrid").dataSource.read();
            },
            error: function (result) {
                alert(result.Message || "Operation failed.");
            }
        });
    }

    function GetDate() {
        $("#FromAmharic").trigger("change");
        $("#ToAmharic").trigger("change");
        if (typeof AssignDates === "function") {
            var y = AssignDates();
            for (var o in y) {
                $.ajax({
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("SetDate", "LeavePlan")',
                    data: { name: y[o].id, value: y[o].date },
                    type: 'GET',
                    cache: false,
                    success: function () { }
                });
            }
        }
    }

    function filterPeriod() {
        return {
            GlFiscalYearId: $("#GlFiscalYearId").val()
        };
    }
</script>