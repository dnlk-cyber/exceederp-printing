@using System.Collections
@using ExceedERP.Core.Domain.HRM.HRMPlan
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorLeave_LeavePlan || @Resources.SelfCare_Personal_Self_Service</legend>
@(Html.Kendo().Grid<LeavePlan>()
      .Name("LeavePlangrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(120);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("EmployeeEditor").Filterable(ftb => ftb.Multi(true).Search(true)).Width(210);
          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
          columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["Period"], "GLPeriodId", "Name").EditorTemplateName("GLPeriodSelector").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);

          columns.Bound(c => c.FromAmharic).EditorTemplateName("Calander").Width(150);
          columns.Bound(c => c.ToAmharic).EditorTemplateName("Calander").Width(150);
          columns.Bound(c => c.Day).Width (120);
          columns.Bound(c => c.LeaveAmount).Width (120);
          columns.Bound(c => c.Remark).Width (100);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Leave_User")
              || HttpContext.Current.User.IsInRole("HR_Manager_SelfService")
              || HttpContext.Current.User.IsInRole("HR_Employee_SelfService"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("HR_Employee_SelfService")
                            || HttpContext.Current.User.IsInRole("HR_Leave_User")
                            || HttpContext.Current.User.IsInRole("HR_Manager_SelfService"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }

          }).Width(200);
      })
      .ToolBar(toolbar => {
          if (HttpContext.Current.User.IsInRole("HR_Leave_User")
          || HttpContext.Current.User.IsInRole("HR_Manager_SelfService")
          || HttpContext.Current.User.IsInRole("HR_Employee_SelfService"))
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
          if (HttpContext.Current.User.IsInRole("HR_Employee_SelfService")
              || HttpContext.Current.User.IsInRole("HR_Leave_User")
              || HttpContext.Current.User.IsInRole("HR_Manager_SelfService"))
          {
              toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
              toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
          }
      })
      .Excel(excel => excel
      .FileName(Resources.NavigatorLeave_LeavePlan + ".xlsx")
      .Filterable(true)
      .AllPages(true)
      .ProxyURL(Url.Action("Excel_Export_Save", "LeavePlan")))
      .Pdf(pdf => pdf
      .AllPages()
      .FileName(Resources.NavigatorLeave_LeavePlan + ".pdf")
      .ProxyURL(Url.Action("Pdf_Export_Save", "LeavePlan")))
      .Events(ev =>
      {
          ev.DetailExpand("onDetailExpandUser");
          ev.DataBound("onDataBound");

      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Scrollable(h => h.Height(500))
             .Events(x =>
             {
                 x.Edit("GetDate");
                 x.Save("GetDate");
             })
             .Groupable()
             .Sortable(sortable =>
             {
                 sortable.SortMode(GridSortMode.SingleColumn);

             })
             .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
          .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(srt => srt.Add(x => x.LeavePlanId).Descending())
                .Events(events =>
                {
                    events.Error("error_handler(\"LeavePlangrid\")");
                    events.RequestStart("onRequestStart(\"LeavePlangrid\")");
                    events.RequestEnd("onRequestEnd(\"LeavePlangrid\")");
                })
               .Model(model => { model.Id(p => p.LeavePlanId);
                   model.Field(p => p.EmployeeCode).Editable (false);
                   model.Field(p => p.EmployeeId).Editable (false);
               })
          .Read(read => read.Action("LeavePlan_Pesonal_Read", "LeavePlan_Pesonal").Data("sendForgery"))
          .Create(create => create.Action("LeavePlan_Pesonal_Create", "LeavePlan_Pesonal").Data("sendForgery"))
          .Update(update => update.Action("LeavePlan_Pesonal_Update", "LeavePlan_Pesonal").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("LeavePlan_Pesonal_Destroy", "LeavePlan_Pesonal").Data("sendForgery"))
      ).ClientDetailTemplateId("leave_plan_template")
)

