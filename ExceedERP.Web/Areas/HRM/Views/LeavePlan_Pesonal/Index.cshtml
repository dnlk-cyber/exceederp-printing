<script>
    function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApprovalRequest", "LeavePlan_Pesonal", new { area = "HRM" })',
            data: { id: id },
            success: function(result) {
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            },
            error: function(result) {
                alert(result.Message);
            }
        });
    }
</script>
<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#FromAmharic").trigger("change");
        $("#ToAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "LeavePlan")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#LeavePlangrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        var masterId = masterDataItem.GeneralServiceWorksRequestId;
        var gridName = "#LeavePlanValidationgrid_" + masterId;
        if (masterDataItem.IsDepartmentOnlineApproved) {
            $(gridName).find(".k-toolbar").hide();
            $(".k-grid-top", gridName).hide();
            $(".k-grid-edit", gridName).hide();
            $(".k-grid-delete", gridName).hide();

        }
        if (masterDataItem.IsSendForApproval) {
            $(gridName).find(".k-toolbar").hide(); //hide toolbar
            $(".k-grid-top", gridName).hide();
            $(".k-grid-edit", gridName).hide();
            $(".k-grid-delete", gridName).hide();


        }



    }

    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsDepartmentOnlineApproved) {

                row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();
                // $(".k-grid-top").show();

            }
            if (dataItem.IsSendForApproval) {

                row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();
                // $(".k-grid-top").show();
                row.css("background-color", "yellow");
                row.find(".k-grid-cmd-close").hide();
            }
            if (dataItem.IsConfirmedByHead) {
                row.css("background-color", "darkorange");


            }
            if (dataItem.IsCheckedByTeamLeaer) {
                row.css("background-color", "green");
                row.find(".k-grid-cmd-close").show();


            }
            if (dataItem.IsClosedByGeneralService) {
                row.css("background-color", "darkred");
                row.find(".k-grid-cmd-close").hide();

            }


        }
    }
</script>
