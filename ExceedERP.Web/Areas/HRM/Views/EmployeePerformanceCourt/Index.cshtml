                             columns.Bound(c => c.ActionName);
                             columns.Bound(c => c.AcPercentageofWeight);
                //             .ClientFooterTemplate("AcPercentageofWeight: #=sum#").Title("Percentage of Weight")
                //.ClientGroupFooterTemplate("AcPercentageofWeight: #=sum#").Title("Percentage of Weight");  
                             columns.Bound(c => c.Result);
                //             .ClientFooterTemplate("Result: #=sum#")
                //.ClientGroupFooterTemplate("Result: #=sum#");  
                             columns.Bound(c => c.Remark);
                             columns.Command(command =>
                             {
                                 command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                //command.Destroy().Text(Resources.ActionButton_Cancel);
                             }).Width(180);
                         })
                         .ToolBar(toolbar =>
                         {
                            // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                         })
                         .Editable(editable => editable.Mode(GridEditMode.InLine))
                                  .Scrollable(h => h.Height(500))

                         .DataSource(dataSource => dataSource
                             .Ajax()
                                            .Events(events =>
 {
 events.Error("error_handler(\"PerformanceActiongrid_#=MeasurementDefinitionId#\")");
 events.RequestStart("onRequestStart(\"PerformanceActiongrid_#=MeasurementDefinitionId#\")");
events.RequestEnd("onRequestEnd(\"PerformanceActiongrid_#=MeasurementDefinitionId#\")");
 })
                                            
                             .Model(model => 
                                 {model.Id(p => p.ActionId);
                                     model.Field(p => p.ActionName).Editable(false);
                        model.Field(p => p.AcPercentageofWeight).Editable(false);

              }
              )
                                     .Read(read => read.Action("PerformanceActions_Read", "EmployeePerformance", new { defid = "#=MeasurementDefinitionId#", mesId = 0 }).Data("sendForgery"))
                                             .Create(create => create.Action("PerformanceActions_Create", "EmployeePerformance", new { defid = "#=MeasurementDefinitionId#", mesId = 0 }).Data("sendForgery"))
                                             .Update(update => update.Action("PerformanceActions_Update", "EmployeePerformance", new { defid = "#=MeasurementDefinitionId#", mesId = 0 }).Data("sendForgery"))
                                     .Destroy(destroy => destroy.Action("PerformanceActions_Destroy", "EmployeePerformance").Data("sendForgery"))
                         ).ToClientTemplate()
                    )


                </text>
                  );

          }).ToClientTemplate())
                </script>

                <script id="Action" type="text/kendo-tmpl">
                    @(Html.Kendo().TabStrip()
                          .Name("tabstrip_#MeasurementId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text(Resources.HR_PerformanceManagment_PerformanceAction_PerformanceAction).Content(
                @<text>
                  @*  <legend>Action</legend>*@
                    @(Html.Kendo().Grid<PerformanceAction>()
                                         .Name("PerformanceActiongrid_#=MeasurementId#")
                         .Columns(columns =>
                         {
                             columns.Bound(c => c.ActionName);
                             columns.Bound(c => c.AcPercentageofWeight);
                //             .ClientFooterTemplate("AcPercentageofWeight: #=sum#")
                //.ClientGroupFooterTemplate("AcPercentageofWeight: #=sum#");  
                             columns.Bound(c => c.Result);
                //             .ClientFooterTemplate("Result: #=sum#")
                //.ClientGroupFooterTemplate("Result: #=sum#");  
                             columns.Bound(c => c.Remark);
                             columns.Command(command =>
                             {
                                 command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                //command.Destroy().Text(Resources.ActionButton_Cancel);
                             }).Width(180);
                         })
                         .ToolBar(toolbar =>
                         {
                           //  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                         })
                         .Editable(editable => editable.Mode(GridEditMode.InLine))
                                  .Scrollable(h => h.Height(500))
                         .DataSource(dataSource => dataSource
                             .Ajax()
                                                .Events(events =>
         {
             events.Error("error_handler(\"PerformanceActiongrid_#=MeasurementId#\")");
             events.RequestStart("onRequestStart(\"PerformanceActiongrid_#=MeasurementId#\")");
             events.RequestEnd("onRequestEnd(\"PerformanceActiongrid_#=MeasurementId#\")");
         })
                                             
                              .Model(model => 
                                 {model.Id(p => p.ActionId);
                                     model.Field(p => p.ActionName).Editable(false);
                        model.Field(p => p.AcPercentageofWeight).Editable(false);

              }
              )
                                                                     .Read(read => read.Action("PerformanceActions_Read", "EmployeePerformance", new { defid = 0, mesid = "#=MeasurementId#" }).Data("sendForgery"))
                                                     .Create(create => create.Action("PerformanceActions_Create", "EmployeePerformance", new { defid = 0, mesid = "#=MeasurementId#" }).Data("sendForgery"))
                                             .Update(update => update.Action("PerformanceActions_Update", "EmployeePerformance", new { defid = 0, mesid = "#=MeasurementId#" }).Data("sendForgery"))
                                     .Destroy(destroy => destroy.Action("PerformanceActions_Destroy", "EmployeePerformance").Data("sendForgery"))
                         ).ToClientTemplate()
                    )


                </text>
                  );

          }).ToClientTemplate())
                </script>
        
</div> 
           
</form>
 
