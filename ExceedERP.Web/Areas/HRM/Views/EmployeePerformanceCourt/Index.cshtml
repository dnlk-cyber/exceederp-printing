                                                                  .Create(create => create.Action("MeasurementDefinitions_Create", "EmployeePerformance").Data("sendForgery"))
                                                                           .Update(update => update.Action("MeasurementDefinitions_Create", "EmployeePerformance").Data("sendForgery"))
                                 .Destroy(destroy => destroy.Action("", "").Data("sendForgery"))
                  ).ClientDetailTemplateId("template")
                )
                <script id="template" type="text/kendo-tmpl">
                    @(Html.Kendo().TabStrip()
