               // .ClientGroupFooterTemplate("MesPercentageofWeight: #=sum#").Title("Percentage of Weight");  
              columns.Bound(c => c.Result);
            //    .ClientFooterTemplate("Result: #=sum#")
            //.ClientGroupFooterTemplate("Result: #=sum#");  
              columns.Bound(c => c.Remark);
              columns.Command(command =>
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                 //command.Destroy().Text(Resources.ActionButton_Cancel);
              }).Width(180);
          })
          .ToolBar(toolbar =>
          {
             // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
                   .ClientDetailTemplateId("Action")
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
          .DataSource(dataSource => dataSource
              .Ajax()

                                .Events(events =>
                                                                                  {
                                                                                      events.Error("error_handler(\"Measurementgrid_#=MeasurementDefinitionId#\")");
                                                                                      events.RequestStart("onRequestStart(\"Measurementgrid_#=MeasurementDefinitionId#\")");
                                                                                      events.RequestEnd("onRequestEnd(\"Measurementgrid_#=MeasurementDefinitionId#\")");
                                                                                  })
                             
              .Model(model => {
                                  model.Id(p => p.MeasurementId);
                   model.Field(p => p.MeasurementName).Editable(false);
                        model.Field(p => p.MesPercentageofWeight).Editable(false);
                        model.Field(p => p.Result).Editable(false);

              }
              )
                      .Read(read => read.Action("Measurements_Read", "EmployeePerformance", new { id = "#=MeasurementDefinitionId#" }).Data("sendForgery"))
                      .Create(create => create.Action("Measurements_Create", "EmployeePerformance", new { id = "#=MeasurementDefinitionId#" }).Data("sendForgery"))
                              .Update(update => update.Action("Measurements_Update", "EmployeePerformance", new { id = "#=MeasurementDefinitionId#" }).Data("sendForgery"))
                      .Destroy(destroy => destroy.Action("Measurements_Destroy", "EmployeePerformance").Data("sendForgery"))
          ).ToClientTemplate()
                    )


                </text>


                  );
              //*************************************************************************************************//
              //**************************************Beginnings************************************************//
              items.Add().Text(Resources.HR_PerformanceManagment_PerformanceAction_PerformanceAction).Content(
