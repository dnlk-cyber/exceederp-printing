@using System.Collections
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>@Resources.NavigatorPerformance_EmployeePerformance</legend>
<form>

    <div class="row">

       </div>
    <div class="row">
        
               @(Html.Kendo().Grid<MeasurementDefinition>()
          .Name("MeasurementDefinitiongrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EvaluationCriteria);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["EvaluationTypes"], "LookupId", "Description").EditorTemplateName("EvaluationTypes");
          columns.Bound(c => c.DefnPercentageofWeight);   
          // .ClientFooterTemplate("DefnPercentageofWeight: #=sum#").HeaderTemplate("Percentage of Weight")      
           // .ClientGroupFooterTemplate("DefnPercentageofWeight: #=sum#").HeaderTemplate("Percentage of Weight");        
          columns.Bound(c => c.Result);
              //  .ClientFooterTemplate("Result: #=sum#").Title("Result")
           // .ClientGroupFooterTemplate("Result: #=sum#").Title("Result");          
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Template(@<text>
                               <div class="toolbar">
                                   <label class="category-label" for="Period">@Resources.HR_PerformanceManagment_EmployeeMeasurementDefinition_PeriodId</label>
                                   @(Html.Kendo().ComboBox()
                                    .Name("Period")
                                    .Placeholder("Period")
                                            .DataTextField("Name")
                                                    .DataSource(dataSource =>
                                  {
                                      dataSource.Read(read => read.Action("GetPeriodList", "EmployeePerformance", new { area = "HRM" }).Data("sendForgery"))
                                                            .ServerFiltering(false);
                                  })
                                                    .DataValueField("GLPeriodId")
                            .AutoBind(false)
                                            .Events(e => e.Change("Period"))
                            .HtmlAttributes(new { style = "width: 150px;" })

                                   )
                                   <label class="category-label" for="EmployeeId">@Resources.HR_PerformanceManagment_EmployeeMeasurementDefinition_PersonEmployee</label>
                                   @(Html.Kendo().ComboBox()
                                         .Placeholder("Employee..")
                                         .Name("EmployeeId")

                                         .BindTo((IEnumerable) ViewData["EmployeeList"])

                                         .DataTextField("FullName")
                                         .DataValueField("PersonId")
                                         .AutoBind(false)
                                         .Events(e => e.Change("Employee"))
                                         .HtmlAttributes(new {style = "width: 150x;"})
                            
                                         )
                                   @*<label class="category-label" for="Role">@Resources.HR_PerformanceManagment_EmployeePerformance_ResponsibilityLevel</label>
                                   @(Html.Kendo().ComboBox()
                                         .Name("Role")
                                         .Placeholder("Responsibility Level")
                                         .DataTextField("Text")
                                         .BindTo(EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.Common.ResponsibilityLevel)))
                                         .DataValueField("Value")
                                         .AutoBind(false)
                                         .Events(e => e.Change("Roles"))
                                         .HtmlAttributes(new { style = "width: 150px;" })

                                   )*@
                                   <label class="category-label" for="LookupId">@Resources.HR_PerformanceManagment_EmployeePerformance_EvaluationType</label>
                                   @(Html.Kendo().ComboBox()
                                                 .Name("LookupId")
                                         .Placeholder("Type")
                                         .DataTextField("Description")
                                         .BindTo((IEnumerable) ViewData["EvaluationTypes"])
                                         .DataValueField("LookupId")
                                         .AutoBind(false)
                                         .Events(e => e.Change("Process"))
                                         .HtmlAttributes(new {style = "width: 150px;"})

                                         )
                                  




                               </div>
        </text>);
      })
              .Editable(editable => editable.Mode(GridEditMode.InLine))
                   .Scrollable(h => h.Height(500))
                         .Groupable()
                                  .Sortable(sortable =>
                                  {
                                      sortable.SortMode(GridSortMode.SingleColumn);
                                  })
                      .Filterable()
                         .Pageable(pageable => pageable
                                                    .Input(true)
                                                    .Numeric(false)
                                                    .Refresh(true)
                                                    .PageSizes(true)
                                                    .ButtonCount(5))
              .DataSource(dataSource => dataSource
                  .Ajax()
                                               .Events(events =>
                                                                          {
                                                                              events.Error("error_handler(\"MeasurementDefinitiongrid\")");
                                                                              events.RequestStart("onRequestStart(\"MeasurementDefinitiongrid\")");
                                                                              events.RequestEnd("onRequestEnd(\"MeasurementDefinitiongrid\")");
                                                                          })
                                                                              
                  .Model(model =>
                  {
                      model.Id(p => p.MeasurementDefinitionId);
                       model.Field(p => p.EvaluationCriteria).Editable(false);
                        model.Field(p => p.LookupId).Editable(false);
                        model.Field(p => p.Result).Editable(false);
                                model.Field(p => p. DefnPercentageofWeight).Editable(false);
