<script>
    function Process() {


        var value = this.value(),
            grid = $("#MeasurementDefinitiongrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "LookupId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>

<script>
    function Roles() {


        var value = this.value(),
            grid = $("#MeasurementDefinitiongrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "Role", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>

<script>
    function Period() {


        var periods = $("#Period").data("kendoComboBox");
        var period = periods.value();
        // $("#EvaluationType").val(0);
        $.ajax({
            url: '@Url.Action("GetPeriod", "EmployeePerformance")',
            //contentType: "application/json; charset=utf-8",
            data: { period: period },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

            }

        });

    }
</script>

<script>
    function Employee() {
        var employees = $("#EmployeeId").data("kendoComboBox");
        var employee = employees.value();
       // $("#EvaluationType").val(0);
        $.ajax({
            url: '@Url.Action("GetEmployee", "EmployeePerformance")',
            //contentType: "application/json; charset=utf-8",
            data: { employee: employee },
            type: 'POST',
            cache: false,
            success: function(result) {
                r = result;
               
            }

        });

      
        var value = this.value(),
               grid = $("#MeasurementDefinitiongrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "EmployeeId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>

