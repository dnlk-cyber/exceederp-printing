@using System.Collections
@using ExceedERP.Web.Areas.HRM.Controllers
@using ExceedERP.Web.Areas.HRM.Controllers.Company
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.TrainingEducation.NeedAssessment
@using ExceedERP.Core.Localization
@{
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? true;

}
<form>

    <div class="row">
        <div class="col-md-1">

        </div>

        <div class="col-md-3">
            <div class="form-group">
                <div>@Html.LabelFor(model => model.Role, htmlAttributes: new { @class = "control-label col-md-8" })</div>

                @(Html.Kendo().AutoCompleteFor(m => m.Role)
                             .DataTextField("Name")
                             .Filter("contains")
                             .Placeholder("Select Responsibility Levels")
                             .Separator(", ")
                             .BindTo(
                                 Enum.GetValues(typeof(ExceedERP.Core.Domain.Common.ResponsibilityLevel))
                                     .Cast<ExceedERP.Core.Domain.Common.ResponsibilityLevel>()
                                     .Select(x => new
                                     {
                                         Name = x.ToString() // or GetDisplayName(x)

                                     })
                             )
                )
                @Html.ValidationMessageFor(model => model.Role, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="col-md-3 mass-assessment-single-branch">
            <div>@Html.LabelFor(model => model.BranchId, htmlAttributes: new { @class = "control-label col-md-8" })</div>

            @(Html.Kendo().DropDownListFor(model => model.BranchId)
                                        .OptionLabel(Resources.Select)
                                        .DataTextField("Name")
                                        .DataValueField("BranchId")
                                        .Filter("contains")
                                        .DataSource(dataSource =>
                                        {
                                            dataSource.Read(read => read.Action("GetBranch", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery"))
                                                .ServerFiltering(false);
                                        })

            )
            @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger" })

        </div>
        <div class="col-md-3 mass-assessment-multiple-branches" hidden>
            <div>@Html.LabelFor(model => model.SelectedBranchIds, "Branches", new { @class = "control-label col-md-8" })</div>
            @(Html.Kendo().MultiSelectFor(model => model.SelectedBranchIds)
                .Placeholder("Select branches")
                .DataTextField("Name")
                .DataValueField("BranchId")
                .Filter(FilterType.Contains)
                .AutoClose(false)
                .ValuePrimitive(true)
                .DataSource(dataSource => dataSource.Read(read => read
                    .Action("GetBranch", "HRMDataProvider", new { area = "HRM" })
                    .Data("sendForgery"))))
            <small>Each selected branch gets its own assessment. If no role is selected, the staff count applies to each branch.</small>
        </div>
        @*<div class="col-md-3">


            <div>@Html.LabelFor(model => model.RequiredTraining, htmlAttributes: new { @class = "control-label col-md-8" })</div>

            @(Html.Kendo().DropDownListFor(model => model.RequiredTraining)
                                                     .OptionLabel(Resources.Select)
                                                     .DataTextField("Description")
                                                     .DataValueField("LookupId")
                                                     .Filter("contains")
                                                     .DataSource(dataSource =>
                                                     {
                                                         dataSource.Read(read => read.Action("GetTargetGroup", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery"))
                                                             .ServerFiltering(false);
                                                     })

            )
            @Html.ValidationMessageFor(model => model.RequiredTraining, "", new { @class = "text-danger" })

        </div>*@

        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.LookupId, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">
                @(Html.Kendo().DropDownListFor(model => model.LookupId)
                                                             .ValuePrimitive(true)
                                                              .OptionLabel(Resources.Select)
                                                              .DataTextField("Description")
                                                              .DataValueField("LookupId")
                                                               .Filter("contains")
                                                              .DataSource(dataSource =>
                                                              {
                                                                  dataSource.Read(read => read.Action("GetCourseList", "HRMDataProvider").Data("sendForgery"));
                                                                  // .ServerFiltering(true);
                                                              }))
                @Html.ValidationMessageFor(model => model.LookupId, "", new { @class = "text-danger" })
            </div>
        </div>
       

    </div>

    <br />


    <div class="row">
        <div class="col-md-1">

        </div>

        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Type, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @(Html.Kendo().DropDownListFor(model => model.Type)
                                             .ValuePrimitive(true)
                                                      .OptionLabel(Resources.Select)
                                                       .Filter("contains")
                                                      .DataTextField("Description")
                                                      .DataValueField("LookupId")
                                              .DataSource(dataSource =>
                                              {
                                                  dataSource.Read(read => read.Action("GetTrainingTypeList", "HRMDataProvider").Data("sendForgery"));
                                              //.ServerFiltering(true);
                                          }))
            </div>

        </div>


        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>

                    @Html.Kendo().TextBoxFor(model => model.Description)
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.MainCompanyId, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @(Html.Kendo().DropDownListFor(model => model.MainCompanyId)
                                             .ValuePrimitive(true)
                                              .OptionLabel(Resources.Select)
                                               .Filter("contains")
                                                      .DataTextField("TradeName")
                                                      .DataValueField("MainCompanyId")
                                              .DataSource(dataSource =>
                                              {
                                                  dataSource.Read(read => read.Action("GetTrainingProvider", "HRMDataProvider").Data("sendForgery"));
                                              //   .ServerFiltering(true);
                                          }))
            </div>
        </div>
    </div>






    <br />
    <div class="row">
        <div class="col-md-1">

        </div>


        <div class="col-md-3">
            <div class="form-group">
                <div>@Html.LabelFor(model => model.GlFiscalYearId, htmlAttributes: new { @class = "control-label col-md-8" })</div>

                @(Html.Kendo().DropDownListFor(model => model.GlFiscalYearId)
                                  .OptionLabel(Resources.Select)
                                   .Filter("contains")
                                  .DataTextField("Name")
                                  .DataValueField("GlFiscalYearId")
                                  .DataSource(dataSource =>
                                  {
                                      dataSource.Read(read => read.Action("GetFisicalYear", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery"))
                                          .ServerFiltering(false);
                                  })

                )
                @Html.ValidationMessageFor(model => model.GlFiscalYearId, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.DevelopmentRequired, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.DevelopmentRequired)
                @Html.ValidationMessageFor(model => model.DevelopmentRequired, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.DevelopmentBy, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.DevelopmentBy)
                @Html.ValidationMessageFor(model => model.DevelopmentBy, "", new { @class = "text-danger" })
            </div>
        </div>






    </div>
    <br />
    <div class="row">
        <div class="col-md-1">

        </div>

        @*<div class="col-md-3">
                @Html.LabelFor(model => model.BusinessUnitId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="form-group">
                    @(Html.Kendo().DropDownListFor(m => m.BusinessUnitId)
                                        .ValuePrimitive(true)
                                        // .AutoBind(false)
                                        .OptionLabel("Select Business Unit...")
                                        .DataTextField("Name")
                                        .DataValueField("Code")
                                        .HtmlAttributes(new { style = "width:240px" })
                                        .Filter("contains")
                                        .DataSource(dataSource =>
                                        {
                                            dataSource.Read(read => read.Action("GetAllBusinessUnits", "GlobalDataProvider", new { area = "Common" }).Data("sendForgery"))
                                                                    .ServerFiltering(false);
                                        })
                    )
                    @Html.ValidationMessageFor(model => model.BusinessUnitId, "", new { @class = "text-danger" })
                </div>
            </div>*@

        @if (useEthiopian)
        {
            <div class="col-md-3">
                <div>
                    @Html.LabelFor(model => model.FromAmharic, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>

                <div class="form-group">

                    @Html.TextBoxFor(model => model.FromAmharic, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />

                    @Html.ValidationMessageFor(model => model.FromAmharic, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-3">
                <div>
                    @Html.LabelFor(model => model.ToAmharic, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>

                <div class="form-group">

                    @Html.TextBoxFor(model => model.ToAmharic, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />

                    @Html.ValidationMessageFor(model => model.ToAmharic, "", new { @class = "text-danger" })

                </div>
            </div>


        }
        else
        {
            <div class="col-md-3">
                <div>
                    @Html.LabelFor(model => model.From, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div class="form-group">

                    @Html.Kendo().DatePickerFor(model => model.From)
                    @Html.ValidationMessageFor(model => model.From, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-3">
                <div>
                    @Html.LabelFor(model => model.To, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div class="form-group">
                    @Html.Kendo().DatePickerFor(model => model.To)
                    @Html.ValidationMessageFor(model => model.To, "", new { @class = "text-danger" })
                </div>
            </div>

        }

        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div class="form-group">

                @Html.TextAreaFor(model => model.Remark)
                @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.NoOfStaff, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.NoOfStaff)
                @Html.ValidationMessageFor(model => model.NoOfStaff, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.TotalDays, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().NumericTextBoxFor(model => model.TotalDays).Min(0)
                @Html.ValidationMessageFor(model => model.TotalDays, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
</form>
