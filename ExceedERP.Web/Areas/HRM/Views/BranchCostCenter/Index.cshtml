    function change(e) {
       
        var id = e.model.Name;
        var key=e.model.OrgStructureId
        var dropdown = $("#dropdown").data("kendoDropDownList");
        var $dropdownRootElem = $(dropdown.element).closest("span.k-dropdown");
        $dropdownRootElem.find("span.k-input").text(id);
        $dropdownRootElem.find("span.k-input").val(key);
        $("#OrgStructureId").val(key);
        $("#OrgStructureId").trigger ("change");
      
    }
    function sync_handler(e) {
        this.read();

    }
</script>
