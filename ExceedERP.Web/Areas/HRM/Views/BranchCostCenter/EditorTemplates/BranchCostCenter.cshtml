@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Helpers.Common
@using ExceedERP.Web.Areas.HRM.Controllers
@using ExceedERP.Web.Areas.HRM.Controllers.Company
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.Company.BranchCostCenter 

<form style="overflow:scroll;height :auto ;">

    <div class="row">

        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.OrgStructureId)
                @Html.HiddenFor(model => model.OrgStructureId)
            </div>
            <div class="form-group">
                @{
                    var getlist = ViewBag.Tree as IEnumerable<NodeViewModel>;

                    <ul id="treeview">
                        @if (getlist != null)
                        {
                            foreach (var item in getlist)
                            {
                                if (@item.Children.Count > 0)
                                {
                                    <li data-expanded="false">

                                        @item.Title
                                        @if (@item.Children.Count > 0)
                                        {
                                            <ul>
                                                @foreach (var chiled in @item.Children)
                                                {


                                                    <li data-expanded="false">
                                                        @chiled.Title
                                                        @if (@chiled.Children.Count > 0)
                                                        {
                                                            <ul>
                                                                @foreach (var chi in @chiled.Children)
                                                                {


                                                                    <li data-expanded="false">
                                                                        @chi.Title
                                                                        @if (@chi.Children.Count > 0)
                                                                        {
                                                                            <ul>
                                                                                @foreach (var ch in @chi.Children)
                                                                                {

                                                                                    <li data-expanded="false">@*cost*@
                                                                                        @ch.Title
                                                                                        @if (@ch.Children.Count > 0)
                                                                                        {
                                                                                            <ul>
                                                                                                @foreach (var c in @ch.Children)
                                                                                                {

                                                                                                    <li data-expanded="false">
                                                                                                        @c.Title

                                                                                                        @if (@c.Children.Count > 0)
                                                                                                        {
                                                                                                            <ul>
                                                                                                                @foreach (var cc in @c.Children)
                                                                                                                {
                                                                                                                    <li data-expanded="false">
                                                                                                                        @cc.Title
                                                                                                                        @if (@cc.Children.Count > 0)
                                                                                                                        {
                                                                                                                            <ul>
                                                                                                                                @foreach (var k in @cc.Children)
                                                                                                                                {
                                                                                                                                    <li data-expanded="false">
                                                                                                                                        @k.Title
                                                                                                                                        @if (@k.Children.Count > 0)
                                                                                                                                        {
                                                                                                                                            <ul>
                                                                                                                                                @foreach (var p in @k.Children)
                                                                                                                                                {
                                                                                                                                                    <li data-expanded="false">
                                                                                                                                                        @p.Title
                                                                                                                                                    </li>
                                                                                                                                                }
                                                                                                                                            </ul>
                                                                                                                                        }
                                                                                                                                    </li>
                                                                                                                                }
                                                                                                                            </ul>
                                                                                                                        }
                                                                                                                    </li>
                                                                                                                }
                                                                                                            </ul>
                                                                                                        }
                                                                                                    </li>
                                                                                                }
                                                                                            </ul>
                                                                                        }
                                                                                    </li>

                                                                                }

                                                                            </ul>
                                                                        }

                                                                    </li>

                                                                }
                                                            </ul>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                                else
                                {
                                    <li>@item.Title</li>
                                }
                            }
                        }
                    </ul>

                }
                <div>
                    <input id="dropdown" style=" width :300px" >

                </div>
            </div>
        </div>



    </div>
    <br />
    <div class="row">
        <div class="col-md-1">
        </div>
     
        <div class="col-md-3">

            <div class="form-group">
            </div>
        </div>

        <div class="col-md-3">

            <div class="form-group">
                <div>@Html.LabelFor(model => model.BranchId, htmlAttributes: new { @class = "control-label col-md-8" })</div>

                @(Html.Kendo().DropDownListFor(m => m.BranchId)
                                     .DataTextField("Name")
                      .OptionLabel(Resources.Select)
                                                     .DataValueField("BranchId")
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetBranches", "HRMDataProvider", new { area = "HRM" }))
                              .ServerFiltering(false);

                      })
                      .ValuePrimitive(true)
                      )

                                 

                
                @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger" })
            </div>

        </div>
        <div class="col-md-3">

            <div class="form-group">
                <div>@Html.LabelFor(model => model.Values, htmlAttributes: new { @class = "control-label col-md-8" })</div>

                @(Html.Kendo().DropDownListFor(m => m.Values)
                      .OptionLabel(Resources.Select)
                      .Filter("containes")
                             .DataTextField("Description")
                                     .CascadeFrom("BranchId")
                                              .DataSource(source =>
                                                {
                                                    source.Read(read =>
                                                    {
                                                        read.Action("GetCostCenter", "HRMDataProvider")
                                                        .Data("filterCategories");
                                                    })
                                                    .ServerFiltering(true);
                                                })
                                                          .DataValueField("Values")
                                        //.BindTo((IEnumerable)ViewData["costCenter"])

                                  .ValuePrimitive(true)

                )
                @Html.ValidationMessageFor(model => model.Values, "", new { @class = "text-danger" })
            </div>

        </div>


    </div>
    <br />



    <div class="row">
        <div class="col-md-1">
        </div>

        <div class="col-md-3">

            <div class="form-group">
            </div>
        </div>

        <div class="col-md-3">

            <div class="form-group">
            </div>
        </div>
        <div class="col-md-3">

            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @Html.TextAreaFor(model => model.Remark)
                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>

        </div>

        
    </div>
    


</form>

<script type="text/javascript">
    $(document).ready(function () {
        var dropdown = $("#dropdown").kendoDropDownList({
            dataSource: [{ text: "", value: "" }],
            dataTextField: "text",
            dataValueField: "value",
            open: function (e) {

                if (!$treeviewRootElem.hasClass("k-custom-visible")) {
                    $treeviewRootElem.slideToggle('fast', function () {
                        dropdown.close();
                        $treeviewRootElem.addClass("k-custom-visible");
                    });
                }
            }

        }).data("kendoDropDownList");
        var $dropdownRootElem = $(dropdown.element).closest("span.k-dropdown");

        var treeview = $("#treeview").kendoTreeView({
            select: function (e) {

                $dropdownRootElem.find("span.k-input").text($(e.node).children("div").text());
                $treeviewRootElem.slideToggle('fast', function () {
                    $treeviewRootElem.removeClass("k-custom-visible");
                });
                var val = $(e.node).children("div").text();
                $.ajax({
                    url: '@Url.Action("GetJobCode", "BranchCostCenter")',
                    contentType: "application/json; charset=utf-8",
                    data: { 'jobName': val },
                    type: 'GET',
                    cache: false,
                    success: function (result) {
                        r = result;

                      $("#OrgStructureId").val(r).trigger ("change");
                    
                        $("#LookupId").kendoDropDownList({
                            
                            dataTextField: "Description",
                            dataValueField: "LookupId",
                           MinLength:2,
                            dataSource: {
                                type: "json",
                                transport: {
                                    read: {url: '@Url.Action("GetJobTitle", "BranchCostCenter")',
                                        type: "GET",
                                        dataType: "json",
                                        contentType: "application/json; charset=utf-8"
                                    }
                                }
                            }
                        });

                    }
                });

            }
        }).data("kendoTreeView");
        var $treeviewRootElem = $(treeview.element).closest("div.k-treeview");


        $treeviewRootElem
            .width($dropdownRootElem.width())
            .css({ "border": "1px solid grey", "display": "none", "position": "absolute" });


        $treeviewRootElem
            .css({ "top": $dropdownRootElem.position().top + $dropdownRootElem.height(), "left": $dropdownRootElem.position().left });

        $(document).click(function (e) {

            if ($(e.target).closest("div.k-treeview").length == 0) {

                if ($treeviewRootElem.hasClass("k-custom-visible")) {
                    $treeviewRootElem.slideToggle('fast', function () {
                        $treeviewRootElem.removeClass("k-custom-visible");
                    });
                }
            }
        });
    });

</script>



<style>
    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>

<style>
    .dropdown-header {
        border-width: 0 0 1px 0;
        text-transform: uppercase;
    }

        .dropdown-header > span {
            display: inline-block;
            padding: 10px;
        }

            .dropdown-header > span:first-child {
                width: 50px;
            }

    #customers-list .k-item {
        line-height: 1em;
        min-width: 300px;
    }

    /* Material Theme padding adjustment*/

    .k-material #customers-list .k-item,
    .k-material #customers-list .k-item.k-state-hover,
    .k-materialblack #customers-list .k-item,
    .k-materialblack #customers-list .k-item.k-state-hover {
        padding-left: 5px;
        border-left: 0;
    }

    #customers-list .k-item > span {
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        box-sizing: border-box;
        display: inline-block;
        vertical-align: top;
        margin: 20px 10px 10px 5px;
    }

        #customers-list .k-item > span:first-child {
            -moz-box-shadow: inset 0 0 30px rgba(0, 0, 0, .3);
            -webkit-box-shadow: inset 0 0 30px rgba(0, 0, 0, .3);
            box-shadow: inset 0 0 30px rgba(0, 0, 0, .3);
            margin: 10px;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background-size: 100%;
            background-repeat: no-repeat;
        }

    #customers-list h3 {
        font-size: 1.2em;
        font-weight: normal;
        margin: 0 0 1px 0;
        padding: 0;
    }

    #customers-list p {
        margin: 0;
        padding: 0;
        font-size: .8em;
    }
</style>
