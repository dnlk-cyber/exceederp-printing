<script>

    var isNew_Global = "";
    function onDepartmentDataBound() {
        if (isNew_Global === "True") {

            $("#FullNameTextBox_Id").hide();
            $("#EmpIdDropdown_Id").show();
        }
        else if (isNew_Global === "False"){
            $("#FullNameTextBox_Id").show();
            $("#EmpIdDropdown_Id").hide();
        }
    }
     function filterEmployees() {
            return {
                text: $("#EmployeeId").data("kendoDropDownList").filterInput.val(),
            }
    }

     function filterDepartment() {
         return {
             branchId: $("#BranchId").val(),
             businessUnitId: $("#BusinessUnitId").val(),
             searchText: $("#OrgStructureId").data("kendoDropDownList").filterInput.val(),
         };
     }


    function GetDate(e) {

        $("#AssignmentDateAmharic").trigger("change");

        if (e.model.isNew() === false) {
            $("#EmployeeId").kendoDropDownList({
                enable: false
            });

            isNew_Global = "False";
        }
        else {
            isNew_Global = "True";
        }
    }

    function GetEmployeeNameEmploye(e) {
        var autocomplete = $("#EmployeeId").data("kendoAutoComplete");
        var id = autocomplete.value();

        $.ajax({
            url: '@Url.Action("SetEmployeeId", "EmployeePlacmentWithJ")',
            contentType: "application/json; charset=utf-8",
            data: { 'fullName': id },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
            }

        });
    }
</script>

<script>
    function DeActivatePlacements() {

        var branch = $("#Project_BranchId").data("kendoDropDownList");
        var branchId = branch.value();

        $('#loading-image').hide();

            $.ajax({
            url: '@Url.Action("DeActivateEmployeesByBranch", "EmployeePlacmentWithJ")',
            contentType: "application/json; charset=utf-8",
            data: { branchId: branchId },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;

                alert(r.Message);
                $('#loading-image').hide();

            }

        });
    }
</script>

<script>
    function GetSalary() {
      if (isNew_Global == "True")
      {
        $("#Salary").val(0);
        var rank = $("#RankId").data("kendoDropDownList").value();
        var step = $("#StepId").data("kendoDropDownList").value();
        var job = $("#LookupId").data("kendoDropDownList").value();

        if (rank.length !== 0 && step.length !== 0) {
            if (rank == "") {
                rank = 0;
            }
            if (step == "") {
                step = 0;
            }
            if (job == "") {
                job = 0;
            }
            $.ajax({
                url: '@Url.Action("GetSalaryAmount", "EmployeePlacmentManual")',
                data: { rank: rank, step: step, job: job },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    $("#Salary").val(r);
                    $("#Salary").trigger("change");
                }

            });
        }
        }
    }

</script>

