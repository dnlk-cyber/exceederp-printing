        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("UnPend", "EmployeePlacmentWithJ")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);
                    $('#loading-image').hide();
                    grid.dataSource.read();
                }
            });

        }

    }

     ////////////////////////////////

    function ApprovePlacement(e) {

     var row = $(e.target).closest("tr");
        var grid = $("#PlacementGrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.PlacementId;

        if (id.length !== 0 )
