     function updateEmployeeAge(element) {
        var $button = $(element);
        var $icon = $button.find('i');
        var originalIcon = $icon.attr('class');

        // Show loading spinner
        $icon.attr('class', 'fa fa-spinner fa-spin');
        $button.prop('disabled', true);
        $('#loading-image').show();
        $.ajax({
            url: '@Url.Action("UpdateEmployeeAge", "EmployeePlacmentWithOJ")',
            type: 'POST',
            dataType: 'json',
            success: function (response) {
                alert(response.message);
                $('#loading-image').hide();
                $button.prop('disabled', false);
            },
            error: function (xhr, status, error) {
                alert('An error occurred while updating age. Please try again.');
                $('#loading-image').hide();
                $button.prop('disabled', false);
            },
            complete: function () {
                // Restore original button state
                $icon.attr('class', originalIcon);
                $button.prop('disabled', false);
            }
        });
    }

    function updateEmployeeSalary(element)
    {
        var $button = $(element);
        var $icon = $button.find('i');
        var originalIcon = $icon.attr('class');

        if (!confirm("Are you sure you want to refresh salary?")) {
            return;
        }

        // Spinner ON
        $icon.attr('class', 'fa fa-spinner fa-spin');
        $button.prop('disabled', true);
        $('#loading-image').show();
        $.ajax({
            url: '@Url.Action("UpdateEmployeeSalary", "EmployeePlacmentWithOJ")',
            type: 'POST',
            dataType: 'json',
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (response) {
                alert(response.Message);
            },
            error: function (xhr) {
                console.log(xhr.responseText); // <=== will show anti-forgery error message
                alert('An error occurred while refreshing salary. Please try again.');
            },
            complete: function () {
                $('#loading-image').hide();
                $icon.attr('class', originalIcon);
                $button.prop('disabled', false);
            }
        });
    }


    function autoCompleteHeadOnChange()
    {
        var employeeId = $("#EmployeeId").data("kendoDropDownList").value();
        var branchId = $("#BranchId").data("kendoDropDownList").value();
        var orgId = $("#OrgStructureId").data("kendoDropDownList").value();
        var businessId = $("#BusinessUnitId").data("kendoDropDownList").value();

        if (employeeId && orgId && branchId && businessId) {
            $.ajax({
                url: '@Url.Action("AutoCompleteHead", "EmployeePlacmentManual")',
                type: 'GET',
                data: {
                    employeeId: employeeId,
                    orgId: orgId,
                    branId: branchId,
                    businUinitId: businessId
                },
                success: function (result) {
                    var headDropDown = $("#HeadId").data("kendoDropDownList");

                    if (result && result.headId) {
                        headDropDown.value(result.headId);
                        headDropDown.text(result.fullName);
                    } else {
                        headDropDown.value("");
                        headDropDown.text("");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching head info:", error);
                }
            });

        }

    }
</script>