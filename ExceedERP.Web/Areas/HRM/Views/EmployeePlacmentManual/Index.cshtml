            .Create(create => create.Action("Placements_Create", "EmployeePlacmentManual").Data("sendForgery"))
            .Update(update => update.Action("Placements_Update", "EmployeePlacmentManual").Data("sendForgery"))
            .Destroy(destroy => destroy.Action("Placements_Destroy", "EmployeePlacmentManual").Data("sendForgery"))
            ).ClientDetailTemplateId("template")

