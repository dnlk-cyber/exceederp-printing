    .Pdf(pdf => pdf
        .AllPages()
        .FileName(Resources.NavigatorPlacment_EmployeePlacment + ".pdf")
        .ProxyURL(Url.Action("Pdf_Export_Save", "EmployeePlacmentWithJ"))
