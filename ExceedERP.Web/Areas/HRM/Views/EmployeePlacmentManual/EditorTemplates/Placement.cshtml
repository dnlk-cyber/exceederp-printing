@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Helpers.Common
@using ExceedERP.Web.Areas.HRM.Controllers
@using ExceedERP.Web.Areas.HRM.Controllers.Company
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.EmployeeDetail.Placement

<div class="form">

    <div class="row fullrow">
        <div class="col-md-4 ro1">   
            
            <div class="form-group">              

                @Html.LabelFor(model => model.EmployeeId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                  
                    @*<input type="text" value="@Model.FullName" id="FullName" name="FullName" class="form-control input-sm"/>*@
                   
                    <div id="FullNameTextBox_Id" hidden>
                        @(Html.Kendo().TextBoxFor(model => model.FullName).HtmlAttributes(new { style = "width:200px;color:red;",@readonly="readonly" }))
                    </div>

                    <div id="EmpIdDropdown_Id" hidden>
                        @(Html.Kendo().DropDownListFor(model => model.EmployeeId)
                              //  .Name("EmployeeId")
                              .DataValueField("EmployeeId")
                              .DataTextField("FullNameaEnglish")
                              .OptionLabel(Resources.Select)
                              .Filter("contains")
                              // .MinLength(2)
                              .HtmlAttributes(new { style = "width:240px" })

                               .DataSource(source =>
                               {
                                   //source.Read(read => read.Action("GetAllEmployeesForPlacement", "HRMDataProvider"));
                                   source.Read(read => read.Action("GetAllEmployeesForPlacement", "HRMDataProvider", new { area = "HRM" }).Data("filterEmployees"))
                                  .ServerFiltering(true);
                               })
                              .ValuePrimitive(true)
                        )
                    </div>
                        
                   
                </div>

                @*<div class="col-md-6">

                    @(Html.Kendo().DropDownListFor(model => model.EmployeeId)
                              //  .Name("EmployeeId")
                              .DataValueField("PersonId")
                              .DataTextField("FullName")
                              .OptionLabel(Resources.Select)
                              .Filter("contains")
                              // .MinLength(2)
                              .HtmlAttributes(new { style = "width:240px" })
                              // .Virtual(v => v.ValueMapper("valueMapper").ItemHeight(33))
