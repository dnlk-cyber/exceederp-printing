                                              .Total("Total");
                                      });

                              })
                              //  .Events(events => events.Edit("onEdit"))

                              .ValuePrimitive(true)


                              .Height(400)
                              .HeaderTemplate("<div class=\"dropdown-header k-widget k-header\">" +
                                              "<span>Photo</span>" +
                                              "<span>Full Name</span>" +
                                              "</div>")
                              .Template(@"<div class='Employee-photo' style='background-image: url(" + Url.Content("~/Content/Images/") + "#:data.PersonId#-Photo/" + "#:data.PersonId#.jpg" + ");'></div>" +
                                        "<div class='Employee-name'>#:FullName#</div>")
                    )



                </div>*@


            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.OrgStructureId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.OrgStructureId)
                        .Filter("contains")
                        .OptionLabel(Resources.Select)
                        .MinLength(2)
                        .DataTextField("Name")
                        .DataValueField("OrgStructureId")
                        .HtmlAttributes(new { style = "width:240px" })
                        .ValuePrimitive(true)
                        .Events(ev=>
                        {
                            ev.DataBound("onDepartmentDataBound");
                        })
                        .DataSource(source =>
                        {
                            source.Read(read => read.Action("GetDepartmentsForPlacement", "HRMDataProvider"));
                        })
                    // .BindTo((IEnumerable)ViewData["organization"])


                    )
                    @Html.ValidationMessageFor(model => model.OrgStructureId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.LookupId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(m => m.LookupId)
                                  .DataTextField("Description")
                                  .DataValueField("LookupId")
                                  .Filter("contains")
                                  .OptionLabel(Resources.Select)
                                  .HtmlAttributes(new { style = "width:240px" })
                                  .MinLength(2)
                                   .Events(e => e.Change("GetSalary"))
                                  .DataSource(source =>
                                  {
                                      source.Read(read =>
                                      {
                                          read.Action("GetJobTitles", "HRMDataProvider")
                                              .Data("filterCategories");
                                      })
                                          .ServerFiltering(true);
                                  })
                                 // .Events(e => e.Change("GetSalary"))
                                  .CascadeFrom("OrgStructureId")
                                  .AutoBind(false)
                                  .Enable(false)
                    )
                    @Html.ValidationMessageFor(model => model.LookupId, "", new { @class = "text-danger" })
                </div>

            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ReportsTo, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(m => m.ReportsTo)
                                  .DataTextField("Name")
                                  .DataValueField("OrgStructureId")
                                  .OptionLabel(Resources.Select)
                                  .HtmlAttributes(new { style = "width:240px" })
                                  .Filter("contains")
                                  .ValuePrimitive(true)
                                  .DataSource(dataSource =>
                                  {
                                          //dataSource.Read(read => read.Action("GetSelectedDepartments", "HRMDataProvider", new { area = "HRM" })); Changed
                                          dataSource.Read(read => read.Action("GetDepartmentsForPlacement", "HRMDataProvider"));
                                          //.ServerFiltering(false);
                                      })

                    )
                    @Html.ValidationMessageFor(model => model.ReportsTo, "", new { @class = "text-danger" })
                </div>

            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.BusinessUnitId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.BusinessUnitId)

                                  .Filter("contains")
                                  .OptionLabel(Resources.Select)
                                  .MinLength(2)
                                  .ValuePrimitive(true)
                                  .AutoBind(false)
                                  .OptionLabel("Select Business Unit...")
                                  .DataTextField("Name")
                                  .DataValueField("Code")
                                  .Filter("contains")
                                  .HtmlAttributes(new { style = "width:240px" })
                                  .DataSource(dataSource =>
                                  {
                                      dataSource.Read(read => read.Action("GetAllBusinessUnits", "HRMDataProvider", new { area = "HRM" }))
                                                            .ServerFiltering(false);
                                  })


                    )
                    @Html.ValidationMessageFor(model => model.BusinessUnitId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
        </div>

        <div class="col-md-4 ro1">

            <div class="form-group">

                @Html.LabelFor(model => model.ResponsibilityLevel, htmlAttributes: new { @class = "control-label col-md-8" })

                <div class="col-md-6">
                    @(Html.EnumDropDownListFor(model => model.ResponsibilityLevel, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 180px" })
                    )

                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.AssignmentType, htmlAttributes: new { @class = "control-label col-md-8" })

                <div class="col-md-6">

                    @(Html.EnumDropDownListFor(model => model.AssignmentType, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 180px" ,})
                    )

                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.BranchId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(m => m.BranchId)
                          .DataTextField("Name")
                          .HtmlAttributes(new { style = "width:200px" })
                          .DataValueField("BranchId")
                          .Filter("contains")
                          .OptionLabel(Resources.Select)
                          .ValuePrimitive(true)
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetAllBranch", "HRMDataProvider", new { area = "HRM" }))
                                  .ServerFiltering(false);
                          })
                    )
                    @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger" })
                </div>

            </div>
            <div class="form-group">

                @Html.LabelFor(model => model.AssignmentDateAmharic, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.AssignmentDateAmharic, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />
                    @Html.ValidationMessageFor(model => model.AssignmentDateAmharic, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.EmployementType, htmlAttributes: new { @class = "control-label col-md-8" })
                    @(Html.EnumDropDownListFor(model => model.EmployementType, htmlAttributes: new { disabled = "disabled", @class = "k-dropdown-wrap k-state-default", @style = "width: 140px"})
                    )

                </div>
            </div>
          
            <div class="row"></div>
        </div>

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.RankId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">

                    @(Html.Kendo().DropDownListFor(model => model.RankId)
                                          .ValuePrimitive(true)
                                          .OptionLabel(Resources.Select)
                                          .HtmlAttributes(new { style = "width:200px" })
                                          .DataTextField("RankName")
                                          .DataValueField("RankId")
                                          // .CascadeFrom("JobTitleCode")
                                          //.Enable(false)
                                          .Events(e => e.Change("GetSalary"))
                                          .DataSource(dataSource =>
                                          {
                                              dataSource.Read(read => read.Action("GetRank", "HRMDataProvider"));

                                          }))
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">


                @Html.LabelFor(model => model.StepId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.StepId)
                                          .ValuePrimitive(true)
                                          .OptionLabel(Resources.Select)
                                          .DataTextField("StepName")
                                          .HtmlAttributes(new { style = "width:200px" })
                                          .OptionLabel("Select Step")
                                          .DataValueField("StepId")
                                          // .CascadeFrom("JobTitleCode")
                                          // .Enable (false)
                                          .Events(e => e.Change("GetSalary"))
                                          .DataSource(dataSource =>
                                          {
                                              dataSource.Read(read => read.Action("GetStep", "HRMDataProvider"));


                                          }))

                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.Salary, htmlAttributes: new { @class = "control-label col-md-8" })

                <div class="col-md-6">
                    @(Html.Kendo().TextBoxFor(model => model.Salary)
                                          .HtmlAttributes(new { style = "width:200px" }))
                    @Html.ValidationMessageFor(model => model.Salary, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <br />
            <br />
            <div class="form-group">
                <div class="col-md-6">
                    @Html.Kendo().CheckBoxFor(model => model.IsHead)
                    @Html.ValidationMessageFor(model => model.IsHead, "", new { @class = "text-danger" })

                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                <div class="col-md-6">
                    @Html.Kendo().CheckBoxFor(model => model.isCurrent).Enable(false)
                    @Html.ValidationMessageFor(model => model.isCurrent, "", new { @class = "text-danger" })

                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })

                <div class="col-md-6">
                    @(Html.Kendo().TextBoxFor(model => model.Remark)
                                          .HtmlAttributes(new { style = "width:200px" })
                                          )
                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

       


    </div>

</div>

<style>
    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>

<style>
    .dropdown-header {
        border-width: 0 0 1px 0;
        text-transform: uppercase;
    }

        .dropdown-header > span {
            display: inline-block;
            padding: 10px;
        }

            .dropdown-header > span:first-child {
                width: 50px;
            }

    #customers-list .k-item {
        line-height: 1em;
        min-width: 300px;
    }

    /* Material Theme padding adjustment*/

    .k-material #customers-list .k-item,
    .k-material #customers-list .k-item.k-state-hover,
    .k-materialblack #customers-list .k-item,
    .k-materialblack #customers-list .k-item.k-state-hover {
        padding-left: 5px;
        border-left: 0;
    }

    #customers-list .k-item > span {
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        box-sizing: border-box;
        display: inline-block;
        vertical-align: top;
        margin: 20px 10px 10px 5px;
    }

        #customers-list .k-item > span:first-child {
            -moz-box-shadow: inset 0 0 30px rgba(0, 0, 0, .3);
            -webkit-box-shadow: inset 0 0 30px rgba(0, 0, 0, .3);
            box-shadow: inset 0 0 30px rgba(0, 0, 0, .3);
            margin: 10px;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background-size: 100%;
            background-repeat: no-repeat;
        }

    #customers-list h3 {
        font-size: 1.2em;
        font-weight: normal;
        margin: 0 0 1px 0;
        padding: 0;
    }

    #customers-list p {
        margin: 0;
        padding: 0;
        font-size: .8em;
    }
</style>
