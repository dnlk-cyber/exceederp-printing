<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#FromDateTimeAm").trigger("change");
        $("#ToDateTimeAm").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "Delegation")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>



<script>

    function Open(e) {

     var row = $(e.target).closest("tr");
        var grid = $("#Delegation").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.DelegationId;

        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("OpenDelegation", "Delegation")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);
                    $('#loading-image').hide();
                    grid.dataSource.read();
                }
            });

        }

    }

    ////////////////////////////////

    function Close(e) {

     var row = $(e.target).closest("tr");
        var grid = $("#Delegation").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.DelegationId;

        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("CloseDelegation", "Delegation")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);
                    $('#loading-image').hide();
                    grid.dataSource.read();
                }
            });

        }

    }

</script>


<script>

    function onDataBound(e) {

        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check

            if (dataItem.IsOpen === false) {
                row.find("#open").show();
                row.find("#close").hide();
            }
            else if (dataItem.IsOpen === true) {
               // row.css("background-color", "red");
                row.find("#open").hide();
                row.find("#close").show();
            }           

           if (dataItem.HideButtons === true) {
                row.find("#open").hide();
                row.find("#close").hide();
                row.find("#delegationEdit").hide();
                row.find("#delegationDelete").hide();
            }
        }

    }

</script>