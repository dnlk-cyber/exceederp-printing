<legend>@Resources.NavigatorBenefit_Delegation</legend>
@(Html.Kendo().Grid<Delegation>()
      .Name("Delegation")
      .Columns(columns =>
      {
          columns.Bound(c => c.IsWithBenefit).ClientTemplate(
           "<input type='checkbox' disabled = 'true' value='#= IsWithBenefit#' " +
           "# if (IsWithBenefit) { #" +
           "checked='checked'" +
           "# } #" +
           "/>"
           ).Width(120);
          //columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["PeriodList"], "GLPeriodId", "Name").EditorTemplateName("GLPeriodSelector").Width(120);
          columns.ForeignKey(c => c.FromEmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("Employees").Filterable(ftb => ftb.Multi(true).Search(true)).Width(160);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("Employees").Filterable(ftb => ftb.Multi(true).Search(true)).Width(160);
          columns.Bound(c => c.FromDateTimeAm).EditorTemplateName("Calander").Width(200);
          columns.Bound(c => c.ToDateTimeAm).EditorTemplateName("Calander").Width(200);
          columns.Bound(c => c.IsOpen).ClientTemplate(
          "<input type='checkbox' disabled = 'true' value='#= IsOpen#' " +
          "# if (IsOpen) { #" +
          "checked='checked'" +
          "# } #" +
          "/>"
          ).Width(120);
          //columns.Bound(c => c.Reason).Width(250);

          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Profile_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit).HtmlAttributes(new { @id = "delegationEdit" });
                  command.Custom("").Click("Open").Text(Resources.Button_Open).IconClass("fa fa-check fa4x").HtmlAttributes(new { @class = "btn btn-yellow", @title = "Open delegation and set start date ", @id = "open" });
                  command.Custom("").Click("Close").Text(Resources.Button_Close).IconClass("fa fa-remove fa4x").HtmlAttributes(new { @class = "btn btn-white", @title = "Close delegation and set end date ", @id = "close" });

              }
              if (HttpContext.Current.User.IsInRole("HR_Profile_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel).HtmlAttributes(new { @id = "delegationDelete" }); ;
              }
          }).Width(350);
      })
        .ToolBar(toolbar =>
        {
            if (HttpContext.Current.User.IsInRole("HR_Profile_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
            {
                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
            }
        })
        .Editable(editable => editable.Mode(GridEditMode.InLine))
             .Events(x =>
             {
                 x.DataBound("onDataBound");
                 x.DetailExpand("onDetailExpand");
                 x.Save("GetDate");
                 x.Edit("GetDate");
             })
           .Scrollable(h => h.Height(500))
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
            .Filterable()
               .Pageable(pageable => pageable
                    .Input(true)
                    .Numeric(false)
                    .Refresh(true)
                    .PageSizes(true)
                    .ButtonCount(5))
        .DataSource(dataSource => dataSource
            .Ajax()
                 .Events(events =>
                 {
                     events.Error("error_handler(\"Delegation\")");
                     events.RequestStart("onRequestStart(\"Delegation\")");
                     events.RequestEnd("onRequestEnd(\"Delegation\")");
                 })
                 .Sort(sort=>sort.Add(x=>x.DelegationId).Descending())

            .Model(model =>
            {
                model.Id(p => p.DelegationId);
                model.Field(p => p.FromDateTime).Editable(false);
                //model.Field(p => p.ToDateTimeAm).Editable(false);
                //model.Field(p => p.FromDateTimeAm).Editable(false);
                model.Field(p => p.ToDateTime).Editable(false);
            })
                .Read(read => read.Action("Delegations_Hr_Read", "Delegation"))
                .Create(create => create.Action("Delegations_Create", "Delegation"))
                .Update(update => update.Action("Delegations_Update", "Delegation"))
                .Destroy(destroy => destroy.Action("Delegations_Destroy", "Delegation"))

        ).ClientDetailTemplateId("template")
)
