              }
              //if (HttpContext.Current.User.IsInRole("HR_Placement_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
              //{
              //    //command.Destroy().Text(Resources.ActionButton_Cancel);
              //}

