            model.Field(p => p.AssignmentType).DefaultValue(-1);
            model.Field(p => p.ResponsibilityLevel).DefaultValue(-1);
            model.Field(p => p.EmployementType).DefaultValue(-1);


        })
        .Read(read => read.Action("PromotionEligible_Read", "PromotionEligible"))
        .Create(create => create.Action("PromotionEligible_Create", "PromotionEligible"))
        .Update(update => update.Action("PromotionEligible_Update", "PromotionEligible"))
        .Destroy(destroy => destroy.Action("PromotionEligible_Destroy", "PromotionEligible"))

        )
)


