        .AllPages(true)
        .ProxyURL(Url.Action("Excel_Export_Save", "EmployeePlacmentWithOJ")))
        //.Pdf(pdf => pdf
        //.AllPages()
        //.FileName(Resources.NavigatorPlacment_EmployeePlacment + ".pdf")
        //.ProxyURL(Url.Action("Pdf_Export_Save", "EmployeePlacmentWithOJ")))
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Placement").Window(window => { window.Title(Resources.NavigatorPlacment_EmployeePlacment); window.Scrollable(false); }))
        .Scrollable(h => h.Height(500))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);

        })
        .Filterable()
        .Events(e =>
        {
            e.Save("GetDate");
            e.Edit("GetDate");
            e.DataBound("onDataBound");
            e.Cancel("onCancel");
        })
        .Pageable(pageable => pageable
        .Input(true)
        .Numeric(false)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5))
        .DataSource(dataSource => dataSource
                .Ajax()
                .Sort(sort => sort.Add(s => s.PlacementId).Descending())
                .Events(events =>
