<script>


    var isNew_Global = "";
    function onDepartmentDataBound() {
        if (isNew_Global === "True") {

            $("#FullNameTextBox_Id").hide();
            $("#EmpIdDropdown_Id").show();
        }
        else if (isNew_Global === "False") {
            $("#FullNameTextBox_Id").show();
            $("#EmpIdDropdown_Id").hide();
        }
    }

    function GetEmployeeNameEmploye(e) {
        var autocomplete = $("#EmployeeId").data("kendoAutoComplete");
        var id = autocomplete.value();

        $.ajax({
            url: '@Url.Action("SetEmployeeId", "EmployeePlacmentWithOJ")',
            contentType: "application/json; charset=utf-8",
            data: { 'fullName': id },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
            }

        });
    }

    function handleButtonClick(e) {
            e.preventDefault(); // Prevent default form submission behavior

            var fromGrade = $("#FromGrade").data("kendoDropDownList").value();
            var toGrade = $("#ToGrade").data("kendoDropDownList").value();
            var fromStep = $("#FromStep").data("kendoDropDownList").value();
            var toStep = $("#ToStep").data("kendoDropDownList").value(); // Corrected typo in variable name

            // Check conditions sequentially and return if any condition fails
            if (fromGrade === "") {
                alert("Please select From grade first");
                return;
            }
            if (toGrade === "") {
                alert("Please select the to Grade first");
                return;
            }
            if (fromStep === "") {
                alert("Please select from step");
                return;
            }
            if (toStep === "") {
                alert("Please select the to step");
                return;
                }
            if (toStep === fromStep) {
                alert(" From and  to step  can't be equal Please select another");
                return;
            }
            if (fromGrade === toGrade) {
                alert(" from and  to grade can't be equal Please select another");
                return;
            }


        // If all conditions pass, make the AJAX request
        $('#loading-image').show();
        $.ajax({
            url: '@Url.Action("UpdateSalary", "EmployeePlacmentWithOJ")',
            data: { fromRank: fromGrade, toRank: toGrade, fromStep: fromStep, toStep: toStep },
            type: 'POST',
            cache: false,
            success: function(result) {
                alert(result);
            }
        });
    }

</script>


