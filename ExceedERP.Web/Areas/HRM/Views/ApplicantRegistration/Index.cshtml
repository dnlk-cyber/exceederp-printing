<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#RegistrationDateAm").trigger("change");

        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "ApplicantRegistration")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
    function GetAppDate() {

        var x = AssignDate();
        var y = x;
        $("#FromAmharic").trigger("change");
        $("#ToAmahric").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "ApplicantExperience")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
    function GetAppEdDate() {

        var x = AssignDate();
        var y = x;
        $("#FromAmharic").trigger("change");
        $("#ToAmahric").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "ApplicantEducation")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }

</script>
