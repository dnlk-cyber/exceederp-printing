@using System.Collections
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Domain.HRM.RecruitmentManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.Navigator_Recruitment_ApplicantRegistration</Legend>
      

                    @(Html.Kendo().Grid<ApplicantRegistration>()
                          .Name("ApplicantRegistrationgrid")
                          .Columns(columns =>
                          {
                              columns.ForeignKey(c => c.VacancyId, (IEnumerable)ViewData["recruitmentVacancy"], "VacancyId", "MediaVacancyCode").EditorTemplateName("Vacancy").Width(150);
                              columns.Bound(c=>c.MediaVacancyCode).Visible(false);
                              columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["JobTitle"], "LookupId", "Description").Width(200);
                              columns.Bound(c => c.ApplicantName).Width( 150);
                              columns.Bound(c => c.Age).Width( 120);
                              columns.Bound(c => c.Sex).Width( 120);
                              columns.Command(command =>
                              {
                                  if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
                                  {
                                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  }
                                  if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Recruitment_Admin"))
                                  {
                                      command.Destroy().Text(Resources.ActionButton_Cancel);
                                  }
                              }).Width(180);
                          })
                          .ToolBar(toolbar =>
                          {
                              if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
                              {
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              }
                              if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Recruitment_Admin"))
                              {
                                  toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
                                  toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
                              }
                          })
                                   .Excel(excel => excel
                                                            .FileName(Resources.Navigator_Recruitment_ApplicantRegistration + ".xlsx")
                                        .Filterable(true)
                                            .AllPages(true)
                                             .ProxyURL(Url.Action("Excel_Export_Save", "ApplicantRegistration"))
                                    )
                                         .Pdf(pdf => pdf
                                        .AllPages()
                                                                        .FileName(Resources.Navigator_Recruitment_ApplicantRegistration + ".pdf")
                                                                    .ProxyURL(Url.Action("Pdf_Export_Save", "ApplicantRegistration"))
                                    )
                          .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ApplicantRegistration").Window(window =>
                          {
                              window.Title(Resources.Navigator_Recruitment_ApplicantRegistration);
                              window.Scrollable(false);
                          }))

                                  .Groupable()
                                        .HtmlAttributes(new { style = "height: 550px;" })
                                       .Groupable()
                                      .Sortable(sortable =>
                                      {
                                          sortable.SortMode(GridSortMode.SingleColumn);
                                      })
                                       .Filterable()
                                      .Scrollable()
                                              .Events(x => { x.Edit("GetDate");
                                                  x.Save("GetDate");})
                                  .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                                      .Sort(sort => sort.Add("VacancyId").Descending())
                                      .Events(events =>
                                      {
                                          events.Error("error_handler(\"ApplicantRegistrationgrid\")");
                                          events.RequestStart("onRequestStart(\"ApplicantRegistrationgrid\")");
                                          events.RequestEnd("onRequestEnd(\"ApplicantRegistrationgrid\")");
                                      }
                                                        )

                              .Model(model => model.Id(p => p.ApplicantRegistrationId))
                              .Read(read => read.Action("ApplicantRegistration_Read", "ApplicantRegistration"))
                              .Create(create => create.Action("ApplicantRegistration_Create", "ApplicantRegistration"))
                              .Update(update => update.Action("ApplicantRegistration_Update", "ApplicantRegistration"))
                              .Destroy(destroy => destroy.Action("ApplicantRegistration_Destroy", "ApplicantRegistration"))
                                                  ).ClientDetailTemplateId("AddressTemplate")
                          )
             



