        var masterGrid = $("#ApplicantRegistrationgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        ApplicantRegistrationId_Global = masterDataItem.ApplicantRegistrationId;


    }

 
        $("#customCommand").click(function (e) {
            e.preventDefault();
      //put custom logic here
            var masterId = ApplicantRegistrationId_Global;

            var row = $(e.target).closest("tr");
            var grid = $("#ApplicantDetailgrid_" + masterId).data("kendoGrid");
            var dataItem = grid.dataItem(row);


