<script>
    function send(e) {
       // var value = e;
        //var grid = $("#VaccancyPlangrid").data("kendoGrid");

        //var selectedRow = grid.dataItem(grid.select());//grid.select();
        //var id = selectedRow.VacancyId;

        var row = $(e.target).closest("tr");
        var grid = $("#ApplicantRegistrationgrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var code = dataItem.VacancyCode;
        var vacancyId = dataItem.VacancyId;

        if (code.length !== 0 )
        {
            $.ajax({
                url: '@Url.Action("SendForResult", "ApplicantRegistration")',

                data: { code: code},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;

                   // $("#OrgStructureId").val(r).trigger("change");

                }

            });

        }
    }
</script>


