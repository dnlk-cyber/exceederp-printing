    <script>

        function Employee()
        {
            var employees = $("#EmployeeId").data("kendoComboBox");
            var employee = employees.value();

            $.ajax({
                url: '@Url.Action("GetEmployee", "EmployeePerformance")',
                data: { employee: employee },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;

                }

            });


            var value = this.value(),
                grid = $("#MeasurementDefinitiongrid").data("kendoGrid");

            if (value) {
                grid.dataSource.filter({ field: "EmployeeId", operator: "eq", value: parseInt(value) });
            } else {
                grid.dataSource.filter({});
            }
        }
        function onEmployeeChange()
        {
            //var employees = $("#EmployeeId").data("DropDownListFor");
               var employeeId = $("#EmployeeId").val();
            //var employeeId = employees ? employees.value() : null;

            if (!employeeId) {
                alert("Please select an employee.");
                return;
            }

            $.ajax({
                url: '@Url.Action("GetEmployee", "EmployeePerformance")',
                type: 'POST',
                data: { id: employeeId },
                cache: false,
                success: function (result) {
                    alert(result.Message);
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching employee data:", error);
                    alert("An error occurred while retrieving employee details.");
                }
            });

            var grid = $("#MeasurementDefinitiongrid").data("kendoGrid");
            if (grid) {
                grid.dataSource.filter(
                    employeeId ? { field: "EmployeeId", operator: "eq", value: parseInt(employeeId) } : {}
                );
            }
            const evaluationCriteria = $("#EvaluationCriteriaId").data("kendoDropDownList");
            if (evaluationCriteria) {
                evaluationCriteria.dataSource.read();
                evaluationCriteria.value("");
            }
        }

    </script>


