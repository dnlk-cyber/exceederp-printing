<script>

    var EmployeePerformanceId_Global = 0;

    function Process() {


        var employee = $("#EmployeeId").data("kendoDropDownList").text();
        var year = $("#GlFiscalYearId").data("kendoDropDownList").text();
        var period = $("#Period").data("kendoDropDownList").text();
        var EvaluationCriteria = $("#EvaluationCriteriaId").data("kendoDropDownList").text();
        var evaluationLevel = $("#Evaluation").data("kendoDropDownList").text();
       

        document.getElementById("EmpName").innerHTML = employee;

        document.getElementById("YearName").innerHTML = year;
        document.getElementById("PeriodName").innerHTML = period;
            
        document.getElementById("EvaluationCriteriaName").innerHTML = "- "+EvaluationCriteria.split('-')[0] + "<br/>- " + EvaluationCriteria.split('-')[1] + "<br/>- "+ EvaluationCriteria.split('-')[2];
     

        var evaluationCriteriaId = $("#EvaluationCriteriaId").data("kendoDropDownList").value();
        var employeeId = $("#EmployeeId").data("kendoDropDownList").value();
        var yearId = $("#GlFiscalYearId").data("kendoDropDownList").value();
        var periodId = $("#Period").data("kendoDropDownList").value();

         $.ajax({
             url: '@Url.Action("GetEvaluationWeightandResult", "EmployeePerformance")',
             data: { evaluationCriteriaId: evaluationCriteriaId, employeeId: employeeId, yearId: yearId, periodId: periodId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                document.getElementById("weight").innerHTML = r.Weight;
                document.getElementById("result").innerHTML = r.Result;
                document.getElementById("approval").innerHTML = r.Approval;
                if (r.Approval === "Submitted") {
                    document.getElementById("approveButtonStyle").style.display = "none";

                }
                //location.reload();

            }

        });

      var grid = $("#Measurementgrid").data("kendoGrid");

       // grid.dataSource.transport.read();
      grid.dataSource.read();

      //  grid.refresh();


    }
</script>

<script>
    function filterdata() {

        var empId = $("#EmployeeId").data("kendoDropDownList").value();
        var fiscalYearId = $("#GlFiscalYearId").data("kendoDropDownList").value();
        var periodId = $("#Period").data("kendoDropDownList").value();
        var evaluationCriteriaId = $("#EvaluationCriteriaId").data("kendoDropDownList").value();
        var criteriaCategoryId = $("#CriteriaCategoryId").data("kendoDropDownList").value();

        return {
            empId: empId,
            fiscalYearId: fiscalYearId,
            periodId: periodId,
            evaluationCriteriaId: evaluationCriteriaId,
            criteriaCategoryId: criteriaCategoryId
        };
    }

</script>



<script>
    
    function Employee() {
        var employees = $("#EmployeeId").data("kendoComboBox");
        var employee = employees.value();
       
        $.ajax({
            url: '@Url.Action("GetEmployee", "EmployeePerformance")',
            data: { employee: employee },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

            }

        });


        var value = this.value(),
            grid = $("#MeasurementDefinitiongrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "EmployeeId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>


<script>

    function filterPeriod() {
        return {
