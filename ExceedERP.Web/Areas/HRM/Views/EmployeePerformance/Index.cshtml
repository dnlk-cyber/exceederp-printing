<script>
    function MasterDetailExpand() {

        var employees = $("#EmployeeId").data("kendoDropDownList");
        var empId = employees.value();
       // var checkemployee = $("#CheckEmp").data("kendoDropDownList");
       // var checkemp = checkemployee.value();
        var periods = $("#Period").data("kendoDropDownList");
        var period = periods.value();
        var lookups = $("#LookupId").data("kendoComboBox");
        var LookupId = lookups.value();
        var evaluation = $("#Evaluation").data("kendoComboBox");
        var eva = evaluation.value();

        $.ajax({
            url: '@Url.Action("GenerateEvaluation", "EmployeePerformance")',
            //contentType: "application/json; charset=utf-8",
            data: { empId: empId, period: period, LookupId: LookupId, eva: eva},
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

            }

        });


        var value = this.value(),
            grid = $("#MeasurementDefinitiongrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "EmployeeId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>

<script>
    function Approve() {
        
        var periods = $("#Period").data("kendoDropDownList");
        var period = periods.value();
        if (period == "") {
            alert("please select the period to approve");
        }
        else {
            var conf = confirm("Are you sure you want to approve this quarter performance evaluation");
            if (conf === true) {
                $('#loading-image').show();

                $.ajax({
                    url: '@Url.Action("Approve", "EmployeePerformance")',
                    //contentType: "application/json; charset=utf-8",
                    data: { period: period },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        r = result;
                        alert("Successfully Approved");
                        $('#loading-image').hide();
                        grid.dataSource.read();
                    }

                });
            }
    }
        }
       
</script>