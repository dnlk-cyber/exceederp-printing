</script>

<script>

    function customAction(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));

        var id = dataItem.MeasurementDefinitionId;


        try {
            //var BookNo = dataItem.BookNo;
            $.ajax({
                //contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetStatus", "EmployeePerformance")',
                data: { mid: id },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    $("#MeasurementDefinitiongrid").data("kendoGrid").dataSource.read();
                    $("#MeasurementDefinitiongrid").data("kendoGrid").refresh();
                }

            });
        } catch (ee) {
            alert("Please select the row first!!");
        }
    }
    var enableDisable;
   
    
    function DetailDatabound(e) {
        var grid = this;


        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);

            var dataItem = grid.dataItem(row);

            if (enableDisable === true) {

                    //answer.hide(true);
                    //transfer.hide(true);
                row.find(".k-grid-edit").hide();



            } else {
                row.find(".k-grid-edit").show();
            }
        }
    }
    function mainDataBound(e) {

        $("#chkemp").show(false);

        try {

            var grid = this;

            var gridRows = grid.tbody.find("tr");

            for (var j = 0; j < gridRows.length; j++) {
                var row = $(gridRows[j]);
                var dataItem = grid.dataItem(row);
                //perform your custom check


                if (dataItem.IsApproved === false) {
                    //hide buttons using jQuery
                    row.find(".k-grid-edit").show();
                    row.find(".k-grid-customAction").text('Approve');
                }
                else {

                    row.find(".k-grid-edit").hide();
                    row.find(".k-grid-customAction").text('Reject');
                }



            }
        } catch (ee) {
            alert(ee);
        }

    }

    var empId = 0;
    var measurmentDefinitionId = 0;
    function MasterDetailExpandSecond(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#EmployeePerformancegrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        empId = masterDataItem.EmployeeId;
    }

    function MasterDetailExpandMeasurmentDefinition(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#MeasurementDefinitionsgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        measurmentDefinitionId = masterDataItem.MeasurementDefinitionId;
    }

    function filterdata() {
        
        var employees = $("#EmployeeId").data("kendoDropDownList");
        var employee = employees.value();
       // var checkemployee = $("#CheckEmp").data("kendoDropDownList");
       // var checkemp = checkemployee.value();
        var periods = $("#Period").data("kendoDropDownList");
        var period = periods.value();
        var lookups = $("#LookupId").data("kendoComboBox");
        var LookupId = lookups.value();
        var evaluation = $("#Evaluation").data("kendoComboBox");
        var Evaluation = evaluation.value();
       
            return {
                employee: employee,
                period: period,
                LookupId: LookupId,
                Evaluation: Evaluation,
                //checkemp: checkemp,
                empId: empId,
                measurmentDefinitionId: measurmentDefinitionId
            };
        
       
    }
    function Employee() {
        var employees = $("#EmployeeId").data("kendoComboBox");
        var employee = employees.value();
        // $("#EvaluationType").val(0);
        $.ajax({
            url: '@Url.Action("GetEmployee", "EmployeePerformance")',
            //contentType: "application/json; charset=utf-8",
            data: { employee: employee },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

            }

        });


        var value = this.value(),
            grid = $("#MeasurementDefinitiongrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "EmployeeId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>

