    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }
    function onChange(e) {
        var grid = e.sender;
        var selectedRows = this.select();
        var rowData = this.dataItem(selectedRows[0]);
        var id = rowData.AttachmentID;
        $.ajax({
            url: '@Url.Action("Download", "EmployeeCosign")',
            contentType: "application/json; charset=utf-8",
            data: { 'id': id },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
            }

        });

    }
</script>
<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
      
        $("#AgreementDateAm").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "EmployeeCosign")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }

</script>
<script>
    function GetCommitmentCosignDate() {

        var x = AssignDate();
        var y = x;
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "CommitmentCosign")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>