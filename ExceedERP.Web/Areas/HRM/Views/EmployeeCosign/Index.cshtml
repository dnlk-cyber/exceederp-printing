@using System.Collections
@using System.Security.AccessControl
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorRecruitment_Cosign</legend>


              @(Html.Kendo().Grid<Cosign>()
              .Name("Cosigngrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(150);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["CosignType"], "LookupId", "Description").EditorTemplateName("CosignType").Width(120);
          columns.Bound(c => c.AgreementDateAm).EditorTemplateName("Calander").Width(150);
          columns.Bound(c => c.FullName).Width (120);
          columns.Bound(c => c.BirthPlace).Width (100);
          
          columns.Bound(c => c.Workorganization).Width (150);
          //columns.Bound(c => c.Remark);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("HR_Recruitment_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          }).Width(190);
      })
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
              .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                       .Events(x =>
                       {
                           x.Edit("GetDate");
                           x.Save("GetDate");
                       })
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
                                                    
      .DataSource(dataSource => dataSource
          .Ajax()
                                    .Events(events =>
                                                          {
                                                              events.Error("error_handler(\"Cosigngrid\")");
                                                              events.RequestStart("onRequestStart(\"Cosigngrid\")");
                                                              events.RequestEnd("onRequestEnd(\"Cosigngrid\")");
                                                          })
                                  

                  .Model(model => { model.Id(p => p.CosignId);
                   model.Field(p => p.EmployeeCode).Editable (false);})
                          .Read(read => read.Action("Cosigns_Read", "EmployeeCosign"))
                          .Create(create => create.Action("Cosigns_Create", "EmployeeCosign"))
                  .Update(update => update.Action("Cosigns_Update", "EmployeeCosign"))
                  .Destroy(destroy => destroy.Action("Cosigns_Destroy", "EmployeeCosign"))
      ).ClientDetailTemplateId("AddressTemplate")
              )
       
 
    <script id="AddressTemplate" type="text/kendo-tmpl">
        @(Html.Kendo().TabStrip()
            .Name("tabstrip_#CosignId#")
    .SelectedIndex(0)
    .Items(items =>
     {
       

         //*****************************************************************************************************//
         //*********************************Organization address*************************************************//
         items.Add().Text(Resources .HR_OrganizationAddress ).Content(
        @<text>

            @(Html.Kendo().Grid<Address>()
                      .Name("OrganizationAddresseGrid_#=CosignId#")
      .Columns(columns =>
      {
          columns.Bound(c => c.Category).EditorTemplateName("Enum");
          columns.Bound(c => c.Value);
          columns.Bound(c => c.Remark);
          columns.Command(command => {
                                         if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
                                         {
                                             command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                         }
                                         if (HttpContext.Current.User.IsInRole("HR_Recruitment_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
                                         {
                                             command.Destroy().Text(Resources.ActionButton_Cancel);
                                         }
          }).Width(200);
             
      })
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
               .Selectable()
      .DataSource(dataSource => dataSource
          .Ajax()
                   .Events(events =>
                                                                  {
                                                                      events.Error("error_handler(\"OrganizationAddresseGrid_#=CosignId#\")");
                                                                      events.RequestStart("onRequestStart(\"OrganizationAddresseGrid_#=CosignId#\")");
                                                                      events.RequestEnd("onRequestEnd(\"OrganizationAddresseGrid_#=CosignId#\")");
                                                                  })
                                  

          .Model(model => model.Id(p => p.AddressId))
                                                  .Read(read => read.Action("Addresses_Read", "Addresse", new { Area = "Common", id = "#=CosignId#", addressReferenceType = "Normal" }))
                                                                  .Create(create => create.Action("Addresses_Create", "Addresse", new { Area = "Common", id = "#=CosignId#", addressReferenceType = "Normal" }))
                  .Update(update => update.Action("Addresses_Update", "Addresse", new { Area = "Common" }))
                  .Destroy(destroy => destroy.Action("Addresses_Destroy", "Addresse", new { Area = "Common" }))
       ).ToClientTemplate()
            )
        </text>
    );

         items.Add().Text(Resources.HR_ResidenceAddress ).Content(
            @<text>

                @(Html.Kendo().Grid<Address>()
                              .Name("ResidenceAddresseGrid_#=CosignId#")
      .Columns(columns =>
      {
          columns.Bound(c => c.Category).EditorTemplateName("Enum");
          columns.Bound(c => c.Value);
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
              .Events(e => { e.Edit("GetCommitmentCosignDate");
               e.Save("GetCommitmentCosignDate");})
               .Selectable()
      .DataSource(dataSource => dataSource
          .Ajax()
                  .Events(events =>
{
 events.Error("error_handler(\"ResidenceAddresseGrid_#=CosignId#\")");
 events.RequestStart("onRequestStart(\"ResidenceAddresseGrid_#=CosignId#\")");
events.RequestEnd("onRequestEnd(\"ResidenceAddresseGrid_#=CosignId#\")");
})
                                  

          .Model(model => model.Id(p => p.AddressId))
                                                          .Read(read => read.Action("Addresses_Read", "Addresse", new { Area = "Common", id = "#=CosignId#", addressReferenceType = "Residence" }))
                                                          .Create(create => create.Action("Addresses_Create", "Addresse", new { Area = "Common", id = "#=CosignId#", addressReferenceType = "Residence" }))
                  .Update(update => update.Action("Addresses_Update", "Addresse", new { Area = "Common" }))
                  .Destroy(destroy => destroy.Action("Addresses_Destroy", "Addresse", new { Area = "Common" }))
       ).ToClientTemplate()
                )
            </text>
    );
         items.Add().Text(Resources .HR_File ).Content(
            @<text>

                @(Html.Kendo().Grid<Attachment>()
                      .Name("AttachmentGrid_#=CosignId#")
      .Columns(columns =>
      {

          columns.Bound(c => c.Description);

          columns.Bound(c => c.FileType).ClientTemplate(Html.ActionLink("DownLoad", "DownloadFile", new { filename = "#=CosignId#" }).ToHtmlString()); 
         
          columns.Command(command =>
          {
             command.Destroy().Text(Resources.ActionButton_Cancel);
              //command.Custom("Download").Click("DownloadAttachmnets");
          }).Width(300);

      })
                        .Events(e =>
                               {
                                   e.Edit("onGridEdit");
                                   e.Change("onChange");
                               }) 
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
              .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Upload").Window(window =>
              {
                  window.Scrollable(false);
                  window.Title(Resources .HR_Upload_File);
              }))
      .Scrollable(h => h.Height(500))
               .Selectable()
      .DataSource(dataSource => dataSource
          .Ajax()
                    .Events(events =>
        {
            events.Error("error_handler(\"AttachmentGrid_#=CosignId#\")");
            events.RequestStart("onRequestStart(\"AttachmentGrid_#=CosignId#\")");
            events.RequestEnd("onRequestEnd(\"AttachmentGrid_#=CosignId#\")");
        })
                                   

          .Model(model => model.Id(p => p.AttachmentId))
                                                                                  .Read(read => read.Action("Attachments_Read", "Attachment", new { Area = "Common", attachmentReferenceType = "Cosign", id = "#=CosignId#", fileOwner = "#=CosignId#" }))
                                                                                 .Create(create => create.Action("Attachments_Create", "Attachment", new { Area = "Common", attachmentReferenceType = "Cosign", id = "#=CosignId#", fileOwner = "#=CosignId#" }))

                                  .Destroy(destroy => destroy.Action("Attachments_Destroy", "EmployeeCosign"))

          ).ToClientTemplate()
                )
            </text>
    );


     }).ToClientTemplate())
    </script>


