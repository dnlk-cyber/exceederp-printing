<script>
    function DownloadAttachmnets(e) {

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var dd = dataItem.Description;
        var id = dataItem.Reference;
        $.ajax({
            url: '@Url.Action("Download", "EmployeeCosign")',
            contentType: "application/json; charset=utf-8",
            data: { 'data': dd, 'id': id },
            type: 'GET',
            cache: false,
            success: function(result) {
                r = result;
            }

        });

    }
</script>
