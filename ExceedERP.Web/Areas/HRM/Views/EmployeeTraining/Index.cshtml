@using System.Collections
@using System.Security.AccessControl
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Domain.HRM.TrainingEducation
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend >@Resources.Navigator_Employee_Tranining</legend>

@(Html.Kendo().Grid<Training>()
                              .Name("EmpTrainingEducation")

             .Columns(columns =>
              {
                  columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(175);
                  columns.Bound(c => c.TrainingName).Width(150); ;
                  columns.Bound(c => c.OrganizationName).Width(170);
                  columns.Bound(c => c.OrgAddress).Width(175); ;
                  columns.Bound(c => c.From);//.EditorTemplateName("ETDateTime").Width(100); ;
                  columns.Bound(c => c.To).Width(100);
                  columns.Bound(c => c.Score).Width(75);
                  columns.Bound(c => c.TotalCost).Width(115);
                  //columns.Bound(c => c.PercentCoverdByOrg).Width(150); ;
                  //   columns.Bound(c => c.Remark).Width(150); ;
                  columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
              })
              .ToolBar(toolbar =>
              {
                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
              })
                                      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("EmployeeTraining").Window(window => { window.Title("Employee Training "); window.Scrollable(false); }))
                 .Scrollable(h => h.Height(500))
             .Groupable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
              .DataSource(dataSource => dataSource
                  .Ajax()
                      .Events(events =>
                    {

                        events.Error("error_handler(\"EmpTrainingEducation\")");
                        events.RequestStart("onRequestStart(\"EmpTrainingEducation\")");
                        events.RequestEnd("onRequestEnd(\"EmpTrainingEducation\")");
                    })
                    
                  .Model(model => model.Id(p => p.EmpEduTrainId))
                              .Read(read => read.Action("EmpTrainingEducations_Read", "EmployeeTraining"))
                                      .Create(create => create.Action("EmpTrainingEducations_Create", "EmployeeTraining"))
                          .Update(update => update.Action("EmpTrainingEducations_Update", "EmployeeTraining"))
                          .Destroy(destroy => destroy.Action("EmpTrainingEducations_Destroy", "EmployeeTraining"))
                  ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                    .Name("tabstrip_#=EmpEduTrainId#")
    .SelectedIndex(0)
    .Items(items =>
     {
       
         //*****************************************************************************************************//

         //*********************************Attachment***********************************************************//
         items.Add().Text(Resources.HR_File).Content(
            @<text>

    @(Html.Kendo().Grid<Attachment>()
              .Name("AttachmentGrid_#=EmpEduTrainId#")
      .Columns(columns =>
      {

          columns.Bound(c => c.Description);
          //columns.Bound(c => c.Reference);
          columns.Bound(c => c.FileType).ClientTemplate(Html.ActionLink("DownLoad", "DownloadFile", new { filename = "#=EmployeeId#" }).ToHtmlString()); 
          // columns.Bound(c => c.Remark);
          columns.Command(command =>
          {
              command.Destroy().Text(Resources.ActionButton_Cancel);
           //   command.Custom("Download").Click("DownloadAttachmnets");
          }).Width(300);

      })
                        .Events(e =>
                       {
                           e.Edit("onGridEdit");
                           e.Change("onChange");
                       }) 
               
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
              .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Upload").Window(window =>
              {
                  window.Scrollable(false);
                  window.Title(Resources .HR_Upload_File);
              }))
      .Scrollable(h=> h.Height( 500))
               .Selectable()
      .DataSource(dataSource => dataSource
          .Ajax()
                   .Events(events =>
                            {

                                events.Error("error_handler(\"AttachmentGrid_#=EmpEduTrainId#\")");
                                events.RequestStart("onRequestStart(\"AttachmentGrid_#=EmpEduTrainId#\")");
                                events.RequestEnd("onRequestEnd(\"AttachmentGrid_#=EmpEduTrainId#\")");
                            })
                  
          .Model(model => model.Id(p => p.AttachmentId))
                                                              .Read(read => read.Action("Attachments_Read", "Attachment", new { Area = "Common", attachmentReferenceType = "Training", id = "#=EmployeeId#", fileOwner = "#=EmpEduTrainId#" }))
                                                                         .Create(create => create.Action("Attachments_Create", "Attachment", new { Area = "Common", attachmentReferenceType = "Training", id = "#=EmployeeId#", fileOwner = "#=EmpEduTrainId#" }))

                  .Destroy(destroy => destroy.Action("Attachments_Destroy", "EmployeeTraining"))

          ).ToClientTemplate()
    )
            </text>
    );
         //*****************************************************************************************************//

     }).ToClientTemplate())
</script>
