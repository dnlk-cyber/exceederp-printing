@using ExceedERP.Core.Localization
@using (Html.BeginForm("Upload", "EmployeeTraining", FormMethod.Post  ,
    new { enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()

    <fieldset>
        <div class="editor-field">
            @Html.TextBox("file", "", new { type = "file"})
        </div>
        <br/>
        <div class="editor-field">
            <input type="submit" value="@Resources.HR_ActionButton_Upload" />
        </div>
    </fieldset>
}
