@using System.Collections
@using System.Security.AccessControl
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.Navigator_Employee_Commitment</legend>

@(Html.Kendo().Grid<Commitment>()
                                  .Name("Commitment")

                  .Columns(columns =>
                  {
                      columns.Bound(c => c.EmployeeCode).Width(120);
                      columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(150);
                      columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["commitment"], "LookupId", "Description").EditorTemplateName("CommitmentType").Width(100);
                      columns.Bound(c => c.Reason).Width(120);
                      columns.Bound(c => c.FromCometAm).EditorTemplateName("Calander").Width(170);
                      columns.Bound(c => c.ToCometAm).EditorTemplateName("Calander").Width(170);
                      columns.Bound(c => c.Value).Width(130);
                      columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsActive ? checked='checked' :'' # >").Width(100); ;
                      columns.Bound(c => c.Remark);
                      columns.Command(command =>
                      {
                          if (HttpContext.Current.User.IsInRole("HR_Profile_User"))
                          {

                              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                          }
                          if (HttpContext.Current.User.IsInRole("HR_Profile_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
                          {
                              command.Destroy().Text(Resources.ActionButton_Cancel);
                          }
                      }).Width(190);
                  })
                  .ToolBar(toolbar =>
                  {
                      if (HttpContext.Current.User.IsInRole("HR_Profile_User"))
                      {

                          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                      }

                  })
                  .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("EmployeeCommitment")
                                         .Window(window => {
                                             window.Title(Resources.Navigator_Employee_Commitment);
                                             window.Scrollable(false);
                                         }))
                  .Scrollable(h => h.Height(500))
                  .Sortable(sortable =>
                  {
                      sortable.SortMode(GridSortMode.SingleColumn);


                  })
                  .Filterable()
                  .Events(events =>
                  {
                      events.Save("GetDate");
                      events.Edit("GetDate");
                  })
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
                  .DataSource(dataSource => dataSource
                      .Ajax()
                      .Events(events =>
                      {
                          events.Error("error_handler(\"Commitment\")");
                          events.RequestStart("onRequestStart(\"Commitment\")");
                          events.RequestEnd("onRequestEnd(\"Commitment\")");

                      })
                        .Model(model => model.Id(p => p.CommitmentId))
                        .Read(read => read.Action("Commitments_Read", "CommitmentDepartment"))
                        .Create(create => create.Action("Commitments_Create", "CommitmentDepartment"))
                        .Update(update => update.Action("Commitments_Update", "CommitmentDepartment"))
                        .Destroy(destroy => destroy.Action("Commitments_Destroy", "CommitmentDepartment"))
                      ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=CommitmentId#")
            .SelectedIndex(0)
            .Items(items =>
