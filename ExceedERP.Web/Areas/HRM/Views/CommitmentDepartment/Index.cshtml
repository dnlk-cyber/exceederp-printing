                     .Columns(columns =>
                     {
                         // columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(120);
                         columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["CosignType"], "LookupId", "Description").EditorTemplateName("CosignType").Width(120);
                         columns.Bound(c => c.AgreementDateAm).Width(170).EditorTemplateName("Calander");
                         columns.Bound(c => c.FullName).Width(120);
                         columns.Bound(c => c.Workorganization).Width(150);
                         columns.Bound(c => c.Remark);
                         columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);


                     })
                     .ToolBar(toolbar =>
                     {
                         if (HttpContext.Current.User.IsInRole("HR_Profile_User"))
                         {

                             toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                         }


                     })
                    .Editable(editable => editable.Mode(GridEditMode.InLine))
                    .Scrollable(h => h.Height(500))
                    .Events(events =>
                    {
                        events.Save("GetCosignDate");
                        events.Edit("GetCosignDate");

                    })
                    .ClientDetailTemplateId("AddressTemplate")
                    .DataSource(dataSource => dataSource
                       .Ajax()
                       .Events(events =>
                       {
                           events.Error("error_handler(\"Cosigngrid_#=CommitmentId#\")");
                           events.RequestStart("onRequestStart(\"Cosigngrid_#=CommitmentId#\")");
                           events.RequestEnd("onRequestEnd(\"Cosigngrid_#=CommitmentId#\")");
                       })

                        .Model(model => model.Id(p => p.CosignId))
                        .Read(read => read.Action("Cosigns_Read", "CommitmentCosign", new { id = "#=EmployeeId#" }))
                        .Create(create => create.Action("Cosigns_Create", "CommitmentCosign", new { id = "#=EmployeeId#" }))
                        .Update(update => update.Action("Cosigns_Update", "CommitmentCosign"))
                        .Destroy(destroy => destroy.Action("Cosigns_Destroy", "CommitmentCosign"))
                        ).ToClientTemplate()
                )
            </text>
 );


     //*****************************************************************************************************//

     //*********************************Attachment***********************************************************//
     items.Add().Text(Resources.HR_File).Content(
                    @<text>

                        @(Html.Kendo().Grid<Attachment>()
                                  .Name("AttachmentGrid_#=CommitmentId#")
                                  .Columns(columns =>
                                  {

                                      columns.Bound(c => c.Description);

                                      columns.Bound(c => c.FileType).ClientTemplate(Html.ActionLink("DownLoad", "DownloadFile", new { filename = "#=CommitmentId#" }).ToHtmlString());

                                      columns.Command(command =>
                                      {
                                          command.Destroy().Text(Resources.ActionButton_Cancel);
                                          // command.Custom("Download").Click("DownloadAttachmnets");
                                      }).Width(300);

                                  })
                                  .Events(e =>
                                  {
                                      e.Edit("onGridEdit");
                                      e.Change("onChange");

                                  })
                                  .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Upload").Window(window =>
                                  {
                                      window.Scrollable(false);
                                      window.Title(Resources.HR_Upload_File);

                                  }))
                                  .Scrollable(h => h.Height(500))
                                  .Selectable()
                                  .DataSource(dataSource => dataSource
                                      .Ajax()
                                      .Events(events =>
                                      {
                                          events.Error("error_handler(\"AttachmentGrid_#=CommitmentId#\")");
                                          events.RequestStart("onRequestStart(\"AttachmentGrid_#=CommitmentId#\")");
                                          events.RequestEnd("onRequestEnd(\"AttachmentGrid_#=CommitmentId#\")");

                                      })
                                      .Model(model => model.Id(p => p.AttachmentId))
                                      .Read(read => read.Action("Attachments_Read", "Attachment", new { Area = "Common", attachmentReferenceType = "Commitment", id = "#=CommitmentId#", fileOwner = "#=CommitmentId#" }))
                                      .Create(create => create.Action("Attachments_Create", "Attachment", new { Area = "Common", attachmentReferenceType = "Commitment", id = "#=CommitmentId#", fileOwner = "#=CommitmentId#" }))
                                     .Destroy(destroy => destroy.Action("Attachments_Destroy", "EmployeeCommitment"))

                                     ).ToClientTemplate()
                        )
                    </text>
                    );
             //*****************************************************************************************************//

         }).ToClientTemplate())


</script>
