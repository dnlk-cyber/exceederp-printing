@using System.Collections
@using System.Security.AccessControl
@using ExceedERP.Core.Domain.HRM.Attendance
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorAttendance_Attendance</legend>

 @(Html.Kendo().Grid<Attendance>()
              .Name("Attendancegrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(200);
          columns.Bound(c => c.FromDateTime).Width(150) ;
          columns.Bound(c => c.ToDateTime).Width(150);
          columns.Bound(c => c.DelayTime).Width(120);
          columns.Bound(c => c.NoOfAbcent).Width(120);
          columns.Bound(c => c.MeasureTaken).Width(120);
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Scrollable(h => h.Height(500))
              .Groupable()
                       .Sortable(sortable =>
                       {
                           sortable.SortMode(GridSortMode.SingleColumn);
                       })
           .Filterable()
              .Pageable(pageable => pageable
                                         .Input(true)
                                         .Numeric(false)
                                         .Refresh(true)
                                         .PageSizes(true)
                                         .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                                             .Events(events =>
              {
                  events.Error("error_handler(\"Attendancegrid\")");
                  events.RequestStart("onRequestStart(\"Attendancegrid\")");
                  events.RequestEnd("onRequestEnd(\"Attendancegrid\")");
              })
              
                         
               .Model(model => { model.Id(p => p.AttendanceId);
                model.Field(p => p.EmployeeCode).Editable (false);})
                       .Read(read => read.Action("Attendances_Read", "EmployeeAttendance"))
                       .Create(create => create.Action("Attendances_Create", "EmployeeAttendance"))
               .Update(update => update.Action("Attendances_Update", "EmployeeAttendance"))
               .Destroy(destroy => destroy.Action("Attendances_Destroy", "EmployeeAttendance"))
           )
            )


<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>

<style>
    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>

