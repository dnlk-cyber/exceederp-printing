@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.Payroll
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPayroll_OverTimePerDay</legend>

@(Html.Kendo().Grid<OverTimePerDay>()
          .Name("OverTimePerDaygrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.TicketNumber).Width( 140);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("PayrollListOfEmployee").Width(150);
          columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["PeriodList"], "GLPeriodId", "Name").EditorTemplateName("GLPeriod").Width(120);
          columns.Bound(c => c.Date).Width(120);//.Format("{0:yyyy-MM-dd}");
          columns.Bound(c => c.NormalHours).Width(105).ClientTemplate("<input type='checkbox' disabled='true' value='#=NormalHours #' " + " # if (NormalHours) { #" + "checked='checked'" + "# } #" + " />");
          columns.Bound(c => c.NightHours).Width(105).ClientTemplate("<input type='checkbox'  disabled='true' value='#=NightHours #' " + " # if (NightHours) { #" + "checked='checked'" + "# } #" + " />");
          columns.Bound(c => c.HolidayHours).Width(105).ClientTemplate("<input type='checkbox'  disabled='true' value='#=HolidayHours #' " + " # if (HolidayHours) { #" + "checked='checked'" + "# } #" + " />");
          columns.Bound(c => c.RestdayHours).Width(105).ClientTemplate("<input type='checkbox'  disabled='true' value='#=RestdayHours #' " + " # if (RestdayHours) { #" + "checked='checked'" + "# } #" + " />");
          // columns.Bound(c => c.Form).Width(120).Format("{0:hh:mm:ss}");
          // columns.Bound(c => c.To).Width(120).Format("{0:hh:mm:ss}");
          columns.Bound(c => c.TotalHr).Width(100);
          //columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
         
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                                          .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("OverTimePerDay").Window(window => { window.Title(Resources.NavigatorPayroll_OverTimePerDay); window.Scrollable(false); }))
                              .Scrollable(h => h.Height(500))
                                     .Groupable()
                                              .Sortable(sortable =>
                                              {
                                                  sortable.SortMode(GridSortMode.SingleColumn);
                                              })
                                  .Filterable()
                                     .Pageable(pageable => pageable
                                                                .Input(true)
                                                                .Numeric(false)
                                                                .Refresh(true)
                                                                .PageSizes(true)
                                                                .ButtonCount(5))

                          .DataSource(dataSource => dataSource
                              .Ajax()
                                    .Events(events =>
                                                            {
                                                                events.Error("error_handler(\"OverTimePerDaygrid\")");
                                                                events.RequestStart("onRequestStart(\"OverTimePerDaygrid\")");
                                                                events.RequestEnd("onRequestEnd(\"OverTimePerDaygrid\")");
                                                            }) 
                                          
                              .Model(model => model.Id(p => p.TicketNumber))
                                                                      .Read(read => read.Action("OverTimePerDays_Read", "OverTimePerDay", new { ticketNo = "#=TicketNumber#" }))
                              .Create(create => create.Action("OverTimePerDays_Create", "OverTimePerDay"))
                              .Update(update => update.Action("OverTimePerDays_Update", "OverTimePerDay"))
                              .Destroy(destroy => destroy.Action("OverTimePerDays_Destroy", "OverTimePerDay"))
                                  )//.ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                          .Name("tabstrip_#=TicketNumber#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text(Resources.Details).Content(
                  @<text>
                 
                    @(Html.Kendo().PanelBar()
                          .Name("panelbar")
                          .ExpandMode(PanelBarExpandMode.Single)
                          .Items(panelbar =>
                          {
                              panelbar.Add().Text(Resources.Details)
                                  .Expanded(true)
                                  .Content(
                                      "<div class='employee-details'>" +
                                      "<ul>" +
                                      "<li><label>Employee:</label>#=EmployeeId#</li>" +
                                      "<li><label>Period:</label>#=Period#</li>" +
                                      "<li><label>Date:</label>#=Date#</li>" +
                                      "<li><label>NormalHours:</label>#=NormalHours#</li>" +
                                      "<li><label>NightHours:</label>#=NightHours#</li>" +
                                      "<li><label>HolidayHours:</label>#=HolidayHours#</li>" +
                                      "<li><label>RestdayHours:</label>#=RestdayHours#</li>" +
                                      "<li><label>From:</label>#=From#</li>" +
                                      "<li><label>To:</label>#=To#</li>" +
                                      "<li><label>Total Hour:</label>#=TotalHr#</li>" +
                                     "</ul>" +
                                      "</div>"
                                      );
                          }).ToClientTemplate()

                          )


                </text>


                  );
          }).ToClientTemplate() 
          )
</script>
