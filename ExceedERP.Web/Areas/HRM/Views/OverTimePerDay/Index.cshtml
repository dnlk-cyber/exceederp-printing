<script>
    function GetTotalOT() {
        //var From = $("#From").data("kendoTimePicker");

        var endPicker = $("#From").data("kendoTimePicker");
        var toPicker = $("#To").data("kendoTimePicker");
        var from = endPicker;
        var to = toPicker;

        $.ajax({
            url: '@Url.Action("GetTotalOt", "OverTimePerDay")',

            data: { from: from, to: to },
            type: 'POST',
            cache: false,
            success: function(result) {
                r = result;

                $("#TotalHr").val(r);
            }

        });
    }

</script>

<script>
    function Process() {


        var value = this.value(),
            grid = $("#OverTimePerDaygrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "TicketNumber", operator: "eq", value: parse(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>

