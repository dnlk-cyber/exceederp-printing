<script>
    function showLoader(show) {
        if (show) {
            $('#loading-image').show();
        } else {
            $('#loading-image').hide();
        }
    }

    function getDropDownValue(dropdownId) {
        return $("#" + dropdownId).data("kendoDropDownList").value();
    }

    function performAjaxAction(actionUrl, data, onSuccess, onError) {
        $.ajax({
            url: actionUrl,
            data: data,
            type: 'POST',
            cache: false,
            success: function (result) {
                if (onSuccess) onSuccess(result);
                showLoader(false);
            },
            error: function () {
                if (onError) onError();
                showLoader(false);
            }
        });
    }

    function Expire(e) 
    {
        showLoader(true);
        try {
            if (!confirm("Are you sure you want to expire this period's leave entitlements?")) {
                showLoader(false);
                return;
            }

            const period = getDropDownValue("GlFiscalYear");
            const employeeId = getDropDownValue("EmployeeId");

            if (!period) {
                alert("Please select a valid period first!");
                showLoader(false);
                return;
            }

            performAjaxAction(
                '@Url.Action("ExpireEntitle", "LeaveEntitle")',
                { period: period, employeeId: employeeId },
                function (result) {
                    alert(result.Message);
                    showLoader(false);
                    $("#LeaveEntitlegrid").data("kendoGrid").dataSource.read();
                },
                function () {
                    alert("Something went wrong. Please try again.");
                }
            );

        } catch (e) {
            alert("Unexpected error: " + e.message);
            showLoader(false);
        }
    }

    function ReverseExpire(e) {
        showLoader(true);
        try {
            const period = getDropDownValue("GlFiscalYear");
            const employeeId = getDropDownValue("EmployeeId");

            performAjaxAction(
                '@Url.Action("ReverseExpireEntitle", "LeaveEntitle")',
                { period: period, employeeId: employeeId },
                function (result)
                {
                    alert(result.Message);
                    showLoader(false);
                    $("#LeaveEntitlegrid").data("kendoGrid").dataSource.read();
                }
            );
        } catch (e) {
            showLoader(false);
            alert("Unexpected error: " + e.message);
        }
    }
</script>
