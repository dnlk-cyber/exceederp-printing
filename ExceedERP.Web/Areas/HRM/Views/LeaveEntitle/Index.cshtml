    function Refresh(e) {
        $('#loading-image').show();
        try {
            var Period = $("#GlFiscalYear").data("kendoDropDownList");
        var period = Period.value();
            var isChecked = $('#chkIsInclude').is(':checked');

            $.ajax({
                url: '@Url.Action("GetEmployeeLeaveEntitlemntNewAwaj", "LeaveEntitle")',
              //  contentType: "application/json; charset=utf-8",
                data: { check: isChecked , period: period },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    $('#loading-image').hide();
                    $("#LeaveEntitlegrid").data("kendoGrid").dataSource.read();

                }

            });
        } catch (e) {
            //alert("Please select the row!!");
        }

    }
