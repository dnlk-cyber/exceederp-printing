<script>

    function filterParam() {
        var period = $("#GlFiscalYear").data("kendoDropDownList")?.value();
        var employeeId = $("#LeaveEmployeeId").data("kendoDropDownList")?.value();
       
        return {
            yearId: period,
            empId: employeeId,

        };
    }

    function sync_handler(e) {
        this.read();

    }
    var employeeId = 0;
    var masterId = 0;
    function onDetailExpand(e)
    {
        var masterRow = e.masterRow;

        var masterGrid = $("#LeaveRequestgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.LeaveEntitleId;
        employeeId = masterDataItem.EmployeeId;

    }
    function filterEmployeeId() {
        return {
            id: $("#EmployeeId").val()
        };
    }
    function filterEmployees() {
        return {
            text: $("#LeaveEmployeeId").data("kendoDropDownList").filterInput.val(),
        }
    }
    function Refresh(e) {
    $('#loading-image').show();

    try {
        var period = $("#GlFiscalYear").data("kendoDropDownList")?.value();
        var employeeId = $("#LeaveEmployeeId").data("kendoDropDownList")?.value();

        $.ajax({
            url: '@Url.Action("GetEmployeeLeaveEntitlementNewAwaj", "LeaveEntitle")',
            type: 'POST',
            data: { period: period, employeeId: employeeId },
            cache: false,
            success: function (result) {
                $('#loading-image').hide();
                alert(result.Message);

                if (result.Status === "OK") {
                    $("#LeaveEntitlegrid").data("kendoGrid").dataSource.read();
                }
            },
            error: function (xhr, status, error) {
                $('#loading-image').hide();
                console.error("Error:", status, error, xhr.responseText);
                alert(xhr.responseText || error || "An error occurred while processing your request.");
            }
        });
    } catch (ex) {
        $('#loading-image').hide();
        console.error("Exception:", ex);
        alert("An unexpected error occurred. Please try again.");
    }
}

   
    function Check() {

    }
</script>

<script>
       function Expire(e) {
        $('#loading-image').show();
        try {
            if (confirm("Are you sure you want to expire this period's leave entitlements?")) {
                var period = $("#GlFiscalYear").data("kendoDropDownList")?.value();
                var employeeId = $("#LeaveEmployeeId").data("kendoDropDownList")?.value();

                if (!period) {
                    alert("Please select a valid period first!");
                    $('#loading-image').hide();
                    return;
                }

                $.ajax({
                    url: '@Url.Action("ExpireEntitle", "LeaveEntitle")',
                    data: { period: period, employeeId: employeeId },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        alert(result.Message);
                        $('#loading-image').hide();
                        $("#LeaveEntitlegrid").data("kendoGrid").dataSource.read();
                    },
                    error: function () {
                        alert("Something went wrong. Please try again.");
                        $('#loading-image').hide();
                    }
                });
            } else {
                $('#loading-image').hide();
            }

        } catch (e) {
            alert("Unexpected error: " + e.message);
            $('#loading-image').hide();
        }
    }

       function ReverseExpire(e) {
            $('#loading-image').show();
            try {
                var period = $("#GlFiscalYear").data("kendoDropDownList")?.value();
                var employeeId = $("#LeaveEmployeeId").data("kendoDropDownList")?.value();
                if (!period) {
                    alert("Please select a valid period first!");
                    $('#loading-image').hide();
                    return;
                }
                $.ajax({
                    url: '@Url.Action("ReverseExpireEntitle", "LeaveEntitle")',
                  //  contentType: "application/json; charset=utf-8",
                    data: { /*check: isChecked ,*/ period: period, employeeId: employeeId  },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        r = result;
                        $('#loading-image').hide();
                        $("#LeaveEntitlegrid").data("kendoGrid").dataSource.read();

                    }

                });
            } catch (e) {
                //alert("Please select the row!!");
            }

        }
    </script>
