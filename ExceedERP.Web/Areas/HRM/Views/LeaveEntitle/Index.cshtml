@using System.Collections
@using System.Collections
@using System.Security.AccessControl
@using ExceedERP.Core.Domain.HRM.LeaveManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorLeave_LeaveEntitlement</legend>
@(Html.Kendo().Grid<LeaveEntitle>()
    .Name("LeaveEntitlegrid")
    .Columns(columns =>
    {
        columns.Bound(c => c.EmployeeCode).Width(150);
        columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").Width(200).EditorTemplateName("EmployeeLists").Filterable(ftb => ftb.Multi(true).Search(true));
        columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branch"], "BranchId", "Name").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));//.Filterable(ftb => ftb.Multi(true).Search(true));
        columns.Bound(c => c.HireDate).Filterable(grp => grp.Search(false).Multi(false).Enabled(false)).Width(150);
        columns.Bound(c => c.Amount).Width(150);
        columns.Bound(c => c.Balance).Width(150);
        columns.Bound(c => c.SumOfAllEntitlement).Width(150);
        columns.Bound(c => c.SumOfAllBalances).Width(150);
        columns.Bound(c => c.Remark).Width(100);
        columns.Command(command =>
        {

            if (HttpContext.Current.User.IsInRole("HR_Leave_User"))
            {
                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
            }
            if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Leave_Admin"))
            {
                command.Destroy().Text(Resources.ActionButton_Cancel);
            }

        }).Width(200);

    })
    .ToolBar(toolbar =>
    {

           toolbar.Template(
            @<text>
                <div class="toolbar">
                    @if (HttpContext.Current.User.IsInRole("HR_Leave_User")
                        || HttpContext.Current.User.IsInRole("HR_Leave_Admin")
                        || HttpContext.Current.User.IsInRole("Leave_Entitlement_Admin"))
                        {
                        @item.CreateButton(Resources.ActionButton_AddNewRecord);


                    }
                
                    @(Html.Kendo().DropDownList()
                        .Name("GlFiscalYear")
                        .ValuePrimitive(true)
                        .OptionLabel(Resources.Select)
                        .DataTextField("Name")
                        .DataValueField("GlFiscalYearId")
                        .Filter("contains")
                        .DataSource(dataSource =>
                        {
                            dataSource.Read(read => read.Action("GetFisicalYear", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery"))
                            .ServerFiltering(false);
                        }))
                    @(Html.Kendo().DropDownListFor(model => model)
                            .Name("LeaveEmployeeId")
                            .DataValueField("EmployeeId")
                            .DataTextField("FullNameaEnglish")
                            .OptionLabel(Resources.Select + " " + Resources.Employee)
                            .Filter("contains")
                            // .MinLength(2)
                            .HtmlAttributes(new { style = "width:240px" })
                            .DataSource(source =>
                            {
                                source.Read(read => read.Action("GetAllEmployeesForPlacement", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery").Data("filterEmployees"))
                                .ServerFiltering(true);
                            })
                            .ValuePrimitive(true)
                    )
                    @if (HttpContext.Current.User.IsInRole("LeaveEntitlementManager"))
                    {
                        @(Html.Kendo().Button()
                                .Name("btnRefresh")
                                .HtmlAttributes(new { type = "button", @class = "k-primary" })
                                .Events(e => e.Click("Refresh"))
                                .Content(Resources.Generate_Leave_Entitlement))
                     }

                    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
                    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
                    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
                    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
                    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
                    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
                    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
                    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
                    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
                    @if (HttpContext.Current.User.IsInRole("LeaveExpire"))
                     {
                        @(Html.Kendo().Button()
                                .Name("btnExpire")
                                .HtmlAttributes(new { type = "button", @class = "k-primary" })
                                    .Events(e => e.Click("Expire"))
                                    .Content("Expire Leave"))




                     }
                       



                    @if (HttpContext.Current.User.IsInRole("LeaveExpireReverse"))
                     {
                       
                        @(Html.Kendo().Button().Name("btnReverseExpire")
                                                .HtmlAttributes(new { type = "button", @class = "k-primary" })
                                                .Events(e => e.Click("ReverseExpire"))
                                                .Content("Reverse Expire Leave"))

                    }
                       


                </div>
           </text>);


    })

    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("LeaveEntitlePop").Window(window => { window.Title("Leave Entitlement"); window.Scrollable(false); }))
    .Selectable(selectable =>
    {
        selectable.Mode(GridSelectionMode.Single);
        selectable.Type(GridSelectionType.Row);

    })
    .Scrollable(h => h.Height(500))
    .Sortable(sortable =>
    {
        sortable.SortMode(GridSortMode.SingleColumn);
    })
    .Events(ev=>ev.DetailExpand("onDetailExpand"))
    .Filterable()
        .Pageable(pageable => pageable
        .Input(true)
        .Numeric(false)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5))
.DataSource(dataSource => dataSource
.Ajax()
    .Events(events =>
    {
        events.Error("error_handler(\"LeaveEntitlegrid\")");
        events.RequestStart("onRequestStart(\"LeaveEntitlegrid\")");
        events.RequestEnd("onRequestEnd(\"LeaveEntitlegrid\")");


    })
    .Model(model =>
    {
        model.Id(p => p.LeaveEntitleId);
        model.Field(p => p.EmployeeCode).Editable(false);
        model.Field(p => p.TotlalAmount).Editable(false);
        model.Field(p => p.BranchId).Editable(false);
        model.Field(p => p.HireDate).Editable(false);
        //model.Field(p => p.Balance).Editable(false);
        model.Field(p => p.SumOfBalances).Editable(false);
        // model.Field(p => p.Amount).Editable(false);

    })
    .Read(read => read.Action("LeavesEntitle_New_Read", "LeaveEntitle").Data("filterParam"))
    .Create(create => create.Action("LeavesEntitle_Create", "LeaveEntitle").Data("sendForgery"))
    .Update(update => update.Action("LeavesEntitle_Update", "LeaveEntitle").Data("sendForgery"))
    .Destroy(destroy => destroy.Action("LeavesEntitle_Destroy", "LeaveEntitle").Data("sendForgery"))
).ClientDetailTemplateId("template")

)
