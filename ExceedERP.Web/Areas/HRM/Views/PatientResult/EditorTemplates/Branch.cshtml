@(Html.Kendo().DropDownListFor(m => m)
                  .ValuePrimitive(true)
                  .OptionLabel("Select")
                      .DataTextField("Name")
                          .DataValueField("BranchId")
                          .Filter("contains")
                                .DataSource(dataSource =>
                                {
                                    dataSource.Read(read => read.Action("GetBranchs", "APTSDataProvider"))
                                    .ServerFiltering(false);
                                })
)
@Html.ValidationMessageFor(m => m)
