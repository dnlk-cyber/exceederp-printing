@using System.Collections
@using ExceedERP.Helpers.Common
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.EmployeeDetail.Experience
@using ExceedERP.Core.Localization

<form>

<div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.EmployeeId, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>

               @(Html.Kendo().DropDownListFor(model => model.EmployeeId)
                       //  .Name("EmployeeId")
                                              .DataValueField("PersonId")
                        .DataTextField("FullName")
                           .OptionLabel("Select Employee..")
                            .Filter("contains")
                            .MinLength(2)
                            .HtmlAttributes(new { style = "width:100%" })
                                            .DataSource(source =>
                                              {
                                              source.Read(read => read.Action("GetEmployees", "HRMDataProvider"));


                                           })
                           .ValuePrimitive(true)


                                                  .Height(400)
                                                          .HeaderTemplate("<div class=\"dropdown-header k-widget k-header\">" +
                                        "<span>Photo</span>" +
                                        "<span>Full Name</span>" +
                                    "</div>")
                                                                                                                       .Template(@"<div class='Employee-photo' style='background-image: url(" + Url.Content("~/Content/Images/") + "#:data.PersonId#-Photo/" + "#:data.PersonId#.jpg" + ");'></div>" +
                                            "<div class='Employee-name'>#:FullName#</div>")



            )



            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.Organozation, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">
            @Html.Kendo().TextBoxFor(model => model.Organozation)
            @Html.ValidationMessageFor(model => model.Organozation, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.OrgFullAddress, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
