</script>
<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#DateAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "MedicalRequest")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#MedicalRequestgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.MedicalRequestId;
        var gridName = "#RequestesStatusgrid_" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatus", "MedicalRequestStatus")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                }
                else if (r == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else if (r == "Dapproved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", gridName).show();
                }

            }

        });

    }
    function SetEmployee(e) {
        var x = e.checked;
        var dropDown = $("#EmployeeId").data("kendoDropDownList");
        if (x == true) {

            dropDown.enable(true);


        }
        else {
            dropDown.value(0);
            dropDown.enable(false);
        }
        $.ajax({
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("SetEmployee", "MedicalRequest")',
            data: { x: x },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
                if (!x && !r) {
                    e.checked = false;
                    dropDown.value(0);
                    dropDown.enable(false);
                    alert("You can not request for other employee!!.\nThere is no employee under your postion.");
                }

            }

        });


    }
    function valueMapper(options) {
        $.ajax({
            url: "/HRM/HRMDataProvider/Employee_ValueMapper/",
            data: {
                value: options.value || 0,
                status: 1,
                excludeId: -1
            },
            success: function (data) {
                options.success(data);
            }
        });
    }

    function convertValues(value) {
        var data = {};

        value = $.isArray(value) ? value : [value];

        for (var idx = 0; idx < value.length; idx++) {
            data["values[" + idx + "]"] = value[idx];
        }

        return data;
    }
</script>