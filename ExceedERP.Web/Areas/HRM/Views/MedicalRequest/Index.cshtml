@using System.Collections
@using ExceedERP.Core.Domain
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization 
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorSelfCare_MedicalRequest</legend>
@(Html.Kendo().Grid<MedicalRequest>()
          .Name("MedicalRequestgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Width(200);
          columns.Bound(c => c.DateAmharic).Width(200);
          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["OrgStructureId"], "OrgStructureId", "Name").EditorTemplateName("Organization").Width(250);
          columns.Bound(c => c.Remark).Width(120);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                  .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("MedicalRequest").Window(window => { window.Title(Resources.NavigatorSelfCare_MedicalRequest); window.Scrollable(false); }))
        .Scrollable(h => h.Height(500))
                         .Groupable()
                                  .Sortable(sortable =>
                                  {
                                      sortable.SortMode(GridSortMode.SingleColumn);
                                  })
                      .Filterable()
                             .Events(events => events.DetailExpand("onDetailExpandUser"))
                      .Events(x => { x.Edit("GetDate");
                          x.Save("GetDate");})
                         .Pageable(pageable => pageable
                                                    .Input(true)
                                                    .Numeric(false)
                                                    .Refresh(true)
                                                    .PageSizes(true)
                                                    .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Events(events =>
               {
                   events.Error("error_handler(\"MedicalRequestgrid\")");
                   events.RequestStart("onRequestStart(\"MedicalRequestgrid\")");
                   events.RequestEnd("onRequestEnd(\"MedicalRequestgrid\")");
               })

          .Model(model => model.Id(p => p.MedicalRequestId))
          .Read(read => read.Action("MedicalRequest_Read", "MedicalRequest"))
          .Create(create => create.Action("MedicalRequest_Create", "MedicalRequest"))
          .Update(update => update.Action("MedicalRequest_Update", "MedicalRequest"))
          .Destroy(destroy => destroy.Action("MedicalRequest_Destroy", "MedicalRequest"))
          ).ClientDetailTemplateId("template")
      )
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("tabstrip_#=MedicalRequestId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text(Resources .HR_RequestStatus ).Content(
                @<text>
                   
                        @(Html.Kendo().Grid<RequestesStatus>()
                      .Name("RequestesStatusgrid_#=MedicalRequestId#")
      .Columns(columns =>
      {
          //columns.Bound(c => c.RequestId);
          columns.Bound(c => c.DateReqStatAm).Width(120);
          columns.Bound(c => c.Status).EditorTemplateName("Enum").Width (200);
          columns.ForeignKey(c => c.ApproverId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(c => c.ApproverDepartment, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.Remark).Width (100);
          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(400);
      })
      .ToolBar(toolbar =>
      {
          //if (HttpContext.Current.User.IsInRole(HrmConstants.HRDepartmentHead) || HttpContext.Current.User.IsInRole(HrmConstants.HRAdmin))
          //{
          //    toolbar.Create().Text( "Take Action");
          //}

          toolbar.Custom().Action("SendForApproval", "MedicalRequest").Text(Resources .HR_Send_For_Approval );
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
                  .Events(events =>
                  {
                      events.Error("error_handler(\"RequestesStatusgrid_#=MedicalRequestId#\")");
                      events.RequestStart("onRequestStart(\"RequestesStatusgrid_#=MedicalRequestId#\")");
                      events.RequestEnd("onRequestEnd(\"RequestesStatusgrid_#=MedicalRequestId#\")");
                  })

                  .Model(model =>
                  {
                      model.Id(p => p.RequestStatusId);
                      model.Field(p => p.Date).Editable(false).DefaultValue(DateTime.Today);
                      model.Field(p => p.ApproverId).Editable(false);
                      model.Field(p => p.ApproverDepartment).Editable(false);
                  })

                                        .Read(read => read.Action("RequestesStatus_Read", "RequestesStatus", new { id = "#=MedicalRequestId#", referenceType = "Medical" }))
                                          .Create(create => create.Action("RequestesStatus_Create", "RequestesStatus", new { id = "#=MedicalRequestId#", referenceType2 = "Medical" }))
                                  .Update(update => update.Action("RequestesStatus_Update", "RequestesStatus"))
                                  .Destroy(destroy => destroy.Action("RequestesStatus_Destroy", "RequestesStatus"))
      ).ToClientTemplate()
                    )


                </text>
                  );
              //*****************************************************************************************************//

          }).ToClientTemplate())
</script>
