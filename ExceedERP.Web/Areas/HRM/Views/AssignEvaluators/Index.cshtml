          {

              columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameEng").EditorTemplateName("EmployeeList").Width(260);
              columns.Bound(c => c.IsConfirmed).ClientTemplate(
                                     "<input type='checkbox' disabled = 'true' value='\\#= IsConfirmed\\#' " +
                                     "\\# if (IsConfirmed) { \\#" +
                                     "checked='checked'" +
                                     "\\# } \\#" +
                                     "/>"
                                     ).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(75);
              columns.Command(command =>
              {
                  command.Edit();
                  command.Custom("cmd-confirm").IconClass("fa fa-check ").Text("Confirm").Click("InternalCustomerAssignmentConfirmation").HtmlAttributes(new { @class = "btn btn-success" });

                  command.Destroy();
