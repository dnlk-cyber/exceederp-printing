    <script>

        var OrgStructureId_Global = 0;
        var IsSendForApproval_Global = false;
        var IsTransfered_Global = false;

        function onDetailExpandUser(e) {

            var masterRow = e.masterRow;
            var masterGrid = e.sender;
          //  var masterGrid = $("#InternalCustomergrid_").data("kendoGrid");

            var masterDataItem = masterGrid.dataItem(masterRow);

            OrgStructureId_Global = masterDataItem.OrgStructureId;
            IsSendForApproval_Global = masterDataItem.IsSendForApproval;
            IsTransfered_Global = masterDataItem.IsTransfered;

            masterId = masterDataItem.InternalCustomerPerformanceEvaluationId;


            var gridName = "#InternalCustomergrid_" + masterId;



            if (masterDataItem.IsSendForApproval) {

                $(gridName).find(".k-toolbar").hide(); //hide toolbar
                $(".k-grid-top", gridName).hide();
            }

            if (IsTransfered_Global) {

                $(gridName).find(".k-toolbar").hide(); //hide toolbar
                $(".k-grid-top", gridName).hide();
            }

        }



        function filterEmployees() {
            return {
                OrgStructureId: OrgStructureId_Global
            };
        }


        function onDetailDataBound(e) {

            var rows = e.sender.tbody.children();


            for (var j = 0; j < rows.length; j++) {

                var row = $(rows[j]);

                var dataItem = e.sender.dataItem(row);

                if (IsSendForApproval_Global) {
                    row.css("background-color", "lightGreen");

                    row.find(".k-grid-edit").hide();
                    row.find(".k-grid-delete").hide();
                }

                if (IsTransfered_Global) {
                    row.css("background-color", "gray");
                    row.css("color", "white");

                    row.find(".k-grid-edit").hide();
                    row.find(".k-grid-delete").hide();
                }

            }

        }
        function onPeerToPeerDataBound(e)
        {
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++)
        {

            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsAsignmentApproved) {
                row.css("background-color", "lightGreen");

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-cmd-confirm").hide();
            }
            
        }

    }

    function onInternalCustomerDataBound(e)
    {
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++)
        {

            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsConfirmed) {
                row.css("background-color", "lightGreen");

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-cmd-confirm").hide();
            }
            
        }

    }

    </script>
    
<script>
    function AssignmentConfirmation(e)
    {

        var grid = this,
                dataItem = grid.dataItem(e.currentTarget.closest("tr"));

        var id = dataItem.PeerToPeerPerformanceEvaluationId;
        var conf = confirm("Are you sure you want to approve this quarter performance evaluation");
        if (conf === true)
        {
            $('#loading-image').show();
            $.ajax({
                    url: '@Url.Action("PeerToPeerEvaluatorConfirmation", "PeerToPeerPerformanceEvaluations")',
                    data: { id: id },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        alert(result.Message);
                        $('#loading-image').hide();
                        grid.dataSource.read();




                },
                error: function (xhr, status, error) {
                            $('#loading-image').hide();
                            alert("An error occurred: " + error);

                }



            });
            
        }
        
    }
    
    function InternalCustomerAssignmentConfirmation(e)
    {

        var grid = this,
                dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        var id = dataItem.InternalCustomerId;
        var conf = confirm("Are you sure you want to Confirm ");
        if (conf === true)
        {
                $('#loading-image').show();
                $.ajax({
                        url: '@Url.Action("InternalCustomerConfirmation", "InternalCustomers")',
                        data: { id: id },
                        type: 'POST',
                        cache: false,
                        success: function (result) {
                            alert(result.Message);
                            $('#loading-image').hide();
                            grid.dataSource.read();
                        },
                        error: function (xhr, status, error) {
                            $('#loading-image').hide();
                            alert("An Error occurred: " + error);
                        }
                });
            }

    }
</script>