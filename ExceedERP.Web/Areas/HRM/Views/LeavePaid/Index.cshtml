@using System.Collections
@using ExceedERP.Core.Domain.HRM.LeaveManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorLeave_LeavePaidInCash</legend>
@(Html.Kendo().Grid<LeavePaid>()
          .Name("LeavePaid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(200);
          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Width(120);
          columns.Bound(c => c.Amount).Width(200);
          columns.Bound(c => c.Remark).Width(100);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Leave_User"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Leave_Admin"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("HR_Leave_User"))
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
          if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Leave_Admin"))
          
          {
              toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
              toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
          }
      })
            .Excel(excel => excel
                                            .FileName(Resources.NavigatorLeave_LeavePaidInCash + ".xlsx")
                                .Filterable(true)
                                    .AllPages(true)
                                                    .ProxyURL(Url.Action("Excel_Export_Save", "LeavePaid"))
                            )
                                 .Pdf(pdf => pdf
                                .AllPages()
                                                .FileName(Resources.NavigatorLeave_LeavePaidInCash + ".pdf")
                                                    .ProxyURL(Url.Action("Pdf_Export_Save", "LeavePaid"))
                            )
        .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Scrollable(h => h.Height(500))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Filterable()
        .Pageable(pageable => pageable
                    .Input(true)
                    .Numeric(false)
                    .Refresh(true)
                    .PageSizes(true)
                    .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
              .Events(events =>
     {
         events.Error("error_handler(\"LeavePaid\")");
         events.RequestStart("onRequestStart(\"LeavePaid\")");
         events.RequestEnd("onRequestEnd(\"LeavePaid\")");
     })
                     
          .Model(model => { model.Id(p => p.LeavePaidId);
           model.Field(p => p.EmployeeCode).Editable (false);})
          .Read(read => read.Action("LeavePaid_Read", "LeavePaid"))
          .Create(create => create.Action("LeavePaid_Create", "LeavePaid"))
          .Update(update => update.Action("LeavePaid_Update", "LeavePaid"))
          .Destroy(destroy => destroy.Action("LeavePaid_Destroy", "LeavePaid"))
      )
)
