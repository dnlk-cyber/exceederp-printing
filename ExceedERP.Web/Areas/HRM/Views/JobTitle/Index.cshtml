        margin: 0 auto;
        box-sizing: border-box;
        box-shadow: 0 5px 10px 0 rgba(0,0,0,.3);
        background-color: #fff;
        color: #333;
        position: relative;
        /*font-family:  "DejaVu Sans", "Arial", sans-serif,"Nyala";*/
