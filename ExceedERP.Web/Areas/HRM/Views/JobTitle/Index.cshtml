@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.Navigator_Company_MaintainJobTitle</legend>
@(Html.Kendo().Grid<Lookup>()
              .Name("Lookupgrid")
          .Columns(columns =>
          {
  // columns.Bound(c => c.Code);
  //  columns.Bound(c => c.Category);
  // columns.Bound(c => c.Index);
  // columns.Bound(c => c.LookupType);
  columns.Bound(c => c.Description);
  // columns.Bound(c => c.IsDefault);
  // columns.Bound(c => c.IsActive);
  columns.Bound(c => c.Remark);
              columns.Command(command =>
              {
                  if (HttpContext.Current.User.IsInRole("HR_Company_User"))
                  {
                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  }
                  if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Company_Admin"))
                  {
                      command.Destroy().Text(Resources.ActionButton_Cancel);//
      }
              }).Width(200);
          })
          .ToolBar(toolbar =>
          {

              toolbar.Template(@<text>
                <div class="toolbar" style="">
                    @if (HttpContext.Current.User.IsInRole("HR_Company_User"))
                                {
                        @item.CreateButton(Resources.ActionButton_AddNewRecord)

                                }
                    
                    @if (HttpContext.Current.User.IsInRole("HR_Company_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
                                {

                        @item.CustomCommandToolBarButton("Excel", "<span class='k-icon k-i-excel'></span>" + Resources.ActionButton_ExportExcel, "Excel_Export_Save", "JobTitle", "", new { @class = "k-button k-button-icontext k-grid-excel btn btn-primary btn-xs pull-right" });
                        @item.CustomCommandToolBarButton("PDF", "<span class='k-icon k-i-pdf'></span>" + Resources.ActionButton_ExportPDF, "Pdf_Export_Save", "JobTitle", "", new { @class = "k-button k-button-icontext k-grid-pdf  btn btn-primary btn-xs pull-right" });
                        @(Html.Kendo().Button()
                      .Name("btnDownLoad")
                           .HtmlAttributes(new { type = "button", @class = "k-primary btn btn-primary btn-xs pull-right" })
                      .Events(e => e.Click("DownLoadTemplate"))
                                      .Content(Resources.DownloadTemplate))
                        <br>
                        @(Html.Kendo().Upload()

                      .Name("file")
                                      .Async(a => a.Save("JobTitle_Import", "JobTitle"))
                      .Events(e => e.Complete("onUploadSuccess").Upload("checkFileType"))
                                //.ShowFileList(false).
                                //  .HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-left" })
                                // .HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" })
                        )


                                }
                   
                </div>
            </text>);

                })
                    .Excel(excel => excel
                                 .FileName(Resources.Navigator_Company_MaintainJobTitle + ".xlsx")
                                      .Filterable(true)
                                                      .AllPages(true)
                                          //  .ProxyURL(Url.Action("Excel_Export_Save", "JobTitle"))
                                          )
                                               .Pdf(pdf => pdf
                                              .AllPages()
                                            .FileName(Resources.Navigator_Company_MaintainJobTitle + ".pdf")
                                          // .ProxyURL(Url.Acion("Pdf_Export_Save", "JobTitle"))
                                          )
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                   .Selectable(selectable =>
                       {
                           selectable.Mode(GridSelectionMode.Single);
                           selectable.Type(GridSelectionType.Row);
                       })
                           .Scrollable(h => h.Height(500))
                               .Groupable()
                                        .Sortable(sortable =>
                                        {
                                            sortable.SortMode(GridSortMode.SingleColumn);
                                        })
                            .Filterable()
                               .Pageable(pageable => pageable
                                                          .Input(true)
                                                          .Numeric(false)
                                                          .Refresh(true)
                                                          .PageSizes(true)
                                                          .ButtonCount(5))
                .DataSource(dataSource => dataSource
                    .Ajax()
                                         .Events(events =>
          {

              events.Error("error_handler(\"Lookupgrid\")");
              events.RequestStart("onRequestStart(\"Lookupgrid\")");
              events.RequestEnd("onRequestEnd(\"Lookupgrid\")");
          })


                    .Model(model => model.Id(p => p.LookupId))
                        .Read(read => read.Action("Lookups_Read", "JobTitle"))
                        .Create(create => create.Action("Lookups_Create", "JobTitle"))
                        .Update(update => update.Action("Lookups_Update", "JobTitle"))
                        .Destroy(destroy => destroy.Action("Lookups_Destroy", "JobTitle"))
                )
)

<script>
    //function error_handler(e) {
    //    if (e.errors) {
    //        var message = "Errors:\n";
    //        $.each(e.errors, function(key, value) {
    //            if ('errors' in value) {
    //                $.each(value.errors, function() {
    //                    message += this + "\n";
    //                });
    //            }
    //        });
    //        alert(message);

    //    }

    //}

    function sync_handler(e) {
        this.read();

    }

    function onUploadSuccess(e) {
        $("#Lookupgrid").data("kendoGrid").dataSource.read();
        $("#Lookupgrid").data("kendoGrid").refresh();
    }

    function checkFileType(e) {
        var files = e.files;

        $.each(files, function () {

            if (this.extension.toLowerCase() === ".xls" || this.extension.toLowerCase() === ".xlsx" || this.extension.toLowerCase() === ".xlsm") {

            } else {
                alert("Only .xls, .xlsx, .xlsm files can be uploaded!");
                e.preventDefault();
            }

        });
    }

    function DownLoadTemplate(e) {
        try {


            var wnd = $("#AttachmentWindow").data("kendoWindow");
            wnd.center().open();

        } catch (ex) {
            // alert("Please select the row!!");
        }

    }
    function bb() {
        alert("export to pdf");
    }
    $(document.body).keypress(function (e) {
        if (e.keyCode === 13) {
            var grid = $("#Lookupgrid").data("kendoGrid");
            grid.addRow();
        }
    });
</script>
@(Html.Kendo().Window().Name("AttachmentWindow")
            .Title(Resources.Templates)
        .Visible(false)
        .Modal(true)
          .Content(@<text>

            @(Html.Kendo().Grid<Attachment>()
                              .Name("AttachmentGrid")
                      .Columns(columns =>
                      {
                                columns.Bound(c => c.Description); //.Title("File Name").ClientTemplate((@Html.ActionLink("#=Description#", "DownloadFile", "DownloadDocument", new { filename = "#=Description#" }, null).ToHtmlString()));
                    columns.Bound(c => c.FileType).ClientTemplate(Html.ActionLink("DownLoad", "DownloadFile", new { area = "HRM", filename = "#=Description#" }).ToHtmlString());

                            })

                          .Scrollable()
                          .Selectable()
                          .DataSource(dataSource => dataSource
                              .Ajax()
                                                       .Events(events => events.Error("error_handler(\"AttachmentGrid\")"))

                              .Model(model => model.Id(p => p.AttachmentId))
                                              .Read(read => read.Action("Attachments_Read", "Attachment", new { Area = "Common", attachmentReferenceType = "TEMPLATE", id = 0 }))


                          )
            )

        </text>).Width(500)
)
<style>
