    .k-pdf-export .pdf-header {
        position: absolute;
        top: .5in;
        height: .6in;
        left: .5in;
        right: .5in;
        border-bottom: 1px solid #e5e5e5;
    }

    .k-grid {
        /*font-family: "DejaVu Sans", "Arial", sans-serif,"nyala";*/
    }

    .k-pdf-export {
        font-family: "Nyala","DejaVu Sans";
    }

    .k-widget {
        font-family: "Nyala","DejaVu Sans"
    }
</style>




<script type="text/javascript">
    $(document).ready(function () {
       // var ApiUrl = "http://localhost:50537/";
        $.ajax({
            url: '@Url.Action("GetDescription", "JobTitle")',
            type: "Get",
            dataType: 'json',
            contentType: 'application/json; charset=utf-8',
            success: function (result) {
                $("#Description").kendoAutoComplete({
                    clearButton: true,
                    dataSource: result,
                    filter: "startswith",
                    dataTextField: "Description",
                    minLength: 1,
                    placeholder: "Enter Description ...",
                });
            }
        });
    });
</script>  