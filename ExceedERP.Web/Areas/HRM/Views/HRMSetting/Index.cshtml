<script>
    function filterCategories()
    {
        return {
            Reference: $("#Reference").val()
        };
    }

    function onDataBound(e)
    {
        var grid = e.sender;
        var dataItems = grid.dataSource.data();
        grid.tbody.find("tr").each(function (index) {
            var row = $(this);
            var dataItem = grid.dataItem(row);

            if (dataItem) {
                var button = row.find(".k-grid-ToggleActive"); // Find the button by the command name
                if (dataItem.IsActive) {
                    // Item is active, set button to deactivate
                    button.removeClass("btn-success").addClass("btn-danger");
                    button.find(".fa").removeClass("fa-toggle-on fa-check").addClass("fa-toggle-off fa-ban");
                    button.text(" Deactivate"); // Note: the icon is separate, so we set the text next to the icon
                    button.attr("title", "Deactivate");
                } else {
                    // Item is inactive, set button to activate
                    button.removeClass("btn-danger").addClass("btn-success");
                    button.find(".fa").removeClass("fa-toggle-off fa-ban").addClass("fa-toggle-on fa-check");
                    button.text(" Activate");
                    button.attr("title", "Activate");
                }
            }
        });
    }

    function enableOrDisableActive(e)
    {

        var row = $(e.target).closest("tr");
        var grid = $("#HolidayGiftRateSettinggrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.HolidayGiftRateSettingId;
        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("EnableOrDisable", "HolidayGiftRateSetting")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                r = result;
                alert(r.Message);
                $('#loading-image').hide();
                grid.dataSource.read();
                }
                });


        }



    }

    function enableOrDisableTerminationActive(e)
    {

        var row = $(e.target).closest("tr");
        var grid = $("#TerminationSettinggrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.TerminationSettingId;
        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("EnableOrDisable", "TerminationSettings")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                r = result;
                alert(r.Message);
                $('#loading-image').hide();
                grid.dataSource.read();
                }
                });

                }



    }
</script>
