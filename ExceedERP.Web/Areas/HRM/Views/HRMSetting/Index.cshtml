<style>
    .hrm-setting-wrapper {
        max-width: 100%;
    }

        .hrm-setting-wrapper .hrm-setting-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
        }

            .hrm-setting-wrapper .hrm-setting-header i {
                color: #fff;
                background: #337ab7;
                width: 34px;
                height: 34px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
            }

            .hrm-setting-wrapper .hrm-setting-header h3 {
                margin: 0;
                font-weight: 600;
                color: #2c3e50;
            }

        .hrm-setting-wrapper > .k-tabstrip {
            border: none;
            background: transparent;
        }

            .hrm-setting-wrapper > .k-tabstrip > .k-tabstrip-items {
                border-bottom: 2px solid #e3e6ea;
                padding: 0 2px;
                flex-wrap: wrap;
            }

                .hrm-setting-wrapper > .k-tabstrip > .k-tabstrip-items .k-item {
                    border: none;
                    background: transparent;
                    margin-right: 4px;
                    font-weight: 600;
                    color: #5a6b7b;
                }

                    .hrm-setting-wrapper > .k-tabstrip > .k-tabstrip-items .k-item.k-state-active {
                        color: #337ab7;
                        border-bottom: 3px solid #337ab7;
                        background: transparent;
                    }

                    .hrm-setting-wrapper > .k-tabstrip > .k-tabstrip-items .k-item:hover {
                        color: #337ab7;
                    }

        .hrm-setting-wrapper .k-content {
            background: #fff;
            border: 1px solid #e3e6ea;
            border-top: none;
            border-radius: 0 0 6px 6px;
            padding: 18px 20px;
        }

        .hrm-setting-wrapper legend {
            font-size: 15px;
            font-weight: 600;
            color: #2c3e50;
            border-bottom: 2px solid #337ab7;
            padding-bottom: 6px;
            margin-bottom: 14px;
            width: auto;
            display: inline-block;
            min-width: 260px;
        }

        .hrm-setting-wrapper .k-grid {
            border-radius: 6px;
            overflow: hidden;
            border: 1px solid #e3e6ea;
        }

            .hrm-setting-wrapper .k-grid .k-grid-header {
                background: #f8f9fb;
            }

        .hrm-setting-wrapper .k-toolbar.k-grid-toolbar {
            background: #f8f9fb;
            border-color: #e3e6ea;
        }
</style>
<div class="hrm-setting-wrapper">
    <div class="hrm-setting-header">
        <i class="fa fa-cogs"></i>
        <h3>@Resources.NavigatorHRMSetting</h3>
    </div>
@(Html.Kendo().TabStrip()
     .Name("tabstrip")
     .Animation(animation =>
        animation.Open(effect =>
        effect.Fade(FadeDirection.In)))
     .Items(tabstrip =>
     {

       tabstrip.Add().Text(Resources.NavigatorHRMSetting)
        .Selected(true)
        .Content(@<text>
            <legend>@Resources.NavigatorHRMSetting</legend>
            @(Html.Kendo().Grid<Configuration>()
                .Name("ConfigurationGrid")
                .Columns(columns =>
                {
                    columns.Bound(c => c.Reference).EditorTemplateName("Categories").Width(200).ClientGroupHeaderTemplate("Setting");

                    columns.Bound(c => c.Attribute).EditorTemplateName("Attribute").Width(300);
                    columns.Bound(c => c.CurrentValue).Width(150);
                    columns.Command(command =>
                    {
                        command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                        command.Destroy().Text(Resources.ActionButton_Cancel);

                    }).Width(200);


                })
                .ToolBar(toolbar =>
                {
                    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);


                })
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                    .Scrollable(h => h.Height(500))
                            .Groupable()
                                    .Sortable(sortable =>
                                    {
                                        sortable.SortMode(GridSortMode.SingleColumn);
                                    })
                        .Filterable()
                            .Pageable(pageable => pageable
                                                    .Input(true)
                                                    .Numeric(false)
                                                    .Refresh(true)
                                                    .PageSizes(true)
                                                    .ButtonCount(5))
                .DataSource(dataSource => dataSource
                    .Ajax()
                        .Events(events =>
                        {
                            events.Error("error_handler(\"ConfigurationGrid\")");
                            events.RequestStart("onRequestStart(\"ConfigurationGrid\")");
                            events.RequestEnd("onRequestEnd(\"ConfigurationGrid\")");

                        })
                        .Model(model => model.Id(p => p.ConfigurationId))
                        .Read(read => read.Action("Configurations_Read", "HRMSetting").Data("sendForgery"))
                            .Create(create => create.Action("Configurations_Create", "HRMSetting", new { Attribute = "#=Attribute#", CurrentValue = "#=CurrentValue#" }).Data("sendForgery"))
                        .Update(update => update.Action("Configurations_Update", "HRMSetting").Data("sendForgery"))
                        .Destroy(destroy => destroy.Action("Configurations_Destroy", "HRMSetting").Data("sendForgery"))
                    ))


                       
            </text>);



