                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                                    .Events(events =>
                                    {
                                                events.Error("error_handler(\"EmployeeCodeSettinggrid\")");
                                                events.RequestStart("onRequestStart(\"EmployeeCodeSettinggrid\")");
                                                events.RequestEnd("onRequestEnd(\"EmployeeCodeSettinggrid\")");
                                            }
                                )

                                .Model(model =>
                                {
                                            model.Id(p => p.EmployeeCodeSettingId);
                                //model.Field(p => p.Remark).Editable(false);
                            })
                            .Read(read => read.Action("EmployeeCodeSetting_Read", "EmployeeCodeSetting").Data("sendForgery"))
                            .Create(create => create.Action("EmployeeCodeSetting_Create", "EmployeeCodeSetting").Data("sendForgery"))
                            .Update(update => update.Action("EmployeeCodeSetting_Update", "EmployeeCodeSetting").Data("sendForgery"))
                            .Destroy(destroy => destroy.Action("EmployeeCodeSetting_Destroy", "EmployeeCodeSetting").Data("sendForgery"))
                        )
