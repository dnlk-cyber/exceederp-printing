@using System.Collections
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPayroll_OverTimeRequests</legend>
@(Html.Kendo().Grid<OverTimeRequest>()
              .Name("OverTimeRequestgrid")
          .Columns(columns =>
          {
              columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["organization"], "OrgStructureId", "Name")
                            .EditorTemplateName("OrgSelector")
                            .Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
              columns.Bound(c => c.Description);

              columns.Bound(c => c.FromDateAm);
              columns.Bound(c => c.ToDateAm);
              columns.Bound(c => c.FromTime);
              columns.Bound(c => c.ToTime);
              columns.Bound(c => c.TotalHours).Width(100);
              columns.Bound(c => c.TotalDays).Width(100);
              columns.Bound(c => c.GrandTotalHours).Width(120);
              columns.Bound(c => c.ConvertedTotalDays).Width(120);


          })
          .ToolBar(toolbar =>
          {
          })
               .Events(events => {
                   events.DataBound("onDataBound"); ;
                   events.DetailExpand("onDetailExpandUser");
               })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
             .Scrollable(h => h.Height(500))
             .Groupable()
             .Sortable(sortable =>
             {
                 sortable.SortMode(GridSortMode.SingleColumn);

             })
             .Filterable()
             .Pageable(pageable => pageable
                                                         .Input(true)
                                                         .Numeric(false)
                                                         .Refresh(true)
                                                         .PageSizes(true)
                                                         .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Sort(sort => sort.Add("OverTimeRequestId").Descending())
                    .Events(events =>
                    {
                        events.Error("error_handler(\"OverTimeRequestgrid\")");
                        events.RequestStart("onRequestStart(\"OverTimeRequestgrid\")");
                        events.RequestEnd("onRequestEnd(\"OverTimeRequestgrid\")");
                    })

              .Model(model => model.Id(p => p.OverTimeRequestId))
              .Read(read => read.Action("OverTimeRequest_Read", "OverTimeRequests").Data("sendForgery"))
              .Create(create => create.Action("OverTimeRequest_Create", "OverTimeRequests").Data("sendForgery"))
              .Update(update => update.Action("OverTimeRequest_Update", "OverTimeRequests").Data("sendForgery"))
              .Destroy(destroy => destroy.Action("OverTimeRequest_Destroy", "OverTimeRequests").Data("sendForgery"))
                  ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("tabstrip_#=OverTimeRequestId#")
                  .SelectedIndex(0)
                  .Items(items =>
                  {


                  items.Add().Text(Resources.HR_SelfCare_OverTimeRequest_Emploees).Content(
        @<text>
            @(Html.Kendo().Grid<OverTimeRequestEmployee>()
                        .Name("OverTimeRequestEmployee#=OverTimeRequestId#")
                        .Columns(columns =>
                        {

                            columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode")
                                        .EditorTemplateName("ListOfEmployee")
                                        .Filterable(ftb => ftb.Search(true)).Width(300);

                            columns.Bound(c => c.Remark);
                            columns.Command(command =>
                            {
                                // command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                command.Destroy().Text(Resources.ActionButton_Cancel);//
                            }).Width(180);

                        })
                        .ToolBar(toolbar =>
                        {
                            // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

                        })
                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .Scrollable()
                        .Filterable()
                        .Events(x => x.DataBound("onDataBoundValidationPM"))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Events(events =>
                            {
                                events.Error("error_handler(\"OverTimeRequestEmployee#=OverTimeRequestId#\")");
                                events.RequestStart("onRequestStart(\"OverTimeRequestEmployee#=OverTimeRequestId#\")");
                                events.RequestEnd("onRequestEnd(\"OverTimeRequestEmployee#=OverTimeRequestId#\")");


                            })
                            .Model(model =>
                            {
                                model.Id(p => p.OverTimeRequestEmployeeId);


                            })
                      .Read(read => read.Action("OverTimeRequestEmployee_Read", "OverTimeRequestEmployee", new { id = "#=OverTimeRequestId#" }).Data("sendForgery"))
                      .Create(create => create.Action("OverTimeRequestEmployee_Create", "OverTimeRequestEmployee", new { id = "#=OverTimeRequestId#" }).Data("sendForgery"))
                      .Update(update => update.Action("OverTimeRequestEmployee_Update", "OverTimeRequestEmployee").Data("sendForgery"))
                      .Destroy(destroy => destroy.Action("OverTimeRequestEmployee_Destroy", "OverTimeRequestEmployee").Data("sendForgery"))
                                            ).ToClientTemplate()
            )


        </text>);
              items.Add().Text(Resources.HR_RequestStatus).Content(
                @<text>
                    @(Html.Kendo().Grid<RequestesStatus>()
                                .Name("RequestesStatusgrid_#=OverTimeRequestId#")
                                .Columns(columns =>
                                {
                                    //columns.Bound(c => c.RequestId);
                                    columns.Bound(c => c.DateReqStatAm).Width(150);
                                    columns.Bound(c => c.Status).EditorTemplateName("Enum").Width(300);
                                    //columns.Bound(c => c.Remark).Width(150);
                                    columns.Command(command =>
                                    {
                                        command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                        command.Destroy().Text(Resources.ActionButton_Cancel);
                                    }).Width(180);
                                })
                                .ToolBar(toolbar =>
                                {
                                    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

                                })
                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .Scrollable()
                                .Events(x => x.DataBound("onDataBoundValidationPM"))
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Events(events =>
                                    {
                                        events.Error("error_handler(\"RequestesStatusgrid_#=OverTimeRequestId#\")");
                                        events.RequestStart("onRequestStart(\"RequestesStatusgrid_#=OverTimeRequestId#\")");
                                        events.RequestEnd("onRequestEnd(\"RequestesStatusgrid_#=OverTimeRequestId#\")");
                                    })
                                   .Model(model =>
                                   {
                                       model.Id(p => p.RequestStatusId);
                                       model.Field(p => p.Date).Editable(false).DefaultValue(DateTime.Today);
                                   })
                       .Read(read => read.Action("RequestesStatus_Read", "RequestesStatus", new { id = "#=OverTimeRequestId#", referenceType = "OverTime" }).Data("sendForgery"))

                        .Create(create => create.Action("RequestesStatus_Create", "RequestesStatus", new { area = "HRM", id = "#=OverTimeRequestId#", referenceType2 = "OverTime", reference = "hrApprover" }).Data("sendForgery"))

                       .Update(update => update.Action("RequestesStatus_Update", "RequestesStatus").Data("sendForgery"))
                       .Destroy(destroy => destroy.Action("RequestesStatus_Destroy", "RequestesStatus").Data("sendForgery"))

                        ).ToClientTemplate())



                </text>);
                  }).ToClientTemplate())
</script>

<script>
    function sync_handler(e) {
        this.read();
    }
    var IsSendForApproval = false;
    var isOnlineApproved = false;
    var masterId = 0;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;
        var masterGrid = $("#OverTimeRequestgrid").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.OverTimeRequestId;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineApproved = masterDataItem.IsOnlineApproved;
        var gridName = "#RequestesStatusgrid_" + masterId;

        // Master already fully (online) approved: lock down add/edit/destroy regardless of status check
        if (masterDataItem.IsOnlineApproved) {
            $(gridName).find(".k-toolbar").hide();
            $(".k-grid-top", gridName).hide();
            $(".k-grid-add", gridName).hide();
            $(".k-grid-edit", gridName).hide();
            $(".k-grid-delete", gridName).hide();
            return;
        }

        $.ajax({
            url: '@Url.Action("CheckStatus", "OverTimeRequest")',
            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                //if (r == "true") {
                //    $(gridName).find(".k-toolbar").hide();
                //    $(".k-grid-add", gridName).hide();
                //}
                //else if (r == "approved") {
                //    $(gridName).find(".k-toolbar").hide();
                //    $(".k-grid-top", gridName).hide();
                //    $(".k-grid-edit", gridName).hide();
                //    $(".k-grid-delete", gridName).hide();
                //}
               
            }
        });
    }

    function onDataBoundValidationPM(e) {
        var detailGrid = "#" + e.sender.element[0].id;
        if (isOnlineApproved == true) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-upload-button", detailGrid).hide();
            $(".k-dropzone", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();

        }
        this.table.find(".k-grid-edit").hide();
        this.table.find(".k-grid-delete").hide();

    }
    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (model.IsOnlineApproved) {

                $(this).css("background-color", "darkgrey");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            else if (model.Status === "DEPARTMENT_APPROVAL" || model.IsSendForApproval ) {
                $(this).css("background-color", "limegreen");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
           
            else {
                $(this).find(".k-grid-edit").show();
                $(this).find(".k-grid-delete").show();



            }
        });
    }

</script>

