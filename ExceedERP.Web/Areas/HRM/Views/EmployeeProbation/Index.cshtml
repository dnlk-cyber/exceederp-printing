@using System.Collections
@using System.Security.AccessControl
@using ExceedERP.Core.Domain.HRM.Prohibition
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorRecruitment_Prohabition</legend>

@(Html.Kendo().Grid<Prohibition>()
              .Name("Prohibitiongrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("ActiveEmployees").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
          columns.Bound(c => c.EndDateAm).EditorTemplateName ("Calander").Width (150);
          columns.Bound(c => c.LookupId ).EditorTemplateName("Enum").Width (150);
          columns.Bound(c => c.EvaluationResult).Width (150);
          columns.ForeignKey(c => c.Decision, (IEnumerable)ViewData["Decistion"], "LookupId", "Description").EditorTemplateName("ProbationType").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);

          columns.Bound(c => c.Remark).Width(120);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("HR_Recruitment_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          })/*.Width(200)*/;
      })
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
             .Groupable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
               .Events(x =>
               {
                   x.Edit("GetDate");
                   x.Save("GetDate");
               })
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Events(events =>
               {
                   events.Error("error_handler(\"Prohibitiongrid\")");
                   events.RequestStart("onRequestStart(\"Prohibitiongrid\")");
                   events.RequestEnd("onRequestEnd(\"Prohibitiongrid\")");
               })

              .Model(model => { model.Id(p => p.ProhibitionId);
                  model.Field(p => p.EmployeeCode).Editable (false);})
                              .Read(read => read.Action("Prohibitions_Read", "EmployeeProbation", new { Area = "HRM", id = "#=EmployeeId#" }).Data("sendForgery"))
                              .Create(create => create.Action("Prohibitions_Create", "EmployeeProbation", new { Area = "HRM", id = "#=EmployeeId#" }).Data("sendForgery"))
                  .Update(update => update.Action("Prohibitions_Update", "EmployeeProbation").Data("sendForgery"))
                  .Destroy(destroy => destroy.Action("Prohibitions_Destroy", "EmployeeProbation").Data("sendForgery"))
      ))

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>

<style>
    .Employee-photo {
        display: inline-block;
