@using System.Collections
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPerformance_QuarterLength</legend>
@(Html.Kendo().Grid<QuarterLength>()
          .Name("QuarterLength")
      .Columns(columns =>
      {

          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name");//.EditorTemplateName( "Period");
          columns.Bound(c => c.Length);

          columns.Bound(c => c.Remark);

          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(200);
      })
      .ToolBar(toolbar => 
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                      .Input(true)
                      .Numeric(false)
                      .Refresh(true)
                      .PageSizes(true)
                      .ButtonCount(5))
      .DataSource(dataSource => dataSource
              .Ajax()
                   .Events(events =>
                   {
                       events.Error("error_handler(\"QuarterLength\")");
                       events.RequestStart("onRequestStart(\"QuarterLength\")");
                       events.RequestEnd("onRequestEnd(\"QuarterLength\")");
                   })

          .Model(model => model.Id(p => p.QuarterLengthId))
          .Read(read => read.Action("QuarterLength_Read", "QuarterLength"))
          .Create(create => create.Action("QuarterLength_Create", "QuarterLength"))
          .Update(update => update.Action("QuarterLength_Update", "QuarterLength"))
          .Destroy(destroy => destroy.Action("QuarterLength_Destroy", "QuarterLength"))
      ).ClientDetailTemplateId("quarter")
      )

<script id="quarter" type="text/kendo-tmpl">
                    @(Html.Kendo().TabStrip()
                          .Name("tabstrip_#QuarterLengthId#")
                          .SelectedIndex(0)
                          .Items(items =>
                          {
                              items.Add().Text(Resources.HR_PerformanceManagment_Quarter_Quarter).Content(
                                  @<text>
                  @*  <legend>Action</legend>*@
                    @(Html.Kendo().Grid<Quarter>()
                          .Name("Quartergrid_#=QuarterLengthId#")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Name);
                              //columns.Bound(c => c.AmharicName);
                              columns.Bound(c => c.Sequence);
                              columns.Bound(c => c.Remark);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  //command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(180);
                          })
                          .ToolBar(toolbar =>
                          {
                              //  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Scrollable(h => h.Height("auto"))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Events(events =>
                              {
                                  events.Error("error_handler(\"Quartergrid_#=QuarterLengthId#\")");
                                  events.RequestStart("onRequestStart(\"Quartergrid_#=QuarterLengthId#\")");
                                  events.RequestEnd("onRequestEnd(\"Quartergrid_#=QuarterLengthId#\")");
                              })

                              .Model(model =>
                              {model.Id(p => p.QuarterId);
                                  model.Field(p => p.Name).Editable(false);
                                  model.Field(p => p.AmharicName).Editable(false);
                                  model.Field(p => p.Sequence).Editable(false);

                              }
                              )
                              .Read(read => read.Action("Quarter_Read", "Quarter", new {  quarterLId = "#=QuarterLengthId#" }))
                              .Create(create => create.Action("Quarter_Create", "Quarter", new { quarterLId = "#=QuarterLengthId#" }))
                              .Update(update => update.Action("Quarter_Update", "Quarter"))
                          .Destroy(destroy => destroy.Action("Quarter_Destroy", "Quarter"))
                          ).ToClientTemplate()
                          )


                </text>
                                  );

                          }).ToClientTemplate())
                </script>
<script>
   

    function sync_handler(e) {
        this.read();

    }
</script>