@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.Common
@(Html.Kendo().DropDownListFor(m => m)
        .ValuePrimitive(true)
        // .AutoBind(false)
        .OptionLabel("Select Business Unit...")
        .DataTextField("Name")
        .DataValueField("Code")
        .HtmlAttributes(new { style = "width:160px" })
        .Filter("contains")
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetAllBusinessUnits", "GlobalDataProvider", new { area = "Common" }))
                                .ServerFiltering(false);
        })
                   
)
