                                    columns.Command(command =>
                                    {
                                        command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                        command.Destroy().Text(Resources.ActionButton_Cancel);

                                    }).Width(180);

                                })
                                .ToolBar(toolbar =>
                                {
                                    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                })
                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .Scrollable(h => h.Height(500))
                                .Filterable()
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                        .Events(events =>
                                        {
                                            events.Error("error_handler(\"MainCompanyEvalutionSettingGrid#=MeasurementDefinitionId#\")");
                                            events.RequestStart("onRequestStart(\"MainCompanyEvalutionSettingGrid#=MeasurementDefinitionId#\")");
                                            events.RequestEnd("onRequestEnd(\"MainCompanyEvalutionSettingGrid#=MeasurementDefinitionId#\")");
                                        })
                                    .Model(model => model.Id(p => p.MainCompanyEvalutionSettingId))
                                    .Read(read => read.Action("MainCompanyEvalutionSettings_Read", "MainCompanyEvalutionSettings", new { masterId = "#=MeasurementDefinitionId#" }).Data("sendForgery"))
                                    .Create(create => create.Action("MainCompanyEvalutionSettings_Create", "MainCompanyEvalutionSettings", new { masterId = "#=MeasurementDefinitionId#" }).Data("sendForgery"))
                                    .Update(update => update.Action("MainCompanyEvalutionSettings_Update", "MainCompanyEvalutionSettings").Data("sendForgery"))
                                    .Destroy(destroy => destroy.Action("MainCompanyEvalutionSettings_Destroy", "MainCompanyEvalutionSettings").Data("sendForgery"))
                                ).ToClientTemplate()
                        )


                    </text>);




            }).ToClientTemplate())
        #} else {#
        @(Html.Kendo().TabStrip()
                .Name("tabstrip_#=MeasurementDefinitionId#")
                .SelectedIndex(0)
                .Items(items =>
                {
                  //**************************************Identification****************************************************//
                  items.Add().Text(Resources.HR_PerformanceManagment_EmployeeMeasurement_MeasurementType).Content(
                                @<text>
                                    @(Html.Kendo().Grid<Measurement>()
                                        .Name("Measurementgrid_#=MeasurementDefinitionId#")
                                        .Columns(columns =>
                                        {
                                            columns.Bound(c => c.MeasurementName);
                                            columns.Bound(c => c.MesPercentageofWeight);
                                            columns.Bound(c => c.Remark);
                                            columns.Command(command =>
                                            {
                                                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                                command.Destroy().Text(Resources.ActionButton_Cancel);
                                            }).Width(180);


                                        })
                                                  .ToolBar(toolbar =>
                                                  {
                                                      toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                                  })

                                                  .ClientDetailTemplateId("Action")
                                                  .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                  .Scrollable(h => h.Height(500))
                                                  .DataSource(dataSource => dataSource
                                                      .Ajax()
                                                          .Events(events =>
                                                          {
                                                              events.Error("error_handler(\"Measurementgrid_#=MeasurementDefinitionId#\")");
                                                              events.RequestStart("onRequestStart(\"Measurementgrid_#=MeasurementDefinitionId#\")");
                                                              events.RequestEnd("onRequestEnd(\"Measurementgrid_#=MeasurementDefinitionId#\")");
                                                          })
                                                      .Model(model => model.Id(p => p.MeasurementId))
                                                      .Read(read => read.Action("EvaluationCriteriaDetail_Read", "EvaluationCriteriaDetail", new { id = "#=MeasurementDefinitionId#" }).Data("sendForgery"))
                                                      .Create(create => create.Action("EvaluationCriteriaDetail_Create", "EvaluationCriteriaDetail", new { id = "#=MeasurementDefinitionId#" }).Data("sendForgery"))
                                                      .Update(update => update.Action("EvaluationCriteriaDetail_Update", "EvaluationCriteriaDetail").Data("sendForgery"))
                                                      .Destroy(destroy => destroy.Action("EvaluationCriteriaDetail_Destroy", "EvaluationCriteriaDetail").Data("sendForgery"))
                                                  ).ToClientTemplate()
                                    )


                                </text>);





                                  }).ToClientTemplate())
    #}#
</script>

<script id="Action" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=MeasurementId#")
          .SelectedIndex(0)
          .Items(items =>
          {

              items.Add().Text(Resources.HR_PerformanceManagment_PerformanceAction_PerformanceAction).Content(
                @<text>

                    @(Html.Kendo().Grid<PerformanceAction>()
                         .Name("PerformanceActiongrid_#=MeasurementId#")
                         .Columns(columns =>
                         {
                             columns.Bound(c => c.ActionName);
                             columns.Bound(c => c.AcPercentageofWeight);

                             columns.Bound(c => c.Remark);
                             columns.Command(command =>
                             {
                                 command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                 command.Destroy().Text(Resources.ActionButton_Cancel);
                             }).Width(180);
                         })
                         .ToolBar(toolbar =>
                         {
                             toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                         })
                         .Editable(editable => editable.Mode(GridEditMode.InLine))
                                  .Scrollable(h => h.Height(500))
                         .DataSource(dataSource => dataSource
                             .Ajax()
                              .Events(events =>
                              {
                                  events.Error("error_handler(\"PerformanceActiongrid_#=MeasurementId#\")");
                                  events.RequestStart("onRequestStart(\"PerformanceActiongrid_#=MeasurementId#\")");
                                  events.RequestEnd("onRequestEnd(\"PerformanceActiongrid_#=MeasurementId#\")");
                              })
                             .Model(model => model.Id(p => p.ActionId))
                                     .Read(read => read.Action("EvaluationCriteriaSecondDetail_Read", "EvaluationCriteriaSecondDetail", new { defid = "#=MeasurementDefinitionId#", mesid = "#=MeasurementId#" }).Data("sendForgery"))
                             .Create(create => create.Action("EvaluationCriteriaSecondDetail_Create", "EvaluationCriteriaSecondDetail", new { defid = "#=MeasurementDefinitionId#", mesid = "#=MeasurementId#" }).Data("sendForgery"))
                             .Update(update => update.Action("EvaluationCriteriaSecondDetail_Update", "EvaluationCriteriaSecondDetail").Data("sendForgery"))
                             .Destroy(destroy => destroy.Action("EvaluationCriteriaSecondDetail_Destroy", "EvaluationCriteriaSecondDetail").Data("sendForgery"))
                         ).ToClientTemplate()
                    )


                </text>
                  );

          }).ToClientTemplate())
</script>


