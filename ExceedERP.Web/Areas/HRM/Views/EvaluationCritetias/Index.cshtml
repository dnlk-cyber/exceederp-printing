@using System.Collections
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<legend>@Resources.Evaluation_Criteria_Action_Type</legend>
@(Html.Kendo().Grid<EvaluationCriteriaActionType>()
          .Name("EvaluationCriteriaActionTypeGrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.PerformanceCriteriaActionType);
          columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsActive ? checked='checked' :'' # >");

          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              // command.Destroy().Text(Resources.ActionButton_Cancel);
          });
      })
      .ToolBar(toolbar =>
      {
          // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(h => h.Height("auto"))
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);

      })
        // .Filterable()
        //.Pageable(pageable => pageable
        //     .Input(true)
        //     .Numeric(false)
        //     .Refresh(true)
        //     .PageSizes(true)
        //     .ButtonCount(5))
        .DataSource(dataSource => dataSource
        .Ajax()
            .Events(events =>
            {
                events.Error("error_handler(\"EvaluationCriteriaActionTypeGrid\")");
                events.RequestStart("onRequestStart(\"EvaluationCriteriaActionTypeGrid\")");
                events.RequestEnd("onRequestEnd(\"EvaluationCriteriaActionTypeGrid\")");
            })

    .Model(model =>
    {
        model.Id(p => p.EvaluationCriteriaActionTypeId);
        model.Field(p => p.PerformanceCriteriaActionType).Editable(false);
    })
    .Read(read => read.Action("EvaluationCriteriaActionType_Read", "EvaluationCriteriaActionType").Data("sendForgery"))
    .Update(update => update.Action("EvaluationCriteriaActionType_Update", "EvaluationCriteriaActionType").Data("sendForgery"))
      )
)




<br/>

<legend>@Resources.NavigatorPerformance_EvaluationCriteria</legend>
@(Html.Kendo().Grid<MeasurementDefinition>()
          .Name("MeasurementDefinitiongrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EvaluationCriteria);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["EvaluationTypes"], "LookupId", "Description").EditorTemplateName("EvaluationTypes").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(c => c.CriteriaCategoryId, (IEnumerable)ViewData["CriteriaCategory"], "CriteriaCategoryId", "Name").EditorTemplateName("criteriaCategory").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.Role).EditorTemplateName("Enum").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.DefnPercentageofWeight);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.IsMainCompanyLevel).Visible(false);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
           .Scrollable(h => h.Height("auto"))
                          // .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                      .Input(true)
                      .Numeric(false)
                      .Refresh(true)
                      .PageSizes(true)
                      .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Events(events =>
               {
                   events.Error("error_handler(\"MeasurementDefinitiongrid\")");
                   events.RequestStart("onRequestStart(\"MeasurementDefinitiongrid\")");
                   events.RequestEnd("onRequestEnd(\"MeasurementDefinitiongrid\")");
               })

          .Model(model => model.Id(p => p.MeasurementDefinitionId))
          .Read(read => read.Action("EvaluationCritetias_Read", "EvaluationCritetias").Data("sendForgery"))
          .Create(create => create.Action("EvaluationCritetias_Create", "EvaluationCritetias").Data("sendForgery"))
          .Update(update => update.Action("EvaluationCritetias_Update", "EvaluationCritetias").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("EvaluationCritetias_Destroy", "EvaluationCritetias").Data("sendForgery"))
          ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
#if(IsMainCompanyLevel){#
    @(Html.Kendo().TabStrip()
            .Name("tabstrip_#=MeasurementDefinitionId#")
            .SelectedIndex(0)
            .Items(items =>
            {
                  //**************************************Identification****************************************************//
                  items.Add().Text(Resources.HR_PerformanceManagment_EmployeeMeasurement_MeasurementType).Content(
                        @<text>
                            @(Html.Kendo().Grid<Measurement>()
                                          .Name("Measurementgrid_#=MeasurementDefinitionId#")
                                          .Columns(columns =>
                                          {
                                              columns.Bound(c => c.MeasurementName);
                                              columns.Bound(c => c.MesPercentageofWeight);
                                              columns.Bound(c => c.Remark);
                                              columns.Command(command =>
                                              {
                                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                                  command.Destroy().Text(Resources.ActionButton_Cancel);

                                              }).Width(180);

                                          })
                                          .ToolBar(toolbar =>
                                          {
                                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                          })

                                          .ClientDetailTemplateId("Action")
                                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                                          .Scrollable(h => h.Height(500))
