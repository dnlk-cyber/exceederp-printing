@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Sent Letters</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.RecivedLetters>()
          .Name("RecivedLetters")
      .Columns(columns =>
      {
          columns.Bound(c => c.RecivedDate).Title("Date");
          columns.Bound(c => c.InstnPerson);
          columns.Bound(c => c.Receiver);
          columns.Bound(c => c.Sender);
          columns.Bound(c => c.Description);
          columns.Bound(c => c.FileName).ClientTemplate(Html.ActionLink("DownLoad", "DownloadFile", new { filename = "#=RecivedLetterId#" }).ToHtmlString());
           columns.Bound(c => c.LetterStatus);
          //columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Template(@<text>
            <div class="toolbar">
               
                @(Html.Kendo().Button()
        .Name("btnAnswer")
                .HtmlAttributes(new { type = "button", @class = "k-primary", width = "200px" })
                        .Events(e => e.Click("Answer"))
                      .Content("Answer"))

                @(Html.Kendo().Button()
        .Name("btnTransfer")
        .HtmlAttributes(new { type = "button", @class = "k-primary" ,width="200px" })
                        .Events(e => e.Click("Transfer"))
                      .Content("Transfer"))

                @*@(Html.Kendo().Button()
        .Name("btnDownload")
        .HtmlAttributes(new { type = "button", @class = "k-primary", width = "200px" })
                        .Events(e => e.Click("Download"))
                                      .Content("Download"))*@

</div>
</text>);
          //  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Events(ev => ev.DataBinding("onDataBound"))
        .Scrollable(h => h.Height(500))
        .Selectable( )
                     .Groupable()
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                  .Filterable()
                     .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                                                                    .Events(x => x.Change("CheckDisablity"))
      .DataSource(dataSource => dataSource
          .Ajax()
                                   .Events(events =>
                                                                            {
                                                                                events.Error("error_handler(\"RecivedLetters\")");
                                                                                events.RequestStart("onRequestStart(\"RecivedLetters\")");
                                                                                events.RequestEnd("onRequestEnd(\"RecivedLetters\")");
                                                                            })
                                                       
          .Model(model => model.Id(p => p.RecivedLetterId))
          .Read(read => read.Action("RecivedLetters_Read", "RecivedLetter"))
          .Create(create => create.Action("RecivedLetters_Create", "RecivedLetter"))
          .Update(update => update.Action("RecivedLetters_Update", "RecivedLetter"))
          .Destroy(destroy => destroy.Action("RecivedLetters_Destroy", "RecivedLetter"))
                          )
      )


