@using System.Collections
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? false;
}
<legend>@Resources.NavigatorLeave_LeaveRequests</legend>

<!-- Status Legend -->
<div class="well well-sm" style="background: #fff; border-radius: 4px; margin-bottom: 12px; padding: 8px 15px;">
    <span class="fa fa-circle" style="color: #6b7280;"></span> Final Approved &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #10b981;"></span> Department Approved &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #0284c7;"></span> Waiting for Approval &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #f59e0b;"></span> Pending &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #ef4444;"></span> Rejected
</div>

@(Html.Kendo().Grid<LeaveRequest>()
          .Name("LeaveRequestgrid")
          .Columns(columns =>
          {

              columns.Bound(c => c.LeaveRequestId).Width(70).Title("#");
              columns.Bound(c => c.IsApproved).Visible(false);
              columns.Bound(c => c.EmployeeCode).Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Width(160).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(110);
              columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
              columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["jobTitle"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
              columns.Bound(c => c.Type).EditorTemplateName("LeaveType").Width(100);
              columns.Bound(c => c.Day).Width(80);
              columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Width(80);
              if (useEthiopian)
              {
                  columns.Bound(c => c.FromAmharic).Width(100);
                  columns.Bound(c => c.ToAmharic).Width(100);
              }
              else
              {
                  columns.Bound(c => c.From).Format("{0:dd/MM/yyyy}").Width(100);
                  columns.Bound(c => c.To).Format("{0:dd/MM/yyyy}").Width(100);
              }
              columns.Bound(c => c.LeaveBalance).Title("Balance").Width(90);
              columns.Bound(c => c.LeaveDays).Title("Days").Width(80);
              columns.Bound(c => c.Status).Width(110);
              columns.Bound(c => c.Reason).Width(140);
              columns.Bound(c => c.LeaveActionTypes).Width(100).Visible(false);
              columns.Bound(c => c.IsOnlineApproved).ClientTemplate(
                  "<input type='checkbox' disabled='true' value='#=IsOnlineApproved#' " +
                  "# if (IsOnlineApproved) { #" + "checked='checked'" + "# } #" + "/>").Width(100);
              columns.Bound(c => c.IsVoid).ClientTemplate(
                  "<input type='checkbox' disabled='true' value='#=IsVoid#' " +
                  "# if (IsVoid) { #" + "checked='checked'" + "# } #" + "/>").Width(90);
              columns.Command(command =>
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }).Width(180);

          })
        .ToolBar(toolbar =>
        {
        })
        .Editable(editable => editable.Mode(GridEditMode.PopUp)
            .TemplateName("LeaveRequest")
            .Window(window =>
            {
                window.Title(Resources.NavigatorLeave_LeaveRequest);
                window.Width(1150);
                window.Scrollable(false);
            }))
        .Events(events =>
        {
            events.DetailExpand("onDetailExpandUser");
            events.DataBound("onDataBound");
            events.Edit("onEdit");
            events.Save("GetDate");
        })
        .Scrollable(h => h.Height(500))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);

        })
        .Filterable()
        .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
        .DataSource(dataSource => dataSource
                  .Ajax()
                  .Sort(sort => sort.Add("LeaveRequestId").Descending())
                  .Events(events =>
                  {
                      events.Error("error_handler(\"LeaveRequestgrid\")");
                      events.RequestStart("onRequestStart(\"LeaveRequestgrid\")");
                      events.RequestEnd("onRequestEnd(\"LeaveRequestgrid\")");
                  })
                  .Model(model => model.Id(p => p.LeaveRequestId))
                  .Read(read => read.Action("LeaveRequest_Read", "LeaveRequestPM").Data("sendForgery"))
                  .Update(update => update.Action("LeaveRequest_Update", "LeaveRequestPM").Data("sendForgery"))
                  .Destroy(destroy => destroy.Action("LeaveRequest_Destroy", "LeaveRequestPM").Data("sendForgery"))
                  ).ClientDetailTemplateId("template")
)

