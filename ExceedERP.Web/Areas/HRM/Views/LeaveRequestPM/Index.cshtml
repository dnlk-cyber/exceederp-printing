<script>
    var editingEmployeeId = 0;

    function onEdit(e) {
        editingEmployeeId = e.model.EmployeeId || 0;
        // Keep the stored balance and days on open; they are recalculated only when the user changes something.
        toggleDayControls();
    }

    // The dropdown may still be loading when the popup opens, so fall back to the edited row.
    function currentEmployeeId() {
        var employee = $("#EmployeeId").data("kendoDropDownList");
        return (employee && parseInt(employee.value(), 10)) || editingEmployeeId;
    }

    function GetDate() {
        $("#FromAmharic").trigger("change");
        $("#ToAmharic").trigger("change");
    }

    function applyLeaveAmounts(result) {
        if (!result) return;
        var parts = result.split('-');
        $("#LeaveBalance").val(parts[0] || "0").trigger("change");
        $("#ExactDeserveLeaveDays").val(parts[1] || "0").trigger("change");
        $("#LeaveDays").val(parts[2] || "0").trigger("change");
    }

    function GetTotalBalance() {
        var empId = currentEmployeeId();
        var morningOrAfternoonDDL = $("#MorningOrAfternoon").data("kendoDropDownList");
        var morningOrAfternoon = morningOrAfternoonDDL ? morningOrAfternoonDDL.value() : 0;

        $.ajax({
            url: '@Url.Action("GetTotalLeaveAmount", "LeaveRequestPM")',
            type: 'POST',
            data: { empId: empId, from: $("#From").val(), to: $("#To").val(), fromAm: $("#FromAmharic").val(), toAm: $("#ToAmharic").val(), morningOrAfternoon: morningOrAfternoon },
            cache: false,
            success: applyLeaveAmounts
        });
    }

    function GetTotalBalanceGord() {
        var empId = currentEmployeeId();
        var morningOrAfternoonDDL = $("#MorningOrAfternoon").data("kendoDropDownList");
        var morningOrAfternoon = morningOrAfternoonDDL ? morningOrAfternoonDDL.value() : 0;

        $.ajax({
            url: '@Url.Action("GetTotalLeaveAmountGorg", "LeaveRequestPM")',
            type: 'POST',
            data: { empId: empId, from: $("#From").val(), to: $("#To").val(), morningOrAfternoon: morningOrAfternoon },
            cache: false,
            success: applyLeaveAmounts
        });
    }

    function GetRequestedAmount() {
        if (toggleDayControls() != 2) {
            GetTotalBalance();
        }
    }

    // Returns the selected Day value: Half Day (1) shows the time pickers, Mixed (2) allows manual leave days.
    function toggleDayControls() {
        var dayT = $("#Day").data("kendoDropDownList");
        var half = dayT ? dayT.value() : 0;

        if (half == 1) {
            $(".showTime").show();
            $(".showTime2").show();
        } else {
            $(".showTime").hide();
            $(".showTime2").hide();
        }

        var leaveDaysInput = $("#LeaveDays");

        if (half == 2) {
            leaveDaysInput.removeAttr("readonly").prop("disabled", false).css({
                "background": "#ffffff",
                "color": "#1f2937",
                "cursor": "text"
            });
        } else {
            leaveDaysInput.attr("readonly", "readonly").prop("disabled", true).css({
                "background": "#fef2f2",
                "color": "#dc2626",
                "cursor": "not-allowed"
            });
        }

        return half;
    }
</script>
<script>

    var masterId = 0;
    var isPMApproved = false;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#LeaveRequestgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.LeaveRequestId;

        isPMApproved = masterDataItem.IsProjectManagerApproved;
        var gridName = "#RequestesStatusgrid_" + masterId;
        var PMGridName = "#LeaveRequestPMValidationGrid_" + masterId;
        if (masterDataItem.IsOnlineApproved == true) {
            $(gridName).find(".k-toolbar").hide(); //hide toolbar
            $(".k-grid-top", gridName).hide();
            $(".k-grid-edit", gridName).hide();
            $(".k-grid-delete", gridName).hide();
            $(PMGridName).find(".k-toolbar").hide(); //hide toolbar
            $(".k-grid-top", PMGridName).hide();
            $(".k-grid-edit", PMGridName).hide();
            $(".k-grid-delete", PMGridName).hide();

        }
        else if (masterDataItem.IsProjectManagerApproved == true) {
            $(gridName).find(".k-toolbar").hide(); //hide toolbar
            $(".k-grid-top", gridName).hide();
            $(".k-grid-edit", gridName).hide();
            $(".k-grid-delete", gridName).hide();
            $(PMGridName).find(".k-toolbar").hide(); //hide toolbar
            $(".k-grid-top", PMGridName).hide();
            $(".k-grid-edit", PMGridName).hide();
            $(".k-grid-delete", PMGridName).hide();
        }
        else if (masterDataItem.IsDepartmentOnlineApproved == true) {
            $(gridName).find(".k-toolbar").hide(); //hide toolbar
            $(".k-grid-top", gridName).hide();
            $(".k-grid-edit", gridName).hide();
            $(".k-grid-delete", gridName).hide();
            //
            $(PMGridName).find(".k-toolbar").show(); //hide toolbar
            $(".k-grid-top", PMGridName).show();
            $(".k-grid-edit", PMGridName).hide();
            $(".k-grid-delete", PMGridName).hide();
        }
        else if (masterDataItem.IsSendForApproval == true)  {
            $(gridName).find(".k-toolbar").show(); //hide toolbar
            $(".k-grid-top", gridName).show();
            $(".k-grid-edit", gridName).hide();
            $(".k-grid-delete", gridName).hide();
            $(PMGridName).find(".k-toolbar").hide(); //hide toolbar
            $(".k-grid-top", PMGridName).hide();
            $(".k-grid-edit", PMGridName).hide();
            $(".k-grid-delete", PMGridName).hide();
        }

        $.ajax({
            url: '@Url.Action("CheckStatus", "LeaveRequestPM")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                var attachmentGridName = "#LeaveRequestAttachementGrid" + masterId;
                if(r == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();

                    $(attachmentGridName).find(".k-grid-toolbar").hide();
                    $(".k-grid-delete", attachmentGridName).hide();

                }
                else if (r == "Dapproved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();

                    $(attachmentGridName).find(".k-grid-toolbar").hide();
                    $(".k-grid-delete", attachmentGridName).hide();
                }
                else {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", gridName).show();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();

                    $(attachmentGridName).find(".k-grid-toolbar").show();
                    $(".k-grid-delete", attachmentGridName).show();
                }

            }

        });
    }

    function onDataBoundValidationPM(e)
    {
        var detailGrid = "#" + e.sender.element[0].id;
        if (isPMApproved == true)
        {

            $(".k-grid-add", detailGrid).hide();
            $(".k-upload-button", detailGrid).hide();
            $(".k-dropzone", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();

        }
        this.table.find(".k-grid-edit").hide();
        this.table.find(".k-grid-delete").hide();

    }

    function onUploadSuccess(e) {
        $("#LeaveRequestAttachementGrid" + masterId).data("kendoGrid").dataSource.read();
    }

    function SetEmployee(e) {
        var isChecked = e.checked;
        var dropDown = $("#EmployeeId").data("kendoDropDownList");

        if (isChecked) {
            dropDown.enable(true);
            $("#LeaveBalance").val(0).trigger("change");
        } else {
            dropDown.value(0);
            dropDown.enable(false);
        }

        $.ajax({
            url: '@Url.Action("SetEmployee", "LeaveRequestPM")',
            type: 'GET',
            data: { x: isChecked },
            cache: false,
            success: function (result) {
                if (isChecked && result == 0) {
                    e.checked = false;
                    dropDown.value(0);
                    dropDown.enable(false);
                    alert("You cannot request for other employees!\nNo subordinates under your position.");
                }
            }
        });
    }

</script>

<script>
    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var model = grid.dataItem(this);
            if (!model) return;

            var $row = $(this);
            $row.removeClass("row-approved row-dept-approved row-waiting row-pending row-rejected");

            if (model.IsOnlineApproved || model.IsApproved === true) {
                $row.addClass("row-approved");
                $row.find(".k-grid-edit, .k-grid-delete").remove();
            }
            else if (model.IsDepartmentOnlineApproved === true || model.Status === "DEPARTMENT_APPROVAL") {
                $row.addClass("row-dept-approved");
                $row.find(".k-grid-edit, .k-grid-delete").remove();
            }
            else if (model.Status === "Pending" || model.IsPending === true) {
                $row.addClass("row-pending");
            }
            else if (model.Status === "Rejected" || model.IsRejected === true) {
                $row.addClass("row-rejected");
            }
            else if (model.IsWaiting === true || model.Status === "WAITING_FOR_APPROVAL") {
                $row.addClass("row-waiting");
                $row.find(".k-grid-delete").remove();
            }
        });
    }

    function onRequestesStatusDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (model.Status == 0 || model.Status == 1 || model.Status == 2 || model.Status == 3 || model.Status == 4 || IsApproved) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }

        });

    }
    function onRequestesStatusEdit(e) {
    }
</script>
