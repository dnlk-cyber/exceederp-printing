
@(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.LeaveManagment.LeaveNewAwajStartYear>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.GlFisicalYearId);
          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar => {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Pageable()
      .Filterable()
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.LeaveNewAwajStartYearId))
          .Read(read => read.Action("LeaveNewAwajStartYears_Read", "LeaveNewAwajStartYears").Data("sendForgery"))
          .Create(create => create.Action("LeaveNewAwajStartYears_Create", "LeaveNewAwajStartYears").Data("sendForgery"))
          .Update(update => update.Action("LeaveNewAwajStartYears_Update", "LeaveNewAwajStartYears").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("LeaveNewAwajStartYears_Destroy", "LeaveNewAwajStartYears").Data("sendForgery"))
      )
)
