<script>
    var bookNo = "";
    var enableDisable;
    function DetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#EmployeeIncomming").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        bookNo = masterDataItem.BookNo;
        enableDisable = masterDataItem.EnableDisbale;
    }
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#OutgoingLetterDateAm").trigger("change");
        $("#RecivedDateAmharic").trigger("change");
        $("#LetterAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "EmployeeIncoming")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
    function GetLetterStatusDate() {

        var x = AssignDate();
        var y = x;

        $("#DateAmharic").trigger("change");

        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "LetterStatus")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
    function GetLetterSenderDate() {

        var x = AssignDate();
        var y = x;
        $("#DateAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "LetterSender")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }

</script>
<script>
    function Answer(e) {
        try {
            statusId = e;
            
           
            var wnd = $("#Answerw").data("kendoWindow");
            wnd.center().open();

        } catch (ex) {
            alert("Please select the row!!");
        }

    }
    function Answerm() {
        try {

           
            var url = "";
            $.ajax({
                url: '@Url.Action("UploadDocument", "EmployeeIncoming")',
                //contentType: "application/json; charset=utf-8",
                data: function () {
                    var data = new FormData();

                    data.append("file", $("#file").get(0).files[0]);
                    data.append("url", url);
                    data.append("txtValue", $("#txtValue").val());
                    data.append("txtDecsion", $("#txtDecsion").val());
                    data.append("id", bookNo);
                    return data;
                }(),
                type: 'POST',
                contentType: false,
                processData: false,
                cache: false,
                success: function (result) {
                    var wnd = $("#Answerw").data("kendoWindow");
                    wnd.close();
                    $("#EmployeeIncomming").data("kendoGrid").dataSource.read();
                    $("#EmployeeIncomming").data("kendoGrid").refresh();
                }


            });
        } catch (e) {
            // alert("Please select the row!!");
        }

    }

    
    
    function customAction(e) {
        
        try {

            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("UpdateStatus", "EmployeeIncoming")',
                data: { 'BookNo': bookNo },
                type: 'GET',
                cache: false,
                success: function(result) {
                    r = result;
                    $("#EmployeeIncomming").data("kendoGrid").dataSource.read();
                    $("#EmployeeIncomming").data("kendoGrid").refresh();
                }

            });
        } catch (ee) {
            alert("Please select the row first!!");
        }
    }

    function mainDataBound(e) {


        var grid = this;

        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check
            if (dataItem.EnableDisbale === false) {
                //hide buttons using jQuery
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-customAction").text('ይከፈት');
            } else {

                row.find(".k-grid-edit").show();
                row.find(".k-grid-customAction").text('ይዘጋ');
            }


            if (dataItem.Status === 0) {
                //answer.hide(true);
                //transfer.hide(true);
                row.css("background-color", "green");

            } else {
                //answer.show(true);
                //transfer.show(true);
                row.css("background-color", "grey");

            }


        }

    }

    function Transfer(e) {
        try {

            var wnd = $("#Transferw").data("kendoWindow");
            wnd.center().open();


        } catch (ex) {
            alert("Please select the row!!");
        }
    }

    function TransferClick(e) {
        try {


            var recivers = $("#Dept").data("kendoComboBox");
            var reciver = recivers.value();
            $.ajax({
                url: '@Url.Action("SetTransfer", "EmployeeIncoming")',
                //contentType: "application/json; charset=utf-8",
                data: { id: bookNo, reciver: reciver },
                type: 'POST',
                cache: false,
                success: function(result) {
                    var wnd = $("#Transferw").data("kendoWindow");
                    wnd.close();
                    $("#EmployeeIncomming").data("kendoGrid").dataSource.read();
                    $("#EmployeeIncomming").data("kendoGrid").refresh();
                }


            });

        } catch (ex) {
            alert("Please select the row!!");
        }

    }

    function DetailDatabound(e) {
        var grid = this;


        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);

            var dataItem = grid.dataItem(row);
            //perform your custom check
            //if (dataItem.EnableDisbale === false) {
            //    //hide buttons using jQuery
            //    row.find(".k-grid-edit").hide();
            //    row.find(".k-grid-customAction").text('Enable');
            //} else {

            //    row.find(".k-grid-edit").show();
            //    row.find(".k-grid-customAction").text('Disable');
            //}
            if (enableDisable === true) {
                if (dataItem.CurrentStatus === 0) {
                    //answer.hide(true);
                    //transfer.hide(true);
                    row.css("background-color", "green");
                    row.find(".k-grid-delete").show();
                    row.find(".k-grid-Answer").show();
                    row.find(".k-grid-Transfer").show();

                } else if (dataItem.CurrentStatus === 1) {
                    //answer.show(true);
                    //transfer.show(true);
                    row.css("background-color", "grey");
                    row.find(".k-grid-delete").hide();
                    row.find(".k-grid-Answer").hide();
                    row.find(".k-grid-Transfer").show();

                } else if (dataItem.CurrentStatus === 2) {
                    //answer.show(true);
                    //transfer.show(true);
                    row.css("background-color", "grey");
                    row.find(".k-grid-delete").hide();
                    row.find(".k-grid-Answer").hide();
                    row.find(".k-grid-Transfer").hide();

                } else {
                    row.find(".k-grid-delete").show();
                    row.find(".k-grid-Answer").show();
                    row.find(".k-grid-Transfer").show();
                }
            } else {
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-Answer").hide();
                row.find(".k-grid-Transfer").hide();
            }
        }
    }
</script>

