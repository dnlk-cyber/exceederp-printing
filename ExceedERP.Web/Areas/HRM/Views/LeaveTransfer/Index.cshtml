<script type="text/javascript">
    $(function () {
        $('#LeaveTransfergrid').on('click', '.chkbx', function () {
            var checked = $(this).is(':checked');
            var grid = $('#LeaveTransfergrid').data().kendoGrid;
            var dataItem = grid.dataItem($(this).closest('tr'));
            dataItem.set('Check', checked);
        })
    })

    function checkAll(ele) {
        var state = $(ele).is(':checked');
        var grid = $('#LeaveTransfergrid').data().kendoGrid;
        $.each(grid.dataSource.view(), function () {
            if (this['Check'] != state)
                this.dirty = true;
            this['Check'] = state;
        });
        grid.refresh();
    }

</script>
<script>
	function Transfer() {
		var from = $("#From").data("kendoComboBox");
		var to = $("#To").data("kendoComboBox");
		try {

			var period = from.value();
			var toPeriod = to.value();
			//$("#run").on("click", function (eve) {
			$.ajax({
				url: '@Url.Action("TransferLeave", "LeaveTransfer")',
				//contentType: "application/json; charset=utf-8",
				data: { period: period ,toPeriod:toPeriod},
				type: 'POST',
				cache: false,
				success: function (result) {
					r = result;
					$("#LeaveTransfergrid").data("kendoGrid").dataSource.read();
					$("#LeaveTransfergrid").data("kendoGrid").refresh();
				}


			});



		} catch (e) {
			alert("Please select Period!!");
		}
		//});
	}
</script>



