@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Domain.HRM.SalaryStructure
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend >@Resources.Navigator_Company_Ranks</legend>
@(Html.Kendo().Grid<Rank>()
      .Name("Rankgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.RankName);
          columns.Bound(c => c.StartingSalary);
          columns.Bound(c => c.MaximumSalary);
          columns.Bound(c => c.Remark);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Company_User"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Company_Admin"))

              {
                   command.Destroy().Text(Resources.ActionButton_Cancel);//
              }
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Template(@<text>
                               <div class="toolbar"style="">
                                   @if (HttpContext.Current.User.IsInRole("HR_Company_User"))

                                   {
                                       @item.CreateButton(Resources.ActionButton_AddNewRecord);
                                   }
@if (HttpContext.Current.User.IsInRole("HR_Company_Admin"))
{
    @(Html.Kendo().Button()
          .Name("btnDownLoad")
          .HtmlAttributes(new { type = "button", @class = "k-primary" })
          .Events(e => e.Click("DownLoadTemplate"))
          .Content(Resources.DownloadTemplate))
    
    @(Html.Kendo().Upload()
          .Name("file")
          .Async(a => a.Save("Rank_Import", "Rank"))
          .Events(e => e.Complete("onUploadSuccess").Upload("checkFileType"))
          //.ShowFileList(false).
          // .HtmlAttributes(new { type = "button", @class = "k-primary" })
          )

   
} 
                               </div>





        </text>);
         

      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Selectable(selectable =>
         {
             selectable.Mode(GridSelectionMode.Single);
             selectable.Type(GridSelectionType.Row);
         })
             .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
              .Events(events =>
                                                        {
                                                            events.Error("error_handler(\"Rankgrid\")");
                                                            events.RequestStart("onRequestStart(\"Rankgrid\")");
                                                            events.RequestEnd("onRequestEnd(\"Rankgrid\")");
                                                        })
                      
          .Model(model => model.Id(p => p.RankId))
          .Read(read => read.Action("Ranks_Read", "Rank"))
          .Create(create => create.Action("Ranks_Create", "Rank"))
          .Update(update => update.Action("Ranks_Update", "Rank"))
          .Destroy(destroy => destroy.Action("Ranks_Destroy", "Rank"))

      )
)
<script>

    function searchGrid(e) {
        $("#Rankgrid").data("kendoGrid").dataSource.filter({ field: "RankName", operator: "contains", value: $("#RankNameSearch").val() });
    }

</script>


<style>
    #Rankgrid .k-grid-toolbar {
        padding: .6em 1.3em;
    }

    .ShipNameSearch {
        vertical-align: middle;
        padding-right: .5em;
    }
     .GridSeachButton {
        vertical-align: middle;
        padding-right: .5em;
    }
    .toolbar {
        float: right;
    }
</style>
<script>
 
    function sync_handler(e) {
        this.read();

    }

    function onUploadSuccess(e) {
        $("#Rankgrid").data("kendoGrid").dataSource.read();
        $("#Rankgrid").data("kendoGrid").refresh();
    }

    function checkFileType(e) {
        var files = e.files;

        $.each(files, function() {

            if (this.extension.toLowerCase() === ".xls" || this.extension.toLowerCase() === ".xlsx" || this.extension.toLowerCase() === ".xlsm") {

            } else {
                alert("Only .xls, .xlsx, .xlsm files can be uploaded!");
                e.preventDefault();
            }

        });
    }

    function DownLoadTemplate(e) {
        try {
          
           
            var wnd = $("#AttachmentWindow").data("kendoWindow");
            wnd.center().open();

        } catch (ex) {
           // alert("Please select the row!!");
        }

    }
</script>
<style>
    #Rankgrid .k-grid-toolbar {
        padding: .6em 1.3em .6em .4em;
    }

    .category-label
    {
        vertical-align: middle;
        padding-right: .5em;
    }
    #category
    {
        vertical-align: middle;
    }
    .refreshBtnContainer {
        display: inline-block;
    }

    .toolbar {
        float: left;
    }
</style>

@(Html.Kendo().Window().Name("AttachmentWindow")
        .Title(Resources.Templates)
    .Visible(false)
    .Modal(true)
      .Content(@<text>

        @(Html.Kendo().Grid<Attachment>()
                  .Name("AttachmentGrid")
          .Columns(columns =>
          {
              columns.Bound(c => c.Description).Width(200); //.Title("File Name").ClientTemplate((@Html.ActionLink("#=Description#", "DownloadFile", "DownloadDocument", new { filename = "#=Description#" }, null).ToHtmlString()));
              columns.Bound(c => c.FileType).ClientTemplate(Html.ActionLink("DownLoad", "DownloadFile", new { area = "HRM", filename = "#=Description#" }).ToHtmlString()).Width( 200);

          })

              .Scrollable()
              .Selectable()
              .DataSource(dataSource => dataSource
                  .Ajax()
                                           .Events(events => events.Error("error_handler(\"AttachmentGrid\")"))

                  .Model(model => model.Id(p => p.AttachmentId))
                                  .Read(read => read.Action("Attachments_Read", "Attachment", new { Area = "Common", attachmentReferenceType = "TEMPLATE", id = 0 }))


              )
        )

    </text>)
.Width( 500)
               
)
