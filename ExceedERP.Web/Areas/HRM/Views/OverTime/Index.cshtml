@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.Payroll
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.NavigatorPayroll_OverTime</Legend>
@(Html.Kendo().Grid<OverTime>()
      .Name("OverTimegrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.OverTimeId).Title("#").Width(90);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullName").EditorTemplateName("PayrollListOfEmployee").Width(260).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["PeriodList"], "GLPeriodId", "Name").EditorTemplateName("GLPeriod").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
          columns.Bound(c => c.NormalHours).Width (100).Title("Normal.Hr").Format("{0:N5}");
          columns.Bound(c => c.NightHours).Width (100).Title ("Night.Hr").Format("{0:N5}");
          columns.Bound(c => c.HolidayHours).Width (100).Title ("Holiday.Hr").Format("{0:N5}");
          columns.Bound(c => c.RestdayHours).Width (100).Title ("Restday.Hr").Format("{0:N5}");
          columns.Bound(c => c.Remark);
          columns.Command(command =>
          {
              command.Edit().Text (Resources.ActionButton_Update);
              command.Destroy().Text (Resources.ActionButton_Cancel);

          }).Width(200);

      })
      .ToolBar(toolbar => {
          toolbar.Create().Text (Resources.ActionButton_AddNewRecord);
      })
      .Events(events => events.DataBound("onOverTimeDataBound"))
      .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Scrollable(h => h.Height(500))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);

        })
        .Filterable()
        .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(srt=>srt.Add(x=>x.OverTimeId).Descending())
          .Events(events =>
          {
              events.Error("error_handler(\"OverTimegrid\")");
              events.RequestStart("onRequestStart(\"OverTimegrid\")");
              events.RequestEnd("onRequestEnd(\"OverTimegrid\")");

          })

          .Model(model =>
          {

              model.Id(p => p.OverTimeId);
              model.Field(p => p.OverTimeId).Editable(false);

          })
          .Read(read => read.Action("OverTimes_Read", "OverTime").Data("sendForgery"))
          .Create(create => create.Action("OverTimes_Create", "OverTime").Data("sendForgery"))
          .Update(update => update.Action("OverTimes_Update", "OverTime").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("OverTimes_Destroy", "OverTime").Data("sendForgery"))
      )
)
<script>

    function onOverTimeDataBound(e)
    {
        var grid = this;
        var rows = grid.tbody.find("tr");
        for (var i = 0; i < rows.length; i++) {
            var row = $(rows[i]);
            var dataItem = grid.dataItem(row);

            if (dataItem.IsFromOverTimeRequest) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
            }
        }
    }

    function sync_handler(e) {
        this.read();

    }
</script>

