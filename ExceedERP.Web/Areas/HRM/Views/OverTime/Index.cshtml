@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.Payroll
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.NavigatorPayroll_OverTime</Legend>
@(Html.Kendo().Grid<OverTime>()
      .Name("OverTimegrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullName").EditorTemplateName("PayrollListOfEmployee").Width(260).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["PeriodList"], "GLPeriodId", "Name").EditorTemplateName("GLPeriod").Width(120);
          columns.Bound(c => c.NormalHours).Width (100).Title("Normal.Hr");
          columns.Bound(c => c.NightHours).Width (100).Title ("Night.Hr");
          columns.Bound(c => c.HolidayHours).Width (100).Title ("Holiday.Hr");
          columns.Bound(c => c.RestdayHours).Width (100).Title ("Restday.Hr");
          //columns.Bound(c => c.Remark);
          columns.Command(command =>
          {
              command.Edit().Text (Resources.ActionButton_Update);
              command.Destroy().Text (Resources.ActionButton_Cancel);

          }).Width(200);
      })
      .ToolBar(toolbar => {
          toolbar.Create().Text (Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Scrollable(h => h.Height(500))

                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Events(events =>
               {
                   events.Error("error_handler(\"OverTimegrid\")");
                   events.RequestStart("onRequestStart(\"OverTimegrid\")");
                   events.RequestEnd("onRequestEnd(\"OverTimegrid\")");
               })

          .Model(model => model.Id(p => p.OverTimeId))
          .Read(read => read.Action("OverTimes_Read", "OverTime"))
          .Create(create => create.Action("OverTimes_Create", "OverTime"))
          .Update(update => update.Action("OverTimes_Update", "OverTime"))
          .Destroy(destroy => destroy.Action("OverTimes_Destroy", "OverTime"))
      )
)
