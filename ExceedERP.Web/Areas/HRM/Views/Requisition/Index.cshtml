@using System.Collections
@using ExceedERP.Core.Domain.HRM.RecruitmentManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@(Html.Kendo().Grid<Recruitment>()
          .Name("Recruitment")
      .Columns(columns =>
      {
          columns.Bound(c => c.IsForContrat).ClientTemplate("<input type='checkbox' disabled = 'true' \\#= IsForContrat ? checked='checked' :'' \\# />").Width(120);
        columns.ForeignKey(c => c.JobTitleCode, (IEnumerable)ViewData["jobTitle"], "OrgStructureId", "Name").EditorTemplateName("JobTitles").Width(120);
        columns.Bound(c => c.NoOfVaccantPostion).Width (150);
        columns.Bound(c => c.NoOfCurrentStaff).Width (150);
        columns.Bound(c => c.NoOfShouldBeStaff).Width (150);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                   .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Recruitments").Window(window => { window.Title("Requisition"); window.Scrollable(false); }))
       .Selectable(selectable =>
       {
           selectable.Mode(GridSelectionMode.Single);
           selectable.Type(GridSelectionType.Row);
       })
             .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
              .Events(events =>
     {
         events.Error("error_handler(\"Recruitment\")");
         events.RequestEnd("onRequestEnd(\"Recruitment\")");
     })
                      
          .Model(model => model.Id(p => p.RecruitmentId))
          .Read(read => read.Action("Recruitments_Read", "Requisition"))
          .Create(create => create.Action("Recruitments_Create", "Requisition"))
          .Update(update => update.Action("Recruitments_Update", "Requisition"))
          .Destroy(destroy => destroy.Action("Recruitments_Destroy", "Requisition"))
      )
)
