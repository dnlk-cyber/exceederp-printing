@using ExceedERP.Core.Domain.Common
@(Html.Kendo().DropDownListFor(m => m)
 
                .DataTextField("Name")
                            .DataValueField("OrgStructureId")
               .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetDepartments", "HRMDataProvider");

                        })
                        .ServerFiltering(true);
                    })
                         .ValuePrimitive(true)
)
