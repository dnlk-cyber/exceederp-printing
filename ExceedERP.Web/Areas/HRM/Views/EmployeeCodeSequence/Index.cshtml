@using System.Collections
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Employee Code Setting</legend>
@(Html.Kendo().Grid<EmployeeCodeSequenceSetting>()
                  .Name("EmployeeCodeSequenceSettingggrid")
              .Columns(columns =>
              {
                  columns.Bound(c => c.Name).Width(100);
                  columns.Bound(c => c.ItemCodeTrim).Width(100);
                  columns.Bound(c => c.IndexCount).Width(100);
                  columns.Bound(c => c.Status).ClientTemplate("<input type='checkbox' disabled = 'true' #=Status ? checked='checked' :'' # >").Width(100);
                  columns.Command(command =>
                  {
                    //  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);  command.Destroy().Text(Resources.ActionButton_Cancel);
                  }).Width(100);
              })
              .ToolBar(toolbar =>
              {
                  //toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
              })
              .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Scrollable(h => h.Height(500))

                                 .Groupable()
                                          .Sortable(sortable =>
                                          {
                                              sortable.SortMode(GridSortMode.SingleColumn);
                                          })
                              .Filterable()
                                 .Pageable(pageable => pageable
                                                            .Input(true)
                                                            .Numeric(false)
                                                            .Refresh(true)
                                                            .PageSizes(true)
                                                            .ButtonCount(5))
              .DataSource(dataSource => dataSource
                  .Ajax()
                         .Events(events =>
                         {
                             events.Error("error_handler(\"EmployeeCodeSequenceSettingggrid\")");
                             events.RequestStart("onRequestStart(\"EmployeeCodeSequenceSettingggrid\")");
                             events.RequestEnd("onRequestEnd(\"EmployeeCodeSequenceSettingggrid\")");
                         }
                      )

                      .Model(model =>
                      {
                          model.Id(p => p.EmployeeCodeSequenceSettingId);
                          //model.Field(p => p.Remark).Editable(false);
                      })
                  .Read(read => read.Action("EmployeeCodeSequence_Read", "EmployeeCodeSequence"))
                  .Create(create => create.Action("EmployeeCodeSequence_Create", "EmployeeCodeSequence"))
                  .Update(update => update.Action("EmployeeCodeSequence_Update", "EmployeeCodeSequence"))
                  .Destroy(destroy => destroy.Action("EmployeeCodeSequence_Destroy", "EmployeeCodeSequence"))
              )
)
<script>

    function sync_handler(e) {
        this.read();

    }
    function AssignDate() {
        var list = AssignDates();
        return list;
    }

</script>