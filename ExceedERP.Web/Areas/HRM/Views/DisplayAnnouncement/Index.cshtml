
@using ExceedERP.Core.Domain.HRM.Company
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorAnnouncment_Announcment</legend>
@(Html.Kendo().Grid<Announcment>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Title);//.ClientTemplate("<a href="@Url.Action("AnnouncmentDetails_Read", "AnnouncementDetail")" target="_blank">"+Resources.NavigatorAnnouncment_AnnouncmentDetail+"</a>");
          //columns.Bound(c => c.Date);
          columns.Bound(c => c.DateAnnAmharic).EditorTemplateName ("Calander");
          columns.Bound(c => c.Remark);
          //columns.Bound(c => c.OrgBranchName);
          //columns.Bound(c => c.DateCreated);
          //columns.Bound(c => c.LastModified);
          //columns.Bound(c => c.CreatedBy);
          //columns.Bound(c => c.ModifiedBy);
          //columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel);  }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Events(e => { e.Save("GetDate"); 
                       e.Edit("GetDate");})
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(h => h.Height(500))
      .Groupable()
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(events =>
          {
              events.Error("error_handler(\"grid\")");
              events.RequestStart("onRequestStart(\"grid\")");
              events.RequestEnd("onRequestEnd(\"grid\")");
          })
                        
          .Model(model => model.Id(p => p.AnnouncmentId))
          .Read(read => read.Action("Announcmentes_Read", "DisplayAnnouncement"))
          .Create(create => create.Action("Announcmentes_Create", "DisplayAnnouncement"))
          .Update(update => update.Action("Announcmentes_Update", "DisplayAnnouncement"))
          .Destroy(destroy => destroy.Action("Announcmentes_Destroy", "DisplayAnnouncement"))
      ).ClientDetailTemplateId("template"))
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                  .Name("tabstrip_#=AnnouncmentId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text(Resources.NavigatorAnnouncment_AnnouncmentDetail).Content(
                @<text>
                    @(Html.Kendo().Grid<AnnouncmentDetail>()
      .Name("gridAA")
      .Columns(columns =>
      {
          columns.Bound(c => c.Detail);
          //columns.Bound(c => c.Remark);
          //columns.Bound(c => c.OrgBranchName);
          //columns.Bound(c => c.DateCreated);
          //columns.Bound(c => c.LastModified);
          //columns.Bound(c => c.CreatedBy);
          //columns.Bound(c => c.ModifiedBy);
          // columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel);  }).Width(200);
      })
                            //.ToolBar(toolbar =>
                            //{
                            //   // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                            //})
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
                    .Events(events =>
                 {
                     events.Error("error_handler(\"gridAA\")");
                     events.RequestStart("onRequestStart(\"gridAA\")");
                     events.RequestEnd("onRequestEnd(\"gridAA\")");
                 })
         

          .Model(model => model.Id(p => p.AnnouncDetailId))
                                  .Read(read => read.Action("AnnouncmentDetails_Read", "AnnouncementDetail", new { id = "#=AnnouncmentId#" }))
                          .Create(create => create.Action("AnnouncmentDetails_Create", "AnnouncementDetail"))
                  .Update(update => update.Action("AnnouncmentDetails_Update", "AnnouncementDetail"))
                  .Destroy(destroy => destroy.Action("AnnouncmentDetails_Destroy", "AnnouncementDetail"))
      ).ToClientTemplate()
                    )
                </text>
                  );
          }).ToClientTemplate())
</script>
