@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.FleetManagement.FleetRegistration.FleetInsurance


<div class="form">
    <div class="row fullrow">
        <div class="col-md-3 ro1">


            <div class="form-group">
                <div>@Html.LabelFor(model => model.InsuranceTypeId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.InsuranceTypeId)
                          .OptionLabel(Resources.Select)
                          .Filter("contains")
                          .MinLength(2)
                          .DataTextField("Name")
                          .DataValueField("InsuranceTypeId")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetInsuranceTypePPE", "HRMDataProvider"))
                                  .ServerFiltering(false);
                          })
                          .ValuePrimitive(true)

                    )
                    @Html.ValidationMessageFor(model => model.InsuranceTypeId, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
            <div class="col-md-3 ro1">
                <div class="form-group">
                    <div>@Html.LabelFor(model => model.InsuranceCategoryId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
                    <div class="col-md-6">
                        @(Html.Kendo().DropDownListFor(m => m.InsuranceCategoryId)
                          .DataTextField("Name")
                          .DataValueField("InsuranceCategoryId")
                          .OptionLabel(Resources.Select)
                          //.Filter(FilterType.Contains)
                          .Filter("contains")
                          //.MinLength(2)
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read =>
                              {
                                  read.Action("GetInsuranceCategory", "HRMDataProvider")
                                      .Data("filterCategories");
                              })
                                  .ServerFiltering(true);
                          }).ValuePrimitive(true)

                          //.Events(e => e.Change("GetNoOfShouldbe"))

                          .CascadeFrom("InsuranceTypeId")
                          //.AutoBind(false)
                          // .Enable(false)
                        )
                        @Html.ValidationMessageFor(model => model.InsuranceCategoryId, "", new { @class = "text-danger" })
                    </div>

                </div>
            </div>
