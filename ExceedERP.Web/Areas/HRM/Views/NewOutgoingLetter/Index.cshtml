@using ExceedERP.Core.Domain.HRM.ArchiveManagement
@using ExceedERP.Core.Localization
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorArchiveManagement_InstitutionOutgoingLetter</legend>
@(Html.Kendo().Grid<OutgoingLetter>()
                  .Name("NewOutgoingLettergrid")
              .Columns(columns =>
              {
                  columns.Bound(c => c.BookNo).Width(200);
                  columns.ForeignKey(c => c.OutgoingInstitutionName, (System.Collections.IEnumerable)ViewData["SubjectType"], "SubjectTypeId", "SubjectTypeName").Width(200);
                  columns.Bound(c => c.FolderNo).Width(100);
                  columns.Bound(c => c.LetterReferenceNo).Width(200);
                  columns.Bound(c => c.OutgoingLetterDateAm).Width(120);
                  columns.Bound(c => c.OutgoingTime).Width(100);
                  columns.Bound(c => c.OwnerName).Width(250);
                  columns.Bound(c => c.Subject).Width(100);
                  // columns.Bound(c => c.InstitutionTypeId);
                  columns.ForeignKey(c => c.InstitutionTypeId, (IEnumerable)ViewData["InstuType"], "InstitutionTypeId", "InstitutionName").EditorTemplateName("Institution").Width(150);

                  // columns.Bound(c => c.Shelve);
                  // columns.Bound(c => c.Row);
                  //columns.Bound(c => c.FileNo);
                  //columns.Bound(c => c.NoOfAttachment);
                  columns.Bound(c => c.SerialNo).Width(100);

                  //columns.Bound(c => c.Remark);
                  columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
              })
              .ToolBar(toolbar =>
              {
                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
              })
                          .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("NewOutgoing").Window(window => { window.Title(Resources.NavigatorArchiveManagement_InstitutionOutgoingLetter); window.Scrollable(false); }))
                            .Events(x =>
                            {
                                x.Edit("GetDate");
                                x.Save("GetDate");

                            })
                     .Selectable(selectable =>
                     {
                         selectable.Mode(GridSelectionMode.Single);
                         selectable.Type(GridSelectionType.Row);
                     })
                          .Scrollable(h => h.Height(500))
                             .Groupable()
                                      .Sortable(sortable =>
                                      {
                                          sortable.SortMode(GridSortMode.SingleColumn);
                                      })
                          .Filterable()
                             .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
              .DataSource(dataSource => dataSource
                  .Ajax()
                      .Events(events =>
                      {
                          events.Error("error_handler(\"NewOutgoingLettergrid\")");
                          events.RequestEnd("onRequestEnd(\"NewOutgoingLettergrid\")");
                      })

                  .Model(model => model.Id(p => p.NewOutgoingLetterLetterId))
                              .Read(read => read.Action("NewOutgoingLetter_Read", "NewOutgoingLetter"))
                          .Create(create => create.Action("NewOutgoingLetter_Create", "NewOutgoingLetter"))
                          .Update(update => update.Action("NewOutgoingLetter_Update", "NewOutgoingLetter"))
                          .Destroy(destroy => destroy.Action("NewOutgoingLetter_Destroy", "NewOutgoingLetter"))
              )
)
