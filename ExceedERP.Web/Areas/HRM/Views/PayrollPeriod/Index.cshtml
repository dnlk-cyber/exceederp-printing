@using ExceedERP.Core.Domain.HRM.Payroll
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPayrollSetup_PayrollPeriod</legend>
@(Html.Kendo().Grid<PayrollPeriod>()
          .Name("PayrollPeriod")
      .Columns(columns =>
      {
          columns.Bound(c => c.GLPeriodId).Hidden();
          columns.Bound(c => c.Name).Width(100);
          columns.Bound(c => c.DateFrom).Width(120);
          columns.Bound(c => c.DateTo).Width(120);
          columns.Bound(c => c.Status).EditorTemplateName("PeriodStatus").Width(150);
          columns.Bound(c => c.OrgBranchName).Width(120).Hidden(true);
          columns.Bound(c => c.DateCreated).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.LastModified).Width(150).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
          columns.Command(command =>
          {
              command.Custom("Close").Click("ClosePeriods");
              command.Custom("Open").Click("OpenPeriod");
          }).Width(180);
      })
      .HtmlAttributes(new { style = "height: 550px;" })
         .Scrollable(h => h.Height(500))
                             .Groupable()
                                      .Sortable(sortable =>
                                      {
                                          sortable.SortMode(GridSortMode.SingleColumn);
                                      })
                          .Filterable()
                             .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
      .Selectable()
     
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Groupable()
    //  .Events(ev => ev.DetailExpand("detailExpand"))
     // .Events(x => x.DataBound("onDataBoundMaster"))

      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(
              model =>
              {
                  model.Id(p => p.GLPeriodId);
                  model.Field(p => p.Status).Editable(false);
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);

              })
              .Events(ev => ev
                                    .Error("error_handler(\"PayrollPeriod\")")
                                    .RequestStart("onRequestStart(\"PayrollPeriod\")")
                                    .RequestEnd("onRequestEnd(\"PayrollPeriod\")"))
            .Read(read => read.Action("InventoryPeriods_Read", "PayrollPeriod"))
      )
    //.Events(events => events.DataBound("onDataBoundLines"))
      )



<script>


    function ClosePeriods(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.GLPeriodId;
        $.ajax({

            type: "GET",
            data: id,
            url: '@Url.Action("ClosePeriod", "PayrollPeriod")/' + id

        });

        $('#PayrollPeriod').data('kendoGrid').dataSource.read();
        $('#PayrollPeriod').data('kendoGrid').refresh();
        location.reload();
    };

    function OpenPeriod(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.GLPeriodId;
        console.log(dataItem);
        $.ajax({

            type: "GET",
            data: id, //I obtained the id properly
            url: '@Url.Action("OpenPeriod", "PayrollPeriod")/' + id

        });

        $('#PayrollPeriod').data('kendoGrid').dataSource.read();
        $('#PayrollPeriod').data('kendoGrid').refresh();
        location.reload();
    };
</script>

<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>

<script type="text/javascript">

</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 800px;
        height: auto;
    }

    div.k-content {
        overflow: hidden;
        height: auto;
    }
</style>
