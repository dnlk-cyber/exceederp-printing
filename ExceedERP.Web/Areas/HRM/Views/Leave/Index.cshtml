@using System.Collections
@using ExceedERP.Core.Domain.HRM.LeaveManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorLeave_Leave</legend>

@(Html.Kendo().Grid<Leave>()
              .Name("Leavegrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["AllEmployeeList"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Width(180);
          columns.Bound(c => c.LeaveType).EditorTemplateName("Enum").Width( 120);
          columns.Bound(c => c.Amount).Width( 90);
          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLPeriodSelector").Width(80);
          columns.Bound(c => c.FromAmharic).Width(120);
          columns.Bound(c => c.ToAmharic).Width( 120);
          columns.Bound(c => c.Day).Width(80);
          //columns.Bound(c => c.MorningOrAfternoon).Width( 100);
          //columns.Bound(c => c.After).Width( 100);
          //columns.Bound(c => c.Remark).Width( 100);
          columns.Command(command =>
          {
              //if (HttpContext.Current.User.IsInRole("HR_Leave_User"))
              //{
               //   command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
             // }
             // if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Leave_Admin"))
             // {
             //     command.Destroy().Text(Resources.ActionButton_Cancel);
             // }
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("HR_Leave_User"))
          {
            //  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
      })
                  .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("LeaveTaken").Window(window => { window.Title(Resources.NavigatorLeave_Leave); window.Scrollable(false); }))
          .Scrollable(h => h.Height(500))
             .Groupable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
                          //.Events(x => x.Edit("onGridEdit(e)")                      )
          .Filterable()
               .Events(x =>
                           {
                               x.Edit("GetDate");
                               x.Save("GetDate");
                           })
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
              .Sort(sort => sort.Add("DateCreated").Descending()) 
               .Events(events =>
                                        {

                                            events.Error("error_handler(\"Leavegrid\")");
                                            events.RequestStart("onRequestStart(\"Leavegrid\")");
                                            events.RequestEnd("onRequestEnd(\"Leavegrid\")");
                                        })
                      
          .Model(model =>
          {
              model.Id(p => p.TakenLeaveId);
              model.Field(p => p.After).Editable(false);
              model.Field(p => p.Before).Editable(false);
              model.Field(p => p.OrgName).Editable(false);
              model.Field(p => p.Amount).Editable(false);
          })
                  .Read(read => read.Action("Leaves_Read", "Leave"))
                  .Create(create => create.Action("Leaves_Create", "Leave"))
          .Update(update => update.Action("Leaves_Update", "Leave"))
          .Destroy(destroy => destroy.Action("Leaves_Destroy", "Leave"))
      )
)

