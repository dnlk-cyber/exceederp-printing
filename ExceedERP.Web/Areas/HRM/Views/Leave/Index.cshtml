<script >
    function filterByType()
    {
        var types = $("#LeaveType").data("kendoDropDownList");
        var type = types.value();
        if (type === "1") {
           // var dropDown = $("#Before").data("kendoTextEdit");
           // dropDown.enable(true);
            $("#Before").prop("disabled", false).removeClass("k-state-disabled");
            $("#After").prop("disabled", false).removeClass("k-state-disabled");
        }
        else {
            $("#Before").prop("disabled", true).addClass("k-state-disabled");
            $("#After").prop("disabled", true).addClass("k-state-disabled");
        }

        if (type === "4") {
            $("#OrgName").prop("disabled", false).removeClass("k-state-disabled");
          
        }
        else {
            $("#OrgName").prop("disabled", true).addClass("k-state-disabled");
         
        }

    }
</script>
<script >
    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").text=@Resources.ActionButton_Update;
        e.container.find(".k-button.k-grid-cancel").text=@Resources.ActionButton_Cancel;

    }
</script>
<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#FromAmharic").trigger("change");
        $("#ToAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "Leave")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }
    function valueMapper(options) {
        $.ajax({
            url: "/HRM/Leave/Employee_ValueMapper/",
            data: {
                value: options.value || 0,
                status: 1,
                excludeId: -1
            },
            success: function (data) {
                options.success(data);
            }
        });
    }

    function convertValues(value) {
        var data = {};

        value = $.isArray(value) ? value : [value];

        for (var idx = 0; idx < value.length; idx++) {
            data["values[" + idx + "]"] = value[idx];
        }

        return data;
    }
</script>