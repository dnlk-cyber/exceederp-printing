<legend>Complain Response</legend>
@(Html.Kendo().Grid<Complain>()
                  .Name("Complain")
                  .Columns(columns =>
                  {
                      columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(150);
                      columns.Bound(c => c.DateAmharic).EditorTemplateName("Calander").Width(100);
                      columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["TypeList"], "LookupId", "Description").EditorTemplateName("LookUpList").Width(100);
                      columns.Bound(c => c.ComplainDescription).Width(440); ;
                      columns.ForeignKey(c => c.RefersTo, (IEnumerable)ViewData["Orgs"], "OrgStructureId", "Name").EditorTemplateName("OrganizationDept").Width(150);
          // columns.ForeignKey(c => c.SendTo, (IEnumerable)ViewData["Orgs"], "OrgStructureId", "Name").EditorTemplateName("OrganizationDept").Width(200);

          columns.Bound(c => c.Remark).Width(100);
                      columns.Command(command =>
                      {
              // command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              // command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(80);
                  })



                  .Editable(editable => editable.Mode(GridEditMode.InLine))
                  .Scrollable(h => h.Height(500))
                  .Selectable(selectable =>
                  {
                      selectable.Mode(GridSelectionMode.Single);
                      selectable.Type(GridSelectionType.Row);
                  })
                  .Groupable()
                  .Sortable(sortable =>
                  {
                      sortable.SortMode(GridSortMode.SingleColumn);
                  })
                  .Filterable()
                  .Events(e =>
                  {
                      e.Save("GetDate");

                      e.Edit("GetDate");
                  })
                  .Pageable(pageable => pageable
                      .Input(true)
                      .Numeric(false)
                      .Refresh(true)
                      .PageSizes(true)
                      .ButtonCount(5))
                  .DataSource(dataSource => dataSource
                      .Ajax()
                      .Events(events =>
                      {
                          events.Error("error_handler(\"Complain\")");
                          events.RequestStart("onRequestStart(\"Complain\")");
                          events.RequestEnd("onRequestEnd(\"Complain\")");
                      })
                      .Model(model =>
                      {
                          model.Id(p => p.ComplainId);
                          model.Field(p => p.EmployeeId).Editable(false);
                          model.Field(p => p.LookupId).Editable(false);
                          model.Field(p => p.DateAmharic).Editable(false);
                          model.Field(p => p.ComplainDescription).Editable(false);
                      })
                      .Read(read => read.Action("ComplainResponseDepartment_Read", "ComplainResponseDepartment"))
                      .Create(create => create.Action("ComplainResponseDepartment_Create", "ComplainResponseDepartment"))
                      .Update(update => update.Action("ComplainResponseDepartment_Update", "ComplainResponseDepartment"))
                      .Destroy(destroy => destroy.Action("ComplainResponseDepartment_Destroy", "ComplainResponseDepartment"))
                     ).ClientDetailTemplateId("template")
)
