                                                                                                                              })

                                                                                                                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                                                                      .Scrollable()
                                                                                                                      .Selectable()
                                                                                                                      .DataSource(dataSource => dataSource
                                                                                                                          .Ajax()
                                                                                                                                  .Events(events =>
                                                                                                                                  {
                                                                                                                                      events.Error("error_handler(\"ComplainDetail#=ComplainId#\")");
                                                                                                                                      events.RequestStart("onRequestStart(\"ComplainDetail#=ComplainId#\")");
                                                                                                                                      events.RequestEnd("onRequestEnd(\"ComplainDetail#=ComplainId#\")");
                                                                                                                                  })


                                                      .Model(model => model.Id(p => p.ComplainDetailId))
                                                   .Read(read => read.Action("ComplainDetail_Read", "ComplainDetail", new { id = "#=ComplainId#" }))
                                                   .Create(create => create.Action("ComplainDetail_Create", "ComplainDetail", new { id = "#=ComplainId#" }))
