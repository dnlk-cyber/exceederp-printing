@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>@Resources.NavigatorPayrollProcess_Bonus</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.Payroll.Bonus>()
          .Name("Bonusgrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Width(180);
          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(105);
          columns.Bound(c => c.BounsFactor).Width(125);
          columns.Bound(c => c.PerformanceRate).Width(155);
          columns.Bound(c => c.BonusType).Width(200);
          columns.Bound(c => c.TotalBonus).Width(115);
          columns.Bound(c => c.TotalIncomeTax).Width(145);
          columns.Bound(c => c.IsClosed).ClientTemplate("<input type='checkbox' disabled='true' value='#=IsClosed #' " + " # if (IsClosed) { #" + "checked='checked'" + "# } #" + " />").Width(100);
          //columns.Command(command =>
          //{
          //   // command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); 
          //    command.Destroy().Text(Resources.ActionButton_Cancel);//
          //}).Width(200);
      })
        .ToolBar(toolbar =>
        {
            toolbar.Template(@<text>
                <div class="toolbar">
                    @(Html.Kendo().ComboBox()
                                           .Placeholder(Resources.HR_Payroll_EmployeePayroll_Bonus_GlFiscalYearId)
                                             .Name("From")

                                        .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetPeriod", "Bonus", new { area = "HRM" }))
                                                    .ServerFiltering(false);
                          })

                                    .DataTextField("Name")
                                      .DataValueField("GlFiscalYearId")
                                                   .AutoBind(false)
                                    //.Events(e => e.Change("Enable"))
                            .HtmlAttributes(new { style = "width: 300px;" })

                          )
                  @(Html.Kendo().ComboBox()
                                         .Name("Type")
                                         .Placeholder(Resources.HR_Payroll_EmployeePayroll_Bonus_BonusType)
                                         .DataTextField("Text")
                                         .BindTo(EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.Common.BonusType )))
                                         .DataValueField("Value")
                                         .AutoBind(false)
                                         //.Events(e => e.Change("Transfer"))
                                         .HtmlAttributes(new { style = "width: 200px;" })

                )
                  @(Html.Kendo().Button()
                      .Name("btnSave")
                      .HtmlAttributes(new { type = "button", @class = "k-primary" })
                              .Events(e => e.Click("Transfer"))
      .Content(Resources.Payroll_Process_Process))

                    @*@(Html.Kendo().Button()
                      .Name("btnReverse")
                      .HtmlAttributes(new { type = "button", @class = "k-primary" })
                              .Events(e => e.Click("Reverse"))
                          .Content(Resources.Payroll_Process_Reverse))*@

                    @(Html.Kendo().Button()
                      .Name("btnClose")
                      .HtmlAttributes(new { type = "button", @class = "k-primary" })
                              .Events(e => e.Click("Close"))
          .Content(Resources.Payroll_Process_Close))
                    <br />
                    <br />
                </div>
              
            </text>);
        })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
              .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
                                       .Events(events =>
                                                                                    {
                                                                                        events.Error("error_handler(\"Bonusgrid\")");
                                                                                        events.RequestStart("onRequestStart(\"Bonusgrid\")");
                                                                                        events.RequestEnd("onRequestEnd(\"Bonusgrid\")");
                                                                                    })

          .Model(model =>
          {
              model.Id(p => p.BonusId);
              model.Field(p => p.EmployeeId).Editable( false);
              model.Field(p => p.GlFiscalYearId).Editable(false);
              model.Field(p => p.BounsFactor).Editable(false);
              model.Field(p => p.PerformanceRate).Editable(false);
          })
          .Read(read => read.Action("Bonuses_Read", "Bonus"))
          .Create(create => create.Action("Bonuses_Create", "Bonus"))
          .Update(update => update.Action("Bonuses_Update", "Bonus"))
          .Destroy(destroy => destroy.Action("Bonuses_Destroy", "Bonus"))
      )
)
<script >
    function Transfer() {
        $('#loading-image').show();
        var from = $("#From").data("kendoComboBox");
        var type = $("#Type").data("kendoComboBox");
        try {
            $("#btnSave").removeClass("k-state-disabled");
            var period = from.value();
            var bType = type.value();
            if (period === "" || bType === "") {
                alert("Please select Period or Bonus Type!!");

            } else {
                if (!$("#btnSave").hasClass("k-state-disabled")) {
                    $("#btnSave").addClass("k-state-disabled");

                    //  progress();
                }
                //$("#run").on("click", function (eve) {
                $.ajax({
                    url: '@Url.Action("PrepareBonus", "Bonus")',
                    //contentType: "application/json; charset=utf-8",
                    data: { period: period, bType: bType },
                    type: 'POST',
                    cache: false,
                    success: function(result) {
                        r = result;
                        if (r.Status == "FAIL") {
                            alert(r.Message);
                        }

                        $("#Bonusgrid").data("kendoGrid").dataSource.read();
                        //$("#Bonusgrid").data("kendoGrid").refresh();
                        $("#btnSave").removeClass("k-state-disabled");

                        $('#loading-image').hide();
                    }


                });
            }


        } catch (e) {
            alert("Please select Period!!");
            $("#btnSave").removeClass("k-state-disabled");
        }
        //});
    }

    function Reverse() {
        var from = $("#From").data("kendoComboBox");
        var type = $("#Type").data("kendoComboBox");
        try {
            $("#btnReverse").removeClass("k-state-disabled");
            var period = from.value();
            //  var bType = type.value();
            if (period === "") {
                alert("Please select Period!!");

            } else {
                if (!$("#btnReverse").hasClass("k-state-disabled")) {
                    $("#btnReverse").addClass("k-state-disabled");

                    //  progress();
                }
                //$("#run").on("click", function (eve) {
                $.ajax({
                    url: '@Url.Action("Reverse", "Bonus")',
                    //contentType: "application/json; charset=utf-8",
                    data: { period: period, bType: 0 },
                    type: 'POST',
                    cache: false,
                    success: function(result) {
                        r = result;
                        $("#Bonusgrid").data("kendoGrid").dataSource.read();
                        $("#Bonusgrid").data("kendoGrid").refresh();
                        $("#btnReverse").removeClass("k-state-disabled");

                    }


                });
            }


        } catch (e) {
            alert("Please select Period!!");
            $("#btnReverse").removeClass("k-state-disabled");
        }
        //});
    }

    function Close() {
        var from = $("#From").data("kendoComboBox");
        var type = $("#Type").data("kendoComboBox");
        try {
            $("#btnClose").removeClass("k-state-disabled");
            var period = from.value();
            // var bType = type.value();
            if (period === "") {
                alert("Please select Period!!");

            } else {
                if (!$("#btnSave").hasClass("k-state-disabled")) {
                    $("#btnSave").addClass("k-state-disabled");

                    //  progress();
                }
                //$("#run").on("click", function (eve) {
                $.ajax({
                    url: '@Url.Action("Close", "Bonus")',
                    //contentType: "application/json; charset=utf-8",
                    data: { period: period },
                    type: 'POST',
                    cache: false,
                    success: function(result) {
                        r = result;
                        $("#Bonusgrid").data("kendoGrid").dataSource.read();
                        $("#Bonusgrid").data("kendoGrid").refresh();
                        $("#btnClose").removeClass("k-state-disabled");

                    }


                });
            }


        } catch (e) {
            alert("Please select Period!!");
            $("#btnClose").removeClass("k-state-disabled");
        }
        //});
    }


</script>
<script>
    function Enable(e) {

        var save = $("#btnSave").data("kendoButton");
        var reverse = $("#btnReverse").data("kendoButton");
        var close = $("#btnClose").data("kendoButton");
      

        save.enable(false);
        reverse.enable(false);
        close.enable(false);
        
      

        var periods = $("#From").data("kendoComboBox");
       


        var id = periods.value();
       

        $.ajax({
            url: '@Url.Action("CheckStatus", "Bonus")',
            contentType: "application/json; charset=utf-8",
            data: { 'id': id},
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "c") {
                    save.enable(false);
                   
                    reverse.enable(false);
                    close.enable(false);
                   


                    
                }
                else if (r == "r") {
                    save.enable(true);
                    reverse.enable(false);
                    close.enable(false);



                    
                }
                else if (r == "n") {
                    save.enable(false);
                    reverse.enable(true);
                    close.enable(true);
                   
                }
                else {
                    save.enable(false);
                    reverse.enable(true);

                    close.enable(true);

                   
                }
            }

        });

    }
</script>