@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.Common
@(Html.Kendo().DropDownListFor(x=> x)
.OptionLabel( Resources.Select)
         .DataTextField("Name")
                        .DataValueField("GlFiscalYearId")
                              .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetPeriodOther", "HRMDataProvider", new { area = "HRM" }))
                                                    .ServerFiltering(false);
                          })
                         .ValuePrimitive(true)
)