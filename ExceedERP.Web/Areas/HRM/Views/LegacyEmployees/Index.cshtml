    //        comboTitle.text(comboTitlevalue); // force display even if not in list
    //    }
    //    if (comboBranchValue) {
    //        comboBranch.text(comboBranchValue); // force display even if not in list
    //    }
    //    if (SubBranchvalue) {
    //        subBranchCombo.text(SubBranchvalue); // force display even if not in list
    //    }
    //});
    function onDataBound(e)
    {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++)
        {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            if (dataItem.IsProcessed)
            {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-enable").hide();
                row.find(".k-grid-Process").hide();
                row.css("background-color", "gray");

            }

        }
    }


