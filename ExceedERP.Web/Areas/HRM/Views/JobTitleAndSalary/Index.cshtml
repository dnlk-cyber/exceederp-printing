tabstrip.Add()
.Text("Salary Job Title")
.Content(@<text>
<div class="form-group">
        <label>Is Job Title Included In Salary ? &nbsp;&nbsp;</label>
        <input type="checkbox" name="IsJobTitleIncludedInSalary" id="IsJobTitleIncludedInSalary" class="checkboxsize" style="display:inline;" onchange="ChangeSalarySetting()"/>
    <br />
</div>
<br /><br />

    @(Html.Kendo().Grid<SalaryJobTitle>()
            .Name("SalaryJobTitle")
            .Columns(columns =>
            {
                if (isJobTitleIncludedInSalary == true)
                {
                    columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["jobTitles"], "LookupId", "Description").EditorTemplateName("JobTitles").Width(150);
                }
                columns.ForeignKey(c => c.RankId, (IEnumerable)ViewData["RankList"], "RankId", "RankName").EditorTemplateName("Rank").Width(150);
                columns.ForeignKey(c => c.StepId, (IEnumerable)ViewData["StepList"], "StepId", "StepName").EditorTemplateName("Step").Width(150);
                columns.Bound(c => c.Salary).Width(150);
                columns.Bound(c => c.Remark).Width(120);
                columns.Command(command =>
                {
                    if (HttpContext.Current.User.IsInRole("HR_Company_User"))
                    {
                        command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                    }
                    if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Company_Admin"))
                    {
                        command.Destroy().Text(Resources.ActionButton_Cancel);//
                    }
                }).Width(200);
            })
