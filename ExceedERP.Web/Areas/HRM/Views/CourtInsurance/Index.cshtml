<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#DateInsuAmhairc").trigger("change");
        $("#DateAssocAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "CourtInsurance")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
