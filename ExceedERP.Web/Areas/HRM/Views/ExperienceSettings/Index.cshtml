@using System.Collections
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Domain.HRM.RecruitmentManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Experience Setting</legend>
@(Html.Kendo().Grid<ExperienceSetting>()
          .Name("ExperienceSettingGrid")
      .Columns(columns =>
      {
           columns.Bound(c => c.Jobtitle).Width(150);
          //columns.Bound(c => c.Remark);
          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(150);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
              .Events(events =>
              {

                  events.Error("error_handler(\"ExperienceSettingGrid\")");
                  events.RequestStart("onRequestStart(\"ExperienceSettingGrid\")");
                  events.RequestEnd("onRequestEnd(\"ExperienceSettingGrid\")");
              })

          .Model(model => model.Id(p => p.ExperienceSettingId))
                  .Read(read => read.Action("ExperienceSettings_Read", "ExperienceSettings"))
                      .Create(create => create.Action("ExperienceSettings_Create", "ExperienceSettings"))
                  .Update(update => update.Action("ExperienceSettings_Update", "ExperienceSettings"))
                  .Destroy(destroy => destroy.Action("ExperienceSettings_Destroy", "ExperienceSettings"))
      )
)

<script>
    function filterCategories() {
        return {
            Reference: $("#Reference").val()
        };
    }
</script>
<script>
    function filterAttributes() {
        return {
            Attribute: $("#Attribute").val()
        };
    }


</script>
<script>
    function filterCurrentValue() {
        return {
            Attribute: $("#CurrentValue").val()
        };
    }


</script>
<script>


    function sync_handler(e) {
        this.read();

    }
</script>