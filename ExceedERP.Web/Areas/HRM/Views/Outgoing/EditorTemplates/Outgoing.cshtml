@using ExceedERP.Helpers.Common
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.Letters.Outgoing


<form>

<div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">
            @Html.Kendo().TextBoxFor(model => model.Name)
            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.Owner, htmlAttributes: new {@class = "control-label col-md-8"})
        </div>
        <div class="form-group">
            @(Html.EnumDropDownListFor(m => m.Owner, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 140px" })
                
                  )
            @Html.ValidationMessageFor(model => model.Owner, "", new {@class = "text-danger"})
        </div>
    </div>

    <div class="col-md-3">

        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.Date, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div>

                @Html.Kendo().DatePickerFor(model => model.Date)
                @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
            </div>
        </div>

    </div>
</div>

<br/>
<div class="row">
    <div class="col-md-1">

    </div>


    <div class="col-md-3">

        <div class="form-group">

            <div class="k-label">
                @Html.LabelFor(model => model.CardSerialNo, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>
                @Html.Kendo().TextBoxFor(model => model.CardSerialNo)
                @Html.ValidationMessageFor(model => model.CardSerialNo, "", new { @class = "text-danger" })

            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.FolderNo, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>

                @Html.Kendo().TextBoxFor(model => model.FolderNo)
                @Html.ValidationMessageFor(model => model.FolderNo, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

</div>
<br/>





</form>
