        if (employeeCode && employeeCode.trim() !== "")
        {
            return;
        }
         var hireDateAm = $("#HiredDateAmharic").val();
         var Hirdate = $("#HiredDate").val();
        $.ajax({
            url: '@Url.Action("GetEmployeeCode", "EmployeeProfile",new { area="HRM"})',
            type: 'POST',
            data: {
                hireDate: Hirdate,
                hirDateAm: hireDateAm
            },
            cache: false,
            success: function (result)
            {
                
                $("#EmployeeCode").val(result).trigger("change");

            },
            error: function (xhr, status, error) {
                console.error("Error fetching Employee Code:", error);
            }
        });
    }


    function updateEmployeeProbation(element)
    {

        var $button = $(element);
        var $icon = $button.find('i');
        var originalIcon = $icon.attr('class');

        if (!confirm("Are you sure you want to upadte  employee status in cantact and  probation?")) {
            return;
        }

        // Spinner ON
        $icon.attr('class', 'fa fa-spinner fa-spin');
        $button.prop('disabled', true);
        $('#loading-image').show();
        $.ajax({
            url: '@Url.Action("UpdateAllContractandProbationStatus", "EmployeeProfile")',
            type: 'POST',
            dataType: 'json',
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (response) {
                alert(response.Message);

                // Refresh grids so probation/contract colors (e.g. yellow -> permanent) reflect the updated status
                $.each(["Person_Employeegrid", "Person_probation_Employeegrid", "Contact_Employeegrid", "retiring_Employeegrid"], function (i, gridName) {
                    var $grid = $("#" + gridName);
                    if ($grid.length && $grid.data("kendoGrid")) {
                        $grid.data("kendoGrid").dataSource.read();
                    }
                });
            },
            error: function (xhr) {
                console.log(xhr.responseText); // <=== will show anti-forgery error message
                alert('An error occurred while refreshing salary. Please try again.');
            },
            complete: function () {
                $('#loading-image').hide();
                $icon.attr('class', originalIcon);
                $button.prop('disabled', false);
            }
        });
    }


   
    function registerAllEmployeesToBiometricMachine(element)
    {
    var $button = $(element);
    var $icon = $button.find('i');
    var originalIcon = $icon.attr('class');

    try {
        // Show loading spinner and disable button
        $icon.attr('class', 'fa fa-spinner fa-spin');
        $button.prop('disabled', true);
        $('#loading-image').show();

        $.ajax({
            url: '@Url.Action("RegisterAllEmployeesToBiometric", "EmployeeProfile")',
            type: 'POST',
            dataType: 'json',
            success: function (response) {
                // Show success or error message from server
                if (response.success) {
                    alert(response.message || "Employees successfully registered.");
                } else {
                    alert(response.message || "Some employees could not be registered.");
                }
            },
            error: function (xhr, status, error) {
                console.error('Biometric registration error:', error, xhr.responseText);
                alert('An error occurred while registering employees. Please try again.');
            },
            complete: function () {
                // Restore original button state
                $icon.attr('class', originalIcon);
                $button.prop('disabled', false);
                $('#loading-image').hide();
            }
        });
    } catch (ex) {
        console.error('Unexpected error:', ex);
        alert('An unexpected error occurred.');
        $icon.attr('class', originalIcon);
        $button.prop('disabled', false);
        $('#loading-image').hide();
    }
}


    function employeeBiometricAutoRegistration(e)
    {

        e.preventDefault();

         var grid = $("#Person_Employeegrid").data("kendoGrid");

         var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));

        $.ajax({
            url: '@Url.Action("RegisterEmployeeToBiometric", "EmployeeProfile", new { area="HRM"})',
            type: 'POST',
            data: { empId: dataItem.EmployeeId },
            success: function (res) {

                if (res.Success) {
                    alert(res.message);
                } else {
                    alert(res.message);
                }
                grid.dataSource.read();

            },
            error: function () {
                alert("Error registering employee to biometric system.");
            }
        });
    }

    function employeeBiometricAutoExempt(e) {
        e.preventDefault();

        var grid = $("#Person_Employeegrid").data("kendoGrid");
        var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));

        $.ajax({
            url: '@Url.Action("ToggleBiometricExemption", "EmployeeProfile", new { area="HRM"})',
            type: 'POST',
            data: { empId: dataItem.EmployeeId },
            success: function (res) {
                if (res.Success) {
                    alert(res.message);
                } else {
                    alert(res.message);
                }
                grid.dataSource.read();
            },
            error: function () {
                alert("Error updating employee attendance exemption status.");
            }
        });
    }
