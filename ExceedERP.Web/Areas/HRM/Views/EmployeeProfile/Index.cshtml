    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.ProhabitionState === 0) {

                row.css("background-color", "red");

            }
            else if (dataItem.IsActive === false) {

                row.css("background-color", "grey");

            }
            else if (dataItem.ProhabitionState === 2) {

                row.css("background-color", "yellow");

            }
            if (dataItem.Status === 4)
            {
                row.css("background-color", "red");
            }
          if (dataItem.IsProbationEnd === true) {

                row.css("background-color", "yellow");

            }


            if (dataItem.ContratLeftDay !== null && dataItem.ContratLeftDay <= 30) {

                row.css("background-color", "lightGreen");

            }
             //retirement notification before 6 months  but it will rtired after 60
            if (dataItem.Age >59.5) {

                row.css("background-color", "olive");

            }

        }

    }
    function Change(e) {

