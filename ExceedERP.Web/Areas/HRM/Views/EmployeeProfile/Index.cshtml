                    columns.Bound(c => c.Religion).EditorTemplateName("Enum").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100).Visible(false);
                    columns.Bound(c => c.Status).EditorTemplateName("Enum").Width(100).Filterable(ftb => ftb.Multi(true).Search(true)).Visible(true);
                    columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsActive ? checked='checked' :'' # >").Width(100).Visible(true);
                    columns.ForeignKey(c => c.Nation, (IEnumerable)ViewData["NationList"], "LookupId", "Description").EditorTemplateName("Nation").Width(100).Visible(true);
                    // columns.ForeignKey(c => c.Nationality, (IEnumerable)ViewData["Nationalites"], "CountryId", "Nationality").EditorTemplateName("NationalityList").Width(100);
                    columns.Bound(c => c.MartialStatus).EditorTemplateName("Enum").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
                    //  columns.ForeignKey(c => c.Nation, (IEnumerable)ViewData["Nation"], "Nation", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
                    //columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox' disabled = 'true' \\#= Status ? checked='checked' :'' \\# />").Width(100);
                    columns.Bound(c => c.PhoneNo).Width(120);                                     
                   //  columns.Bound(c => c.BirthPlace).Width(120);
                    columns.Command(command =>
                    {
                        if (HttpContext.Current.User.IsInRole("HR_Profile_User"))
                        {
                            command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                        }
                        if (HttpContext.Current.User.IsInRole("HR_Profile_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
                        {
                            command.Destroy().Text(Resources.ActionButton_Cancel);
                        }
                    }).Width(200);
                })
             .ToolBar(toolbar =>
             {
             toolbar.Template(@<text>
               <div class="toolbar" style="">
               @if (HttpContext.Current.User.IsInRole("HR_Profile_User"))
               {
                @*@item.CreateButton(Resources.ActionButton_AddNewRecord);*@              
               }        
              </div>
               </text>);
               })                                          
                    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("PersonEmployeeNew").Window(window => { window.Title(Resources.Navigator_Employee_EmployeeProfile); window.Scrollable(false); }))
                    .Scrollable(h => h.Height(500))
                    // .Groupable()
                    .Sortable(sortable =>
                    {
                        sortable.SortMode(GridSortMode.SingleColumn);
                    })                                
                       .Filterable()
                       .ColumnMenu()
                       .Events(e =>
                       {
                           e.Save("GetDate");
                           e.DataBound("onDataBound");
                           e.Edit("GetDate");
                       })
                      .Pageable(pageable => pageable
                      .Input(true)
                      .Numeric(false)
                      .Refresh(true)
                      .PageSizes(true)
                      .ButtonCount(5)
                      .Enabled(true))                      
                      .DataSource(dataSource => dataSource
                      .Ajax()
                      .Sort(sort => sort.Add("EmployeeCode").Descending())
                      .ServerOperation(true)
                      .Events(events =>
                      {
                          events.Error("error_handler(\"Person_Employeegrid_NotPlaced\")");
                          events.RequestStart("onRequestStart(\"Person_Employeegrid_NotPlaced\")");
                          events.RequestEnd("onRequestEnd(\"Person_Employeegrid_NotPlaced\")");
                      })
                       .Model(model => model.Id(p => p.EmployeeId))
                       .Read(read => read.Action("NotPlaced_Employees_Read", "InActiveEmployees"))
                       .Create(create => create.Action("Person_Employee_Create", "EmployeeProfile"))
                       .Update(update => update.Action("Person_Employee_Update", "EmployeeProfile"))
                       .Destroy(destroy => destroy.Action("Person_Employee_Destroy", "EmployeeProfile"))
                       ).ClientDetailTemplateId("template")

        )
}
