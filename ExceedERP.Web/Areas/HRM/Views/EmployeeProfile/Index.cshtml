    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsBiometricRegistered === true)
            {

                row.find("#employeeBiometricRegistration").hide();
            }

            var $exemptBtn = row.find("#employeeBiometricExempt");

            if (dataItem.IsAttendanceExempt === true) {
                // If exempt (excluded from payroll/attendance), show 'Include' button
                $exemptBtn
                    .removeClass("btn-primary btn-warning")
                    .addClass("btn-success")
                    .html("<i class='fa fa-check-circle'></i> Include")
                    .attr("title", "Click to include employee back in attendance and payroll consideration");
            } else {
                // If not exempt (included), show 'Exclude' button
                $exemptBtn
                    .removeClass("btn-primary btn-success")
                    .addClass("btn-warning")
                    .html("<i class='fa fa-ban'></i> Exclude")
                    .attr("title", "Click to exclude employee from biometric attendance and payroll consideration");
            }

            if (dataItem.IsActive === false) {

                row.css("background-color", "grey");

            }
            else if (dataItem.ProhabitionState === 2) {

                row.css("background-color", "yellow");

            }
            else {
                // Clear any stale probation coloring once the employee is permanent/active (e.g. after probation update)
                row.css("background-color", "");
            }
            if (dataItem.Status === 4)
            {
                row.css("background-color", "red");
            }



            if (dataItem.ContratLeftDay !== null && dataItem.ContratLeftDay <= 30) {

                row.css("background-color", "lightGreen");

            }
             //retirement notification before 6 months  but it will rtired after 60
            if (dataItem.Age >59.5) {

                row.css("background-color", "olive");

            }

        }

    }
    function Change(e) {

        var x = e.value;

        // PHONE TYPE
        if (["0", "1", "2", "3"].includes(x)) {

            $("#Value")
                .attr("type", "tel")
                .attr("placeholder", "+251912345678 or 0912345678")
                .off("blur")
                .on("blur", function () {

                    var val = $(this).val();

                    if (val && !isValidPhone(val)) {
                        alert("Invalid phone number format");
                        $(this).focus();
                    }
                });
        }

        // EMAIL TYPE
        else if (["4", "5", "6", "7", "14", "15"].includes(x)) {

            $("#Value")
                .attr("type", "email")
                .attr("placeholder", "email@example.com")
                .attr("required", true);
        }

        // DEFAULT
        else {
            $("#Value")
                .attr("type", "text")
                .attr("placeholder", "")
                .removeAttr("required")
                .off("blur");
        }
    }


    // Validation function
    function isValidPhone(phone) {
        const regex = /^(\+2519\d{8}|09\d{8}|\+[1-9]\d{7,14})$/;
        return regex.test(phone);
    }
