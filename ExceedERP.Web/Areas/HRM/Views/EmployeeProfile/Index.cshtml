        car = car.replace(/፱0/g, "፺");
        car = car.replace(/፲0/g, "፻");
        car = car.replace(/፳0/g, "፪፻");
        car = car.replace(/፺0/g, "፱፻");
        car = car.replace(/፻0/g, "፲፻");
        car = car.replace(/፲፻0/g, "፼");

