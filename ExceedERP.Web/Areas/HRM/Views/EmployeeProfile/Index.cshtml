    function onExcelExportClick()
    {
        // Get the reference to the grid
         var grid = $("#Person_Employeegrid").data("kendoGrid");

        // Get the URL for the Excel export action
        var excelExportUrl = "@Url.Action("Excel_Export_Save", "EmployeeProfile")";

        // Trigger the Excel export
        grid.saveAsExcel({
            fileName: "EmployeeData.xlsx",
            proxyURL: excelExportUrl,
            allPages: true
        });
    }
</script>
<script>
    var masterId = 0;
    var employeeId = 0;
    function onDetailExpandActiveUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#Person_Employeegrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.EmployeeId;


    }
    function onDetailExpandInActiveUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#Person_Employeegrid_NotPlaced").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.EmployeeId;


    }
    function onDetailExpandInActive(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#InActive_Person_Employeegrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.EmployeeId;
    }
    function onUploadSuccess(e) {
        // Force the rebinding of the Grid on successful upload
        $("#PhotoAttachmentGrid" + masterId).data("kendoGrid").dataSource.read();
    }
    function onUploadSuccess1(e) {
        // Force the rebinding of the Grid on successful upload
        $("#Documents_Attach_" + masterId).data("kendoGrid").dataSource.read();
    }
    function onUploadSuccess2(e) {
        // Force the rebinding of the Grid on successful upload
        $("#OtherDocuments_Attach_" + masterId).data("kendoGrid").dataSource.read();
    }
</script>
<script>
    $(document).ready(function () {
        var grid = $("#Person_Employeegrid").data("kendoGrid");
        var uploadForm = document.getElementById('uploadForm');

        if (uploadForm) {
            uploadForm.onsubmit = function () {
                var selectedRow = grid.select();
                if (selectedRow.length > 0) {
                    var employeeId = grid.dataItem(selectedRow[0]).EmployeeId;
                    this.action = `/HRM/EmployeeProfile/AttachmentTemplateFiles_Create?attachmentReferenceType=photo&id=${employeeId}&fileOwner=${employeeId}`;
                } else {
                    alert("Please select an employee before uploading.");
                    return false;
                }
            };
        }
    });

