@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isManual = ViewData["isManual"] != null && (bool)ViewData["isManual"];
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? true;
    bool autoReg = ViewData["autoEmployeeReg"] as bool? ?? false;
    bool autoExempt = ViewData["autoEmployeeExempt"] as bool? ?? false;

}
<div class="ep-page-header">
    <i class="fa fa-id-card"></i>
    <legend>@Resources.Navigator_Employee_EmployeeProfile</legend>
</div>
@(Html.Kendo().TabStrip()
    .Name("tabstrip")
    .Animation(animation =>
    animation.Open(effect =>
    effect.Fade(FadeDirection.In)))
    .Items(tabstrip =>
    {

        tabstrip.Add().Text(Resources.Navigator_Employee_EmployeeProfile)
        .Selected(true)
        .Content(
            @<text>
            @EmployeeProfile()
            </text>);
        tabstrip.Add().Text(Resources.Navigator_Employee_Not_Placed_Employee)
        .Selected(false)
        .Content(
            @<text>
                @NotPlaced_Employees()
            </text>);
        tabstrip.Add().Text(Resources.Navigator_Employee_Inactive_Employee)
        .Content(
            @<text>
                @InActiveEmployeeAllDatas()
            </text>);
        tabstrip.Add().Text(Resources.Probation).Content(
            @<text>
                @ProbationEmployees()
            </text>);
        tabstrip.Add().Text(Resources.Expiring_Soon).Content(
            @<text>
                @ContractEmployeesLessThan30()
            </text>);
        tabstrip.Add().Text(Resources.Retirement_Eligibility_180_Days).Content(
            @<text>
                @RetiringEmolyeeNotificationBefore180DaysLeft()
            </text>);

    }))

<div class="notplacedemployees">

    @helper NotPlaced_Employees()
    {

        bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? true;
        <script id="fileTemplate" type="text/x-kendo-template">
            <span class='k-progress'></span>
            <div class='file-wrapper'>
                <span class='file-icon #=addExtensionClass(files[0].extension)#'></span>
                <h4 class='file-heading file-name-heading'>Name: #=name#</h4>
                <h4 class='file-heading file-size-heading'>Size: #=size# bytes</h4>
                <button type='button' class='k-upload-action'></button>
            </div>
        </script>
        <div class="row">
            <p>
                <span class="fa fa-circle" style="color:lightgreen;"></span>&nbsp;&nbsp;@Resources.HR_Contract_Below_15_day_left,&nbsp;&nbsp;
                <span class="fa fa-circle" style="color:gray;"></span>&nbsp;&nbsp;@Resources.Navigator_Employee_Inactive_Employee,&nbsp;&nbsp;
                <span class="fa fa-circle" style="color:yellow;"></span>&nbsp;&nbsp;@Resources.HR_Probation_Period,&nbsp;&nbsp;
                <span class="fa fa-circle" style="color:red;"></span>&nbsp;&nbsp;@Resources.HR_Probation_Period_end_or_no_status &nbsp;&nbsp;
                <span class="fa fa-circle" style="color:olive;"></span>&nbsp;&nbsp;@Resources.Rpt_RetirementNotification  &nbsp;&nbsp;
               
            </p>
        </div>
        @(Html.Kendo().Grid<Person_Employee>()
              .Name("Person_Employeegrid_NotPlaced")
              .Columns(columns =>
              {
                  //columns.Bound(c => c.EmployeeCode).ClientTemplate(
                  //              @"<div class='Employee-photo'
                  //         style='background-image: url(" + Url.Content("~/Content/Images/") + "#:data.EmployeeId#-Photo/" + "#:data.EmployeeId#.jpg" + ");'></div>" +
                  //          "<div class='Employee-name'>#:EmployeeCode#</div>").Width(150);
                  columns.Bound(c => c.EmployeeCode).ClientTemplate(
                                        @"<div class='Employee-photo'
                            style='background-image: url(" + Url.Action("ResolveImage", "EmployeeProfile") + "/#:EmployeeId#);'></div>" +
                                        "<div class='Employee-name'>#:EmployeeCode#</div>"
                                    ).Width(150);
                  columns.Bound(c => c.Title).EditorTemplateName("Enum").Width(50).Visible(false);
                  columns.Bound(c => c.IsProbationEnd).Visible(false);
                  columns.Bound(c => c.FirstName).Width(100);//Filterable(ftb => ftb.Multi(true).Search(true))
                  columns.Bound(c => c.MiddleName).Width(100);
                  columns.Bound(c => c.LastName).Width(100);
                  columns.Bound(c => c.FirstNameEnglish).Width(100);
                  columns.Bound(c => c.MiddleNameEnglish).Width(100);
                  columns.Bound(c => c.LastNameEnglish).Width(100);
                  columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
                  columns.ForeignKey(c => c.EmployeeTypeId, (IEnumerable)ViewData["employeeType"], "EmployeeTypeId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
                  //columns.Bound(c => c.MothersFullName).Width(100);
                  columns.Bound(c => c.Gender).EditorTemplateName("Enum").Filterable(ftb => ftb.Multi(true).Search(true)).Width(80);
                  if (useEthiopian)
                  {
                      columns.Bound(c => c.DateOfBirthAm).EditorTemplateName("Calander").Width(160);
                      columns.Bound(c => c.HiredDateAmharic).EditorTemplateName("Calander").Width(160);
                  }
                  else
                  {

                      columns.Bound(c => c.DateOfBirth).Width(160);
                      columns.Bound(c => c.HiredDate).Width(160);
                  }
                  columns.Bound(c => c.Region).EditorTemplateName("Enum").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100).Visible(false);
                  columns.Bound(c => c.Religion).EditorTemplateName("Enum").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100).Visible(false);
                  columns.Bound(c => c.Status).EditorTemplateName("Enum").Width(100).Filterable(ftb => ftb.Multi(true).Search(true)).Visible(true);
                  columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsActive ? checked='checked' :'' # >").Width(100).Visible(true);
                  columns.ForeignKey(c => c.Nation, (IEnumerable)ViewData["NationList"], "LookupId", "Description").EditorTemplateName("Nation").Width(100).Visible(true);
                  // columns.ForeignKey(c => c.Nationality, (IEnumerable)ViewData["Nationalites"], "CountryId", "Nationality").EditorTemplateName("NationalityList").Width(100);
                  columns.Bound(c => c.MartialStatus).EditorTemplateName("Enum").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
                  //  columns.ForeignKey(c => c.Nation, (IEnumerable)ViewData["Nation"], "Nation", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
                  //columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox' disabled = 'true' \\#= Status ? checked='checked' :'' \\# />").Width(100);
                  columns.Bound(c => c.PhoneNo).Width(120);
                  //  columns.Bound(c => c.BirthPlace).Width(120);
                  columns.Command(command =>
                  {
                      if (HttpContext.Current.User.IsInRole("HR_Profile_User"))
                      {
                          command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                      }
                      if (HttpContext.Current.User.IsInRole("HR_Profile_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
                      {
                          command.Destroy().Text(Resources.ActionButton_Cancel);
                      }
                  }).Width(200);


              })
              .Excel(excel => excel
                            .FileName(Resources.Navigator_Employee_EmployeeProfile + ".xlsx")
                            .Filterable(true)
                            .AllPages(true)
                        )
                            .Pdf(pdf => pdf
                            .AllPages()
                            .Landscape()
                            .FileName(Resources.Navigator_Employee_EmployeeProfile + ".pdf")
                        )
                        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("PersonEmployee").Window(window => { window.Title(Resources.Navigator_Employee_EmployeeProfile); window.Scrollable(false); }))
                        .Scrollable(h => h.Height(500))
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })

                        .Filterable()
                        .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5)
                                .Enabled(true))
                                .Events(ev =>
                                {
                                    ev.DetailExpand("onDetailExpandInActive");
                                })
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Sort(sort => sort.Add(x => x.EmployeeId).Descending())
                                .ServerOperation(true)
                                .Events(events =>
                                {
                                    events.Error("error_handler(\"Person_Employeegrid_NotPlaced\")");
                                    events.RequestStart("onRequestStart(\"Person_Employeegrid_NotPlaced\")");
                                    events.RequestEnd("onRequestEnd(\"Person_Employeegrid_NotPlaced\")");


                                })
                                .Model(model => model.Id(p => p.EmployeeId))
                                .Read(read => read.Action("NotPlaced_Employees_Read", "InActiveEmployees").Data("sendForgery"))
                                .Create(create => create.Action("Person_Employee_Create", "EmployeeProfile").Data("sendForgery"))
                                .Update(update => update.Action("Person_Employee_Update", "EmployeeProfile").Data("sendForgery"))
                                .Destroy(destroy => destroy.Action("Person_Employee_Destroy", "EmployeeProfile").Data("sendForgery"))
                                ).ClientDetailTemplateId("template")

        )
    }
