@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.Common
@(Html.Kendo().DropDownListFor(m => m)
         .OptionLabel(Resources.Select)
                                    .DataTextField("Name")
                                            .DataValueField("WoredaId")
                                             .Filter("contains")
                                              .CascadeFrom("ZoneId")
              .DataSource(dataSource =>
              {
                  dataSource.Read(read => read.Action("GetWoredas", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery").Data("filterWoredas"))
                      .ServerFiltering(true);
              })
                            .ValuePrimitive(true)
)
