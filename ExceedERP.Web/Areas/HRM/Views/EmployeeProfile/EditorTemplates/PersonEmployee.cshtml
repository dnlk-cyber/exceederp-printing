        <div class="col-md-3 ro1">
            <div class="form-group">

                @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @*@Html.EnumDropDownListFor(m => m.Title, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 140px" })*@

                    @(Html.Kendo().DropDownListFor(m => m.Title)
                              .DataTextField("Description")
                              .DataValueField("LookupId")
                              .OptionLabel(Resources.Select)
                              .Filter(Resources.Select)
                              .ValuePrimitive(true)
                              .DataSource(dataSource =>
                              {
                                  dataSource.Read(read => read.Action("GetPersonTitle", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery"))
                                      .ServerFiltering(false);
                              })

                    )

                    @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Gender, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">

                    @(Html.EnumDropDownListFor(m => m.Gender, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 140px" })

                    )
                    @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })
                </div>
            </div>
