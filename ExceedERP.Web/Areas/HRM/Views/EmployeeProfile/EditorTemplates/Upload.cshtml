@using ExceedERP.Core.Localization
@using (Html.BeginForm("Upload", "EmployeeProfile",
        new { area = "HRM"},
        FormMethod.Post,
        new { enctype = "multipart/form-data", id = "uploadForm" }))
    {
        @Html.AntiForgeryToken()
        <fieldset>
            <div class="editor-field">
                @Html.TextBox("file", "", new {
                    type = "file",
                    id = "file",
                    name = "file",
                    accept = "image/*",
                    capture = "environment"
                })
            </div>
            <br />
            <div class="editor-field">
                <input type="submit" value="@Resources.HR_ActionButton_Upload" />
            </div>
        </fieldset>


}

