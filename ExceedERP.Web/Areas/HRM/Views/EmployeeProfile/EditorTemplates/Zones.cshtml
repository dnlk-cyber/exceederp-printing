@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.Common
@(Html.Kendo().DropDownListFor(m => m)
     .OptionLabel(Resources.Select)
                                .DataTextField("Name")
                                        .DataValueField("ZoneId")
                                         .Filter("contains")
                                          .CascadeFrom("RegionId")
          .DataSource(dataSource =>
          {
              dataSource.Read(read => read.Action("GetZones", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery").Data("filterZones"))
                  .ServerFiltering(true);
          })
                        .ValuePrimitive(true)
)
