<script>
    function GetSalary() {
        //if (isNew_Global == "True") {
            var rank = $("#RankId").data("kendoDropDownList").value();
            var step = $("#StepId").data("kendoDropDownList").value();
            //var Jobs = $("#LookupId").data("kendoDropDownList");
            //var job = Jobs.value();

            if (rank != 0 && step != 0) {

                $("#Salary").val(0);

                $.ajax({
                    url: '@Url.Action("GetSalaryAmount", "VacancySelfcare", new { area="HRM"})',
                    data: { rank: rank, step: step },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        $("#Salary").val(result);
                        $("#Salary").trigger("change");
                    }
                });
            }
        //}
    }

</script>
<Script>
    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsActive == false) {

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-close").hide();
                row.find(".k-grid-open").show();
                row.css("background-color", "gray");
            }
            else {
                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").show();
                row.find(".k-grid-close").show();
                row.find(".k-grid-open").hide();
                row.css("background-color", "");
            }
            //if (dataItem.Status === 0) {

            //    row.css("background-color", "red");

            //} else {
            //    row.css("background-color", "green");
            //}

        }

    }
    function AssignDate() {
        var list = AssignDates();
        return list;
    }
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#FromVacAm").trigger("change");
        $("#ToVacAm").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "VacancySelfcare")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
</Script>
<script>
    function Branch() {


        var value = this.value(),
            grid = $("#VaccancyPlangrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "BranchId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>
