@helper vacancyLanguages()
{
    @(Html.Kendo().Grid<VacancyLanguage>()
          .Name("VacancyLanguage_grid_#=VacancyId#")
          .Columns(columns =>
            {

                columns.Bound(c => c.LanguageName)
                       .EditorTemplateName("LanguageAutoComplate")
                       .Width(150);
                columns.Bound(c => c.ProficiencyLevel).Width(150);
                columns.Bound(c => c.IsRequired).ClientTemplate("<input type='checkbox' disabled = 'true' value='\\#= IsRequired\\#' " +
                                                                "\\# if (IsRequired) { \\#" +
                                                                "checked='checked'" +
                                                                "\\# } \\#" +
                                                                "/>"
                                                                ).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(130);

                columns.Bound(c => c.Description);

                columns.Command(command =>
                {

                    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                    command.Destroy().Text(Resources.ActionButton_Cancel);

                })/*.Width(250)*/;

            })
            .ToolBar(toolbar =>
            {
                if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
                {
                    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                }



            })
            .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(500))
            .Filterable()
            .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Events(events =>
                    {
                        events.Error("error_handler(\"VacancyLanguage_grid_#=VacancyId#\")");
                        events.RequestStart("onRequestStart(\"VacancyLanguage_grid_#=VacancyId#\")");
                        events.RequestEnd("onRequestEnd(\"VacancyLanguage_grid_#=VacancyId#\")");
                    })
                    .Model(model =>
                    model.Id(p => p.VacancyLanguageId))
                    .Read(read => read.Action("VacancyLanguages_Read", "VacancyLanguages", new { Area = "HRM", id = "#=JobTitle#" }).Data("sendForgery"))
                    .Create(create => create.Action("VacancyLanguages_Create", "VacancyLanguages", new { Area = "HRM", id = "#=JobTitle#" }).Data("sendForgery"))
                    .Update(update => update.Action("VacancyLanguages_Update", "VacancyLanguages").Data("sendForgery"))
                    .Destroy(destroy => destroy.Action("VacancyLanguages_Destroy", "VacancyLanguages").Data("sendForgery"))
                ).ToClientTemplate())


}

