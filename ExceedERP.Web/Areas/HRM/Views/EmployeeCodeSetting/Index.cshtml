@using System.Collections
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Employee Code Setting</legend>
@(Html.Kendo().Grid<EmployeeCodeSetting>()
              .Name("EmployeeCodeSettinggrid")
          .Columns(columns =>
          {
              columns.Bound(c => c.Type).Width(100);
              columns.Bound(c => c.Index).Width(100);
              columns.Bound(c => c.Remark).Width(100);
              columns.Command(command => {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate)
                  .Text(Resources.ActionButton_Edit);
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }).Width(100);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(500))
                   
                             .Groupable()
                                      .Sortable(sortable =>
                                      {
                                          sortable.SortMode(GridSortMode.SingleColumn);
                                      })
                          .Filterable()
                             .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
                     .Events(events =>
                     {
                         events.Error("error_handler(\"EmployeeCodeSettinggrid\")");
                         events.RequestStart("onRequestStart(\"EmployeeCodeSettinggrid\")");
                         events.RequestEnd("onRequestEnd(\"EmployeeCodeSettinggrid\")");
                     }
                  )

                  .Model(model =>
                  {
                      model.Id(p => p.EmployeeCodeSettingId);
                      //model.Field(p => p.Remark).Editable(false);
                  })
              .Read(read => read.Action("EmployeeCodeSetting_Read", "EmployeeCodeSetting"))
              .Create(create => create.Action("EmployeeCodeSetting_Create", "EmployeeCodeSetting"))
              .Update(update => update.Action("EmployeeCodeSetting_Update", "EmployeeCodeSetting"))
              .Destroy(destroy => destroy.Action("EmployeeCodeSetting_Destroy", "EmployeeCodeSetting"))
          )
)
<script>
   
    function sync_handler(e) {
        this.read();

    }
    function AssignDate() {
        var list = AssignDates();
        return list;
    }
   
</script>