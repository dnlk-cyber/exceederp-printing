@using System.Collections
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.Navigator_Recruitment_InternalSetting</Legend>
@(Html.Kendo().Grid<Configuration>()
          .Name("RecruitmentSettinggrid")
      .Columns(columns =>
      {
        //columns.Bound(c => c.Reference);
          columns.ForeignKey(c => c.Attribute, (IEnumerable)ViewData["RecruitmentSetting"],"Text","Text").EditorTemplateName("Setting");
          columns.Bound(c => c.CurrentValue);
       // columns.Bound(c => c.PreviousValue);
        columns.Bound(c => c.Remark);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(300);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Scrollable(h => h.Height(500))
             .Groupable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                .Events(events =>
                             {
                                 events.Error("error_handler(\"RecruitmentSettinggrid\")");
                                 events.RequestStart("onRequestStart(\"RecruitmentSettinggrid\")");
                                 events.RequestEnd("onRequestEnd(\"RecruitmentSettinggrid\")");
                             })
                     
          .Model(model => model.Id(p => p.ConfigurationId))
              .Read(read => read.Action("Configurations_Read", "RecruitmentSetting"))
              .Create(create => create.Action("Configurations_Create", "RecruitmentSetting"))
              .Update(update => update.Action("Configurations_Update", "RecruitmentSetting"))
              .Destroy(destroy => destroy.Action("Configurations_Destroy", "RecruitmentSetting"))
      )
)
