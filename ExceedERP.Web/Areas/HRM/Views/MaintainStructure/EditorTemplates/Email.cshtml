@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.Common.HRM.CompanyEmail 
<form>
  
   
   
    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.EmailAddress, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.TextBoxFor(model => model.EmailAddress, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 140px", onchange = "Change(this)" })                                 
                @Html.ValidationMessageFor(model => model.EmailAddress, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">
                <input class="text-box single-line password" data-val="true" data-val-required="Password required" id="Password" name="Password" type="password" value="" />
              @*  @Html.Kendo().TextBoxFor(model => model.Password)*@ 
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                
                
            </div>
        </div>
      

    </div>
 

</form>
