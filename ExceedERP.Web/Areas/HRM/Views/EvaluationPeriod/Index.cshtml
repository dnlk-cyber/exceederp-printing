@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPerformance_EvaluationPeriod</legend>

    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Common.Period>()
          .Name("Periodgrid")
          .Columns(columns =>
          {
             // columns.Bound(c => c.PeriodType).EditorTemplateName("PeriodType").Width(150);
              columns.Bound(c => c.PeriodName).Width(100);
              columns.ForeignKey(c => c.ParentId, (System.Collections.IEnumerable)ViewData["PeriodList"], "PeriodId", "PeriodName").EditorTemplateName("Period").Width(150);
              columns.Bound(c => c.AmharicStartDate).Width(200).EditorTemplateName("Calander");
              columns.Bound(c => c.AmharicEndDate).Width(200).EditorTemplateName("Calander");
            //  columns.Bound(c => c.Index);
             // columns.Bound(c => c.Remark);
              columns.Command(command =>
              {
                  command.Edit().Text(Resources.ActionButton_Update);
                 command.Destroy().Text(Resources.ActionButton_Cancel);
              }).Width(180);

          })
                   .Events(events =>
                   {
                       events.Save("GetDate");
                       events.Edit("GetDate");
                   })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
          .DataSource(dataSource => dataSource
              .Ajax()
                        .Events(events => events.Error("error_handler")
                                          .Sync("sync_handler")
                                          .Change( "Compare"))
              .Model(model =>
              {
                  model.Id(p => p.PeriodId);
                 
              })
                              .Read(read => read.Action("Periods_Read", "EvaluationPeriod"))
                              .Create(create => create.Action("Periods_Create", "EvaluationPeriod"))
                              .Update(update => update.Action("Periods_Update", "EvaluationPeriod"))
                              .Destroy(destroy => destroy.Action("Periods_Destroy", "EvaluationPeriod"))
              
          )
          )
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
</script>

<script>
    function Compare() {

        var startDate = $("#StartDate");//.kendoDatePicker({
        //    change: checkDates
        //});
        var endDate = $("#EndDate");//.kendoDatePicker({
        //    change: checkDates
        //});
        
            if (startDate.val() != '' && endDate.val() != '') {
                if (Date.parse(startDate.val()) > Date.parse(endDate.val())) {
                    alert('End date should be before start date');
                    endDate.val(startDate.val());
                }
                if (Date.parse(startDate.val()) == Date.parse(endDate.val())) {
                    alert('End date should be different from start date');
                    endDate.val(startDate.val());
                }
            }
       
        
        $("#StartDate").kendoValidator({
            rules: {
                date: function (input) {
                    var d = kendo.parseDate(input.val());
                    return d instanceof Date;
                }
            }
        });

        $("#EndDate").kendoValidator({
            rules: {
                date: function (input) {
                    var d = kendo.parseDate(input.val());
                    return d instanceof Date;
                }
            }
        });
    };
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#AmharicStartDate").trigger("change");
        $("#AmharicEndDate").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "EvaluationPeriod")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
</script>
