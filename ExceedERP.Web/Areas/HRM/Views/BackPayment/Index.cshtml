@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>@Resources.NavigatorPayrollProcess_BackPayment</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.Payroll.BackPayment>()
          .Name("BackPaymentgrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(180);
          columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["PeriodList"], "GLPeriodId", "Name").EditorTemplateName("GLFPeriod").Width(105);
          columns.Bound(c => c.BasicSalary).Width( 120);
          columns.Bound(c => c.Allowances).Width(120);
          columns.Bound(c => c.IncomeTax).Width( 120);
          columns.Bound(c => c.Pension).Width( 120);
          columns.Bound(c => c.Net).Width( 120);
          columns.Bound(c => c.IsClosed).ClientTemplate("<input type='checkbox' disabled='true' value='#=IsClosed #' " + " # if (IsClosed) { #" + "checked='checked'" + "# } #" + " />").Width(100);
        //  columns.Bound(c => c.Remark);
          //columns.Command(command =>
          //{
          //    // command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
          //     command.Destroy().Text(Resources.ActionButton_Cancel);//
          //}).Width(180);
      })
     .ToolBar(toolbar =>
        {
            toolbar.Template(@<text>
                <div class="toolbar">
                    @(Html.Kendo().ComboBox()
                                                                     .Placeholder(Resources.HR_LeaveManagment_LeaveTransfer_From)
                                             .Name("From")

                                                            .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetPeriod", "BackPayment", new { area = "HRM" }))
                                                    .ServerFiltering(false);
                          })

                                                          .DataTextField("Name")
                                                                                  .DataValueField("GLPeriodId")
                                                   .AutoBind(false)
                                    .Events(e => e.Change("Enable"))
                            .HtmlAttributes(new { style = "width: 300px;" })

                          )
                    @(Html.Kendo().ComboBox()
                                                                            .Placeholder(Resources.HR_LeaveManagment_LeaveTransfer_To)
                                             .Name("To")

                                                            .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetPeriod", "BackPayment", new { area = "HRM" }))
                                                    .ServerFiltering(false);
                          })

                                                          .DataTextField("Name")
                                                                                  .DataValueField("GLPeriodId")
                                                   .AutoBind(false)
                                    .Events(e => e.Change("Enable"))
                            .HtmlAttributes(new { style = "width: 300px;" })

                    )
                   
                    @(Html.Kendo().Button()
                      .Name("btnSave")
                      .HtmlAttributes(new { type = "button", @class = "k-primary" })
                              .Events(e => e.Click("Transfer"))
      .Content(Resources.Payroll_Process_Process))
                    @(Html.Kendo().Button()
                      .Name("btnReverse")
                      .HtmlAttributes(new { type = "button", @class = "k-primary" })
                              .Events(e => e.Click("Reverse"))
                          .Content(Resources.Payroll_Process_Reverse))
                    @(Html.Kendo().Button()
                      .Name("btnClose")
                      .HtmlAttributes(new { type = "button", @class = "k-primary" })
                              .Events(e => e.Click("Close"))
          .Content(Resources.Payroll_Process_Close))
                    <br />
                    <br />
                </div>
                
            </text>);
        })
         .Editable(editable => editable.Mode(GridEditMode.InLine))
                  .Scrollable(h => h.Height(500))
                     .Groupable()
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                  .Filterable()
                     .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
              .DataSource(dataSource => dataSource
                  .Ajax()
                                          .Events(events =>
                                                            {
                                                                events.Error("error_handler(\"BackPayment\")");
                                                                events.RequestStart("onRequestStart(\"BackPayment\")");
                                                                events.RequestEnd("onRequestEnd(\"BackPayment\")");
                                                            })
                                               
          .Model(model => model.Id(p => p.BackPaymentId))
          .Read(read => read.Action("BackPayments_Read", "BackPayment"))
          .Create(create => create.Action("BackPayments_Create", "BackPayment"))
          .Update(update => update.Action("BackPayments_Update", "BackPayment"))
          .Destroy(destroy => destroy.Action("BackPayments_Destroy", "BackPayment"))
      )
)
<script>
    function Transfer() {
        var from = $("#From").data("kendoComboBox");
        var type = $("#To").data("kendoComboBox");
        try {
            $("#btnSave").removeClass("k-state-disabled");
            var period = from.value();
            var bType = type.value();
            if (period === "" || bType === "") {
                alert("Please select Periods!!");

            } else {
                if (!$("#btnSave").hasClass("k-state-disabled")) {
                    $("#btnSave").addClass("k-state-disabled");

                    //  progress();
                }
                //$("#run").on("click", function (eve) {
                $.ajax({
                    url: '@Url.Action("PrepareBackPayment", "BackPayment")',
                    //contentType: "application/json; charset=utf-8",
                    data: { period1: period, period2: bType },
                    type: 'POST',
                    cache: false,
                    success: function(result) {
                        r = result;
                        $("#BackPaymentgrid").data("kendoGrid").dataSource.read();
                        $("#BackPaymentgrid").data("kendoGrid").refresh();
                        $("#btnSave").removeClass("k-state-disabled");

                    }


                });
            }


        } catch (e) {
            alert("Please select Period!!");
            $("#btnSave").removeClass("k-state-disabled");
        }
        //});
    }

    function Reverse() {
        var from = $("#From").data("kendoComboBox");
        var type = $("#To").data("kendoComboBox");
        try {
            $("#btnReverse").removeClass("k-state-disabled");
            var period = from.value();
             var bType = type.value();
            if (period === "" || bType === "") {
                alert("Please select Periods!!");

            } else {
                if (!$("#btnReverse").hasClass("k-state-disabled")) {
                    $("#btnReverse").addClass("k-state-disabled");

                    //  progress();
                }
                //$("#run").on("click", function (eve) {
                $.ajax({
                    url: '@Url.Action("Reverse", "BackPayment")',
                    //contentType: "application/json; charset=utf-8",
                    data: { period1: period, period2: bType },
                    type: 'POST',
                    cache: false,
                    success: function(result) {
                        r = result;
                        $("#BackPaymentgrid").data("kendoGrid").dataSource.read();
                        $("#BackPaymentgrid").data("kendoGrid").refresh();
                        $("#btnReverse").removeClass("k-state-disabled");

                    }


                });
            }


        } catch (e) {
            alert("Please select Period!!");
            $("#btnReverse").removeClass("k-state-disabled");
        }
        //});
    }

    function Close() {
        var from = $("#From").data("kendoComboBox");
        var type = $("#To").data("kendoComboBox");
        try {
            $("#btnClose").removeClass("k-state-disabled");
            var period = from.value();
             var bType = type.value();
            if (period === "" || bType === "") {
                alert("Please select Periods!!");

            } else {
                if (!$("#btnSave").hasClass("k-state-disabled")) {
                    $("#btnSave").addClass("k-state-disabled");

                    //  progress();
                }
                //$("#run").on("click", function (eve) {
                $.ajax({
                    url: '@Url.Action("Close", "BackPayment")',
                    //contentType: "application/json; charset=utf-8",
                    data: { period: period, bType: bType },
                    type: 'POST',
                    cache: false,
                    success: function(result) {
                        r = result;
                        $("#BackPaymentgrid").data("kendoGrid").dataSource.read();
                        $("#BackPaymentgrid").data("kendoGrid").refresh();
                        $("#btnClose").removeClass("k-state-disabled");

                    }


                });
            }


        } catch (e) {
            alert("Please select Period!!");
            $("#btnClose").removeClass("k-state-disabled");
        }
        //});
    }


</script>
<script>
    function Enable(e) {

        var save = $("#btnSave").data("kendoButton");
        var reverse = $("#btnReverse").data("kendoButton");
        var close = $("#btnClose").data("kendoButton");


        save.enable(false);
        reverse.enable(false);
        close.enable(false);



        var periods = $("#From").data("kendoComboBox");



        var id = periods.value();


        $.ajax({
            url: '@Url.Action("CheckStatus", "BackPayment")',
            contentType: "application/json; charset=utf-8",
            data: { 'id': id},
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "c") {
                    save.enable(false);

                    reverse.enable(false);
                    close.enable(false);




                }
                else if (r == "r") {
                    save.enable(true);
                    reverse.enable(false);
                    close.enable(false);




                }
                else if (r == "n") {
                    save.enable(false);
                    reverse.enable(true);
                    close.enable(true);

                }
                else {
                    save.enable(false);
                    reverse.enable(true);

                    close.enable(true);


                }
            }

        });

    }
</script>