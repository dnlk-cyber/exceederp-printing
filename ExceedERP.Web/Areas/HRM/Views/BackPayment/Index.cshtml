<script>
    function Process() {
        var businessUnitid = 0;
        var periods = $("#GLPeriodId").data("kendoComboBox");
        var toPeriods = $("#ToGLPeriodId").data("kendoComboBox");
        var processPeriods = $("#ProcessGLPeriodId").data("kendoComboBox");
        var branchs = $("#BranchId").data("kendoComboBox");
        var businessUnit = $("#BusinessUnitId").data("kendoComboBox");
        try {
            $("#btnSave").removeClass("k-state-disabled");
            var period = periods.value();
            var toPeriod = toPeriods.value();
            var processPeriod = processPeriods.value();
            var branchid = branchs.value();

            if (businessUnit)
                businessUnitid = businessUnit.value();

            if (!period || !toPeriod || !branchid) {
                alert("Please select all parameters!!");

            } else {
                if (!$("#btnSave").hasClass("k-state-disabled")) {
                    $("#btnSave").addClass("k-state-disabled");

                    //  progress();
                }
                //$("#run").on("click", function (eve) {
                $.ajax({
                    url: '@Url.Action("ProcessBackPay", "BackPayment")',
                    //contentType: "application/json; charset=utf-8",
                    data: { period: period, toperiod: toPeriod, processperiod: processPeriod, branchid: branchid, businessUnitid: businessUnitid },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        alert(result.Message);
                      //  r = result;
                        $("#BackPaymentgrid").data("kendoGrid").dataSource.read();
                        $("#BackPaymentgrid").data("kendoGrid").refresh();
                        $("#btnSave").removeClass("k-state-disabled");

                    },
                    beforeSend: function () {
                        // Show image container
                        $("#loading-image").show();
                    },
                    complete: function (data) {
                        // Hide image container
                        $("#loading-image").hide();
                    },
                    error: function (result) {
                        alert(result);
                    }


                });
            }


        } catch (e) {
            alert("Please select all parameters!");
            $("#btnSave").removeClass("k-state-disabled");
        }
        //});
    }
    function Close(e) {
        try {
            if (confirm('Are you sure you want to colse this backpay?')) {
                var grid = $("#BackPaymentgrid").data("kendoGrid");
                var dataItem = grid.dataItem(grid.select());
                var id = dataItem.BackPayId;

               // alert(id);

                var save = $("#btnClose").data("kendoButton");
                if ($('#btnClose').length > 0) {
                    save.enable(false);
                }

                $.ajax({
                    url: '@Url.Action("Close", "BackPayment")',
                   // contentType: "application/json; charset=utf-8",
                    data: { id: id},
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                       // r = result;
                        alert(result.Message);

                        $("#BackPaymentgrid").data("kendoGrid").dataSource.read();
                        $("#BackPaymentgrid").data("kendoGrid").refresh();
                        if ($('#btnClose').length > 0) {
                            save.enable(true);
                        }
                        passProgress.value(100);
                    },
                    beforeSend: function () {
                        // Show image container
                        $("#loading-image").show();
                    },
                    complete: function (data) {
                        // Hide image container
                        $("#loading-image").hide();
                    },
                    error: function (result) {
                        alert(result);
                    }

                });
            } else {
                // Do nothing!
            }

        } catch (e) {
            alert("Please select the row!!");
        }

    }


    function OnDataBoundBackPay(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#BackPaymentgrid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsClosed) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }


        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (!dataItem.IsClosed) {
                row.css("background-color", "lightgreen");
            }


        }

    }
</script>
<script>
    function Enable(e) {

        var save = $("#btnSave").data("kendoButton");
        //var reverse = $("#btnReverse").data("kendoButton");
        var close = $("#btnClose").data("kendoButton");


        save.enable(false);
       // reverse.enable(false);
        close.enable(false);



        var periods = $("#GLPeriodId").data("kendoComboBox");
        var toPeriods = $("#ToGLPeriodId").data("kendoComboBox");
        var branches = $("#BranchId").data("kendoComboBox");
        var businessUnits = $("#BusinessUnitId").data("kendoComboBox");

        var from = periods.value();
        var to = toPeriods.value();
        var branchid = branches.value();

        var businessUnitid = 0;
        if (businessUnits)
            businessUnitid = businessUnits.value();


        $.ajax({
            url: '@Url.Action("CheckStatus", "BackPayment")',
            contentType: "application/json; charset=utf-8",
            data: { 'fromPeriod': from, 'toPeriod': to, 'branchid': branchid, 'businessUnitid': businessUnitid },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "c") {
                    save.enable(false);
                   // reverse.enable(false);
                    close.enable(false);
                }
                else if (r == "r") {
                    save.enable(true);
                    //reverse.enable(false);
                    close.enable(false);

                }
                else if (r == "n") {
                    save.enable(false);
                   // reverse.enable(true);
                    close.enable(true);
                }
                else {
                    save.enable(false);
                    //reverse.enable(true);
                    close.enable(true);
                }
            }

        });

    }
</script>