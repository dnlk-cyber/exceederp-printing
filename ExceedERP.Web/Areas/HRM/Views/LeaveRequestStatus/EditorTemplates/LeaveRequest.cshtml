@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Helpers.Common
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.SelfCare.LeaveRequest

@{
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? true;
}
<form>

<div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.EmployeeId, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>

                @(Html.Kendo().DropDownListFor(model => model.EmployeeId)
                        //  .Name("EmployeeId")
                                              .DataValueField("PersonId")
                        .DataTextField("FullName")
                           .OptionLabel("Select Employee..")
                            .Filter("contains")
                            .MinLength(2)
                                     .CascadeFrom("IsForOther")
                            .HtmlAttributes(new { style = "width:200px" })
                            .Virtual(v => v.ValueMapper("valueMapper").ItemHeight(26))
                        .DataSource(source =>
                        {
                            source.Custom()
                                  .ServerFiltering(true)
                                  .ServerPaging(true)
                                  .Type("aspnetmvc-ajax")
                                  .Transport(transport => transport.Read(r => r.Action("GetEmployees", "HRMDataProvider").Data("sendForgery")))
                                  .Schema(schema =>
                                  {
                                      schema.Data("Data")
                                            .Total("Total");
                                  });
                        })

                                           .ValuePrimitive(true)


                                                                  .Height(400)
                                                                          .HeaderTemplate("<div class=\"dropdown-header k-widget k-header\">" +
                                                        "<span>Photo</span>" +
                                                        "<span>Full Name</span>" +
                                                    "</div>")
                                                            .Template(@"<div class='Employee-photo' style='background-image: url(" + Url.Content("~/Content/Images/") + "#:data.PersonId#-Photo/" + "#:data.PersonId#.jpg" + ");'></div>" +
                                                            "<div class='Employee-name'>#:FullName#</div>")
                )


            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.Type, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">
            @(Html.Kendo().DropDownListFor(m => m.Type )
                  .DataTextField("Text")
                  .DataValueField("Value")
                           .ValuePrimitive(true)
                  .BindTo(EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.Common.LeaveType)))
            )
            @Html.ValidationMessageFor(model => model.Type, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.From, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">
            @Html.Kendo().DatePickerFor(model => model.From)
            @Html.ValidationMessageFor(model => model.From, "", new { @class = "text-danger" })
        </div>
    </div>
  

</div>

<br/>


<div class="row">
    <div class="col-md-1">

    </div>

    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.To, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>

                @Html.Kendo().DatePickerFor(model => model.To)
                @Html.ValidationMessageFor(model => model.To , "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.LeaveBalance, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">

            @Html.Kendo().TextBoxFor(model => model.LeaveBalance)
            @Html.ValidationMessageFor(model => model.LeaveBalance, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.Reason, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">

            @Html.Kendo().TextBoxFor(model => model.Reason)
            @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
        </div>
    </div>
  


</div>
<br/>

    <div class="row">
        <div class="col-md-1">

        </div>
       
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.LeaveDays, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.LeaveDays)
                @Html.ValidationMessageFor(model => model.LeaveDays, "", new { @class = "text-danger" })
            </div>
        </div>
    

        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div class="form-group">

                @Html.TextAreaFor(model => model.Remark)
                @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
            </div>
        </div>



    </div>

</form>
<style >
    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>