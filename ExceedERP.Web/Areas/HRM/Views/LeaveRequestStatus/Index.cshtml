@helper PMValidation()
{
    @(Html.Kendo().Grid<LeaveRequestPMValidation>()
                   .Name("LeaveRequestPMValidationGrid_#=LeaveRequestId#")
                   .Columns(columns =>
                   {

                       columns.Bound(c => c.Status).Width(150);
                       columns.Bound(c => c.DateCreated).Title("Date").Width(150);
                       columns.Bound(c => c.CreatedBy).Title("User").Width(150);
                       columns.Bound(c => c.Remark).Width(150);
                       columns.Command(command =>
                       {
                           command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                           command.Destroy().Text(Resources.ActionButton_Cancel);
                       });

                   })
                   .ToolBar(toolbar =>
                   {
                       toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                   })
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Scrollable(h => h.Height(500))
                .Sortable(sortable =>
                {
                    sortable.SortMode(GridSortMode.SingleColumn);
                })
                .Filterable()
                .Events(x => x.DataBound("onDataBoundValidationPM"))
                .Pageable(pageable => pageable
                    .Input(true)
                    .Numeric(false)
                    .Refresh(true)
                    .PageSizes(true)
                    .ButtonCount(5))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Events(events =>
                    {
                        events.Error("error_handler(\"LeaveRequestPMValidationGrid_#=LeaveRequestId#\")");
                        events.RequestStart("onRequestStart(\"LeaveRequestPMValidationGrid_#=LeaveRequestId#\")");
                        events.RequestEnd("onRequestEnd(\"LeaveRequestPMValidationGrid_#=LeaveRequestId#\")");
                    })
                   .Model(model =>
                   {
                       model.Id(p => p.LeaveRequestPMValidationId);
                       model.Field(p => p.CreatedBy).Editable(false);
                       model.Field(p => p.DateCreated).Editable(false);

                   })
                    .Read(read => read.Action("LeaveRequestPMValidations_Read", "LeaveRequestPMValidations", new { Area = "HRM", reqId = "#=LeaveRequestId#" }).Data("sendForgery"))
                    .Create(create => create.Action("LeaveRequestPMValidations_Create", "LeaveRequestPMValidations", new { Area = "HRM", reqId = "#=LeaveRequestId#" }).Data("sendForgery"))
                    .Update(update => update.Action("LeaveRequestPMValidations_Update", "LeaveRequestPMValidations").Data("sendForgery"))
                    .Destroy(destroy => destroy.Action("LeaveRequestPMValidations_Destroy", "LeaveRequestPMValidations").Data("sendForgery"))

                    ).ToClientTemplate()

    )
}
