                                .Update(update => update.Action("RequestesStatus_Update", "RequestesStatus"))
                                .Destroy(destroy => destroy.Action("RequestesStatus_Destroy", "RequestesStatus"))

                                ).ToClientTemplate()
                            )

                            <a href='@Url.Action("LeaveRequestLetter", "PrintableLetter")/?id=#=LeaveRequestId#' target="_blank" title="Print"><i class="fa fa-print fa-2x"></i></a>
                        </text> );
                  //*****************************************************************************************************//
                      items.Add().Text(Resources.Navigator_Company_UploadDocument).Content(
                      @<text>
                        <button onclick='uploadFile(#=LeaveRequestId#)' class='fa fa-upload btn btn-primary'>&nbsp;@Resources.HR_ActionButton_Upload </button>
                      @(Html.Kendo().Grid<ExceedERP.Core.Domain.Common.HRM.Attachment>()
                         .Name("Documents_Leave_Requests#=LeaveRequestId#")
                         .Columns(columns =>
                         {
                             columns.Bound(c => c.FileName);
                             columns.Bound(c => c.Description);
                             columns.Bound(m => m.FileType).ClientTemplate(Html.ActionLink(Resources.Common_Attachment_FileType, "DownloadDoument", "LeaveRequestStatus", new { filename = "#=LeaveRequestId#", attachId = "\\#=AttachmentId\\#" }, null).ToString());

                             columns.Command(command =>
                             {
                                 //if (HttpContext.Current.User.IsInRole("HR_Profile_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
                                 //{
                                 //  command.Destroy().Text(Resources.ActionButton_Cancel);//
                                 //}

                             }).Width(300);

                         })
                         .Events(e =>
                         {
                             e.DataBound("onRequestesStatusDataBound");

                         })
                         .ToolBar(toolbar =>
                         {
                             toolbar.Create().Text(Resources.ActionButton_AddNewRecord);


                         })
                         .Editable(editable => editable.Mode(GridEditMode.InCell).TemplateName("UploadDocument").Window(window =>
                         {

