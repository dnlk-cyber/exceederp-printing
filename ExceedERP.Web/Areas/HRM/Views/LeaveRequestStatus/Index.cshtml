<script>
    function uploadFile(id) {
        $("#leaveRequestId").val(id);
        var wnd = $("#UploadDoc").data("kendoWindow");
        wnd.center().open();
    }

    function sync_handler(e) {
        this.read();

    }
    var masterId = 0;
    var isPMApproved = false;

    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#LeaveRequestgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.LeaveRequestId;
        isPMApproved = masterDataItem.IsProjectManagerApproved;

        var gridName = "#RequestesStatusgrid" + masterId;
        var attachmentGridName = "#LeaveRequestAttachementGrid" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatus", "LeaveRequestStatus")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-add", gridName).hide();
                }
                else if (r == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();

                    $(attachmentGridName).find(".k-grid-toolbar").hide();
                    $(".k-grid-delete", attachmentGridName).hide();
                }
                else if (r == "Dapproved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).show();
                    $(".k-grid-edit", gridName).show();
                    $(".k-grid-delete", gridName).show();
                }
                else
                {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-add", gridName).show();

                    $(attachmentGridName).find(".k-grid-toolbar").show();
                    $(".k-grid-delete", attachmentGridName).show();
                }

            }

        });

    }

    function onDataBoundValidationPM(e) {
        var detailGrid = "#" + e.sender.element[0].id;
        if (isPMApproved == true) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-upload-button", detailGrid).hide();
            $(".k-dropzone", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();

        }
        this.table.find(".k-grid-edit").hide();
        this.table.find(".k-grid-delete").hide();

    }
    function onUploadSuccess(e) {
        // Force the rebinding of the Grid on successful upload
        $("#LeaveRequestAttachementGrid" + masterId).data("kendoGrid").dataSource.read();
    }
</script>

<script>

    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var model = grid.dataItem(this);
            if (!model) return;

            var $row = $(this);
            $row.removeClass("row-approved row-dept-approved row-waiting row-pending row-rejected");

            if (model.IsOnlineApproved) {
                $row.addClass("row-approved");
            }
            else if (model.Status === "DEPARTMENT_APPROVAL" || model.IsApproved) {
                $row.addClass("row-dept-approved");
            }
            else if (model.IsPending) {
                $row.addClass("row-pending");
            }
            else if (model.IsRejected) {
                $row.addClass("row-rejected");
            }
            else if (model.IsWaiting) {
                $row.addClass("row-waiting");
            }
        });
    }

    function RefreshBranchAndBussinessUnit(e) {
        if (confirm("are you sure to refresh ")) {
            $.ajax({
                url: "/HRM/LeaveRequestStatus/RefreshBussinessUnitAndBranch/",
                success: function (data) {
                    options.success(data);
                }
            });
        }
        else {
            alert("not updated");
        }
    }
    function onRequestesStatusDataBound() {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (model.Status == 0
                || model.Status == 1
                || model.Status == 2
                || model.Status == 3
                || model.Status == 4
                || IsApproved)
            {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }

        });

    }
</script>
<script>
    function updateEmployeeLeaveRequest(element) {
        var $button = $(element);
        var $icon = $button.find('i');
        var originalIcon = $icon.attr('class');

        // Show loading spinner
        $icon.attr('class', 'fa fa-spinner fa-spin');
        $button.prop('disabled', true);
        $('#loading-image').show();
        $.ajax({
            url: '@Url.Action("UpdateLeaveRequestinfo", "LeaveRequestStatus")',
            type: 'POST',
            dataType: 'json',
            success: function (response) {
                alert(response.message);
                $('#loading-image').hide();
                $button.prop('disabled', false);
            },
            error: function (xhr, status, error) {
                alert('An error occurred while updating leave request info. Please try again.');
                $('#loading-image').hide();
                $button.prop('disabled', false);
            },
            complete: function () {
                // Restore original button state
                $icon.attr('class', originalIcon);
                $button.prop('disabled', false);
            }
        });
    }
</script>
