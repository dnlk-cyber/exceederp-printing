@using System.Collections
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorLeave_LeaveRequests</legend>
@(Html.Kendo().Grid<LeaveRequest>()
          .Name("LeaveRequestgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.IsApproved).Visible(false);
          columns.Bound(c => c.LeaveRequestId).Width(100).Title("Request Id");
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.Type).EditorTemplateName("LeaveType").Width(100);
          columns.Bound(c => c.Day).Width(80);
          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Width(80);
          columns.Bound(c => c.FromAmharic).Width (100);
          columns.Bound(c => c.ToAmharic).Width (100);
          columns.Bound(c => c.LeaveBalance).Width(120);
          columns.Bound(c => c.LeaveDays).Width (100);
          columns.Bound(c => c.Reason).Width (150);
          //columns.Bound(c => c.Remark);
          columns.Command(command =>
          {
              //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              //command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(180);
      })
      .ToolBar(toolbar => {
          // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                  .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("LeaveRequest").Window(window => { window.Title(Resources.NavigatorLeave_LeaveRequests); window.Scrollable(false); }))
        .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                       .Events(events => events.DetailExpand("onDetailExpandUser"))
                       .Events(e =>
                       {
                           e.DataBound("onDataBound");
                       })
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Sort(sort => sort.Add("LeaveRequestId").Descending())
                 .Events(events =>
                 {
                     events.Error("error_handler(\"LeaveRequestgrid\")");
                     events.RequestStart("onRequestStart(\"LeaveRequestgrid\")");
                     events.RequestEnd("onRequestEnd(\"LeaveRequestgrid\")");
                 })

          .Model(model => model.Id(p => p.LeaveRequestId))
              .Read(read => read.Action("LeaveRequest_Read", "LeaveRequestStatus"))
              .Create(create => create.Action("LeaveRequest_Create", "LeaveRequestStatus"))
              .Update(update => update.Action("LeaveRequest_Update", "LeaveRequestStatus"))
              .Destroy(destroy => destroy.Action("LeaveRequest_Destroy", "LeaveRequestStatus"))
          ).ClientDetailTemplateId("template")
      )

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                  .Name("tabstrip_#=LeaveRequestId#")
                  .SelectedIndex(0)
                  .Items(items =>
                  {
                      items.Add().Text(Resources.HR_RequestStatus).Content(
                        @<text>
                            @*<legend>Status</legend>*@

                            @(Html.Kendo().Grid<RequestesStatus>()
                                                  .Name("RequestesStatusgrid#=LeaveRequestId#")
                                          .Columns(columns =>
                                          {
                                              //columns.Bound(c => c.RequestId);

                                              columns.Bound(c => c.DateReqStatAm).Width(150);
                                              columns.Bound(c => c.Status).EditorTemplateName("EnumWithoutDepApprove").Width(200);
                                              columns.ForeignKey(c => c.ApproverId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                                              columns.ForeignKey(c => c.ApproverDepartment, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                                              columns.Bound(c => c.Remark).Width(200);

                                              columns.Command(command =>
                                              {
                                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                                              });
                                          })
                                          .ToolBar(toolbar =>
                                          {
                                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                          })
                                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                                          .Scrollable()
                                          .DataSource(dataSource => dataSource
                                              .Ajax()

                                                       .Events(events =>
                                                       {
                                                           events.Error("error_handler(\"RequestesStatusgrid#=LeaveRequestId#\")");
                                                           events.RequestStart("onRequestStart(\"RequestesStatusgrid_#=LeaveRequestId#\")");
                                                           events.RequestEnd("onRequestEnd(\"RequestesStatusgrid#=LeaveRequestId#\")");
                                                       })

                                                     .Model(model =>
                                                     {
                                                         model.Id(p => p.RequestStatusId);
                                                         model.Field(p => p.Date).Editable(false).DefaultValue(DateTime.Today);
                                                         model.Field(p => p.ApproverId).Editable(false);
                                                         model.Field(p => p.ApproverDepartment).Editable(false);
                                                     })

                                                                    .Read(read => read.Action("RequestesStatus_Read", "RequestesStatus", new { id = "#=LeaveRequestId#", referenceType = "Leave" }))
                                                                   .Create(create => create.Action("RequestesStatus_Create", "RequestesStatus", new { id = "#=LeaveRequestId#", referenceType2 = "Leave" }))
                                                                  .Update(update => update.Action("RequestesStatus_Update", "RequestesStatus"))
                                                                  .Destroy(destroy => destroy.Action("RequestesStatus_Destroy", "RequestesStatus"))
                                          ).ToClientTemplate()
                            )

                            <a href='@Url.Action("LeaveRequestLetter", "PrintableLetter")/?id=#=LeaveRequestId#' target="_blank" title="Print"><i class="fa fa-print fa-2x"></i></a>
                        </text>
                                  );
                  //*****************************************************************************************************//

              }).ToClientTemplate())
</script>
