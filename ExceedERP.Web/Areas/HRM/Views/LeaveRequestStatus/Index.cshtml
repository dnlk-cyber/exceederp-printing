@using System.Collections
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorLeave_LeaveRequests</legend>
<div class="row">
    <p>

        <span class="fa fa-circle" style="color:darkgrey;"></span>&nbsp;&nbsp;Final Approved &nbsp;&nbsp;
        <span class="fa fa-circle" style="color:limegreen;"></span>&nbsp;&nbsp;Department Aproved &nbsp;&nbsp;
        <span class="fa fa-circle" style="color:deepskyblue;"></span>&nbsp;&nbsp;Waiting for approval,&nbsp;&nbsp;
        <span class="fa fa-circle" style="color:Orange;"></span>&nbsp;&nbsp;Pending &nbsp;&nbsp;
        <span class="fa fa-circle" style="color:LightGray;"></span>&nbsp;&nbsp;Rejected &nbsp;&nbsp;

    </p>
</div>
@(Html.Kendo().Grid<LeaveRequest>()
      .Name("LeaveRequestgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.IsApproved).Visible(false);
          columns.Bound(c => c.LeaveRequestId).Width(150);
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
          columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
          columns.Bound(c => c.Type).EditorTemplateName("LeaveType").Width(100);
          columns.Bound(c => c.Day).Width(80);
          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Width(80);
          columns.Bound(c => c.FromAmharic).Width (100);
          columns.Bound(c => c.ToAmharic).Width (100);
          columns.Bound(c => c.Status).Width (100);
          columns.Bound(c => c.IsOnlineApproved).ClientTemplate(
               "<input type='checkbox' disabled = 'true' value='#=IsOnlineApproved#' " +
               "# if (IsOnlineApproved) { #" +
               "checked='checked'" +
               "# } #" +
               "/>").Width(120);
          columns.Bound(c => c.IsVoid).ClientTemplate(
                  "<input type='checkbox' disabled = 'true' value='#=IsVoid#' " +
                  "# if (IsVoid) { #" +
                  "checked='checked'" +
                  "# } #" +
                  "/>").Width(120);
          columns.Bound(c => c.LeaveBalance).Width(120);
          columns.Bound(c => c.LeaveDays).Width (130);
          columns.Bound(c => c.Reason).Width (150);
          //columns.Bound(c => c.Remark);
          columns.Command(command =>
          {
              //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              //command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(180);
      })
      .ToolBar(toolbar =>
      {
      toolbar.Template(@<text>
        <div class="toolbar">
                                           
                                            
                                          
                @(Html.Kendo().Button()
                .Name("btnCopy")
                .HtmlAttributes(new { type = "button", @class = "k-primary btn btn-primary btn-xs pull-left" })
                .Events(e => e.Click("RefreshBranchAndBussinessUnit"))
                .Content(Resources.HR_Button_Refresh_Branch + " & " + Resources.BussinessUnit))

                                            
                                           
                                            
        </div>

       </text>);

      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("LeaveRequest").Window(window => { window.Title(Resources.NavigatorLeave_LeaveRequests); window.Scrollable(false); }))
      .Scrollable(h => h.Height(500))
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);

      })
      .Filterable()
      .Events(e =>
      {
          e.DataBound("onDataBound");
          e.DetailExpand("onDetailExpandUser");
      })
      .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("LeaveRequestId").Descending())
          .Events(events =>
          {
              events.Error("error_handler(\"LeaveRequestgrid\")");
              events.RequestStart("onRequestStart(\"LeaveRequestgrid\")");
              events.RequestEnd("onRequestEnd(\"LeaveRequestgrid\")");

          })
           .Model(model =>
           {
               model.Id(p => p.LeaveRequestId);
               model.Field(p => p.BranchId).Editable(false);
               model.Field(p => p.BusinessUnitId).Editable(false);
               model.Field(p => p.IsOnlineApproved).Editable(false);

           })
              .Read(read => read.Action("LeaveRequest_Read", "LeaveRequestStatus"))
              .Create(create => create.Action("LeaveRequest_Create", "LeaveRequestStatus"))
              .Update(update => update.Action("LeaveRequest_Update", "LeaveRequestStatus"))
              .Destroy(destroy => destroy.Action("LeaveRequest_Destroy", "LeaveRequestStatus"))
          ).ClientDetailTemplateId("template")
      )

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_#=LeaveRequestId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text(Resources.HR_RequestStatus).Content(
