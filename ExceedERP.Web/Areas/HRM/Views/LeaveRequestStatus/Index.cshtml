<script>
    function uploadFile(id) {
        $("#leaveRequestId").val(id);
        var wnd = $("#UploadDoc").data("kendoWindow");
        wnd.center().open();
    }
   

    function sync_handler(e) {
        this.read();

    }
    var masterId = 0;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#LeaveRequestgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.LeaveRequestId;
        var gridName = "#RequestesStatusgrid" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatus", "LeaveRequestStatus")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-add", gridName).hide();
                }
                else if (r == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else if (r == "Dapproved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).show();
                    $(".k-grid-edit", gridName).show();
                    $(".k-grid-delete", gridName).show();
                }
                else
                {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-add", gridName).show();
                }

            }

        });

    }
    function onUploadSuccess(e) {
        // Force the rebinding of the Grid on successful upload
        $("#LeaveRequestAttachementGrid" + masterId).data("kendoGrid").dataSource.read();
    }
    function valueMapper(options) {
        $.ajax({
            url: "/HRM/Leave/Employee_ValueMapper/",
            data: {
                value: options.value || 0,
                status: 1,
                excludeId: -1
            },
            success: function (data) {
                options.success(data);
            }
        });
    }

    function convertValues(value) {
        var data = {};

        value = $.isArray(value) ? value : [value];

        for (var idx = 0; idx < value.length; idx++) {
            data["values[" + idx + "]"] = value[idx];
        }

        return data;
    }
</script>

<script>

    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (model.IsOnlineApproved) {

                $(this).css("background-color", "darkgrey");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            else if (model.Status === "DEPARTMENT_APPROVAL" || model.IsApproved) {
                $(this).css("background-color", "limegreen");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            else if (model.IsPending) {

                $(this).css("background-color", "Orange");
                $(this).find(".k-grid-edit").show();
                $(this).find(".k-grid-delete").show();
            }
            else if (model.IsRejected) {

                $(this).css("background-color", "LightGray");
                $(this).find(".k-grid-edit").show();
                $(this).find(".k-grid-delete").show();
            }
            else if (model.IsWaiting) {

                $(this).css("background-color", "deepskyblue");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            else {
                $(this).find(".k-grid-edit").show();
                $(this).find(".k-grid-delete").show();



            }
        });
    }


    function RefreshBranchAndBussinessUnit(e) {
        if (confirm("are you sure to refresh ")) {
            $.ajax({
                url: "/HRM/LeaveRequestStatus/RefreshBussinessUnitAndBranch/",
                success: function (data) {
                    options.success(data);
                }
            });
        }
        else {
            alert("not updated");
        }
    }
    function onRequestesStatusDataBound() {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (model.Status == 0
                || model.Status == 1
                || model.Status == 2
                || model.Status == 3
                || model.Status == 4
                || IsApproved)
            {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }

        });

    }
</script>
<script>
    function updateEmployeeLeaveRequest(element) {
        var $button = $(element);
        var $icon = $button.find('i');
        var originalIcon = $icon.attr('class');

        // Show loading spinner
        $icon.attr('class', 'fa fa-spinner fa-spin');
        $button.prop('disabled', true);
        $('#loading-image').show();
        $.ajax({
            url: '@Url.Action("UpdateLeaveRequestinfo", "LeaveRequestStatus")',
            type: 'POST',
            dataType: 'json',
            success: function (response) {
                alert(response.message);
                $('#loading-image').hide();
                $button.prop('disabled', false);
            },
            error: function (xhr, status, error) {
                alert('An error occurred while updating leave request info. Please try again.');
                $('#loading-image').hide();
                $button.prop('disabled', false);
            },
            complete: function () {
                // Restore original button state
                $icon.attr('class', originalIcon);
                $button.prop('disabled', false);
            }
        });
    }
</script>
