                          .Create(create => create.Action("Attachments_Create", "Attachment", new { Area = "Common", attachmentReferenceType = "DOCUMENT", id = "#=LeaveRequestId#", fileOwner = "#=LeaveRequestId#" }))
                          .Destroy(destroy => destroy.Action("Attachments_Destroy", "EmployeeProfile"))

