            </text>);
            })

            .Scrollable(h => h.Height("auto"))
            .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events =>
            {
                events.Error("error_handler(\"LeaveRequestAttachementGrid#=LeaveRequestId#\")");
                events.RequestStart("onRequestStart(\"LeaveRequestAttachementGrid#=LeaveRequestId#\")");
                events.RequestEnd("onRequestEnd(\"LeaveRequestAttachementGrid#=LeaveRequestId#\")");

            })
            .Model(model => model.Id(p => p.LeaveRequestAttachementId))
            .Read(read => read.Action("LeaveRequestAttachements_Read", "LeaveRequestAttachements", new { id = "#=LeaveRequestId#" }).Data("sendForgery"))
            .Create(create => create.Action("LeaveRequestAttachements_Create", "LeaveRequestAttachements", new { id = "#=LeaveRequestId#" }).Data("sendForgery"))
            .Update(update => update.Action("LeaveRequestAttachements_Update", "LeaveRequestAttachements").Data("sendForgery"))
            .Destroy(destroy => destroy.Action("LeaveRequestAttachements_Destroy", "LeaveRequestAttachements").Data("sendForgery"))
            ).ToClientTemplate())
}

