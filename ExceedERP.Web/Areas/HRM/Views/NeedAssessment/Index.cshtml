@using System.Collections
@using ExceedERP.Core.Domain.HRM.TrainingEducation
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@(Html.Kendo().TabStrip()
            .Name("tabstrip")
            .Animation(animation =>
                animation.Open(effect =>
                    effect.Fade(FadeDirection.In)))
            .Items(tabstrip =>
            {
                tabstrip.Add().Text(Resources.NavigatorTraining_DepartmentTrainingPlan)
                    .Selected(true)
                    .Content(@<text>

                        @DepartmentTrainingNeedAssessment()

                    </text>);

                        tabstrip.Add().Text("Training Need Assessment Summary")
                        .Content(@<text>

                            @TrainingNeedAssessmentSummary()

                        </text>);

                               tabstrip.Add().Text(Resources.NavigatorTraining_NeedAssessment)
                  .Content(@<text>

                    @TrainingPlan()

                </text>);

              tabstrip.Add().Text(Resources.NavigatorSelfCare_TrainingApplicant)
 .Content(@<text>
    @TrainingRequest()
</text>);
    })
)


@helper DepartmentTrainingNeedAssessment()
{

    <Legend>@Resources.NavigatorTraining_NeedAssessment</Legend>

     @(Html.Kendo().Grid<NeedAssessment>()
            .Name("NeedAssessmentgrid")
            .Columns(columns =>
            {
                columns.Select().Width(40);
                columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["allDepartments"], "OrgStructureId", "Name").EditorTemplateName("Department").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                columns.ForeignKey(c => c.RequiredTraining, (IEnumerable)ViewData["TargetGroup"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                columns.Bound(c => c.NoOfStaff).Width(100);
                columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["CourseList"], "LookupId", "Description").EditorTemplateName("Course").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                columns.ForeignKey(c => c.Type, (IEnumerable)ViewData["TraTypeList"], "LookupId", "Description").EditorTemplateName("TrainingType").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);

                columns.Bound(c => c.Remark).Width(200);
                columns.Command(command =>
                {
                  command.Custom("send").Text(Resources.HR_Send_For_Approval).Click("SendForApproval").HtmlAttributes(new { @class = "btn btn-success" });

                    if (HttpContext.Current.User.IsInRole("HR_Training_User"))
                    {
                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                    }
                    if (HttpContext.Current.User.IsInRole("HR_Admin"))
                    {
                      command.Destroy().Text(Resources.ActionButton_Cancel);

                    }
                }).Width(300);
            })
            .ToolBar(toolbar =>
            {

            toolbar.Template(@<text>
            @if (HttpContext.Current.User.IsInRole("HR_Training_User") || HttpContext.Current.User.IsInRole("HR_Department_Head"))
              {

                @item.CreateButton(Resources.ActionButton_AddNewRecord)
                //@item.SaveButton();
            }
            <div class="toolbar pull-right">
                <label class="category-label">@Resources.HR_RecruitmentManagment_Vacancy_BranchId</label>
                @(Html.Kendo().ComboBox()
                                        .Placeholder(Resources.HR_RecruitmentManagment_Vacancy_BranchId)
                                        .Name("OrgBranchName")
                                        .BindTo((IEnumerable)ViewData["Branches"])
                                        .DataTextField("Name")
                                        .DataValueField("BranchId")
                                        .Events(x => x.Change("Branch"))
                                        .AutoBind(false)
                                        .HtmlAttributes(new { style = "width: 200px;" })

                )
                @(Html.Kendo().Button()
                         .Name("btn_summary")
                         .Content("Summary")
                         .Events(e =>
                         {

                             e.Click("onSummaryClick");

                         })
                          .HtmlAttributes(new { @class = "btn btn-success" })
                          .Enable(false)
                )

                @if (HttpContext.Current.User.IsInRole("HR_Training_User"))
                                {
                    // @item.SaveButton();
                    //toolbar.Save();

                    // toolbar.Save().SaveText(Resources.Button_Transfer_To_Plan);
                    //toolbar.Save().CancelText("dd");
                    // <button type="button" id="transferhButton" class="k-primary" style="width:100px">Transfer</button>

                }




                @if (HttpContext.Current.User.IsInRole("HR_Admin"))
                 {

                    @item.CustomCommandToolBarButton("Excel", "<span class='k-icon k-i-excel'></span>" + Resources.ActionButton_ExportExcel, "Excel_Export_Save", "NeedAssessment", "", new { @class = "k-button k-button-icontext k-grid-excel btn btn-primary btn-xs pull-right" });
                    @item.CustomCommandToolBarButton("PDF", "<span class='k-icon k-i-pdf'></span>" + Resources.ActionButton_ExportPDF, "Pdf_Export_Save", "NeedAssessment", "", new { @class = "k-button k-button-icontext k-grid-pdf  btn btn-primary btn-xs pull-right" });

                }
            </div>
            </text>);

            })
                .Excel(excel => excel
                .FileName(Resources.NavigatorTraining_NeedAssessment + ".xlsx")
                .Filterable(true)
                .AllPages(true))
                .Pdf(pdf => pdf
                .AllPages()
                .FileName(Resources.NavigatorTraining_NeedAssessment + ".pdf"))
                .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("NeedAssessment")
                              .Window(window => { window.Title(Resources.NavigatorTraining_NeedAssessment);
                                                  window.Scrollable(false); }))
                .Scrollable(h => h.Height(500))
                .PersistSelection()
                .Filterable()
                .Excel(excel => excel
                    .FileName("TrainingNeedAssessment.xlsx")
                .Filterable(true))
                    .Pageable(pageable => pageable
                    .Input(true)
                    .Numeric(false)
                    .Refresh(true)
                    .PageSizes(true)
                    .ButtonCount(5))

                .Events(e =>
                {
                    e.DataBound("onDataBound");
                    e.Change("onMainGridSelectionChange");
                    e.DetailExpand("onDetailExpandUser");

                })
              .DataSource(dataSource => dataSource
                .Ajax()
                .Sort(s => s.Add(x => x.AssesmentId).Descending())
                .Events(events =>
                {
                    events.Error("error_handler(\"NeedAssessmentgrid\")");
                    events.RequestStart("onRequestStart(\"NeedAssessmentgrid\")");
                    events.RequestEnd("onRequestEnd(\"NeedAssessmentgrid\")");
                })

                .Model(model => model.Id(p => p.AssesmentId))
                .Read(read => read.Action("NeedAssessments_Read", "NeedAssessment"))
                .Create(create => create.Action("NeedAssessments_Create", "NeedAssessment"))
                .Update(update => update.Action("NeedAssessments_Update", "NeedAssessment"))
                .Destroy(destroy => destroy.Action("NeedAssessments_Destroy", "NeedAssessment"))
            ).ClientDetailTemplateId("assessment_Kb_details")
    )

}
<script id="assessment_Kb_details" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tab_strip1_#=AssesmentId#")
            .SelectedIndex(0)
            .Items(items =>
            {
                items.Add().Text("Training Need Request").Content(
                @<text>
                    @trainingNeedRequest()
                </text>);

            }).ToClientTemplate())
</script>
@helper trainingNeedRequest()
{
    @(Html.Kendo().Grid<TrainingNeedRequest>()
            .Name("Training_Need_Requestgrid#=AssesmentId#")
            .Columns(columns =>
            {
                columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["allDepartments"], "OrgStructureId", "Name").EditorTemplateName("Department").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                //columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(150);
                columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").EditorTemplateName("EmployeeList").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                columns.Bound(c => c.Prerequest).Width(150);
                columns.Bound(c => c.EmployeePerformanceGap).Width(200);
                columns.Bound(c => c.TrainingNeedForEmployeePerformanceGap).Width(200);
                columns.Bound(c => c.TheNeedForTrainingRelatedToInistitution).Width(200);
                columns.Bound(c => c.ExpectedResultFromTraining).Width(200);
                columns.Command(command =>
                {
                    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                    command.Destroy().Text(Resources.ActionButton_Cancel);

                }).Width(180);
            })
            .ToolBar(toolbar =>
            {
                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
            })
            .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("TrainingRequest")
            .Window(window =>
            {
                window.Title("Training Need Request form");
                window.Scrollable(false);
            })
                )
            .Scrollable(h => h.Height(550))
            .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events =>
                {
                    events.Error("error_handler(\"Training_Need_Requestgrid#=AssesmentId#\")");
                    events.RequestStart("onRequestStart(\"Training_Need_Requestgrid#=AssesmentId#\")");
                    events.RequestEnd("onRequestEnd(\"Training_Need_Requestgrid#=AssesmentId#\")");


                })

                .Model(model =>
                {
                    model.Id(p => p.TrainingNeedRequestId);
                })
                .Read(read => read.Action("TrainingNeedRequests_Read", "TrainingNeedRequests", new { aId = "#=AssesmentId#" }))
                .Create(create => create.Action("TrainingNeedRequests_Create", "TrainingNeedRequests", new { assesId = "#=AssesmentId#" }))
                .Update(update => update.Action("TrainingNeedRequests_Update", "TrainingNeedRequests"))
                .Destroy(destroy => destroy.Action("TrainingNeedRequests_Destroy", "TrainingNeedRequests"))
            ).ToClientTemplate()
    )
}

@helper TrainingPlanApproval()
{

    <legend>@Resources.NavigatorTraining_TransferAssessment</legend>


    @(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.TrainingEducation.TrainingAssessmentViewModel>()
                .Name("TrainingAssessmentgrid")
                .Columns(columns =>
                {
                    columns.Bound(c => c.Check).Template(@<text></text>).ClientTemplate("<input type='checkbox' #= Check ? checked='checked':'' # class='chkbx' />")
                            .HeaderTemplate("<input type='checkbox' id='masterCheckBox' onclick='checkAll(this)'/>").Width(30);
                    columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["allDepartments"], "OrgStructureId", "Name").EditorTemplateName("Department").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                    columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").Width(120);
                    columns.Bound(c => c.NoOfStaff).Width(100);
                    columns.ForeignKey(c => c.RequiredTraining, (IEnumerable)ViewData["TargetGroup"], "LookupId", "Description").Width(120);
                    columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["CourseList"], "LookupId", "Description").EditorTemplateName("Course").Width(120);
                    columns.ForeignKey(c => c.Type, (IEnumerable)ViewData["TraTypeList"], "LookupId", "Description").EditorTemplateName("TrainingType").Width(120);
                    columns.Bound(c => c.Remark).Width(250);

                })
                .ToolBar(toolbar =>
                {

                toolbar.Template(@<text>


                        @item.SaveButton()


                    </text>);


                })

                    .Editable(editable => editable.Mode(GridEditMode.InCell))
                    .PersistSelection()
                    .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Batch(true)
                        .Events(events =>
                        {
                            events.Error("error_handler(\"TrainingAssessmentgrid\")");
                            events.RequestStart("onRequestStart(\"TrainingAssessmentgrid\")");
                            events.RequestEnd("onRequestEnd(\"TrainingAssessmentgrid\")");
                        })
                        .Model(model =>
                        {
                            model.Id(p => p.TrainingAssessmentViewModelId);
                            model.Field(p => p.OrgStructureId).Editable(false);
                            model.Field(p => p.RequiredTraining).Editable(false);
                            model.Field(p => p.NoOfStaff).Editable(false);
                            model.Field(p => p.LookupId).Editable(false);
                            model.Field(p => p.Type).Editable(false);
                        })

                    .Read(read => read.Action("TrainingAssessments_Read", "TrainingAssessment"))
                    .Create(create => create.Action("Transfer_Create", "NeedAssessment"))
                    .Update(update => update.Action("Transfer_Create", "NeedAssessment"))
            )

    )

}


