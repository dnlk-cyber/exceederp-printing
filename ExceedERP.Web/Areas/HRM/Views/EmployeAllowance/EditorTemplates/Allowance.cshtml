@model int?

@(Html.Kendo().MultiSelectFor(m => m)
          .DataTextField("AllowanceName")
          .DataValueField("AllowanceDefinationId")
          .Placeholder("Select allowances...")
          .Filter("contains")
          .BindTo((IEnumerable<ExceedERP.Core.Domain.HRM.Allowance.AllowanceDefination>)ViewData["AllowanceList"])
)