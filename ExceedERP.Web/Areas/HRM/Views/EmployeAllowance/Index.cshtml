<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
    function Referesh(e) {
        try {
            var fromDate = $("#FromT").data("kendoDatePicker");
            var toDate = $("#ToT").data("kendoDatePicker");
            var fromd = fromDate.value();
            var tod = toDate.value();

            var from = kendo.toString(kendo.parseDate(fromd), 'dd/MM/yyyy');
            var to = kendo.toString(kendo.parseDate(tod), 'dd/MM/yyyy')
            $.ajax({
                url: '@Url.Action("SetDate", "EmployeAllowance")',
                contentType: "application/json; charset=utf-8",
                data: { 'from': from, 'to': to },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                    $("#From").val(fromd);
                    $("#From").trigger("change");
                //    $("#AllowancePerEmployeegrid").data("kendoGrid").dataSource.read();
                   // $("#AllowancePerEmployeegrid").data("kendoGrid").refresh();
                }

            });
          
        } catch (e) {
            //alert("Please select the row!!");
        }
    }
</script>
<script type="text/javascript">
    $(function () {
        $('#AllowancePerEmployeegrid').on('click', '.chkbx', function () {
            var checked = $(this).is(':checked');
            var grid = $('#AllowancePerEmployeegrid').data().kendoGrid;
            var dataItem = grid.dataItem($(this).closest('tr'));
            dataItem.set('Pend', checked);
        })
    })

    function checkAll(ele) {
        var state = $(ele).is(':checked');
        var grid = $('#AllowancePerEmployeegrid').data().kendoGrid;
        $.each(grid.dataSource.view(), function () {
            if (this['Pend'] != state)
                this.dirty = true;
            this['Pend'] = state;
        });
        grid.refresh();
    }
    function ReAssign()
    {
        $.ajax({
            url: '@Url.Action("PerapreEmployeeAllowance", "EmployeAllowance")',
            contentType: "application/json; charset=utf-8",
          //  data: { 'from': from, 'to': to },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
                //$("#From").val(fromd);
                //$("#From").trigger("change");
                   $("#AllowancePerEmployeegrid").data("kendoGrid").dataSource.read();
                $("#AllowancePerEmployeegrid").data("kendoGrid").refresh();
            }

        });

    }
</script>

