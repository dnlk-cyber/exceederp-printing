@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.Allowance
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorBenefit_EmployeeAllowance</legend>
@(Html.Kendo().Grid<AllowancePerEmployee>()
      .Name("AllowancePerEmployeegrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(120);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("PayrollListOfEmployee").Filterable(f=>f.Multi(true).Search(true)).Width(200);
          columns.ForeignKey(c => c.AllowanceDefinationId, (IEnumerable)ViewData["AllowanceList"], "AllowanceDefinationId", "AllowanceName").EditorTemplateName("Allowance").Filterable(f=>f.Multi(true).Search(true)).Width(200);
          columns.Bound(c => c.Pend).ClientTemplate("<input type='checkbox' #= Pend ? checked='checked':'' # class='chkbx' />").Width (120);
          columns.Bound(c => c.From).Width(150);
          columns.Bound(c => c.To).Width(150);
          columns.Bound(c => c.Remark).Width(150);
          columns.Command(command =>
          {
              //if (HttpContext.Current.User.IsInRole("HR_Benefit_User"))
              //{
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              //}
              if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Benefit_Admin"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {

      toolbar.Template(@<text>
         <div class="toolbar">
          
             @item.CreateButton(Resources.ActionButton_AddNewRecord)            
          
         </div>       

         </text>);

      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))     
         .Scrollable(h => h.Height(500))
         .Groupable()
         .Filterable()
         .Pageable(pageable => pageable
         .Input(true)
         .Numeric(false)
         .Refresh(true)
         .PageSizes(true)
         .ButtonCount(5))    

      .DataSource(dataSource => dataSource
      .Ajax()
              .Events(events =>
               {

                   events.Error("error_handler(\"AllowancePerEmployeegrid\")");
                   events.RequestStart("onRequestStart(\"AllowancePerEmployeegrid\")");
                   events.RequestEnd("onRequestEnd(\"AllowancePerEmployeegrid\")");
               })

          .Model(model =>
          {
              model.Id(p => p.AllowanceId);
              model.Field(p => p.EmployeeCode).Editable(false);
              model.Field(p => p.Remark).Editable(false);
          })
          .Read(read => read.Action("AllowancePerEmployees_Read", "EmployeAllowance"))
           .Create(create => create.Action("AllowancePerEmployees_Create", "EmployeAllowance"))
          .Update(update => update.Action("AllowancePerEmployees_Update", "EmployeAllowance"))
            .Destroy(destroy => destroy.Action("AllowancePerEmployees_Destroy", "EmployeAllowance"))
              )
)



<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>

<script type="text/javascript">
    $(function () {
        $('#AllowancePerEmployeegrid').on('click', '.chkbx', function () {
            var checked = $(this).is(':checked');
            var grid = $('#AllowancePerEmployeegrid').data().kendoGrid;
            var dataItem = grid.dataItem($(this).closest('tr'));
            dataItem.set('Pend', checked);
        })
    })

    function checkAll(ele) {
        var state = $(ele).is(':checked');
        var grid = $('#AllowancePerEmployeegrid').data().kendoGrid;
        $.each(grid.dataSource.view(), function () {
            if (this['Pend'] != state)
                this.dirty = true;
            this['Pend'] = state;
        });
        grid.refresh();
    }
    function ReAssign()
    {
        $.ajax({
            url: '@Url.Action("PerapreEmployeeAllowance", "EmployeAllowance")',
            contentType: "application/json; charset=utf-8",
          //  data: { 'from': from, 'to': to },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
                //$("#From").val(fromd);
                //$("#From").trigger("change");
                $("#AllowancePerEmployeegrid").data("kendoGrid").dataSource.read();
                $("#AllowancePerEmployeegrid").data("kendoGrid").refresh();
            }

        });

    }
</script>

