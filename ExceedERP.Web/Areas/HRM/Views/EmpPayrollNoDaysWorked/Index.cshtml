@using System.Collections
@using ExceedERP.Core.Domain.HRM.Attendance
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorAttendance_DaysWorked</legend>
@(Html.Kendo().Grid<EmpPayrollNoDaysWorked>()
          .Name("EmpPayrollNoDaysWorkedgrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150).Width(200);
          columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["CurrentYearPeriods"], "GLPeriodId", "Name").EditorTemplateName("GetCurrentYearPeriods").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150).Width(200);
          columns.Bound(c => c.Days);
          //columns.Bound(c => c.Remark);
          columns.Bound(c => c.Reason);
          columns.Bound(c => c.MeasureTaken);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Attendance_User"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("HR_Attendance_User") || HttpContext.Current.User.IsInRole("HR_Admin"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Template(@<text>
<div class="toolbar">
    @if (HttpContext.Current.User.IsInRole("HR_Attendance_User"))
                {
        @item.CreateButton(Resources.ActionButton_AddNewRecord)

                }
    
    <label class="category-label" for="GLPeriodId">@Resources.HR_Attendance_EmpPayrollNoDaysWorked_PeriodId</label>
    @(Html.Kendo().ComboBox()
                  .Placeholder(Resources.HR_Attendance_EmpPayrollNoDaysWorked_PeriodId)
                  .Name("Period")

                  .DataSource(dataSource =>
                  {
                                                   dataSource.Read(read => read.Action("GetCurrentYearPeriods", "EmpPayrollNoDaysWorked", new { area = "HRM" }))
                                                       .ServerFiltering(false);
                                               })

                  .DataTextField("Name")
                  .DataValueField("GLPeriodId")
                  .AutoBind(false)

                  .HtmlAttributes(new { style = "width: 300px;" })

    )
    @if (HttpContext.Current.User.IsInRole("GenerateDayAbsent")) { 

    @(Html.Kendo().Button()
                 .Name("btnRefresh")
                 .HtmlAttributes(new { type = "button", @class = "k-primary", width = "200px" })
                 .Events(e => e.Click("Refresh"))
                 .Content("Generate Days Absent"))
    

    @(Html.Kendo().Button()
                  .Name("btnSummary")
                  .HtmlAttributes(new { type = "button", @class = "k-primary", width = "200px" })
                  .Events(e => e.Click("summary"))
                  .Content(Resources.HR_Attendance_EmpPayrollNoDaysWorked_Summary))
    }


</div>

        </text>);
           
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
                         .Groupable()
                                  .Sortable(sortable =>
                                  {
                                      sortable.SortMode(GridSortMode.SingleColumn);
                                  })
                      .Filterable()
                         .Pageable(pageable => pageable
                                                    .Input(true)
                                                    .Numeric(false)
                                                    .Refresh(true)
                                                    .PageSizes(true)
                                                    .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                                                  .Events(events =>
                                                                   {

                                                                       events.Error("error_handler(\"EmpPayrollNoDaysWorkedgrid\")");
                                                                       events.RequestStart("onRequestStart(\"EmpPayrollNoDaysWorkedgrid\")");
                                                                       events.RequestEnd("onRequestEnd(\"EmpPayrollNoDaysWorkedgrid\")");
                                                                   })
                       
          .Model(model => model.Id(p => p.EmpPayrollNoDaysWorkedId))
          .Read(read => read.Action("EmpPayrollNoDaysWorkeds_Read", "EmpPayrollNoDaysWorked"))
          .Create(create => create.Action("EmpPayrollNoDaysWorkeds_Create", "EmpPayrollNoDaysWorked"))
          .Update(update => update.Action("EmpPayrollNoDaysWorkeds_Update", "EmpPayrollNoDaysWorked"))
          .Destroy(destroy => destroy.Action("EmpPayrollNoDaysWorkeds_Destroy", "EmpPayrollNoDaysWorked"))
      )
)
<script>
    //function error_handler(e) {
    //    if (e.errors) {
    //        var message = "Errors:\n";
    //        $.each(e.errors, function(key, value) {
    //            if ('errors' in value) {
    //                $.each(value.errors, function() {
    //                    message += this + "\n";
    //                });
    //            }
    //        });
    //        alert(message);

    //    }

    //}

    function sync_handler(e) {
        this.read();

    }

    function summary() {
        try {
            $('#loading-image').show();
            var grid = $("#Period").data("kendoComboBox");
            var period = grid.value();
            if (period === "") {
                alert("Please select period first!!");
            } else {
                $.ajax({
                    url: '@Url.Action("Summary", "EmpPayrollNoDaysWorked")',
                    //contentType: "application/json; charset=utf-8",
                    data: { period: period },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        $('#loading-image').hide();
                        r = result;
                        $("#EmpPayrollNoDaysWorkedgrid").data("kendoGrid").dataSource.read();
                        $("#EmpPayrollNoDaysWorkedgrid").data("kendoGrid").refresh();
                    }


                });
            }
        } catch (e) {
            // alert("Please select the row!!");
        }

    }
</script>

<script>

    function Refresh() {
        $('#loading-image').show();
        var grid = $("#Period").data("kendoComboBox");
        var period = grid.value();
        if (period === "") {
            alert("Please select period first!!");
        } else {

            $.ajax({
                url: '@Url.Action("Refresh", "EmpPayrollNoDaysWorked")',
                //contentType: "application/json; charset=utf-8",
                data: { period: period},
                type: 'POST',
                cache: false,
                success: function (result) {
                    $('#loading-image').hide();
                    r = result;

                    $("#EmpPayrollNoDaysWorkedgrid").data("kendoGrid").dataSource.read();
                    $("#EmpPayrollNoDaysWorkedgrid").data("kendoGrid").refresh();
                }


            });
        }
      
        }


</script>