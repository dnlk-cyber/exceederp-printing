@using System.Collections
@using ExceedERP.Core.Domain.HRM.Company
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.Employee @Resources.Enum_EmployeeStatus_PROBATION.ToLower()  @Resources.Settings</legend>
@(Html.Kendo().Grid<EmployeeProbationSetting>()
          .Name("EmployeeProbationSettinggrid")
      .Columns(columns =>
      {

          columns.Bound(c => c.EmployeeProbationSettingId).Title("S.No").Width (95);
          columns.Bound(c => c.IncludeWeekend).ClientTemplate(
                "<input type='checkbox' disabled = 'true' value='#= IncludeWeekend#' " +
                "# if (IncludeWeekend) { #" +
                "checked='checked'" +
                "# } #" +
                "/>").Width (165);
          columns.Bound(c => c.IncludeHoliday).ClientTemplate(
                "<input type='checkbox' disabled = 'true' value='#= IncludeHoliday#' " +
                "# if (IncludeHoliday) { #" +
                "checked='checked'" +
                "# } #" +
                "/>").Width (155);
          columns.Command(command => {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(200);
      })
      .ToolBar(toolbar => {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Scrollable(h => h.Height(500))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Filterable()
        .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                 .Events(events =>
                 {
                     events.Error("error_handler(\"EmployeeProbationSettinggrid\")");
                     events.RequestStart("onRequestStart(\"EmployeeProbationSettinggrid\")");
                     events.RequestEnd("onRequestEnd(\"EmployeeProbationSettinggrid\")");
                 }
              )

              .Model(model => { model.Id(p => p.EmployeeProbationSettingId);
                  model.Field(p => p.EmployeeProbationSettingId).Editable(false);})
          .Read(read => read.Action("EmployeeProbationSettings_Read", "EmployeeProbationSettings"))
          .Create(create => create.Action("EmployeeProbationSettings_Create", "EmployeeProbationSettings"))
          .Update(update => update.Action("EmployeeProbationSettings_Update", "EmployeeProbationSettings"))
          .Destroy(destroy => destroy.Action("EmployeeProbationSettings_Destroy", "EmployeeProbationSettings"))
      )
)
