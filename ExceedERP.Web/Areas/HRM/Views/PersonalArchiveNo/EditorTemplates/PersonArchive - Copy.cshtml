@using System.Collections
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.ArchiveManagement.PersonalArchiveNo

@using ExceedERP.Core.Localization
<form>

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.EmployeeId, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>

                    @(Html.Kendo().DropDownListFor(model => model.EmployeeId)
                                                                      //  .Name("EmployeeId")
                                                                      .DataValueField("PersonId")
                                                .DataTextField("FullName")
                                                   .OptionLabel(Resources.Select)
                                                    .Filter("contains")
                                                    .MinLength(2)
                                                    .HtmlAttributes(new { style = "width:200px" })
                                                    .Virtual(v => v.ValueMapper("valueMapper").ItemHeight(26))
                                                .DataSource(source =>
                                                {
                                                    source.Custom()
                                                          .ServerFiltering(true)
                                                          .ServerPaging(true)
                                                          .Type("aspnetmvc-ajax")
                                                          .Transport(transport => transport.Read(r => r.Action("GetEmployees", "HRMDataProvider")))
                                                          .Schema(schema =>
                                                          {
                                                              schema.Data("Data")
                                                                    .Total("Total");
                                                          });
                                                })

                                                                   .ValuePrimitive(true)


                                                                                          .Height(400)
                                                                                                  .HeaderTemplate("<div class=\"dropdown-header k-widget k-header\">" +
                                                                                "<span>Photo</span>" +
                                                                                "<span>Full Name</span>" +
                                                                            "</div>")
                                                                                    .Template(@"<div class='Employee-photo' style='background-image: url(" + Url.Content("~/Content/Images/") + "#:data.PersonId#-Photo/" + "#:data.PersonId#." + "#:data.ImageType#" + ");'></div>" +
                                                                                    "<div class='Employee-name'>#:FullName#</div>")
                    )



                </div>
            </div>
        </div>


        <div class="col-md-3">
            <div class="form-group">


                <div>@Html.LabelFor(model => model.BranchId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.BranchId)
                                                  .OptionLabel(Resources.Select)
                                                  .Filter("contains")
                                                  .MinLength(2)
                                                   .DataTextField("Name")
                                                        .DataValueField("BranchId")
                                                  .DataSource(dataSource =>
                                                  {
                                                      dataSource.Read(read => read.Action("GetBranches", "HRMDataProvider"))
                                                          .ServerFiltering(false);
                                                  })
                                                  .ValuePrimitive(true)

                    )
                    @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Folder, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">
                @Html.Kendo().TextBoxFor(model => model.Folder)
                @Html.ValidationMessageFor(model => model.Folder, "", new { @class = "text-danger" })
            </div>
        </div>

        @*<div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.ZoneId, htmlAttributes: new { @class = "control-label col-md-8" })

                    </div>
                    <div>

                        @(Html.Kendo().DropDownListFor(model => model.ZoneId)
                      .AutoBind(false)
                      .OptionLabel(Resources.Select)
                                       .BindTo((IEnumerable)ViewData["Zones"])
                                              .DataTextField("ZoneName")
                                              .DataValueField("ZoneId")
                                               .ValuePrimitive(true)
                        )
                    </div>
                </div>
            </div>*@


    </div>

    <br />


    <div class="row">
        <div class="col-md-1">

        </div>




        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Row, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.Row)
                @Html.ValidationMessageFor(model => model.Row, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.FileNo, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.FileNo)
                @Html.ValidationMessageFor(model => model.FileNo, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Shelve, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.Shelve)
                @Html.ValidationMessageFor(model => model.Shelve, "", new { @class = "text-danger" })
            </div>
        </div>



    </div>

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.RoomNo, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.RoomNo)
                @Html.ValidationMessageFor(model => model.RoomNo, "", new { @class = "text-danger" })
            </div>
        </div>
        </div>
        <br />

</form>
