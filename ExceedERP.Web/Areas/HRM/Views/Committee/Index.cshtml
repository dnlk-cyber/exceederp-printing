    <script>
        function Change(e) {

            var dropDown = $("#VaccancyCode").data("kendoDropDownList");
            var x = e.value;
            if (x == "0") {
                // $("#VaccancyCode").prop("disabled", false).addClass("k-state-disabled");
                dropDown.wrapper.show();
                dropDown.enable(true);
                // $('#VaccancyCode').show();
                $("control-label col-md-8", "#VaccancyCode").show();

            }
            else {
                // $("#VaccancyCode").prop("disabled", true).addClass("k-state-disabled");
                dropDown.enable(false);
                dropDown.wrapper.hide();
                $("control-label col-md-8", "#VaccancyCode").hide();


            }
        }
        function Edit(e) {
            var masterRow = e.model.CommitteeType;

            var masterGrid = $("#Committeegrid").data("kendoGrid");
            var dropDown = $("#VaccancyCode").data("kendoDropDownList");
            //var masterDataItem = masterGrid.dataItem(masterRow);

            masterId = masterRow;
            if (masterId == "0") {
                // $("#VaccancyCode").prop("disabled", false).addClass("k-state-disabled");
                dropDown.wrapper.show();
                dropDown.enable(true);
                // $('#VaccancyCode').show();
                $("control-label col-md-8", "#VaccancyCode").show();

            }
            else {
                // $("#VaccancyCode").prop("disabled", true).addClass("k-state-disabled");
                dropDown.enable(false);
                dropDown.wrapper.hide();
                $("control-label col-md-8", "#VaccancyCode").hide();


            }
        }
    </script>
