         items.Add().Text(Resources.Navigator_Company_CommitteeMinute).Content(
            @<text>

                @(Html.Kendo().Grid<CommitteMinute>()
                                      .Name("CommitteMinute_#=CommitteeId#")
             .Columns(columns =>
