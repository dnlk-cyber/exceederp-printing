@(Html.Kendo().DropDownListFor(m => m)
                  .ValuePrimitive(true)
                  .OptionLabel("Select Committee...")
                      .DataTextField("Role")
                              .DataValueField("CommitteeId")
                          .Filter("contains")
                                .DataSource(dataSource =>
                                {
                                    dataSource.Read(read => read.Action("GetCommittee", "HRMDataProvider", new { area = "HRM" }))
                                    .ServerFiltering(false);
                                })
)
@Html.ValidationMessageFor(m => m)
