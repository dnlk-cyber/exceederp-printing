@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.EmployeeDetail.Committee


<div class="form">
    <div class="row fullrow">
        <div class="col-md-3 ro1">
            <div class="form-group">


                @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">

                    @Html.Kendo().TextBoxFor(model=>model.Description)
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                </div>
            </div>


            <div class="form-group">
                @*@Html.LabelFor(model => model.CommitteeType, htmlAttributes: new { @class = "control-label col-md-8" })*@
                <div class="col-md-3">
                    @*@(Html.EnumDropDownListFor(m => m.CommitteeType, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 140px", onchange = "Change(this)" })

                    )
                    @Html.ValidationMessageFor(model => model.CommitteeType, "", new { @class = "text-danger" })*@
                </div>
            </div>
        </div>
        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.VaccancyCode, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-3">
                    @(Html.Kendo().DropDownListFor(model => model.VaccancyCode)

                                                       //.CascadeFrom("CommitteeType")
                                                       .DataSource(source =>
                                                       {
                                                           source.Read(read =>
                                                           {
                                                               read.Action("GetVacancyGeneratedCode", "HRMDataProvider");
                                                               //.Data("filterCategories");
                                                           })
                                                           .ServerFiltering(true);
                                                       })
                                                   .ValuePrimitive(true)
                          .OptionLabel(Resources.Select)
                                                                 .DataTextField("MediaVacancyCode")
                                                                .DataValueField("MediaVacancyCode")
                                              .Enable(false)
                    )
                </div>
            </div>
            <div class="row"></div><br/>
            @*<div class="form-group">

                @Html.LabelFor(model => model.Role, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-3">
                    @Html.TextAreaFor(model => model.Role)
                        @Html.ValidationMessageFor(model => model.Role, "", new { @class = "text-danger" })
                </div>
            </div>*@
      
       
            <div class="form-group">
                @*  @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-md-8" })*@
                <div class="col-md-6">

                    @Html.Kendo().CheckBoxFor(model => model.IsActive)
                    @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
