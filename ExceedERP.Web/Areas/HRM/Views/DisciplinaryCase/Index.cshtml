<script>
    function DownloadAttachmnets(e) {

        var grid = e.sender;
        var selectedRows = this.select();
        var rowData = this.dataItem(selectedRows[0]);
        var id = rowData.AttachmentID;
        $.ajax({
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("Download", "DisciplinaryCase")',
            data: { 'id': id },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
            }

        });

    }
</script>
<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#TransgressionDateAm").trigger("change");
     
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "DisciplinaryCase")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }

</script>

<script>
    function GetMinuteDate() {

        var x = AssignDate();
        var y = x;
        $("#DateAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "CommitteMinuteDetail")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
    function GetHearingDate() {

        var x = AssignDate();
        var y = x;
        $("#HearingDateAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "EmpDisciplinaryHearing")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
    function GetDisciplineMeasureDate() {

        var x = AssignDate();
        var y = x;
        $("#DecisionDateAm").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "EmpDisciplineMeasure")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
