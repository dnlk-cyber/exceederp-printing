<script>
    function filterMeasure() {
        return {
            MeasuresId: $("#MeasuresId").val()
        };
    }

    function filterMonth() {
        return {
            DetailMeasuresId: $("#DetailMeasuresId").val()
        }
    }
    function onMeasureByMoneyDataBound(e) {
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsOnlineApproved === true) {
                row.css("background-color", "yellow");
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-send").hide();
            }
        }
    }
    function onDataBound(e) {
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsOnlineApproved === true) {
                row.css("background-color", "yellow");
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
            }
        }
    }
    var masterId = 0;
    var isHRapproved =false;
    var isDeptapproved = false;
    var isDeptSendForApproval = false;
    function onDetailExpandUser(e)
    {
        const masterGrid = $("#DisciplinaryCasegrid").data("kendoGrid");
        const masterDataItem = masterGrid.dataItem(e.masterRow);

        isDeptapproved = masterDataItem.IsDepartmentOnlineApproved;
        isDeptSendForApproval = masterDataItem.IsDepartmentSendForApproval;
        isHRapproved = masterDataItem.IsOnlineApproved;
        masterId = masterDataItem.DisciplinaryCaseId;

        const gridSelectors = [
            "#EmpDisciplinaryHearinggrid_" + masterId,
            "#EmpDisciplineMeasuregrid_" + masterId,
            "#DisciplineMeasuerByMoney_" + masterId,
            "#Appeal_" + masterId,
            "#CommitteMinute_" + masterId
        ];

        gridSelectors.forEach(gridSelector => {
            const $grid = $(gridSelector);
            const shouldHide = isHRapproved;

            $grid.find(".k-toolbar").toggle(!shouldHide);
            $(".k-grid-top", $grid).toggle(!shouldHide);
            $(".k-dropzone", $grid).toggle(!shouldHide);
            $(".k-grid-edit", $grid).toggle(false);
            $(".k-grid-delete", $grid).toggle(false);
        });
    }

    function toggleGridControls(selector, condition) {
        const $grid = $(selector);
        $(".k-grid-add, .k-grid-delete, .k-grid-edit", $grid).toggle(!condition);
    }

   
    function onDataBoundTransferRequestValidations(e) {
        toggleGridControls("#" + e.sender.element.attr("id"), isHRapproved);
        //e.sender.table.find(".k-grid-edit").hide();
        //e.sender.table.find(".k-grid-delete").hide();
    }
    function onDetailExpandUserexisetd(e) {
        var masterRow = e.masterRow;
        var masterGrid = $("#DisciplinaryCasegrid").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.DisciplinaryCaseId;

    }
    function sendToFixedContribution(e) {
        var row = $(e.target).closest("tr");
        var grid = $("#DisciplineMeasuerByMoney_" + masterId).data("kendoGrid");

        if (!grid) {
            alert("Grid not found!");
            return;
        }

        var dataItem = grid.dataItem(row);

        if (!dataItem) {
            alert("Please select a row first!!");
            return;
        }

        var childId = dataItem.DisciplineMeasuerByMoneyId;
        if (!childId) {
            return;
        }

        if (confirm("Are you sure you want to send to Fixed Contribution?")) {
            $.ajax({
                url: '@Url.Action("SendToFixedContribution", "DisciplineMeasureByMoney", new { area= "HRM" })',
                data: { id: childId },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        alert(result.Message);
                        $("#DisciplineMeasuerByMoney_" + masterId).data("kendoGrid").dataSource.read();
                    }


            });

        }
    }
</script>