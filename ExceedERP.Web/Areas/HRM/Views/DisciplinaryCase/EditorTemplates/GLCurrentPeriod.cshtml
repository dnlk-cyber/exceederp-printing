@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
    .OptionLabel( Resources.Select)
    .DataTextField("Name")
    .DataValueField("GLPeriodId")
    .Filter("contains")
    .DataSource(dataSource =>
    {
        dataSource.Read(read => read.Action("GetCurrentPeriods", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery"))
            .ServerFiltering(false);

    })
        .ValuePrimitive(true)
)