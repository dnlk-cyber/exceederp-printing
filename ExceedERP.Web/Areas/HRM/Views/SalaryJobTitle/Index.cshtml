@using System.Collections
@using ExceedERP.Core.Domain.HRM.SalaryStructure
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.Navigator_Company_JobTitleSalary</legend>
@(Html.Kendo().Grid<SalaryJobTitle>()
          .Name("SalaryJobTitle")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["jobTitles"], "LookupId", "Description").EditorTemplateName("JobTitles").Width(150);
          columns.ForeignKey(c => c.RankId, (IEnumerable)ViewData["RankList"], "RankId", "RankName").EditorTemplateName("Rank").Width(150);
          columns.ForeignKey(c => c.StepId, (IEnumerable)ViewData["StepList"], "StepId", "StepName").EditorTemplateName("Step").Width(150);
          columns.Bound(c => c.Salary).Width(150);
        columns.Bound(c => c.Remark).Width( 120);
        columns.Command(command =>
        {
            if (HttpContext.Current.User.IsInRole("HR_Company_User"))
            {
                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
            }
            if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Company_Admin"))
            {
                 command.Destroy().Text(Resources.ActionButton_Cancel);//
            }
        }).Width(200);
      })
      .ToolBar(toolbar => {
                              if (HttpContext.Current.User.IsInRole("HR_Company_User"))
                              {
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              }
      })
                          .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("SalaryJobTitle").Window(window => { window.Title(Resources.Navigator_Company_JobTitleSalary); window.Scrollable(false); }))
         .Selectable(selectable =>
         {
             selectable.Mode(GridSelectionMode.Single);
             selectable.Type(GridSelectionType.Row);
         })
             .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Events(events =>
         {
             events.Error("error_handler(\"SalaryJobTitle\")");
             events.RequestStart("onRequestStart(\"SalaryJobTitle\")");
             events.RequestEnd("onRequestEnd(\"SalaryJobTitle\")");
         })
                         
          .Model(model => model.Id(p => p.SalJobTiId))
          .Read(read => read.Action("SalariesJobTitles_Read", "SalaryJobTitle"))
          .Create(create => create.Action("SalariesJobTitles_Create", "SalaryJobTitle"))
          .Update(update => update.Action("SalariesJobTitles_Update", "SalaryJobTitle"))
          .Destroy(destroy => destroy.Action("SalariesJobTitles_Destroy", "SalaryJobTitle"))
      )
)
