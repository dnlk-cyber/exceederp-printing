<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#LetterDateAmmharic").trigger("change");
        $("#RecivedDateAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "Incoming")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }

</script>

<script>
    function GetStatusDate() {

        var x = AssignDate();
        var y = x;
        $("#DateAmharic").trigger("change");
       
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "IncomingStatus")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>

<script>
    function categoriesChange() {
        var value = this.value(),
		 	 grid = $("#Incomming").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "LettersRefNo", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>

<style>
    #grid .k-grid-toolbar {
        padding: .6em 1.3em;
    }

    .category-label {
        vertical-align: middle;
        padding-right: .5em;
    }

    #category {
        vertical-align: middle;
    }

    .toolbar {
        float: right;
    }
</style>