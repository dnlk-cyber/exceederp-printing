@using System.Collections
@using ExceedERP.Web.Areas.HRM.Controllers
@using ExceedERP.Web.Areas.HRM.Controllers.Company
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.SelfCare.TrainingApplicant


<form>

<div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div>@Html.LabelFor(model => model.OrgStructureId, htmlAttributes: new { @class = "control-label col-md-8" })</div>

            @(Html.Kendo().DropDownListFor(model => model.OrgStructureId)
                  .OptionLabel("Select Department")
                  .DataTextField("Name")
                  .DataValueField("OrgStructureId")
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetSelectedDepartments", "HRMDataProvider", new { area = "HRM" }))
                          .ServerFiltering(false);
                  })
                  .ValuePrimitive(true)

            )
            @Html.ValidationMessageFor(model => model.OrgStructureId, "", new { @class = "text-danger" })
        </div>
    </div>
    

    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.LookupId, htmlAttributes: new { @class = "control-label col-md-8" })

        </div>
        <div class="form-group">

            @(Html.Kendo().DropDownListFor(model => model.LookupId)
                  .OptionLabel("Select Course")
                          .DataTextField("Description")
                          .DataValueField("LookupId")
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetCourseList", "HRMDataProvider", new { area = "HRM" }))
                          .ServerFiltering(false);
                  })
                  .ValuePrimitive(true)

            )
            @Html.ValidationMessageFor(model => model.LookupId, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.Date, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">

            @(Html.Kendo().DatePickerFor(model => model.Date)
                  .Value( DateTime.Now.Date ))
            @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
        </div>
    </div>
   

</div>


<br/>

    <br />
    <div class="row">
        <div class="col-md-1">

        </div>
     
      
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div class="form-group">

                @Html.TextAreaFor(model => model.Remark)
                @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
            </div>
        </div>
</div>
</form>
