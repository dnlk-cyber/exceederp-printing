        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.OwnerName, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.OwnerName)
                                                                       //  .Name("EmployeeId")
                                                                       .DataValueField("EmployeeId")
                                                 .DataTextField("FullNameaEnglish")
                                                    .OptionLabel("Select Employee..")
                                                     .Filter("contains")
                                                     .MinLength(2)
                                                     .HtmlAttributes(new { style = "width:160px" })

                                                  .DataSource(dataSource =>
                                                 {
                                                     dataSource.Read(read => read.Action("GetAllEmployees", "HRMDataProvider", new { area = "HRM" }))
                                                                     .ServerFiltering(false);
                                                 })

.ValuePrimitive(true)


.Height(400)

.Events(e => e.Change("GetData"))

                    )
                    @Html.ValidationMessageFor(model => model.OwnerName, "", new { @class = "text-danger" })
                </div>
            </div>
