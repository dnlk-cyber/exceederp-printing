<style>
    div.k-edit-form-container {
        width: 700px;
    }
</style>

<script>
     function GetData() {


         //var institution = $("#InstitutionTypeId").data("kendoDropDownList");
         //var institute = institution.value();

         var employee = $("#OwnerName").data("kendoDropDownList");
         var empId = employee.value();
        $.ajax({
            url: '@Url.Action("GetData", "EmployeeOutgoingLetter")',

            //data: { institute: institute },
            data: { empId: empId },
            type: 'POST',
            cache: false,
            success: function (result) {

                console.log(result);
                if (result.length > 0) {

                    for (var i = 0; i < result.length; i++) {
                        $("#Shelve").data("kendoDropDownList").value(result[i].Shelve);
                        $("#Shelve").trigger("change");

                        $("#Row").data("kendoDropDownList").value(result[i].Row);
                        $("#Row").trigger("change");

                        $("#FileNo").data("kendoDropDownList").value(result[i].FileNo);
                        $("#FileNo").trigger("change");
                       
                        $("#FolderNo").data("kendoDropDownList").value(result[i].Folder);
                        $("#FolderNo").trigger("change");
                    }
                }

            }

        });
    }

</script>