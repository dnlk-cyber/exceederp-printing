<script>
    function GetDate() {

        $("#AttendanceDate").trigger("change");

    }
</script>

<script>
    function filterData() {
        $("#AttendanceDate").trigger("change");
        var attendanceDate = $("#AttendanceDate").val();

        return {
            date: attendanceDate
        };

    }
</script>

