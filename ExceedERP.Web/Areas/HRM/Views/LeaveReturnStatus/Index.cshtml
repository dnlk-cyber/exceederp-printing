<legend>Leave Return</legend>
@(Html.Kendo().Grid<LeaveReturn>()
                                          .Name("LeaveReturngrid")
                                      .Columns(columns =>
                                      {
                                          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));

