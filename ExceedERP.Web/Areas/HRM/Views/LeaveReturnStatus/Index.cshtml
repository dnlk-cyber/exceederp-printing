<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#FromAm").trigger("change");
        $("#ToAm").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "LeaveRequestPersonal")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }

        /////////////////////////////////////////////////////////

             $("#LeaveBalance").val(0);
        var employee = $("#EmployeeId").data("kendoDropDownList");
        var empId = employee.value();
        if (empId == "0" )
        {
            $.ajax({
                url: '@Url.Action("GetBalance", "LeaveReturnPersonal")',

                data: { empId: empId },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    var s = r.split(/-/);

                    $("#LeaveBalance").val(s[0]);
                    $("#LeaveBalance").trigger("change");
                }

            });
        }

    }

</script>
