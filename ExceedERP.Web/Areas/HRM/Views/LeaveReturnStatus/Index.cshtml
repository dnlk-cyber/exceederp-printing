<script>
    function GetRequestedAmount() {

        $("#LeaveDays").val(0);
       // var fromDate = $("#FromAmharic").data('kendoTextBox').value();
        var from = $('#FromAmharic').val();
        //var toDate = $("#ToAmharic").data('kendoTextBox').value();
        var to = $('#ToAmharic').val();
        var dayT = $("#Day").data("kendoDropDownList");
        var half = dayT.value();
        var hour = $('#Hours').val();


            $.ajax({
                url: '@Url.Action("GetLeaveDays", "LeaveReturnPersonal")',

                data: { from: from, to: to, half: half, hour: hour },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    var s = r.split(/-/);

                    $("#LeaveDays").val(s[0]);
                    $("#LeaveDays").trigger("change");
                }

            });

    }

</script>