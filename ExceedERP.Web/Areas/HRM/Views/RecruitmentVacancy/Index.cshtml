<script type="text/javascript">
    $(function () {
        $('#RecruitmentPlanGrid').on('click', '.chkbx', function () {
            var checked = $(this).is(':checked');
            var grid = $('#RecruitmentPlanGrid').data().kendoGrid;
            var dataItem = grid.dataItem($(this).closest('tr'));
            dataItem.set('Check', checked);
        })
    })

    function checkAll(ele) {
        var state = $(ele).is(':checked');
        var grid = $('#RecruitmentPlanGrid').data().kendoGrid;
        $.each(grid.dataSource.view(), function () {
            if (this['Check'] != state)
                this.dirty = true;
            this['Check'] = state;
        });
        grid.refresh();
    }

</script>
