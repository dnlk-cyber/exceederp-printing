@using System.Collections
@using ExceedERP.Core.Domain.HRM.SalaryStructure
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend >@Resources.Navigator_Company_SalaryStructures</legend>
@(Html.Kendo().Grid<Salary>()
          .Name("Salary")
      .Columns(columns =>
      {
       columns.ForeignKey(c => c.RankId, (IEnumerable)ViewData["RankList"], "RankId", "RankName").EditorTemplateName("Rank").Width(150);
        columns.ForeignKey(c => c.StepId, (IEnumerable)ViewData["StepList"], "StepId", "StepName").EditorTemplateName("Step").Width(150);
        columns.Bound(c => c.SalaryAmount);
        columns.Bound(c => c.Remark);
        columns.Command(command =>
        {
            if (HttpContext.Current.User.IsInRole("HR_Company_User"))
            {
                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
            }
            if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Company_Admin"))
            {
                 command.Destroy().Text(Resources.ActionButton_Cancel);//
            }
        }).Width(200);
      })
      .ToolBar(toolbar => {
                              if (HttpContext.Current.User.IsInRole("HR_Company_User"))
                              {
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              }
                              if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Company_Admin"))
                              {
                                  toolbar.Excel().Text(Resources .ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
                                  toolbar.Pdf().Text( Resources .ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
                              }
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
             .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(events =>
     {
         events.Error("error_handler(\"Salary\")");
         events.RequestStart("onRequestStart(\"Salary\")");
         events.RequestEnd("onRequestEnd(\"Salary\")");
     })
                        
          .Model(model => model.Id(p => p.SalaryStructureId))
          .Read(read => read.Action("Salaries_Read", "Salary"))
          .Create(create => create.Action("Salaries_Create", "Salary"))
          .Update(update => update.Action("Salaries_Update", "Salary"))
          .Destroy(destroy => destroy.Action("Salaries_Destroy", "Salary"))
      )
)
