
@model ExceedERP.Core.Domain.FleetManagement.FleetRegistration.Accident
@using System.Collections
@using ExceedERP.Core.Domain.HRM.Attendance
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Accident Registration</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.Accident>()
              .Name("grid")
              .Columns(columns =>
                  {

                      columns.Bound(o => o.AccidentLocation);
                      columns.Bound(o => o.Accountablebody);
                      columns.Bound(o => o.Policereport).Title("Plate Number");
                      columns.Bound(o => o.LevelOfDamage);
                      columns.Bound(o => o.DateOfOccurrence).Format("{0:d}");



                      columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

                  })
              .ToolBar(commands => commands.Create())
              .Editable(editable =>
                  {
                      editable.Mode(GridEditMode.PopUp).TemplateName("AccidentEditor").Window(x => x.Title("Accident Registration "));
                      editable.DisplayDeleteConfirmation("Are You Sure To Remove Accident");
                  })
                   .HtmlAttributes(new { style = "height: 520px;" })
                              .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))

                                    .Scrollable()
                                    .Sortable()
                                    .Filterable()
                                     .Scrollable(h => h.Height(500))
                                        .ClientDetailTemplateId("template")
              .DataSource(dataSource => dataSource
                  .Ajax()
                  .ServerOperation(false)
                  .Model(model =>
                      {
                          model.Id(p => p.AccidentID);
                          model.Field(p => p.AccidentID).Editable(false);

                      })
                                       .Events(ev => ev
                                    .Error("error_handler(\"grid\")")
                                    .RequestStart("onRequestStart(\"grid\")")
                                    .RequestEnd("onRequestEnd(\"grid\")"))
                  .Create(update => update.Action("Accident_Create", "AccidentAndInsurance"))
                  .Read(read => read.Action("Accident_Read", "AccidentAndInsurance"))
                  .Update(update => update.Action("Accident_Update", "AccidentAndInsurance"))
                  .Destroy(update => update.Action("Accident_Destroy", "AccidentAndInsurance"))
              ))

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                                            .Name("tabStrip_#=AccidentID#")
                            .SelectedIndex(0)
                            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                            .Items(items =>
                            {
                                items.Add().Text("Detail").Content(
                                    @<text>
                                        <div>
                                            <div class="box">

                                                <div class="box-col">


                                                </div>
                                            </div>
                                            <div class="demo-section k-header export-app">
                                                <div class="demo-section content-wrapper">

                                                    <form>



                                                        <div class="row">
                                                            <div class="col-md-1">
                                                            </div>
                                                            <div class="col-md-2">
                                                                <div class="form-group">
                                                                    <div class="label">
                                                                        @Html.LabelFor(model => model.CreatedBy)
                                                                    </div>
                                                                    <div>
                                                                        #=CreatedBy#

                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-2">
                                                                <div class="form-group">
                                                                    <div class="label">
                                                                        @Html.LabelFor(model => model.DateCreated)
                                                                    </div>
                                                                    <div>
                                                                        #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="col-md-2">
                                                                <div class="form-group">
                                                                    <div class="label">
                                                                        @Html.LabelFor(model => model.ModifiedBy)
                                                                    </div>
                                                                    <div>

                                                                        #=ModifiedBy#

                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="col-md-2">
                                                                <div class="form-group">
                                                                    <div class="label">
                                                                        @Html.LabelFor(model => model.LastModified)
                                                                    </div>
                                                                    <div>
                                                                        #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #

                                                                    </div>
                                                                </div>
                                                            </div>

                                                        </div>

                                                    </form>

                                                </div>
                                            </div>

                                        </div>

                                    </text>


                                            );
                                    })
                                                                                                                                                                                                                                                                                                                                                        .ToClientTemplate())
</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>

