@using System.Collections
@using ExceedERP.Core.Domain.HRM.Templates
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div>
    <div class="cards-container">
        <div class="k-card k-card-horizontal">
            
            <div class="k-vbox k-column">
                <div class="k-card-header">
                    <h5 class="k-card-title">Card Title</h5>
                </div>
                <div class="k-card-body">
                    <p>Some quick example text to build on the card title and make up the bulk of the card's content.</p>
                </div>
                <div class="k-card-actions k-card-actions-stretched k-card-actions-horizontal">
                    <span class="k-card-action">
                        <span class="k-button k-flat fa fa-edit">Edit</span>
                    </span>
                    <span class="k-card-action">
                        <span class="k-button k-flat k-primary fa fa-trash">Delete</span>
                    </span>
                </div>
            </div>
        </div>

      
    </div>

    <style>
        .cards-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
        }

        .k-card {
            margin: 5%;
            width: 300px;
        }
    </style>
</div>

