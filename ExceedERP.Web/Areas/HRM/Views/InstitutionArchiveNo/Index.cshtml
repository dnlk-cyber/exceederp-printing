@using System.Collections
@using ExceedERP.Core.Domain.HRM.ArchiveManagement
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorArchiveManagement_InstitutionFolder</legend>
@(Html.Kendo().Grid<InstitutionArchiveNo>()
          .Name("InstitutionArchiveNogrid")
      .Columns(columns =>
      {
         // columns.Bound(c => c.InstitutionName);
          columns.ForeignKey(c => c.InstitutionName, (IEnumerable)ViewData["SubjectType"], "SubjectTypeId", "SubjectTypeName");
          columns.Bound(c => c.FileNo);
          // columns.ForeignKey(c => c.InstitutionTypeId, (IEnumerable)ViewData["InstuType"], "InstitutionTypeId", "InstitutionName").EditorTemplateName("Institution");

          columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").EditorTemplateName("Branch");
          columns.Bound(c => c.RoomNo);
          columns.Bound(c => c.Shelve);
          columns.Bound(c => c.Row);
          columns.Bound(c => c.Folder);
          //columns.Bound(c => c.Remark);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("Archive_User"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("Archive_Admin"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          }).Width(200);
      })
      .ToolBar(toolbar => {
          if (HttpContext.Current.User.IsInRole("Archive_User"))
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
      })
                    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("InstitutionArchive").Window(window => { window.Title(Resources.NavigatorArchiveManagement_InstitutionFolder); window.Scrollable(false); }))
           .Selectable(selectable =>
           {
               selectable.Mode(GridSelectionMode.Single);
               selectable.Type(GridSelectionType.Row);
           })
              .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
           .Sort(sort => sort.Add("InstiArchiveNoId").Descending())
               .Events(events =>
               {

                   events.Error("error_handler(\"InstitutionArchiveNogrid\")");
                   events.RequestStart("onRequestStart(\"InstitutionArchiveNogrid\")");
                   events.RequestEnd("onRequestEnd(\"InstitutionArchiveNogrid\")");
               })

          .Model(model => model.Id(p => p.InstiArchiveNoId))
          .Read(read => read.Action("InstitutionArchiveNo_Read", "InstitutionArchiveNo"))
          .Create(create => create.Action("InstitutionArchiveNo_Create", "InstitutionArchiveNo"))
          .Update(update => update.Action("InstitutionArchiveNo_Update", "InstitutionArchiveNo"))
          .Destroy(destroy => destroy.Action("InstitutionArchiveNo_Destroy", "InstitutionArchiveNo"))
      )
)
