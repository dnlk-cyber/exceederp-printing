@using ExceedERP.Web.Areas.HRM.Controllers
@using ExceedERP.Web.Areas.HRM.Controllers.Company
@using Kendo.Mvc.UI.Fluent
@using ExceedERP.Core.Localization

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@(Html.Kendo().TabStrip()
                          .Name("tabstrip")
                          .Animation(animation =>
                              animation.Open(effect =>
                                  effect.Fade(FadeDirection.In)))
                          .Items(tabstrip =>
                          {

                              tabstrip.Add().Text(Resources.Navigator_Company_CompanyChart)
             .Selected(true)
                      .Content(@<text>

                        @(Html.Kendo().TreeView()
                                       .Name("TreeViewTemplateBiding")
                                       .TemplateId("TreeViewTemplate")
                                       .BindTo((IEnumerable<NodeViewModel>)ViewBag.Tree, (NavigationBindingFactory<TreeViewItem> mappings) =>
                                       {
                                                 mappings.For<NodeViewModel>(binding => binding.ItemDataBound((itm, node) =>
                                     {
                                                               itm.Id = node.Id.ToString();
                                                               itm.Text = node.Title;
                                                               itm.Expanded = node.Expanded;
                                                           })
                                         .Children(node => node.Children));
                                             })
                        )


                    </text>);

                                    tabstrip.Add().Text(Resources.Navigator_Company_OrganizationChart)
    .Content(@<text>
           
    <div id="chart-container"></div>

    </text>);

  })
)


<script>
    function name() {
        $('#chart-container').orgChart({
            'data': $('#TreeViewTemplateBiding')

        });
    }

</script>