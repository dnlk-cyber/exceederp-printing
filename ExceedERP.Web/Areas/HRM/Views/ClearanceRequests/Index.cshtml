    function hrApproval(e)
    {
        // Get the closest row to the event target
        var row = $(e.target).closest("tr");
    
        // Get the Kendo Grid instance
        var grid = $("#ClearanceRequestgrid").data("kendoGrid");
    
        // Get the data item for the selected row
        var dataItem = grid.dataItem(row);
    
        // Extract the ClearanceRequestId from the data item
        var id = dataItem.ClearanceRequestId;
    
        // Check if the id is valid (non-empty and defined)
        if (id) {
            // Show loading image during the request
            $('#loading-image').show();
        
        // Make an AJAX POST request to the server for approval
            $.ajax({
                url: '@Url.Action("ClearanceRequestApproval", "ClearanceRequests")', // Server-side action
                data: { id: id }, // Pass the id to the server
                type: 'POST',
                cache: false,
            
                // On success, show the result message, hide loading, and refresh the grid
                success: function (result) {
                    alert(result.Message); // Show the success message from the server
                    $('#loading-image').hide(); // Hide the loading image
                    grid.dataSource.read(); // Refresh the grid data to reflect changes
                },
            
                // Handle any errors during the AJAX request
                error: function (xhr, status, error) {
                    console.log("Error: " + error); // Log the error for debugging
                    alert("An error occurred while processing the request. Please try again.");
                    $('#loading-image').hide(); // Ensure the loading image is hidden on error
                }
            });

        }
        else {
            // If the id is invalid, show an alert
            alert("Clearance Request ID is missing.");
        }


    }
    function hrFinalApproval(e)
    {
        // Get the closest row to the event target
        var row = $(e.target).closest("tr");
    
        // Get the Kendo Grid instance
        var grid = $("#ClearanceRequestgrid").data("kendoGrid");
    
        // Get the data item for the selected row
        var dataItem = grid.dataItem(row);
    
        // Extract the ClearanceRequestId from the data item
        var id = dataItem.ClearanceRequestId;
    
        // Check if the id is valid (non-empty and defined)
        if (id) {
            // Show loading image during the request
            $('#loading-image').show();
        
            // Make an AJAX POST request to the server for approval
            $.ajax({
                url: '@Url.Action("FinalApproval", "ClearanceRequests")', // Server-side action
                data: { id: id }, // Pass the id to the server
                type: 'POST',
                cache: false,
            
                // On success, show the result message, hide loading, and refresh the grid
                success: function (result) {
                    alert(result.Message); // Show the success message from the server
                    $('#loading-image').hide(); // Hide the loading image
                    grid.dataSource.read(); // Refresh the grid data to reflect changes
                },
            
                // Handle any errors during the AJAX request
                error: function (xhr, status, error) {
                    console.log("Error: " + error); // Log the error for debugging
                    alert("An error occurred while processing the request. Please try again.");
                    $('#loading-image').hide(); // Ensure the loading image is hidden on error
                }
            });
        }
        else {
            // If the id is invalid, show an alert
            alert("Clearance Request ID is missing.");
        }

    }

    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsFinalApproval) {

                row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();
                row.find(".k-grid-cmd-approve").remove();
                row.find(".k-grid-cmd-final-approve").remove();
                row.find("#approve").hide();
                row.find("#finalapprove").hide();
                $(".k-grid-top").show();

            }
            else if (dataItem.IsDepartmentOnlineApproved) {

                row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();
                row.find(".k-grid-cmd-approve").remove();
                row.find(".k-grid-cmd-final-approve").show();
                row.find("#approve").hide();
                row.find("#finalapprove").show();
                $(".k-grid-top").show();

            }
            else if (dataItem.IsOnlineApproved) {

                row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();
                row.find(".k-grid-cmd-approve").remove();
                ////row.find(".k-grid-cmd-final-approve").remove();
                row.find("#approve").hide();
                //row.find("#approve").hide();
                $(".k-grid-top").show();

            }

            else if (dataItem.IsSendForApproval) {

                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").remove();
                row.find(".k-grid-cmd-approve").show();
                //row.find(".k-grid-cmd-final-approve").sh();
                //row.find("#approve").show();
                row.find("#finalapprove").hide();
                $(".k-grid-top").show();

            }
            else if(dataItem.IsFinalApproval == false) {


                row.find(".k-grid-cmd-final-approve").show();
                row.find("#finalapprove").show();
                $(".k-grid-top").show();
            }


        }
    }
    function filterEmployee() {
        return {
            text: $("#EmployeeId").data("kendoDropDownList").filterInput.val(),
        };
    }
    function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApprovalRequest", "ClearanceRequestDepartment", new { area = "HRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            },
            error: function (result) {
                alert(result.Message);
            }
        });
    }
</script>
