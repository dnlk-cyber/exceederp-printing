@using System.Collections
@using ExceedERP.Core.Domain.HRM.Company
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend> @Resources.HR_EmployeeDetail_Clearance_Clearance  @Request</legend>
@(Html.Kendo().Grid<ClearanceRequest>()
      .Name("ClearanceRequestgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ClearanceRequestId).Title("#").Width(100);
          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").EditorTemplateName("Organization").Width(200);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["clearanceType"], "LookupId", "Description").EditorTemplateName("ClearanceType").Width(200);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("ActiveEmployeeDepart").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
          columns.Bound(c => c.Remark).Width(120);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Admin"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("HR_Department_Head") || HttpContext.Current.User.IsInRole("HR_Admin"))
              {
                  command.Custom("cmd-approve").Click("hrApproval").Text("Approve").IconClass("fa fa-check fa4x").HtmlAttributes(new { @class = "btn btn-success", @title = "Approve  ", @id = "approve" });
                  command.Custom("cmd-final-approve").Click("hrFinalApproval").Text("Final-Approve").IconClass("fa fa-check fa4x").HtmlAttributes(new { @class = "btn btn-success", @title = "Approve  ", @id = "finalapprove" });

                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          }).Width(300);
      })
      .ToolBar(toolbar => 
      {
          if (HttpContext.Current.User.IsInRole("HR_Company_User"))
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      //.TemplateName("ClearanceProvider").Window(window => { window.Title("Clearance Provider"); window.Scrollable(false); }))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);

      })
      .Events(ev =>
      {
          ev.DataBound("onDataBound");
      })
      .Scrollable(h => h.Height(500))
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);

      })
      .Filterable()
      .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort=>sort.Add(x=>x.ClearanceRequestId).Descending())
          .Events(events =>
          {
              events.Error("error_handler(\"ClearanceRequestgrid\")");
              events.RequestStart("onRequestStart(\"ClearanceRequestgrid\")");
              events.RequestEnd("onRequestEnd(\"ClearanceRequestgrid\")");

          })
          .Model(model => 
          {
              model.Id(p => p.ClearanceRequestId);
              model.Field(p => p.ClearanceRequestId).Editable(false);
          })
          .Read(read => read.Action("ClearanceRequests_Read", "ClearanceRequests").Data("sendForgery"))
          .Create(create => create.Action("ClearanceRequests_Create", "ClearanceRequests").Data("sendForgery"))
          .Update(update => update.Action("ClearanceRequests_Update", "ClearanceRequests").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("ClearanceRequests_Destroy", "ClearanceRequests").Data("sendForgery"))
      ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
  @(Html.Kendo().TabStrip()
        .Name("tabstrip_#=ClearanceRequestId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Detail").Content(
            @<text>
                # if (!IsSendForApproval){#
                <a onclick='return sendForApproval("#=ClearanceRequestId#")' href=' \#' title="@Resources.HR_Send_For_Approval"><i class="fa fa-share-square fa-2x"></i></a>
                #}#
            </text>);
            items.Add().Text("Clearance status").Content(
            @<text>
            @(Html.Kendo().Grid<ClearanceRequestStatus>()
                  .Name("Clearancerequestgrid_#=ClearanceRequestId#")
                  .Columns(columns =>
                  {
                      columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").EditorTemplateName("Organization").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                      columns.Bound(c => c.IsDepartmentOnlineApproved).ClientTemplate(
                                        "<input type='checkbox' disabled = 'true' value='\\#=IsDepartmentOnlineApproved\\#' " +
                                        "\\# if (IsDepartmentOnlineApproved) { \\#" +
                                        "checked='checked'" +
                                        "\\# } \\#" +
                                        "/>"
                                        ).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(150);
                  })
                  .ToolBar(toolbar =>
                  {
                      //if (HttpContext.Current.User.IsInRole("HR_Discipline_User"))
                      //{
                      //    // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                      //}

                  })
                  .Editable(editable => editable.Mode(GridEditMode.InLine))
                  .Selectable(selectable =>
                  {
                      selectable.Mode(GridSelectionMode.Single);
                      selectable.Type(GridSelectionType.Row);


                  })
                  .Scrollable(h => h.Height(350))
                  .DataSource(dataSource => dataSource
                        .Ajax()
                        .Events(events =>
                        {
                            events.Error("error_handler(\"Clearancerequestgrid_#=ClearanceRequestId#\")");
                            events.RequestStart("onRequestStart(\"Clearancerequestgrid_#=ClearanceRequestId#\")");
                            events.RequestEnd("onRequestEnd(\"Clearancerequestgrid_#=ClearanceRequestId#\")");

                        })
                        .Model(model => model.Id(p => p.ClearanceRequestStatusId))
                        .Read(read => read.Action("ClearanceRequests_Read", "ClearanceRequests", new { id = "#=ClearanceRequestId#" }).Data("sendForgery"))
                    //.Create(create => create.Action("ClearanceProviderDetails_Create", "ClearanceProviderDetails", new { cRId = "#=ClearanceRequestId#" }).Data("sendForgery"))
                    //.Update(update => update.Action("ClearanceProviderDetails_Update", "ClearanceProviderDetails").Data("sendForgery"))
                    //.Destroy(destroy => destroy.Action("ClearanceProviderDetails_Destroy", "ClearanceProviderDetails").Data("sendForgery"))
                    ).ToClientTemplate())
                </text>);
        }).ToClientTemplate())

</script>
