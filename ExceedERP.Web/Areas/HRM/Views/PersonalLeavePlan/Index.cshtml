@using System.Collections
@using ExceedERP.Core.Domain.HRM.HRMPlan
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorLeave_LeavePlan</legend>
@(Html.Kendo().Grid<LeavePlan>()
          .Name("LeavePlangrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(200).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.FromAmharic).EditorTemplateName ("Calander").Width(200);
          columns.Bound(c => c.ToAmharic).EditorTemplateName ("Calander").Width(200);
        columns.Bound(c => c.LeaveAmount).Width (150);
        columns.Bound(c => c.Remark).Width (120);
        columns.Command(command =>
        {
           
                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
           
                command.Destroy().Text(Resources.ActionButton_Cancel);
            
        }).Width(200);
      })
      .ToolBar(toolbar => {
                             
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                             
                                  toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
                                  toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
                             
      })
           .Excel(excel => excel
                                                    .FileName(Resources.NavigatorLeave_LeavePlan + ".xlsx")
                                    .Filterable(true)
                                        .AllPages(true)
                                                            .ProxyURL(Url.Action("Excel_Export_Save", "LeavePlan"))
                                )
                                     .Pdf(pdf => pdf
                                    .AllPages()
                                                        .FileName(Resources.NavigatorLeave_LeavePlan + ".pdf")
                                                            .ProxyURL(Url.Action("Pdf_Export_Save", "LeavePlan"))
                                )
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Scrollable(h => h.Height(500))
             .Events(x =>
                               {
                                   x.Edit("GetDate");
                                   x.Save("GetDate");
                               })
             .Groupable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                .Events(events =>
         {
             events.Error("error_handler(\"LeavePlangrid\")");
             events.RequestStart("onRequestStart(\"LeavePlangrid\")");
             events.RequestEnd("onRequestEnd(\"LeavePlangrid\")");
         })
                     
              .Model(model => { model.Id(p => p.LeavePlanId);
              model.Field(p => p.EmployeeCode).Editable (false);
               model.Field(p => p.EmployeeId).Editable (false);})
              
          .Read(read => read.Action("LeavePlans_Read", "PersonalLeavePlan"))
              .Create(create => create.Action("LeavePlans_Create", "PersonalLeavePlan"))
              .Update(update => update.Action("LeavePlans_Update", "PersonalLeavePlan"))
              .Destroy(destroy => destroy.Action("LeavePlans_Destroy", "PersonalLeavePlan"))
      )
)
<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }

   
</style>
