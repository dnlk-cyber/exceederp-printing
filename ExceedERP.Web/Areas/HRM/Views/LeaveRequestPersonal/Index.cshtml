    <script>

        var masterId = 0;
        function onDetailExpandUser(e)
        {
            var masterRow = e.masterRow;
            var masterGrid = $("#LeaveRequestgrid").data("kendoGrid");
            var masterDataItem = masterGrid.dataItem(masterRow);
            masterId = masterDataItem.LeaveRequestId;
            var gridName = "#RequestesStatusgrid_" + masterId;
            var attachmentGridName = "#LeaveRequestAttachementGrid" + masterId;
            $.ajax({
                url: '@Url.Action("CheckStatus", "LeaveRequestStatus")',
                data: { masterId: masterId },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    if (r == "true") {
                        $(gridName).find(".k-toolbar").hide(); //hide toolbar
                        $(".k-grid-top", gridName).hide();
                    }
                    else if (r == "approved") {
                        $(gridName).find(".k-toolbar").hide(); //hide toolbar
                        $(".k-grid-top", gridName).hide();
                        $(".k-grid-edit", gridName).hide();
                        $(".k-grid-delete", gridName).hide();

                        $(attachmentGridName).find(".k-grid-toolbar").hide();
                        $(".k-grid-delete", attachmentGridName).hide();
                    }
                    else if (r == "Dapproved") {
                        $(gridName).find(".k-toolbar").hide(); //hide toolbar
                        $(".k-grid-top", gridName).hide();
                        $(".k-grid-edit", gridName).hide();
                        $(".k-grid-delete", gridName).hide();

                        $(attachmentGridName).find(".k-grid-toolbar").hide();
                        $(".k-grid-delete", attachmentGridName).hide();
                    }
                    else {
                        $(gridName).find(".k-toolbar").show(); //hide toolbar
                        $(".k-grid-top", gridName).show();
                        $(".k-grid-edit", gridName).show();
                        $(".k-grid-delete", gridName).hide();

                        $(attachmentGridName).find(".k-grid-toolbar").show();
                        $(".k-grid-delete", attachmentGridName).show();
                    }

                }

            });

        }

        function onUploadSuccess(e) {
            // Force the rebinding of the Grid on successful upload
            $("#LeaveRequestAttachementGrid" + masterId).data("kendoGrid").dataSource.read();
        }

        function valueMapper(options) {
            $.ajax({
                url: "/HRM/HRMDataProvider/Employee_ValueMapper/",
                data: {
                    value: options.value || 0,
                    status: 1,
                    excludeId: -1
                },
                success: function (data) {
                    options.success(data);
                }
            });
        }

        function convertValues(value) {
            var data = {};

            value = $.isArray(value) ? value : [value];

            for (var idx = 0; idx < value.length; idx++) {
                data["values[" + idx + "]"] = value[idx];
            }

            return data;
        }
        function IsforOthers() {
            return {
                IsForOther: $("#IsForOther").val()
            };
        }

    </script>


    <script>


        // Toggle subordinate request (server-side validation)
        function SetEmployee(e) {
            var isChecked = e.checked;
            var dropDown = $("#EmployeeId").data("kendoDropDownList");

            if (isChecked) {
                dropDown.enable(true);
                $("#LeaveBalance").val(0).trigger("change");
            } else {
                dropDown.value(0);
                dropDown.enable(false);
            }

            $.ajax({
                url: '@Url.Action("SetEmployee", "LeaveRequestPersonal")',
                type: 'POST',
                data: { isForOther: isChecked },
                success: function (result) {
                    if (isChecked && result === 0) {
                        e.checked = false;
                        dropDown.value(0);
                        dropDown.enable(false);
                        alert("You cannot request for other employees!\nNo subordinates under your position.");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error in SetEmployee:", error);
                }
            });
        }
        function onEdit(e) {
            GetTotalBalance();
        }
        // ✅ Get total balance based on employee and date range
        function GetTotalBalance() {
            $("#LeaveBalance").val(0);
            $("#LeaveDays").val(0);
            $("#ExactDeserveLeaveDays").val(0);

            var employee = $("#EmployeeId").data("kendoDropDownList");
            var empId = employee ? employee.value() : 0;
            var morningOrAfternoon = $("#MorningOrAfternoon").data("kendoDropDownList").value(); // 👈 FIXED
            var fromAm =  $("#FromAmharic").val();
            var toAm =  $("#ToAmharic").val() ;
            var from = $("#From").val();
            var to = $("#To").val();
            //if (!empId || empId === "0" || !from || !to) return;
            if (!empId) {
                empId = 0;
                from =from?? null;
                to = to??null;
            }
            $.ajax({
                url: '@Url.Action("GetTotalLeaveAmount", "LeaveRequestPersonal")',
                type: 'POST',
                data: {
                    empId: empId,
                    from: from,
                    to: to,
                    fromAm: fromAm,
                    toAm: toAm,
                    morningOrAfternoon: morningOrAfternoon
                },
                cache: false,
                success: function (result) {
                    if (!result) return;

                    var parts = result.split('-');
                    var totalBalance = parts[0] || "0";
                    var exactDays = parts[1] || "0";
                    var leaveDays = parts[2] || "0";

                    $("#LeaveBalance").val(totalBalance).trigger("change");
                    $("#ExactDeserveLeaveDays").val(exactDays).trigger("change");
                    $("#LeaveDays").val(leaveDays).trigger("change");
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching leave balance:", error);
                }
            });
        }
        //  Get total balance based on employee and date range goergorian
        function GetTotalBalanceGord() {
            $("#LeaveBalance").val(0);
            $("#ExactDeserveLeaveDays").val(0);
            $("#LeaveDays").val(0);

            var employee = $("#EmployeeId").data("kendoDropDownList");
            var empId = employee ? employee.value() : 0;
           // var useEthiopian = $(".et-popup-picker").length > 0;
            var morningOrAfternoon = $("#MorningOrAfternoon").data("kendoDropDownList").value(); // 👈 FIXED
            var from = $("#From").val();
            var to =  $("#To").val();

            //if (!empId || empId === "0" || !from || !to) return;
            if (!empId) {
                empId = 0;
                from =from?? null;
                to = to??null;
            }
            $.ajax({
                url: '@Url.Action("GetTotalLeaveAmountGorg", "LeaveRequestPersonal")',
                type: 'POST',
                data: { empId: empId, from: from, to: to, morningOrAfternoon: morningOrAfternoon  },
                cache: false,
                success: function (result) {
                    if (!result) return;

                    var parts = result.split('-');
                    var totalBalance = parts[0] || "0";
                    var exactDays = parts[1] || "0";
                    var leaveDays = parts[2] || "0";

                    $("#LeaveBalance").val(totalBalance).trigger("change");
                    $("#ExactDeserveLeaveDays").val(exactDays).trigger("change");
                    $("#LeaveDays").val(leaveDays).trigger("change");
                },
