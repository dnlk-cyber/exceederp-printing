@using System.Collections
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.LeaveManagment
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? false;
}

<style>
    .lr-page {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .lr-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 14px;
    }

        .lr-page-header legend {
            border: 0;
            margin: 0;
            padding: 0;
            font-size: 20px;
            font-weight: 700;
            color: #1f2937;
        }

    .lr-status-pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        text-align: center;
        letter-spacing: .2px;
    }

    .status-approved {
        background-color: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }

    .status-dept {
        background-color: #ecfdf5;
        color: #047857;
        border: 1px solid #6ee7b7;
    }

    .status-waiting {
        background-color: #e0f2fe;
        color: #0369a1;
        border: 1px solid #bae6fd;
    }

    .status-pending {
        background-color: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .status-rejected {
        background-color: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    /* Status Legend Bar */
    .lr-legend-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 10px 14px;
        margin-bottom: 16px;
        box-shadow: 0 1px 3px rgba(16, 24, 40, .05);
    }

    .lr-legend-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #4b5563;
        background: #f9fafb;
        border: 1px solid #eef0f2;
        border-radius: 20px;
        padding: 4px 10px;
    }

        .lr-legend-item .fa-circle {
            font-size: 9px;
        }

    /* Grid card shell */
    .lr-grid-card {
        background: #fff;
        border-radius: 10px;
        padding: 4px;
        box-shadow: 0 1px 3px rgba(16, 24, 40, .06), 0 1px 2px rgba(16, 24, 40, .04);
    }

        .lr-grid-card .k-grid {
            border-radius: 8px;
            border-color: #eef0f2;
        }

        .lr-grid-card .k-grid-header {
            background-color: #f8fafc;
        }

            .lr-grid-card .k-grid-header th.k-header {
                font-weight: 700;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: .3px;
                color: #4b5563;
            }

        .lr-grid-card .k-grid-toolbar {
            background: #fff;
            border-bottom: 1px solid #eef0f2;
            padding: 10px 12px;
        }

            .lr-grid-card .k-grid-toolbar .k-button {
                border-radius: 6px;
                font-weight: 600;
                background-color: #2563eb;
                border-color: #2563eb;
                color: #fff;
                padding: 6px 14px;
            }

                .lr-grid-card .k-grid-toolbar .k-button:hover {
                    background-color: #1d4ed8;
                    border-color: #1d4ed8;
                }

        .lr-grid-card .k-grid-content tr:hover {
            background-color: #f5f8ff;
        }

        .lr-grid-card .k-grid-content .k-button {
            border-radius: 6px;
            font-weight: 600;
        }

        .lr-grid-card .k-pager-wrap {
            background: #f8fafc;
            border-top: 1px solid #eef0f2;
        }

    /* kept as classes (not inline hex) because '#' inside the kendo-tmpl script block below breaks Kendo's template parser */
    .lr-detail-actions {
        padding: 16px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        background: #fafbfc;
    }

    .lr-detail-btn {
        border-radius: 6px;
        font-weight: 600;
    }
</style>
<style>
    .lr-modal-container {
        padding: 14px 18px 18px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    /* Mobile-first: one full-width row per section; fields inside a row auto-fit into columns
       as space allows (container-based, not viewport-breakpoint based like Bootstrap's col-md-4). */
    .lr-section-card {
        background: #fff;
        border: 1px solid #eef0f2;
        border-radius: 10px;
        padding: 16px 18px;
        margin-bottom: 16px;
    }

        .lr-section-card:last-child {
            margin-bottom: 0;
        }

    .lr-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
        color: #374151;
        border-bottom: 2px solid #eef0f2;
        padding-bottom: 10px;
        margin-bottom: 16px;
    }

        .lr-section-title .lr-section-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: #eff6ff;
            color: #2563eb;
            font-size: 12px;
        }

    .lr-field-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px 20px;
    }

        .lr-field-grid.lr-cols-3 {
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        }

        .lr-field-grid .lr-span-all {
            grid-column: 1 / -1;
        }

    .lr-form-group {
        margin-bottom: 0;
    }

        .lr-form-group label {
            font-size: 12px;
            font-weight: 600;
            color: #374151;
            margin-bottom: 4px;
            display: block;
        }

        .lr-form-group .form-control,
        .lr-form-group input.k-textbox,
        .lr-form-group .k-dropdown,
        .lr-form-group .k-picker-wrap {
            border-radius: 6px !important;
        }

    .lr-subordinate-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 12px;
    }

        .lr-subordinate-toggle label {
            margin: 0;
            font-size: 13px;
            font-weight: 600;
            color: #1e40af;
            cursor: pointer;
        }

    .eth-input-group {
        display: flex;
        align-items: center;
    }

        .eth-input-group input {
            border-top-right-radius: 0 !important;
            border-bottom-right-radius: 0 !important;
            cursor: pointer;
            background-color: #fff !important;
        }

        .eth-input-group .input-group-addon {
            background-color: #eff6ff;
            border: 1px solid #d1d5db;
            border-left: 0;
            border-top-right-radius: 6px;
            border-bottom-right-radius: 6px;
            padding: 6px 12px;
            cursor: pointer;
            transition: background-color .15s ease-in-out;
        }

            .eth-input-group .input-group-addon:hover {
                background-color: #dbeafe;
            }

    .lr-balance-card {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 14px;
    }

        .lr-balance-card.lr-cols-3 {
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        }
</style>

<div class="lr-page">
    <div class="lr-page-header">
        <legend>@Resources.NavigatorLeave_LeaveRequest</legend>
    </div>

    <!-- Status Legend Bar -->
    <div class="lr-legend-bar">
        <span class="lr-legend-item"><i class="fa fa-circle" style="color:#059669;"></i> Final Approved</span>
        <span class="lr-legend-item"><i class="fa fa-circle" style="color:#10b981;"></i> Department Approved</span>
        <span class="lr-legend-item"><i class="fa fa-circle" style="color:#0284c7;"></i> Waiting for Approval</span>
        <span class="lr-legend-item"><i class="fa fa-circle" style="color:#d97706;"></i> Pending</span>
        <span class="lr-legend-item"><i class="fa fa-circle" style="color:#dc2626;"></i> Rejected</span>
    </div>

    <div class="lr-grid-card">
        @(Html.Kendo().Grid<LeaveRequest>()
                    .Name("LeaveRequestgrid")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.LeaveRequestId).Title("#").Width(70);
                        columns.Bound(c => c.EmployeeCode).Title("Code").Width(110);
                        columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").Title("Employee").Width(160);
                        columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Title("Branch").Width(120);
            //columns.ForeignKey(c => c.or, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").Title("Department").Width(140);
            columns.Bound(c => c.Type).Title("Type").Width(110);
                        columns.Bound(c => c.Day).Title("Day").Width(90);

                        if (useEthiopian)
                        {
                            columns.Bound(c => c.FromAmharic).Title("From (Eth)").Width(100);
                            columns.Bound(c => c.ToAmharic).Title("To (Eth)").Width(100);
                        }
                        else
                        {
                            columns.Bound(c => c.From).Format("{0:dd/MM/yyyy}").Title("From").Width(100);
                            columns.Bound(c => c.To).Format("{0:dd/MM/yyyy}").Title("To").Width(100);
                        }

                        columns.Bound(c => c.LeaveDays).Title("Days").Width(80);
                        columns.Bound(c => c.Status).Title("Status").ClientTemplate(
                            "# if (IsApproved) { #" +
                                "<span class='lr-status-pill status-approved'>Approved</span>" +
                            "# } else if (Status === 'DEPARTMENT_APPROVAL') { #" +
                                "<span class='lr-status-pill status-dept'>Dept Approved</span>" +
                            "# } else if (IsSendForApproval || Status === 'WAITING_FOR_APPROVAL') { #" +
                                "<span class='lr-status-pill status-waiting'>Waiting</span>" +
                            "# } else if (IsRejected) { #" +
                                "<span class='lr-status-pill status-rejected'>Rejected</span>" +
                            "# } else { #" +
                                "<span class='lr-status-pill status-pending'>Pending</span>" +
                            "# } #"
                        ).Width(120);

                        columns.Bound(c => c.Reason).Title("Reason").Width(140);

                        columns.Command(command =>
                        {
                            command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                            command.Destroy().Text(Resources.ActionButton_Cancel);
                        }).Width(200);
                    })
                    .ToolBar(toolbar => toolbar.Create().Text(Resources.ActionButton_AddNewRecord))
                    .Editable(editable => editable.Mode(GridEditMode.PopUp)
                        .TemplateName("LeaveRequest")
                        .Window(window =>
                        {
                            window.Title(Resources.NavigatorPlacment_EmployeePlacment);
                            window.Scrollable(false);
                            window.Events(ev => ev.Open("centerKendoWindow"));
                        })
                    )
                    .Scrollable(h => h.Height("auto"))
                    .Sortable()
                    .Filterable()
                    .Pageable(p => p.Refresh(true).PageSizes(new[] { 10, 20, 50 }))
                    .Events(e =>
                    {
                        e.Edit("onGridPopupEdit");
                        e.DetailExpand("onDetailExpandUser");
                        e.DataBound("onDataBound");
                    })
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Sort(s => s.Add(x => x.LeaveRequestId).Descending())
                        .Model(m => m.Id(p => p.LeaveRequestId))
                        .Read(r => r.Action("LeaveRequestPersonal_Read", "LeaveRequestPersonal").Data("sendForgery"))
                        .Create(c => c.Action("LeaveRequestPersonal_Create", "LeaveRequestPersonal").Data("sendForgery"))
                        .Update(u => u.Action("LeaveRequestPersonal_Update", "LeaveRequestPersonal").Data("sendForgery"))
                        .Destroy(d => d.Action("LeaveRequestPersonal_Destroy", "LeaveRequestPersonal").Data("sendForgery"))
                        .Events(e => e.Error("onGridError"))
                    )
                    .ClientDetailTemplateId("template")
        )
    </div>
</div>

<!-- Master Detail Strip -->
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabstrip_#=LeaveRequestId#")
            .SelectedIndex(0)
            .Items(items =>
            {
                items.Add().Text("Actions & Print").Content(
                    @<text>
                        <div class="lr-detail-actions">
                            # if (!IsSendForApproval && !IsApproved){ #
                            <button class="btn btn-sm btn-primary lr-detail-btn" onclick="sendForApproval('#=LeaveRequestId#')">
                                <i class="fa fa-paper-plane"></i> Send for Approval
                            </button>
                            # } #
                            <a href="@Url.Action("LeaveRequestLetter", "PrintableLetter")/?id=#=LeaveRequestId#" target="_blank" class="btn btn-sm btn-default lr-detail-btn">
                                <i class="fa fa-print"></i> Print Letter
                            </a>
                        </div>
                    </text>);


            }).ToClientTemplate())
</script>

<script type="text/javascript">
    function centerKendoWindow(e) {
        var win = e.sender;
        var screenWidth = $(window).width();

        if (screenWidth < 768) {
            win.setOptions({
                width: "95%",
                maxHeight: "92vh"
            });
        } else if (screenWidth < 1100) {
            win.setOptions({
                width: "740px",
                maxHeight: "90vh"
            });
        } else {
            win.setOptions({
                width: "850px",
                maxHeight: "88vh"
            });
        }
        win.center();
    }



</script>
<script>


    // --- Ethiopic Popup Picker Integration ---
    function triggerEthDate(elem, targetField) {
        if (typeof SelectDate === "function") {
            SelectDate(elem);
            // Poll for value change when user selects a date from the calendar popup
            var input = document.getElementById(targetField);
            var prevVal = input ? input.value : "";
            var interval = setInterval(function () {
                if (input && input.value !== prevVal) {
                    clearInterval(interval);
                    GetTotalBalance();
                }
            }, 300);
        }
    }

    function onGridPopupEdit(e) {
        // Toggle time pickers on edit load
        GetRequestedAmount();
        GetTotalBalance();
    }

    // Surface validation/server errors instead of failing silently (e.g. invalid Ethiopian date conversion)
    function onGridError(e) {
        if (e.errors) {
            var message = "";
            $.each(e.errors, function (key, value) {
                if (value.errors) {
                    message += value.errors.join("\n") + "\n";
                }
            });
            alert(message || "An error occurred while saving the leave request.");
        } else if (e.xhr && e.xhr.responseText) {
            alert("An unexpected error occurred while saving the leave request.");
        }
    }

    // --- Subordinate Request Toggle ---
    function SetEmployee(e) {
        var isChecked = e.checked;
        var dropDown = $("#EmployeeId").data("kendoDropDownList");

        if (isChecked) {
            dropDown.enable(true);
            $("#LeaveBalance").val(0).trigger("change");
        } else {
            dropDown.value(0);
            dropDown.enable(false);
        }

        $.ajax({
            url: '@Url.Action("SetEmployee", "LeaveRequestPersonal")',
            type: 'POST',
            data: { isForOther: isChecked },
            success: function (result) {
                if (isChecked && result === 0) {
                    e.checked = false;
                    dropDown.value(0);
                    dropDown.enable(false);
                    alert("You cannot request for other employees: No subordinates found under your supervision.");
                }
            }
        });
    }

    // --- Dynamic Balance Calculation (Ethiopic & General) ---
    function GetTotalBalance() {
        var employee = $("#EmployeeId").data("kendoDropDownList");
        var empId = employee ? employee.value() : 0;
        var morningOrAfternoonDDL = $("#MorningOrAfternoon").data("kendoDropDownList");
        var morningOrAfternoon = morningOrAfternoonDDL ? morningOrAfternoonDDL.value() : 0;

        var fromAm = $("#FromAmharic").val();
        var toAm = $("#ToAmharic").val();
        var from = $("#From").val();
        var to = $("#To").val();

        $.ajax({
            url: '@Url.Action("GetTotalLeaveAmount", "LeaveRequestPersonal")',
            type: 'POST',
            data: {
                empId: empId,
                from: from,
                to: to,
                fromAm: fromAm,
                toAm: toAm,
                morningOrAfternoon: morningOrAfternoon
            },
            success: function (result) {
                if (!result) return;
                var parts = result.split('-');
                $("#LeaveBalance").val(parts[0] || "0").trigger("change");
                $("#ExactDeserveLeaveDays").val(parts[1] || "0").trigger("change");
                $("#LeaveDays").val(parts[2] || "0").trigger("change");
            }
        });
    }

    function GetTotalBalanceGord() {
        var employee = $("#EmployeeId").data("kendoDropDownList");
        var empId = employee ? employee.value() : 0;
        var morningOrAfternoonDDL = $("#MorningOrAfternoon").data("kendoDropDownList");
        var morningOrAfternoon = morningOrAfternoonDDL ? morningOrAfternoonDDL.value() : 0;

        var from = $("#From").val();
        var to = $("#To").val();

        $.ajax({
            url: '@Url.Action("GetTotalLeaveAmountGorg", "LeaveRequestPersonal")',
            type: 'POST',
            data: { empId: empId, from: from, to: to, morningOrAfternoon: morningOrAfternoon },
            success: function (result) {
                if (!result) return;
                var parts = result.split('-');
                $("#LeaveBalance").val(parts[0] || "0").trigger("change");
                $("#ExactDeserveLeaveDays").val(parts[1] || "0").trigger("change");
                $("#LeaveDays").val(parts[2] || "0").trigger("change");
            }
        });
    }

    function GetRequestedAmount() {
        var dayDDL = $("#Day").data("kendoDropDownList");
        var half = dayDDL ? dayDDL.value() : 0;

        // Show/hide time pickers if partial day is selected
        if (half == 1) {
            $(".showTime").show();
        } else {
            $(".showTime").hide();
        }

        GetTotalBalance();
    }

   function sendForApproval(id) {
        // Prevent sending unsaved or new grid rows (ID 0 or empty)
        if (!id || id <= 0 || id === "0" || id === "#=LeaveRequestId#") {
            alert("Please save the leave request before sending it for approval.");
            return;
        }

        if (!confirm("Are you sure you want to send this leave request for approval?")) return;

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "LeaveRequestPersonal", new { area = "HRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                $("#LeaveRequestgrid").data("kendoGrid").dataSource.read();
            }
        });
    }

    var masterId = 0;

    function onDetailExpandUser(e)
    {
            var masterRow = e.masterRow;
            var masterGrid = $("#LeaveRequestgrid").data("kendoGrid");
            var masterDataItem = masterGrid.dataItem(masterRow);
            masterId = masterDataItem.LeaveRequestId;
            var gridName = "#RequestesStatusgrid_" + masterId;
            $.ajax({
                url: '@Url.Action("CheckStatus", "LeaveRequestStatus")',
                data: { masterId: masterId },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    if (r == "true") {
                        $(gridName).find(".k-toolbar").hide(); //hide toolbar
                        $(".k-grid-top", gridName).hide();
                    }
                    else if (r == "approved") {
                        $(gridName).find(".k-toolbar").hide(); //hide toolbar
                        $(".k-grid-top", gridName).hide();
                        $(".k-grid-edit", gridName).hide();
                        $(".k-grid-delete", gridName).hide();
                    }
                    else if (r == "Dapproved") {
                        $(gridName).find(".k-toolbar").hide(); //hide toolbar
                        $(".k-grid-top", gridName).hide();
                        $(".k-grid-edit", gridName).hide();
                        $(".k-grid-delete", gridName).hide();
                    }
                    else {
                        $(gridName).find(".k-toolbar").show(); //hide toolbar
                        $(".k-grid-top", gridName).show();
                        $(".k-grid-edit", gridName).show();
                        $(".k-grid-delete", gridName).hide();
                    }

                }

            });


    }
    function onDataBound(e)
    {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (model.IsApproved === true) {

                $(this).css("background-color", "darkgrey");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            else if (model.Status === "DEPARTMENT_APPROVAL" && !model.IsApproved) {
                $(this).css("background-color", "limegreen");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            else if (model.IsPending === true) {

                $(this).css("background-color", "Orange");
                $(this).find(".k-grid-edit").show();
                $(this).find(".k-grid-delete").show();
            }
            else if (model.IsRejected === true) {

                $(this).css("background-color", "LightGray");
                $(this).find(".k-grid-edit").show();
                $(this).find(".k-grid-delete").show();
            }
            else if (model.IsSendForApproval === true) {

                $(this).css("background-color", "lightblue");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            else if (model.IsWaiting === true || model.Status == "WAITING_FOR_APPROVAL") {

                $(this).css("background-color", "lightblue");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }

        });
    }
</script>


