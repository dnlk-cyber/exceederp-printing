@helper documentAttachment()
{
    @(Html.Kendo().Grid<LeaveRequestAttachement>()
                .Name("LeaveRequestAttachementGrid#=LeaveRequestId#")
                .Columns(columns =>
                {
                    columns.Bound(c => c.FileName).ClientTemplate("<a href='/HRM/LeaveRequestAttachements/DownloadAttachment?attachmentId=\\#=LeaveRequestAttachementId\\#'> <i class='fa fa-download'></i> \\#=FileName\\# </a>").Width(150);
                    columns.Bound(c => c.Description).Width(120);
                    columns.Template(e => { }).ClientTemplate("<a href='\\#=ShortPath\\#/\\#=FileName\\#' target='_blank'><i class='fa fa-folder-open'></i> Open</a>").Width(90);
                    columns.Command(command => command.Destroy().Text("Delete")).Width(100);
                })
                .ToolBar(toolbar =>
                {
                    toolbar.Template(@<text>
                        @Html.Kendo().Upload().Name("file").Async(a => a.Save("LeaveRequestAttachements_Create", "LeaveRequestAttachements", new { area = "HRM", id = "#=LeaveRequestId#" })).Events(e => e.Complete("onUploadSuccess").Select("function(e) { globalOnSelect(e, ['.jpg', '.png', '.pdf'], 50 * 1024 * 1024); }").Error("onUploadError")).ShowFileList(false).ToClientTemplate()
                    </text>);
                            })
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Model(model => model.Id(p => p.LeaveRequestAttachementId))
                                .Read(read => read.Action("LeaveRequestAttachements_Read", "LeaveRequestAttachements", new { id = "#=LeaveRequestId#" }).Data("sendForgery"))
                                .Destroy(destroy => destroy.Action("LeaveRequestAttachements_Destroy", "LeaveRequestAttachements").Data("sendForgery"))
                            ).ToClientTemplate())
}

<script>
    var masterId = 0;

    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;
        var masterGrid = $("#LeaveRequestgrid").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.LeaveRequestId;
    }

    function onUploadSuccess(e) {
        $("#LeaveRequestAttachementGrid" + masterId).data("kendoGrid").dataSource.read();
    }

    function valueMapper(options) {
        $.ajax({
            url: "/HRM/HRMDataProvider/Employee_ValueMapper/",
            data: { value: options.value || 0, status: 1, excludeId: -1 },
            success: function (data) {
                options.success(data);
            }
        });
    }

    function SetEmployee(e) {
        var isChecked = e.checked;
        var dropDown = $("#EmployeeId").data("kendoDropDownList");

        if (isChecked) {
            dropDown.enable(true);
            $("#LeaveBalance").val(0).trigger("change");
        } else {
            dropDown.value(0);
            dropDown.enable(false);
        }

        $.ajax({
            url: '@Url.Action("SetEmployee", "LeaveRequestPersonal")',
            type: 'POST',
            data: { isForOther: isChecked },
            success: function (result) {
                if (isChecked && result === 0) {
                    e.checked = false;
                    dropDown.value(0);
                    dropDown.enable(false);
                    alert("You cannot request for other employees!\nNo subordinates under your position.");
                }
            }
        });
    }

    function onEdit(e) {
        GetTotalBalance();
        GetRequestedAmount();
    }

    function GetDate() {
        $("#FromAmharic").trigger("change");
        $("#ToAmharic").trigger("change");
    }

    function GetTotalBalance() {
        var employee = $("#EmployeeId").data("kendoDropDownList");
        var empId = employee ? employee.value() : 0;
        var morningOrAfternoonDDL = $("#MorningOrAfternoon").data("kendoDropDownList");
        var morningOrAfternoon = morningOrAfternoonDDL ? morningOrAfternoonDDL.value() : 0;
        var fromAm = $("#FromAmharic").val();
        var toAm = $("#ToAmharic").val();
        var from = $("#From").val();
        var to = $("#To").val();

        $.ajax({
            url: '@Url.Action("GetTotalLeaveAmount", "LeaveRequestPersonal")',
            type: 'POST',
            data: { empId: empId, from: from, to: to, fromAm: fromAm, toAm: toAm, morningOrAfternoon: morningOrAfternoon },
            cache: false,
            success: function (result) {
                if (!result) return;
                var parts = result.split('-');
                $("#LeaveBalance").val(parts[0] || "0").trigger("change");
                $("#ExactDeserveLeaveDays").val(parts[1] || "0").trigger("change");
                $("#LeaveDays").val(parts[2] || "0").trigger("change");
            }
        });
    }

    function GetTotalBalanceGord() {
        var employee = $("#EmployeeId").data("kendoDropDownList");
        var empId = employee ? employee.value() : 0;
        var morningOrAfternoonDDL = $("#MorningOrAfternoon").data("kendoDropDownList");
        var morningOrAfternoon = morningOrAfternoonDDL ? morningOrAfternoonDDL.value() : 0;
        var from = $("#From").val();
        var to = $("#To").val();

        $.ajax({
            url: '@Url.Action("GetTotalLeaveAmountGorg", "LeaveRequestPersonal")',
            type: 'POST',
            data: { empId: empId, from: from, to: to, morningOrAfternoon: morningOrAfternoon },
            cache: false,
            success: function (result) {
                if (!result) return;
                var parts = result.split('-');
                $("#LeaveBalance").val(parts[0] || "0").trigger("change");
                $("#ExactDeserveLeaveDays").val(parts[1] || "0").trigger("change");
                $("#LeaveDays").val(parts[2] || "0").trigger("change");
            }
        });
    }

    function GetRequestedAmount() {
        var dayT = $("#Day").data("kendoDropDownList");
        var half = dayT ? dayT.value() : 0;

        // Toggle time pickers for Half Day (1)
        if (half == 1) {
            $(".showTime").show();
            $(".showTime2").show();
        } else {
            $(".showTime").hide();
            $(".showTime2").hide();
        }

        var leaveDaysInput = $("#LeaveDays");

        // 👈 If Mixed (2) is selected, enable manual input for Requested Leave Days
        if (half == 2) {
            leaveDaysInput.removeAttr("readonly").prop("disabled", false).css({
                "background": "#ffffff",
                "color": "#1f2937",
                "cursor": "text"
            });
        } else {
            // Otherwise, keep it disabled/read-only for Full Day (0) and Half Day (1)
            leaveDaysInput.attr("readonly", "readonly").prop("disabled", true).css({
                "background": "#fef2f2",
                "color": "#dc2626",
                "cursor": "not-allowed"
            });

            // Only fetch via AJAX automatically if it's NOT mixed
            GetTotalBalance();
        }
    }

    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var model = grid.dataItem(this);
            var $row = $(this);

            // Remove any previously attached status classes
            $row.removeClass("row-approved row-dept-approved row-waiting row-pending row-rejected");

            if (model.IsApproved === true) {
                $row.addClass("row-approved");
                $row.find(".k-grid-edit, .k-grid-delete").remove();
            }
            else if (model.Status === "DEPARTMENT_APPROVAL" && !model.IsApproved) {
                $row.addClass("row-dept-approved");
                $row.find(".k-grid-edit, .k-grid-delete").remove();
            }
            else if (model.IsSendForApproval === true || model.Status === "WAITING_FOR_APPROVAL") {
                $row.addClass("row-waiting");
                $row.find(".k-grid-edit, .k-grid-delete").remove();
            }
            else if (model.IsRejected === true) {
                $row.addClass("row-rejected");
            }
            else if (model.IsPending === true || (!model.IsApproved && !model.IsSendForApproval)) {
                $row.addClass("row-pending");
            }
        });
    }

    function onRequestesStatusDataBound() {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var model = grid.dataItem(this);
            if (model.Status >= 0 && model.Status <= 4) {
                $(this).css("background-color", "#f3f4f6");
            }
        });
    }

    function sendForApproval(id) {
        if (!confirm("Are you sure you want to send this leave request for approval?")) return;

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "LeaveRequestPersonal", new { area = "HRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                $("#LeaveRequestgrid").data("kendoGrid").dataSource.read();
            }
        });
    }
</script>

