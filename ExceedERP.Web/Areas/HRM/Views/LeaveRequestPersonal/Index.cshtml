@(Html.Kendo().Grid<LeaveRequest>()
    .Name("LeaveRequestgrid")
    .Columns(columns =>
    {
        columns.Bound(c => c.LeaveRequestId).Title("#").Width(80);
        columns.Bound(c => c.IsApproved).Visible(false);
        columns.Bound(c => c.EmployeeCode).Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
        columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
        columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
        columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
        columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["jobTitle"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
        columns.Bound(c => c.Type).EditorTemplateName("LeaveType").Width(100);
        columns.Bound(c => c.Day).Width(80);
        columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Width(80);
        if (useEthiopian)
        {
            columns.Bound(c => c.FromAmharic).Width(100);
            columns.Bound(c => c.ToAmharic).Width(100);
        }
        else
        {
            columns.Bound(c => c.From).Width(100);
            columns.Bound(c => c.To).Width(100);
        }


        columns.Bound(c => c.LeaveBalance).Width(110);
        columns.Bound(c => c.LeaveDays).Width(100);
        columns.Bound(c => c.Status).Width(100);
        columns.Bound(c => c.Reason).Width(150);
        columns.Bound(c => c.Type).Width(100);
        columns.Bound(c => c.LeaveActionTypes).Width(100).Visible(false);
        columns.Command(command =>
        {
            command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
            command.Destroy().Text(Resources.ActionButton_Cancel);

        }).Width(250);




    })
            .ToolBar(toolbar =>
            {

                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
            })

            .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("LeaveRequest").Window(window => { window.Title(Resources.NavigatorLeave_LeaveRequest); window.Scrollable(false); }))
            .Scrollable(h => h.Height(500))
            .Groupable()
            .Sortable(sortable =>
            {
                sortable.SortMode(GridSortMode.SingleColumn);

            })
            .Filterable()
            .Events(e =>
            {
                e.DetailExpand("onDetailExpandUser");
                e.DataBound("onDataBound");
                e.Edit("onEdit");


            })
            .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
            .DataSource(dataSource => dataSource
                .Ajax()
                .Sort(sort => sort.Add("LeaveRequestId").Descending())
                .Events(events =>
                {
                    events.Error("error_handler(\"LeaveRequestgrid\")");
                    events.RequestStart("onRequestStart(\"LeaveRequestgrid\")");
                    events.RequestEnd("onRequestEnd(\"LeaveRequestgrid\")");

                })

                .Model(model => {
                    model.Id(p => p.LeaveRequestId);
                    model.Field(p => p.LeaveRequestId).Editable(false);
                })
                .Read(read => read.Action("LeaveRequestPersonal_Read", "LeaveRequestPersonal").Data("sendForgery"))
                .Create(create => create.Action("LeaveRequestPersonal_Create", "LeaveRequestPersonal").Data("sendForgery"))
                .Update(update => update.Action("LeaveRequestPersonal_Update", "LeaveRequestPersonal").Data("sendForgery"))
                .Destroy(destroy => destroy.Action("LeaveRequestPersonal_Destroy", "LeaveRequestPersonal").Data("sendForgery"))
                ).ClientDetailTemplateId("template")
)


