@helper documentAttachment()
{ 
     @(Html.Kendo().Grid<LeaveRequestAttachement>()
            .Name("LeaveRequestAttachementGrid#=LeaveRequestId#")
            .Columns(columns =>
            {
                columns.Bound(c => c.FileName).ClientTemplate("<a href='/HRM/LeaveRequestAttachements/DownloadAttachment?attachmentId=\\#=LeaveRequestAttachementId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; \\#=FileName\\# </a>").Width(150);
                columns.Bound(c => c.Description).Width(100);

                columns.Template(e => { }).ClientTemplate("<a href='/HRM/LeaveRequestAttachements/DownloadAttachment?attachmentId=\\#=LeaveRequestAttachementId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; Download </a>").Width(100);
                columns.Template(e => { }).ClientTemplate("<a href='\\#=ShortPath\\#/\\#=FileName\\#' target='_blank'> <f class = 'fa fa-folder-open'></i> &nbsp;&nbsp; Open</a>").Width(100);

                columns.Command(command =>
                {
                    command.Destroy().Text("Delete");
                }).Width(300);

            })
            .ToolBar(toolbar =>
            {
            toolbar.Template(@<text>
                @Html.Kendo().Upload().Name("file").Async(a => a.Save("LeaveRequestAttachements_Create", "LeaveRequestAttachements", new {area="HRM", id = "#=LeaveRequestId#" })).Events(e => e.Complete("onUploadSuccess")
                                                                                                            .Select("function(e) { globalOnSelect(e, ['.jpg', '.png', '.pdf'], 50 * 1024 * 1024); }")
                                                                .Error("onUploadError")).ShowFileList(false).ToClientTemplate()
            </text>);
            })

            .Scrollable(h => h.Height("auto"))
            .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events =>
            {
                events.Error("error_handler(\"LeaveRequestAttachementGrid#=LeaveRequestId#\")");
                events.RequestStart("onRequestStart(\"LeaveRequestAttachementGrid#=LeaveRequestId#\")");
                events.RequestEnd("onRequestEnd(\"LeaveRequestAttachementGrid#=LeaveRequestId#\")");

            })
            .Model(model => model.Id(p => p.LeaveRequestAttachementId))
            .Read(read => read.Action("LeaveRequestAttachements_Read", "LeaveRequestAttachements", new { id = "#=LeaveRequestId#" }).Data("sendForgery"))
            .Create(create => create.Action("LeaveRequestAttachements_Create", "LeaveRequestAttachements", new { id = "#=LeaveRequestId#" }).Data("sendForgery"))
            .Update(update => update.Action("LeaveRequestAttachements_Update", "LeaveRequestAttachements").Data("sendForgery"))
            .Destroy(destroy => destroy.Action("LeaveRequestAttachements_Destroy", "LeaveRequestAttachements").Data("sendForgery"))
            ).ToClientTemplate())
}

