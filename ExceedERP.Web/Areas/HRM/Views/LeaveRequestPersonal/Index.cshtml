        function GetExactDerevedLeavedays()
        {

                //$("#LeaveBalance").val(0);
                var employee = $("#EmployeeId").data("kendoDropDownList");
                var empId = employee.value();
                var from = $('#FromAmharic').val();
                var to = $('#ToAmharic').val();
                if (empId.length !== 0 )
                {

                    $.ajax({
                        url: '@Url.Action("GetDservedExactLeaveAmount", "LeaveRequestPersonal")',

                        data: { empId: empId, from: from, to: to },
                        type: 'POST',
                        cache: false,
                        success: function (result) {
                            var s = result.split('-');;

