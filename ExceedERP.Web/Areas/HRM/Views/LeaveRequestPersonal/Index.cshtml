@using System.Collections
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.LeaveManagment
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? false;
}

<style type="text/css">
    /* Force Kendo popup container to full width to prevent column wrapping */
    div.k-edit-form-container {
        width: 100% !important;
        max-width: 1120px !important;
        padding: 15px 25px !important;
    }

    .k-window {
        max-width: 95vw !important;
    }

    .lr-status-pill {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-approved {
        background-color: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }

    .status-dept {
        background-color: #ecfdf5;
        color: #047857;
        border: 1px solid #6ee7b7;
    }

    .status-waiting {
        background-color: #e0f2fe;
        color: #0369a1;
        border: 1px solid #bae6fd;
    }

    .status-pending {
        background-color: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .status-rejected {
        background-color: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
    /* Base Row Colors */
    .row-approved {
        background-color: #e5e7eb !important;
    }

    .row-dept-approved {
        background-color: #d1fae5 !important;
    }

    .row-waiting {
        background-color: #e0f2fe !important;
    }

    .row-pending {
        background-color: #fef3c7 !important;
    }

    .row-rejected {
        background-color: #fee2e2 !important;
    }

    /* Dynamic Hover States based on Status Legend */
    .k-grid tbody tr.row-approved:hover,
    .k-grid tbody tr.row-approved.k-state-hover {
        background-color: #cbd5e1 !important; /* Darker Slate Gray */
        cursor: pointer;
    }

    .k-grid tbody tr.row-dept-approved:hover,
    .k-grid tbody tr.row-dept-approved.k-state-hover {
        background-color: #a7f3d0 !important; /* Darker Mint/Green */
        cursor: pointer;
    }

    .k-grid tbody tr.row-waiting:hover,
    .k-grid tbody tr.row-waiting.k-state-hover {
        background-color: #bae6fd !important; /* Darker Sky Blue */
        cursor: pointer;
    }

    .k-grid tbody tr.row-pending:hover,
    .k-grid tbody tr.row-pending.k-state-hover {
        background-color: #fde68a !important; /* Darker Amber/Orange */
        cursor: pointer;
    }

    .k-grid tbody tr.row-rejected:hover,
    .k-grid tbody tr.row-rejected.k-state-hover {
        background-color: #fecaca !important; /* Darker Soft Red */
        cursor: pointer;
    }
</style>

<legend>@Resources.NavigatorLeave_LeaveRequest</legend>

<!-- Status Legend -->
<div class="well well-sm" style="background: #fff; border-radius: 4px; margin-bottom: 12px; padding: 8px 15px;">
    <span class="fa fa-circle" style="color: #6b7280;"></span> Final Approved &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #10b981;"></span> Department Approved &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #0284c7;"></span> Waiting for Approval &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #f59e0b;"></span> Pending &nbsp;&nbsp;
    <span class="fa fa-circle" style="color: #ef4444;"></span> Rejected
</div>

@(Html.Kendo().Grid<LeaveRequest>()
        .Name("LeaveRequestgrid")
        .Columns(columns =>
        {
            columns.Bound(c => c.LeaveRequestId).Title("#").Width(70);
            columns.Bound(c => c.IsApproved).Visible(false);
            columns.Bound(c => c.EmployeeCode).Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
            columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Width(160).Filterable(ftb => ftb.Multi(true).Search(true));
            columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(110);
            columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
            columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["jobTitle"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
            columns.Bound(c => c.Type).EditorTemplateName("LeaveType").Width(100);
            columns.Bound(c => c.Day).Width(80);
            columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Width(80);

            if (useEthiopian)
            {
                columns.Bound(c => c.FromAmharic).Width(100);
                columns.Bound(c => c.ToAmharic).Width(100);
            }
            else
            {
                columns.Bound(c => c.From).Format("{0:dd/MM/yyyy}").Width(100);
                columns.Bound(c => c.To).Format("{0:dd/MM/yyyy}").Width(100);
            }

            columns.Bound(c => c.LeaveBalance).Title("Balance").Width(90);
            columns.Bound(c => c.LeaveDays).Title("Days").Width(80);
            columns.Bound(c => c.Status).Width(110);
            columns.Bound(c => c.Reason).Width(140);
            columns.Bound(c => c.LeaveActionTypes).Width(100).Visible(false);
            columns.Bound(c => c.IsOnlineApproved).ClientTemplate(
                "<input type='checkbox' disabled='true' value='#=IsOnlineApproved#' " +
                "# if (IsOnlineApproved) { #" + "checked='checked'" + "# } #" + "/>").Width(100);
            columns.Bound(c => c.IsVoid).ClientTemplate(
                "<input type='checkbox' disabled='true' value='#=IsVoid#' " +
                "# if (IsVoid) { #" + "checked='checked'" + "# } #" + "/>").Width(90);

            columns.Command(command =>
            {
                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                command.Destroy().Text(Resources.ActionButton_Cancel);
            }).Width(180);
        })
        .ToolBar(toolbar =>
        {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
        })
        .Editable(editable => editable.Mode(GridEditMode.PopUp)
            .TemplateName("LeaveRequest")
            .Window(window =>
            {
                window.Title(Resources.NavigatorLeave_LeaveRequest);
                window.Width(1150); // Exact width to fit all 3 columns in one row
    window.Scrollable(false);
            }))
        .Scrollable(h => h.Height(500))
        .Sortable(sortable => sortable.SortMode(GridSortMode.SingleColumn))
        .Filterable()
        .Events(e =>
        {
            e.DetailExpand("onDetailExpandUser");
            e.DataBound("onDataBound");
            e.Edit("onEdit");
            e.Save("GetDate");
        })
        .Pageable(pageable => pageable
            .Input(true)
            .Numeric(false)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Sort(sort => sort.Add("LeaveRequestId").Descending())
            .Events(events =>
            {
                events.Error("error_handler(\"LeaveRequestgrid\")");
                events.RequestStart("onRequestStart(\"LeaveRequestgrid\")");
                events.RequestEnd("onRequestEnd(\"LeaveRequestgrid\")");
            })
            .Model(model =>
            {
                model.Id(p => p.LeaveRequestId);
                model.Field(p => p.LeaveRequestId).Editable(false);
            })
            .Read(read => read.Action("LeaveRequestPersonal_Read", "LeaveRequestPersonal").Data("sendForgery"))
            .Create(create => create.Action("LeaveRequestPersonal_Create", "LeaveRequestPersonal").Data("sendForgery"))
            .Update(update => update.Action("LeaveRequestPersonal_Update", "LeaveRequestPersonal").Data("sendForgery"))
            .Destroy(destroy => destroy.Action("LeaveRequestPersonal_Destroy", "LeaveRequestPersonal").Data("sendForgery"))
        )
        .ClientDetailTemplateId("template")
)

<!-- Master-Detail Template -->
