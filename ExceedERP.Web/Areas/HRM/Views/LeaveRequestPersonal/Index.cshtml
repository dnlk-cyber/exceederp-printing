<script>
    function GetRequestedAmount() {

        $("#LeaveDays").val(0);
        $("#ExactDeserveLeaveDays").val(0);
        var employee = $("#EmployeeId").data("kendoDropDownList");
        var empId = employee.value();
        var morningOrAfternoon = $("#MorningOrAfternoon").data("kendoDropDownList").value(); // 👈 FIXED
        var fromAm = $('#FromAmharic').val();
        var toAm = $('#ToAmharic').val();
        var from = $("#From").val();
        var to = $("#To").val();
        var dayT = $("#Day").data("kendoDropDownList");
        var half = dayT.value();
        if (half == 1) {
            var showField = document.querySelector('.showTime');
            var showField1 = document.querySelector('.showTime2');
            showField.style.display = 'block';
            showField1.style.display = 'block';
        }
        else {
            var showField = document.querySelector('.showTime');
            showField.style.display = 'none';
            var showField1 = document.querySelector('.showTime2');
            showField1.style.display = 'none';
        }
        var hour = $('#Hours').val();


            $.ajax({
                url: '@Url.Action("GetLeaveDaysToPulate", "LeaveRequestPersonal")',

                data: { empId: empId, from: from, to: to, fromAm: fromAm, toAm: toAm, half: half, hour: hour, morningOrAfternoon: morningOrAfternoon  },
                type: 'POST',
                cache: false,
                success: function (result) {
                    var s = result.split('-');
                    $("#LeaveDays").val(s[0]);
                    $("#ExactDeserveLeaveDays").val(s[1]);
                    $("#LeaveDays").trigger("change");
                    $("#ExactDeserveLeaveDays").trigger("change");

                }

            });

    }

</script>

