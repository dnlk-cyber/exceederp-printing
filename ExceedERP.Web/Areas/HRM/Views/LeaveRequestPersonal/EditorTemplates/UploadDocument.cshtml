@using ExceedERP.Core.Localization
@using (Html.BeginForm("UploadDocument", "LeaveRequestPersonal", FormMethod.Post,
    new { enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
<fieldset>
    <input type="hidden" name="leaveRequestId" id="leaveRequestId">
    <div class="editor-field">
        @Html.TextBox("file", "", new { type = "file", accept = ".xlsx,.xls,image/*,.doc, .docx,.ppt, .pptx,.txt,.pdf", onchange = "validateDocFileType()" })
    </div>
    <br />
    <div class="editor-field">
        @Html.TextBox("txtValue", null, new { placeholder = Resources.Common_Attachment_FileName })
    </div>
    <br />
    <div class="editor-field">
        <input id="uploadBut" type="submit" value="@Resources.HR_ActionButton_Upload" />
    </div>

</fieldset>
}
