@using System.Collections
@using ExceedERP.Helpers.Common
@using Kendo.Mvc.UI
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.SelfCare.LeaveRequest

@{
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? false;
}


<div class="lr-modal-container">
    <!-- Row 1: Requester & Leave Setup -->
    <div class="lr-section-card">
        <div class="lr-section-title"><span class="lr-section-icon"><i class="fa fa-user"></i></span> Requester Profile</div>

        <div class="lr-field-grid lr-cols-3">
            <div class="lr-subordinate-toggle lr-span-all">
                @Html.CheckBoxFor(m => m.IsForOther, new { onchange = "SetEmployee(this)" })
                <label for="IsForOther">Request For Subordinate</label>
            </div>

            <div class="lr-form-group">
                @Html.LabelFor(model => model.EmployeeId, "Target Employee")
                @(Html.Kendo().DropDownListFor(model => model.EmployeeId)
                            .DataValueField("PersonId")
                            .DataTextField("FullName")
                            .Events(e => e.Change("GetTotalBalance"))
                            .OptionLabel(Resources.Select)
                            .Filter("contains")
                            .MinLength(2)
                            .HtmlAttributes(new { style = "width:100%" })
                            .DataSource(source => source.Read(read => read.Action("GetEmployeesAskForOther", "HRMDataProvider")).ServerFiltering(false))
                            .Enable(false)
                            .ValuePrimitive(true)
                            .Height(300)
                )
                @Html.ValidationMessageFor(model => model.EmployeeId, "", new { @class = "text-danger small" })
            </div>

            <div class="lr-form-group">
                @Html.LabelFor(model => model.Type, "Leave Category")
                @(Html.EnumDropDownListFor(m => m.Type, new { @class = "form-control input-sm", style = "width:100%" }))
                @Html.ValidationMessageFor(model => model.Type, "", new { @class = "text-danger small" })
            </div>

            <div class="lr-form-group">
                @Html.LabelFor(model => model.LeaveActionTypes, "Plan Mode")
                @(Html.EnumDropDownListFor(m => m.LeaveActionTypes, new { @class = "form-control input-sm", style = "width:100%" }))
                @Html.ValidationMessageFor(model => model.LeaveActionTypes, "", new { @class = "text-danger small" })
            </div>
        </div>
    </div>

    <!-- Row 2: Date & Duration Pickers -->
    <div class="lr-section-card">
        <div class="lr-section-title"><span class="lr-section-icon"><i class="fa fa-calendar"></i></span> Schedule & Range</div>

        <div class="lr-field-grid lr-cols-3">
            @if (useEthiopian)
            {
                <div class="lr-form-group">
                    @Html.LabelFor(model => model.FromAmharic, "From Date (Ethiopic)")
                    <div class="input-group eth-input-group">
                        @Html.TextBoxFor(model => model.FromAmharic, new { @class = "form-control input-sm et-popup-picker", @readonly = "readonly", placeholder = "DD/MM/YYYY" })
                        <span class="input-group-addon" onclick="triggerEthDate(this, 'FromAmharic')">
                            <i class="fa fa-calendar text-primary"></i>
                        </span>
                    </div>
                    @Html.ValidationMessageFor(model => model.FromAmharic, "", new { @class = "text-danger small" })
                </div>

                <div class="lr-form-group">
                    @Html.LabelFor(model => model.ToAmharic, "To Date (Ethiopic)")
                    <div class="input-group eth-input-group">
                        @Html.TextBoxFor(model => model.ToAmharic, new { @class = "form-control input-sm et-popup-picker", @readonly = "readonly", placeholder = "DD/MM/YYYY" })
                        <span class="input-group-addon" onclick="triggerEthDate(this, 'ToAmharic')">
                            <i class="fa fa-calendar text-primary"></i>
                        </span>
                    </div>
                    @Html.ValidationMessageFor(model => model.ToAmharic, "", new { @class = "text-danger small" })
                </div>
            }
            else
            {
                <div class="lr-form-group">
                    @Html.LabelFor(model => model.From, "From Date")
                    @(Html.Kendo().DatePickerFor(model => model.From)
                                .Name("From")
                                .Events(e => e.Change("GetTotalBalanceGord"))
                                .HtmlAttributes(new { style = "width:100%" }))
                    @Html.ValidationMessageFor(model => model.From, "", new { @class = "text-danger small" })
                </div>

                <div class="lr-form-group">
                    @Html.LabelFor(model => model.To, "To Date")
                    @(Html.Kendo().DatePickerFor(model => model.To)
                                .Name("To")
                                .Events(e => e.Change("GetTotalBalanceGord"))
                                .HtmlAttributes(new { style = "width:100%" }))
                    @Html.ValidationMessageFor(model => model.To, "", new { @class = "text-danger small" })
                </div>
            }

            <div class="lr-form-group">
                @Html.LabelFor(model => model.Day, "Day Type")
                @(Html.Kendo().DropDownListFor(model => model.Day)
                            .ValuePrimitive(true)
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .Events(e => e.Change("GetRequestedAmount"))
                            .BindTo(EnumExtension.EnumToSelectList(typeof(LeaveDay)))
                            .HtmlAttributes(new { style = "width:100%" })
                )
            </div>

            <div class="lr-form-group">
                @Html.LabelFor(model => model.MorningOrAfternoon, "Shift / Segment")
                @(Html.Kendo().DropDownListFor(model => model.MorningOrAfternoon)
                            .ValuePrimitive(true)
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .Events(e => e.Change("GetRequestedAmount"))
                            .BindTo(EnumExtension.EnumToSelectList(typeof(MorningOrAfternoon)))
                            .HtmlAttributes(new { style = "width:100%" })
                )
            </div>

            <div class="lr-field-grid lr-cols-3 lr-span-all showTime" style="display:none">
                <div class="lr-form-group">
                    <label>From Time</label>
                    @(Html.Kendo().TimePickerFor(model => model.FromTime).HtmlAttributes(new { style = "width:100%" }))
                </div>
                <div class="lr-form-group">
                    <label>To Time</label>
                    @(Html.Kendo().TimePickerFor(model => model.ToTime).HtmlAttributes(new { style = "width:100%" }))
                </div>
            </div>
        </div>
    </div>

    <!-- Row 3: Balance Overview & Remarks -->
    <div class="lr-section-card">
        <div class="lr-section-title"><span class="lr-section-icon"><i class="fa fa-calculator"></i></span> Calculations & Notes</div>

        <div class="lr-field-grid lr-cols-3">
            <div class="lr-balance-card lr-cols-3 lr-span-all">
                <div class="lr-form-group">
                    <label class="text-muted small">TOTAL ACCUMULATED BALANCE</label>
                    @(Html.Kendo().TextBoxFor(model => model.LeaveBalance).Enable(false).HtmlAttributes(new { @class = "form-control fw-bold text-primary", style = "background:#eef2ff;" }))
                </div>

                <div class="lr-form-group">
                    <label class="text-muted small">EARNED / DESERVED DAYS</label>
                    @(Html.Kendo().TextBoxFor(model => model.ExactDeserveLeaveDays).Enable(false).HtmlAttributes(new { @class = "form-control fw-bold text-success", style = "background:#ecfdf5;" }))
                </div>

                <div class="lr-form-group">
                    <label class="text-muted small">TOTAL APPLIED DAYS</label>
                    @(Html.Kendo().TextBoxFor(model => model.LeaveDays).Enable(false).HtmlAttributes(new { @class = "form-control fw-bold text-danger", style = "background:#fff1f2;" }))
                </div>
            </div>

            <div class="lr-form-group">
                @Html.LabelFor(model => model.Reason, "Reason for Leave")
                @Html.Kendo().TextBoxFor(model => model.Reason).HtmlAttributes(new { style = "width:100%", placeholder = "Enter reason..." })
            </div>

            <div class="lr-form-group">
                @Html.LabelFor(model => model.Remark, "Additional Remarks")
                @Html.Kendo().TextBoxFor(model => model.Remark).HtmlAttributes(new { style = "width:100%", placeholder = "Optional remarks..." })
            </div>
        </div>
    </div>
</div>