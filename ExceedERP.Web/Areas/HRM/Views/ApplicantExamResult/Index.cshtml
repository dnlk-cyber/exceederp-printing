@using System.Collections
@using ExceedERP.Core.Domain.HRM.RecruitmentManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.Navigator_Recruitment_ApplicantExamResult</Legend>
@(Html.Kendo().Grid<ApplicantRegistration>()
                          .Name("ApplicantRegistrationgrid")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.VacancyId).Width(120);
                              columns.Bound(c => c.ApplicantName).Width(200);
                              columns.Bound(c => c.Age).Width(150);
                              columns.Bound(c => c.Sex).Width(150);
                              columns.Bound(c => c.TotalResult).Width(150);
                              columns.Command(command =>
                              {
                                 // command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  //command.Destroy();
                              }).Width(180);
                          })
                          .ToolBar(toolbar =>
                          {
                            //  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ApplicantRegistration").Window(window =>
                          //{
                          //    window.Title("Applicant Registration Form");
                          //    window.Scrollable(false);
                          //}))

                          .Groupable()
                                .HtmlAttributes(new { style = "height: 550px;" })
                               .Groupable()
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                               .Filterable()
                              .Scrollable()
                                  //.Events(x => x.DataBinding("CheckGrid"))
                          .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                            .ClientDetailTemplateId("AddressTemplate")
                          .DataSource(dataSource => dataSource
                              .Ajax()
                                   .Events(events =>
                                                                                                  {
                                                                                                      events.Error("error_handler(\"ApplicantRegistrationgrid\")");
                                                                                                      events.RequestStart("onRequestStart(\"ApplicantRegistrationgrid\")");
                                                                                                      events.RequestEnd("onRequestEnd(\"ApplicantRegistrationgrid\")");
                                                                                                  }
                                                                                                  )
                                    
                              .Model(model => model.Id(p => p.ApplicantRegistrationId))
                                  .Read(read => read.Action("ApplicantRegistration_Read", "ApplicantRegistration", new { id = "Screen" }))
                              .Create(create => create.Action("ApplicantRegistration_Create", "ApplicantRegistration"))
                              .Update(update => update.Action("ApplicantRegistration_Update", "ApplicantRegistration"))
                              .Destroy(destroy => destroy.Action("ApplicantRegistration_Destroy", "ApplicantRegistration"))
                              ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                            .Name("tabstrip_#=ApplicantRegistrationId#")
    .SelectedIndex(0)
    .Items(items =>
     {


         items.Add().Text(Resources.HR_Recruitment_ApplicantScreeningResult).Content(
            @<text>
                @* <legend>Screening Result</legend>*@
                @(Html.Kendo().Grid<ApplicantScreeningResult>()
                      .Name("ApplicantScreeningResultgrid_#=ApplicantRegistrationId#")
      .Columns(columns =>
      {
          columns.Bound(c => c.Criteria).Width(120);
          columns.Bound(c => c.SettingValue).Width(120);
          columns.Bound(c => c.CurrentResult).Width(150);
          columns.Bound(c => c.Remark).Width(120);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);  }).Width(200);
      })
      .ToolBar(toolbar =>
      {
         // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
                                               .Events(events =>
                                                                                                          {
                                                                                                              events.Error("error_handler(\"ApplicantScreeningResultgrid_#=ApplicantRegistrationId#\")");
                                                                                                              events.RequestStart("onRequestStart(\"ApplicantScreeningResultgrid_#=ApplicantRegistrationId#\")");
                                                                                                              events.RequestEnd("onRequestEnd(\"ApplicantScreeningResultgrid_#=ApplicantRegistrationId#\")");
                                                                                                          }
                                                                                                          )
          .Model(model =>
          {
              model.Id(p => p.ScreeningResultId);
              model.Field(p => p.Criteria).Editable(false);
              model.Field(p => p.SettingValue).Editable(false);
          })
                  .Read(read => read.Action("ApplicantScreeningResult_Read", "ApplicantScreeningResult", new { id = "#=ApplicantRegistrationId#" }))
                  .Create(create => create.Action("ApplicantScreeningResult_Create", "ApplicantScreeningResult", new { id = "#=ApplicantRegistrationId#" }))
          .Update(update => update.Action("ApplicantScreeningResult_Update", "ApplicantScreeningResult"))
          .Destroy(destroy => destroy.Action("ApplicantScreeningResult_Destroy", "ApplicantScreeningResult"))
      ).ToClientTemplate()
                )


            </text>
    );


         items.Add().Text(Resources.Navigator_Recruitment_ApplicantExamResult).Content(
            @<text>
                @*<legend>Exam Result</legend>*@
               @(Html.Kendo().Grid<ApplicantExamResult>()
                      .Name("ApplicantExamResultgrid_#=ApplicantRegistrationId#")
      .Columns(columns =>
      {
         // columns.Bound(c => c.ApplicantRegistrationId);
          columns.Bound(c => c.Criteria).Width( 120);
          columns.Bound(c => c.SettingValue).Width( 120);
          columns.Bound(c => c.CurrentResult).Width( 120);
        //  columns.Bound(c => c.Total).Width( 120);
         // columns.Bound(c => c.Rank).Width( 120);
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          //toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
                                            .Events(events =>
                                                                                                                  {
                                                                                                                      events.Error("error_handler(\"ApplicantExamResultgrid_#=ApplicantRegistrationId#\")");
                                                                                                                      events.RequestStart("onRequestStart(\"ApplicantExamResultgrid_#=ApplicantRegistrationId#\")");
                                                                                                                      events.RequestEnd("onRequestEnd(\"ApplicantExamResultgrid_#=ApplicantRegistrationId#\")");
                                                                                                                  }
                                                                                                                  )
                  .Model(model =>
                  {
                      model.Id(p => p.ApplicantResultId);
            model.Field(p => p.Criteria).Editable( false );
              model.Field(p => p.SettingValue).Editable(false);})
                  .Read(read => read.Action("ApplicantExamResult_Read", "ApplicantExamResult", new { id = "#=ApplicantRegistrationId#" }))
                  .Create(create => create.Action("ApplicantExamResult_Create", "ApplicantExamResult", new { id = "#=ApplicantRegistrationId#" }))
          .Update(update => update.Action("ApplicantExamResult_Update", "ApplicantExamResult"))
          .Destroy(destroy => destroy.Action("ApplicantExamResult_Destroy", "ApplicantExamResult"))
      ).ToClientTemplate() 
            )
            </text>
    );

        



     }).ToClientTemplate())
</script>

