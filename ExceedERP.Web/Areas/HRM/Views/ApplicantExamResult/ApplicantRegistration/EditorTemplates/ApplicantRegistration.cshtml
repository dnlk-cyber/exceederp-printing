@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Helpers.Common
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.RecruitmentManagment.ApplicantRegistration 


<form>

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.VacancyId, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">
                @(Html.Kendo().DropDownListFor(model => model.VacancyId)
                                   .ValuePrimitive(true)
                          .OptionLabel(Resources.Select)
                                                  .DataTextField("Name")
                                                                .DataValueField("VaccancyCode")
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetVacancy", "HRMDataProvider", new { area = "HRM" }))
                              .ServerFiltering(false);
                      })
                )
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.LookupId, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">
                @(Html.Kendo().DropDownListFor(model => model.LookupId)
                                   .ValuePrimitive(true)
                          .OptionLabel(Resources.Select)
                                          .CascadeFrom("VacancyCode")
                                           .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetJobTitle", "ApplicantRegistration")
                                                .Data("filterCategories");
                                            })
                                            .ServerFiltering(true);
                                        })
                                                          .DataTextField("Description")
                                                        .DataValueField("LookupId")
                      .DataSource(dataSource =>
                      {
                          dataSource.Read(read => read.Action("GetJobTitleSelected", "HRMDataProvider", new { area = "HRM" }))
                              .ServerFiltering(false);
                      })
                )
                @Html.ValidationMessageFor(model => model.LookupId, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.ApplicantName, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.ApplicantName)
                @Html.ValidationMessageFor(model => model.ApplicantName, "", new { @class = "text-danger" })
            </div>
        </div>

      
       


    </div>


<br/>


<div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.Age, htmlAttributes: new { @class = "control-label col-md-8" })

        </div>
        <div class="form-group">

            @Html.Kendo().TextBoxFor(model => model.Age)
            @Html.ValidationMessageFor(model => model.Age, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.Sex, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">
            @(Html.EnumDropDownListFor(m => m.Sex, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style="width: 140px"   })
               )
            
            @Html.ValidationMessageFor(model => model.Sex, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.RegistrationDateAm, htmlAttributes: new { @class = "control-label col-md-8" })

        </div>
        <div class="form-group">



            @Html.TextBoxFor(model => model.RegistrationDateAm, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />
            @Html.ValidationMessageFor(model => model.RegistrationDateAm, "", new { @class = "text-danger" })

        </div>
    </div>
   
   
   



</div>
<br/>

    <div class="row">
    <div class="col-md-1">

    </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.RegistrationPalce, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div class="form-group">



                @Html.Kendo().TextBoxFor(model => model.RegistrationPalce)
                @Html.ValidationMessageFor(model => model.RegistrationPalce, "", new { @class = "text-danger" })

            </div>
        </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.RegisterBy, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">

            @(Html.Kendo().TextBoxFor(model => model.RegisterBy)
                            .Enable (false))
            @Html.ValidationMessageFor(model => model.RegisterBy, "", new { @class = "text-danger" })
        </div>
    </div>
    </div>


</form>
