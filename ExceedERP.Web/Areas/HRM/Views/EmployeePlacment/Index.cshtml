@using System.Collections
@using System.Security.AccessControl
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPlacment_EmployeePlacment</legend>

@(Html.Kendo().Grid<Placement>()
       .Name("PlacementGrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeListEnglish"], "PersonId", "FullNameEng").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
          columns.Bound(c => c.JobTitleName).Filterable(ftb => ftb.Multi(true).Search(true)).Width(140);
          columns.Bound(c => c.IsHead).Width(90).ClientTemplate(
            "<input type='checkbox' disabled = 'true' value='#= IsHead#' " +
            "# if (IsHead) { #" +
            "checked='checked'" +
            "# } #" +
            "/>"
            );
          columns.Bound(c => c.AssignmentDateAmharic).Width(200);
          columns.ForeignKey(c => c.RankId, (IEnumerable)ViewData["RankList"], "RankId", "RankName").EditorTemplateName("Rank").Width(100);
          columns.ForeignKey(c => c.StepId, (IEnumerable)ViewData["StepList"], "StepId", "StepName").EditorTemplateName("Step").Width(100);
          columns.Bound(c => c.Salary).Width(100);
          columns.Bound(c => c.AssignmentType).Width (150);
          columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(80);
          // columns.ForeignKey(c => c.JobTitleCode, (IEnumerable)ViewData["jobTitle"], "OrgStructureId", "Name").EditorTemplateName("JobTitles").Width(130);
          // columns.ForeignKey(c => c.ReportsTo, (IEnumerable)ViewData["jobTitle"], "OrgStructureId", "Name").EditorTemplateName("JobTitles").Width(200);
          // columns.Bound(c => c.ResponsibilityLevel);
          // columns.Bound(c => c.Remark);
          columns.Command(command =>
          {
              //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          if (HttpContext.Current.User.IsInRole("HR_Admin"))
          {
              toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
              toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
          }
          toolbar.Custom().Text(Resources.ActionButton_Refersh);
      })
      .Excel(excel => excel
                        .FileName(Resources.NavigatorPlacment_EmployeePlacment + ".xlsx")
                        .Filterable(true)
                            .AllPages(true)           
                            .ProxyURL(Url.Action("Excel_Export_Save", "EmployeePlacment")) )
                            .Pdf(pdf => pdf
                            .AllPages()
                            .FileName(Resources.NavigatorPlacment_EmployeePlacment + ".pdf")
                            .ProxyURL(Url.Action("Pdf_Export_Save", "EmployeePlacment")))
         .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Placement").Window(window => { window.Title(Resources.NavigatorPlacment_EmployeePlacment); window.Scrollable(false); }))
         .Scrollable(h => h.Height(500))
         .Groupable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
                        .Events(e =>
                        {
                            e.Save("GetDate");
                            e.Edit("GetDate");
                        })
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

          .DataSource(dataSource => dataSource
          .Ajax()
               .Sort(sort => sort.Add("EmployeeCode"))
               .Events(events =>
               {
                   events.Error("error_handler(\"PlacementGrid\")");
                   events.RequestStart("onRequestStart(\"PlacementGrid\")");
                   events.RequestEnd("onRequestEnd(\"PlacementGrid\")");
               })

                  .Model(model => model.Id(p => p.PlacementId))
                  .Read(read => read.Action("Placements_Read", "EmployeePlacment").Data("sendForgery"))
                          .Create(create => create.Action("Placements_Create", "EmployeePlacment").Data("sendForgery"))
                  .Update(update => update.Action("Placements_Update", "EmployeePlacment").Data("sendForgery"))
                  .Destroy(destroy => destroy.Action("Placements_Destroy", "EmployeePlacment").Data("sendForgery"))

      )
)
<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
