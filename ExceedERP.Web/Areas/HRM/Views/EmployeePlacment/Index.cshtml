<script>
    function GetSalary() {
        $("#Salary").val(0);
        var Ranks = $("#RankId").data("kendoDropDownList");
        var rank = Ranks.value();
        var Steps = $("#StepId").data("kendoDropDownList");
        var step = Steps.value();
        var Titles = $("#LookupId").data("kendoDropDownList");
        var title = Titles.value();

        if (rank !== 0 && step !== 0 && title!==0)
        {

        $.ajax({
            url: '@Url.Action("GetSalaryAmount", "EmployeePlacment")',

            data: { rank: rank, step: step, title: title },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

                $("#Salary").val(r);
            }

        });

        
    }
    }

</script>


<script>
    function GetDepartment() {

        $("#Salary").val(0);
        $("#RankName").val("");
        $("#StepName").val("");
        var Titles = $("#OrgStructureId").data("kendoDropDownList");
        var OrgId = Titles.value();
        var jobs = $("#LookupId").data("kendoDropDownList");
        var title = jobs.value();
        $.ajax({
            url: '@Url.Action("GetDepartment", "EmployeePlacment")',

            data: { OrgId: OrgId, title: title },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                var s = r.split(/-/);

                $("#Salary").val(s[0]);
                $("#RankName").val(s[1]);
                $("#StepName").val(s[2]);
            }

        });
    }

</script>
