@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.NavigatorPayroll_Loan</Legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.Payroll.Loan>()
      .Name("Loangrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullName").EditorTemplateName("ListOfEmployee").Width(200).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["PeriodList"], "GLPeriodId", "Name").EditorTemplateName("GLPeriodSelector").Width(120);
          columns.Bound(c => c.LoanAmount).Width (110);
          columns.Bound(c => c.Months).Width (100);
          columns.Bound(c => c.MonthlyAmount).Width(120);
          columns.Bound(c => c.Balance ).Width (100);
          columns.Bound(c => c.Description).Visible(false);
          columns.Bound(c => c.JumpHoliday).ClientTemplate("<input type='checkbox'  disabled='true' value='#=JumpHoliday #' " + " # if (JumpHoliday) { #" + "checked='checked'" + "# } #" + " />").Width(130);
          columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsActive #' " + " # if (IsActive) { #" + "checked='checked'" + "# } #" + " />").Width(130);
          columns.Bound(c => c.Remark).Width(100);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
          toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });

      })
              .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Loan").Window(window => { window.Title(Resources.NavigatorPayroll_Loan); window.Scrollable(false); }))
               .Excel(excel => excel
          .FileName(Resources.NavigatorPayroll_Loan + ".xlsx")
          .Filterable(true)
          .AllPages(true)
          .ProxyURL(Url.Action("Excel_Export_Save", "Loan"))
      )
      .Pdf(pdf => pdf
          .AllPages()
          .FileName(Resources.NavigatorPayroll_Loan + ".pdf")
          .ProxyURL(Url.Action("Pdf_Export_Save", "Loan"))
      )
          .Scrollable(h => h.Height(500))

                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
           .Sort(sort => sort.Add("LoanId").Descending())
               .Events(events =>
               {
                   events.Error("error_handler(\"Loangrid\")");
                   events.RequestStart("onRequestStart(\"Loangrid\")");
                   events.RequestEnd("onRequestEnd(\"Loangrid\")");
               })

          .Model(model =>
          {
              model.Id(p => p.LoanId);
              model.Field(p => p.MonthlyAmount).Editable(false);
              model.Field(p => p.Balance).Editable(false);
          })
          .Read(read => read.Action("Loans_Read", "Loan").Data("sendForgery"))
          .Create(create => create.Action("Loans_Create", "Loan").Data("sendForgery"))
          .Update(update => update.Action("Loans_Update", "Loan").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("Loans_Destroy", "Loan").Data("sendForgery"))
      )
)
