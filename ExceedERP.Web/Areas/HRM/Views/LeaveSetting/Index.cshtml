@using System.Collections
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.NavigatorLeave_LeaveSetting</Legend>
@(Html.Kendo().Grid<Configuration>()
          .Name("LeaveSettinggrid")
          .Columns(columns =>
          {
              //columns.Bound(c => c.Reference);

              columns.ForeignKey(c => c.Attribute, (IEnumerable)ViewData["LeaveSetting"], "Text", "Text").EditorTemplateName("Setting");
              columns.Bound(c => c.CurrentValue);
              // columns.Bound(c => c.PreviousValue);
              // columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["FiscalYeaer"], "GlFiscalYearId", "Name").EditorTemplateName("FiscalYear");
              columns.Bound(c => c.Remark);
              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);              
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(250))
                // .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
                  .Events(events =>
                  {
                      events.Error("error_handler(\"LeaveSettinggrid\")");
                      events.RequestStart("onRequestStart(\"LeaveSettinggrid\")");
                      events.RequestEnd("onRequestEnd(\"LeaveSettinggrid\")");
                  })

              .Model(model => model.Id(p => p.ConfigurationId))
              .Read(read => read.Action("Configurations_Read", "LeaveSetting"))
              .Create(create => create.Action("Configurations_Create", "LeaveSetting"))
              .Update(update => update.Action("Configurations_Update", "LeaveSetting"))
              .Destroy(destroy => destroy.Action("Configurations_Destroy", "LeaveSetting"))
          )
)
<br/>

<div class="row">
    <div class="col-md-6 col-sm-6 col-lg-6">

        <legend>@Resources.Leave_new_declaration_start_year</legend>

        @(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.LeaveManagment.LeaveNewAwajStartYear>()
          .Name("LeaveNewAwajStartYearGrid")
          .Columns(columns =>
          {
              columns.ForeignKey(c => c.GlFisicalYearId, (IEnumerable)ViewData["FisicalYear"], "GlFiscalYearId", "Name").EditorTemplateName("FiscalYear");
          

              columns.Command(command =>
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  command.Destroy().HtmlAttributes(new { id="deleteButtonId"});
              });
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().HtmlAttributes(new { id = "toolBarId" });
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
           .Filterable()

         //.Pageable(pageable => pageable
         //      .Input(true)
         //      .Numeric(false)
         //      .Refresh(true)
         //      .PageSizes(true)
         //      .ButtonCount(5))
         .Scrollable(h => h.Height("auto"))
          .DataSource(dataSource => dataSource
              .Ajax()
               .Events(events =>
               {
                   events.Error("error_handler(\"LeaveNewAwajStartYearGrid\")");
                   events.RequestStart("onRequestStart(\"LeaveNewAwajStartYearGrid\")");
                   events.RequestEnd("onRequestEnd(\"LeaveNewAwajStartYearGrid\")");
               })
              .Model(model => model.Id(p => p.LeaveNewAwajStartYearId))
              .Read(read => read.Action("LeaveNewAwajStartYears_Read", "LeaveNewAwajStartYears"))
              .Create(create => create.Action("LeaveNewAwajStartYears_Create", "LeaveNewAwajStartYears"))
              .Update(update => update.Action("LeaveNewAwajStartYears_Update", "LeaveNewAwajStartYears"))
              .Destroy(destroy => destroy.Action("LeaveNewAwajStartYears_Destroy", "LeaveNewAwajStartYears"))
          )
        )




    </div>

    <div class="col-md-6 col-sm-6 col-lg-6">

        <legend>@Resources.Leave_entitle_start_date</legend>

        @(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.LeaveManagment.LeaveEntitleStartingDate>()
          .Name("LeaveEntitleStartingDateGrid")
          .Columns(columns =>
          {
              columns.Bound(c => c.Start).EditorTemplateName("Enum");
              columns.Bound(c => c.Remark);

              columns.Command(command =>
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  // command.Destroy();
              });
          })
          .ToolBar(toolbar =>
          {
              // toolbar.Create();
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
           .Filterable()
          //.Pageable(pageable => pageable
          //      .Input(true)
          //      .Numeric(false)
          //      .Refresh(true)
          //      .PageSizes(true)
          //      .ButtonCount(5))
          .Scrollable(h=>h.Height("auto"))
          .DataSource(dataSource => dataSource
              .Ajax()
               .Events(events =>
               {
                   events.Error("error_handler(\"LeaveEntitleStartingDateGrid\")");
                   events.RequestStart("onRequestStart(\"LeaveEntitleStartingDateGrid\")");
                   events.RequestEnd("onRequestEnd(\"LeaveEntitleStartingDateGrid\")");
               })
              .Model(model => model.Id(p => p.LeaveEntitleStartingDateId))
              .Read(read => read.Action("LeaveEntitleStartingDate_Read", "LeaveEntitleStartingDate"))
          .Create(create => create.Action("LeaveEntitleStartingDate_Create", "LeaveEntitleStartingDate"))
          .Update(update => update.Action("LeaveEntitleStartingDate_Update", "LeaveEntitleStartingDate"))
          .Destroy(destroy => destroy.Action("LeaveEntitleStartingDate_Destroy", "LeaveEntitleStartingDate"))
          )
        )


    </div>

</div>



<script>

    function sync_handler(e) {
        this.read();

    }

    document.addEventListener('DOMContentLoaded', function () {

         $.ajax({
                url: '@Url.Action("CheckNewAwajDataIfExists", "LeaveSetting")',
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;

                    if (r.Message == "OK")
                    {
                        $("#deleteButtonId").hide();
                        $("#toolBarId").hide();

                        $("#LeaveNewAwajStartYearGrid").find(".k-toolbar").hide(); //hide toolbar
                        $(".k-grid-top", "#LeaveNewAwajStartYearGrid").hide();
                    }
                   
                }

            });

    }, false);
</script>

