@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.Payroll
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.NavigatorPayroll_RegularContribution</Legend>
@(Html.Kendo().Grid<RegularContribution>()
          .Name("RegularContributiongrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("PayrollListOfEmployee").Width(260).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(c => c.ContributionTypeId, (IEnumerable)ViewData["Contribution"], "ContributionTypeId", "Description").EditorTemplateName("ContributionType").Width(150);
          columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["PeriodList"], "GLPeriodId", "Name").EditorTemplateName("GLPeriod").Width(150);
          columns.Bound(c => c.Amount).Width(200);
          columns.Bound(c => c.NetGross).Width( 150);
          columns.Bound(c => c.AdditionalAmount).Width( 150);
          columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsActive #' " + " # if (IsActive) { #" + "checked='checked'" + "# } #" + " />").Width(120);
          columns.Bound(c => c.ApplyToAll).ClientTemplate("<input type='checkbox'  disabled='true' value='#=ApplyToAll #' " + " # if (ApplyToAll) { #" + "checked='checked'" + "# } #" + " />").Width(120);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
          toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Excel(excel => excel
          .FileName(Resources.NavigatorPayroll_RegularContribution + ".xlsx")
          .Filterable(true)
          .AllPages(true)
          .ProxyURL(Url.Action("Excel_Export_Save", "RegularContribution"))
      )
      .Pdf(pdf => pdf
          .AllPages()
          .FileName(Resources.NavigatorPayroll_RegularContribution + ".pdf")
          .ProxyURL(Url.Action("Pdf_Export_Save", "RegularContribution"))
      )
      .Selectable(selectable => {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
         .Scrollable(h => h.Height(500))
                 
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
              .Events(events =>
              {
                  events.Error("error_handler(\"RegularContributiongrid\")");
                  events.RequestStart("onRequestStart(\"RegularContributiongrid\")");
                  events.RequestEnd("onRequestEnd(\"RegularContributiongrid\")");
              })

          .Model(model => model.Id(p => p.RegContributionId))
          .Read(read => read.Action("RegularContributions_Read", "RegularContribution"))
          .Create(create => create.Action("RegularContributions_Create", "RegularContribution"))
          .Update(update => update.Action("RegularContributions_Update", "RegularContribution"))
          .Destroy(destroy => destroy.Action("RegularContributions_Destroy", "RegularContribution"))
      )
)
<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }

    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0, 0, 0, .2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>
