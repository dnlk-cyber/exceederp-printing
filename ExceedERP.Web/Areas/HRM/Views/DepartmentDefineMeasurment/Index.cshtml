@using System.Collections
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Department Level Criteria</legend>
@(Html.Kendo().Grid<MeasurementDefinition>()
              .Name("DepartmentDefineMeasurmentgrid")
          .Columns(columns =>
          {
              columns.Bound(c => c.EvaluationCriteria);
              columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["EvaluationTypes"], "LookupId", "Description").EditorTemplateName("EvaluationTypes");
              columns.Bound(c => c.Role).EditorTemplateName("Enum");
              columns.Bound(c => c.DefnPercentageofWeight);
              columns.Bound(c => c.Remark);
              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
               .Scrollable(h => h.Height(500))
                     .Groupable()
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                  .Filterable()
                     .Pageable(pageable => pageable
                          .Input(true)
                          .Numeric(false)
                          .Refresh(true)
                          .PageSizes(true)
                          .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
                   .Events(events =>
                   {
                       events.Error("error_handler(\"DepartmentDefineMeasurmentgrid\")");
                       events.RequestStart("onRequestStart(\"DepartmentDefineMeasurmentgrid\")");
                       events.RequestEnd("onRequestEnd(\"DepartmentDefineMeasurmentgrid\")");
                   })

              .Model(model => model.Id(p => p.MeasurementDefinitionId))
              .Read(read => read.Action("DepartmentDefineMeasurment_Read", "DepartmentDefineMeasurment"))
              .Create(create => create.Action("DepartmentDefineMeasurment_Create", "DepartmentDefineMeasurment"))
              .Update(update => update.Action("DepartmentDefineMeasurment_Update", "DepartmentDefineMeasurment"))
              .Destroy(destroy => destroy.Action("DepartmentDefineMeasurment_Destroy", "DepartmentDefineMeasurment"))
              ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("tabstrip_#=MeasurementDefinitionId#")
                  .SelectedIndex(0)
                  .Items(items =>
                  {
          //**************************************Identification****************************************************//
          items.Add().Text(Resources.HR_PerformanceManagment_EmployeeMeasurement_MeasurementType).Content(
                        @<text>
                            @* <legend>Measurement</legend>*@
                            @(Html.Kendo().Grid<Measurement>()
                                  .Name("Measurement_#=MeasurementDefinitionId#")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.MeasurementName);
                              columns.Bound(c => c.MesPercentageofWeight);
                              columns.Bound(c => c.Remark);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(180);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                                   .ClientDetailTemplateId("Action")
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Scrollable(h => h.Height(500))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                                   .Events(events =>
                                   {
                                       events.Error("error_handler(\"Measurement_#=MeasurementDefinitionId#\")");
                                       events.RequestStart("onRequestStart(\"Measurement_#=MeasurementDefinitionId#\")");
                                       events.RequestEnd("onRequestEnd(\"Measurement_#=MeasurementDefinitionId#\")");
                                   })
                              .Model(model => model.Id(p => p.MeasurementId))
                              .Read(read => read.Action("DepartmentMeasurment_Read", "DepartmentMeasurment", new { id = "#=MeasurementDefinitionId#" }))
                              .Create(create => create.Action("DepartmentMeasurment_Create", "DepartmentMeasurment", new { id = "#=MeasurementDefinitionId#" }))
                              .Update(update => update.Action("DepartmentMeasurment_Update", "DepartmentMeasurment"))
                              .Destroy(destroy => destroy.Action("DepartmentMeasurment_Destroy", "DepartmentMeasurment"))
                          ).ToClientTemplate()
                            )


                        </text>


                                  );

           

                        }).ToClientTemplate())
</script>

<script id="Action" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                  .Name("tabstrip_#=MeasurementId#")
                  .SelectedIndex(0)
                  .Items(items =>
                  {


                      items.Add().Text(Resources.HR_PerformanceManagment_PerformanceAction_PerformanceAction).Content(
                        @<text>

                            @(Html.Kendo().Grid<PerformanceAction>()
                                                 .Name("PerformanceAction_#=MeasurementId#")
                                         .Columns(columns =>
                                         {
                                                     columns.Bound(c => c.ActionName);
                                                     columns.Bound(c => c.AcPercentageofWeight);

                                                     columns.Bound(c => c.Remark);
                                                     columns.Command(command =>
                                                     {
                                                         command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                                         command.Destroy().Text(Resources.ActionButton_Cancel);
                                                     }).Width(180);
                                                 })
                                         .ToolBar(toolbar =>
                                         {
                                                     toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                                 })
                                         .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                  .Scrollable(h => h.Height(500))
                                         .DataSource(dataSource => dataSource
                                             .Ajax()
                                                .Events(events =>
                                                {
                                                   events.Error("error_handler(\"PerformanceAction_#=MeasurementId#\")");
                                                   events.RequestStart("onRequestStart(\"PerformanceAction_#=MeasurementId#\")");
                                                   events.RequestEnd("onRequestEnd(\"PerformanceAction_#=MeasurementId#\")");
                                                })         
                                             .Model(model => model.Id(p => p.ActionId))
                                                                     .Read(read => read.Action("DepartmentPerformanceAction_Read", "DepartmentPerformanceAction", new { defid = "#=MeasurementDefinitionId#", mesid = "#=MeasurementId#" }))
                                                             .Create(create => create.Action("DepartmentPerformanceAction_Create", "DepartmentPerformanceAction", new { defid = "#=MeasurementDefinitionId#", mesid = "#=MeasurementId#" }))
                                             .Update(update => update.Action("DepartmentPerformanceAction_Update", "DepartmentPerformanceAction"))
                                             .Destroy(destroy => destroy.Action("DepartmentPerformanceAction_Destroy", "DepartmentPerformanceAction"))
                                         ).ToClientTemplate()
                            )


                        </text>
                                  );

                          }).ToClientTemplate())
</script>







