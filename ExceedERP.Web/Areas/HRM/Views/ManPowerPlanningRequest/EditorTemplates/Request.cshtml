@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.SelfCare.ManPowerPlanningRequest 


<div class="form">
    <div class="row fullrow">
        <div class="col-md-3 ro1">
            <div class="form-group">

                <div class="col-md-6">


                    @(Html.CheckBoxFor(m => m.IsNewJobTitle, htmlAttributes: new { @onchange = "GetJobTitle(this)" })

                    )
                    @Html.LabelFor(model => model.IsNewJobTitle, htmlAttributes: new { @class = "control-label col-md-8" })
                    @Html.ValidationMessageFor(model => model.IsNewJobTitle, "", new { @class = "text-danger" })
                </div>

            </div>
            <div class="form-group">


                <div>@Html.LabelFor(model => model.BranchId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.BranchId)
                                          .OptionLabel(Resources.Select)
                                          .Filter("contains")
                                          .MinLength(2)
                                          .DataTextField("Name")
                                          .DataValueField("BranchId")
                                          .DataSource(dataSource =>
                                          {
                                                  // dataSource.Read(read => read.Action("GetDepartmentOfHeads", "HRMDataProvider", new { area = "HRM" }))
                                                  dataSource.Read(read => read.Action("GetBranchFromRecruitmentPlan", "HRMDataProvider"))
                                                  .ServerFiltering(false);
                                          })
                                          .ValuePrimitive(true)

                    )
                    @Html.ValidationMessageFor(model => model.OrgStructureId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
            <div>@Html.LabelFor(model => model.OrgStructureId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
            <div class="col-md-6">
                @(Html.Kendo().DropDownListFor(model => model.OrgStructureId)
                              .OptionLabel(Resources.Select)
                              .Filter("contains")
                              .MinLength(2)
                              .DataTextField("Name")
                              .DataValueField("OrgStructureId")
                              .DataSource(dataSource =>
                              {
                                      // dataSource.Read(read => read.Action("GetDepartmentOfHeads", "HRMDataProvider", new { area = "HRM" }))
                                      dataSource.Read(read => read.Action("GetDepartmentOfHeads", "HRMDataProvider"))
                                      .ServerFiltering(false);
                              })
                              .ValuePrimitive(true)

                )
                @Html.ValidationMessageFor(model => model.OrgStructureId, "", new { @class = "text-danger" })
            </div>
        </div>


            <div class="form-group" id="lookUpJobTitle">
                <div>@Html.LabelFor(model => model.LookupId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(m => m.LookupId)
                                          .DataTextField("Description")
                                          .DataValueField("LookupId")
                                          .OptionLabel(Resources.Select)
                                          //.Filter(FilterType.Contains)
                                          .Filter("contains")
                                          //.MinLength(2)
                                          .DataSource(dataSource =>
                                          {
                                              dataSource.Read(read =>
                                              {
                                                  read.Action("GetJobTitleForManPower", "HRMDataProvider")
                                                      .Data("filterFormanPower");
                                                  })
                                                  .ServerFiltering(false);
                                          }).ValuePrimitive(true)

                                          .Events(e => e.Change("GetNoOfShouldbe"))

                            // .CascadeFrom("OrgStructureId")
                            //.AutoBind(false)
                            // .Enable(false)
                    )
                    @Html.ValidationMessageFor(model => model.LookupId, "", new { @class = "text-danger" })
                </div>

            </div>

            <div class="form-group" id="jobHide" hidden>
                @Html.LabelFor(model => model.JobTitle, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">

                    @(Html.Kendo().TextBoxFor(model => model.JobTitle)
                                          .Enable(true) )
                    @Html.ValidationMessageFor(model => model.JobTitle, "", new { @class = "text-danger" })
                </div>
            </div>

        </div>
        <div class="col-md-3 ro1">         

            <div class="form-group">
                @Html.LabelFor(model => model.EmploymentType, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">

                    @(Html.EnumDropDownListFor(model => model.EmploymentType, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 140px" })

                    )

                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.NoOfShouldBeStaff, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">

                    @(Html.Kendo().TextBoxFor(model => model.NoOfShouldBeStaff)
                                  .Enable(false) )
                    @Html.ValidationMessageFor(model => model.NoOfShouldBeStaff, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.NoOfCurrentStaff, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">

                    @(Html.Kendo().TextBoxFor(model => model.NoOfCurrentStaff)
                                  .Enable(false))
                    @Html.ValidationMessageFor(model => model.NoOfCurrentStaff, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Education, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">

                    @(Html.Kendo().TextBoxFor(model => model.Education))
                    @Html.ValidationMessageFor(model => model.Education, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.NumberOfStaff, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().TextBoxFor(model => model.NumberOfStaff)
                    )
                    @Html.ValidationMessageFor(model => model.ManPowerPlanningRequestId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.GlFiscalYearId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.GlFiscalYearId)
                                          .OptionLabel(Resources.Select)
                                          .Filter("contains")
                                          .MinLength(2)
                                          .DataTextField("Name")
                                          .DataValueField("GlFiscalYearId")
                                          .DataSource(dataSource =>
                                          {
                                              dataSource.Read(read => read.Action("GetFisicalYearForRecruitmentAndManPower", "HRMDataProvider", new { area = "HRM" }))
                                                  .ServerFiltering(false);
                                          })
                                          .ValuePrimitive(true)

                    )
                    @Html.ValidationMessageFor(model => model.GlFiscalYearId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Experience, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().TextBoxFor(model => model.Experience)
                    )
                    @Html.ValidationMessageFor(model => model.Experience, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Reason, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().TextBoxFor(model => model.Reason)
                    )
                    @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
                </div>
            </div>


        </div>
    </div>
    </div>

