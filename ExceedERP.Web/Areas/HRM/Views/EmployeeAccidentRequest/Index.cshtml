@model ExceedERP.Core.Domain.HRM.HealthAndInsurance.EmployeeAccident
@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Employee Accident Request</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.HealthAndInsurance.EmployeeAccident>()
              .Name("grid")
              .Columns(columns =>
              {
                  columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["Name"], "EmployeeId", "FullNameaEnglish").Width(120);
                  columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").Width(120);
                  columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["Workunit"], "OrgStructureId", "Name").Width(120);
                  columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["Jobtitle"], "LookupId", "Description").Width(120);
                  columns.Bound(c => c.Salary).Width(120);
                  columns.Bound(c => c.EmployeementType).Width(120);
                  columns.Bound(c => c.Description).Width(120);
                  columns.Bound(c => c.AccidentDateAmh).EditorTemplateName("Calander").Width(120);
                  //columns.Bound(c => c.AccidentDate).Width(120);
                  columns.Bound(c => c.AccidentTime).Width(120);
                  columns.Bound(c => c.IsAtWorkPlace).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsAtWorkPlace ? checked='checked' :'' # >").Width(120);
                  columns.Bound(c => c.IsOnDuety).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsOnDuety ? checked='checked' :'' # >").Width(120);
                  columns.Bound(c => c.Witness).Width(120);

                  columns.Command(command =>
                  {


                      command.Custom("").Text("Send For Approval").Click("sendforapproval");
                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);

                      command.Destroy().Text(Resources.ActionButton_Cancel);

                  }).Width(300);
              })

                 .ToolBar(toolbar =>
                 {


                 toolbar.Template(@<text>

        @if (HttpContext.Current.User.IsInRole("HR_Department_Head"))
        {

            @item.CreateButton()

        }

        </text>);


                 })
              .Events(ev =>
              {
                  ev.DataBound("onDataBound"); ev.DetailExpand("onDetailExpand");
              })
               .Events(x =>
               {
                   x.Edit("GetDate");
                   x.Save("GetDate");
               })
              .Editable(editable =>
              {
                  editable.Mode(GridEditMode.PopUp).TemplateName("EmployeeAccident");//.Window(x => x.Title("Accident Registration "));
                  editable.DisplayDeleteConfirmation("Are You Sure To Remove Accident");
              })
           .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                             .Scrollable(h => h.Height(500))
      //  .ClientDetailTemplateId("template")
      .DataSource(dataSource => dataSource
          .Ajax()
          .AutoSync(false)
          .ServerOperation(false)
          .Model(model =>
          {
              model.Id(p => p.EmployeeAccidentId);
              //model.Field(p => p.AccidentDateAmh).Editable(false);
              //model.Field(p => p.AccidentTime).Editable(false);
              //model.Field(p => p.BranchId).Editable(false);
              //model.Field(p => p.Description).Editable(false);
              //model.Field(p => p.EmployeeId).Editable(false);
              //model.Field(p => p.EmployeementType).Editable(false);
              //model.Field(p => p.LookupId).Editable(false);
              //model.Field(p => p.LevelOfInjuired).Editable(false);
              //model.Field(p => p.Witness).Editable(false);
              //model.Field(p => p.OrgStructureId).Editable(false);

          })
                               .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
           .Read(read => read.Action("EmployeeAccidentRequest_Read", "EmployeeAccidentRequest"))
          .Create(create => create.Action("EmployeeAccidentRequest_Create", "EmployeeAccidentRequest"))
          .Update(update => update.Action("EmployeeAccidentRequest_Update", "EmployeeAccidentRequest"))
          .Destroy(destroy => destroy.Action("EmployeeAccidentRequest_Destroy", "EmployeeAccidentRequest"))
      ))

