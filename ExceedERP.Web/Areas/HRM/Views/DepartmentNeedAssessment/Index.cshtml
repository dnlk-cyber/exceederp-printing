<script>
      function onDataBound(e) {
          var rows = e.sender.tbody.children();

          var gridName = "#NeedAssessmentgrid";

          for (var j = 0; j < rows.length; j++) {
              var row = $(rows[j]); 
              var dataItem = e.sender.dataItem(row);

              if (dataItem.IsSendForApproval) {
                  row.css("background-color", "lightGreen");   

                  row.find(".k-grid-edit").hide();
                  row.find(".k-grid-delete").hide();
                  row.find(".k-grid-send").hide();
              }   

              if (dataItem.IsTransfered) {
                  row.css("background-color", "gray");
                  row.css("color", "white");

                  row.find(".k-grid-edit").hide();
                  row.find(".k-grid-delete").hide();
                  row.find(".k-grid-send").hide();
              }    
             
          }

      }
</script>



<script>
      function SendForApproval(e) {

           var row = $(e.target).closest("tr");
           var grid = $("#NeedAssessmentgrid").data("kendoGrid");
           var dataItem = grid.dataItem(row);
           var id = dataItem.AssesmentId;
          
            $.ajax({
               // contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SendAssessmentForApproval", "DepartmentNeedAssessment")',
                data: { id: id},
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);

                    grid.dataSource.read();
                }

            });       
       }
</script>


<script>

      var OrgStructureId_Global = 0;
      var IsSendForApproval_Global = false;
      var IsTransfered_Global = false;

      function onDetailExpandUser(e) {

          var masterRow = e.masterRow;

          var masterGrid = $("#NeedAssessmentgrid").data("kendoGrid");

          var masterDataItem = masterGrid.dataItem(masterRow);

          OrgStructureId_Global = masterDataItem.OrgStructureId;
          IsSendForApproval_Global = masterDataItem.IsSendForApproval;
          IsTransfered_Global = masterDataItem.IsTransfered;

          masterId = masterDataItem.AssesmentId;    


          var gridName = "#EmployeesInAssessmentGrid" + masterId;



          if (masterDataItem.IsSendForApproval) {

              $(gridName).find(".k-toolbar").hide(); //hide toolbar
              $(".k-grid-top", gridName).hide();
          }

          if (IsTransfered_Global) {

              $(gridName).find(".k-toolbar").hide(); //hide toolbar
              $(".k-grid-top", gridName).hide();
          }      

    }



