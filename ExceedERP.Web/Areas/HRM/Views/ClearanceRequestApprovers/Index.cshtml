<script>
    function departmentApproval(e) {

       var row = $(e.target).closest("tr");
        var grid = $("#grid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.ClearanceRequestId;

        if (id.length !== 0 )
        {
            $('#loading-image').show();
            $.ajax({
                url: '@Url.Action("DepartmentApproval", "ClearanceRequestApprovers")',
                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);
                    $('#loading-image').hide();
                    grid.dataSource.read();
                }
            });

        }

    }
    function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApprovalRequest", "ClearanceRequestPersonal", new { area = "HRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            },
            error: function (result) {
                alert(result.Message);
            }
        });
    }

        function onDataBound(e) {
            var rows = e.sender.tbody.children();

            for (var j = 0; j < rows.length; j++) {
                var row = $(rows[j]);
                var dataItem = e.sender.dataItem(row);
                if (dataItem.IsDepartmentOnlineApproved || dataItem.IsOnlineApproved) {

                    row.find(".k-grid-edit").remove();
                    row.find(".k-grid-delete").remove();
                    $(".k-grid-top").show();

                }
                if (dataItem.IsSendForApproval && (!dataItem.IsOnlineApproved || !dataItem.IsOnlineApproved)) {

                    row.find(".k-grid-edit").show();
                    row.find(".k-grid-delete").remove();
                    $(".k-grid-top").show();

                }
                else {

                    row.find(".k-grid-delete").show();

                }


            }
        }
</script>
    
