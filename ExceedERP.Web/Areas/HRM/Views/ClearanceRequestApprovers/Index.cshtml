@using System.Collections
@using ExceedERP.Core.Domain.HRM.Company
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Clearance Request Approver</legend>
@(Html.Kendo().Grid<ClearanceRequestApprover>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.ApproverOrgStructureId, (IEnumerable)ViewData["Department"], "ApproverOrgStructureId", "Name").EditorTemplateName("Organization").Width(200);
          columns.Bound(c => c.ClearanceRequestId).Width(100);
          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").EditorTemplateName("Organization").Width(200);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("ActiveEmployeeForClearances").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["clearanceType"], "LookupId", "Description").EditorTemplateName("ClearanceType").Width(200);
          columns.Bound(c => c.Remark).Width(100);
          columns.Command(command =>
          {
              command.Custom("cmd-approve").Click("departmentApproval").Text("Approve").IconClass("fa fa-check fa4x").HtmlAttributes(new { @class = "btn btn-success", @title = "Approve  ", @id = "approve" });

              if (HttpContext.Current.User.IsInRole("HR_Company_User"))
              {
                  //  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Company_Admin"))
              {
                  // command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          }).Width(200);
      })
      .ToolBar(toolbar => {
          if (HttpContext.Current.User.IsInRole("HR_Company_User"))
          {
              //toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
      })
               .Editable(editable => editable.Mode(GridEditMode.InLine))
          //.TemplateName("ClearanceProvider").Window(window => { window.Title("Clearance Provider"); window.Scrollable(false); }))
          .Selectable(selectable =>
          {
              selectable.Mode(GridSelectionMode.Single);
              selectable.Type(GridSelectionType.Row);
          })
          .Events(ev =>
          {
              ev.DataBound("onDataBound");
          })
             .Scrollable(h => h.Height(500))
             .Sortable(sortable =>
             {
                 sortable.SortMode(GridSortMode.SingleColumn);

             })
             .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                .Events(events =>
                {
                    events.Error("error_handler(\"grid\")");
                    events.RequestStart("onRequestStart(\"grid\")");
                    events.RequestEnd("onRequestEnd(\"grid\")");
                })

          .Model(model => {
              model.Id(p => p.ClearanceRequestApproverId);
              model.Field(p => p.ClearanceRequestId).Editable(false);
              model.Field(p => p.EmployeeId).Editable(false);
              model.Field(p => p.OrgStructureId).Editable(false);
          })
          .Read(read => read.Action("ClearanceRequestApprovers_Read", "ClearanceRequestApprovers"))
          .Create(create => create.Action("ClearanceRequestApprovers_Create", "ClearanceRequestApprovers"))
          .Update(update => update.Action("ClearanceRequestApprovers_Update", "ClearanceRequestApprovers"))
          .Destroy(destroy => destroy.Action("ClearanceRequestApprovers_Destroy", "ClearanceRequestApprovers"))
      )/*.ClientDetailTemplateId("template")*/
)

