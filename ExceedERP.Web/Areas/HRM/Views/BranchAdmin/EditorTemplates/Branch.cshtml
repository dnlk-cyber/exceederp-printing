@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.Common.HRM.Branch 


<form>

    <div class="row my-class">

        <div class="col-sm-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Code, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>
                    @Html.TextBoxFor(model => model.Code)
                    @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger" })
                </div>
            </div>
        </div> 
        <div class="col-sm-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>
                    @Html.TextBoxFor(model => model.Name)
                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
       

    </div>
    <div class="row my-class">

        <div class="col-sm-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.AmharicName, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>
                    @Html.TextBoxFor(model => model.AmharicName)
                    @Html.ValidationMessageFor(model => model.AmharicName, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.BranchTypes, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>

                    @(Html.EnumDropDownListFor(m => m.BranchTypes, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 120px" })
                    )
                    @Html.ValidationMessageFor(model => model.BranchTypes, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

    </div>
 
    <div class="row my-class">

        <div class="col-sm-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Abbreviation, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>
                    @Html.TextBoxFor(model => model.Abbreviation)
                    @Html.ValidationMessageFor(model => model.Abbreviation, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-sm-3">

            <div class="form-group">
                @Html.LabelFor(model => model.ParentBranchId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.ParentBranchId)
                                  .ValuePrimitive(true)
                                  .OptionLabel("Select Parent...")
                                  .DataTextField("Name")
                                  .DataValueField("BranchId")
                                  .Filter("contains")
                                  .DataSource(dataSource =>
                                  {
                                      dataSource.Read(read => read.Action("GetBranches", "BranchAdmin", new { area = "HRM" }))
                                          .ServerFiltering(false);
                                  })
                    )
                    @Html.ValidationMessageFor(model => model.ParentBranchId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-md-8" })
                </div>
                <div>
                    <div class="col-md-10">
                        @(Html.Kendo().CheckBoxFor(model => model.IsActive))
                    </div>
                    @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
       
    </div>
</form>
