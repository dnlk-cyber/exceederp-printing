<script>
    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (model.IsHRApproved) {
                $(this).find(".k-grid-cmd-approve-request").hide();
            }

        });


    }


</script>

<script>
    function thirdLevelApproval(e) {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        var year = dataItem.GlFiscalYearId;
        var period = dataItem.GlPeriodId;
        var employee = dataItem.EmployeeId;

        $('#loading-image').show(); {
            var conf = confirm("Are you sure you want to approve this quarter performance evaluation");
            if (conf === true) {
                $('#loading-image').show();

                $.ajax({
                    url: '@Url.Action("ApproveEvaluation", "EmployeePerformanceCorporateAndSectorLevels")',
                    //contentType: "application/json; charset=utf-8",
                    data: { year: year, period: period, employee: employee },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        r = result;
                        $('#loading-image').hide();
                        if (r == "true") {
                            alert("Successfully Approved");
                            grid.dataSource.read();
                        }
                        else {
                            alert("not Approved");
                            grid.dataSource.read();
                        }

                    },
                    error: function (xhr, status, error) {
                        $('#loading-image').hide();
                        alert("An error occurred: " + error);
                    }

                });
            }

        }

    }


</script>
<script>


    function GenerateProcess() {


        var evaluationCriteriaId = $("#EvaluationCriteriaId").data("kendoDropDownList").value();
        var yearId = $("#GlFiscalYearId").data("kendoDropDownList").value();
        var periodId = $("#Period").data("kendoDropDownList").value();
        var code = $("#businessUnit").data("kendoDropDownList").value();
        var branchId = $("#branch").data("kendoDropDownList").value();
        var orgId = $("#workUnit").data("kendoDropDownList").value();
        var lookupId = $("#jobtitle").data("kendoDropDownList").value();
        var resultValue = $("#decimalInput").val(); // Get the value of the decimal input field
        if (yearId == "") {
            alert("please select the year first");
        }
        else if (periodId == "") {
            alert("please select the period first");
        }

        else if (evaluationCriteriaId == "") {
            alert("please select the evaluation criteria first");
        }
        else if (resultValue == "") {
            alert("please select the evaluation criteria first");
        }
        $('#loading-image').show();
        $.ajax({
            url: '@Url.Action("GenerateEmployeeForPerofmanceEvaluation", "EmployeePerformanceCorporateAndSectorLevels")',
            data: { fiscalYearId: yearId, periodId: periodId, evaluationCriteriaId: evaluationCriteriaId, code: code, branchId: branchId, orgId: orgId, lookupId: lookupId, resultValue: resultValue },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                alert(r.Message);
                location.reload();

            }

        });

    }

    function onCriteriaChange(e)
    {
        var evaluationType = $("#Evaluation").data("kendoDropDownList");
        var dStatus = evaluationType.value();
        if (dStatus == 7) {
            var showField = document.querySelector('.clasToBeShow1');
            var hiddenField2 = document.querySelector('.clasToBeShow2');
            var branchField = document.querySelector('.branchClassToBeShow1');
            var hiddenField3 = document.querySelector('.clasToBeShow3');
            showField.style.display = 'block';
            hiddenField2.style.display = 'none';
            hiddenField3.style.display = 'none';
            branchField.style.display = 'none';

        }
        if (dStatus == 8) {
            var showField2 = document.querySelector('.clasToBeShow2');
            var hiddenField1 = document.querySelector('.clasToBeShow1');
            var hiddenField3 = document.querySelector('.clasToBeShow3');
            var branchField = document.querySelector('.branchClassToBeShow1');

            showField2.style.display = 'block';
            hiddenField1.style.display = 'block';
            branchField.style.display = 'block';
            hiddenField3.style.display = 'none';

        }

        if (dStatus == 9) {
            var showField3 = document.querySelector('.clasToBeShow3');
            var showField1 = document.querySelector('.clasToBeShow1');
            var hiddenField2 = document.querySelector('.clasToBeShow2');
            var branchField = document.querySelector('.branchClassToBeShow1');

            showField3.style.display = 'block';
            showField1.style.display = 'block';
            branchField.style.display = 'block';
            hiddenField2.style.display = 'none';

        }

        if (dStatus == 6) {
            var hiddenField1 = document.querySelector('.clasToBeShow1');
            var hiddenField2 = document.querySelector('.clasToBeShow2');
            var hiddenField3 = document.querySelector('.clasToBeShow3');
            var branchField = document.querySelector('.branchClassToBeShow1');

            hiddenField1.style.display = 'none';
            hiddenField2.style.display = 'none';
            hiddenField3.style.display = 'none';
            branchField.style.display = 'none';
        }

    }
    function filterEvaluationCriteria() {
        return {
            level: $("#Evaluation").val(),
            text: $("#EvaluationCriteriaId").data("kendoDropDownList").filterInput.val()


        };
    }
    function filterWorkUnitEvaluationCriteria() {
        return {
            evaluationCriteriaId: $("#EvaluationCriteriaId").val(),
            branchId: $("#branch").val(),
            text: $("#workUnit").data("kendoDropDownList").filterInput.val()


        };
    }
    function filterJobTitleEvaluationCriteria() {
        return {
            evaluationCriteriaId: $("#EvaluationCriteriaId").val(),
            branchId: $("#branch").val(),
            text: $("#jobtitle").data("kendoDropDownList").filterInput.val()


        };
    }
    function filterPeriod() {
        return {
            GlFiscalYearId: $("#GlFiscalYearId").val()
        };
    }
    function filterBranch() {
        return {
            businessUnitId: $("#businessUnit").val(),
            searchText: $("#branch").data("kendoDropDownList").filterInput.val(),

        };
    }
    function onMeasurementDefinitionChange() {
        var evaluationCriteriaId = $("#EvaluationCriteriaId").data("kendoDropDownList").value();
        var resultValue = $("#decimalInput").val(); // Get the value of the decimal input field
        if (evaluationCriteriaId == "") {
            alert("please Select the Result to generate");
        }
        if (resultValue == "") {
            alert("please Enter the Result to generate");
        }

        $.ajax({
            url: '@Url.Action("CheckTheWeight", "EmployeePerformanceCorporateAndSectorLevels")',
            data: { evaluationCriteriaId: evaluationCriteriaId, resultValue: resultValue},
            type: 'POST',
            cache: false,
                success: function (result) {
                    alert(result)
                }


        });

    }
</script>
