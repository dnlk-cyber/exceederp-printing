@using System.Collections
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row flex-container">
    <div class="col-md-12">
        <div class="flex-container">
            @*<div class="flex-item-group">*@
                <!-- Fiscal Year Dropdown -->
                <div class="flex-item">
                    <!-- Dropdown for Fiscal Year -->
                    <label class="category-label"> Year</label>
                    <br />

                    @(Html.Kendo().DropDownListFor(m => m)
                                                    .Name("GlFiscalYearId")
                                                    .OptionLabel(Resources.Select)
                                                    .Filter("contains")
                                                    .DataTextField("Name")
                                                    .DataValueField("GlFiscalYearId")
                                                    .HtmlAttributes(new { style = "width:150px" })
                                                    .DataSource(dataSource =>
                                                    {
                                                        dataSource.Read(read => read.Action("GetFiscalYearForPerformance", "HRMDataProvider", new { area = "HRM" }))
                                                            .ServerFiltering(false);
                                                    })

                                                    .HtmlAttributes(new { style = "width: 150px;" }))

                </div>

                <!-- Period Dropdown -->
                <div class="flex-item">
                    <label class="category-label" for="Period">@Resources.HR_PerformanceManagment_EmployeeMeasurementDefinition_PeriodId</label>

                    <br />

                    @(Html.Kendo().DropDownListFor(m => m)
                                                        .Name("Period")
                                                        //.Placeholder("Period")
                                                        .OptionLabel(Resources.Select)
                                                        .Filter("contains")
                                                        .CascadeFrom("GlFiscalYearId")
                                                        .DataTextField("Name")
                                                        .HtmlAttributes(new { style = "width:150px" })
                                                        .DataSource(dataSource =>
                                                        {
                                                            dataSource.Read(read => read.Action("GetPeriodList", "EmployeePerformance", new { area = "HRM" }).Data("filterPeriod"))
                                                            .ServerFiltering(true);
                                                        })
                                                    .DataValueField("QuarterId")
                                                    .AutoBind(false)
                                                    .Events(e => e.Change("Period"))
                                                    .HtmlAttributes(new { style = "width: 150px;" })

                    )

                </div>

                <!-- Evaluation Level Dropdown -->
                <div class="flex-item">
                    <label class="category-label" for="Role" style="width: 120px;">Evaluation-Level</label>

                    <br />

                    @(Html.Kendo().DropDownListFor(m => m)
                                                    .Name("Evaluation")
                                                    .OptionLabel(Resources.Select)
                                                    //.Placeholder("Evaluation Level")
                                                    .DataTextField("Text")
                                                    .BindTo(EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.HRM.PerformanceManagment.EvaluationTypeLevel)))
                                                    .DataValueField("Value")
                                                    .Filter("contains")
                                                    .Events(x => x.Change("onCriteriaChange"))
                                                    .HtmlAttributes(new { style = "width:150px" })
                                                    .AutoBind(false)
                                                    //.Events(e => e.Change("Roles"))
                                                    .HtmlAttributes(new { style = "width: 150px;" })

                    )
                </div>

                <!-- Evaluation Criteria Dropdown -->
                <div class="flex-item">
                    <label class="category-label" for="EvaluationCriteriaId" style="width: 150px;">@Resources.HR_PerformanceManagment_EmployeePerformance_EvaluationType</label>

                    <br />
                    @(Html.Kendo().DropDownListFor(m => m)
                                                        .Name("EvaluationCriteriaId")
                                                        .OptionLabel(Resources.Select)
                                                        // .Placeholder("Type")
                                                        .DataTextField("Name")
                                                        .Filter("contains")
                                                        //.BindTo((IEnumerable)ViewData["EvaluationTypes"])
                                                        .DataValueField("MeasurementDefinitionId")
                                                        .CascadeFrom("Evaluation")
                                                        //.Events(x => x.Change("onMeasurementDefinitionChange"))
                                                        .AutoBind(false)
                                                        .DataSource(dataSource =>
                                                        {
                                                            dataSource.Read(read => read.Action("GetCorporateOrSectorEvaluationCriterias", "HRMDataProvider", new { area = "HRM" }).Data("filterEvaluationCriteria"))
                                                            .ServerFiltering(true);
                                                        })
                                                        .HtmlAttributes(new { style = "width: 150px;" })
                    )

                </div>

                <!-- Other Dropdowns and Inputs as flex-item -->
                <!-- Business Unit, Work Unit, Job Title, Result Input, Button -->
            @*</div>*@
            @*<div class="flex-item-group">*@
                <div class="clasToBeShow1 flex-item" style="display:none">

                    <label class="category-label" for="businessUnit">@Resources.BussinessUnit</label>
                    <br />
                    @(Html.Kendo().DropDownListFor(m => m)
                                .Name("businessUnit")
                                .OptionLabel(Resources.Select)
                                .Filter("contains")
                                .DataTextField("Name")
                                .DataValueField("Code")

                                    .DataSource(dataSource =>
                                    {
                                        dataSource.Read(read => read.Action("GetAllBusinessUnits", "HRMDataProvider", new { area = "HRM" }))
                                        .ServerFiltering(false);

                                    })

                                      .HtmlAttributes(new { style = "width: 150px;" })
                    )

                </div>
                <div class="branchClassToBeShow1 flex-item" style="display:none">

                    <label class="branch-label" for="branch">@Resources.Rpt_Branch</label>
                    <br />
                    @(Html.Kendo().DropDownListFor(m => m)
                                    .Name("branch")
                                    .OptionLabel(Resources.Select)
                                    .Filter("contains")
                                    .DataTextField("Name")
                                    .CascadeFrom("businessUnit")
                                    .DataValueField("BranchId")
                                        .DataSource(dataSource =>
                                        {
                                            dataSource.Read(read => read.Action("GetAllBranchByBusinessUnit", "HRMDataProvider", new { area = "HRM" }).Data("filterBranch"))
                                            .ServerFiltering(true);
                                        })

                                    .HtmlAttributes(new { style = "width: 150px;" })
                    )

                </div>

                <div class="clasToBeShow2 flex-item" style="display:none">

                    <label class="category-label" for="workUnit">@Resources.Department</label>
                    <br />
                    @(Html.Kendo().DropDownListFor(m => m)
                                .Name("workUnit")
                                .OptionLabel(Resources.Select)
                                .Filter("contains")
                                .CascadeFrom("branch")
                                .DataTextField("Name")
                                .DataValueField("OrgStructureId")

                                    .DataSource(dataSource =>
                                    {
                                        dataSource.Read(read => read.Action("GetAllWorkUnitForPerformances", "HRMDataProvider", new { area = "HRM" }).Data("filterWorkUnitEvaluationCriteria"))
                                        .ServerFiltering(true);
                                    })

                                .HtmlAttributes(new { style = "width: 150px;" })
                    )

                </div>
                <div class="clasToBeShow3 flex-item" style="display:none">

                    <label class="category-label" for="JobTitle">@Resources.JobTitle</label>
                    <br />
                    @(Html.Kendo().DropDownListFor(m => m)
                            .Name("jobtitle")
                            .OptionLabel(Resources.Select)
                            .Filter("contains")
                            .CascadeFrom("EvaluationCriteriaId")
                            .DataTextField("Description")
                            .DataValueField("LookupId")

                                .DataSource(dataSource =>
                                {
                                    dataSource.Read(read => read.Action("GetAllJobTitleForPerformances", "HRMDataProvider", new { area = "HRM" }).Data("filterJobTitleEvaluationCriteria"))
                                    .ServerFiltering(true);
                                })

                            .HtmlAttributes(new { style = "width:150px;" })
                    )

                </div>


                <div class="flex-item">
                    <!-- Result label and input here -->
                    <label class="result-label" for="result">@Resources.Result</label>
                    <br />
                    <input type="number" id="decimalInput" step="0.01" placeholder="Enter result" style="width: 100px;" onchange="onMeasurementDefinitionChange()" />

                </div>
                <div class="flex-item">
                    <!-- Button here -->
                    <br />

                    @(Html.Kendo().Button()
                        .Name("btnRefresh")
                        .HtmlAttributes(new { type = "button", @class = "k-primary", style = "width: 100px;height: 40px" })
                        .Events(e => e.Click("GenerateProcess"))
                        .Content("Apply"))
                    &nbsp; &nbsp;
                    &nbsp; &nbsp;
                    &nbsp;  &nbsp;


                </div>
            </div>


        </div>
    </div>
<legend>@Resources.NavigatorPerformance_EmployeePerformance || HR </legend>
@(Html.Kendo().Grid<EmployeePerformance>()
        .Name("EmployeePerformancegrid")
        .Columns(columns =>
        {
            columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").Width(200).EditorTemplateName("EmployeeLists").Filterable(ftb => ftb.Multi(true).Search(true));
            columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["fiscalYearList"], "GlFiscalYearId", "Name").EditorTemplateName("GLYearSelector").Filterable(ftb => ftb.Multi(true).Search(true)).Width(80);
            columns.ForeignKey(c => c.GlPeriodId, (IEnumerable)ViewData["Period"], "QuarterId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
            columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
            columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
            columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
            columns.ForeignKey(c => c.JobTitleId, (IEnumerable)ViewData["jobTitle"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
            columns.Bound(c => c.IsCurrent).ClientTemplate(
             "<input type='checkbox' disabled = 'true' value='#= IsCurrent#' " +
             "# if (IsCurrent) { #" +
             "checked='checked'" +
             "# } #" +
             "/>"
             ).Width(150);
            columns.Bound(c => c.IsHRApproved).ClientTemplate(
             "<input type='checkbox' disabled = 'true' value='#= IsHRApproved#' " +
             "# if (IsHRApproved) { #" +
             "checked='checked'" +
             "# } #" +
             "/>"
             ).Width(150);
            columns.Bound(c => c.ResponsibilityLevel).Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);

            columns.Command(command =>
            {
                command.Custom("cmd-approve-request").IconClass("fa fa-check ").Text("Approva").Click("thirdLevelApproval").HtmlAttributes(new { @class = "btn btn-success" });

            }).Width(100);



        })
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Filterable()
                .Scrollable(h => h.Height("auto"))
                .Events(ev => ev.DataBound("onDataBound"))
                .Pageable(pageable => pageable
                    //.Input(true)
                    // .Numeric(false)
                    .Refresh(true)
                    //.PageSizes(true)
                    // .ButtonCount(5)
                    )

                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Events(events =>
                    {
                        events.Error("error_handler(\"EmployeePerformancegrid\")");
                        events.RequestStart("onRequestStart(\"EmployeePerformancegrid\")");
                        events.RequestEnd("onRequestEnd(\"EmployeePerformancegrid\")");

                    })
                    .Model(model =>
                    {
                        model.Id(p => p.EmployeePerformanceId);
                        model.Field(p => p.Result).Editable(false);


                    })
                .Read(read => read.Action("EmployeePerformanceCorporateAndSectorLevels_Read", "EmployeePerformanceCorporateAndSectorLevels"))
                ).ClientDetailTemplateId("employee_performance_template")
)

<script id="employee_performance_template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabstrip_#=EmployeePerformanceId#")
            .SelectedIndex(0)
            .Items(items =>
            {
                items.Add().Text(Resources.NavigatorPerformance_EmployeePerformance).Content(
                @<text>
                    @(Html.Kendo().Grid<EmployeePerformance>()
                        .Name("EmployeePerformancedetailgrid_#=EmployeePerformanceId#")
                        .Columns(columns =>
                        {

                            columns.Bound(c => c.EmployeePerformanceId).Visible(false).Width(80);
                            columns.ForeignKey(c => c.EvaluationCriteriaTypeId, (IEnumerable)ViewData["EvalutionCrateria"], "MeasurementDefinitionId", "Name").Width(200);
                            // columns.Bound(c => c.Weight).Width(80);
                            // columns.Bound(c => c.Result).Width(80);
                            columns.Bound(c => c.Weight).Width(100).Format("{0:n}").ClientFooterTemplate("\\#=kendo.toString(sum, 'n')\\# ");
                            columns.Bound(c => c.Result).Width(100).Format("{0:n}").ClientFooterTemplate("\\#=kendo.toString(sum, 'n')\\# ");
                            columns.Bound(c => c.Remark).Width(100);
                            columns.Command(command =>
                            {
                                // command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                command.Destroy().Text(Resources.ActionButton_Cancel);


                            }).Width(100);


                        })

                        .ClientDetailTemplateId("Action")
                        .Editable(editable => {
                            editable.Mode(GridEditMode.InLine);
                            editable.DisplayDeleteConfirmation("⚠️WARNING: Are you sure you want to delete this? This Evaluation has undergone many processes and approvals. ");
                        })

                        .Scrollable(h => h.Height("auto"))
                            .Pageable(pageable => pageable
                                //.Input(true)
                                // .Numeric(false)
                                .Refresh(true)

                                )

                                .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Aggregates(aggregates =>
                                        {
                                            aggregates.Add(p => p.Weight).Sum();
                                            aggregates.Add(p => p.Result).Sum();
                                        })
                                        .Events(events =>
                                        {
                                            events.Error("error_handler(\"EmployeePerformancedetailgrid_#=EmployeePerformanceId#\")");
                                            events.RequestStart("onRequestStart(\"EmployeePerformancedetailgrid_#=EmployeePerformanceId#\")");
                                            events.RequestEnd("onRequestEnd(\"EmployeePerformancedetailgrid_#=EmployeePerformanceId#\")");
                                        })
                                        .Model(model =>
                                        {
                                            model.Id(p => p.EmployeePerformanceId);
                                            model.Field(p => p.Result).Editable(false);


                                        })
                                        .Read(read => read.Action("EmployeePerformanceCorporateAndSectorLevels_OnePerson_Read", "EmployeePerformanceCorporateAndSectorLevels", new { employeeId = "#=EmployeeId#", fiscalyearId = "#=GlFiscalYearId#", quarterId = "#=GlPeriodId#" }))
                                        // .Destroy(destroy => destroy.Action("EmployeePerformanceCorporateAndSectorLevels_OnePerson_Destroy", "EmployeePerformanceCorporateAndSectorLevels", new { employeePerformanceId = "#=EmployeePerformanceId#"}))
                                        .Destroy(destroy => destroy.Action("EmployeePerformanceCorporateAndSectorLevels_OnePerson_Destroy", "EmployeePerformanceCorporateAndSectorLevels", new { employeePerformanceId = "#=EmployeePerformanceId#" }))

                                        ).ClientDetailTemplateId("employee_performance_detail_template")
                                        .ToClientTemplate()
                    )
            </text> );



            }).ToClientTemplate())

</script>

