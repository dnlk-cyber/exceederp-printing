<script>
     function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }
    function onChange(e) {
        var grid = e.sender;
        var selectedRows = this.select();
        var rowData = this.dataItem(selectedRows[0]);
        var id = rowData.AttachmentID;
        $.ajax({
            url: '@Url.Action("Download", "Termination")',
            contentType: "application/json; charset=utf-8",
            data: { 'id': id },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
            }

        });

    }
    function DownloadAttachmnets(e) {

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var dd = dataItem.Description;
        var id = dataItem.Reference;
        $.ajax({
            url: '@Url.Action("Download", "Termination")',
            contentType: "application/json; charset=utf-8",
            data: { 'data': dd, 'id': id },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
            }

        });

    }
    function onUploadSuccess1(e) {
        // Force the rebinding of the Grid on successful upload
        $("#AttachmentGrid_" + masterId).data("kendoGrid").dataSource.read();
    }
</script>
