@using System.Collections
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? true;
}
<Legend>@Resources.NavigatorTermination_TerminationRequestes</Legend>
@(Html.Kendo().Grid<Termination>()
      .Name("TerminationGrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(100);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["TerminationTypes"], "LookupId", "Description").EditorTemplateName("TerminationType").Filterable(ftb => ftb.Multi(true).Search(true)).Width (130);
          columns.Bound(c => c.Reason).Width (300);
          columns.Bound(c => c.IsForciblyTerminated).ClientTemplate(
                      "<input type='checkbox' disabled = 'true' value='#= IsForciblyTerminated#' " +
                      "# if (IsForciblyTerminated) { #" +
                      "checked='checked'" +
                      "# } #" +
                      "/>" ).Width(150);
          if (useEthiopian)
          {
              columns.Bound(c => c.ApplicationDateAm).EditorTemplateName("Calander").Width(100);
              columns.Bound(c => c.TerminationDateAm).EditorTemplateName("Calander").Width(100);
          }
          else
          {
              columns.Bound(c => c.ApplicationDate).Width(120);
              columns.Bound(c => c.TerminationDate).Width(120);
          }          // columns.Bound(c => c.Remark).Width (120);
          //  columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
          //  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Selectable(selectable => {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Events(events => events.DetailExpand("onDetailExpandUser"))
      .Scrollable(h=> h.Height( 500))
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);

      })
      .Filterable()
      .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ApplicationDate").Descending())
               .Events(events =>
               {
                   events.Error("error_handler(\"TerminationGrid\")");
                   events.RequestStart("onRequestStart(\"TerminationGrid\")");
                   events.RequestEnd("onRequestEnd(\"TerminationGrid\")");
               })

          .Model(model => model.Id(p => p.TerminationId))
              .Read(read => read.Action("Terminations_Read", "TerminationRequestes").Data("sendForgery"))
              .Create(create => create.Action("Terminations_Create", "TerminationRequestes").Data("sendForgery"))
              .Update(update => update.Action("Terminations_Update", "TerminationRequestes").Data("sendForgery"))
              .Destroy(destroy => destroy.Action("Terminations_Destroy", "TerminationRequestes").Data("sendForgery"))

                  ).ClientDetailTemplateId("template")
      )
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=TerminationId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text(Resources.HR_RequestesStatus).Content(
                @<text>
                    @* <legend>Status</legend>*@

                    @(Html.Kendo().Grid<RequestesStatus>()
                                  .Name("RequestesStatusgrid_#=TerminationId#")
                          .Columns(columns =>
                          {
                              //columns.Bound(c => c.RequestId);
                              columns.Bound(c => c.DateReqStatAm).Width(150);
                              columns.Bound(c => c.Status).EditorTemplateName("EnumWithoutDepApprove").Width(300);
                              columns.ForeignKey(c => c.ApproverId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                              columns.ForeignKey(c => c.ApproverDepartment, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                              columns.Bound(c => c.Remark).Width(150);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);//
                              }).Width(180);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              // toolbar.Custom().Action("SendForApproval", "TerminationRequestes").Text("Send For Approval");
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Scrollable(h => h.Height(500))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Events(events =>
                              {
                                    events.Error("error_handler(\"RequestesStatusgrid_#=TerminationId#\")");
                                    events.RequestStart("onRequestStart(\"RequestesStatusgrid_#=TerminationId#\")");
                                    events.RequestEnd("onRequestEnd(\"RequestesStatusgrid_#=TerminationId#\")");
                              })
                                
                              .Model(model =>
                              {
                                  model.Id(p => p.RequestStatusId);
                                  model.Field(p => p.Date).Editable(false).DefaultValue(DateTime.Today);
                              })

                              .Read(read => read.Action("RequestesStatus_Read", "RequestesStatus", new { id = "#=TerminationId#", referenceType = "Termination" }).Data("sendForgery"))
                              .Create(create => create.Action("RequestesStatus_Create", "RequestesStatus", new { id = "#=TerminationId#", referenceType2 = "Termination" }).Data("sendForgery"))
                              .Update(update => update.Action("RequestesStatus_Update", "RequestesStatus").Data("sendForgery"))
                              .Destroy(destroy => destroy.Action("RequestesStatus_Destroy", "RequestesStatus").Data("sendForgery"))
                          ).ToClientTemplate()
                    )


                </text>);
               items.Add().Text(Resources.NavigatorSelfCare_FixedAsset).Content(
                @<text>
                    @fixedAssetYouHave()
                </text>);
          items.Add().Text(Resources.UploadFile).Content(
                @<text>
                    @TerminationFileAttachment()
                </text>);
          }).ToClientTemplate())
</script>
@helper TerminationFileAttachment() { 
    @(Html.Kendo().Grid<Attachment>()
                .Name("AttachmentGrid_#=TerminationId#")
                .Columns(columns =>
                {

                    columns.Bound(c => c.Description).Width(150);
                    columns.Template(e => { }).ClientTemplate("<a href='/Common/Attachment/DownloadAttachment?attachmentId=\\#=AttachmentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; Download </a>").Width(80);
                    columns.Template(e => { }).ClientTemplate("<a href='\\#=URL\\#/\\#=FileName\\#' target='_blank'> <f class = 'fa fa-folder-open'></i> &nbsp;&nbsp; Open</a>").Width(80);

                    //columns.Bound(c => c.FileType).ClientTemplate(Html.ActionLink("DownLoad", "DownloadFile", new { filename = "#=TerminationId#" }).ToHtmlString()).Width(150);
                    columns.Command(command =>
                    {
                        command.Destroy().Text(Resources.ActionButton_Cancel);
                        //command.Custom("Download").Click("DownloadAttachmnets");
                    });
                })
                .ToolBar(toolbar =>
                {
                toolbar.Template(@<text>
                            @Html.Kendo().Upload().Name("file").Async(a => a.Save("AttachmentTemplateFiles_Create", "Attachment", new { Area = "Common", attachmentReferenceType = "Clearance", id = "#=EmployeeId#", fileOwner = "#=TerminationId#" })).Events(e => e.Complete("onUploadSuccess1")
                                                                                                                        .Select("function(e) { globalOnSelect(e, ['.jpg', '.png', '.pdf'], 2 * 1024 * 1024); }")
                                                                            .Error("onUploadError")).ShowFileList(false).ToClientTemplate()
                        </text>);


                    })
                .Events(e =>
                {
                    e.Edit("onGridEdit");
                    e.Change("onChange");
                })
                //.ToolBar(toolbar =>
                //{
                //    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

                //})
                .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Upload").Window(window =>
                {
                    window.Scrollable(false);
                    window.Title(Resources.HR_Upload_File);

                }))
                .Scrollable()
                .Selectable()
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Events(events =>
                    {
                        events.Error("error_handler(\"AttachmentGrid_#=TerminationId#\")");
                        events.RequestStart("onRequestStart(\"AttachmentGrid_#=TerminationId#\")");
                        events.RequestEnd("onRequestEnd(\"AttachmentGrid_#=TerminationId#\")");

                    })
                    .Model(model => model.Id(p => p.AttachmentId))
                    .Read(read => read.Action("Attachments_Read", "Attachment", new { Area = "Common", attachmentReferenceType = "Clearance", id = "#=EmployeeId#", fileOwner = "#=TerminationId#" }).Data("sendForgery"))
                    .Create(create => create.Action("Attachments_Create", "Attachment", new { Area = "Common", attachmentReferenceType = "Clearance", id = "#=EmployeeId#", fileOwner = "#=TerminationId#" }).Data("sendForgery"))
                    .Destroy(destroy => destroy.Action("Attachments_Destroy", "Termination").Data("sendForgery"))

                    ).ToClientTemplate()
                )
    }
@helper fixedAssetYouHave()
{ 
     @(Html.Kendo().Grid<ExceedERP.Core.Domain.FixedAsset.UserCard.UserCardItems>()
          .Name("UserCardItemsgrid#=TerminationId#")
          .Columns(columns =>
          {
              columns.Bound(c => c.Name).Width (140);
              columns.Bound(c => c.IssueDate).Width (130);
              columns.Bound(c => c.UOM).Width (130);
              columns.Bound(c => c.UnitPrice).Width(120);
              columns.Bound(c => c.Quanity).Width (100);
              columns.Bound(c => c.SerialNo).Width(130);
              columns.Bound(c => c.SIVNo).Width(120);
              columns.Bound(c => c.GRNDate).Width(120);
              columns.Bound(c => c.Active).ClientTemplate(
                     "<input type='checkbox' disabled = 'true' value='\\#= Active\\#' " +
                     "\\# if (Active) { \\#" +
                     "checked='checked'" +
                     "\\# } \\#" +
                     "/>"
                     ).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(120);

              columns.Bound(c => c.Remark);
          })

          .Scrollable(h => h.Height(500))
          .Sortable(sortable =>
          {
              sortable.SortMode(GridSortMode.SingleColumn);

          })
          .Filterable()
          .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
           .Sort(sort => sort.Add("LoanId").Descending())
           .Events(events =>
           {
               events.Error("error_handler(\"UserCardItemsgrid#=TerminationId#\")");
               events.RequestStart("onRequestStart(\"UserCardItemsgrid#=TerminationId#\")");
               events.RequestEnd("onRequestEnd(\"UserCardItemsgrid#=TerminationId#\")");

           })
          .Model(model =>
          {
              model.Id(p => p.UserCardItemsID);
          })
          .Read(read => read.Action("UserCardItems_Read", "Termination", new { Area = "HRM", employeeId = "#=EmployeeId#" }).Data("sendForgery"))

      ).ToClientTemplate())
}
<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
