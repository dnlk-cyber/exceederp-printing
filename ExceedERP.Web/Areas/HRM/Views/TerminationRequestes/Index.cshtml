    function sync_handler(e) {
        this.read();

    }
    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }
    var masterId = 0;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#TerminationGrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.TerminationId;
        var gridName = "#RequestesStatusgrid_" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatus", "TerminationRequest")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-add", gridName).hide();
                }
                else if (r == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else if (r == "Dapproved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).show();
                    $(".k-grid-delete", gridName).show();
                }
                else {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-add", gridName).show();
                }

            }

        });

    }
</script>