@using System.Collections
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.NavigatorTermination_TerminationRequestes</Legend>
@(Html.Kendo().Grid<Termination>()
      .Name("TerminationGrid")
      .Columns(columns =>
      {

          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("ListOfEmployee").Width(200);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["TerminationTypes"], "LookupId", "Description").EditorTemplateName("TerminationType").Width (150);
          columns.Bound(c => c.ApplicationDateAm).Width(150);
          columns.Bound(c => c.Reason).Width (150);
          columns.Bound(c => c.IsForciblyTerminated).ClientTemplate(
                      "<input type='checkbox' disabled = 'true' value='#= IsForciblyTerminated#' " +
                      "# if (IsForciblyTerminated) { #" +
                      "checked='checked'" +
                      "# } #" +
                      "/>"
                      ).Width(150);
          columns.Bound(c => c.TerminationDateAm).Width (150);
          // columns.Bound(c => c.Remark).Width (120);
          //  columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
          //  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Selectable(selectable => {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Events(events => events.DetailExpand("onDetailExpandUser"))
      .Scrollable(h=> h.Height( 500))
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);

      })
      .Filterable()
      .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ApplicationDate").Descending())
               .Events(events =>
               {
                   events.Error("error_handler(\"TerminationGrid\")");
                   events.RequestStart("onRequestStart(\"TerminationGrid\")");
                   events.RequestEnd("onRequestEnd(\"TerminationGrid\")");
               })

          .Model(model => model.Id(p => p.TerminationId))
              .Read(read => read.Action("Terminations_Read", "TerminationRequestes"))
              .Create(create => create.Action("Terminations_Create", "TerminationRequestes"))
              .Update(update => update.Action("Terminations_Update", "TerminationRequestes"))
              .Destroy(destroy => destroy.Action("Terminations_Destroy", "TerminationRequestes"))

                  ).ClientDetailTemplateId("template")
      )
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=TerminationId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text(Resources.HR_RequestesStatus).Content(
                @<text>
                    @* <legend>Status</legend>*@

                    @(Html.Kendo().Grid<RequestesStatus>()
                                  .Name("RequestesStatusgrid_#=TerminationId#")
                          .Columns(columns =>
                          {
                              //columns.Bound(c => c.RequestId);
                              columns.Bound(c => c.DateReqStatAm).Width(150);
                              columns.Bound(c => c.Status).EditorTemplateName("EnumWithoutDepApprove").Width(300);
                              columns.ForeignKey(c => c.ApproverId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                              columns.ForeignKey(c => c.ApproverDepartment, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                              columns.Bound(c => c.Remark).Width(150);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);//
                              }).Width(180);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              // toolbar.Custom().Action("SendForApproval", "TerminationRequestes").Text("Send For Approval");
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Scrollable(h => h.Height(500))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Events(events =>
                              {
                                    events.Error("error_handler(\"RequestesStatusgrid_#=TerminationId#\")");
                                    events.RequestStart("onRequestStart(\"RequestesStatusgrid_#=TerminationId#\")");
                                    events.RequestEnd("onRequestEnd(\"RequestesStatusgrid_#=TerminationId#\")");
                              })
                                
                              .Model(model =>
                              {
                                  model.Id(p => p.RequestStatusId);
                                  model.Field(p => p.Date).Editable(false).DefaultValue(DateTime.Today);
                              })

                              .Read(read => read.Action("RequestesStatus_Read", "RequestesStatus", new { id = "#=TerminationId#", referenceType = "Termination" }))
                              .Create(create => create.Action("RequestesStatus_Create", "RequestesStatus", new { id = "#=TerminationId#", referenceType2 = "Termination" }))
                              .Update(update => update.Action("RequestesStatus_Update", "RequestesStatus"))
                              .Destroy(destroy => destroy.Action("RequestesStatus_Destroy", "RequestesStatus"))
                          ).ToClientTemplate()
                    )


                </text>
                  );
              //*****************************************************************************************************//

          }).ToClientTemplate())
</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
<script>
    function DownloadAttachmnets(e) {

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var dd = dataItem.Description;
        var id = dataItem.Reference;
        $.ajax({
            url: '@Url.Action("Download", "Termination")',
            contentType: "application/json; charset=utf-8",
            data: { 'data': dd, 'id': id },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
            }

        });

    }
</script>
