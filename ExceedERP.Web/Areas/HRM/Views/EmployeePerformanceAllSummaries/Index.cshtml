<style>
    #approveButtonStyle {
        border-radius: 5%;
        padding-top: 1px;
        padding-bottom: 1px;
    }
   

</style>


<script>
    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (model.IsHRApproved && model.AreAllHRLevelApproved) {
                $(this).find(".k-grid-cmd-approve-request").hide();
                $(this).find(".k-grid-cmd-reject").hide();
            }
            else if (model.IsHRRejected && model.AreAllHRLevelApproved) {
                $(this).find(".k-grid-cmd-approve-request").hide();
                $(this).find(".k-grid-cmd-reject").hide();
            }
            else if (model.IsHRRejected) {
                $(this).find(".k-grid-cmd-approve-request").show();
                $(this).find(".k-grid-cmd-reject").hide();

            }

        });


    }


</script>

<script>
    function thirdLevelApproval(e) {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        var year = dataItem.GlFiscalYearId;
        var period = dataItem.GlPeriodId;
        var employee = dataItem.EmployeeId;

        $('#loading-image').show(); {
            var conf = confirm("Are you sure you want to approve this quarter performance evaluation");
            if (conf === true) {
                $('#loading-image').show();

                $.ajax({
                    url: '@Url.Action("ApproveEvaluation", "EmployeePerformanceAllSummaries")',
                    //contentType: "application/json; charset=utf-8",
                    data: { year: year, period: period, employee: employee },
                    type: 'POST',
                    cache: false,
                    success: function (result) {

                        alert(result.Message);

                        $('#loading-image').hide();

                        grid.dataSource.read();
                        //if (r == "true") {
                        //    alert("Successfully Approved");
                        //    $('#loading-image').hide();
                        //    grid.dataSource.read();
                        //}
                        //else {
                        //    alert("not Approved");
                        //    $('#loading-image').hide();
                        //    grid.dataSource.read();
                        //}

                    },
                    error: function (xhr, status, error) {
                        $('#loading-image').hide();
                        alert("An error occurred: " + error);
                    }

                });
            }

        }

    }


</script>

<script>
    function onChangeGrid(e) {
        var grid = $("#EmployeePerformancegrid").data("kendoGrid");
        grid.dataSource.read();
    }

    function refreshPerformanceData() {

        var year = $("#GlFiscalYearId").data("kendoComboBox");
        var yearId = year.value();
        if (yearId == "") {
            alert("Please select the Fiscal year first!!");
        }
       
        $.ajax({
            url: '@Url.Action("RefreshPerformanceData", "EmployeePerformanceAllSummaries")',
            data: { yearId: yearId},
            type: 'POST',
            cache: false,
            success: function (result) {
              
                alert(result.Message);
               
            }

        });
    }

    var isCorprat = false;
    var isSector = false;
    var masterId = 0;
    var detailId = 0;
    var isHRApproved_Global = false; // Tracks third-level HR approval flag

    function onMasterDetailExpand(e) {
        var masterRow = e.masterRow;
        var masterGrid = $("#EmployeePerformancegrid").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.EmployeePerformanceId;
        // Capture the third-level approval status from the master row
        isHRApproved_Global = masterDataItem.IsHRApproved === true;
    }

    function onDetailExpand(e) {
        var masterRow = e.masterRow;
        var detailGrid = $("#EmployeePerformancedetailgrid_" + masterId).data("kendoGrid");
        var detailDataItem = detailGrid.dataItem(masterRow);

        detailId = detailDataItem.EmployeePerformanceId;
        isSector = detailDataItem.IsSectorApplied;
        isCorprat = detailDataItem.IsCorporateApplied;

        // Fallback check if IsHRApproved is also present on the second level
        if (detailDataItem.IsHRApproved !== undefined) {
            isHRApproved_Global = detailDataItem.IsHRApproved === true;
        }
    }

    function onDetaiDetainDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");

        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            // If third-level approval has occurred, lock and hide the edit buttons
            if (isHRApproved_Global) {
                row.find(".k-grid-edit").hide();
            } else {
                // Not approved yet by third level: keep editable (or check sector/corporate if applicable)
                if (isSector == true || isCorprat == true) {
                    row.find(".k-grid-edit").show();
                } else {
                    // If you want it always editable prior to 3rd-level approval:
                    row.find(".k-grid-edit").show();
                }
            }
        }
    }

</script>
<script>
   function onExcelExportClick() {
        // Get the reference to the grid
       var grid = $("#EmployeePerformancegrid").data("kendoGrid");
        // Get the URL for the Excel export action
        var excelExportUrl = "@Url.Action("Excel_Export_Save", "EmployeePerformanceAllSummaries")";
        // Trigger the Excel export
        grid.saveAsExcel({
            fileName: "EmployeePerformanceData.xlsx",
            proxyURL: excelExportUrl,
            allPages: true
        });
    }


    function finalLevelRejection(e)
    {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr")),
            year = dataItem.GlFiscalYearId,
            period = dataItem.GlPeriodId,
            employee = dataItem.EmployeeId;

        var confirmed = confirm("Are you sure you want to reject this performance evaluation?");
        if (!confirmed) return;

        var reason = prompt("Please provide a reason for rejection:");
        if (!reason || reason.trim() === "") {
            alert("Rejection reason is required.");
            return;
        }

        $('#loading-image').show();

        $.ajax({
            url: '@Url.Action("HRRejectionWithReason_Create", "EmployeePerformanceAllSummaries")',
            type: 'POST',
            data: {
                yearId: year,
                periodId: period,
                employeeId: employee,
                reason: reason
            },
            success: function (response) {
                $('#loading-image').hide();
                if (response.success) {
                    alert(response.message);
                    grid.dataSource.read();
                } else {
                    alert("Error: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                $('#loading-image').hide();
                alert("Server error: " + error);
            }
        });

    }

</script>