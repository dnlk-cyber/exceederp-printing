                <a onclick='return refreshAfterForNewItems("#=TrainingNeedRequestId#")' href=' \#' title="Refresh"><i class="fa fa-refresh fa-2x"></i></a>


                @(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.TrainingEducation.TrainingEvaluationAfter>()
                                .Name("TrainingEvaluationAftergrid#=TrainingNeedRequestId#")
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.TrainingEvaluationCriteriaId).Hidden().Width(150);
                                    columns.Bound(c => c.TrainingEvaluationSettingCategoryId).Hidden().Width(150);
                                    columns.Bound(c => c.TrainingNeedRequestId).Hidden().Width(150);
                                    columns.Bound(c => c.Name).Width(120);
                                    columns.Bound(c => c.Criteria).Width(200);
                                    columns.Bound(c => c.Weight).Width(200);
                                    columns.Bound(c => c.Result).Width(200);
                                    columns.Command(command =>
                                    {
                                        command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                        command.Destroy().Text(Resources.ActionButton_Cancel);

                                    }).Width(200);


                                })
                                //.ToolBar(toolbar =>
                                //{
                                //    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                //})
                                //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("TrainingRequest")
                                //.                 Window(window => { window.Title("Training Need Request form");
                                //    window.Scrollable(false); })
                                //    )
                                .Scrollable(h => h.Height(550))
                                //.Events(ev=>ev.DetailExpand("onDetailExpand"))
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Events(events =>
                                    {
                                        events.Error("error_handler(\"TrainingEvaluationAftergrid#=TrainingNeedRequestId#\")");
                                        events.RequestStart("onRequestStart(\"TrainingEvaluationAftergrid#=TrainingNeedRequestId#\")");
                                        events.RequestEnd("onRequestEnd(\"TrainingEvaluationAftergrid#=TrainingNeedRequestId#\")");

                                    })

                                    .Model(model =>
                                    {
                                        model.Id(p => p.TrainingEvaluationAfterId);
                                    })
                                    .Read(read => read.Action("TrainingEvaluationAfters_Read", "TrainingEvaluationAfters", new { reqId = "#=TrainingNeedRequestId#" }))
                                    .Create(create => create.Action("TrainingEvaluationAfters_Create", "TrainingEvaluationAfters", new { reqId = "#=TrainingNeedRequestId#" }))
                                    .Update(update => update.Action("TrainingEvaluationAfters_Update", "TrainingEvaluationAfters"))
                                    .Destroy(destroy => destroy.Action("TrainingEvaluationAfters_Destroy", "TrainingEvaluationAfters"))
                                    ).ToClientTemplate()
                                        )
                                    
           </text>);

        }).ToClientTemplate())

</script>


