<script>
    function refreshBeforeForNewItems(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("GenerateEvaluation", "TrainingEvaluationBefores", new { area = "HRM" })',
            data: { requestId: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
               // recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
    function refreshAfterForNewItems(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("GenerateEvaluationAfter", "TrainingEvaluationAfters", new { area = "HRM" })',
            data: { reqId: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
               // recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
    
</script>