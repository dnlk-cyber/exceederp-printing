@using System.Collections
@using ExceedERP.Core.Domain.HRM.TrainingEducation
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Training Plan Summary </legend>
@(Html.Kendo().Grid<NeedAssessmentSummary>()
      .Name("NeedAssessmentSummarygrid")
      .Columns(columns =>
      {

          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name")
                              .EditorTemplateName("GLFPeriod")
                              .Filterable(ftb => ftb.Multi(true).Search(true))
                              .Width(140);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["CourseList"], "LookupId", "Description")
                              .EditorTemplateName("Course")
                              .Filterable(ftb => ftb.Multi(true).Search(true))
                              .Width(130);
          columns.Bound(c => c.NoOfStaff).Width(140);
          columns.ForeignKey(c => c.MainCompanyId, (IEnumerable)ViewData["Companies"], "MainCompanyId", "TradeName")
                              .EditorTemplateName("Companies")
                              .Filterable(ftb => ftb.Multi(true).Search(true))
                              .Width(130);
          columns.Bound(c => c.CostPerPerson).Width(130);
          columns.Bound(c => c.TotalCost).Width(130);
          columns.Bound(c => c.Remark).Width(120);
          columns.Command(command =>
          {
              //    if (HttpContext.Current.User.IsInRole("HR_Training_User"))
              //    {

              //        command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              //    }
              if (HttpContext.Current.User.IsInRole("HR_Admin"))
              {
                  command.Custom("SendNotification").Click("sendCourseTrackingNotifications")
                                                        .Text("Notify Employees")
                                                        .IconClass("fa fa-bell")
                                                        .HtmlAttributes(new
                                                        {
                                                            @class = "btn btn-success",
                                                            @title = "Send course notification to assigned employees",
                                                            id = "employeeNotificationBtn"
                                                        });
                  //command.Destroy().Text(Resources.ActionButton_Cancel);
              }

          })/*.Width(190)*/;



      })
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("HR_Training_User"))
          {

              toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-left" });
              //toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });

          }



      })
      .Excel(excel => excel
      .FileName("Excel_Export_Save" + ".xlsx")
        .Filterable(true)
        .AllPages(true)
        .ProxyURL(Url.Action("Excel_Export_Save", "TrainingPlanSummary")))
        .Pdf(pdf => pdf
        .AllPages()
        .FileName(Resources.NavigatorPlacment_EmployeePlacment + ".pdf")
        .ProxyURL(Url.Action("Pdf_Export_Save", "TrainingPlanSummary")))
        .Editable(editable => editable.Mode(GridEditMode.InLine).TemplateName("TrainingPlan")
                .Window(window =>
                {
                    window.Title(Resources.NavigatorTraining_TrainingPlan);
                    window.Scrollable(false);

                }))
            .Selectable(selectable =>
            {
                selectable.Mode(GridSelectionMode.Single);
                selectable.Type(GridSelectionType.Row);

            })
            .Scrollable(h => h.Height(500))
            .Filterable()
                .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
            .DataSource(dataSource => dataSource
                .Ajax()
                .Sort(sort => sort.Add("DateCreated").Descending())
                .Events(events =>
                {
                    events.Error("error_handler(\"NeedAssessmentSummarygrid\")");
                    events.RequestStart("onRequestStart(\"NeedAssessmentSummarygrid\")");
                    events.RequestEnd("onRequestEnd(\"NeedAssessmentSummarygrid\")");


                })

                .Model(model =>
                {
                    model.Id(p => p.NeedAssessmentSummaryId);
                    model.Field(p => p.GlFiscalYearId).Editable(false);
                    model.Field(p => p.LookupId).Editable(false);
                    model.Field(p => p.NoOfStaff).Editable(false);
                    model.Field(p => p.TotalCost).Editable(false);


                })
               .Read(read => read.Action("TrainingPlanSummary_Read", "TrainingPlanSummary").Data("sendForgery"))
              //.Create(create => create.Action("NeedAssessmentSummary_Create", "NeedAssessmentSummary").Data("sendForgery"))
              //.Update(update => update.Action("NeedAssessmentSummary_Update", "NeedAssessmentSummary").Data("sendForgery"))
              //.Destroy(destroy => destroy.Action("NeedAssessmentSummary_Destroy", "NeedAssessmentSummary").Data("sendForgery"))
              ).ClientDetailTemplateId("assessment_Summary_details")
)
