                                    .Update(update => update.Action("TrainingEvaluationBefores_Update", "TrainingEvaluationBefores"))
                                    .Destroy(destroy => destroy.Action("TrainingEvaluationBefores_Destroy", "TrainingEvaluationBefores"))
                                    ).ToClientTemplate()
