<script>


    function sendCourseTrackingNotifications(e)
    {
         e.preventDefault();
         var grid = $("#NeedAssessmentSummarygrid").data("kendoGrid");
         var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));
            $.ajax({
                url: '@Url.Action("SendCourseTrackingNotifications", "TrainingPlanSummary", new { area="HRM"})',
                type: 'POST',
                data: { needAssessmentSummaryId: dataItem.NeedAssessmentSummaryId },
                success: function (res) {
                    if (res.Success) {
                        alert("✅ " + res.Message);
                    } else {
                        alert("⚠️ " + res.Message);
                    }
                },
                error: function () {
                    alert("❌ Something went wrong while sending notifications. Please try again.");
                }
            });

    }

    function refreshBeforeForNewItems(id)
    {

        $.ajax({
            type: "POST",
            url: '@Url.Action("GenerateEvaluation", "TrainingEvaluationBefores", new { area = "HRM" })',
            data: { requestId: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
               // recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function refreshAfterForNewItems(id)
    {

        $.ajax({
            type: "POST",
            url: '@Url.Action("GenerateEvaluationAfter", "TrainingEvaluationAfters", new { area = "HRM" })',
            data: { reqId: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
               // recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });

    }
    
</script>