@helper summaryDetail() { 
    @(Html.Kendo().Grid<NeedAssessment>()
            .Name("NeedAssessmentDetailgrid#=NeedAssessmentSummaryId#")
            .Columns(columns =>
            {
                columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["allDepartments"], "OrgStructureId", "Name").EditorTemplateName("Department").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                columns.ForeignKey(c => c.RequiredTraining, (IEnumerable)ViewData["TargetGroup"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                columns.Bound(c => c.NoOfStaff).Width(100);
                columns.Bound(c => c.TotalDays).Width(140);
                columns.Bound(c => c.Remark);

                
            })
           

               
              .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events =>
                {
                    events.Error("error_handler(\"NeedAssessmentDetailgrid#=NeedAssessmentSummaryId#\")");
                    events.RequestStart("onRequestStart(\"NeedAssessmentDetailgrid#=NeedAssessmentSummaryId#\")");
                    events.RequestEnd("onRequestEnd(\"NeedAssessmentDetailgrid#=NeedAssessmentSummaryId#\")");
                })

                .Model(model => model.Id(p => p.AssesmentId))
                .Read(read => read.Action("NeedAssessmentSummaryDetail_Read", "NeedAssessment",new { area="HRM",id= "#=NeedAssessmentSummaryId#" }).Data("sendForgery"))
            //.Create(create => create.Action("NeedAssessments_Create", "NeedAssessment").Data("sendForgery"))
