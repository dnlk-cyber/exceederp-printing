@using System.Collections
@using ExceedERP.Core.Domain.HRM.RecruitmentManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>Internal Recruitment Criteria Type Settings</Legend>
@(Html.Kendo().Grid<InternalRecruitmentCriteriaTypeSetting>()
        .Name("ExamTypeSettinggrid")
        .Columns(columns =>
        {
            columns.Bound(c => c.InternalRecruitmentCriteriaTypeSettingId).Title("#").Width(80);
            columns.Bound(c => c.ExamType).Width(150);
            columns.Bound(c => c.ExamSource).Width(150);
            columns.Bound(c => c.IsPercent).ClientTemplate(
                "<input type='checkbox' disabled = 'true' value='#=IsPercent#' " +
                "# if (IsPercent) { #" +
                "checked='checked'" +
                "# } #" +
                "/>").Width(120);
            columns.Bound(c => c.Squence).Width(120);
            columns.Bound(c => c.SettingVlaue).Title("Weight").Width(120);
            columns.Bound(c => c.Rate).Width(120);
            columns.Bound(c => c.Remark).Width(120);
            columns.Command(command =>
            {
                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                command.Destroy().Text(Resources.ActionButton_Cancel);

            }).Width(200);

        })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(500))
            .Sortable(sortable =>
            {
                sortable.SortMode(GridSortMode.SingleColumn);
            })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
                    .Events(events =>
                    {
                        events.Error("error_handler(\"ExamTypeSettinggrid\")");
                        events.RequestStart("onRequestStart(\"ExamTypeSettinggrid\")");
                        events.RequestEnd("onRequestEnd(\"ExamTypeSettinggrid\")");
                    })

              .Model(model => {
                  model.Id(p => p.InternalRecruitmentCriteriaTypeSettingId);
                  model.Field(p => p.InternalRecruitmentCriteriaTypeSettingId).Editable(false);

              })
                .Read(read => read.Action("Read", "InternalRecruitmentCriteriaTypeSettings").Data("sendForgery"))
                .Create(create => create.Action("Create", "InternalRecruitmentCriteriaTypeSettings").Data("sendForgery"))
                .Update(update => update.Action("Update", "InternalRecruitmentCriteriaTypeSettings").Data("sendForgery"))
                .Destroy(destroy => destroy.Action("Destroy", "InternalRecruitmentCriteriaTypeSettings").Data("sendForgery"))
          )
)
<script>
   
    function sync_handler(e) {
        this.read();

    }

</script>