@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Send Letter</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.LetterSender>()
          .Name("LetterSendergrid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Date);
        columns.Bound(c => c.Receiver);
        columns.Bound(c => c.Description);
        columns.Bound(c => c.Sender);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
                .Events(events =>
                                                                 {
                                                                     events.Error("error_handler(\"LetterSendergrid\")");
                                                                     events.RequestStart("onRequestStart(\"LetterSendergrid\")");
                                                                     events.RequestEnd("onRequestEnd(\"LetterSendergrid\")");
                                                                 })
                      
          .Model(model => model.Id(p => p.LetterSenderId))
          .Read(read => read.Action("LetterSenders_Read", "LetterSender"))
          .Create(create => create.Action("LetterSenders_Create", "LetterSender"))
          .Update(update => update.Action("LetterSenders_Update", "LetterSender"))
          .Destroy(destroy => destroy.Action("LetterSenders_Destroy", "LetterSender"))
      )
)
