    var masterId = 0;
    function onDetailExpand(e) {
        var masterRow = e.masterRow;
        var masterGrid = $("#grid").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.ClearanceRequestId;
    }

    function departmentApproval(e)
    {
        // Get the closest row to the event target
        var row = $(e.target).closest("tr");
    
        // Get the Kendo Grid instance
            var grid = $("#grid").data("kendoGrid");
    
        // Get the data item for the selected row
        var dataItem = grid.dataItem(row);
    
        // Extract the ClearanceRequestId from the data item
        var id = dataItem.ClearanceRequestId;
    
        // Check if the id is valid (non-empty and defined)
        if (id) {
            // Show loading image during the request
            $('#loading-image').show();
        
            // Make an AJAX POST request to the server for approval
            $.ajax({
                url: '@Url.Action("DepartmentApproval", "ClearanceRequestDepartments")', // Server-side action
                data: { id: id }, // Pass the id to the server
                type: 'POST',
                cache: false,
            
                // On success, show the result message, hide loading, and refresh the grid
                success: function (result) {
                    alert(result.Message); // Show the success message from the server
                    $('#loading-image').hide(); // Hide the loading image
                    grid.dataSource.read(); // Refresh the grid data to reflect changes
                },
            
                // Handle any errors during the AJAX request
                error: function (xhr, status, error) {
                    console.log("Error: " + error); // Log the error for debugging
                    alert("An error occurred while processing the request. Please try again.");
                    $('#loading-image').hide(); // Ensure the loading image is hidden on error
                }
            });

        }
        else {
            // If the id is invalid, show an alert
            alert("Clearance Request ID is missing.");
        }

    }
