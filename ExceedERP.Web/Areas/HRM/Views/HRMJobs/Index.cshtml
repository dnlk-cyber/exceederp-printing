
@(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.Payroll.Addition>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.GLPeriodId);
        columns.Bound(c => c.Amount);
        columns.Bound(c => c.AdditionTaxType);
        columns.Bound(c => c.OrgBranchName);
        columns.Bound(c => c.DateCreated);
        columns.Bound(c => c.LastModified);
        columns.Bound(c => c.CreatedBy);
        columns.Bound(c => c.ModifiedBy);
      })
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Read(read => read.Action("Additions_Read", "HRMJobs"))
      )
)
