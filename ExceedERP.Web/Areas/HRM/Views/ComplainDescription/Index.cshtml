<legend>Complain Description</legend>
@(Html.Kendo().Grid<Complain>()
                          .Name("Complain")
                          .Columns(columns =>
                          {
                              columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["Employees"], "EmployeeId", "FullNameaEnglish").Width(140);
                              columns.Bound(c => c.DateAmharic).EditorTemplateName("Calander").Width(100);
                              columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["TypeList"], "LookupId", "Description").EditorTemplateName("LookUpList").Width(140);
                              columns.Bound(c => c.ComplainDescription).Title("Complain Description").Width(300);
                              columns.ForeignKey(c => c.RefersTo, (IEnumerable)ViewData["RefersTo"], "OrgStructureId", "Name").EditorTemplateName("OrganizationDept").Width(150);

                  //columns.ForeignKey(c => c.CC, (IEnumerable)ViewData["CC"], "OrgStructureId", "Name").EditorTemplateName("OrganizationDept").Width(150);
                  // columns.ForeignKey(c => c.RefersTo, (IEnumerable)ViewData["RefersTo"], "OrgStructureId", "Name").EditorTemplateName("OrganizationDept").Width(200);

                  columns.Bound(c => c.Remark).Width(100);
                  // columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
              })
                          //.ToolBar(toolbar =>
                          //{
                          //    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          //})
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Scrollable(h => h.Height(500))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          .Filterable()
                          .Events(e =>
                          {
                              e.Save("GetDate");

                              e.Edit("GetDate");
                          })
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                                  .Events(events =>
                                  {
                                      events.Error("error_handler(\"Complain\")");
                                      events.RequestStart("onRequestStart(\"Complain\")");
                                      events.RequestEnd("onRequestEnd(\"Complain\")");
                                  })

                              .Model(model => model.Id(p => p.ComplainId))
                              .Read(read => read.Action("ComplainDescription_Read", "ComplainDescription"))
                              .Create(create => create.Action("ComplainDescription_Create", "ComplainDescription", new { Area = "HRM" }))
                              .Update(update => update.Action("ComplainDescription_Update", "ComplainDescription"))
                              .Destroy(destroy => destroy.Action("ComplainDescription_Destroy", "ComplainDescription"))

                         ).ClientDetailTemplateId("template")
)
