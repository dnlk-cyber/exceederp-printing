@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.HRM
@using ExceedERP.Core.Localization

@(Html.Kendo().DropDownListFor(x => x)

          .DataValueField("PersonId")
                        .DataTextField("FullName")
                           .OptionLabel(Resources.Select)
                            .Filter("contains")
                            .MinLength(2)
      .HtmlAttributes(new { style = "width:200px" })
      .Virtual(v => v.ValueMapper("valueMapper").ItemHeight(26))
      .DataSource(source =>
      {
          source.Read(read =>
          {
              read.Action("GetEmployeesAskForOther", "HRMDataProvider");
              //.Data("IsforOthers");
          })
              .ServerFiltering(false);
      })
      //.Enable(false)
      .ValuePrimitive(true)


      .Height(400)
      .HeaderTemplate("<div class=\"dropdown-header k-widget k-header\">" +
                      "<span>Photo</span>" +
                      "<span>Full Name</span>" +
                      "</div>")
      .Template(@"<div class='Employee-photo' style='background-image: url(" + Url.Content("~/Content/Images/") + "#:data.PersonId#-Photo/" + "#:data.PersonId#."+"#:data.ImageType#" + ");'></div>" +
                "<div class='Employee-name'>#:FullName#</div>")
      )


<style>
    .dropdown-header {
        border-width: 0 0 1px 0;
        text-transform: uppercase;
    }

        .dropdown-header > span {
            display: inline-block;
            padding: 10px;
        }

            .dropdown-header > span:first-child {
                width: 50px;
            }

    #customers-list .k-item {
        line-height: 1em;
        min-width: 300px;
    }

    /* Material Theme padding adjustment*/

    .k-material #customers-list .k-item,
    .k-material #customers-list .k-item.k-state-hover,
    .k-materialblack #customers-list .k-item,
    .k-materialblack #customers-list .k-item.k-state-hover {
        padding-left: 5px;
        border-left: 0;
    }

    #customers-list .k-item > span {
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        box-sizing: border-box;
        display: inline-block;
        vertical-align: top;
        margin: 20px 10px 10px 5px;
    }

        #customers-list .k-item > span:first-child {
            -moz-box-shadow: inset 0 0 30px rgba(0, 0, 0, .3);
            -webkit-box-shadow: inset 0 0 30px rgba(0, 0, 0, .3);
            box-shadow: inset 0 0 30px rgba(0, 0, 0, .3);
            margin: 10px;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background-size: 100%;
            background-repeat: no-repeat;
        }

    #customers-list h3 {
        font-size: 1.2em;
        font-weight: normal;
        margin: 0 0 1px 0;
        padding: 0;
    }

    #customers-list p {
        margin: 0;
        padding: 0;
        font-size: .8em;
    }
</style>

<style>
    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }

    .Employee-Id {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>
