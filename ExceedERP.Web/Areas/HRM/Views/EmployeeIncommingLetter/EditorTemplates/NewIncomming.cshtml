@using System.Collections
@using Kendo.Mvc.UI
@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.NewIncommingLetter 


<form>

    <div class="row">
        <div class="col-md-1">

        </div>
      

        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.FolderNo, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">
                @Html.Kendo().TextBoxFor(model => model.FolderNo)
                @Html.ValidationMessageFor(model => model.FolderNo, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.LetterReferenceNo, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">
                @Html.Kendo().TextBoxFor(model => model.LetterReferenceNo)
                @Html.ValidationMessageFor(model => model.LetterReferenceNo, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.LetterDate, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>

                    @Html.Kendo().DatePickerFor(model => model.LetterDate)
                    @Html.ValidationMessageFor(model => model.LetterDate, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

    </div>

    <br />


    <div class="row">
        <div class="col-md-1">

        </div>

        
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.InstitutionTypeId, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @(Html.Kendo().DropDownListFor(model => model.InstitutionTypeId)
                 
                  .OptionLabel(Resources.Select)
                                                   .BindTo((IEnumerable)ViewData["InstuType"])
                                                  .DataTextField("InstitutionName")
                                                  .DataValueField("InstitutionTypeId")
                                           .ValuePrimitive(true)
                )
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.OwnerName, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.OwnerName)
                @Html.ValidationMessageFor(model => model.OwnerName, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.RecivedDate, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().DatePickerFor(model => model.RecivedDate)
                @Html.ValidationMessageFor(model => model.RecivedDate, "", new { @class = "text-danger" })
            </div>
        </div>


    </div>
    <br />
    <div class="row">
        <div class="col-md-1">

        </div>

        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Subject, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.Subject)
                @Html.ValidationMessageFor(model => model.Subject, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Shelve, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.Shelve)
                @Html.ValidationMessageFor(model => model.Shelve, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Row, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.Row)
                @Html.ValidationMessageFor(model => model.Row, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-1">

        </div>
        
        

        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.FileNo, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.FileNo)
                @Html.ValidationMessageFor(model => model.FileNo, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.SerialNo, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.SerialNo)
                @Html.ValidationMessageFor(model => model.SerialNo, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.NoOfAttachment, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.NoOfAttachment)
                @Html.ValidationMessageFor(model => model.NoOfAttachment, "", new { @class = "text-danger" })
            </div>
        </div>

    </div>


    <div class="row">
        <div class="col-md-1">

        </div>


        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div class="form-group">

                @Html.TextAreaFor(model => model.Remark)
                @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
            </div>
        </div>

    </div>
</form>
<style>
    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>