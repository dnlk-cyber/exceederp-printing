@using System.Collections
@using ExceedERP.Helpers.Common
@using ExceedERP.Core.Domain.Common
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.EmployeeDetail.Complain

@using ExceedERP.Core.Localization

<div class="form">
    <div class="row fullrow">

        <div class="col-md-1 row">
        </div>

        <div class="col-md-3 row">

            @*<div class="form-group">
            @Html.LabelFor(model => model.DateAmharic, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.DateAmharic, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />

                @Html.ValidationMessageFor(model => model.DateAmharic, "", new { @class = "text-danger" })
            </div>
        </div>*@


            <div class="form-group">
                @Html.LabelFor(model => model.LookupId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.LookupId)
                                    .DataValueField("LookupId")
                                    .DataTextField("Name")
                                    .OptionLabel(Resources.Select)
                                    .Filter("contains")
                                    .MinLength(2)
                                    //.HtmlAttributes(new { style = "width:200px" })
                                    .DataSource(source =>
                                    {
                                        source.Read(read =>
                                        {
                                            read.Action("GetComplaintType", "HRMDataProvider");
                                        })
                                            .ServerFiltering(false);
                                    })
                                    .ValuePrimitive(true)


                                    .Height(400)

                    )



                </div>

            </div>


            <div class="form-group">

                @Html.LabelFor(model => model.RefersTo, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">

                    @(Html.Kendo().DropDownListFor(m => m.RefersTo)
                                   .DataTextField("Name")
                                   .DataValueField("OrgStructureId")
                                   .OptionLabel(Resources.Select)
                                   .Filter(Resources.Select)
                                   .ValuePrimitive(true)
                                   .DataSource(dataSource =>
                                   {
                                       dataSource.Read(read => read.Action("GetDepartmentForComplaints", "HRMDataProvider", new { area = "HRM" }))
                                           .ServerFiltering(false);
                                   })

                    )

                    @Html.ValidationMessageFor(model => model.RefersTo, "", new { @class = "text-danger" })
                </div>
            </div>


        </div>


        <div class="col-md-3 row">

            <div class="form-group">
                @Html.LabelFor(model => model.ComplainDescription, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-10">

                    @Html.TextAreaFor(model => model.ComplainDescription, new { @style = " rows=10, cols=40" })
                    @Html.ValidationMessageFor(model => model.ComplainDescription, "", new { @class = "text-danger" })
                </div>
            </div>          

        </div>

        <div class="col-md-3 row">

            <div class="form-group">
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-10">
                    @Html.Kendo().TextBoxFor(model => model.Remark)

                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>


        </div>

        <div class="col-md-1 row">
        </div>

    </div>

    </div>


