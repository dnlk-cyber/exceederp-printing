                                                  events.RequestEnd("onRequestEnd(\"ComplainCC#=ComplainId#\")");
                                              })

                                                                                                                
                                                      .Model(model => model.Id(p => p.ComplainCCId))
                                                   .Read(read => read.Action("ComplainCCDetail_Read", "ComplainCC", new { id = "#=ComplainId#" }))
                                                   .Create(create => create.Action("ComplainCCDetail_Create", "ComplainCC", new { id = "#=ComplainId#" }))
                                                  .Update(update => update.Action("ComplainCCDetail_Update", "ComplainCC"))
                                                  .Destroy(destroy => destroy.Action("ComplainCCDetail_Destroy", "ComplainCC"))

                                                                                                                      ).ToClientTemplate()
                                                                    )

                                                                </text>
                                                                                                                          );

                                                             //**********************************************************************************//
                                                             items.Add().Text("Response").Content(
                                                                        @<text>


                                                                            @(Html.Kendo().Grid<ComplainDetail>()
                                                                                         .Name("ComplainDetail#=ComplainId#")
                                                                         .Columns(columns =>
                                                                         {

                                                                             columns.Bound(c => c.Response).Width(200);
                                                                             columns.Bound(c => c.DateAm).Width(50);
                                                                             //columns.Bound(c => c.IsCurrent).Width(100);
                                                                             //columns.Command(command =>
                                                                             //{

                                                                             //    //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                                                             //    //command.Destroy().Text(Resources.ActionButton_Cancel);

                                                                             //}).Width(20);
                                                                         })

                                                                         .ToolBar(toolbar =>
                                                                         {
                                                                             //toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                                                         })

                                                                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                          .Scrollable()
                                                                          .Selectable()
                                                                          .DataSource(dataSource => dataSource
                                                                              .Ajax()
                                                                                      .Events(events =>
                                                                                      {
                                                                                          events.Error("error_handler(\"ComplainDetail#=ComplainId#\")");
                                                                                          events.RequestStart("onRequestStart(\"ComplainDetail#=ComplainId#\")");
                                                                                          events.RequestEnd("onRequestEnd(\"ComplainDetail#=ComplainId#\")");
                                                                                      })

                                                                                                                             
                                                              .Model(model => model.Id(p => p.ComplainDetailId))
                                                           .Read(read => read.Action("ComplainDetail_Read", "ComplainDetail", new { id = "#=ComplainId#" }))
                                                           .Create(create => create.Action("ComplainDetail_Create", "ComplainDetail", new { id = "#=ComplainId#" }))
                                                          .Update(update => update.Action("ComplainDetail_Update", "ComplainDetail"))
                                                          .Destroy(destroy => destroy.Action("ComplainDetail_Destroy", "ComplainDetail"))

                                                                           ).ToClientTemplate()
                                                                            )

                                                                        </text>
                                                                            );




                                                                             }).ToClientTemplate())
</script>



