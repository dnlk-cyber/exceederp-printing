@using System.Collections
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Complain Request</legend>
@(Html.Kendo().Grid<Complain>()
          .Name("Complain")
          .Columns(columns =>
          {
              columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["Employees"], "EmployeeId", "FullNameaEnglish").Width(140);
              columns.Bound(c => c.DateAmharic).EditorTemplateName("Calander").Width(80);
              columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["TypeList"], "LookupId", "Description").EditorTemplateName("LookUpList").Width(100);
              columns.Bound(c => c.ComplainDescription).Title("Complain Description").Width(360);
              columns.ForeignKey(c => c.RefersTo, (IEnumerable)ViewData["Orgs"], "OrgStructureId", "Name").EditorTemplateName("OrganizationDept").Width(150);

              //columns.ForeignKey(c => c.CC, (IEnumerable)ViewData["CC"], "OrgStructureId", "Name").EditorTemplateName("OrganizationDept").Width(150);
              // columns.ForeignKey(c => c.RefersTo, (IEnumerable)ViewData["RefersTo"], "OrgStructureId", "Name").EditorTemplateName("OrganizationDept").Width(200);

              columns.Bound(c => c.Remark).Width(100);

              columns.Command(command =>
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }).Width(200);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ComplainRequest").Window(window => { window.Title("Complain Request"); window.Scrollable(false); }))
          .Scrollable(h => h.Height(500))
          .Selectable(selectable =>
          {
              selectable.Mode(GridSelectionMode.Single);
              selectable.Type(GridSelectionType.Row);
          })
          .Groupable()
          .Sortable(sortable =>
          {
              sortable.SortMode(GridSortMode.SingleColumn);
          })
          .Filterable()
          .Events(e =>
          {
              e.Save("GetDate");
              e.Edit("GetDate");
          })
          .Pageable(pageable => pageable
              .Input(true)
              .Numeric(false)
              .Refresh(true)
              .PageSizes(true)
              .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
                  .Events(events =>
                  {
                      events.Error("error_handler(\"Complain\")");
                      events.RequestStart("onRequestStart(\"Complain\")");
                      events.RequestEnd("onRequestEnd(\"Complain\")");
                  })

              .Model(model =>
              {
                  model.Id(p => p.ComplainId);
              })
              .Read(read => read.Action("Complains_Read", "Complain"))
              .Create(create => create.Action("Complainss_Create", "Complain", new { Area = "HRM" }))
              .Update(update => update.Action("Complains_Update", "Complain"))
              .Destroy(destroy => destroy.Action("Complains_Destroy", "Complain"))

         ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                              .Name("tabstrip_#=ComplainId#")
                      .SelectedIndex(0)
                      .Items(items =>
                       {


               //*****************************************************************************************************//
               items.Add().Text("CC").Content(
                          @<text>


                              @(Html.Kendo().Grid<ComplainCC>()
                                    .Name("ComplainCC#=ComplainId#")
                                   .Columns(columns =>
                                   {
                                                                   
                                              columns.ForeignKey(c => c.CC, (IEnumerable)ViewData["CC"], "OrgStructureId", "Name").EditorTemplateName("OrganizationDept").Width(150);
                                              //columns.Bound(c => c.IsCurrent).Width(100);
                                              columns.Command(command =>
                                              {

                                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                                  command.Destroy().Text(Resources.ActionButton_Cancel);

                                              }).Width(100);
                                          })

                                          .ToolBar(toolbar =>
