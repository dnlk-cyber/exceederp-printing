@using ExceedERP.Core.Domain.HRM.Discipline
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@(Html.Kendo().Grid<DisciplineMeasuresDetail>()
          .Name("DisciplineMeasuresDetailgrid")
      .Columns(columns =>
      {
          //columns.Bound(c => c.MeasuresId);
          columns.Bound(c => c.Level);
          columns.Bound(c => c.Description);
          columns.Bound(c => c.Remark);
          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(200);
      })
      .ToolBar(toolbar => {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Selectable(selectable => {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
          .Scrollable(h => h.Height(500))
             .Groupable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Events(events =>
               {
                   events.Error("error_handler(\"DisciplineMeasuresDetailgrid\")");
                   events.RequestStart("onRequestStart(\"DisciplineMeasuresDetailgrid\")");
                   events.RequestEnd("onRequestEnd(\"DisciplineMeasuresDetailgrid\")");
               })

          .Model(model => model.Id(p => p.DetailMeasuresId))
              .Read(read => read.Action("DisciplineMeasuresDetail_Read", "DisciplineMeasuresDetailCourt"))
              .Create(create => create.Action("DisciplineMeasuresDetail_Create", "DisciplineMeasuresDetailCourt"))
              .Update(update => update.Action("DisciplineMeasuresDetail_Update", "DisciplineMeasuresDetailCourt"))
              .Destroy(destroy => destroy.Action("DisciplineMeasuresDetail_Destroy", "DisciplineMeasuresDetailCourt"))
      )
      )
