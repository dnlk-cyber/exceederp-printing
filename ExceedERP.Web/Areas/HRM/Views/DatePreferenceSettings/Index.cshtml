@using System.Collections
@using ExceedERP.Core.Domain.HRM.Company
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Date Preference Settings </legend>
@(Html.Kendo().Grid<DatePreferenceSetting>()
    .Name("EmployeeProbationSettinggrid")
    .Columns(columns =>
    {

        columns.Bound(c => c.DatePreferenceSettingId).Title("S.N").Width (95);
        columns.Bound(c => c.UseEthiopianDate).ClientTemplate(
            "<input type='checkbox' disabled = 'true' value='#= UseEthiopianDate#' " +
            "# if (UseEthiopianDate) { #" +
            "checked='checked'" +
            "# } #" +
            "/>").Width (200);
        columns.Bound(c => c.Remark).Width(150);

        columns.Command(command =>
        {
            command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
            command.Destroy().Text(Resources.ActionButton_Cancel);

        });
    })
    .ToolBar(toolbar => {
        toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
    })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Scrollable(h => h.Height(500))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Filterable()
        .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events =>
        {
            events.Error("error_handler(\"EmployeeProbationSettinggrid\")");
            events.RequestStart("onRequestStart(\"EmployeeProbationSettinggrid\")");
            events.RequestEnd("onRequestEnd(\"EmployeeProbationSettinggrid\")");

        })
        .Model(model =>
        {
            model.Id(p => p.DatePreferenceSettingId);
            model.Field(p => p.DatePreferenceSettingId).Editable(false);
            model.Field(p => p.Remark).Editable(false);
        })
        .Read(read => read.Action("DatePreferenceSettings_Read", "DatePreferenceSettings").Data("sendForgery"))
        .Create(create => create.Action("DatePreferenceSettings_Create", "DatePreferenceSettings").Data("sendForgery"))
        .Update(update => update.Action("DatePreferenceSettings_Update", "DatePreferenceSettings").Data("sendForgery"))
        .Destroy(destroy => destroy.Action("DatePreferenceSettings_Destroy", "DatePreferenceSettings").Data("sendForgery"))
      )
)
