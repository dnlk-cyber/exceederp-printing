<script>
    function CheckDisablity(e) {
        var answer = $("#btnAnswer").data("kendoButton");
        var transfer = $("#btnTransfer").data("kendoButton");
        var dwonload = $("#btnDownload").data("kendoButton");

        var grid = $("#RecivedLetters").data("kendoGrid");

        var dataItem = grid.dataItem(grid.select());
        var id = dataItem.LetterSenderId;

        $.ajax({
            url: '@Url.Action("CheckStatus", "SentLetter")',
            contentType: "application/json; charset=utf-8",
            data: { 'id': id },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "c") {
                    answer.enable(true);
                    transfer.enable(true);


                } else {
                    answer.enable(false);
                    transfer.enable(false);


                }
            }

        });


    }
</script>