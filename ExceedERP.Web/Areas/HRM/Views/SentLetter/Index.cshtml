@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorArchiveManagement_SentLetter</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.LetterSender>()
              .Name("RecivedLetters")
      .Columns(columns =>
      {
          columns.Bound(c => c.Date);
          columns.Bound(c => c.OwnerName);
          columns.Bound(c => c.Sender);
          columns.Bound(c => c.Receiver);
          columns.Bound(c => c.Description);
          columns.Bound(c => c.Status).EditorTemplateName("Status") ;
          columns.Bound(c => c.StatusName).Visible(false);
          columns.Bound(c => c.FileName).ClientTemplate(Html.ActionLink("DownLoad", "DownloadFile", new { filename = "#=LetterSenderId#" }).ToHtmlString());
         // columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Template(@<text>
            <div class="toolbar">

                @(Html.Kendo().Button()
        .Name("btnAnswer")
                .HtmlAttributes(new { type = "button", @class = "k-primary", width = "200px" })
                        .Events(e => e.Click("Answer"))
                      .Content("Answer"))

                @(Html.Kendo().Button()
        .Name("btnTransfer")
        .HtmlAttributes(new { type = "button", @class = "k-primary", width = "200px" })
                        .Events(e => e.Click("Transfer"))
                      .Content("Transfer"))

                @*@(Html.Kendo().Button()
                    .Name("btnDownload")
                    .HtmlAttributes(new { type = "button", @class = "k-primary", width = "200px" })
                                    .Events(e => e.Click("Download"))
                                                  .Content("Download"))*@

            </div>
        </text>);
      })
                         .Editable(editable => editable.Mode(GridEditMode.InLine))
                              .Events(ev => ev.DataBinding("onDataBound"))
                            .Scrollable(h => h.Height(500))
                                                  .Selectable(selectable =>
                             {
                                 selectable.Mode(GridSelectionMode.Single);
                                 selectable.Type(GridSelectionType.Row);
                             })
                                         .Groupable()
                                                  .Sortable(sortable =>
                                                  {
                                                      sortable.SortMode(GridSortMode.SingleColumn);
                                                  })
                                      .Filterable()
                                         .Pageable(pageable => pageable
                                                                    .Input(true)
                                                                    .Numeric(false)
                                                                    .Refresh(true)
                                                                    .PageSizes(true)
                                                                    .ButtonCount(5))
                                                                                        .Events(x => x.Change("CheckDisablity"))
      .DataSource(dataSource => dataSource
          .Ajax()
                               .Events(events =>
                             {
                                 events.Error("error_handler(\"RecivedLetters\")");
                                 events.RequestStart("onRequestStart(\"RecivedLetters\")");
                                 events.RequestEnd("onRequestEnd(\"RecivedLetters\")");
                             })
                                                                      
          .Model(model => model.Id(p => p.LetterSenderId))
                                                  .Read(read => read.Action("LetterSender_Read", "SentLetter"))
                                                  .Create(create => create.Action("LetterSender_Create", "SentLetter"))
                                                  .Update(update => update.Action("LetterSender_Update", "SentLetter"))
                                                  .Destroy(destroy => destroy.Action("LetterSender_Destroy", "SentLetter"))
      )
)
