@using System.Collections
@using ExceedERP.Core.Domain.HRM.RecruitmentManagment
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.TrainingEducation

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.Training_Evaluation_Criteria_Category</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.TrainingEducation.TrainingEvaluationCriteriaCategory>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.Bound(c => c.Name);
              columns.Command(command => {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
              }).Width(180);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(500))
                     // .Groupable()

                     .Pageable(pageable => pageable
                                  .Input(true)
                                  .Numeric(false)
                                      .Refresh(true)
                                     .PageSizes(true)
              .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Model(model => model.Id(p => p.TrainingEvaluationSettingCategoryId))
              .Read(read => read.Action("TrainingEvaluationCriteriaCategories_Read", "TrainingEvaluationCriteriaCategories"))
              .Create(create => create.Action("TrainingEvaluationCriteriaCategories_Create", "TrainingEvaluationCriteriaCategories"))
              .Update(update => update.Action("TrainingEvaluationCriteriaCategories_Update", "TrainingEvaluationCriteriaCategories"))
              .Destroy(destroy => destroy.Action("TrainingEvaluationCriteriaCategories_Destroy", "TrainingEvaluationCriteriaCategories"))
          ).ClientDetailTemplateId("detail")
)


<script id="detail" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("tabstrip2_#=TrainingEvaluationSettingCategoryId#")
            .SelectedIndex(0)
            .Items(items =>
             {

                 items.Add().Text(Resources.Interviewers).Content(
                    @<text>

                        @(Html.Kendo().Grid<TrainingEvaluationCriteria>()
                                  .Name("TrainingEvaluationCriteriaGrid#=TrainingEvaluationSettingCategoryId#")
                      .Columns(columns =>
                      {
                          columns.Bound(c => c.Criteria).Width(350);
                          columns.Bound(c => c.Weight).Width(120);
                          columns.Bound(c => c.Result).Width(120);

                          columns.Command(command =>
                          {

                              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);

                              command.Destroy().Text(Resources.ActionButton_Cancel);

                          });
                      })
                      .ToolBar(toolbar =>
                      {
                          if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              //toolbar.Custom().Text("Add New Applicant").HtmlAttributes(new { id = "customCommand" });
                          }
                      })
                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                      .Scrollable(h => h.Height(500))

                      .DataSource(dataSource => dataSource
                          .Ajax()
                                  .Events(events =>
                                  {
                                      events.Error("error_handler(\"TrainingEvaluationCriteriaGrid#=TrainingEvaluationSettingCategoryId#\")");
                                      events.RequestStart("onRequestStart(\"TrainingEvaluationCriteriaGrid#=TrainingEvaluationSettingCategoryId#\")");
                                      events.RequestEnd("onRequestEnd(\"TrainingEvaluationCriteriaGrid#=TrainingEvaluationSettingCategoryId#\")");
                                  }
                                            )

                                  .Model(model =>
                                              model.Id(p => p.TrainingEvaluationCriteriaId))
                                  .Read(read => read.Action("TrainingEvaluationCriterias_Read", "TrainingEvaluationCriteria", new { Area = "HRM", id = "#=TrainingEvaluationSettingCategoryId#" }))
                                  .Create(create => create.Action("TrainingEvaluationCriterias_Create", "TrainingEvaluationCriteria", new { Area = "HRM", id = "#=TrainingEvaluationSettingCategoryId#" }))
                                  .Update(update => update.Action("TrainingEvaluationCriterias_Update", "TrainingEvaluationCriteria"))
                                  .Destroy(destroy => destroy.Action("TrainingEvaluationCriterias_Destroy", "TrainingEvaluationCriteria"))
                      ).ToClientTemplate()
                        )
                    </text>
                    );


            }).ToClientTemplate())
</script>
