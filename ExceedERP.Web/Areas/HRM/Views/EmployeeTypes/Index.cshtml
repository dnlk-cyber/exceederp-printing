@using System.Collections
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.EmployeeType</legend>
@(Html.Kendo().Grid<EmployeeType>()
              .Name("grid")
              .Columns(columns =>
              {
                  columns.Bound(c => c.Name);
                  
                  columns.Bound(c => c.Remark);
                  columns.Command(command => {
                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                      command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
              })
              .ToolBar(toolbar =>
              {
                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
              })
              .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Scrollable(h => h.Height(500))

                //.Groupable()
                .Sortable(sortable =>
                {
                    sortable.SortMode(GridSortMode.SingleColumn);
                })
                .Filterable()
                .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
              .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events =>
                {
                    events.Error("error_handler(\"grid\")");
                    events.RequestStart("onRequestStart(\"grid\")");
                    events.RequestEnd("onRequestEnd(\"grid\")");
                })

                .Model(model =>
                {
                    model.Id(p => p.EmployeeTypeId);
                })
                .Read(read => read.Action("EmployeeTypes_Read", "EmployeeTypes"))
                .Create(create => create.Action("EmployeeType_Create", "EmployeeTypes"))
                .Update(update => update.Action("EmployeeType_Update", "EmployeeTypes"))
                .Destroy(destroy => destroy.Action("EmployeeType_Destroy", "EmployeeTypes"))
              )
)
<script>
   
</script>