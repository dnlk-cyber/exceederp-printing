@using System.Collections
@using ExceedERP.Core.Domain.HRM.LeaveManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.SickLeaveSetting</Legend>
@(Html.Kendo().Grid<SickLeaveSetting>()
          .Name("SickLeaveSettinggrid")
          .Columns(columns =>
          {
              columns.Bound(c => c.CurrentValue).Width(200);
              columns.Command(command =>
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }).Width(200);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
                  .Events(events =>
                  {
                      events.Error("error_handler(\"SickLeaveSettinggrid\")");
                      events.RequestStart("onRequestStart(\"SickLeaveSettinggrid\")");
                      events.RequestEnd("onRequestEnd(\"SickLeaveSettinggrid\")");
                  })

              .Model(model => model.Id(p => p.SickLeaveSettingId))
              .Read(read => read.Action("SickLeaveSetting_Read", "SickLeaveSetting"))
              .Create(create => create.Action("SickLeaveSetting_Create", "SickLeaveSetting"))
              .Update(update => update.Action("SickLeaveSetting_Update", "SickLeaveSetting"))
              .Destroy(destroy => destroy.Action("SickLeaveSetting_Destroy", "SickLeaveSetting"))
          )
)
