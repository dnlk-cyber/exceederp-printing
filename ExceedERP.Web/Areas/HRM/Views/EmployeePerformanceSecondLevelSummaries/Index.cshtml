 <script>
            function onDataBound(e) {
                var grid = this;
                grid.tbody.find("tr[role='row']").each(function (e) {
                    var model = grid.dataItem(this);
                    if (model.IsSecondLevelApproved) {
                        $(this).find(".k-grid-cmd-approve-request").hide();
                        $(this).find(".k-grid-cmd-reject").hide();
                    }
                    if (model.IsSecondLevelRejected) {
                        $(this).find(".k-grid-cmd-reject").hide();

                    }
                });
               

            }
          

        </script>

<script>
    function thirdLevelApproval(e) {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        var year = dataItem.GlFiscalYearId;
        var period = dataItem.GlPeriodId;
        var employee = dataItem.EmployeeId;

        $('#loading-image').show(); {
            var conf = confirm("Are you sure you want to approve this quarter performance evaluation");
            if (conf === true) {
                $('#loading-image').show();
                $.ajax({
                    url: '@Url.Action("ApproveEvaluation", "EmployeePerformanceSecondLevelSummaries")',
                    //contentType: "application/json; charset=utf-8",
                    data: { year: year, period: period, employee: employee },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        r = result;
                        $('#loading-image').hide();
                        if (r == "true") {
                            alert("Successfully Approved");
                            grid.dataSource.read();
                        }
                        else {
                            alert("Approval cannot be granted until the 1st level evaluation is approved");
                            grid.dataSource.read();
                        }
                        
                    },
                    error: function (xhr, status, error) {
                        $('#loading-image').hide();
                        alert("An error occurred: " + error);
                    }


                });
            }

        }

    }
    function secondLevelRejection(e) {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        var year = dataItem.GlFiscalYearId;
        var period = dataItem.GlPeriodId;
        var employee = dataItem.EmployeeId;

        $('#loading-image').show(); {
            var conf = confirm("Are you sure you want to Reject this  performance evaluation");
            if (conf === true) {
                $('#loading-image').show();
                var rejectionReason = prompt("Please provide a reason for rejection:");

                $.ajax({
                    url: '@Url.Action("RejectionReason_Create", "EmployeePerformanceSecondLevelSummaries")',
                    //contentType: "application/json; charset=utf-8",
                    data: { yearId: year, periodId: period, employeeId: employee, reason: rejectionReason },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        r = result;
                        if (r == "true") {
                            alert("Successfully Rejected");
                            $('#loading-image').hide();
                            grid.dataSource.read();
                        }
                        else {
                            alert("not rejected");
                            $('#loading-image').hide();
                            grid.dataSource.read();
                        }
                        
                    }

                });
            }
            $('#loading-image').hide();


        }

    }


 </script>

     