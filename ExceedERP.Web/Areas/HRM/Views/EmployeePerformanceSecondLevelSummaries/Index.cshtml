@using System.Collections
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>@Resources.NavigatorPerformance_EmployeePerformance || Second Level</legend>
@(Html.Kendo().Grid<EmployeePerformance>()
        .Name("EmployeePerformancegrid")
        .Columns(columns =>
        {
            columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").Width(170).EditorTemplateName("EmployeeLists").Filterable(ftb => ftb.Multi(true).Search(true));
            columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["fiscalYearList"], "GlFiscalYearId", "Name").EditorTemplateName("GLYearSelector").Filterable(ftb => ftb.Multi(true).Search(true)).Width(80);
            columns.ForeignKey(c => c.GlPeriodId, (IEnumerable)ViewData["Period"], "QuarterId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(160);
            columns.Bound(c => c.IsCurrent).Filterable(ftb => ftb.Multi(true).Search(true)).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsCurrent ? checked='checked' :'' # >").Width(150);
            columns.Bound(c => c.ReasonFor2ndRejection).Width(140);
            columns.Bound(c => c.IsSecondLevelApproved).ClientTemplate(
                       "<input type='checkbox' disabled = 'true' value='#=IsSecondLevelApproved#' " +
                       "#if(IsSecondLevelApproved) { #" +
                       "checked='checked'" +
                       "# } #" +
                       "/>").Width(120);
            columns.Bound(c => c.IsSecondLevelRejected).ClientTemplate(
                       "<input type='checkbox' disabled = 'true' value='#=IsSecondLevelRejected#' " +
                       "#if(IsSecondLevelRejected) { #" +
                       "checked='checked'" +
                       "# } #" +
                       "/>").Width(120);
            columns.Command(command =>
            {
                command.Custom("cmd-approve-request").IconClass("fa fa-check ").Text("Approva").Click("thirdLevelApproval").HtmlAttributes(new { @class = "btn btn-success" });
                command.Custom("cmd-reject").IconClass("fa fa-check ").Text("Reject").Click("secondLevelRejection").HtmlAttributes(new { @class = "btn btn-warning" });

            }).Width(100);


        })

            .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Filterable()
            .Scrollable(h => h.Height("auto"))
            .Events(ev=>ev.DataBound("onDataBound"))
            .Pageable(pageable => pageable
                //.Input(true)
                // .Numeric(false)
                .Refresh(true)
                //.PageSizes(true)
                // .ButtonCount(5)
                )

            .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events =>
                {
                    events.Error("error_handler(\"EmployeePerformancegrid\")");
                    events.RequestStart("onRequestStart(\"EmployeePerformancegrid\")");
                    events.RequestEnd("onRequestEnd(\"EmployeePerformancegrid\")");
                })
                     .Model(model =>
                     {
                         model.Id(p => p.EmployeePerformanceId);
                         model.Field(p => p.Result).Editable(false);


                     })
                    .Read(read => read.Action("EmployeePerformanceSecondLevelSummaries_Read", "EmployeePerformanceSecondLevelSummaries"))
                    ).ClientDetailTemplateId("employee_performance_template")
                    )

<script id="employee_performance_template" type="text/kendo-tmpl">
  @(Html.Kendo().TabStrip()
        .Name("tabstrip_#=EmployeePerformanceId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text(Resources.NavigatorPerformance_EmployeePerformance).Content(
            @<text>
          @(Html.Kendo().Grid<EmployeePerformance>()
              .Name("EmployeePerformancedetailgrid_#=EmployeePerformanceId#")
              .Columns(columns =>
              {

                  columns.ForeignKey(c => c.EvaluationCriteriaTypeId, (IEnumerable)ViewData["EvalutionCrateria"], "MeasurementDefinitionId", "Name").Width(200);
                  columns.Bound(c => c.Weight).Width(100).Format("{0:n}").ClientFooterTemplate("\\#=kendo.toString(sum, 'n')\\# ");
                  columns.Bound(c => c.Result).Width(100).Format("{0:n}").ClientFooterTemplate("\\#=kendo.toString(sum, 'n')\\# ");
                  columns.Bound(c => c.ReasonFor2ndRejection).Width(100);
                  columns.Bound(c => c.Remark).Width(50);

              })
              .ClientDetailTemplateId("Action")
              .Editable(editable => editable.Mode(GridEditMode.InLine))
              .Scrollable(h => h.Height("auto"))
                .Pageable(pageable => pageable
                      //.Input(true)
                      // .Numeric(false)
                      .Refresh(true)
                     //.PageSizes(true)
                     // .ButtonCount(5)
                     )

              .DataSource(dataSource => dataSource
                     .Ajax()
                     .Events(events =>
                     {
                         events.Error("error_handler(\"EmployeePerformancedetailgrid_#=EmployeePerformanceId#\")");
                         events.RequestStart("onRequestStart(\"EmployeePerformancedetailgrid_#=EmployeePerformanceId#\")");
                         events.RequestEnd("onRequestEnd(\"EmployeePerformancedetailgrid_#=EmployeePerformanceId#\")");
                     })
                     .Aggregates(aggregates =>
                     {
                         aggregates.Add(p => p.Weight).Sum();
                         aggregates.Add(p => p.Result).Sum();

                     })
                     .Model(model =>
                     {
                         model.Id(p => p.EmployeePerformanceId);
                         model.Field(p => p.Result).Editable(false);


                     })
                    .Read(read => read.Action("EmployeePerformanceSecondLevelSummaries_OnePerson_Read", "EmployeePerformanceSecondLevelSummaries", new { employeeId= "#=EmployeeId#", fiscalyearId= "#=GlFiscalYearId#", quarterId= "#=GlPeriodId#" }))

                    ).ClientDetailTemplateId("employee_performance_detail_template")
                    .ToClientTemplate()
                    )
                   </text> );


                }).ToClientTemplate())
                                            
</script>

