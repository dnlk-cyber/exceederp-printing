@using System.Collections
@using ExceedERP.Core.Domain.HRM.RecruitmentManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.Navigator_Recruitment_GeneralSetting</legend>
@(Html.Kendo().Grid<RecruitmentApplicantPassSetting>()
          .Name("RecruitmentApplicantPassSettingGrid")
      .Columns(columns =>
      {
          // columns.Bound(c => c.Category);
          columns.ForeignKey(c => c.VacancyId, (IEnumerable)ViewData["Vacancy"], "VacancyId", "VaccancyCode").EditorTemplateName("Vacancy").Width(150).Title("Vacancy");


          //columns.Bound(c => c.Attribute).EditorTemplateName("Attribute").Width(300);
          columns.Bound(c => c.TotalValue).Width(150);
          columns.Bound(c => c.PassScore).Width(150);
          columns.Bound(c => c.Remark).Width(150);
          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(200);
      })
      .ToolBar(toolbar => {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
              .Events(events =>
              {

                  events.Error("error_handler(\"RecruitmentApplicantPassSettingGrid\")");
                  events.RequestStart("onRequestStart(\"RecruitmentApplicantPassSettingGrid\")");
                  events.RequestEnd("onRequestEnd(\"RecruitmentApplicantPassSettingGrid\")");
              })

          .Model(model => model.Id(p => p.RecruitmentApplicantPassSettingId))
                  .Read(read => read.Action("PassSetting_Read", "PassSetting"))
                      .Create(create => create.Action("PassSetting_Create", "PassSetting"))
                  .Update(update => update.Action("PassSetting_Update", "PassSetting"))
                  .Destroy(destroy => destroy.Action("PassSetting_Destroy", "PassSetting"))
      )
      )

<script>
    function filterCategories() {
        return {
            Reference: $("#Reference").val()
        };
    }
</script>
<script>
    function filterAttributes() {
        return {
