                            .Placeholder(Resources.NavigatorCompany_ProjectType)
                            .Name("LookupIdd")
                            .BindTo((IEnumerable)ViewData["projects"])
                            .DataTextField("Description")
                            .DataValueField("LookupId")
                            .Filter("contains")
                            .AutoBind(false)
                            .HtmlAttributes(new { style = "width: 160px;" })

                )
                @(Html.Kendo().ComboBox()
                        .Placeholder(Resources.BussinessUnit)
                        .Name("BusinessUnittIdd")
                        .BindTo((IEnumerable)ViewData["businessUnits"])
                        .DataTextField("Name")
                        .DataValueField("BusinessUnitId")
                        .Events(e => e.Change("onChangeGrid"))
                        .Filter("contains")
                        .AutoBind(false)
                        .HtmlAttributes(new { style = "width: 160px;" })

