@helper ManPowerPlanning()
{
    <div class="row">

    </div>
    @(Html.Kendo().Grid<JobTitleMapping>()
          .Name("JobTitleMappinggrid")
          .Columns(columns =>
          {
              columns.Bound(c => c.JobTitleMappingId).Title("#").Width(80);
              columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "AmharicName").EditorTemplateName("BranchSelector").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
              columns.ForeignKey(c => c.WorkUnitId, (IEnumerable)ViewData["parent"], "WorkUnitId", "Name").EditorTemplateName("JobTitleMapping").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);//.Filterable(filterable=>filterable.UI("titleFilter")).Width(150);
              columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["orgstructure"], "OrgStructureId", "Name").EditorTemplateName("Organization").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
              columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["jobTitles"], "LookupId", "Description").EditorTemplateName("JobTitles").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
              columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
              columns.Bound(c => c.Quntity).Width(120);
              columns.Bound(c => c.IsActive).ClientTemplate(
                                        "<input type='checkbox' disabled = 'true' value='#= IsActive#' " +
                                        "# if (IsActive) { #" +
                                        "checked='checked'" +
                                        "# } #" +
                                        "/>").Width(120);
              columns.Bound(c => c.PlanType).EditorTemplateName("PlanType").Width(120);
              columns.Bound(c => c.Remark).Width(100);
              columns.Command(command =>
              {
                  if (HttpContext.Current.User.IsInRole("HR_Admin"))
                  {
                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                      command.Custom("").Click("enableOrDisableActive").Text(" Enable Or Disable").IconClass("fa fa-check fa2x").HtmlAttributes(new { @class = "btn btn-success", @title = "Approve Placement ", @id = "approveplacement" });

                  }
              }).Width(200);
          })
