<script>
    function filterBranch() {
        return {
            businessUnitId: $("#BusinessUnitId").val(),
            text: $("#WorkUnitId").data("kendoDropDownList").filterInput.val()

        };
    }
    function filterBranchForGrid() {
        return {
            branchId: $("#BranchIdd").val(),
            businessUnitId: $("#BusinessUnittIdd").val(),
            text: $("#WorkUnitIdd").data("kendoDropDownList").filterInput.val()

        };
    }
    function filterParam() {
        return {
            branchIdd: $("#BranchIdd").val(),
            businessUnitIdd: $("#BusinessUnittIdd").val(),
            parentIdd: $("#WorkUnitIdd").val(),
            orgStructureIdd: $("#OrgStructureIdd").val(),
        };
    }
    function filterStructure() {
        return {
            WorkUnitId: $("#WorkUnitId").val(),
            searchText: $("#OrgStructureId").data("kendoDropDownList").filterInput.val()

        };
    }
    function filterStructureForGrid() {
        return {
            branchId: $("#BranchIdd").val(),
            businessUnitId: $("#BusinessUnittIdd").val(),
            WorkUnitId: $("#WorkUnitIdd").val(),
            searchText: $("#OrgStructureIdd").data("kendoDropDownList").filterInput.val()

        };
    }
    function filterJobTitle() {
        return {
            OrgStructureId: $("#OrgStructureId").val()
        };
    }
</script>
<script>

    function CopyMapping() {

        var type = $("#LookupIdd").data("kendoComboBox");
        var typeId = type.value();
        var branch = $("#BranchIdd").data("kendoComboBox");
        var branchId = branch.value();
        var businessUnit = $("#BusinessUnittIdd").data("kendoComboBox");
        var businessUnitId = businessUnit.value();

        if (typeId == "") {
            alert("Please select the project type first!!");
        }
        if (branchId == "") {
            alert("Please select project or Branch first!!");
        }
        if (businessUnitId == "") {
            alert("Please select business Unit first!!");
        }
        $.ajax({
            url: '@Url.Action("CreateJobTitleMapping", "JobTitleMapping")',
            data: { typeId: typeId, branchId: branchId, businessUnitId: businessUnitId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "exist") {
                    alert("You cannot copy the template. The branch has existed mapping!!");
                }
                else if (r == "error") {
                    alert("Please set template for this project type first!!");
                }
                else {
                    alert("Successfully generated!!");
                }



            }

        });
    }
</script>

