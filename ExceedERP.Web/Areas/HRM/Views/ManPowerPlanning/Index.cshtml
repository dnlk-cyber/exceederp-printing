<script>
    function filterStructure() {
        return {
            WorkUnitId: $("#WorkUnitId").val()
        };
    }

    function filterJobTitle() {
        return {
            OrgStructureId: $("#OrgStructureId").val()
        };
    }
</script>
<script>

    function CopyMapping() {

        var type = $("#LookupIdd").data("kendoComboBox");
        var typeId = type.value();
        var branch = $("#BranchIdd").data("kendoComboBox");
        var branchId = branch.value();
        if (typeId == "") {
            alert("Please select the project type first!!");
        }
        if (branchId == "") {
            alert("Please select project first!!");
        }
        $.ajax({
            url: '@Url.Action("CreateJobTitleMapping", "JobTitleMapping")',
            data: { typeId: typeId, branchId: branchId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "exist") {
                    alert("You cannot copy the template. The branch has existed mapping!!");
                }
                else if (r == "error") {
                    alert("Please set template for this project type first!!");
                }
                else {
                    alert("Successfully generated!!");
                }



            }

        });
    }
</script>

<script>
    function filterStructure() {
        return {
            WorkUnitId: $("#WorkUnitId").val()
        };
    }
    function filterJobTitle() {
        return {
            OrgStructureId: $("#OrgStructureId").val()
        };
    }
</script>
