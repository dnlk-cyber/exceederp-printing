<script>

    function onChangeGrid(e) {
        var grid = $("#JobTitleMappinggrid").data("kendoGrid");
        grid.dataSource.read();
    }
  function enableOrDisableActive(e) {
    var row = $(e.target).closest("tr");
    var grid = $("#JobTitleMappinggrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
      var id = dataItem.JobTitleMappingId;
        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("EnableOrDisable", "JobTitleMapping")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                r = result;
                alert(r.Message);
                $('#loading-image').hide();
                grid.dataSource.read();
                }
                });

                }


    }

