@using System.Collections
@using ExceedERP.Core.Localization
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.Company.JobTitleMapping

<form>
    <br />
    <div class="row my-class">
        <div class="col-md-3">
            <div>@Html.LabelFor(model => model.BranchId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
            <div class="form-group">
                @(Html.Kendo().DropDownListFor(model => model.BranchId)
                        .OptionLabel(Resources.Select)
                        .Filter("contains")
                        .MinLength(2)
                        .DataTextField("Name")
                        .DataValueField("BranchId")
                        .HtmlAttributes(new { @class = "kendo-control" })
                         .AutoBind(true)
                        .DataSource(source =>
                        {
                            source.Read(read => read.Action("GetAllBranch", "HRMDataProvider").Data("sendForgery"));
                        })
                        .ValuePrimitive(true)
                )
                @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            @Html.LabelFor(model => model.BusinessUnitId, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="form-group">
                @(Html.Kendo().DropDownListFor(m => m.BusinessUnitId)
                    .Name("BusinessUnitId")
                    .ValuePrimitive(true)
                    .OptionLabel("Select Business Unit...")
                    .DataTextField("Name")
                    .DataValueField("Code")
                     .AutoBind(true)
                    // .DataValueField("BusinessUnitId")
                    .HtmlAttributes(new { @class = "kendo-control" }).Filter("contains")
                    .DataSource(dataSource =>
                    {
                        dataSource.Read(read => read.Action("GetAllBusinessUnits", "GlobalDataProvider", new { area = "Common" }).Data("sendForgery"))
                                                .ServerFiltering(false);
                    })
                )
                @Html.ValidationMessageFor(model => model.BusinessUnitId, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div>@Html.LabelFor(model => model.WorkUnitId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
            <div class="form-group">
                @(Html.Kendo().DropDownListFor(model => model.WorkUnitId)
                                        .Name("WorkUnitId")
                                           .OptionLabel(Resources.Select)
                                           .Filter("contains")
                                            .MinLength(2)
                                            .HtmlAttributes(new { @class = "kendo-control" })
                                             .DataTextField("Name")
                                             .DataValueField("WorkUnitId")
                                             .CascadeFrom("BusinessUnitId")
                                              .AutoBind(true)
                                             .DataSource(source =>
                                             {
                                                 source.Read(read =>
                                                 {
                                                     read.Action("GetParentWorkUnit", "JobTitleMapping")
                                                         .Data("filterBranch")/*.Data("sendForgery")*/;
                                                 })
                                                .ServerFiltering(true);
                                                 //source.Read(read => read.Action("GetParentWorkUnit", "JobTitleMapping").Data("filterBranch").Data("sendForgery"))
                                                 //    .ServerFiltering(true);
                                             })
                                            .ValuePrimitive(true)
                )
                @Html.ValidationMessageFor(model => model.WorkUnitId, "", new { @class = "text-danger" })
            </div>
        </div>
        
    </div>
    <div class="row my-class">
        <div class="col-md-3">
            <div>@Html.LabelFor(model => model.OrgStructureId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
            <div class="form-group">
                @(Html.Kendo().DropDownListFor(model => model.OrgStructureId)
                                             .OptionLabel(Resources.Select)
                                             .Filter("contains")
                                             .MinLength(2)
                                             .HtmlAttributes(new { @class = "kendo-control" })
                                             .DataTextField("Name")
                                             .DataValueField("OrgStructureId")
                                             .CascadeFrom("WorkUnitId")
                                              .AutoBind(true)
                                             .DataSource(source =>
                                             {
                                                 source.Read(read =>
                                                 {
                                                     read.Action("GetStructure", "JobTitleMapping")
                                                         .Data("filterStructure");
                                                 })
                                                 .ServerFiltering(true);
                                             })
                                                    .ValuePrimitive(true)
                )
                @Html.ValidationMessageFor(model => model.OrgStructureId, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div>@Html.LabelFor(model => model.LookupId, htmlAttributes: new { @class = "control-label col-md-8" })</div>
            <div class="form-group">
                @(Html.Kendo().DropDownListFor(m => m.LookupId)
                                      .OptionLabel(Resources.Select)
                                      .Filter("contains")
                                      .MinLength(2)
                                      .HtmlAttributes(new { @class = "kendo-control" })
                                      .DataTextField("Description")
                                      .DataValueField("LookupId")
                                      .AutoBind(true)
                                      .DataSource(source =>
                                      {
                                          source.Read(read => read.Action("GetJobTitleList", "JobTitleMapping").Data("sendForgery"));
                                      })
                                      .ValuePrimitive(true)
                )
                @Html.ValidationMessageFor(model => model.LookupId, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.PlanType, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">
                @(Html.EnumDropDownListFor(model => model.PlanType, htmlAttributes: new { @class = "k-dropdown-wrap k-state-default", @style = "width: 140px" }))
            </div>
        </div>
      
    </div>
    <br />
    
    <div class="row my-class">
        <div class="col-md-3">
            <div>@Html.LabelFor(model => model.Quntity, htmlAttributes: new { @class = "control-label col-md-8" })</div>
            <div class="form-group">
                @Html.Kendo().TextBoxFor(model => model.Quntity).HtmlAttributes(new { @class = "kendo-control" })
                @Html.ValidationMessageFor(model => model.Quntity, "", new { @class = "text-danger" })
            </div>
        </div>
        @*<div class="col-md-3">
            @Html.LabelFor(model => model.BusinessUnitId, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="form-group">
                @(Html.Kendo().DropDownListFor(m => m.BusinessUnitId)
                                  .ValuePrimitive(true)
                                   .AutoBind(false)
                                   .OptionLabel("Select Business Unit...")
                                   .DataTextField("Name")
                                   .DataValueField("Code")
                                   .Filter("contains")
                                   .DataSource(dataSource =>
                                   {
                                       dataSource.Read(read => read.Action("GetAllBusinessUnits", "GlobalDataProvider", new { area = "Common" }).Data("sendForgery"))
                                                             .ServerFiltering(false);
                                   })
                )
                @Html.ValidationMessageFor(m => m.BusinessUnitId)
            </div>
        </div>*@
        <div class="col-md-3">
            <div>@Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })</div>
            <div class="form-group">
                @Html.TextAreaFor(model => model.Remark)
                @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
</form>
<style>
    .row.my-class {
        margin-left: 30px;
    }

    .kendo-textbox {
        width: 240px;
    }

    textarea {
        width: 240px;
    }
</style>

