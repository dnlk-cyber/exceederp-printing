        try {

            var grid = $("#IncommingLetterRegistration").data("kendoGrid");
            var dataItem = grid.dataItem(grid.select());
            var id = dataItem.BookNo;
            var url = "";
            $.ajax({
                url: '@Url.Action("UploadDocument", "InstitutionIncomming")',
                //contentType: "application/json; charset=utf-8",
                data: function () {
                    var data = new FormData();
                    
                    data.append("file", $("#file").get(0).files[0]);
                    data.append("url", url);
                    data.append("txtValue", $("#txtValue").val());
                    data.append("txtDecsion", $("#txtDecsion").val());
                    data.append("id", id);
                    return data;
                }(),
