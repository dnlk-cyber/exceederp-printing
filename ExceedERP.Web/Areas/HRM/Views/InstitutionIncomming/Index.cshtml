<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#OutgoingLetterDateAm").trigger("change");
        $("#RecivedDateAmharic").trigger("change");
        $("#LetterAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "InstitutionIncomming")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
    function GetLetterStatusDate() {

        var x = AssignDate();
        var y = x;
       
        $("#DateAmharic").trigger("change");
      
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "LetterStatus")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
    function GetLetterSenderDate() {

        var x = AssignDate();
        var y = x;
        $("#DateAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "LetterSender")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
</script>
