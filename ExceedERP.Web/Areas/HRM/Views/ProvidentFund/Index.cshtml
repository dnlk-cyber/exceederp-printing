@using ExceedERP.Core.Localization
@using System.Collections
@using ExceedERP.Core.Domain.HRM.Payroll

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPayroll_ProvidentFund</legend>
@(Html.Kendo().Grid<ProvidentFund>()
                  .Name("ProvidentFundgrid")
      .Columns(columns =>
      {

          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("PayrollListOfEmployee").Width(260);
          columns.Bound(c => c.IsMemeber).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsMemeber #' " + " # if (IsMemeber) { #" + "checked='checked'" + "# } #" + " />").Width(120);
          columns.Bound(c => c.ApplyPension).ClientTemplate("<input type='checkbox'  disabled='true' value='#=ApplyPension #' " + " # if (ApplyPension) { #" + "checked='checked'" + "# } #" + " />").Width(120);
          columns.Bound(c => c.Remark).Width(200);
          columns.Command(command =>
          {
              command.Edit();
              if (HttpContext.Current.User.IsInRole("Payroll_Admin") )
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();


      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Scrollable(h => h.Height(500))

                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ProvidentFundId").Descending())
                                                    //.Batch(true )
                                                    .Events(events =>
                                                    {
                                                        events.Error("error_handler(\"ProvidentFundgrid\")");
                                                        events.RequestStart("onRequestStart(\"ProvidentFundgrid\")");
                                                        events.RequestEnd("onRequestEnd(\"ProvidentFundgrid\")");
                                                    })

          .Model(model =>
          {
              model.Id(p => p.ProvidentFundId);

          })
                          .Read(read => read.Action("ProvidentFunds_Read", "ProvidentFund"))
                          .Create(create => create.Action("ProvidentFunds_Create", "ProvidentFund"))
                         .Update(update => update.Action("ProvidentFunds_Update", "ProvidentFund"))
                  .Destroy(destroy => destroy.Action("ProvidentFunds_Destroy", "ProvidentFund"))
              )
)























<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>

<style>
    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>


<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
   
</script>
