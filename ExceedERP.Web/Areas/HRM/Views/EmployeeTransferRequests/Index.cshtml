@using System.Collections
@using ExceedERP.Core.Domain.HRM.RecruitmentManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.RecruitmentRequest</legend>
@(Html.Kendo().Grid<EmployeeTransferRequest>()
              .Name("EmployeeTransferRequestgrid")
              .Columns(columns =>
              {
                  columns.Bound(c => c.EmployeeTransferRequestId).Title("S.N").Width(80);
                  //columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Width(180);
                  columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("GetAllActiveEmployees").Filterable(ftb => ftb.Multi(true).Search(true)).Title(Resources.Placement_FullName).Width(180);
                  columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                  columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                  columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
                  columns.Bound(c => c.RequestDate).Width(120);
                  columns.Bound(c => c.Reason).Width(130);
                  columns.Bound(c => c.Remark).Width(110);
                  columns.Command(command =>
                  {
                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                      command.Destroy().Text(Resources.ActionButton_Cancel);
                  }).Width(200);
              })
              .ToolBar(toolbar =>
              {
                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

              })
              .Editable(editable => editable.Mode(GridEditMode.InLine))
              .Scrollable(h => h.Height(500))
                 //.Events(x => x.Save("GetAbscenceDate"))
                 //.Events(x => x.Edit("GetAbscenceDate"))
                 .Events(ev => {
                     ev.DetailExpand("detailExpandMasterDepartment");
                     ev.DataBound("onDataBoundMasterDepartment");
                 })
                .Sortable(sortable =>
                {
                    sortable.SortMode(GridSortMode.SingleColumn);
                })
                .Filterable()
                .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
                 .DataSource(dataSource => dataSource
                    .Ajax()
                    .Events(events =>
                    {
                        events.Error("error_handler(\"EmployeeTransferRequestgrid\")");
                        events.RequestStart("onRequestStart(\"EmployeeTransferRequestgrid\")");
                        events.RequestEnd("onRequestEnd(\"EmployeeTransferRequestgrid\")");
                    })

                  .Model(model =>
                  {
                      model.Id(p => p.EmployeeTransferRequestId);
                      model.Field(p => p.EmployeeTransferRequestId).Editable(false);

                  })
                  .Read(read => read.Action("EmployeeTransferRequests_Read", "EmployeeTransferRequests"))
                  .Create(create => create.Action("EmployeeTransferRequests_Create", "EmployeeTransferRequests"))
                  .Update(update => update.Action("EmployeeTransferRequests_Update", "EmployeeTransferRequests"))
                  .Destroy(destroy => destroy.Action("EmployeeTransferRequests_Destroy", "EmployeeTransferRequests"))
              ).ClientDetailTemplateId("Employee_transfer_requests_template")
)

<script type="text/kendo-template" id="Employee_transfer_requests_template">
    @(Html.Kendo().TabStrip()
            .Name("tab_strip_#=EmployeeTransferRequestId#")
            .SelectedIndex(0)
            .Items(items =>
            {

                   
                    items.Add().Text("Detail ").Content(
                    @<text>
                        # if (!IsDepartmentOnlineApproved&&!IsDepartmentSendForApproval)
                            {#
                            <a onclick='return sendForApproval("#=EmployeeTransferRequestId#")' href=' \#' title="Send for Department Approval"><i class="fa fa-share-square fa-2x"></i></a>
                            <br />
                            # } #
                        @transferRequestDetail()
                    </text>);
                   items.Add().Text("Department Validation").Content(
                    @<text>
                        @transferRequestDepartmentValidation()
                    </text>);
                    @*items.Add().Text("Validation ").Content(
                    @<text>
                        @transferRequestValidation()
                    </text>);*@
                    
                   

            }).ToClientTemplate()
    )
</script>

@helper transferRequestDetail() { 
    @(Html.Kendo().Grid<TransferRequestDetail>()
            .Name("TransferRequestDetailGrid_#=EmployeeTransferRequestId#")
            .Columns(columns =>
            {

                columns.ForeignKey(c => c.JobTitleId, (IEnumerable)ViewData["jobTitle"], "LookupId", "Description").EditorTemplateName("JobTitles").Width(120);
                columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("GetAllActiveEmployees").Filterable(ftb => ftb.Multi(true).Search(true)).Title(Resources.Placement_FullName).Width(150);
                columns.Bound(c => c.Quantity).Width(120);
                columns.Bound(c => c.Description).Width(120);
                columns.Command(command =>
                {

                    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);


                    command.Destroy().Text(Resources.ActionButton_Cancel);

                }).Width(200);

            })
            .ToolBar(toolbar =>
            {

                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

            })
         .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Scrollable(h => h.Height(500))
         .Sortable(sortable =>
         {
             sortable.SortMode(GridSortMode.SingleColumn);
         })
         .Filterable()
         .Events(x => x.DataBound("onDataBoundLineDepartment"))
         .Pageable(pageable => pageable
             .Input(true)
             .Numeric(false)
             .Refresh(true)
             .PageSizes(true)
             .ButtonCount(5))
         .DataSource(dataSource => dataSource
             .Ajax()
             .Events(events =>
             {
                 events.Error("error_handler(\"TransferRequestDetailGrid_#=EmployeeTransferRequestId#\")");
                 events.RequestStart("onRequestStart(\"TransferRequestDetailGrid_#=EmployeeTransferRequestId#\")");
                 events.RequestEnd("onRequestEnd(\"TransferRequestDetailGrid_#=EmployeeTransferRequestId#\")");
             })

             .Model(model => model.Id(p => p.TransferRequestDetailId))
             .Read(read => read.Action("EmployeeTransferRequestDetails_Read", "EmployeeTransferRequestDetails", new { Area = "HRM", empTRId = "#=EmployeeTransferRequestId#" }))
             .Create(create => create.Action("EmployeeTransferRequestDetails_Create", "EmployeeTransferRequestDetails", new { Area = "HRM", empTRId = "#=EmployeeTransferRequestId#" }))
             .Update(update => update.Action("EmployeeTransferRequestDetails_Update", "EmployeeTransferRequestDetails"))
             .Destroy(destroy => destroy.Action("EmployeeTransferRequestDetails_Destroy", "EmployeeTransferRequestDetails"))
                ).ToClientTemplate()

            )
    }

