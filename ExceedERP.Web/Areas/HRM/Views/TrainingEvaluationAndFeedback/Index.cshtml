@using System.Collections
@using ExceedERP.Core.Domain.HRM.TrainingEducation
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Training Evaluation and Feedback</legend>
@(Html.Kendo().Grid<CourseTracking>()
                  .Name("CourseTrackingGrid")
              .Columns(columns =>
              {
                  columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Width(100);
      //columns.ForeignKey(c => c.TrainingPlanId, (IEnumerable)ViewData["plan"], "TrainingPlanId", "NoofTrainee").EditorTemplateName("TrainingPlan").Width(120);
      columns.Bound(x => x.NoOfTrainee).Width(120);
                  columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["CourseList"], "LookupId", "Description").EditorTemplateName("Course").Width(120);
                  columns.Bound(c => c.FromAmharic).Width(80);
                  columns.Bound(c => c.ToAmharic).Width(80);
                  columns.Bound(c => c.Cost).Width(70);
                  columns.Bound(c => c.TrainingType).EditorTemplateName("Enum").Width(110);
                  columns.Bound(c => c.TrainingTerm).EditorTemplateName("Enum").Width(120);
                  columns.Bound(c => c.TrainingLocation).EditorTemplateName("Enum").Width(120);
                  columns.ForeignKey(c => c.MainCompanyId, (IEnumerable)ViewData["ProviderList"], "MainCompanyId", "TradeName").EditorTemplateName("TrainingProvider").Width(120);
      //columns.Bound(c => c.Remark);
      columns.Command(command =>
        {

                  }).Width(200);
              })
              .ToolBar(toolbar =>
              {


              })
                      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("CourseTracking").Window(window => { window.Title(Resources.NavigatorTraining_CourseTracking); window.Scrollable(false); }))
                       .Scrollable(h => h.Height(500))
                           .Groupable()
                                    .Sortable(sortable =>
                                    {
                                        sortable.SortMode(GridSortMode.SingleColumn);
                                    })
                        .Filterable()

                           .Pageable(pageable => pageable
                                                      .Input(true)
                                                      .Numeric(false)
                                                      .Refresh(true)
                                                      .PageSizes(true)
                                                      .ButtonCount(5))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                                  .Events(events =>
                                      {
                                          events.Error("error_handler(\"CourseTrackingGrid\")");
                                          events.RequestStart("onRequestStart(\"CourseTrackingGrid\")");
                                          events.RequestEnd("onRequestEnd(\"CourseTrackingGrid\")");
                                      })

                        .Model(model => model.Id(p => p.CourseTrackingId))
                        .Read(read => read.Action("CourseTrackings_Read", "TrainingEvaluationAndFeedback"))
                        .Create(create => create.Action("CourseTrackings_Create", "CourseTracking"))
                        .Update(update => update.Action("CourseTrackings_Update", "CourseTracking"))
                        .Destroy(destroy => destroy.Action("CourseTrackings_Destroy", "CourseTracking"))
                            ).ClientDetailTemplateId("template")
)


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                          .Name("tabstrip_#=CourseTrackingId#")
                  .SelectedIndex(0)
                  .Items(items =>
                  {
                  items.Add().Text("Training Evaluation").Content(
                    @<text>

                        @(Html.Kendo().Grid<TrainingEvaluation>()
                             .Name("TrainingEvaluationGrid#=CourseTrackingId#")
                        .Columns(columns =>
                        {
                            columns.ForeignKey(c => c.CriteriaId, (IEnumerable)ViewData["Criterias"], "TrainingEvaluationCriteriaId", "Criteria").EditorTemplateName("CriteriaLists").Width(120);
                            columns.Bound(c => c.Score).Width(200);

                            columns.Command(command =>
                            {
                                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);

                                command.Destroy().Text(Resources.ActionButton_Cancel);

                            }).Width(200);
                        })
                        .ToolBar(toolbar =>
                        {
                            if (HttpContext.Current.User.IsInRole("HR_Training_User"))
                            {
                                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                            }
                        })
                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .Scrollable(h => h.Height(500))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                                    //.Events().Update()
                                    .Events(events =>
                                    {
                                        events.Error("error_handler(\"TrainingEvaluationGrid#=CourseTrackingId#\")");
                                        events.RequestStart("onRequestStart(\"TrainingEvaluationGrid#=CourseTrackingId#\")");
                                        events.RequestEnd("onRequestEnd(\"TrainingEvaluationGrid#=CourseTrackingId#\")");
                                    })

                            .Model(model => model.Id(p => p.TrainingEvaluationId))
                                    .Read(read => read.Action("TrainingEvaluation_Read", "TrainingEvaluationAndFeedback", new { id = "#=CourseTrackingId#" }))
                                    .Create(create => create.Action("TrainingEvaluation_Create", "TrainingEvaluationAndFeedback", new { id = "#=CourseTrackingId#" }))
                            .Update(update => update.Action("TrainingEvaluation_Update", "TrainingEvaluationAndFeedback"))
                            .Destroy(destroy => destroy.Action("TrainingEvaluation_Destroy", "TrainingEvaluationAndFeedback"))
                        ).ToClientTemplate()
                        )

                    </text>
                                  );

                      items.Add().Text("Feedback").Content(
                        @<text>

                            @(Html.Kendo().Grid<TrainingFeedback>()
                             .Name("TrainingEvaluationAndFeedback#=CourseTrackingId#")
                        .Columns(columns =>
                        {
                            columns.Bound(c => c.FeedBack).Width(200);

                            columns.Command(command =>
                            {

                                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);

                                command.Destroy().Text(Resources.ActionButton_Cancel);

                            }).Width(150);
                        })
                        .ToolBar(toolbar =>
                        {
                            if (HttpContext.Current.User.IsInRole("HR_Training_User"))
                            {
                                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                            }
                        })
                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .Scrollable(h => h.Height(500))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                                    //.Events().Update()
                                    .Events(events =>
                                    {
                                        events.Error("error_handler(\"TrainingEvaluationAndFeedback#=CourseTrackingId#\")");
                                        events.RequestStart("onRequestStart(\"TrainingEvaluationAndFeedback#=CourseTrackingId#\")");
                                        events.RequestEnd("onRequestEnd(\"TrainingEvaluationAndFeedback#=CourseTrackingId#\")");
                                    })

                            .Model(model => model.Id(p => p.TrainingFeedbackId))
                                    .Read(read => read.Action("TrainingFeedback_Read", "TrainingEvaluationAndFeedback", new { id = "#=CourseTrackingId#" }))
                                    .Create(create => create.Action("TrainingFeedback_Create", "TrainingEvaluationAndFeedback", new { id = "#=CourseTrackingId#" }))
                            .Update(update => update.Action("TrainingFeedback_Update", "TrainingEvaluationAndFeedback"))
                            .Destroy(destroy => destroy.Action("TrainingFeedback_Destroy", "TrainingEvaluationAndFeedback"))
                        ).ToClientTemplate()
                            )

                        </text>
                                  );

                          }).ToClientTemplate())
</script>



