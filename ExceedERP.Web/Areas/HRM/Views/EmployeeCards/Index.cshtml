@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Employee Card</legend>
@(Html.Kendo().Grid<EmployeeCard>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCardId).Title("#").Width(80);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("AllEmployeeSelector").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
          columns.ForeignKey(c => c.ToEmployeeId, (IEnumerable)ViewData["EmployeeList"], "ToEmployeeId", "FullNameaEnglish").EditorTemplateName("AllEmployeeSelector").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
          columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
          columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["jobTitle"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(130);
          columns.Bound(c => c.FromDateAm).EditorTemplateName("Calander").Width(150);
          columns.Bound(c => c.ToDateTimeAm).EditorTemplateName("Calander").Width(150);
          columns.Bound(c => c.IsActive).ClientTemplate(
             "<input type='checkbox' disabled = 'true' value='#= IsActive#' " +
             "# if (IsActive) { #" +
             "checked='checked'" +
             "# } #" +
             "/>").Width(100);
          columns.Bound(c => c.Salary).Width(110);
          columns.Bound(c => c.Remark).Width(110);
          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Benefit_Admin"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }

          }).Width(200);

      })
      .ToolBar(toolbar =>
      {

      toolbar.Template(@<text>
         <div class="toolbar">
          
             @item.CreateButton(Resources.ActionButton_AddNewRecord)  
         </div> 
         </text>);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Scrollable(h => h.Height(500))
         .Groupable()
         .Filterable()
         .Pageable(pageable => pageable
         .Input(true)
         .Numeric(false)
         .Refresh(true)
         .PageSizes(true)
         .ButtonCount(5))
      .DataSource(dataSource => dataSource
      .Ajax()
      .Events(events =>
      {

          events.Error("error_handler(\"grid\")");
          events.RequestStart("onRequestStart(\"grid\")");
          events.RequestEnd("onRequestEnd(\"grid\")");

      })
      .Model(model =>
      {
          model.Id(p => p.EmployeeCardId);
          model.Field(p => p.EmployeeCardId).Editable(false);

      })
      .Read(read => read.Action("EmployeeCards_Read", "EmployeeCards"))
      .Create(create => create.Action("EmployeeCards_Create", "EmployeeCards"))
      .Update(update => update.Action("EmployeeCards_Update", "EmployeeCards"))
      .Destroy(destroy => destroy.Action("EmployeeCards_Destroy", "EmployeeCards"))
      )/*.ClientDetailTemplateId("template")*/
)
      
