@using System.Collections
@using System.Collections
@using System.Security.AccessControl
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorLeave_LeaveEntitlement</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.LeaveEntitle>()
          .Name("LeaveEntitlegrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(200);
          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Width(120);
          columns.Bound(c => c.Amount).Width(150);
          columns.Bound(c => c.TotlalAmount).Width(150);
          columns.Bound(c => c.Remark).Width(100);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Leave_User"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Leave_Admin"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          if (HttpContext.Current.User.IsInRole("HR_Leave_User"))
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
          if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Leave_Admin"))
          {
              toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
              toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
          }
      })
            .Excel(excel => excel
                                            .FileName(Resources.NavigatorLeave_LeaveEntitlement + ".xlsx")
                                .Filterable(true)
                                    .AllPages(true)
                                                    .ProxyURL(Url.Action("Excel_Export_Save", "LeaveEntitle"))
                            )
                                 .Pdf(pdf => pdf
                                .AllPages()
                                                .FileName(Resources.NavigatorLeave_LeaveEntitlement + ".pdf")
                                                    .ProxyURL(Url.Action("Pdf_Export_Save", "LeaveEntitle"))
                            )
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
         .Scrollable(h => h.Height(500))
             .Groupable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
              .Events(events =>
 {
events.Error("error_handler(\"LeaveEntitlegrid\")");
events.RequestStart("onRequestStart(\"LeaveEntitlegrid\")");
events.RequestEnd("onRequestEnd(\"LeaveEntitlegrid\")");
})
                      
          .Model(model => { model.Id(p => p.LeaveEntitleId);
          model.Field(p => p.EmployeeCode).Editable (false);})
          .Read(read => read.Action("LeavesEntitle_Read", "LeaveEntitle").Data("sendForgery"))
                  .Create(create => create.Action("LeavesEntitle_Create", "LeaveEntitle").Data("sendForgery"))
                  .Update(update => update.Action("LeavesEntitle_Update", "LeaveEntitle").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("LeavesEntitle_Destroy", "LeaveEntitle").Data("sendForgery"))
      )
)

<style type="text/css">
    div.k-edit-form-container {
