    function AssignDate() {
        var list = AssignDates();
        return list;
    }

    function GetIdentificationDate() {

        var x = AssignDate();
        var y = x;
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "Identification", new {Area = "Common"})',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function(result) {
                    r = result;
                }

            });
        }
    }

    function Change(e) {

        var dropDown = $("#Value").data("kendoTextBox");
        var x = e.value;
        if (x == "0" || x == "1" || x == "2" || x == "3") {
            // $("#VaccancyCode").prop("disabled", false).addClass("k-state-disabled");
            $("#Value").kendoMaskedTextBox({
                mask: "(999) 000-0000",
                placeholder: "",
                data_email_msg: ""
            });

        } else if (x == "4" || x == "5" || x == "6" || x == "7" || x == "14" || x == "15") {
            //$("#Value").kendoMaskedTextBox({
            //    mask: "~",
            //    placeholder: ""
            //});
            $("#Value").prop("placeholder", "email@email.com");
            $("#Value").prop("type", "email");
            $("#Value").prop("required", "required");
            $("#Value").prop("data_email_msg", "Email format is not valid");


        } else {
            $("#Value").prop("placeholder", "");
            $("#Value").prop("type", "");
            //$("#Value").kendoMaskedTextBox({
            //    mask: "*[!((a-z) or (0-9))]*",
            //    //placeholder: "",
            //    //data_email_msg: ""
            //});
        }
    }
