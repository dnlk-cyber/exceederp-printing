<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#DateAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "TrainingApplicant")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }
    var masterId = 0;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#TrainingApplicantgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.TrainingApplicantId;
        var gridName = "#RequestesStatusgrid_" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatus", "TrainingApplicant")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                }
                else if (r == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else if (r == "Dapproved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", gridName).show();
                }

            }

        });

    }
    function onUploadSuccess(e) {
        $("#TrainingApplicantAttachmentGrid_" + masterId).data("kendoGrid").dataSource.read();
    }

    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsSendForApproval === true || dataItem.IsDepartmentSendForApproval) {

                row.css("background-color", "darkgrey");
                row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();
            }
            if (dataItem.IsOnlineApproved) {

                row.css("background-color", "lightgreen");
                row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();

            }


        }
    }

     function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "TrainingApplicant", new { area = "HRM" })',
            data: { id: id },
            success: function(result) {
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            },
            error: function(result) {
                alert(result.Message);
            }
        });
    }
</script>
