               events.RequestEnd("onRequestEnd(\"UserCardItemsgrid#=TerminationId#\")");

           })
          .Model(model =>
          {
              model.Id(p => p.UserCardItemsID);
          })
          .Read(read => read.Action("UserCardItems_Read", "Termination", new { Area = "HRM", employeeId = "#=EmployeeId#" }).Data("sendForgery"))

      ).ToClientTemplate())
}

@helper TerminationFileAttachment() { 
    @(Html.Kendo().Grid<Attachment>()
           .Name("AttachmentGrid_#=TerminationId#")
           .Columns(columns =>
           {

               columns.Bound(c => c.Description).Width(150);
               columns.Template(e => { }).ClientTemplate("<a href='/Common/Attachment/DownloadAttachment?attachmentId=\\#=AttachmentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; Download </a>").Width(80);
               columns.Template(e => { }).ClientTemplate("<a href='\\#=URL\\#/\\#=FileName\\#' target='_blank'> <f class = 'fa fa-folder-open'></i> &nbsp;&nbsp; Open</a>").Width(80);

               // columns.Bound(c => c.FileType).ClientTemplate(Html.ActionLink("DownLoad", "DownloadFile", new { filename = "#=TerminationId#" }).ToHtmlString()).Width(150);
               columns.Command(command =>
               {
                   command.Destroy().Text(Resources.ActionButton_Cancel);
                   //command.Custom("Download").Click("DownloadAttachmnets");
               });
           })
           .ToolBar(toolbar =>
           {

                toolbar.Template(@<text>
                            @Html.Kendo().Upload().Name("file").Async(a => a.Save("AttachmentTemplateFiles_Create", "Attachment", new { Area = "Common", attachmentReferenceType = "Clearance", id = "#=EmployeeId#", fileOwner = "#=TerminationId#" })).Events(e => e.Complete("onUploadSuccess1")
                                                                                                                        .Select("function(e) { globalOnSelect(e, ['.jpg', '.png', '.pdf'], 2 * 1024 * 1024); }")
                                                                            .Error("onUploadError")).ShowFileList(false).ToClientTemplate()
                        </text>);




           })
           .Events(e =>
            {
                e.Edit("onGridEdit");
                e.Change("onChange");
            })
                //.ToolBar(toolbar =>
                //{
                //    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

                //})
                .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Upload").Window(window =>
                {
                    window.Scrollable(false);
                    window.Title(Resources.HR_Upload_File);

                }))
                .Scrollable()
                .Selectable()
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Events(events =>
                    {
                        events.Error("error_handler(\"AttachmentGrid_#=TerminationId#\")");
                        events.RequestStart("onRequestStart(\"AttachmentGrid_#=TerminationId#\")");
                        events.RequestEnd("onRequestEnd(\"AttachmentGrid_#=TerminationId#\")");

                    })
                    .Model(model => model.Id(p => p.AttachmentId))
                    .Read(read => read.Action("Attachments_Read", "Attachment", new { Area = "Common", attachmentReferenceType = "Clearance", id = "#=EmployeeId#", fileOwner = "#=TerminationId#" }).Data("sendForgery"))
                    .Create(create => create.Action("Attachments_Create", "Attachment", new { Area = "Common", attachmentReferenceType = "Clearance", id = "#=EmployeeId#", fileOwner = "#=TerminationId#" }).Data("sendForgery"))
                    .Destroy(destroy => destroy.Action("Attachments_Destroy", "Termination").Data("sendForgery"))

                    ).ToClientTemplate()
                )
    }

