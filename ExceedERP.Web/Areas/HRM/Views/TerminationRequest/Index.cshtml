                              columns.ForeignKey(c => c.ApproverId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                              columns.ForeignKey(c => c.ApproverDepartment, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                              columns.Bound(c => c.Remark).Width(100);
                              columns.Command(command =>
                              {
                                  //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  //command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(400);
                          })
                          .ToolBar(toolbar =>
                          {
                              //toolbar.Custom().Action("SendForApproval", "TerminationRequest").Text(Resources.HR_Send_For_Approval);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Scrollable(h => h.Height(300))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                                                        .Events(events =>
                                                        {
                                                            events.Error("error_handler(\"RequestesStatusgrid_#=TerminationId#\")");
                                                            events.RequestStart("onRequestStart(\"RequestesStatusgrid_#=TerminationId#\")");
                                                            events.RequestEnd("onRequestEnd(\"RequestesStatusgrid_#=TerminationId#\")");
                                                        })
