<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }
    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsApproved === true || dataItem.IsSendForApproval) {

                row.css("background-color", "darkgrey");
                row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();
            }
            //else {

            //    row.css("background-color", "lightgreen");
            //    row.find(".k-grid-delete").remove();

            //}


        }
    }

    var masterId = 0;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#TerminationGrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.TerminationId;
        var gridName = "#RequestesStatusgrid_" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatus", "TerminationRequest")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                }
                else if (r == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else if (r == "Dapproved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", gridName).show();
                }

            }

        });

    }
    function SetEmployee(e) {
        var x = e.checked;
        var dropDown = $("#EmployeeId").data("kendoDropDownList");
        if (x == true) {

            dropDown.enable(true);


        }
        else {
            dropDown.value(0);
            dropDown.enable(false);
        }
        $.ajax({
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("SetEmployee", "TerminationRequest")',
            data: { x: x },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
                if (x == true && r == "0") {
                    e.checked = false;
                    dropDown.value(0);
                    dropDown.enable(false);
                    alert("You can not request for other employee!!.\nThere is no employee under your postion.");
                }

            }

        });


    }
    function valueMapper(options) {
        $.ajax({
            url: "/HRM/HRMDataProvider/Employee_ValueMapper/",
            data: {
                value: options.value || 0,
                status: 1,
                excludeId: -1
            },
            success: function (data) {
                options.success(data);
            }
        });
    }

    function convertValues(value) {
        var data = {};

        value = $.isArray(value) ? value : [value];

        for (var idx = 0; idx < value.length; idx++) {
            data["values[" + idx + "]"] = value[idx];
        }

        return data;
    }
    function IsforOthers() {
        return {
            IsForOther: $("#IsForOther").val()
        };
    }

</script>

@* for Confirmation message *@
<script>
    //On click of POPUP form Update button
    save: function(e) {
        //check if the row is being edited and not newly added
        if (! e.model.isNew())
        {
            if (! confirm("Are you really sure that you want to update the data ?")) 
            {
                //In the confirm box, if the user clicks no or cancel, then do not proceed with the updation of record
                e.preventDefault();
            }
        }
    }
</script>
<script>


    function sendForApproval(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "TerminationRequest", new { area = "HRM" })',
            data: { id: id },
            success: function(result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function(result) {
                alert(result);
            }
        });
    }
    
</script>