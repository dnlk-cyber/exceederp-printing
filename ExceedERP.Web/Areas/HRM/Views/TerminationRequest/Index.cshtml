@using System.Collections
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? true;
}
<Legend>@Resources.NavigatorTermination_TerminationRequest</Legend>
@(Html.Kendo().Grid<Termination>()
      .Name("TerminationGrid")
      .Columns(columns =>
      {

          //columns.Bound(c => c.EmployeeCode).Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "EmployeeCode").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Title(Resources.HR_Prohibition_Prohibition_EmployeeCode).Width(100);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Width(160);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["TerminationTypes"], "LookupId", "Description").EditorTemplateName("TerminationType").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
          if (useEthiopian)
          {
              columns.Bound(c => c.ApplicationDateAm).EditorTemplateName("Calander").Width(120);
              columns.Bound(c => c.TerminationDateAm).EditorTemplateName("Calander").Width(120);

          }
          else
          {
              columns.Bound(c => c.ApplicationDate).Width(120);
              columns.Bound(c => c.TerminationDate).Width(120);
          }
          columns.Bound(c => c.Reason).Width(300);
          // columns.Bound(c => c.Remark).Width (120);

          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })

      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("TerminationRequest").Window(window => { window.Title(Resources.NavigatorTermination_TerminationRequest); window.Scrollable(false); }))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Events(events =>
      {
          events.DataBound("onDataBound");
          events.DetailExpand("onDetailExpandUser");


      })
      .Scrollable(h => h.Height(500))
               .Groupable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
          .Pageable(pageable => pageable.Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
           .Sort(sort => sort.Add("ApplicationDate").Descending())
                              .Events(events =>
                              {
                                  events.Error("error_handler(\"TerminationGrid\")");
                                  events.RequestStart("onRequestStart(\"TerminationGrid\")");
                                  events.RequestEnd("onRequestEnd(\"TerminationGrid\")");
                              })
          .Model(model =>
          {
              model.Id(p => p.TerminationId);
              model.Field(p => p.EmployeeCode).Editable(false);
              //model.Field(p => p.EmployeeId).Editable(false);
          })
                  .Read(read => read.Action("Terminations_Read", "TerminationRequest").Data("sendForgery"))
                  .Create(create => create.Action("Terminations_Create", "TerminationRequest").Data("sendForgery"))
                  .Update(update => update.Action("Terminations_Update", "TerminationRequest").Data("sendForgery"))
                  .Destroy(destroy => destroy.Action("Terminations_Destroy", "TerminationRequest").Data("sendForgery"))

                  ).ClientDetailTemplateId("template")
)
