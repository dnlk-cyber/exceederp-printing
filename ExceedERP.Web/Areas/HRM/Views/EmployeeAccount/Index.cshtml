@(Html.Kendo().Window().Name("AccountCodeIssue")
    .Title("Account Code")
    .Visible(false)
    .Modal(true)
      .Content(@<text>
        @(Html.Kendo().DropDownList()
                          .Name("Accounts")
                          .HtmlAttributes(new { style = "width:200px" })
                          .ValuePrimitive(true)
                          .OptionLabel("Account...")
                                  .DataTextField("GlchartAccunt")
                                  .DataValueField("GlValue")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetAccountCode", "EmployeeAccount", new { area = "HRM" }))
                                  .ServerFiltering(true);
                          })
        )

        <br />

        @(Html.Kendo().DropDownList()
                          .Name("SubAccounts")
                          .ValuePrimitive(true)
                          .OptionLabel("...SubAccount...")
                          .HtmlAttributes(new { style = "width:200px" })
                                  .DataTextField("GlchartSubAccunt")
                                  .DataValueField("GlValue")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetSubAccountCode", "EmployeeAccount", new { area = "HRM" }))
                                  .ServerFiltering(true);
                          })
        )
        <br />

        @(Html.Kendo().DropDownList()
                          .Name("Company")
                          .ValuePrimitive(true)
                          .OptionLabel("...Comapny...")
                          .HtmlAttributes(new { style = "width:200px" })
                                  .DataTextField("Name")
                                  .DataValueField("Value")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetCompany", "EmployeeAccount", new { area = "HRM" }))
                                  .ServerFiltering(true);
                          })
        )
        @Html.ValidationMessageFor(m => m)
        <br />
        <div class="pull-right">
            @Html.Kendo().Button().Name("gggg").Content("Save").Events(ev => ev.Click("rankclicked"))

        </div>

    </text>)
    .Draggable(true)
    .Width(300)
      )

