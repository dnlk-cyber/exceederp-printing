@using System.Collections
@using System.Security.AccessControl
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPayrollSetup_EmployeeAccount</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.Payroll.EmployeeBankAccountView>()
      .Name("Person_Employeegrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(140);
          columns.Bound(c => c.FirstNameEnglish).Width(150);
          columns.Bound(c => c.MiddleNameEnglish).Width(150);
          columns.Bound(c => c.LastNameEnglish).Width(140);
          columns.Bound(c => c.MothersFullName).Width(150);
          columns.Bound(c => c.Gender).Width(100);
          columns.ForeignKey(c => c.Branch, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(80);
          columns.Bound(c => c.AccountNumber).Width(150);
          //  columns.Bound(c => c.Assignment).Width(100);

      })
      .ToolBar(toolbar =>
      {
          toolbar.Excel().Text(Resources .ActionButton_ExportExcel);
          toolbar.Pdf().Text(Resources.ActionButton_ExportPDF);
      })

            .Excel(excel => excel
                                                            .FileName(Resources.NavigatorPayrollSetup_EmployeeAccount + ".xlsx")
                                        .Filterable(true)
                                                .AllPages(true)
             .ProxyURL(Url.Action("Excel_Export_Save", "EmployeeAccount"))
                                    )
                                         .Pdf(pdf => pdf
                                        .AllPages()
                                                                .FileName(Resources.NavigatorPayrollSetup_EmployeeAccount + ".pdf")
                     .ProxyURL(Url.Action("Pdf_Export_Save", "EmployeeAccount"))
                                    )
         .Scrollable(h => h.Height(500))
             
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
          
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Events(events =>
 {
events.Error("error_handler(\"Person_Employeegrid\")");
events.RequestStart("onRequestStart(\"Person_Employeegrid\")");
events.RequestEnd("onRequestEnd(\"Person_Employeegrid\")");
})
                      
          .Model(model =>
          {
              model.Id(p => p.EmployeeId);
              
          })
          
                                  .Read(read => read.Action("Person_Employee_Read", "EmployeeAccount"))

          ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabstrip_#=EmployeeId#")
    .SelectedIndex(0)
    .Items(items =>
     {
         items.Add().Text(Resources.Details).Content(
            @<text>

                @(Html.Kendo().PanelBar()
                                      .Name("panelbar_#=EmployeeId#")
                      .ExpandMode(PanelBarExpandMode.Single)
                      .Items(panelbar =>
                      {
                          panelbar.Add().Text(Resources.Details)
                              .Expanded(true)
                              .Content(
                                  "<div class='employee-details'>" +
                        "<ul>" +
                         "<li><label>" + Resources.HR_Photo + ": </label><div class='EmployeeDetail-photo'style='background-image: url(" + Url.Content("~/Content/Images/") + "#:data.EmployeeId#-Photo/" + "#:data.EmployeeId#.jpg" + ");'/></li>" +
                         "<li><label>" + Resources.Common_PersonEmployee_EmployeeCode + ": </label>#=EmployeeCode #</li>" +
                              // "<li><label>Title:  </label>#=Title #</li>" +
                            "<li><label>" + Resources.Common_PersonEmployee_FirstNameEnglish + ":</label>#=FirstNameEnglish #</li>" +
                             "<li><label>" + Resources.Common_PersonEmployee_MiddleNameEnglish + ":    </label>#=MiddleNameEnglish #</li>" +
                              "<li><label>" + Resources.Common_PersonEmployee_LastNameEnglish + ":</label>#=LastNameEnglish #</li>" +
                              // "<li><label>FirstName:</label>#=FirstName #</li>" +
                           "<li><label>" + Resources.Common_PersonEmployee_DateOfBirth + ":</label>#=DateOfBirthAm#</li>" +
                                  "<li><label>" + Resources.Common_PersonEmployee_MothersFullName + ":                </label>#=MothersFullName #</li>" +
                                  "<li><label>" + Resources.Common_PersonEmployee_BirthPlace + ":</label>#=BirthPlace #</li>" +
                                  "<li><label>" + Resources.Common_PersonEmployee_HiredDate + ":</label>#=HiredDateAmharic#</li>" +

                        "</ul>" +
                    "</div>"



                );




                      }).ToClientTemplate()

                )


            </text>


                  );


         //*************************************************************************************************
         //*********************************BankInformation*************************************************//
         items.Add().Text(Resources.NavigatorPayrollSetup_EmployeeAccount).Content(
             @<text>
                 @*<Legend>Bank Account</Legend>*@
                @(Html.Kendo().Grid<BankReference>()
                      .Name("BankReference_#=EmployeeId#")
                      .Columns(columns =>
                      {
                          columns.ForeignKey(c => c.BankId, (System.Collections.IEnumerable)ViewData["BankList"], "BankId", "Name").EditorTemplateName("Bank").Width(150);
                          columns.Bound(c => c.Type).EditorTemplateName("Enum");
                          columns.Bound(c => c.AccountNumber);
                          columns.Bound(c => c.Remark);
                          columns.Command(command =>
                          {
                              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                             command.Destroy().Text(Resources.ActionButton_Cancel);
                          }).Width(200);
                      })
                      .ToolBar(toolbar =>
                      {
                          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                      })
                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                      .Scrollable()
                      .DataSource(dataSource => dataSource
                          .Ajax()
                                   .Events(events =>
         {
             events.Error("error_handler(\"BankReference_#=EmployeeId#\")");
             events.RequestStart("onRequestStart(\"BankReference_#=EmployeeId#\")");
             events.RequestEnd("onRequestEnd(\"BankReference_#=EmployeeId#\")");
         })
                                                  
                          .Model(model => model.Id(p => p.BankReferenceId))
                                          .Read(read => read.Action("BankReferences_Read", "BankReference", new {Area="Common", id = "#=EmployeeId#", bankReferenceType = "Employee" }))
                                          .Create(create => create.Action("BankReferences_Create", "BankReference", new {Area="Common", id = "#=EmployeeId#", bankReferenceType = "Employee" }))
                                          .Update(update => update.Action("BankReferences_Update", "BankReference", new {Area="Common"}))
                                          .Destroy(destroy => destroy.Action("BankReferences_Destroy", "BankReference", new {Area="Common"}))
                      ).ToClientTemplate()
                      )

            
              </text>
            );
         
     }).ToClientTemplate())
</script>
<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
