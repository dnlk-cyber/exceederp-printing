</style>

<script>
    
    var popup;
    var aCode;
    var templbtn;

    function SelectAccCode() {
        templbtn = "acc";
        var wnd = $("#AccountCodeIssue").data("kendoWindow");
        wnd.center().open();
    }

    function rankclicked(e) {

        var account = $("#Accounts").data("kendoDropDownList").value();
        var subaccount = $("#SubAccounts").data("kendoDropDownList").value();
        var company = $("#Company").data("kendoDropDownList").value();
        var glAcc = account + "-" + company + "-" + "00000" + "-" + subaccount;
        if (account !== "" && subaccount !== "" && company !== "") {
            if (templbtn === "iacc") {
                $("#IssueAccCode").val(glAcc).trigger("change");

            }
            else if (templbtn === "acc") {
                $("#AccountCode").val(glAcc).trigger("change");

            }
            var window = $("#AccountCodeIssue").data("kendoWindow");

            window.close();
        } else {
            alert("Please select all the neccessary Fields");
        }

    }
</script>
