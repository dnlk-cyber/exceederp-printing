<script>
    function BranchList() {

        var value = this.value(),
           grid = $("#Person_Employeegrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "Branch", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }

    }
    function AssignmentList() {

        var value = this.value(),
           grid = $("#Person_Employeegrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "Assignment", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }

    }
</script>