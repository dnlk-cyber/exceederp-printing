<Legend>@Resources.NavigatorDiscipline_EmployeeDisciplinaryCase</Legend>
@(Html.Kendo().Grid<DisciplinaryCase>()
          .Name("DisciplinaryCasegrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(200);
          columns.Bound(c => c.TransgressionDateAm).EditorTemplateName("Calander").Width(200);
          columns.Bound(c => c.NatureofTransgression).Width(200);
          columns.Bound(c => c.Evidence).Width(200);
          //columns.Bound(c => c.Remark).Width (150);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
          .Groupable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
              .Events(e =>
              {
                  e.Save("GetDate");

                  e.Edit("GetDate");
              })
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Events(events =>
                                        {
                                            events.Error("error_handler(\"DisciplinaryCasegrid\")");
                                            events.RequestStart("onRequestStart(\"DisciplinaryCasegrid\")");
                                            events.RequestEnd("onRequestEnd(\"DisciplinaryCasegrid\")");
                                        })
                       
          .Model(model => { model.Id(p => p.DisciplinaryCaseId); 
          model.Field(p => p.EmployeeCode).Editable (false);})
          .Read(read => read.Action("DisciplinaryCases_Read", "DisciplinaryCase"))
              .Create(create => create.Action("DisciplinaryCases_Create", "DisciplinaryCase"))
          .Update(update => update.Action("DisciplinaryCases_Update", "DisciplinaryCase"))
          .Destroy(destroy => destroy.Action("DisciplinaryCases_Destroy", "DisciplinaryCase"))
          ).ClientDetailTemplateId("template")
      )

