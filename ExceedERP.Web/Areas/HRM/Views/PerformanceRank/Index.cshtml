@using System.Collections
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPerformance_PerformanceRank</legend>
@(Html.Kendo().Grid<PerformanceRank>()
          .Name("PerformanceRank")
      .Columns(columns =>
      {

          columns.Bound(c => c.Description);
        columns.Bound(c => c.Minimum);
        columns.Bound(c => c.Maximum);
        columns.Bound(c => c.BonusRate);
        columns.Bound(c => c.Remark);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
              .Ajax()
                   .Events(events =>
                                                        {
                                                            events.Error("error_handler(\"PerformanceRank\")");
                                                            events.RequestStart("onRequestStart(\"PerformanceRank\")");
                                                            events.RequestEnd("onRequestEnd(\"PerformanceRank\")");
                                                        })
                           
          .Model(model => model.Id(p => p.PerformanceRankId))
          .Read(read => read.Action("PerformanceRank_Read", "PerformanceRank").Data("sendForgery"))
          .Create(create => create.Action("PerformanceRank_Create", "PerformanceRank").Data("sendForgery"))
          .Update(update => update.Action("PerformanceRank_Update", "PerformanceRank").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("PerformanceRank_Destroy", "PerformanceRank").Data("sendForgery"))
      )
)
