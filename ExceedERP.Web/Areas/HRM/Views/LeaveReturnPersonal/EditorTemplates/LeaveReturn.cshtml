@using System.Collections
@using ExceedERP.Helpers.Common
@using Kendo.Mvc.UI
@using ExceedERP.Core.Domain.Common
@model ExceedERP.Core.Domain.HRM.LeaveManagment.LeaveReturn

@using ExceedERP.Core.Localization

<div class="form">
    <div class="row fullrow">
        <div class="col-md-4 ro1">
            <div class="form-group">

                <div class="col-md-6">


                    @(Html.CheckBoxFor(m => m.IsForOther, htmlAttributes: new { @onchange = "SetEmployee(this)" })

                    )
                    @Html.LabelFor(model => model.IsForOther, htmlAttributes: new { @class = "control-label col-md-8" })
                    @Html.ValidationMessageFor(model => model.IsForOther, "", new { @class = "text-danger" })
                </div>

            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.EmployeeId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.EmployeeId)
                                                                  //  .Name("EmployeeId")
                                                                  .DataValueField("PersonId")
                                                                  .DataTextField("FullName")
                                                                  .Events(e => e.Change("GetBalance"))
                                                                  .OptionLabel(Resources.Select)
                                                                  .Filter("contains")
                                                                  .MinLength(2)
                                                                  //.CascadeFrom("IsForOther")
                                                                  .HtmlAttributes(new { style = "width:200px" })
                                                                  .Virtual(v => v.ValueMapper("valueMapper").ItemHeight(26))
                                                                  .DataSource(source =>
                                                                  {
                                                                      source.Read(read =>
                                                                      {
                                                                          read.Action("GetEmployeesAskForOther", "HRMDataProvider");
                                                                              //.Data("IsforOthers");
                                                                          })
                                                                          .ServerFiltering(false);
                                                                  })
                                                                  .Enable(false)
                                                                  .ValuePrimitive(true)


                                                                  .Height(400)
                                                                  .HeaderTemplate("<div class=\"dropdown-header k-widget k-header\">" +
                                                                                  "<span>Photo</span>" +
                                                                                  "<span>Full Name</span>" +
                                                                                  "</div>")
                                                                  .Template(@"<div class='Employee-photo' style='background-image: url(" + Url.Content("~/Content/Images/") + "#:data.PersonId#-Photo/" + "#:data.PersonId#." + "#:data.ImageType#" + ");'></div>" +
                                                                            "<div class='Employee-name'>#:FullName#</div>")
                    )



                </div>

            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.FromAm, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.FromAm, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />

                    @Html.ValidationMessageFor(model => model.FromAm, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ToAm, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.ToAm, htmlAttributes: new { disabled = "disabled", @class = "et-popup-picker" }) <img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />

                    @Html.ValidationMessageFor(model => model.ToAm, "", new { @class = "text-danger" })
                </div>
            </div>

        </div>
       
        <div class="col-md-3 ro1">
            <div class="row"></div><br /><br />
            <div class="form-group">
                @Html.LabelFor(model => model.GlFiscalYearId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.GlFiscalYearId)
                                  .OptionLabel(Resources.Select)
                                  .Filter("contains")
                                  .MinLength(2)
                                  .DataTextField("Name")
                                  .DataValueField("GlFiscalYearId")
                                  .DataSource(dataSource =>
                                  {
                                      dataSource.Read(read => read.Action("GetFisicalYear", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery"))
                                          .ServerFiltering(false);
                                  })
                                  .ValuePrimitive(true)

                    )
                    @Html.ValidationMessageFor(model => model.GlFiscalYearId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Amount, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().TextBoxFor(model => model.Amount)
                                                          .Enable(false))
                    @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                </div>
            </div>



        </div>
    </div>

</div>


<style>
    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>