@using System.Collections
@using ExceedERP.Core.Domain.HRM.Company
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.Navigator_Company_JobTitleMapping</legend>
@(Html.Kendo().Grid<JobTitleMapping>()
          .Name("JobTitleMappinggrid")
      .Columns(columns =>
      {
        columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["organization"], "OrgStructureId", "Name").EditorTemplateName("OrgSelector").Width(270);
        columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["jobTitles"], "LookupId", "Description").EditorTemplateName("JobTitles").Width( 200);
        //columns.Bound(c => c.MainFunction).Width(150);
        columns.Bound(c => c.Quntity).Width( 100);
        columns.Bound(c => c.PlanType).EditorTemplateName("PlanType").Width(120);
        columns.Bound(c => c.Remark).Width( 120);
        columns.Command(command =>
        {
            if (HttpContext.Current.User.IsInRole("HR_Company_User"))

            {
                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
            }
            if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Company_Admin"))
            {
                command.Destroy().Text(Resources.ActionButton_Cancel);
            }
        }).Width(200);
      })
      .ToolBar(toolbar => {
                              if (HttpContext.Current.User.IsInRole("HR_Company_User"))

                              {
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              }
                              if (HttpContext.Current.User.IsInRole("HR_Admin") || HttpContext.Current.User.IsInRole("HR_Company_Admin"))
                              {
                                  toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
                                  toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
                              }
      })
           .Excel(excel => excel
                                                                                                                .FileName(Resources.Navigator_Company_JobTitleMapping + ".xlsx")
                                                                    .Filterable(true)
                                                                        .AllPages(true)
                                                                                                                            .ProxyURL(Url.Action("Excel_Export_Save", "JobTitleMappingCourt"))
                                                                )
                                                                     .Pdf(pdf => pdf
                                                                    .AllPages()
                                                                                                                            .FileName(Resources.Navigator_Company_JobTitleMapping + ".pdf")
                                                                                                                            .ProxyURL(Url.Action("Pdf_Export_Save", "JobTitleMappingCourt"))
                                                                )
                      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("JobTitleMapping").Window(window => { window.Title(Resources.Navigator_Company_JobTitleMapping); window.Scrollable(false); }))
         .Scrollable(h => h.Height(500))
                             .Groupable()
                                      .Sortable(sortable =>
                                      {
                                          sortable.SortMode(GridSortMode.SingleColumn);
                                      })
                          .Filterable()
                             .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Events(events =>
                    {

                        events.Error("error_handler(\"JobTitleMappinggrid\")");
                        events.RequestStart("onRequestStart(\"JobTitleMappinggrid\")");
                        events.RequestEnd("onRequestEnd(\"JobTitleMappinggrid\")");
                    })
                      
          .Model(model => model.Id(p => p.JobTitleMappingId))
              .Read(read => read.Action("JobTitleMapping_Read", "JobTitleMappingCourt"))
              .Create(create => create.Action("JobTitleMapping_Create", "JobTitleMappingCourt"))
              .Update(update => update.Action("JobTitleMapping_Update", "JobTitleMappingCourt"))
              .Destroy(destroy => destroy.Action("JobTitleMapping_Destroy", "JobTitleMappingCourt"))
          ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=JobTitleMappingId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text(Resources.HR_Company_JobTitleMappingDetail_MainFunction).Content(
                @<text>
                  
                   @(Html.Kendo().Grid<JobTitleMappingMain>()
                              .Name("JobTitleMappingMian_#=JobTitleMappingId#")
      .Columns(columns =>
      {
          columns.Bound(c => c.MainFunction);
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
                  .Events(events =>
                            {

                                events.Error("error_handler(\"JobTitleMappingMian_#=JobTitleMappingId#\")");
                                events.RequestStart("onRequestStart(\"JobTitleMappingMian_#=JobTitleMappingId#\")");
                                events.RequestEnd("onRequestEnd(\"JobTitleMappingMian_#=JobTitleMappingId#\")");
                            })
                                  
          .Model(model => model.Id(p => p.JobTitleMappingMianId))
                                                 .Read(read => read.Action("JobTitleMappingMian_Read", "JobTitleMappingMain", new { id = "#=JobTitleMappingId#" }))
                          .Create(create => create.Action("JobTitleMappingMian_Create", "JobTitleMappingMain", new { idTwo = "#=JobTitleMappingId#" }))
                  .Update(update => update.Action("JobTitleMappingMian_Update", "JobTitleMappingMain"))
                  .Destroy(destroy => destroy.Action("JobTitleMappingMian_Destroy", "JobTitleMappingMain"))
      ).ToClientTemplate()
                )


                </text>
                  );
                  
              items.Add().Text(Resources.Details ).Content(
                @<text>

                    @(Html.Kendo().Grid<JobTitleMappingDetail>()
                      .Name("JobTitleMappingDetailTwo_#=JobTitleMappingId#")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["EduLevelList"], "LookupId", "Description").EditorTemplateName("EduLevel").Width(150);
          columns.Bound(c => c.RelevantExp);
          columns.Bound(c => c.Experience);
          columns.Bound(c => c.SpecialSkill);
          columns.Bound(c => c.PlannedSalary);
          //columns.Bound(c => c.Remark);
          //columns.Bound(c => c.OrgBranchName);
          //columns.Bound(c => c.DateCreated);
          //columns.Bound(c => c.LastModified);
          //columns.Bound(c => c.CreatedBy);
          //columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
                   .Events(events =>
                                    {

                                        events.Error("error_handler(\"JobTitleMappingDetailTwo_#=JobTitleMappingId#\")");
                                        events.RequestStart("onRequestStart(\"JobTitleMappingDetailTwo_#=JobTitleMappingId#\")");
                                        events.RequestEnd("onRequestEnd(\"JobTitleMappingDetailTwo_#=JobTitleMappingId#\")");
                                    })
                                 
          .Model(model => model.Id(p => p.JobTitleMappingDetailId))
                          .Read(read => read.Action("JobTitleMappingDetail_Read", "JobTitleMappingDetail", new { id = "#=JobTitleMappingId#" }))
                  .Create(create => create.Action("JobTitleMappingDetail_Create", "JobTitleMappingDetail", new { idTwo = "#=JobTitleMappingId#" }))
          .Update(update => update.Action("JobTitleMappingDetail_Update", "JobTitleMappingDetail"))
          .Destroy(destroy => destroy.Action("JobTitleMappingDetail_Destroy", "JobTitleMappingDetail"))
      ).ToClientTemplate()
                    )


                </text>
                  );

          }).ToClientTemplate())
</script>
