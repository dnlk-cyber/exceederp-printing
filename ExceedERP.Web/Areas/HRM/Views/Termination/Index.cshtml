@helper loan()
{
    @(Html.Kendo().Grid<ExceedERP.Core.Domain.HRM.Payroll.Loan>()
                .Name("Loangrid#=TerminationId#")
                .Columns(columns =>
                {
                    columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ActiveEmployees").Width(200).Filterable(ftb => ftb.Multi(true).Search(true));
                    columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["PeriodList"], "GLPeriodId", "Name").EditorTemplateName("GLPeriodSelector").Width(120);
                    columns.Bound(c => c.LoanAmount).Width(110);
                    columns.Bound(c => c.Months).Width(100);
                    columns.Bound(c => c.MonthlyAmount).Width(120);
                    columns.Bound(c => c.Balance).Width(100);
                    columns.Bound(c => c.Description).Visible(false);
                    columns.Bound(c => c.JumpHoliday).ClientTemplate(
                        "<input type='checkbox' disabled = 'true' value='\\#= JumpHoliday\\#' " +
                        "\\# if (JumpHoliday) { \\#" +
                        "checked='checked'" +
                        "\\# } \\#" +
                        "/>"
                    ).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(120);
                    columns.Bound(c => c.IsActive).ClientTemplate(
                        "<input type='checkbox' disabled = 'true' value='\\#= IsActive\\#' " +
                        "\\# if (IsActive) { \\#" +
                        "checked='checked'" +
                        "\\# } \\#" +
                        "/>"
                    ).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(120);
                    columns.Bound(c => c.Remark);
                })
                .Scrollable(h => h.Height(500))
                .Sortable(sortable => sortable.SortMode(GridSortMode.SingleColumn))
                .Filterable()
                .Pageable(pageable => pageable
                    .Input(true)
                    .Numeric(false)
                    .Refresh(true)
                    .PageSizes(true)
                    .ButtonCount(5))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Sort(sort => sort.Add("LoanId").Descending())
                    .Events(events =>
                    {
                        events.Error("error_handler(\"Loangrid#=TerminationId#\")");
                        events.RequestStart("onRequestStart(\"Loangrid#=TerminationId#\")");
                        events.RequestEnd("onRequestEnd(\"Loangrid#=TerminationId#\")");
                    })
                    .Model(model =>
                    {
                        model.Id(p => p.LoanId);
                        model.Field(p => p.MonthlyAmount).Editable(false);
                        model.Field(p => p.Balance).Editable(false);
                    })
                    .Read(read => read.Action("Loans_Read_Per_Employee", "Termination", new { Area = "HRM", employeeId = "#=EmployeeId#" }).Data("sendForgery"))
                ).ToClientTemplate())
}

