@using System.Collections
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Domain.HRM.LeaveManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool useEthiopian = ViewData["isEthiopicDate"] as bool? ?? true;
    var approvalConfigs = ViewData["ApprovalConfigs"] as List<ExceedERP.Core.Domain.HRM.Company.CompanyApprovalSetting>
                          ?? new List<ExceedERP.Core.Domain.HRM.Company.CompanyApprovalSetting>();
}

<script>
    // Serialize enabled approval steps ordered by StepOrder for sequential client validation
    var activeApprovalSteps = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
        approvalConfigs.Select(x => new {
            Role = x.Role.ToString(),
            x.StepOrder
        })
    ));
</script>

<div class="termination-page-container">
    @Html.AntiForgeryToken()
    <!-- Top Header -->
    <div class="erp-header-card">
        <h2 class="erp-page-title">
            <i class="fa-solid fa-user-xmark text-danger"></i>
            @Resources.NavigatorTermination_Termination
        </h2>
        <div>
            <a href="javascript:void(0);" onclick="updateEmployeeTermination(this)" class="btn-action-refresh">
                <i class="fa fa-refresh text-primary"></i>
                @Resources.ActionButton_Update @Resources.Rpt_Termination
            </a>
        </div>
    </div>
    <!-- Top Legend Bar -->
    <div class="erp-legend-card">
        <div class="erp-legend-items">
            <span class="text-muted small" style="font-weight: 700;">STATUS:</span>
            <div class="legend-indicator">
                <span class="legend-dot approved"></span>
                <span>Online Approved</span>
            </div>
            <div class="legend-indicator">
                <span class="legend-dot forced"></span>
                <span>Forcibly Terminated</span>
            </div>
            <div class="legend-indicator">
                <span class="legend-dot pending"></span>
                <span>Pending Approval</span>
            </div>
        </div>
        <div class="text-muted small">
            Date Mode: <strong>@(useEthiopian ? "Ethiopic Calendar" : "Gregorian")</strong>
        </div>
    </div>
</div>

@(Html.Kendo().Grid<Termination>()
        .Name("TerminationGrid")
        .Columns(columns =>
        {
            columns.Bound(c => c.EmployeeCode).Width(100).Hidden();
            columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").Filterable(g => g.Search(true).Multi(true)).EditorTemplateName("ActiveEmployees").Width(180);
            columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
            columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
            columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
            columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["TerminationTypes"], "LookupId", "Description").Filterable(g => g.Search(true).Multi(true)).EditorTemplateName("TerminationType").Width(150);
            columns.Bound(c => c.Reason).Width(100);
            columns.Bound(c => c.IsEarlyRetirement).ClientTemplate(
                "<input type='checkbox' disabled = 'true' value='#= IsEarlyRetirement#' " +
                "# if (IsEarlyRetirement) { #" +
                "checked='checked'" +
                "# } #" +
                "/>").Width(140);

            columns.Bound(c => c.IsOnlineApproved).ClientTemplate(
                "<input type='checkbox' disabled = 'true' value='#= IsOnlineApproved#' " +
                "# if (IsOnlineApproved) { #" +
                "checked='checked'" +
                "# } #" +
                "/>").Title("Status").Width(120);

            columns.Bound(c => c.IsForciblyTerminated).ClientTemplate(
                "<input type='checkbox' disabled = 'true' value='#= IsForciblyTerminated#' " +
                "# if (IsForciblyTerminated) { #" +
                "checked='checked'" +
                "# } #" +
                "/>").Width(150);

            if (useEthiopian)
            {
                columns.Bound(c => c.ApplicationDateAm).EditorTemplateName("Calander").Width(140);
                columns.Bound(c => c.TerminationDateAm).EditorTemplateName("Calander").Width(140);
            }
            else
            {
                columns.Bound(c => c.ApplicationDate).Width(140);
                columns.Bound(c => c.TerminationDate).Width(140);
            }

            columns.Command(command =>
            {
                if (HttpContext.Current.User.IsInRole("HR_Termination_User"))
                {
                    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                }

    // 1. Dynamically render optional approval commands based on CompanyApprovalSettings
    if (approvalConfigs != null && approvalConfigs.Any())
                {
                    foreach (var config in approvalConfigs)
                    {
                        string roleName = config.Role.ToString();
                        if (HttpContext.Current.User.IsInRole(roleName)||
                            HttpContext.Current.User.IsInRole("HR_Admin"))
                        {
                            command.Custom("cmd-" + roleName)
                                   .Click("approveDynamicStep('" + roleName + "')")
                                   .Text("Approve (" + roleName + ")")
                                   .IconClass("fa fa-check")
                                   .HtmlAttributes(new { @class = "btn btn-info btn-approval-step", @id = "btn_" + roleName });
                        }
                    }
                }

    // 2. Final Approval & administrative operations (HR_Admin)
    if (HttpContext.Current.User.IsInRole("HR_Admin"))
                {
                    command.Custom(Resources.ActionButton_Approve)
                           .Click("terminateEmployee")
                           .Text("Final Approve")
                           .IconClass("fa fa-check-circle")
                           .HtmlAttributes(new
                           {
                               @class = "btn btn-success",
                               @title = "Final Approve the employee termination and process payroll exit",
                               @id = "terminate"
                           });

                    command.Custom("").Click("enableOrUnTerminate")
                           .Text("Un-Terminate")
                           .IconClass("fa fa-undo")
                           .HtmlAttributes(new
                           {
                               @class = "btn btn-primary",
                               @title = "Remove the employee from termination pending lists and restore them to active status",
                               @id = "unterminate"
                           });

                    command.Custom(Resources.Button_Force_Treminate)
                           .Click("forceTerminateEmployee")
                           .IconClass("fa fa-times")
                           .HtmlAttributes(new { @class = "btn btn-danger", @title = "Force Terminate Employees", @id = "forceTerminate" });

                    command.Destroy().Text(Resources.ActionButton_Cancel);
                }

            }).Width(480);

        })
        .ToolBar(toolbar =>
        {
            if (HttpContext.Current.User.IsInRole("HR_Termination_User"))
            {
                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
            }
        })
        .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        .Scrollable(h => h.Height(500))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Filterable()
        .Events(x =>
        {
            x.DataBound("onDataBound");
            x.Save("GetDate");
            x.Edit("GetDate");
        })
        .Pageable(pageable => pageable
            .Input(true)
            .Numeric(false)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Sort(s => s.Add(x => x.TerminationId).Descending())
            .Events(events =>
            {
                events.Error("error_handler(\"TerminationGrid\")");
                events.RequestStart("onRequestStart(\"TerminationGrid\")");
                events.RequestEnd("onRequestEnd(\"TerminationGrid\")");
            })
            .Model(model =>
            {
                model.Id(p => p.TerminationId);
                model.Field(p => p.BranchId).Editable(false);
                model.Field(p => p.BusinessUnitId).Editable(false);
                model.Field(p => p.OrgStructureId).Editable(false);
                model.Field(p => p.IsOnlineApproved).Editable(false);
                model.Field(p => p.IsForciblyTerminated).Editable(false);
            })
            .Read(read => read.Action("Terminations_Read", "Termination").Data("sendForgery"))
            .Create(create => create.Action("Terminations_Create", "Termination").Data("sendForgery"))
            .Update(update => update.Action("Terminations_Update", "Termination").Data("sendForgery"))
            .Destroy(destroy => destroy.Action("Terminations_Destroy", "Termination").Data("sendForgery"))
        ).ClientDetailTemplateId("template")
)

