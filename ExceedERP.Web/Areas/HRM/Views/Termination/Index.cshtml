<script>
    function terminateEmployee(e) {
         var row = $(e.target).closest("tr");
        var grid = $("#TerminationGrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.TerminationId;

        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("TerminateEmployee", "Termination")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);
                    $('#loading-image').hide();
                    grid.dataSource.read();
                }
            });

        }
    }
</script>


<script>
    function forceTerminateEmployee(e) {
         var row = $(e.target).closest("tr");
        var grid = $("#TerminationGrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.TerminationId;

        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("ForceTerminateEmployee", "Termination")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);
                    $('#loading-image').hide();
                    grid.dataSource.read();
                }
            });

        }
    }
</script>

<script>
    function onDataBound(e) {

        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check
            if (dataItem.IsOnlineApproved === true) {

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find("#terminate").hide();
                row.css("background-color", "gray");
                row.find("#unterminate").show();

            }
            if (dataItem.IsDirect === false) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find("#terminate").hide();
                row.find("#unterminate").show();

            }
            if (dataItem.IsActive === false)
            {
                row.find("#forceTerminate").hide();
                row.find("#unterminate").show();

            }
            if (dataItem.IsForciblyTerminated === true) {
                row.find("#forceTerminate").hide();
                row.find("#unterminate").show();

            }
            if (dataItem.IsOnlineApproved === false) {
                row.find("#unterminate").hide();

            }
        }
    }

    function enableOrUnTerminate(e) {
        var row = $(e.target).closest("tr");
        var grid = $("#TerminationGrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.TerminationId;
        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("UnterminateEmployee", "Termination")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                r = result;
                alert(r.Message);
                $('#loading-image').hide();
                grid.dataSource.read();
                }
                });


        }


    }

</script>