<script>
    function filterEmployees() {
        return {
            text: $("#EmployeeId").data("kendoDropDownList").filterInput.val(),
        };
    }

    function Paid() {
        var Gidd = $("#GlFiscalYearId").data("kendoDropDownList");
        var gid = Gidd.value();
        var Idd = $("#EmployeeId").data("kendoDropDownList");
        var id = Idd.value();
        if (id !== null && gid !== null) {
            $.ajax({
                url: '@Url.Action("Paid", "Termination")',
                data: { employeeId: id, fiscalYearId: gid },
                type: 'POST',
                cache: false,
                success: function (result) {
                    if (result === true) {
                        alert("Paid successfully");
                    } else {
                        alert("Paid not successfully");
                    }
                }
            });
        }
    }

    function sync_handler(e) {
        this.read();
    }

    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();
    }

    function onChange(e) {
        var selectedRows = this.select();
        var rowData = this.dataItem(selectedRows[0]);
        var id = rowData.AttachmentID;
        $.ajax({
            url: '@Url.Action("Download", "Termination")',
            contentType: "application/json; charset=utf-8",
            data: { 'id': id },
            type: 'GET',
            cache: false,
            success: function (result) { }
        });
    }

    function GetDate() {
        $("#TerminationDateAm").trigger("change");
        $("#ApplicationDateAm").trigger("change");

        var x = AssignDate();
        var y = x;
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "Termination")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) { }
            });
        }
    }

    function AssignDate() {
        return AssignDates();
    }

    // Final Approval (Original functionality maintained)
    function terminateEmployee(e) {
        var row = $(e.target).closest("tr");
        var grid = $("#TerminationGrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.TerminationId;

        if (id) {
            if (!confirm("Are you sure you want to perform Final Approval for this employee termination?")) {
                return;
            }
            $('#loading-image').show();
            $.ajax({
                url: '@Url.Action("TerminateEmployee", "Termination")',
                data: { id: id },
                type: 'POST',
                cache: false,
                success: function (result) {
                    alert(result.Message);
                    $('#loading-image').hide();
                    grid.dataSource.read();
                },
                error: function () {
                    $('#loading-image').hide();
                    alert("An error occurred during final approval.");
                }
            });
        }
    }

    // Dynamic Step Approval Click Handler
    function approveDynamicStep(roleName) {
        return function (e) {
            e.preventDefault();
            var row = $(e.target).closest("tr");
            var grid = $("#TerminationGrid").data("kendoGrid");
            var dataItem = grid.dataItem(row);
            var id = dataItem.TerminationId;

            if (id) {
                if (!confirm("Approve step as '" + roleName + "'?")) {
                    return;
                }
                $('#loading-image').show();
                $.ajax({
                    url: '@Url.Action("TerminationApprovalStep", "Termination", new { area = "HRM" })',
                    type: 'POST',
                    data: {
                        id: id,
                        roleName: roleName,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (result) {
                        alert(result.Message);
                        if (result.Status === "Ok") {
                            grid.dataSource.read();
                        }
                    },
                    error: function (xhr) {
                        alert(xhr.responseJSON ? xhr.responseJSON.Message : "An error occurred while approving step.");
                    },
                    complete: function () {
                        $('#loading-image').hide();
                    }
                });
            }
        };
    }

    function forceTerminateEmployee(e) {
        var row = $(e.target).closest("tr");
        var grid = $("#TerminationGrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.TerminationId;
        if (id) {
            if (!confirm("Are you sure you want to forcibly terminate this employee?")) {
                return;
            }
            $('#loading-image').show();
            $.ajax({
                url: '@Url.Action("ForceTerminateEmployee", "Termination")',
                data: { id: id },
                type: 'POST',
                cache: false,
                success: function (result) {
                    alert(result.Message);
                    $('#loading-image').hide();
                    grid.dataSource.read();
                }
            });
        }
    }

    function onDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");

        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            var $terminate = row.find("#terminate");
            var $unterminate = row.find("#unterminate");
            var $forceTerminate = row.find("#forceTerminate");
            var $edit = row.find(".k-grid-edit");
            var $delete = row.find(".k-grid-delete");

            // Hide action and dynamic buttons by default for this row
            if ($terminate.length) $terminate.hide();
            if ($unterminate.length) $unterminate.hide();
            row.find("[id^='btn_']").hide();

            // 1. Fully finalized / online approved
            if (dataItem.IsOnlineApproved === true) {
                $edit.hide();
                $delete.hide();
                if ($forceTerminate.length) $forceTerminate.hide();
                row.css("background-color", "#e2e8f0");
                if ($unterminate.length) $unterminate.show();
                continue;
            }

            // 2. Direct request checks
            if (dataItem.IsDirect === false) {
                $edit.hide();
                $delete.hide();
                if ($terminate.length) $terminate.hide();
                if ($unterminate.length) $unterminate.show();
            }
            if (dataItem.IsActive === false) {
                if ($forceTerminate.length) $forceTerminate.hide();
                if ($unterminate.length) $unterminate.show();
            }
            if (dataItem.IsForciblyTerminated === true) {
                if ($forceTerminate.length) $forceTerminate.hide();
                if ($unterminate.length) $unterminate.show();
                continue;
            }

            // 3. Sequential optional steps evaluation based on database order
            var pendingStepRole = null;

            if (activeApprovalSteps && activeApprovalSteps.length > 0) {
                for (var s = 0; s < activeApprovalSteps.length; s++) {
                    var step = activeApprovalSteps[s];
                    var isStepDone = false;

                    switch (step.Role) {
                        case "ProjectHRAdmin":
                        case "HROfficer":
                            isStepDone = dataItem.IsProjectHRApproved;
                            break;
                        case "ProjectManager":
                        case "GM":
                            isStepDone = dataItem.IsPMApproved;
                            break;
                        case "DepartmentHead":
                        case "DepartmentManager":
                        case "ProjectDepartmentHead":
                            isStepDone = dataItem.IsDepartmentHeadApproved;
                            break;
                        case "HRManager":
                        case "HRAdministrationManager":
                        case "HumanResourceAdmin":
                            isStepDone = dataItem.IsHRManagerApproved;
                            break;
                        case "DailLabour":
                        case "DGM":
                            isStepDone = dataItem.IsAdditionalApproved;
                            break;
                        default:
                            isStepDone = dataItem.IsAdditionalApproved;
                            break;
                    }

                    // First incomplete predecessor step blocks the remaining ones
                    if (!isStepDone) {
                        pendingStepRole = step.Role;
                        break;
                    }
                }
            }

            if (pendingStepRole) {
                // Show ONLY the button corresponding to the next pending step
                var $activeBtn = row.find("#btn_" + pendingStepRole);
                if ($activeBtn.length) {
                    $activeBtn.show();
                }
            } else {
                // All configured optional steps are finished (or none configured): unlock Final Approve
                if ($terminate.length) {
                    $terminate.show();
                }
            }
        }
    }

    function enableOrUnTerminate(e) {
        e.preventDefault();

        var row = $(e.target).closest("tr");
        var grid = $("#TerminationGrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);

        if (!dataItem || !dataItem.TerminationId) {
            alert("Invalid termination record.");
            return;
        }

        var id = dataItem.TerminationId;

        if (!confirm("Are you sure you want to un-terminate this employee?")) {
            return;
        }

        $('#loading-image').show();

        $.ajax({
            url: '@Url.Action("UnTerminateEmployee", "Termination", new { area = "HRM" })',
            type: 'POST',
            data: {
                id: id,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (result) {
                alert(result.Message);
                if (result.Status === "OK") {
                    grid.dataSource.read();
                }
            },
            error: function () {
                alert("An error occurred while processing the request.");
            },
            complete: function () {
                $('#loading-image').hide();
            }
        });
    }

    function updateEmployeeTermination(element) {
        var $button = $(element);
        var $icon = $button.find('i');
        var originalIcon = $icon.attr('class');

        $icon.attr('class', 'fa fa-spinner fa-spin');
        $button.prop('disabled', true);
        $('#loading-image').show();

        $.ajax({
            url: '@Url.Action("DeactivateTerminatedEmployees", "Termination")',
            type: 'POST',
            dataType: 'json',
            success: function (response) {
                if (response.success) {
                    alert(response.message);
                } else {
                    alert(response.message || 'Operation failed.');
                }
            },
            error: function () {
                alert('An error occurred while deactivating employees. Please try again.');
            },
            complete: function () {
                $('#loading-image').hide();
                $icon.attr('class', originalIcon);
                $button.prop('disabled', false);
            }
        });
    }
</script>

