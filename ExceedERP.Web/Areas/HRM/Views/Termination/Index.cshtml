<Legend>@Resources.NavigatorTermination_Termination</Legend>
@(Html.Kendo().Grid<Termination>()
        .Name("TerminationGrid")
        .Columns(columns =>
        {

            columns.Bound(c => c.EmployeeCode).Width(100).Hidden();
            columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").Filterable(g=>g.Search(true).Multi(true)).EditorTemplateName("ActiveEmployees").Width(180);
            columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["TerminationTypes"], "LookupId", "Description").Filterable(g => g.Search(true).Multi(true)).EditorTemplateName("TerminationType").Width(150);
            //columns.Bound(c => c.TerminationLevel).Width(120);
            columns.Bound(c => c.ApplicationDateAm).EditorTemplateName("Calander").Width(140);
            columns.Bound(c => c.Reason).Width(100);
            columns.Bound(c => c.IsOnlineApproved).ClientTemplate(
             "<input type='checkbox' disabled = 'true' value='#= IsOnlineApproved#' " +
             "# if (IsOnlineApproved) { #" +
             "checked='checked'" +
             "# } #" +
             "/>"
             ).Title("Status").Width(100);
            columns.Bound(c => c.IsForciblyTerminated).ClientTemplate(
             "<input type='checkbox' disabled = 'true' value='#= IsForciblyTerminated#' " +
             "# if (IsForciblyTerminated) { #" +
             "checked='checked'" +
             "# } #" +
             "/>"
             ).Width(150);
            columns.Bound(c => c.TerminationDateAm).EditorTemplateName("Calander").Width(140);
            // columns.Bound(c => c.Remark).Width (120);
            columns.Command(command =>
            {
                if (HttpContext.Current.User.IsInRole("HR_Termination_User"))
                {
                    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                }
                if (HttpContext.Current.User.IsInRole("HR_Admin"))
                {
                    command.Destroy().Text(Resources.ActionButton_Cancel);
                    command.Custom(Resources.ActionButton_Approve).Click("terminateEmployee").IconClass("fa fa-check").HtmlAttributes(new { @class = "btn btn-success", @title = "Approve termination", @id = "terminate" });
                    //command.Custom("").Click("enableOrUnTerminate").Text("UnTerminate").IconClass("fa fa-check fa2x").HtmlAttributes(new { @class = "btn btn-primary", @title = "unterminate ", @id = "unterminate" });
                    command.Custom(Resources.Button_Force_Treminate).Click("forceTerminateEmployee").IconClass("fa fa-check").HtmlAttributes(new { @class = "btn btn-danger", @title = "Force Terminate Employees", @id = "forceTerminate" });
                }
            }).Width(400);

        })
        .ToolBar(toolbar =>
        {
            if (HttpContext.Current.User.IsInRole("HR_Termination_User"))
            {
                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
            }

        })
        .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })

        .Scrollable(h => h.Height(500))

        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Filterable()
        .Events(x =>
        {
            x.DataBound("onDataBound");
            x.Save("GetDate");
            x.Edit("GetDate");
        })
        .Pageable(pageable => pageable
        .Input(true)
        .Numeric(false)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5))
        .DataSource(dataSource => dataSource
                .Ajax()
                .Sort(s=>s.Add(x=>x.TerminationId).Descending())
                    .Events(events =>
                    {
                        events.Error("error_handler(\"TerminationGrid\")");
                        events.RequestStart("onRequestStart(\"TerminationGrid\")");
                        events.RequestEnd("onRequestEnd(\"TerminationGrid\")");
                    })
                    .Model(model =>
                    {
                        model.Id(p => p.TerminationId);
                        model.Field(p => p.IsOnlineApproved).Editable(false);
                        model.Field(p => p.IsForciblyTerminated).Editable(false);
                    })
                    .Read(read => read.Action("Terminations_Read", "Termination"))
                    .Create(create => create.Action("Terminations_Create", "Termination"))
                    .Update(update => update.Action("Terminations_Update", "Termination"))
                    .Destroy(destroy => destroy.Action("Terminations_Destroy", "Termination"))

                    ).ClientDetailTemplateId("template")
)
