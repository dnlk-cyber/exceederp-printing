<script>
    function GetDate() {

        $("#TerminationDateAm").trigger("change");
        $("#ApplicationDateAm").trigger("change");

        var x = AssignDate();
        var y = x;
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "Termination")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
