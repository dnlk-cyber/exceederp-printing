    function secondLevelApproval(e) {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        var year = dataItem.GlFiscalYearId;
        var period = dataItem.GlPeriodId;
        var employee = dataItem.EmployeeId;
        var conf = confirm("Are you sure you want to approve this quarter performance evaluation");
        if (conf === true) {
            $('#loading-image').show();
            $.ajax({
                url: '@Url.Action("ApproveEvaluation", "EmployeePerformanceSecondLevelSummaries")',
                //contentType: "application/json; charset=utf-8",
                data: { year: year, period: period, employee: employee },
                type: 'POST',
                cache: false,
                success: function (result) {
                   
                    alert(result.Message);
                    grid.dataSource.read();
                   
                   

                }

            });
        }



    }

    function secondLevelRejection(e) {
    e.preventDefault();
    var grid = this,
        dataItem = grid.dataItem($(e.currentTarget).closest("tr"));

    var year = dataItem.GlFiscalYearId;
    var period = dataItem.GlPeriodId;
    var employee = dataItem.EmployeeId;

    var reason = prompt("Please provide a reason for rejecting this evaluation (will be returned to the 1st Evaluator):");
    if (reason === null) {
        return; // User canceled prompt
    }

    if ($.trim(reason) === "") {
        alert("A rejection reason is required.");
        return;
    }

    $('#loading-image').show();
    $.ajax({
        url: '@Url.Action("RejectEvaluation", "EmployeePerformanceSummaries")',
        data: { year: year, period: period, employee: employee, rejectionReason: reason },
        type: 'POST',
        cache: false,
        success: function (result) {
            alert(result.Message);
            grid.dataSource.read();
        },
        error: function (xhr, status, error) {
            alert("An error occurred while rejecting the evaluation: " + error);
        },
        complete: function () {
            $('#loading-image').hide();
        }
    });
}
</script>
