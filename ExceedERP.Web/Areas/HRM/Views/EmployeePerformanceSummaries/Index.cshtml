    function changeparent() {
        var nextApproverEmployeeId = document.getElementById('NextApprovareEmployeeId').value;
        if (nextApproverEmployeeId.length === 0) {
            alert("Please select Employee.");
        } else {
            var id = document.getElementById('currentEmployeeId').value;
            $.ajax({
                type: "POST",
                url: '/HRM/HRMDataProvider/UpdateNextApprover',
                data: {
                    currentEmployeeId: id,
                    nextApproverEmployeeId: nextApproverEmployeeId
                },
                success: function (result) {
                    console.log("AJAX request succeeded:", result);
                    if (result && result.Message) {
                        alert(result.Message);

                        // Update the parent window's element
                        var approverElement = window.opener.document.getElementById("new_user_name_display");
                        if (approverElement) {
                            approverElement.innerText = "Sent to: " + result.NextApproverName;
                        }

                        // Close the Kendo Window
                        var wnd = $("#SelectEmployee").data("kendoWindow");
                        if (wnd) {
                            wnd.close();
                        } else {
                            console.error("Kendo Window instance not found.");
                        }
                    } else {
                        alert(result.Message);
                        console.error(result.Message);
                    }
                },
                error: function (xhr, status, error) {
                    var errorMessage = xhr.status + ': ' + xhr.statusText;
                    alert("An error occurred: " + errorMessage);
                    console.error("AJAX request failed:", status, error, xhr);
                }
            });
        }
    }


</script>
