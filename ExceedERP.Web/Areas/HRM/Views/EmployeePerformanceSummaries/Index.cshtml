<style>
    #approveButtonStyle {
        border-radius: 5%;
        padding-top: 1px;
        padding-bottom: 1px;
    }
</style>


<script>
    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (!model.IsImmediateSuppurvisorApproved) {
                $(this).find(".k-grid-cmd-approval-request").show();
                $(this).find(".k-grid-cmd-secondlevelapproval-request").hide();

            }
            if (model.IsImmediateSuppurvisorApproved) {
                $(this).find(".k-grid-cmd-approval-request").hide();
                $(this).find(".k-grid-cmd-secondlevelapproval-request").show();

            }

            if (model.IsSecondLevelApproved) {
                $(this).find(".k-grid-cmd-approval-request").hide();
                $(this).find(".k-grid-cmd-secondlevelapproval-request").hide();
            }

        });


    }


</script>

<script>
   function immidiateApproval(e) {
    var grid = this,
        dataItem = grid.dataItem(e.currentTarget.closest("tr"));
    var year = dataItem.GlFiscalYearId;
    var period = dataItem.GlPeriodId;
    var employee = dataItem.EmployeeId;
       var empPerformanceId = dataItem.EmployeePerformanceId;
    var conf = confirm("Are you sure you want to approve this quarter performance evaluation");
    if (conf === true) {
        $('#loading-image').show();

        $.ajax({
            url: '@Url.Action("ApproveEvaluation", "EmployeePerformanceSummaries")',
            //contentType: "application/json; charset=utf-8",
            data: { year: year, period: period, employee: employee, empPerformanceId: empPerformanceId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                $('#loading-image').hide();
                if (r == "true") {
                    alert("Successfully Approved");
                    // Reload the page to reflect the changes
                    location.reload();
                } else {
                    alert("Approval cannot be granted. The individual must first Accept or Reject the evaluation.");
                    grid.dataSource.read();
                }
            },
            error: function (xhr, status, error) {
                $('#loading-image').hide();
                alert("An error occurred: " + error);
            }
        });
    }
}


    function secondLevelApproval(e) {
        var grid = this,
            dataItem = grid.dataItem(e.currentTarget.closest("tr"));
        var year = dataItem.GlFiscalYearId;
        var period = dataItem.GlPeriodId;
        var employee = dataItem.EmployeeId;
        var conf = confirm("Are you sure you want to approve this quarter performance evaluation");
        if (conf === true) {
            $('#loading-image').show();
            $.ajax({
                url: '@Url.Action("ApproveEvaluation", "EmployeePerformanceSecondLevelSummaries")',
                //contentType: "application/json; charset=utf-8",
                data: { year: year, period: period, employee: employee },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    if (r == "true") {
                        alert("Successfully Approved");
                        grid.dataSource.read();
                    }
                    else {
                        alert("Approval cannot be granted until the 1st level evaluation is approved");
                        grid.dataSource.read();
                    }

                }

            });
        }



    }
</script>
