<script>
    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (model.IsImmediateSuppurvisorApproved === false) {
                $(this).find(".k-grid-cmd-approval-request").show();
                $(this).find(".k-grid-cmd-secondlevelapproval-request").hide();
                $(this).find(".k-grid-cmd-secondlevelreject-request").hide();

            }
            else if (model.IsImmediateSuppurvisorApproved) {
                $(this).find(".k-grid-cmd-approval-request").hide();
                $(this).find(".k-grid-cmd-secondlevelapproval-request").show();
                $(this).find(".k-grid-cmd-secondlevelreject-request").show();

            }
            else if (model.IsSecondLevelApproved) {
                $(this).find(".k-grid-cmd-approval-request").hide();
                $(this).find(".k-grid-cmd-secondlevelapproval-request").hide();
                $(this).find(".k-grid-cmd-secondlevelreject-request").hide();
            }
            else if (model.IsSecondLevelRejected) {
                $(this).find(".k-grid-cmd-approval-request").hide();
                $(this).find(".k-grid-cmd-secondlevelapproval-request").hide();
                $(this).find(".k-grid-cmd-secondlevelreject-request").hide();
            }
            
            
          

         

        });


    }


</script>

<div class="modal fade" id="l1EvalModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Level 1 Approver Remarks</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="l1_year" />
                <input type="hidden" id="l1_period" />
                <input type="hidden" id="l1_employee" />
                <input type="hidden" id="l1_empPerformanceId" />

                <div class="form-group">
                    <label>Employee Special Accomplishments</label>
                    <textarea id="l1_accomplishments" class="form-control" rows="2"></textarea>
                </div>
                <div class="form-group">
                    <label>Employee Strengths</label>
                    <textarea id="l1_strengths" class="form-control" rows="2"></textarea>
                </div>
                <div class="form-group">
                    <label>Areas Needing Improvement</label>
                    <textarea id="l1_improvements" class="form-control" rows="2"></textarea>
                </div>
                <div class="form-group">
                    <label>General Remark</label>
                    <textarea id="l1_remark" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="confirmL1Approval()">Submit & Approve</button>
            </div>
        </div>
    </div>
</div>
<script>
    function immidiateApproval(e) {
    e.preventDefault();
    var grid = this,
        dataItem = grid.dataItem($(e.currentTarget).closest("tr"));

    $('#l1_year').val(dataItem.GlFiscalYearId);
    $('#l1_period').val(dataItem.GlPeriodId);
    $('#l1_employee').val(dataItem.EmployeeId);
    $('#l1_empPerformanceId').val(dataItem.EmployeePerformanceId);

    $('#l1_accomplishments').val(dataItem.SpecialAccomplishments || '');
    $('#l1_strengths').val(dataItem.Strengths || '');
    $('#l1_improvements').val(dataItem.AreasNeedingImprovement || '');
    $('#l1_remark').val(dataItem.Remark || '');

    $('#l1EvalModal').modal('show');
}

    function confirmL1Approval()
    {
        $('#l1EvalModal').modal('hide');
        $('#loading-image').show();

        $.ajax({
            url: '@Url.Action("ApproveEvaluation", "EmployeePerformanceSummaries")',
            type: 'POST',
            data: {
                year: $('#l1_year').val(),
                period: $('#l1_period').val(),
                employee: $('#l1_employee').val(),
                empPerformanceId: $('#l1_empPerformanceId').val(),
                remark: $('#l1_remark').val(),
                specialAccomplishments: $('#l1_accomplishments').val(),
                strengths: $('#l1_strengths').val(),
                areasNeedingImprovement: $('#l1_improvements').val()
            },
            cache: false,
            success: function (result) {
                if (typeof result === "object") {
                    alert(result.Message);
                } else if (result === "true") {
                    alert("Successfully Approved and forwarded to Level 2.");
                } else {
                    alert("Approval cannot be granted. The individual must first Accept or Reject all the evaluations.");
                }
                $("#EmployeePerformancegrid").data("kendoGrid").dataSource.read();
            },
            error: function (xhr, status, error) {
                alert("An error occurred: " + error);
            },
            complete: function () {
                $('#loading-image').hide();
            }
        });
    }
