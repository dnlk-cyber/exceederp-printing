@using System.Collections
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>@Resources.NavigatorPerformance_EmployeePerformance</legend>
@(Html.Kendo().Grid<EmployeePerformance>()
                  .Name("EmployeePerformancegrid")
                  .Columns(columns =>
                  {
                      columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").Width(200).EditorTemplateName("EmployeeLists").Filterable(ftb => ftb.Multi(true).Search(true));
                      columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["fiscalYearList"], "GlFiscalYearId", "Name").EditorTemplateName("GLYearSelector").Width(80);
                      columns.ForeignKey(c => c.GlPeriodId, (IEnumerable)ViewData["Period"], "QuarterId", "Name").Width(200);
                     
                      columns.Command(command =>
                      {
                          command.Custom("cmd-approve-request").IconClass("fa fa-check ").Text("Approva").Click("secondLevelApproval").HtmlAttributes(new { @class = "btn btn-success" });

                      }).Width(100);

                  })

                  .Editable(editable => editable.Mode(GridEditMode.InLine))
                  .Filterable()
                  .Scrollable(h => h.Height("auto"))
                  .Events(ev=>ev.DataBound("onDataBound"))
                  .Pageable(pageable => pageable
                      //.Input(true)
                      // .Numeric(false)
                      .Refresh(true)
                     //.PageSizes(true)
                     // .ButtonCount(5)
                     )

                 .DataSource(dataSource => dataSource
                     .Ajax()
                     .Events(events =>
                     {
                         events.Error("error_handler(\"EmployeePerformancegrid\")");
                         events.RequestStart("onRequestStart(\"EmployeePerformancegrid\")");
                         events.RequestEnd("onRequestEnd(\"EmployeePerformancegrid\")");
                     })
                     .Model(model =>
                     {
                         model.Id(p => p.EmployeePerformanceId);
                         model.Field(p => p.Result).Editable(false);


                     })
                    .Read(read => read.Action("EmployeePerformanceSummaries_Read", "EmployeePerformanceSummaries"))
                    ).ClientDetailTemplateId("employee_performance_template")
                    )

