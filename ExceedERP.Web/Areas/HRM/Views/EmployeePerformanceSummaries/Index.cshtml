                .Pageable(pageable => pageable
                      //.Input(true)
                      // .Numeric(false)
                      .Refresh(true)
                     //.PageSizes(true)
                     // .ButtonCount(5)
                     )

              .DataSource(dataSource => dataSource
                     .Ajax()
                     .Events(events =>
                     {
                         events.Error("error_handler(\"EmployeePerformancedetailgrid_#=EmployeePerformanceId#\")");
                         events.RequestStart("onRequestStart(\"EmployeePerformancedetailgrid_#=EmployeePerformanceId#\")");
                         events.RequestEnd("onRequestEnd(\"EmployeePerformancedetailgrid_#=EmployeePerformanceId#\")");
                     })
                     .Model(model =>
                     {
                         model.Id(p => p.EmployeePerformanceId);
                         model.Field(p => p.Result).Editable(false);


                     })
                    .Read(read => read.Action("EmployeePerformanceSummaries_OnePerson_Read", "EmployeePerformanceSummaries",new { employeeId= "#=EmployeeId#", fiscalyearId= "#=GlFiscalYearId#", quarterId= "#=GlPeriodId#" }))

                    ).ClientDetailTemplateId("employee_performance_detail_template")
                    .ToClientTemplate()
