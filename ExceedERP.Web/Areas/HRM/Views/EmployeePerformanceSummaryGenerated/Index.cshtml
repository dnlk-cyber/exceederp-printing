<script>
    function onChangeGrid(e) {
        var grid = $("#grid").data("kendoGrid");
        grid.dataSource.read();
    }

    function refreshPerformanceData()
    {

        var yearId = $("#GlFiscalYearId").data("kendoDropDownList").value();
        if (yearId == "") {
            alert("Please select the Fiscal year first!!");
        }
        $('#loading-image').show();
        $.ajax({
            url: '@Url.Action("RefreshPerformanceData", "EmployeePerformanceSummaryGenerated")',
            data: { yearId: yearId},
            type: 'POST',
            cache: false,
            success: function (result) {

                alert(result.Message);
                $('#loading-image').hide();
                var grid = $("#grid").data("kendoGrid");
                grid.dataSource.read();
            }

        });
    }
</script>