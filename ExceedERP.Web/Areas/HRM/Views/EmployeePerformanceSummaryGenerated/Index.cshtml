@using System.Collections
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="perf-summary-header">
    <i class="fa fa-line-chart"></i>
    <legend>@Resources.Performance_Summary_Generated</legend>
</div>

<div class="perf-summary-toolbar">
    <div class="row">

        <div class="col-md-2 col-sm-6 col-xs-12">

            <label class="control-label">Year</label>

            @(Html.Kendo().DropDownListFor(m => m)
                .Name("GlFiscalYearId")
                .OptionLabel(Resources.Select)
                .Filter("contains")
                .DataTextField("Name")
                .DataValueField("GlFiscalYearId")
                .DataSource(dataSource =>
                {
                    dataSource.Read(read => read.Action("GetFiscalYearForPerformance", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery"))
                        .ServerFiltering(false);
                })
                .HtmlAttributes(new { style = "width: 100%;" })
            )

        </div>

        <div class="col-md-2 col-sm-6 col-xs-12">

            <label class="control-label">@Resources.Rpt_Branch</label>

            @(Html.Kendo().DropDownListFor(m => m)
                        .Name("Branch")
                        .OptionLabel(Resources.Select)
                        .Filter("contains")
                        .DataTextField("Name")
                        .DataValueField("BranchId")
                        .DataSource(dataSource =>
                        {
                            dataSource.Read(read => read.Action("GetAllBranchs", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery"))
                            .ServerFiltering(false);
                        })
                    .AutoBind(false)
                    .HtmlAttributes(new { style = "width: 100%;" })
            )

        </div>
        <div class="col-md-2 col-sm-6 col-xs-12">

            <label class="control-label">Business Unit</label>
            @(Html.Kendo().DropDownListFor(m => m)
                    .Name("businessUnit")
                    .OptionLabel(Resources.Select)
                    .Filter("contains")
                    .DataTextField("Name")
                    .DataValueField("Code")
                    .DataSource(dataSource =>
                    {
                        dataSource.Read(read => read.Action("GetAllBusinessUnits", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery"))
                        .ServerFiltering(false);
                    })
                    .HtmlAttributes(new { style = "width: 100%;" })
            )

        </div>

        <div class="col-md-2 col-sm-6 col-xs-12">

            <label class="control-label">@Resources.HR_PerformanceManagment_EmployeeMeasurementDefinition_PersonEmployee</label>
            @(Html.Kendo().DropDownListFor(m => m)
                        .Name("EmployeeId")
                        .OptionLabel(Resources.Select)
                        .Filter("contains")
                        .DataTextField("FullNameaEnglish")
                        .DataValueField("EmployeeId")
                        .Events(e => e.Change("EmployeeId"))
                        .DataSource(dataSource =>
                        {
                            dataSource.Read(read => read.Action("GetAllEmployeesForPerformance", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery").Data("filterEmployeeBranch"))
                            .ServerFiltering(true);

                        })
                        .HtmlAttributes(new { style = "width: 100%;" })
            )

        </div>
        <div class="col-md-2 col-sm-6 col-xs-12">

            <label class="control-label">&nbsp;</label>
            @(Html.Kendo().Button()
                    .Name("btnRefresh")
                    .HtmlAttributes(new { type = "button", @class = "k-primary perf-summary-btn" })
                    .Events(e => e.Click("generateEmployeePerformanceSummary"))
                    .Content("Generate"))

        </div>
        <div class="col-md-2 col-sm-6 col-xs-12">

            <label class="control-label">&nbsp;</label>
             @(Html.Kendo().Button()
                    .Name("btnrefresh")
                    .HtmlAttributes(new { type = "button", @class = "k-primary perf-summary-btn" })
                    .Events(e => e.Click("refreshPerformanceData"))
                    .Content(Resources.Ecabinet_DashBoard_RefreshData))

        </div>
        <div class="col-md-2 col-sm-6 col-xs-12">

            <label class="control-label">&nbsp;</label>
            @(Html.Kendo().Button()
                    .Name("btnExportExcel")
                    .HtmlAttributes(new { type = "button", @class = "k-primary perf-summary-btn" })
                    .Events(e => e.Click("exportPerformanceSummaryExcel"))
                    .Content(Resources.ActionButton_ExportExcel))

        </div>
    </div>
</div>

    <div class="row">

        <div class="col-md-12">

            <div class="perf-summary-grid-wrapper">
            @(Html.Kendo().Grid<EmployeePerformanceSummary>()
                  .Name("grid")
                  .Columns(columns =>
                  {
                      columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "EmployeeCode").Width(140).Title(Resources.Common_PersonEmployee_EmployeeCode).Filterable(ftb => ftb.Multi(true).Search(true));
                      columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").Width(160).EditorTemplateName("EmployeeLists").Filterable(ftb => ftb.Multi(true).Search(true));
                      columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["fiscalYearList"], "GlFiscalYearId", "Name").EditorTemplateName("GLYearSelector").Width(150);
                      //columns.ForeignKey(c => c.GlPeriodId, (IEnumerable)ViewData["Period"], "QuarterId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                      columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
                      columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                      columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
                      columns.Bound(c => c.ResponsibilityLevel).Width(120);
                      columns.Bound(c => c.Weight).Width(80);
                      columns.Bound(c => c.Result).Width(80);
                      columns.Bound(c => c.Bonus).Width(80);
                      columns.Bound(c => c.TotalDays).Width(140);
                      columns.Bound(c => c.Remark).Width(100);

                  })

                   .Excel(excel => excel
                    .FileName("EmployeePerformanceSummaryWithBonus" + ".xlsx")
                    .Filterable(true)
                    .AllPages(true)
                    .ProxyURL(Url.Action("Excel_Export_Save", "EmployeePerformanceSummaryGenerated")))
                    .Pdf(pdf => pdf
                    .AllPages()
                    .FileName("EmployeePerformanceSummaryWithBonus" + ".pdf")
                    .ProxyURL(Url.Action("Pdf_Export_Save", "EmployeePerformanceSummaryGenerated")))
                  .Editable(editable => editable.Mode(GridEditMode.InLine))
                  .Scrollable(h => h.Height(550))
                  .Filterable()
                  .Pageable(pageable => pageable
                          .Input(true)
                           .Numeric(false)
                          .Refresh(true)
                         .PageSizes(true)
                          .ButtonCount(5) )

                  .DataSource(dataSource => dataSource
                  .Ajax()
                  .Events(events =>
                  {
                      events.Error("error_handler(\"grid\")");
                      events.RequestStart("onRequestStart(\"grid\")");
                      events.RequestEnd("onRequestEnd(\"grid\")");

                  })

                  .Model(model =>
                  {
                      model.Id(p => p.EmployeePerformanceSummaryId);
                      model.Field(p => p.Result).Editable(false);


                  } )

                  .Read(read => read.Action("EmployeePerformanceSummary_Read", "EmployeePerformanceSummaryGenerated").Data("sendForgery").Data("filterdata"))
                            ))
            </div>
     

       
        

        </div>
      

    </div>


<script>
 
    function sync_handler(e) {
        this.read();

    }
</script>



