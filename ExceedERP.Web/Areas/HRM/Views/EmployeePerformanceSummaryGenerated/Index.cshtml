<script>
    function ApproveEvaluation() {

        var year = $("#GlFiscalYearId").data("kendoDropDownList").value();
        var period = $("#Period").data("kendoDropDownList").value();
        var employee = $("#EmployeeId").data("kendoDropDownList").value();
        //var evaluationCriteria = $("#EvaluationCriteriaId").data("kendoDropDownList").value();
        //var criteriaCategoryId = $("#CriteriaCategoryId").data("kendoDropDownList").value();

        
        if (year == "") {
            alert("please select the year to approve");
        }
        else if (period == "") {
            alert("please select the period to approve");
        }
        else if (employee == "") {
            alert("please select the employee to approve");
        }
        //else if (evaluationCriteria == "") {
        //    alert("please select the evaluation criteria to approve");
        //}
        else {
            var conf = confirm("Are you sure you want to Submit this quarter performance evaluation");
            if (conf === true) {
                $('#loading-image').show();

                $.ajax({
                    url: '@Url.Action("ApproveEvaluation", "EmployeePerformance")',
                    //contentType: "application/json; charset=utf-8",
                    data: { year: year, period: period, employee: employee/*, evaluationCriteria: evaluationCriteria, criteriaCategoryId: criteriaCategoryId*/},
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        r = result;
                        alert("Successfully Summited");
                        $('#loading-image').hide();

                        if (r == "true")
                        {
                            document.getElementById("approval").innerHTML = "Submitted";
                        }
                        else {
                            document.getElementById("approval").innerHTML = "Not Submitted";
                        }
                        grid.dataSource.read();
                    }

                });
            }
    }
        }
       
</script>
