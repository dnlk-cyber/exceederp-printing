@using System.Collections
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>@Resources.NavigatorPerformance_PerformanceSummary with Bonus</legend>

<div class="row">
    <div class="col-md-12">
           
    <div class="cards-container">
        <div class="k-card k-card-horizontal">
                   
            <div class="k-vbox k-column">
                       
                <div class="k-card-body">
                           
                    <div class="row">



                        <div class="col-md-1">

                            <label class="category-label" @*for="Period"*@>Year</label>

                            <br />

                            @(Html.Kendo().DropDownListFor(m => m)
                                        .Name("GlFiscalYearId")
                                        //.Placeholder("Period")
                                        .OptionLabel(Resources.Select)
                                        .Filter("contains")
                                        .DataTextField("Name")
                                        .DataValueField("GlFiscalYearId")
                                        .DataSource(dataSource =>
                                        {
                                            dataSource.Read(read => read.Action("GetFiscalYear", "EmployeePerformance", new { area = "HRM" }).Data("sendForgery"))
                                                .ServerFiltering(false);
                                        })

                                        .HtmlAttributes(new { style = "width: 120px;" })

                            )

                        </div>

                        <div class="col-md-1">

                            <label class="category-label" for="Period">@Resources.HR_PerformanceManagment_EmployeeMeasurementDefinition_PeriodId</label>

                            <br />

                            @(Html.Kendo().DropDownListFor(m => m)
                                        .Name("Period")
                                        //.Placeholder("Period")
                                        .OptionLabel(Resources.Select)
                                        .Filter("contains")
                                        .CascadeFrom("GlFiscalYearId")
                                        .DataTextField("Name")
                                        .DataSource(dataSource =>
                                        {
                                            dataSource.Read(read => read.Action("GetPeriodList", "EmployeePerformance", new { area = "HRM" }).Data("sendForgery").Data("filterPeriod"))
                                            .ServerFiltering(true);
                                        })
                                    .DataValueField("QuarterId")
                                    .AutoBind(false)
                                    .Events(e => e.Change("Period"))
                                    .HtmlAttributes(new { style = "width: 120px;" })

                            )

                        </div>

                        <div class="col-md-1">

                            <label class="category-label" for="EmployeeId">@Resources.HR_PerformanceManagment_EmployeeMeasurementDefinition_PersonEmployee</label>
                            <br />
                            @(Html.Kendo().DropDownListFor(m => m)
                                        .Name("EmployeeId")
                                        .OptionLabel(Resources.Select)
                                        .Filter("contains")
                                        .DataTextField("FullNameaEnglish")
                                        .DataValueField("EmployeeId")
                                        .Events(e => e.Change("EmployeeId"))
                                        .DataSource(dataSource =>
                                        {
                                            dataSource.Read(read => read.Action("GetAllEmployeesForPerformance", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery").Data("filterEmployeeBranch"))
                                            .ServerFiltering(true);

                                        })

                                                .HtmlAttributes(new { style = "width: 150px;" })
                            )

                        </div>
                        


                        <div class="col-md-1">

                            <br />

                            @(Html.Kendo().Button()
                                        .Name("btnRefresh")
                                        .HtmlAttributes(new { type = "button", @class = "k-primary", style = "width: 150px;height:40px" })
                                        .Events(e => e.Click("generateEmployeePerformanceSummary"))
                                        .Content("Generate"))
                            &nbsp; &nbsp;
                            &nbsp; &nbsp;
                            &nbsp;  &nbsp;

                           

                        </div>
                    </div>
                         
                </div>
                       
            </div>
        </div>

    </div>
    </div>
    </div>

      
<br />

    <div class="row">

        <div class="col-md-12">

            @(Html.Kendo().Grid<EmployeePerformanceSummary>()
                  .Name("grid")
                  .Columns(columns =>
                  {
                      columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").Width(160).EditorTemplateName("EmployeeLists").Filterable(ftb => ftb.Multi(true).Search(true));
                      columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["fiscalYearList"], "GlFiscalYearId", "Name").EditorTemplateName("GLYearSelector").Width(150);
                      columns.ForeignKey(c => c.GlPeriodId, (IEnumerable)ViewData["Period"], "QuarterId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
                      columns.Bound(c => c.Weight).Width(80);
                      columns.Bound(c => c.Result).Width(80);
                      columns.Bound(c => c.Bonus).Width(80);
                      columns.Bound(c => c.Remark).Width(50);

                  })

                   .ToolBar(toolbar =>
                   {
                      
                      
                     
                           toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
                      

                   })
                   .Excel(excel => excel
                    .FileName("EmployeePerformanceSummaryWithBonus" + ".xlsx")
                    .Filterable(true)
                    .AllPages(true)
                    .ProxyURL(Url.Action("Excel_Export_Save", "EmployeePerformanceSummaryGenerated")))
                    .Pdf(pdf => pdf
                    .AllPages()
                    .FileName("EmployeePerformanceSummaryWithBonus" + ".pdf")
                    .ProxyURL(Url.Action("Pdf_Export_Save", "EmployeePerformanceSummaryGenerated")))
                  .Editable(editable => editable.Mode(GridEditMode.InLine))
                  .Scrollable(h => h.Height(550))
                  .Filterable()
                  .Pageable(pageable => pageable
                          .Input(true)
                           .Numeric(false)
                          .Refresh(true)
                         .PageSizes(true)
                          .ButtonCount(5) )

                  .DataSource(dataSource => dataSource
                  .Ajax()
                  .Events(events =>
                  {
                      events.Error("error_handler(\"grid\")");
                      events.RequestStart("onRequestStart(\"grid\")");
                      events.RequestEnd("onRequestEnd(\"grid\")");

                  })

                  .Model(model =>
                  {
                      model.Id(p => p.EmployeePerformanceSummaryId);
                      model.Field(p => p.Result).Editable(false);


                  } )

                  .Read(read => read.Action("EmployeePerformanceSummary_Read", "EmployeePerformanceSummaryGenerated").Data("sendForgery").Data("filterdata"))
                            ))
     

       
        

        </div>
      

    </div>


<script>
 
    function sync_handler(e) {
        this.read();

    }
</script>



