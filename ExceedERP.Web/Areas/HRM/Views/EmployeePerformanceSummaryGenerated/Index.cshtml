<script>

    var EmployeePerformanceId_Global = 0;

    function exportPerformanceSummaryExcel() {
        $("#grid").data("kendoGrid").saveAsExcel();
    }

    function generateEmployeePerformanceSummary()
    {
        var employeeId = $("#EmployeeId").data("kendoDropDownList").value();
        var yearId = $("#GlFiscalYearId").data("kendoDropDownList").value();
        //var periodId = $("#Period").data("kendoDropDownList").value();
        var branchId = $("#Branch").data("kendoDropDownList").value();
        var code = $("#businessUnit").data("kendoDropDownList").value();

        if (!yearId /*|| !periodId*/) {
            alert("Please select Fiscal Year, and Period.");
            return;
        }
         $.ajax({
             url: '@Url.Action("GenerateEmployeePerformanceSummary", "EmployeePerformanceSummaryGenerated",new { area="HRM"})',
             data: { empId: employeeId, fiscalYearId: yearId/*, periodId: periodId*/, branchId:branchId,code:code, },
            type: 'POST',
            cache: false,
            success: function (result) {

                alert(result.Message);
                var grid = $("#grid").data("kendoGrid");
                grid.dataSource.read();
            }

        });

        var grid = $("#grid").data("kendoGrid");

       // grid.dataSource.transport.read();
      grid.dataSource.read();

      //  grid.refresh();


    }
</script>

