        }

            .perf-summary-toolbar .col-md-2,
            .perf-summary-toolbar .col-sm-6,
            .perf-summary-toolbar .col-xs-12 {
                margin-bottom: 14px;
            }

            .perf-summary-toolbar .control-label {
                font-size: 12px;
            }

        .perf-summary-btn {
            height: 38px;
        }

        #grid .k-grid-toolbar .pull-right {
            float: none !important;
            display: block;
            width: 100%;
            margin-top: 8px;
        }

        #grid .k-grid-toolbar .btn {
            width: 100%;
        }

        #grid.k-grid {
            font-size: 12px;
        }
    }
