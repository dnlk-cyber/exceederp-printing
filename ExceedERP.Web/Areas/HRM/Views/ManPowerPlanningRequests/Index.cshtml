<Legend>@Resources.Man_power_Planning_Requests</Legend>
@(Html.Kendo().Grid<ManPowerPlanningRequest>()
        .Name("ManPowerPlanningRequestgrid")
        .Columns(columns =>
        {
            columns.Bound(c => c.ManPowerPlanningRequestId).Title("S.No").Width(80);
            columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").EditorTemplateName("Branch").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
            columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["Departments"], "OrgStructureId", "Name").EditorTemplateName("Department").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
            columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLPeriodSelector").Filterable(ftb => ftb.Multi(true).Search(true)).Width(80);

            columns.Bound(c => c.EmploymentType).EditorTemplateName("Enum").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
            columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["jobTitles"], "LookupId", "Description").EditorTemplateName("JobTitles").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
            columns.Bound(c => c.PlanType).EditorTemplateName("Enum").Filterable(ftb => ftb.Multi(true).Search(true)).Width(110);
            columns.Bound(c => c.NoOfShouldBeStaff).Width(135);
            columns.Bound(c => c.NoOfCurrentStaff).Width(130);

            columns.Bound(c => c.NoOfVaccantPostion).Title(Resources.Recruitment_Requested_Vacancy).Width(140);

            // columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
        })
        .ToolBar(toolbar =>
        {
            // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
        })
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Request").Window(window => { window.Title("Man Power Planning Request"); window.Scrollable(false); }))
        .Events(events => events.DetailExpand("onDetailExpandUser"))
            .HtmlAttributes(new { style = "height: 550px;" })
            .Groupable()
            .Sortable(sortable =>
            {
                sortable.SortMode(GridSortMode.SingleColumn);
            })
            .Filterable()
            .Scrollable()
        .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Sort(sort => sort.Add("ManPowerPlanningRequestId").Descending())
            .Events(events =>
            {
                events.Error("error_handler(\"ManPowerPlanningRequestgrid\")");
                events.RequestStart("onRequestStart(\"ManPowerPlanningRequestgrid\")");
                events.RequestEnd("onRequestEnd(\"ManPowerPlanningRequestgrid\")");

            })
            .Model(model =>
            {
                model.Id(p => p.ManPowerPlanningRequestId);
                model.Field(p => p.ManPowerPlanningRequestId).Editable(false);
                model.Field(p => p.NoOfCurrentStaff).Editable(false);
                model.Field(p => p.NoOfShouldBeStaff).Editable(false);


            })
            .Read(read => read.Action("ManPowerPlanningRequests_Read", "ManPowerPlanningRequests"))
            .Create(create => create.Action("ManPowerPlanningRequests_Create", "ManPowerPlanningRequests"))
            .Update(update => update.Action("ManPowerPlanningRequests_Update", "ManPowerPlanningRequests"))
            .Destroy(destroy => destroy.Action("ManPowerPlanningRequests_Destroy", "ManPowerPlanningRequests"))
            ).ClientDetailTemplateId("template")
)



