<script>
    function GetDetail() {

        $("#NoOfVaccantPostion").val(0);
        $("#NoOfCurrentStaff").val(0);
        $("#NoOfShouldBeStaff").val(0);
        var Titles = $("#OrgStructureId").data("kendoComboBox");
        var OrgId = Titles.value();
        var jobs = $("#LookupId").data("kendoComboBox");
        var title = jobs.value();
        $.ajax({
            url: '@Url.Action("CheckPostions", "RecruitmentRequest")',

            data: { OrgId: OrgId, title: title },
            type: 'POST',
            cache: false,
            success: function(result) {
                r = result;
                var s = r.split(/-/);

                $("#NoOfShouldBeStaff").val(s[0]);
                $("#NoOfCurrentStaff").val(s[1]);
                $("#NoOfVaccantPostion").val(s[2]);
            }

        });
    }
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#RecruitmentRequestgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.RecruitmentRequestId;
        var gridName = "#RequestesStatusgrid_" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatus", "RecruitmentRequestStatus")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                }
                else if (r == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else if (r == "Dapproved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", gridName).show();
                }

            }

        });

    }
</script>
