<script>
    function GetNoOfShouldbe() {
        $("#NoOfShouldBeStaff").val(0);
        var WorkUnit = $("#OrgStructureId").data("kendoDropDownList");
        var workunit = WorkUnit.value();
        var JobTitle = $("#LookupId").data("kendoDropDownList");
        var jobtitle = JobTitle.value();
        var Branch = $("#BranchId").data("kendoDropDownList");
        var branch = Branch.value();

        if (workunit.length !== 0 && jobtitle.length !== 0 && branch.length !== 0)
        {

        $.ajax({
            url: '@Url.Action("GetNoofShouldBe", "RecruitmentRequest")',

            data: { workunit: workunit, jobtitle: jobtitle, branch: branch },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

                var s = r.split(/-/);

                $("#NoOfShouldBeStaff").val(s[0]).trigger("change");
                $("#NoOfCurrentStaff").val(s[1]).trigger("change");
                $("#NoOfVaccantPostion").val(s[2]).trigger("change");


                //$("#NoOfShouldBeStaff").val(r);
        }



        });

    }
    }

</script>
<script>
    function GetNoofCurrent() {
        $("#NoOfCurrentStaff").val(0);
        var WorkUnit = $("#OrgStructureId").data("kendoDropDownList");
        var workunit = WorkUnit.value();
        var JobTitle = $("#LookupId").data("kendoDropDownList");
        var jobtitle = JobTitle.value();




        if (workunit.length !== 0 && jobtitle.length !== 0)
        {

        $.ajax({
            url: '@Url.Action("GetNoOfCurrentStaff", "RecruitmentRequest")',

            data: { workunit: workunit, jobtitle: jobtitle},
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

                $("#NoOfCurrentStaff").val(r);
        }

        });
    }
    }
</script>

