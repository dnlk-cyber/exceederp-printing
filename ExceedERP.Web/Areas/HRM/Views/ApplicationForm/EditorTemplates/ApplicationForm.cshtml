@using ExceedERP.Core.Localization
@model ExceedERP.Core.Domain.HRM.SelfCare.ApplicantionForm

<div class="container-fluid">
    <div class="form-group">
        @Html.CheckBoxFor(model => model.IsForOther, new { onchange = "setApplicationEmployee(this)" })
        @Html.LabelFor(model => model.IsForOther)
    </div>
    <div class="row">
        <div class="col-sm-6 form-group">
            @Html.LabelFor(model => model.EmployeeId)
            @(Html.Kendo().DropDownListFor(model => model.EmployeeId)
                .DataValueField("PersonId")
                .DataTextField("FullName")
                .OptionLabel(Resources.Select)
                .Filter("contains")
                .ValuePrimitive(true)
                .Enable(false)
                .HtmlAttributes(new { style = "width: 100%" })
                .DataSource(source => source.Read(read => read.Action("GetEmployeesAskForOther", "HRMDataProvider", new { area = "HRM" }))))
            @Html.ValidationMessageFor(model => model.EmployeeId)
        </div>
    </div>

    @Html.Partial("~/Areas/HRM/Views/Shared/_ApplicationVacancyFields.cshtml", Model)

    <div class="form-group">
        @Html.LabelFor(model => model.Remark)
        @Html.TextBoxFor(model => model.Remark, new { @class = "k-textbox", style = "width: 100%" })
        @Html.ValidationMessageFor(model => model.Remark)
    </div>
</div>
