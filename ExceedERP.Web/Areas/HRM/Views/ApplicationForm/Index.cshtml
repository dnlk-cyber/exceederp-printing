@using System.Collections
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>@Resources.NavigatorSelfCare_ApplicationForm</legend>
<script src="@Url.Content("~/Areas/HRM/Scripts/application-vacancy.js")"></script>

                    @(Html.Kendo().Grid<ApplicantionForm>()
                      .Name("ApplicantionForm")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "EmployeeCode").Filterable(ftb => ftb.Multi(true).Search(true)).EditorTemplateName("ListOfEmployee").Width(200);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable) ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").Filterable(ftb => ftb.Multi(true).Search(true)).EditorTemplateName("ListOfEmployee").Width(200);
          columns.ForeignKey(c => c.VacancyId, (IEnumerable)ViewData["ApplicationVacancyCodes"], "VacancyId", "VaccancyCode").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["JobTitle"], "LookupId", "Description").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
          columns.Bound(c => c.Remark).Width (80);
          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                              .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ApplicationForm").Window(window =>
                              {
                                  window.Title(Resources.NavigatorSelfCare_ApplicationForm);
                                  window.Scrollable(false);
                              }))
             .Events(events => events.Edit("editSelfCareApplication"))
             .Scrollable(h => h.Height(500))
                         .Groupable()
                                  .Sortable(sortable =>
                                  {
                                      sortable.SortMode(GridSortMode.SingleColumn);
                                  })
                      .Filterable()
                         .Pageable(pageable => pageable
                             .Input(true)
                             .Numeric(false)
                             .Refresh(true)
                             .PageSizes(true)
                             .ButtonCount(5))
          .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ApplicantionFormId").Descending())
                  .Events(events =>
                  {
                      events.Error("error_handler(\"ApplicantionForm\")");
                      events.RequestStart("onRequestStart(\"ApplicantionForm\")");
                      events.RequestEnd("onRequestEnd(\"ApplicantionForm\")");
                  })

          .Model(model => { model.Id(p => p.ApplicantionFormId);
              model.Field(p => p.EmployeeCode).Editable  (false );})
                  .Read(read => read.Action("ApplicantionFormes_Read", "ApplicationForm"))
                  .Create(create => create.Action("ApplicantionFormes_Create", "ApplicationForm"))
                  .Update(update => update.Action("ApplicantionFormes_Update", "ApplicationForm"))
                  .Destroy(destroy => destroy.Action("ApplicantionFormes_Destroy", "ApplicationForm"))
      )
                    )

<script>
    function editSelfCareApplication(e) {
        var employee = e.container.find("[name='EmployeeId']").data("kendoDropDownList");
        employee.enable(e.model.IsForOther);
        showApplicationVacancy(e);
    }

    function setApplicationEmployee(checkbox) {
        var employee = $(checkbox).closest(".k-edit-form-container").find("[name='EmployeeId']").data("kendoDropDownList");
        employee.enable(checkbox.checked);
        if (!checkbox.checked) {
            employee.value("");
            employee.trigger("change");
        }
    }
</script>

<style>
    .k-edit-form-container {
        width: 700px;
        max-width: calc(100vw - 36px);
    }
</style>
