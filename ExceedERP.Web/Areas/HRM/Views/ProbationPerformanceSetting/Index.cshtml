@using System.Collections
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Probation Performance Setting</legend>
@(Html.Kendo().Grid<ProbationPerformanceSetting>()
              .Name("ProbationPerformanceSettinggrid")
          .Columns(columns =>
          {
              columns.Bound(c => c.ProbationMeasurement).EditorTemplateName("Enum").Width(100);
              columns.Bound(c => c.IntialWeight).Width(90);
              columns.Bound(c => c.EndWeight).Width(90);
              columns.Command(command =>
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }).Width(200);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(500))
                     
                            // .Groupable()
                                      .Sortable(sortable =>
                                      {
                                          sortable.SortMode(GridSortMode.SingleColumn);
                                      })
                          .Filterable()
                             .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
                     .Events(events =>
                     {
                         events.Error("error_handler(\"ProbationPerformanceSettinggrid\")");
                         events.RequestStart("onRequestStart(\"ProbationPerformanceSettinggrid\")");
                         events.RequestEnd("onRequestEnd(\"ProbationPerformanceSettinggrid\")");
                     }
                  )

                  .Model(model =>
                  {
                      model.Id(p => p.ProbationPerformanceSettingId);
                      //model.Field(p => p.IntialWeight).Editable(false);
                  })
              .Read(read => read.Action("ProbationPerformanceSetting_Read", "ProbationPerformanceSetting"))
              .Create(create => create.Action("ProbationPerformanceSetting_Create", "ProbationPerformanceSetting"))
              .Update(update => update.Action("ProbationPerformanceSetting_Update", "ProbationPerformanceSetting"))
              .Destroy(destroy => destroy.Action("ProbationPerformanceSetting_Destroy", "ProbationPerformanceSetting"))
          )
)
