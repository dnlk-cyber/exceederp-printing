<script>
    function ApproveAttendance() {

        $("#AttendanceDate").trigger("change");
        var attendanceDate = $("#AttendanceDate").val();

        if (attendanceDate == null || attendanceDate == "") {
            alert("Please select the date first to approve");
        }
        else {
            var grid = $("#grid").data("kendoGrid");

            grid.dataSource.read();

            if (confirm("Are you sure to approve this attendance ?")) {

                   $.ajax({
                         url: '@Url.Action("DepartmentApproveAttendance", "AttendancesNew")',
                         //contentType: "application/json; charset=utf-8",
                       data: { date: attendanceDate },
                         type: 'POST',
                         cache: false,
                         success: function (result) {
                             r = result;
                             alert(r.Message);
                             grid.dataSource.read();
                         }

                   });

            }
        }

    }
</script>



<script>
    function ReturnAttendance() {

        $("#AttendanceDate").trigger("change");
        var attendanceDate = $("#AttendanceDate").val();

        if (attendanceDate == null || attendanceDate == "") {
            alert("Please select the date first to return and check");
        }
        else {
            var grid = $("#grid").data("kendoGrid");

            grid.dataSource.read();

            if (confirm("Are you sure to return back this attendance ?")) {

                   $.ajax({
                         url: '@Url.Action("ReturnAttendance", "AttendancesNew")',
                         //contentType: "application/json; charset=utf-8",
                       data: { date: attendanceDate },
                         type: 'POST',
                         cache: false,
                         success: function (result) {
                             r = result;
                             alert(r.Message);
                             grid.dataSource.read();
                         }

                   });

            }
        }

    }
</script>

