@using System.Collections
@using ExceedERP.Core.Domain.HRM.Attendance
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorAttendance_Absence</legend>
@(Html.Kendo().Grid<Absence>()
      .Name("Absencegrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(200);
          columns.Bound(c => c.FromAbscAmharic).EditorTemplateName("Calander").Width(200);
          columns.Bound(c => c.ToAbscAmharic).EditorTemplateName("Calander").Width(200);
        columns.Bound(c => c.NoOfWorkingDays).Width (156);
        columns.Bound(c => c.Reason).Width (95);
        columns.Bound(c => c.MeasureTaken).Width (125);
        //columns.Bound(c => c.Remark);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Scrollable(h => h.Height(500))
                 .Events(x => x.Save("GetAbscenceDate"))
                                            .Events(x => x.Edit("GetAbscenceDate"))
                         .Groupable()
                                  .Sortable(sortable =>
                                  {
                                      sortable.SortMode(GridSortMode.SingleColumn);
                                  })
                      .Filterable()
                         .Pageable(pageable => pageable
                                                    .Input(true)
                                                    .Numeric(false)
                                                    .Refresh(true)
                                                    .PageSizes(true)
                                                    .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                 .Events(events =>
              {
                  events.Error("error_handler(\"Absencegrid\")");
                  events.RequestStart("onRequestStart(\"Absencegrid\")");
                  events.RequestEnd("onRequestEnd(\"Absencegrid\")");
              }
              )
                       
              .Model(model => { model.Id(p => p.AbsenceId);
              model.Field(p => p.EmployeeCode).Editable(false);})
          .Read(read => read.Action("Absence_Read", "Absence"))
          .Create(create => create.Action("Absence_Create", "Absence"))
          .Update(update => update.Action("Absence_Update", "Absence"))
          .Destroy(destroy => destroy.Action("Absence_Destroy", "Absence"))
      )
)
