                                                dataSource.Read(read => read.Action("GetAllEmployeesForPerformance", "HRMDataProvider", new { area = "HRM" }).Data("sendForgery").Data("filterEmployeeBranch"))
                                                .ServerFiltering(true);



                                            }).ToClientTemplate()
                    )

                </div>
                <div class="col-sm-2" style="padding-right:0px">
                    @Html.TextBox("severanceDate", "", new { disabled = "disabled", @class = "et-popup-picker" });<img src="~/Scripts/etp/images/calendar-blue.gif" onclick="SelectDate(this)" />

                </div>
                <div class="col-sm-2" style="padding-right:0px">
                    <a onclick='return generateSeverancePayable("#=SeverancePayableId#")' href=' \#' title="Generate"><i class=" fa fa-wrench fa-2x">Generate</i></a>

                </div>
                <div class="col-sm-2" style="padding-right:0px">
                    <a href='@Url.Action("SeverancePayableReport", "EmployeeReport")/#=SeverancePayableId#' title="Print"><i class="fa fa-print fa-2x">Print</i></a>

                </div>
            </div>

              @*<div class="row">
