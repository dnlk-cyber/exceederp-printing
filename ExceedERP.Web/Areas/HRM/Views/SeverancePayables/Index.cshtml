@using System.Collections
@using ExceedERP.Core.Domain.HRM.Severance
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>Severance Payables </Legend>
@(Html.Kendo().Grid<SeverancePayable>()
      .Name("SeverancePayable_grid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
          columns.Bound(c => c.Description).Width(200);
          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
          });

      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(h => h.Height(600))
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
     .Filterable()
     .Pageable(pageable => pageable
        .Input(true)
        .Numeric(false)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5))
        .DataSource(dataSource => dataSource
              .Ajax()
              .Sort(sort=>sort.Add(x=>x.SeverancePayableId).Descending())
              .Events(events =>
              {
                  events.Error("error_handler(\"SeverancePayable_grid\")");
                  events.RequestStart("onRequestStart(\"SeverancePayable_grid\")");
                  events.RequestEnd("onRequestEnd(\"SeverancePayable_grid\")");

              })

              .Model(model => model.Id(p => p.SeverancePayableId))
              .Read(read => read.Action("SeverancePayables_Read", "SeverancePayables").Data("sendForgery"))
              .Create(create => create.Action("SeverancePayables_Create", "SeverancePayables").Data("sendForgery"))
              .Update(update => update.Action("SeverancePayables_Update", "SeverancePayables").Data("sendForgery"))
              .Destroy(destroy => destroy.Action("SeverancePayables_Destroy", "SeverancePayables").Data("sendForgery"))
          ).ClientDetailTemplateId("Severance_Payable_Template")
)
