                    .Create(create => create.Action("SeverancePayableDetails_Create", "SeverancePayableDetails", new { sPId = "#=SeverancePayableId#" }).Data("sendForgery"))
                    .Update(update => update.Action("SeverancePayableDetails_Update", "SeverancePayableDetails").Data("sendForgery"))
                    .Destroy(destroy => destroy.Action("SeverancePayableDetails_Destroy", "SeverancePayableDetails").Data("sendForgery"))

                    ).ToClientTemplate()

            )

        </text>);





        }).ToClientTemplate())
</script>

<script>
    
    function generateSeverancePayable(id) {
        var severanceDate = $("#severanceDate").val();
        var employee = $("#EmployeeId").val();

        $('#loading-image').show();

        $.ajax({
            type: "POST",
            url: '@Url.Action("GenerateSeverancePayable", "SeverancePayables", new { area = "HRM" })',
            data: { id: id, empId: employee, severanceDate: severanceDate },
            success: function (result) {
                alert(result.Message);
                $('#loading-image').hide();
                location.reload(true);
            }, 
            error: function (result) {
                alert(result.Message);
                $('#loading-image').hide();

            }
        });
    }
    function sync_handler(e) {
        this.read();

    }
</script>
<script>
    function filterEmployeeBranch() {
        return {
            text: $("#EmployeeId").data("kendoDropDownList").filterInput.val(),

        };
    }

</script>
<script>
    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsSendForPayment) {

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-close").hide();
                row.find(".k-grid-cmd-pay").hide();
                row.css("background-color", "gray");
            }
            else {
                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-cmd-pay").show();
            }
           

        }

    }

