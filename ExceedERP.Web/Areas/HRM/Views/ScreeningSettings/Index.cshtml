@using System.Collections
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Domain.HRM.RecruitmentManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Screening Setting</legend>
@(Html.Kendo().Grid<ScreeningSetting>()
          .Name("ConfigurationGrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.VacancyId, (IEnumerable)ViewData["Vacancy"], "VacancyId", "VaccancyCode").EditorTemplateName("VacancyLists").Width(150);
          columns.Bound(c => c.OrganizationType).Width(150);
          columns.Bound(c => c.ExperienceYear).Width(150);
          columns.Bound(c => c.Gender).EditorTemplateName("Enum").Width(150);
          columns.Bound(c => c.Language).Width(150);


          //columns.Bound(c => c.Remark);
          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
              .Events(events =>
              {

                  events.Error("error_handler(\"ConfigurationGrid\")");
                  events.RequestStart("onRequestStart(\"ConfigurationGrid\")");
                  events.RequestEnd("onRequestEnd(\"ConfigurationGrid\")");
              })

          .Model(model =>
          {
              model.Id(p => p.ScreeningSettingId);
              model.Field(p => p.Gender).DefaultValue(0);
          })
                  .Read(read => read.Action("ScreeningSettings_Read", "ScreeningSettings"))
                      .Create(create => create.Action("ScreeningSettings_Create", "ScreeningSettings"))
                  .Update(update => update.Action("ScreeningSettings_Update", "ScreeningSettings"))
                  .Destroy(destroy => destroy.Action("ScreeningSettings_Destroy", "ScreeningSettings"))
      ).ClientDetailTemplateId("EducationLevel")
)



