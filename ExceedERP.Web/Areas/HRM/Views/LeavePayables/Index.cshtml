@using System.Collections
@using ExceedERP.Core.Domain.HRM.LeaveManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.NavigatorLeave_LeavePayable </Legend>
@(Html.Kendo().Grid<LeavePayable>()
          .Name("LeavePayable_grid")
          .Columns(columns =>
          {
              columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Width(120);
              columns.Bound(c => c.Description).Width(200);
              columns.Command(command =>
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }).Width(200);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(550))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
              .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Events(events =>
              {
                  events.Error("error_handler(\"LeavePayable_grid\")");
                  events.RequestStart("onRequestStart(\"LeavePayable_grid\")");
                  events.RequestEnd("onRequestEnd(\"LeavePayable_grid\")");

              })

              .Model(model => model.Id(p => p.LeavePayableId))
              .Read(read => read.Action("LeavePayables_Read", "LeavePayables"))
              .Create(create => create.Action("LeavePayables_Create", "LeavePayables"))
              .Update(update => update.Action("LeavePayables_Update", "LeavePayables"))
              .Destroy(destroy => destroy.Action("LeavePayables_Destroy", "LeavePayables"))
          ).ClientDetailTemplateId("Leave_Payable_Template")
)
<script id="Leave_Payable_Template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
              .Name("tabstrip_#=LeavePayableId#")
              .SelectedIndex(0)
                 .Items(items =>
                 {
                     items.Add().Text("Leave Payable Details").Content(
        @<text>
    <div class="row">
        <div class="col-sm-4" style="padding-right:0px">
            <a onclick='return generateLeavePayable("#=LeavePayableId#")' href=' \#' title="Generate"><i class="fa fa-wrench fa-2x"></i>Generate</a>

        </div>
        <div class="col-sm-4" style="padding-left:0px">
            <a href='@Url.Action("LeavePayableReport", "LeaveReport")/#=LeavePayableId#' title="Print"><i class="fa fa-print fa-2x">Print</i></a>
            
        </div>
        </div>
        @(Html.Kendo().Grid<LeavePayableDetail>()
                                  .Name("LeavePayableDetail_grid#=LeavePayableId#")
                                  .Columns(columns =>
                                  {

                                          columns.Bound(c => c.EmployeeCode).Width(120);
                                          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullName").EditorTemplateName("EmployeeEditor").Width(210);
                                          columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
                                          columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(80);
                                          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
                                          columns.Bound(c => c.Year1).Width(120);
                                          columns.Bound(c => c.Year2).Width(120);
                                          columns.Bound(c => c.PayableDays).Width(120);
                                          columns.Bound(c => c.Balance).Width(120);


                                          columns.Command(command =>
                  {
                                          command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                          command.Destroy().Text(Resources.ActionButton_Cancel);
                                      }).Width(400);
                                      })
                                            //.ToolBar(toolbar =>
                                            //{
                                            //    // toolbar.Custom().Action("SendForApproval", "LeaveReturn").Text(Resources.HR_Send_For_Approval);
                                            //    toolbar.Custom().Action("GenerateLeavePayable", "LeavePayables", new { id = "#=LeavePayableId#" }).Text("Generate");
                                            //})


                                            .Editable(editable => editable.Mode(GridEditMode.InLine))
                                            .Scrollable(h => h.Height(500))
                                            .DataSource(dataSource => dataSource
                                                .Ajax()
                                                .Events(events =>
                                                {
                                                        events.Error("error_handler(\"LeavePayableDetail_grid#=LeavePayableId#\")");
                                                        events.RequestStart("onRequestStart(\"LeavePayableDetail_grid#=LeavePayableId#\")");
                                                        events.RequestEnd("onRequestEnd(\"LeavePayableDetail_grid#=LeavePayableId#\")");


                                                    })
                                               .Model(model =>
                                               {
                                                       model.Id(p => p.LeavePayableDetailId);
                                           //model.Field(p => p.Date).Editable(false).DefaultValue(DateTime.Today);
                                           model.Field(p => p.EmployeeId).Editable(false);
                                                       model.Field(p => p.EmployeeCode).Editable(false);
                                                       model.Field(p => p.EmployeeId).Editable(false);
                                                       model.Field(p => p.BranchId).Editable(false);
                                                       model.Field(p => p.BusinessUnitId).Editable(false);
                                                       model.Field(p => p.PayableDays).Editable(false);
                                                       model.Field(p => p.OrgStructureId).Editable(false);
                                                       model.Field(p => p.Balance).Editable(false);
                                                   })
                                              .Read(read => read.Action("LeavePayableDetails_Read", "LeavePayableDetails", new { leavPId = "#=LeavePayableId#" }))
                                              .Create(create => create.Action("LeavePayableDetails_Create", "LeavePayableDetails", new { lPId = "#=LeavePayableId#" }))
                                              .Update(update => update.Action("LeavePayableDetails_Update", "LeavePayableDetails"))
                                              .Destroy(destroy => destroy.Action("LeavePayableDetails_Destroy", "LeavePayableDetails"))

                                              ).ToClientTemplate()

        )

        </text>);




                     }).ToClientTemplate())
</script>

<script>
    function generateLeavePayable(id) {
        $('#loading-image').show();
        $.ajax({
            type: "POST",
            url: '@Url.Action("GenerateLeavePayable", "LeavePayables", new { area = "HRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                $('#loading-image').hide();
                location.reload(true);
               

            }, 
            error: function (result) {
                alert(result.Message);
                $('#loading-image').hide();

            }
        });
    }

    function sync_handler(e) {
        this.read();

    }
</script>