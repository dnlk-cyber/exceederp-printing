@using System.Collections
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>@Resources.Navigator_Employee_ExperienceRequest</Legend>
@(Html.Kendo().Grid<ExperienceRequest>()
      .Name("ExperienceRequestGrid")
      .Columns(columns =>
      {

          columns.Bound(c => c.EmployeeCode).Width(150);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(200);
          columns.Bound(c => c.ApplicationDateAm).EditorTemplateName("Calander").Width(200);
          columns.Bound(c => c.RequestType).Width(200);
          columns.Bound(c => c.Remark).Width(200);
          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
          .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ExpirianceRequest").Window(window => { window.Title(Resources.Navigator_Employee_ExperienceRequest); window.Scrollable(false); }))
          .Events(e => {
              e.Edit("GetDate");
              e.Save("GetDate");
              e.DataBound("onDataBound");
              e.DetailExpand("onDetailExpandUser");
          })

         .Scrollable(h => h.Height(500))
         .Sortable(sortable =>
         {
             sortable.SortMode(GridSortMode.SingleColumn);


         })
         .Filterable()
         .Pageable(pageable => pageable
                               .Input(true)
                               .Numeric(false)
                               .Refresh(true)
                               .PageSizes(true)
                               .ButtonCount(5))
          .DataSource(dataSource => dataSource
               .Ajax()
               .Events(events =>
               {

                   events.Error("error_handler(\"ExperienceRequestGrid\")");
                   events.RequestStart("onRequestStart(\"ExperienceRequestGrid\")");
                   events.RequestEnd("onRequestEnd(\"ExperienceRequestGrid\")");
               })

              .Model(model =>
              {
                  model.Id(p => p.ExperienceRequestId);
                  model.Field (p => p.EmployeeCode).Editable(false) ;
                  //model.Field (p => p.EmployeeId).Editable(false) ;
              })
              .Read(read => read.Action("ExprianceRequests_Read", "ExpirianceRequest"))
              .Create(create => create.Action("ExprianceRequests_Create", "ExpirianceRequest"))
              .Update(update => update.Action("ExprianceRequests_Update", "ExpirianceRequest"))
              .Destroy(destroy => destroy.Action("ExprianceRequests_Destroy", "ExpirianceRequest"))
              ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_#=ExperienceRequestId#")
        .SelectedIndex(0)
        .Items(items =>
        {

            items.Add().Text(Resources.HR_RequestStatus).Content(
            @<text>
            @(Html.Kendo().Grid<RequestesStatus>()
                        .Name("RequestesStatusesgrid_#=ExperienceRequestId#")
                        .Columns(columns =>
                        {
                            //columns.Bound(c => c.RequestId);
                            columns.Bound(c => c.DateReqStatAm).Width(120);
                            columns.Bound(c => c.Status).EditorTemplateName("EnumWithoutApprove").Width(200);
                            columns.ForeignKey(c => c.ApproverId, (IEnumerable)ViewData["EmployeeName"], "EmployeeId", "FullNameAmharic").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                            columns.ForeignKey(c => c.ApproverDepartment, (IEnumerable)ViewData["Department"], "OrgStructureId", "Name").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
                            columns.Bound(c => c.Remark).Width(100);
                            columns.Command(command =>
                            {
                                //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                //command.Destroy().Text(Resources.ActionButton_Cancel);
                            }).Width(300);
                        })
                        .ToolBar(toolbar =>
                        {
                            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                            // toolbar.Custom().Action("SendForApproval", "ExpirianceRequest").Text(Resources.HR_Send_For_Approval);
                        })
                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .Scrollable(h => h.Height(500))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Events(events =>
                            {

                                events.Error("error_handler(\"RequestesStatusesgrid_#=ExperienceRequestId#\")");
                                events.RequestStart("onRequestStart(\"RequestesStatusesgrid_#=ExperienceRequestId#\")");
                                events.RequestEnd("onRequestEnd(\"RequestesStatusesgrid_#=ExperienceRequestId#\")");

                            })
                            .Model(model =>
                            {
                                model.Id(p => p.RequestStatusId);
                                model.Field(p => p.Date).Editable(false).DefaultValue(DateTime.Today);
                                model.Field(p => p.DateReqStatAm).Editable(false);
                                model.Field(p => p.ApproverId).Editable(false);
                                model.Field(p => p.ApproverDepartment).Editable(false);
                            })
                            .Read(read => read.Action("RequestesStatus_Read", "RequestesStatus", new { id = "#=ExperienceRequestId#", referenceType = "Experience" }))
                            .Create(create => create.Action("RequestesStatus_Create", "RequestesStatus", new { id = "#=ExperienceRequestId   #", referenceType2 = "Experience" }))
                            .Update(update => update.Action("RequestesStatus_Update", "RequestesStatus"))
                            .Destroy(destroy => destroy.Action("RequestesStatus_Destroy", "RequestesStatus"))
                        ).ToClientTemplate()
                )
                <a onclick='return sendForApproval("#=ExperienceRequestId#")' href=' \#' title="@Resources.HR_Send_For_Approval"><i class="fa fa-share-square fa-2x"></i></a>

            </text>);
        }).ToClientTemplate())
</script>


    
<script>
