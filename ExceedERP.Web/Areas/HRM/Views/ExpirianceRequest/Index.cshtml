    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApprovalExperienceRequest", "ExpirianceRequest", new { area = "HRM" })',
            data: { id: id },
            success: function(result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function(result) {
                alert(result);
            }
        });
    }
    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsApproved === true || dataItem.IsDepartmentSendForApproval) {

                row.css("background-color", "darkgrey");
                row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();
            }
            else {

                row.css("background-color", "lightgreen");
                row.find(".k-grid-delete").remove();

            }


        }
    }

    function sync_handler(e) {
        this.read();

    }
    function AssignDate() {
        var list = AssignDates();
        return list;
    }
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#ApplicationDateAm").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "ExpirianceRequest")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#ExperienceRequestGrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.ExperienceRequestId;
        var gridName = "#RequestesStatusesgrid_" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatuses", "ExpirianceRequest")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).remove();
                }
                else if (r == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else if (r == "Dapproved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                }

            }

        });

    }
    function SetEmployee(e) {
        var x = e.checked;
        var dropDown = $("#EmployeeId").data("kendoDropDownList");
        if (x == true) {
          
            dropDown.enable(true);


        }
        else {
            dropDown.value(0);
            dropDown.enable(false);
        }
        $.ajax({
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("SetEmployee", "ExpirianceRequest")',
            data: { x: x },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
                if (x == true && r == "0") {
                    e.checked = false;
                    dropDown.value(0);
                    dropDown.enable(false);
                    alert("You can not request for other employee!!.\nThere is no employee under your postion.");
                }
               
            }

        });


    }
</script>
