@using System.Collections
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.HealthAndInsurance.ReferralForm  


<form>

<div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.EmployeeId, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>

                @(Html.Kendo().ComboBoxFor(model => model)
                     .Name("EmployeeId")
                                              .DataValueField("PersonId")
                        .DataTextField("FullName")
                           .Placeholder("Select Employee..")
                            .Filter("contains")
                            .MinLength(2)
                            .HtmlAttributes(new { style = "width:100%" })
                                   
                           .DataSource(source =>
                           {
                               source.Read(read =>
                               {
                                   read.Action("GetEmployees", "ReferralForm");

                               })
                               .ServerFiltering(false);
                           })
                           .ValuePrimitive(true)


                                                  .Height(400)
                                                          .HeaderTemplate("<div class=\"dropdown-header k-widget k-header\">" +
                                        "<span>Photo</span>" +
                                        "<span>Full Name</span>" +
                                    "</div>")
                                       .Template(@"<div class='Employee-photo' style='background-image: url(" + Url.Content("~/Content/Images/") + "#:data.PersonId#-Photo/" + "#:data.PersonId#.jpg" + ");'></div>" +
                                            "<div class='Employee-name'>#:FullName#</div>")



                )



            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.ReferredDate, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">
        @Html.Kendo().DatePickerFor(model => model.ReferredDate)
        @Html.ValidationMessageFor(model => model.ReferredDate, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.ReferredTime , htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">
            @Html.Kendo().DatePickerFor(model => model.ReferredTime)
            @Html.ValidationMessageFor(model => model.ReferredTime, "", new { @class = "text-danger" })
        </div>
    </div>
  
</div>

<br/>
    
<div class="row">
    <div class="col-md-1">

    </div>

    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.ImmediateBoss , htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>
              @Html.Kendo().TextBoxFor(model => model.ImmediateBoss)
                @Html.ValidationMessageFor(model => model.ImmediateBoss, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.Time, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">

            @Html.Kendo().DatePickerFor(model => model.Time)
            @Html.ValidationMessageFor(model => model.Time, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">

           @Html.TextAreaFor(model => model.Remark)
            @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
        </div>
    </div>
  


</div>
<br/>



</form>
<style >
    .Employee-photo {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-size: 32px 35px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .Employee-name {
        display: inline-block;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>