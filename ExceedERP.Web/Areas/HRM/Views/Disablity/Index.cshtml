@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<Legend>Disablity</Legend>
@(Html.Kendo().Grid<Disability>()
          .Name("DisabilityGrid")
      .Columns(columns =>
      {
       // columns.Bound(c => c.EmployeeId);
        columns.Bound(c => c.Type);
        columns.Bound(c => c.Remark);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Selectable(selectable => {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
      })
        .Scrollable(h => h.Height(500))
             .Groupable()
                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                     .Events(events =>
                                    {
                                        events.Error("error_handler(\"DisabilityGrid\")");
                                        events.RequestStart("onRequestStart(\"DisabilityGrid\")");
                                        events.RequestEnd("onRequestEnd(\"DisabilityGrid\")");
                                    })
          .Model(model => model.Id(p => p.DisabilityId))
          .Read(read => read.Action("Disabilities_Read", "Disablity"))
          .Create(create => create.Action("Disabilities_Create", "Disablity"))
          .Update(update => update.Action("Disabilities_Update", "Disablity"))
          .Destroy(destroy => destroy.Action("Disabilities_Destroy", "Disablity"))
      )
)
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
</script>