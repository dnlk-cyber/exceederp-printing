    }
</script>


<script>

    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#InternalApplicantScreeningResult").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        screeningId = masterDataItem.InternalApplicantScreeningResultId;
        $.ajax({
            url: '@Url.Action("GenerateScreeningValues", "InternalApplicantScreeningResult")',

            data: { screeningId: screeningId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r.toLowerCase() == "True".toLowerCase()) {

                    var grid = $("#InternalApplicantScreeningResult").data("kendoGrid");

                    grid.dataSource.read();

                }
            }

        });

    }
</script>


<script>
    function Screen() {

        var vacancyIds = $("#VacancyId").data("kendoDropDownList");
        var vacancyId = vacancyIds.value();
        // $("#EvaluationType").val(0);
        $.ajax({
            url: '@Url.Action("ScreenAndGenerateApplicants", "InternalApplicantScreeningResult")',
            //contentType: "application/json; charset=utf-8",
            data: { vacancyId: vacancyId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                alert(r.message);
                var grid = $("#InternalApplicantScreeningResultGrid").data("kendoGrid");

                //grid.dataSource.transport.read();
                grid.dataSource.read();
            }

        });

    }
</script>