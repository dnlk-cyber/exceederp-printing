@using System.Collections
@using ExceedERP.Core.Domain.HRM.RecruitmentManagment
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.Navigator_Recruitment_InternalApplicantScreeningResult</legend>
@(Html.Kendo().Grid<InternalApplicantScreeningResult>()
                              .Name("InternalApplicantScreeningResultGrid")
              .Columns(columns =>
              {
                //columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("ListOfEmployee").Width(175);

                columns.ForeignKey(c => c.VacancyId, (IEnumerable)ViewData["Vacancy"], "VacancyId", "VaccancyCode");


              })
             .ToolBar(toolbar =>
             {

                 toolbar.Template(@<text>
                    <div class="toolbar">

                        <label class="category-label" @*for="Period"*@>Vacancy Code</label>
                        @(Html.Kendo().DropDownListFor(m => m)
                                     .Name("VacancyId")
                              .OptionLabel(Resources.Select)
                              .Filter("contains")
                              .DataTextField("VaccancyCode")
                                  .DataValueField("VacancyId")
                                      .DataSource(dataSource =>
                                      {
                                     dataSource.Read(read => read.Action("GetVacancyInternal", "HRMDataProvider", new { area = "HRM" }))
                      .ServerFiltering(false);
                                 })


                        )

                        @(Html.Kendo().Button()
                                        .Name("btnScreen")
                                                    .HtmlAttributes(new { type = "button", @class = "k-primary" })
                                                       .Events(e => e.Click("Screen"))
                                                                        .Content("Screen and Genderate Applicants"))


                        @*@(Html.Kendo().Button()
                            .Name("btnRefresh")
                            .HtmlAttributes(new { type = "button", @class = "k-primary" })
                               .Events(e => e.Click("Generate"))
                               .Content("Generate Applicants"))*@

                        <br />
                        <br />
                    </div>

                </text>);
             })
                           .Editable(editable => editable.Mode(GridEditMode.InLine))
                               .Scrollable(h => h.Height(500))
                                      .Groupable()
                                               .Sortable(sortable =>
                                               {
                                                   sortable.SortMode(GridSortMode.SingleColumn);
                                               })
                                   .Filterable()
                                      .Pageable(pageable => pageable
                                                                 .Input(true)
                                                                 .Numeric(false)
                                                                 .Refresh(true)
                                                                 .PageSizes(true)
                                                                 .ButtonCount(5))

                                                               

                           // .Events(e=>e.DetailExpand("onDetailExpand"))

                           .DataSource(dataSource => dataSource
                               .Ajax()
                                                   //.Sort(sort => sort.Add("DateCreated").Descending())
                                                   .Events(events =>
                                                   {

                                                       events.Error("error_handler(\"InternalApplicantScreeningResultGrid\")");
                                                       events.RequestStart("onRequestStart(\"InternalApplicantScreeningResultGrid\")");
                                                       events.RequestEnd("onRequestEnd(\"InternalApplicantScreeningResultGrid\")");
                                                   })

                               .Model(model =>
                               {
                                   model.Id(p => p.InternalApplicantScreeningResultId);
                                   //   model.Field(p => p.TotalResult).Editable();
                               })
                                                   .Read(read => read.Action("InternalApplicantScreeningResult_Read", "InternalApplicantScreeningResult"))
                                                   .Create(create => create.Action("InternalApplicantScreeningResult_Create", "InternalApplicantScreeningResult"))
                                       .Update(update => update.Action("InternalApplicantScreeningResult_Update", "InternalApplicantScreeningResult"))
                                       .Destroy(destroy => destroy.Action("InternalApplicantScreeningResult_Destroy", "InternalApplicantScreeningResult"))
                               ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                    .Name("tabstrip_#=InternalApplicantScreeningResultId#")
                    .SelectedIndex(0)
                    .Items(items =>
                     {
                         items.Add().Text(Resources.HR_Recruitment_ApplicantScreeningResult).Content(
                            @<text>
                                @* <legend>Screening Result</legend>*@
                                @(Html.Kendo().Grid<InternalApplicantScreening>()
                                                      .Name("ApplicantScreeningResultgrid_#=InternalApplicantScreeningResultId#")
                                      .Columns(columns =>
                                      {
                                          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("EmployeeList");
                                          columns.Bound(c => c.Department);
                                          columns.Bound(c => c.TotalResult);
                                          columns.Bound(c => c.PassOrFail);

                                          columns.Command(command =>
                                          {
                                              //if (HttpContext.Current.User.IsInRole("HR_Recruitment_User"))
                                              //{
                                              //    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                              //}
                                              //command.Destroy().Text(Resources.ActionButton_Cancel);
                                          }).Width(200);
                                      })
                                      .ToolBar(toolbar =>
                                      {
                                          //toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                      })

                                     .ClientDetailTemplateId("ApplicantScreening")

                                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                                      .Scrollable(h => h.Height(400))
                                      .DataSource(dataSource => dataSource
                                          .Ajax()
                                                  .Events(events =>
                                                  {

                                                      events.Error("error_handler(\"ApplicantScreeningResultgrid_#=InternalApplicantScreeningResultId#\")");
                                                      events.RequestStart("onRequestStart(\"ApplicantScreeningResultgrid_#=InternalApplicantScreeningResultId#\")");
                                                      events.RequestEnd("onRequestEnd(\"ApplicantScreeningResultgrid_#=InternalApplicantScreeningResultId#\")");
                                                  })

                                          .Model(model =>
                                          {
                                              model.Id(p => p.InternalApplicantScreeningId);
                                          })
                                                                  .Read(read => read.Action("InternalApplicantScreening_Read", "InternalApplicantScreeningResult", new { id = "#=InternalApplicantScreeningResultId#" }))
                                                                  .Create(create => create.Action("ApplicantScreeningResult_Create", "InternalApplicantScreeningResult", new { id = "#=InternalApplicantScreeningResultId#" }))
                                                  .Update(update => update.Action("ApplicantScreeningResult_Update", "InternalApplicantScreeningResult"))
                                                  .Destroy(destroy => destroy.Action("ApplicantScreeningResult_Destroy", "InternalApplicantScreeningResult"))
                                      ).ToClientTemplate()
