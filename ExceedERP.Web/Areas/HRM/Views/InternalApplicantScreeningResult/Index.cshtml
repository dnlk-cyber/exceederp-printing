<script>
    function JobTitle() {


        var value = this.value(),
            grid = $("#ApplicantionForm").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "LookupId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>
<script>
    function Vacancy() {

        var value = this.value(),
           grid = $("#ApplicantionForm").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "VaccancyCode", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }

    }
</script>
<script>
    function RecruitmentType() {


        var value = this.value(),
            grid = $("#ApplicantionForm").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "VacancyType", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>