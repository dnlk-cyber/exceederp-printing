<script>
    function Generate() {

        var vacancyIds = $("#VacancyId").data("kendoDropDownList");
        var vacancyId = vacancyIds.value();

        $.ajax({
            url: '@Url.Action("GenerateApplicants", "InternalApplicantScreeningResult")',
            //contentType: "application/json; charset=utf-8",
            data: { vacancyId: vacancyId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                alert(r);
                var grid = $("#InternalApplicantScreeningResult").data("kendoGrid");

                grid.dataSource.read();
            }

        });

    }
</script>


