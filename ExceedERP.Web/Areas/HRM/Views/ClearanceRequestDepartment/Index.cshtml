<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
<script>
    function departmentApproval(e) {

       var row = $(e.target).closest("tr");
        var grid = $("#grid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.ClearanceRequestId;

        if (id.length !== 0 )
        {
            $('#loading-image').show();
            $.ajax({
                url: '@Url.Action("DepartmentApproval", "ClearanceRequestDepartment")',
                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);
                    $('#loading-image').hide();
                    grid.dataSource.read();
                }
            });

        }

    }
    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsDepartmentOnlineApproved || dataItem.IsOnlineApproved) {

                row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();
                row.find(".k-grid-cmd-approve").remove();
                row.find("#approve").hide();
                $(".k-grid-top").show();

            }
            if (dataItem.IsSendForApproval && (!dataItem.IsDepartmentOnlineApproved || !dataItem.IsOnlineApproved)) {

                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").remove();
                row.find(".k-grid-cmd-approve").show();
                row.find("#approve").show();
                $(".k-grid-top").show();

            }
            else {

                row.find(".k-grid-delete").show();

            }


        }
    }
    function filterEmployee() {
        return {
            text: $("#EmployeeId").data("kendoDropDownList").filterInput.val(),


        };
    }

    function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApprovalRequest", "ClearanceRequestDepartment", new { area = "HRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            },
            error: function (result) {
                alert(result.Message);
            }
        });
    }
</script>
