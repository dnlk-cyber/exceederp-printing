<script>
    function Change(e) {

        // var amt = $("#AmtPercnet").data("kendoDropDownList");
        var x = e.value;
        if (x == "1") {
            $("#MonthlyAmount").prop("disabled", false).addClass("k-state-disabled");
            $("#AdditionalAmount").prop("disabled", false).addClass("k-state-disabled");
            $("#Amount").prop("disabled", true).addClass("k-state-disabled");
            $("#NetGross").prop("disabled", false).addClass("k-state-disabled");
        }
        else {
            $("#MonthlyAmount").prop("disabled", true).addClass("k-state-disabled");
            $("#AdditionalAmount").prop("disabled", true).addClass("k-state-disabled");
            $("#Amount").prop("disabled", false).addClass("k-state-disabled");
            $("#NetGross").prop("disabled", true).addClass("k-state-disabled");
        }
    }
    function valueMapper(options) {
        $.ajax({
            url: "/HRM/Loan/Employee_ValueMapper/",
            data: {
                value: options.value || 0,
                status: 1,
                excludeId: -1
            },
            success: function (data) {
                options.success(data);
            }
        });
    }

    function convertValues(value) {
        var data = {};

        value = $.isArray(value) ? value : [value];

        for (var idx = 0; idx < value.length; idx++) {
            data["values[" + idx + "]"] = value[idx];
        }

        return data;
    }
</script>