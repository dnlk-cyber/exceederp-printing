@using System.Collections
@using ExceedERP.Core.Domain.HRM.LeaveManagment
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@(Html.Kendo().TabStrip()
    .Name("tabstrip")
    .Animation(animation =>
        animation.Open(effect =>
            effect.Fade(FadeDirection.In)))
     .Items(tabstrip =>
     {
          tabstrip.Add().Text(Resources.NavigatorLeave_LeaveSetting)
         .Content(@<text>
              @leaveSetting()

            </text>);
         tabstrip.Add().Text(Resources.Rpt_LeaveType + " "+ Resources.Settings)
         .Content(@<text>
              @leaveTypeSetting()

            </text>);
        tabstrip.Add().Text(Resources.SickLeaveSetting)
        .Selected(true)
        .Content(@<text>
        <Legend>@Resources.SickLeaveSetting</Legend>
         @sickLeaveSetting()
        </text>);

        tabstrip.Add().Text(Resources.SickLeaveSetting+" "+Resources.Rpt_Salary)
         .Content(@<text>
              @sickLeaveWithSalary()

            </text>);
        
        
        tabstrip.Add().Text(Resources.NavigatorLeave_LeavePayable +" "+Resources.Settings+"|| No of working days")
         .Content(@<text>
              @leavePayableSetting()

            </text>);
        tabstrip.Add().Text(Resources.NavigatorLeave_LeaveEntitlement +" "+Resources.Settings)
         .Content(@<text>
              @leaveEntitlementSetting()

            </text>);
     @*tabstrip.Add().Text("Company Leave Work-flow Setting")
         .Content(@<text>
              @companyLeaveWorkflowSetting()

            </text>);*@
     })
)

@helper sickLeaveSetting()
{ 
    @(Html.Kendo().Grid<SickLeaveSetting>()
              .Name("SickLeaveSettinggrid")
              .Columns(columns =>
              {
                  columns.Bound(c => c.CurrentValue).Width(200);
                  columns.Command(command =>
                  {
                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                      command.Destroy().Text(Resources.ActionButton_Cancel);
                  }).Width(200);
              })
              .ToolBar(toolbar =>
              {
                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
              })
              .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Scrollable(h => h.Height(500))
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                  .Filterable()
                     .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
              .DataSource(dataSource => dataSource
                  .Ajax()
                      .Events(events =>
                      {
                          events.Error("error_handler(\"SickLeaveSettinggrid\")");
                          events.RequestStart("onRequestStart(\"SickLeaveSettinggrid\")");
                          events.RequestEnd("onRequestEnd(\"SickLeaveSettinggrid\")");
                      })

                  .Model(model => model.Id(p => p.SickLeaveSettingId))
                  .Read(read => read.Action("SickLeaveSetting_Read", "SickLeaveSetting").Data("sendForgery"))
                  .Create(create => create.Action("SickLeaveSetting_Create", "SickLeaveSetting").Data("sendForgery"))
                  .Update(update => update.Action("SickLeaveSetting_Update", "SickLeaveSetting").Data("sendForgery"))
                  .Destroy(destroy => destroy.Action("SickLeaveSetting_Destroy", "SickLeaveSetting").Data("sendForgery"))
              )
        )
}
 
@helper sickLeaveWithSalary()
{ 
    
        <legend>@Resources.SickLeaveSetting @Resources.Rpt_Salary </legend>
        @(Html.Kendo().Grid<SickLeaveSalarySetting>()
            .Name("SickLeaveSalarySettinggrid")
            .Columns(columns =>
            {
                columns.Bound(c => c.SickLeaveSalarySettingId).Title("#").Width(80);
                columns.Bound(c => c.FromDays).Width(120);
                columns.Bound(c => c.ToDays).Width(120);
                columns.Bound(c => c.PayableSalaryInPercent).Width(150);
                columns.Bound(c => c.IsTerminated).Width(120).ClientTemplate(
                    "<input type='checkbox' disabled = 'true' value='#=IsTerminated#' " +
                    "# if (IsTerminated) { #" +
                    "checked='checked'" +
                    "# } #" +
                    "/>");
                columns.Command(command =>
                {
                    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                    command.Destroy().Text(Resources.ActionButton_Cancel);
                }).Width(200);
            })
            .ToolBar(toolbar =>
            {
                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

            })
            .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(500))
            .Sortable(sortable =>
            {
                sortable.SortMode(GridSortMode.SingleColumn);


            })
            .Filterable()
            .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
            .DataSource(dataSource => dataSource
                .Ajax()
                    .Events(events =>
                    {
                        events.Error("error_handler(\"SickLeaveSalarySettinggrid\")");
                        events.RequestStart("onRequestStart(\"SickLeaveSalarySettinggrid\")");
                        events.RequestEnd("onRequestEnd(\"SickLeaveSalarySettinggrid\")");
                    })

                .Model(model => { model.Id(p => p.SickLeaveSalarySettingId);
                    model.Field(p => p.SickLeaveSalarySettingId).Editable(false);
                })
                .Read(read => read.Action("SickLeaveSalarySetting_Read", "SickLeaveSalarySetting").Data("sendForgery"))
                .Create(create => create.Action("SickLeaveSalarySetting_Create", "SickLeaveSalarySetting").Data("sendForgery"))
                .Update(update => update.Action("SickLeaveSalarySetting_Update", "SickLeaveSalarySetting").Data("sendForgery"))
                .Destroy(destroy => destroy.Action("SickLeaveSalarySetting_Destroy", "SickLeaveSalarySetting").Data("sendForgery"))
            )
    )             
}
@helper leaveTypeSetting()
{ 
    
    <Legend>@Resources.Rpt_LeaveType @Resources.Settings</Legend>
     @(Html.Kendo().Grid<LeaveTypeSetting>()
          .Name("LeaveTypeSettinggrid")
          .Columns(columns =>
          {

              columns.Bound(c => c.LeaveTypeSettingId).Title("#").Width(100);
              columns.Bound(c => c.LeaveType).Width(150);
              columns.Bound(c => c.IsConsecutiveDays).ClientTemplate(
                     "<input type='checkbox' disabled = 'true' value='#=IsConsecutiveDays#' " +
                     "# if (IsConsecutiveDays) { #" +
                     "checked='checked'" +
                     "# } #" +
                     "/>").Width(140);
              columns.Bound(c => c.IsWorkingDays).ClientTemplate(
                     "<input type='checkbox' disabled = 'true' value='#=IsWorkingDays#' " +
                     "# if (IsWorkingDays) { #" +
                     "checked='checked'" +
                     "# } #" +
                     "/>").Width(140);
              columns.Bound(c => c.MaximumAmount).Width(150);
              columns.Bound(c => c.MaxDaysBack).Width(150);
              columns.Bound(c => c.AllowFullAnnualLeave).ClientTemplate(
                     "<input type='checkbox' disabled = 'true' value='#=AllowFullAnnualLeave#' " +
                     "# if (AllowFullAnnualLeave) { #" +
                     "checked='checked'" +
                     "# } #" +
                     "/>").Width(140);
              columns.Bound(c => c.Remark).Width(150);
              columns.Command(command =>
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);

                  command.Destroy().Text(Resources.ActionButton_Cancel);

              }).Width(200);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(550))
            .Sortable(sortable =>
            {
                sortable.SortMode(GridSortMode.SingleColumn);

            })
            .Filterable()
            .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Sort(sort=>sort.Add(x=>x.LeaveTypeSettingId).Descending())
              .Events(events =>
              {
                  events.Error("error_handler(\"LeaveTypeSettinggrid\")");
                  events.RequestStart("onRequestStart(\"LeaveTypeSettinggrid\")");
                  events.RequestEnd("onRequestEnd(\"LeaveTypeSettinggrid\")");

              })
              .Model(model => {
                  model.Id(p => p.LeaveTypeSettingId);
                  model.Field(p => p.LeaveTypeSettingId).Editable(false);
              })
              .Read(read => read.Action("LeaveTypeSettings_Read", "LeaveTypeSettings").Data("sendForgery"))
              .Create(create => create.Action("LeaveTypeSettings_Create", "LeaveTypeSettings").Data("sendForgery"))
              .Update(update => update.Action("LeaveTypeSettings_Update", "LeaveTypeSettings").Data("sendForgery"))
              .Destroy(destroy => destroy.Action("LeaveTypeSettings_Destroy", "LeaveTypeSettings").Data("sendForgery"))
          )
)

    
 }

