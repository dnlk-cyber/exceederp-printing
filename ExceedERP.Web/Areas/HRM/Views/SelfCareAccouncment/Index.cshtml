                              .Name("AnnouncmentDetail_#=AnnouncmentId#")
      .Columns(columns =>
      {
          columns.Bound(c => c.Detail).EditorTemplateName("Editor").Encoded(false);
              //.ClientTemplate(" <textarea id='editor' rows='10' cols='30' style='height:440px' aria-label='editor'>Detail</textarea>");
        
          //columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      //.ToolBar(toolbar =>
