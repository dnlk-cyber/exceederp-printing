                                                                                              events.RequestStart("onRequestStart(\"AnnouncmentDetail_#=AnnouncmentId#\")");
                                                                                              events.RequestEnd("onRequestEnd(\"AnnouncmentDetail_#=AnnouncmentId#\")");
                                                                                          }
                                                                                          )


          .Model(model => model.Id(p => p.AnnouncDetailId))
