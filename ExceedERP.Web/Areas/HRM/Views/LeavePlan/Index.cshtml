@using System.Collections
@using ExceedERP.Core.Domain.HRM.HRMPlan
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorLeave_LeavePlan </legend>
@(Html.Kendo().Grid<LeavePlan>()
      .Name("LeavePlangrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EmployeeCode).Width(120);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("EmployeeEditor").Width(210);
          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["PeriodList"], "GlFiscalYearId", "Name").EditorTemplateName("GLFPeriod").Width(120);
          columns.Bound(c => c.FromAmharic).EditorTemplateName ("Calander").Width(150);
          columns.Bound(c => c.ToAmharic).EditorTemplateName ("Calander").Width(150);
          columns.Bound(c => c.LeaveAmount).Width (120);
          columns.Bound(c => c.Remark).Width (100);
          columns.Command(command =>
          {
              if (HttpContext.Current.User.IsInRole("HR_Leave_User")
              || HttpContext.Current.User.IsInRole("HR_Department_Head"))
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              }
              if (HttpContext.Current.User.IsInRole("HR_Admin")
                            || HttpContext.Current.User.IsInRole("HR_Leave_Admin")
                            || HttpContext.Current.User.IsInRole("HR_Department_Head"))
              {
                  command.Destroy().Text(Resources.ActionButton_Cancel);
              }

          }).Width(200);
      })
      .ToolBar(toolbar => {
          if (HttpContext.Current.User.IsInRole("HR_Leave_User")
          || HttpContext.Current.User.IsInRole("HR_Department_Head"))
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          }
          if (HttpContext.Current.User.IsInRole("HR_Admin")
              || HttpContext.Current.User.IsInRole("HR_Leave_Admin")
              || HttpContext.Current.User.IsInRole("HR_Department_Head"))
          {
              toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
              toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
          }
      })
      .Excel(excel => excel
      .FileName(Resources.NavigatorLeave_LeavePlan + ".xlsx")
      .Filterable(true)
      .AllPages(true)
      .ProxyURL(Url.Action("Excel_Export_Save", "LeavePlan")))
      .Pdf(pdf => pdf
      .AllPages()
      .FileName(Resources.NavigatorLeave_LeavePlan + ".pdf")
      .ProxyURL(Url.Action("Pdf_Export_Save", "LeavePlan")))
      .Events(ev =>
       {
           ev.DetailExpand("onDetailExpandUser");
           ev.DataBound("onDataBound");

       })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Scrollable(h => h.Height(500))
             .Events(x =>
             {
                 x.Edit("GetDate");
                 x.Save("GetDate");
             })
             .Groupable()
             .Sortable(sortable =>
             {
                 sortable.SortMode(GridSortMode.SingleColumn);

             })
             .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
          .DataSource(dataSource => dataSource
          .Ajax()
                .Events(events =>
                {
                    events.Error("error_handler(\"LeavePlangrid\")");
                    events.RequestStart("onRequestStart(\"LeavePlangrid\")");
                    events.RequestEnd("onRequestEnd(\"LeavePlangrid\")");
                })
               .Model(model => { model.Id(p => p.LeavePlanId);
                   model.Field(p => p.EmployeeCode).Editable (false);
               })
          .Read(read => read.Action("LeavePlans_Read", "LeavePlan"))
          .Create(create => create.Action("LeavePlans_Create", "LeavePlan"))
          .Update(update => update.Action("LeavePlans_Update", "LeavePlan"))
          .Destroy(destroy => destroy.Action("LeavePlans_Destroy", "LeavePlan"))
      ).ClientDetailTemplateId("leave_plan_template")
)

<script id="leave_plan_template" type="text/kendo-tmpl">
   
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_#=LeavePlanId#")
        .SelectedIndex(0)
        .Items(items =>
        {
           
                     
            items.Add().Text("Departmental Validation").Content(
            @<text>
            @(Html.Kendo().Grid<LeavePlanValidation>()
                .Name("LeavePlanValidationgrid_#=LeavePlanId#")
                .Columns(columns =>
                {
                    columns.Bound(c => c.Status).Width(170);
                    columns.Bound(c => c.Remark).Width(200);
                    columns.Command(command =>
                    {

                        command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                        command.Destroy().Text(Resources.ActionButton_Cancel);



                    });



                })
                .ToolBar(toolbar =>
                {
                     toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

                })
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Events(ev => ev.DataBound("onDataBoundDetail"))
                .Scrollable(h => h.Height(500))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Events(events =>
                    {


                        events.Error("error_handler(\"LeavePlanValidationgrid_#=LeavePlanId#\")");
                        events.RequestStart("onRequestStart(\"LeavePlanValidationgrid_#=LeavePlanId#\")");
                        events.RequestEnd("onRequestEnd(\"LeavePlanValidationgrid_#=LeavePlanId#\")");




                    })


                    .Model(model =>
                    {
                        model.Id(p => p.LeavePlanValidationId);
                        //model.Field(p => p.ApproverDepartment).Editable(false);



                    })
                    .Read(read => read.Action("LeavePlanDeparmentalValidation_Read", "LeavePlanDeparmentalValidation", new { gId = "#=LeavePlanId#" }))
                    .Create(create => create.Action("LeavePlanDeparmentalValidation_Create", "LeavePlanDeparmentalValidation", new { gId = "#=LeavePlanId#" }))
                    .Update(update => update.Action("LeavePlanDeparmentalValidation_Update", "LeavePlanDeparmentalValidation"))
                    .Destroy(destroy => destroy.Action("LeavePlanDeparmentalValidation_Destroy", "LeavePlanDeparmentalValidation"))
                ).ToClientTemplate()
                )
                    
            </text>);
            
        }).ToClientTemplate())
       
</script>
