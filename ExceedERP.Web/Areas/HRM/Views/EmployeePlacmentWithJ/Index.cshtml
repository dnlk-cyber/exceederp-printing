                  e.Save("GetDate");
                  e.Edit("GetDate");
                  e.DataBound("onDataBound");
                  //e.Edit("onEdit");

              })
              .Pageable(pageable => pageable
                  .Input(true)
                  .Numeric(false)
                  .Refresh(true)
                  .PageSizes(true)
                  .ButtonCount(5))

              .DataSource(dataSource => dataSource
                  .Ajax()
                      .Sort(sort => sort.Add("EmployeeCode"))
                  .Events(events =>
                  {
                      events.Error("error_handler(\"PlacementGrid\")");
                      events.RequestStart("onRequestStart(\"PlacementGrid\")");
                      events.RequestEnd("onRequestEnd(\"PlacementGrid\")");
                  }
                  )
                  .Model(model => model.Id(p => p.PlacementId))
                                      .Read(read => read.Action("Placements_Read", "EmployeePlacmentWithJ"))
                                                  .Create(create => create.Action("Placements_Create", "EmployeePlacmentWithJ"))
                                              .Update(update => update.Action("Placements_Update", "EmployeePlacmentWithJ"))
                                          .Destroy(destroy => destroy.Action("Placements_Destroy", "EmployeePlacmentWithJ"))

              ).ClientDetailTemplateId("template")
)
