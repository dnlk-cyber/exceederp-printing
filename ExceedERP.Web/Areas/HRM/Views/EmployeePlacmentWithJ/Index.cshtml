                    "# } #" +
                    "/>"
                    ).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(75);
                  ////columns.Bound(c => c.HaveFixedAsset).Width(90).ClientTemplate(
                  ////    "<input type='checkbox' disabled = 'true' value='#= HaveFixedAsset#' " +
                  ////    "# if (HaveFixedAsset) { #" +
                  ////    "checked='checked'"
                  ////    "# } #" +
                  ////    "/>"
                  ////    );
                  //columns.Bound(c => c.ImmediateSupervisor).Width(140);
                  columns.Bound(c => c.AssignmentDateAmharic).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(100); ;
                  columns.ForeignKey(c => c.RankId, (IEnumerable)ViewData["RankList"], "RankId", "RankName").EditorTemplateName("Rank").Width(70);
                  columns.ForeignKey(c => c.StepId, (IEnumerable)ViewData["StepList"], "StepId", "StepName").EditorTemplateName("Step").Width(65);
                  columns.Bound(c => c.Salary).Width(80);
                  columns.Bound(c => c.AssignmentType).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(120);
