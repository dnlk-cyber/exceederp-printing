<script>
    function GetSalary() {
        $("#Salary").val(0);
        var Ranks = $("#RankId").data("kendoDropDownList");
        var rank = Ranks.value();
        var Steps = $("#StepId").data("kendoDropDownList");
        var step = Steps.value();
        var Jobs = $("#LookupId").data("kendoDropDownList");
        var job = Jobs.value();
        if(rank.length!==0 && step.length!==0 && job.length!==0)
        {

            $.ajax({
                url: '@Url.Action("GetSalaryAmount", "EmployeePlacmentWithJ")',

                data: { rank: rank, step: step, job: job },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;

                    $("#Salary").val(r);
                }

            });
        }
    }

</script>


