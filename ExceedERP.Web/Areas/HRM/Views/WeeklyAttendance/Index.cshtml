<script>
    function onDataBound(e) {


        var gsDayNames = [
            "Sunday",
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday"
        ];


        //dayName will return the name of day
        var rows = e.sender.tbody.children();

        try {
            for (var j = 0; j < rows.length; j++) {
                var row = $(rows[j]);
                var dataItem = e.items[j]; //sender.dataItem(row);
                if (dataItem !== undefined) {


                    var dO = new Date(dataItem.DayOneDate);
                    var dayOneName = dO.toString().split(' ')[0];
                    
                    if (dataItem.DayOneDate !== null)
                        {
                        $("#WeeklyAttendance th[data-field=DayOne]").html("ጧት\n"+"እሁድ" + " (" + dataItem.DayOneAmharicDate + ")");
                        $("#WeeklyAttendance th[data-field=DayOneAN]").html("ከሰአት\n" +"እሁድ" + " (" + dataItem.DayOneAmharicDate + ")");
                    }
                    //////////////////////////////////////////////////////////////////////////////////
                    e.sender.columns[1].readonly = true;
                    var dT = new Date(dataItem.DayTwoDate);
                    var dayTwoName = dT.toString().split(' ')[0];
                   
