@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.TrainingEducation

@(Html.Kendo().Grid<Trainee>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.CourseTrackingId);
        columns.Bound(c => c.EmployeeId);
        columns.Bound(c => c.IsCompleteTraining);
        columns.Bound(c => c.Remark);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.TraineeId))
          .Read(read => read.Action("Trainee_Read", "Trainee"))
          .Create(create => create.Action("Trainee_Create", "Trainee"))
          .Update(update => update.Action("Trainee_Update", "Trainee"))
          .Destroy(destroy => destroy.Action("Trainee_Destroy", "Trainee"))
      )
)
