<script>


    var isNew_Global = "";
    function onDepartmentDataBound() {
        if (isNew_Global === "True") {

            $("#FullNameTextBox_Id").hide();
            $("#EmpIdDropdown_Id").show();
        }
        else if (isNew_Global === "False") {
            $("#FullNameTextBox_Id").show();
            $("#EmpIdDropdown_Id").hide();
        }
    }

    function GetEmployeeNameEmploye(e) {
        var autocomplete = $("#EmployeeId").data("kendoAutoComplete");
        var id = autocomplete.value();

        $.ajax({
            url: '@Url.Action("SetEmployeeId", "EmployeePlacmentWithOJ")',
            contentType: "application/json; charset=utf-8",
            data: { 'fullName': id },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
            }

        });
    }
</script>
<script>

    function GetAssignDate() {

        var x = AssignDate();
        var y = x;
        $("#FromAmharic").trigger("change");
        $("#ToAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "EmployeePlacmentHistory")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function(result) {
                    r = result;
                }
            });
        }
    }

</script>
