<script>
    function GetSalary() {
        //if (isNew_Global == "True") {
            var rank = $("#RankId").data("kendoDropDownList").value();
            var step = $("#StepId").data("kendoDropDownList").value();
            //var Jobs = $("#LookupId").data("kendoDropDownList");
            //var job = Jobs.value();

            if (rank != 0 && step != 0) {

                $("#Salary").val(0);

                $.ajax({
                    url: '@Url.Action("GetSalaryAmount", "EmployeePlacmentWithOJ")',
                    data: { rank: rank, step: step },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
