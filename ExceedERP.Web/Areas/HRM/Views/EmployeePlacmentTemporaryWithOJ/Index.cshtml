<script>
    function Pend(e) {

     var row = $(e.target).closest("tr");
        var grid = $("#PlacementGrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.PlacementId;

        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("Pend", "EmployeePlacmentWithJ")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);
                    $('#loading-image').hide();
                    grid.dataSource.read();
                }
            });

        }

    }

    ////////////////////////////////

    function UnPend(e) {

     var row = $(e.target).closest("tr");
        var grid = $("#PlacementGrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.PlacementId;

        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("UnPend", "EmployeePlacmentWithJ")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);
                    $('#loading-image').hide();
                    grid.dataSource.read();
                }
            });

        }

    }

</script>

<script>

    function onDataBound(e) {

        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check

            if (dataItem.isCurrent === true && dataItem.IsPend === false) {
                row.find("#pend").show();
                row.find("#unpend").hide();
            }
            else if (dataItem.isCurrent === true && dataItem.IsPend === true) {
                row.css("background-color", "gray");
                row.find("#pend").hide();
                row.find("#unpend").show();
            }
            else if (dataItem.isCurrent === false) {
                row.find("#pend").hide();
                row.find("#unpend").hide();
            }
            if (dataItem.IsApprove === true) {
                row.find("#approveplacement").hide();
            }
            if (dataItem.IsApprove === false) {
                row.css("background-color", "#FF842D");

            }
            if (dataItem.Age > 60) {

                row.css("background-color", "olive");

            }
        }
    }

    function ApprovePlacement(e) {

     var row = $(e.target).closest("tr");
        var grid = $("#PlacementGrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.PlacementId;

        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("ApprovePlacement", "EmployeePlacmentTemporaryWithOJ")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);
                    grid.dataSource.read();
                }
            });

        }

    }
    function OpenAttachementWindow() {

        $("#Attachement_InstitutionIncomingId").val(institutionIncomingLetterId);

        var wnd = $("#IncomingAttachementWindow").data("kendoWindow");
        wnd.center().open();
    }
    function UploadFile(id) {
        $("#employeeId").val(id);
        var wnd = $("#UploadDoc").data("kendoWindow");
        wnd.center().open();
    }

</script>
