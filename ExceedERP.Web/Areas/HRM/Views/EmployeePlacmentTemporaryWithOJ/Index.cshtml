    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPlacment_EmployeePlacment</legend>
<div class="row">
    <p>
        <span class="fa fa-circle" style="color:yellow;"></span>&nbsp;&nbsp;@Resources.Enum_RequestStatus_PEND,&nbsp;&nbsp;
        <span class="fa fa-circle" style="color:olive;"></span>&nbsp;&nbsp;@Resources.Rpt_RetirementNotification &nbsp;&nbsp;
        <span class="fa fa-circle" style="color:#FF842D;"></span>&nbsp;&nbsp;Employee Not Yet Approved &nbsp;&nbsp;

    </p>
</div>
@(Html.Kendo().Grid<Placement>()
        .Name("PlacementGrid")
        .Columns(columns =>
        {

            // columns.Bound(c => c.EmployeeCode).Width(150);
            //columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "EmployeeCode").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" }).Width(90);
            columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Width(180);
            //columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameAmharic").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
            columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Title(Resources.Placement_FullName).Width(150);
            // columns.Bound(c => c.FullName).Width(150);
            columns.ForeignKey(c => c.HeadId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameaEnglish").EditorTemplateName("ListOfEmployee").Filterable(ftb => ftb.Multi(true).Search(true)).Width(150);
            // columns.Bound(c => c.Boss).Width(150);
            // columns.ForeignKey(c => c.JobTitleCode, (IEnumerable)ViewData["jobTitle"], "OrgStructureId", "Name").EditorTemplateName("JobTitles").Width(130);
            columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branches"], "BranchId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
            columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessUnits"], "BusinessUnitId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
            columns.ForeignKey(c => c.ParentOrgStructureId, (System.Collections.IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").Width(170);
            columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["workunits"], "OrgStructureId", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
            columns.Bound(c => c.JobTitleName).Filterable(ftb => ftb.Multi(true).Search(true)).Width(140);
            columns.Bound(c => c.IsHead).Width(90).ClientTemplate(
             "<input type='checkbox' disabled = 'true' value='#= IsHead#' " +
             "# if (IsHead) { #" +
             "checked='checked'" +
             "# } #" +
             "/>"
             );
            columns.Bound(c => c.HireDate).Width(100);
            columns.Bound(c => c.AssignmentDateAmharic).Width(150);
            columns.ForeignKey(c => c.RankId, (IEnumerable)ViewData["RankList"], "RankId", "RankName").EditorTemplateName("Rank").Width(100);
            columns.ForeignKey(c => c.StepId, (IEnumerable)ViewData["StepList"], "StepId", "StepName").EditorTemplateName("Step").Width(100);
            columns.Bound(c => c.Salary).Width(80);
            columns.Bound(c => c.AssignmentType).Width(150);
            // columns.ForeignKey(c => c.ReportsTo, (IEnumerable)ViewData["jobTitle"], "OrgStructureId", "Name").EditorTemplateName("JobTitles").Width(200);
            columns.Bound(c => c.EmployementType).Width(150);
            columns.Bound(c => c.isCurrent).ClientTemplate("<input type='checkbox' disabled='true' value='#=isCurrent #' " + " # if (isCurrent) { #" + "checked='checked'" + "# } #" + " />").Width(100);
            columns.Bound(c => c.IsApprove).ClientTemplate(
                "<input type='checkbox' disabled = 'true' value='#= IsApprove#' " +
                "# if (IsApprove) { #" +
                "checked='checked'" +
                "# } #" +
                "/>"
                ).Width(100);
            columns.Bound(c => c.IsTemporary).ClientTemplate(
                "<input type='checkbox' disabled = 'true' value='#= IsTemporary#' " +
                "# if (IsTemporary) { #" +
                "checked='checked'" +
                "# } #" +
                "/>"
                ).Width(100);
            columns.Bound(c => c.IsPend).ClientTemplate(
                "<input type='checkbox' disabled = 'true' value='#= IsPend#' " +
                "# if (IsPend) { #" +
                "checked='checked'" +
                "# } #" +
                "/>"
                ).Width(100);
            columns.Bound(c => c.Remark).Width(100);
            columns.Command(command =>
            {
                if (HttpContext.Current.User.IsInRole("HR_Placement_User"))
                {
                    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                    command.Custom("").Click("Pend").Text("Pend ").IconClass("fa fa-remove fa4x").HtmlAttributes(new { @class = "btn btn-yellow", @title = "Pend the employee to stop payroll processing ", @id = "pend" });
                    command.Custom("").Click("UnPend").Text("UnPend").IconClass("fa fa-check fa4x").HtmlAttributes(new { @class = "btn btn-white", @title = "Remove the employee from pend lists to start payroll processing ", @id = "unpend" });
                }
                if (HttpContext.Current.User.IsInRole("PlacementApprover"))
                {
                    command.Custom("").Click("ApprovePlacement").Text("Approve").IconClass("fa fa-check fa4x").HtmlAttributes(new { @class = "btn btn-success", @title = "Approve Placement ", @id = "approveplacement" });
                }
                if (HttpContext.Current.User.IsInRole("HR_Placement_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
                {
                    command.Destroy().Text(Resources.ActionButton_Cancel);
                }

            }).Width(350);


        })
        .ToolBar(toolbar =>
        {
            if (HttpContext.Current.User.IsInRole("HR_Placement_User"))
            {
                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
            }

            if (HttpContext.Current.User.IsInRole("GenerateDayAbsent"))
            {
                //toolbar.Custom()
                //  .Text("Update Salary")
                //  .Text(Resources.ActionButton_Refersh)
                //  .HtmlAttributes(new { id = "btnRefresh", onclick = "Refresh()" });


            }
            if (HttpContext.Current.User.IsInRole("HR_Placement_Admin") || HttpContext.Current.User.IsInRole("HR_Admin"))
            {
                toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
                toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
            }



        })
        .Excel(excel => excel
        .FileName(Resources.NavigatorPlacment_EmployeePlacment + ".xlsx")
        .Filterable(true)
        .AllPages(true)
        .ProxyURL(Url.Action("Excel_Export_Save", "EmployeePlacmentTemporaryWithOJ")))
        .Pdf(pdf => pdf
        .AllPages()
        .FileName(Resources.NavigatorPlacment_EmployeePlacment + ".pdf")
        .ProxyURL(Url.Action("Pdf_Export_Save", "EmployeePlacmentTemporaryWithOJ")))
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Placement").Window(window => { window.Title(Resources.NavigatorPlacment_EmployeePlacment); window.Scrollable(false); }))
        .Scrollable(h => h.Height(500))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);

        })
        .Filterable()
        .Events(e =>
        {
            e.Save("GetDate");
            e.Edit("GetDate");
            e.DataBound("onDataBound");
            e.Cancel("onCancel");

        })
        .Pageable(pageable => pageable
        .Input(true)
        .Numeric(false)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5))
        .DataSource(dataSource => dataSource
                .Ajax()
                    .Sort(sort => sort.Add(s => s.PlacementId).Descending())
                    .Events(events =>
                    {
                        events.Error("error_handler(\"PlacementGrid\")");
                        events.RequestStart("onRequestStart(\"PlacementGrid\")");
                        events.RequestEnd("onRequestEnd(\"PlacementGrid\")");
                    })

            .Model(model =>
            {
                model.Id(p => p.PlacementId);
                model.Field(p => p.AssignmentType).DefaultValue(-1);
                model.Field(p => p.ResponsibilityLevel).DefaultValue(-1);
                model.Field(p => p.EmployementType).DefaultValue(-1);

            })
            .Read(read => read.Action("PlacmentTemporaries_Read", "EmployeePlacmentTemporaryWithOJ"))
            .Create(create => create.Action("PlacmentTemporaries_Create", "EmployeePlacmentTemporaryWithOJ"))
            .Update(update => update.Action("PlacmentTemporaries_Update", "EmployeePlacmentTemporaryWithOJ"))
            .Destroy(destroy => destroy.Action("PlacmentTemporaries_Destroy", "EmployeePlacmentTemporaryWithOJ"))

            ).ClientDetailTemplateId("template")
)

