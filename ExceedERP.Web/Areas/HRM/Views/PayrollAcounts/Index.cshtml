@using System.Collections
@using System.Security.AccessControl
@using ExceedERP.Core.Domain.HRM.Payroll.Setting
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPayrollSetup_PayrollAcounts</legend>
@(Html.Kendo().Grid<PayrollAccounts>()
          .Name("PayrollAccountsgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Description).Width( 200);
          columns.Bound(c => c.IsPerEmployee).Width(150).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsPerEmployee#' " + " # if (IsPerEmployee) { #" + "checked='checked'" + "# } #" + " />");
          columns.Bound(c => c.IsPerBranch).Width(150).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsPerBranch#' " + " # if (IsPerBranch) { #" + "checked='checked'" + "# } #" + " />");
          columns.Bound(c => c.IsPerCostCenter).Width(150).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsPerCostCenter#' " + " # if (IsPerCostCenter) { #" + "checked='checked'" + "# } #" + " />");
          columns.Bound(c => c.Account).EditorTemplateName("AccountCode").Width(200);
          //  columns.Bound(c => c.Remark).Width( 150);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);}).Width(200);
      })
      .ToolBar(toolbar => {

          toolbar.Excel().Text(Resources.ActionButton_ExportExcel).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
          toolbar.Pdf().Text(Resources.ActionButton_ExportPDF).HtmlAttributes(new { @class = "btn btn-primary btn-xs pull-right" });
          //   toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Excel(excel => excel
          .FileName(Resources.NavigatorPayrollSetup_PayrollAcounts + ".xlsx")
          .Filterable(true)
          .AllPages(true)
          .ProxyURL(Url.Action("Excel_Export_Save", "PayrollAcounts"))
      )
      .Pdf(pdf => pdf
          .AllPages()
          .FileName(Resources.NavigatorPayrollSetup_PayrollAcounts + ".pdf")
          .ProxyURL(Url.Action("Pdf_Export_Save", "PayrollAcounts"))
      )
         .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
          //    .Events(e =>
          //{
          //    e.Edit("onChange");

          //})
          .Selectable( )
      .DataSource(dataSource => dataSource
          .Ajax()
              .Events(events =>
              {
                  events.Error("error_handler(\"PayrollAccountsgrid\")");
                  events.RequestStart("onRequestStart(\"PayrollAccountsgrid\")");
                  events.RequestEnd("onRequestEnd(\"PayrollAccountsgrid\")");

              })

          .Model(model => model.Id(p => p.PayrollAccountsId))
          .Read(read => read.Action("PayrollAccounts_Read", "PayrollAcounts"))
          .Create(create => create.Action("PayrollAccounts_Create", "PayrollAcounts"))
          .Update(update => update.Action("PayrollAccounts_Update", "PayrollAcounts"))
          .Destroy(destroy => destroy.Action("PayrollAccounts_Destroy", "PayrollAcounts"))
      )
      )

