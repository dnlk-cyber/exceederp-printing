@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.PerformanceManagment
@using System.Collections
@using Kendo.Mvc
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend> Internal Customer Evaluators Request and Assign Evaluators   </legend>
@(Html.Kendo().Grid<PerformanceRequestPeriod>()
          .Name("PerformanceRequestPeriodgrid")
          .Columns(columns =>
          {
              columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["departmentLists"], "OrgStructureId", "Name").EditorTemplateName("workUnit").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
              columns.Bound(c => c.Head).Width(150);
              columns.ForeignKey(c => c.FiscalYearId, (IEnumerable)ViewData["Fiscalyears"], "FiscalYearId", "Name").EditorTemplateName("fiscalYear").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
              columns.ForeignKey(c => c.PeriodId, (IEnumerable)ViewData["Periods"], "PeriodId", "Name").EditorTemplateName("period").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200);
              columns.Command(command =>
              {
                  command.Edit();
                  command.Destroy();
              });
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create();
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Pageable()
          .Filterable()
          .Scrollable(h => h.Height(550))
          .Events(events =>
          {
              events.Cancel("onCancel");
              events.Edit("onEdit");
              events.DetailExpand("onDetailExpandUser");
          })
          .DataSource(dataSource => dataSource
              .Ajax()
              .Events(events =>
              {
                  events.Error("error_handler(\"PerformanceRequestPeriodgrid\")");
                  events.RequestStart("onRequestStart(\"PerformanceRequestPeriodgrid\")");
                  events.RequestEnd("onRequestEnd(\"PerformanceRequestPeriodgrid\")");
              })
              .Model(model => { model.Id(p => p.PerformanceRequestPeriodId);
                  model.Field(x => x.Head).Editable(false);
                  model.Field(x => x.OrgStructureId).Editable(false);
              })
              .Read(read => read.Action("EvaluatorsRequest_Read", "EvaluatorsRequest"))
              .Create(create => create.Action("EvaluatorsRequest_Create", "EvaluatorsRequest"))
              .Update(update => update.Action("EvaluatorsRequest_Update", "EvaluatorsRequest"))
              .Destroy(destroy => destroy.Action("EvaluatorsRequest_Destroy", "EvaluatorsRequest"))
          ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabstrip_#=PerformanceRequestPeriodId#")
            .SelectedIndex(0)
            .Items(items =>
            {


                items.Add().Text("Peer To Peer").Content(
                @<text>
                    @peerToPeerEvaluation()
                </text> );
                 //Internal Custemer
                items.Add().Text("Internal Customer Evaluators Request").Content(
                @<text>
                    @internalCustemerevaluation()
                </text>);

         }).ToClientTemplate()
    )
</script>

@helper peerToPeerEvaluation()
{
    @(Html.Kendo().Grid<PeerToPeerPerformanceEvaluation>()
              .Name("PeerToPeergrid_#=PerformanceRequestPeriodId#")
              .Columns(columns =>
              {
                  columns.ForeignKey(c => c.EvaluatorId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameEng").EditorTemplateName("EmployeeEvalutorsList").Filterable(ftb => ftb.Multi(true).Search(true)).Width(260);
                  columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameEng").EditorTemplateName("EmployeeSubList").Filterable(ftb => ftb.Multi(true).Search(true)).Width(260);

                  columns.Command(command => { command.Edit(); command.Destroy(); });
              })
              .ToolBar(toolbar =>
              {
                  toolbar.Create();
              })
              .Editable(editable => editable.Mode(GridEditMode.InLine))
              .Pageable()
              .Filterable()
              .Scrollable(h => h.Height(550))
              .Events(events =>
              {
                  events.Cancel("onCancel");
                  events.Edit("onEdit");
              })
              .DataSource(dataSource => dataSource
                  .Ajax()
                  .Events(events =>
                             {
                                 events.Error("error_handler(\"PeerToPeergrid_#=PerformanceRequestPeriodId#\")");
                                 events.RequestStart("onRequestStart(\"PeerToPeergrid_#=PerformanceRequestPeriodId#\")");
                                 events.RequestEnd("onRequestEnd(\"PeerToPeergrid_#=PerformanceRequestPeriodId#\")");
                             })
                  .Model(model => model.Id(p => p.PeerToPeerPerformanceEvaluationId))
                  .Read(read => read.Action("PeerToPeerPerformanceEvaluations_Read", "PeerToPeerPerformanceEvaluations", new { pPId = "#=PerformanceRequestPeriodId#" }))
                  .Create(create => create.Action("PeerToPeerPerformanceEvaluations_Create", "PeerToPeerPerformanceEvaluations", new { pPId = "#=PerformanceRequestPeriodId#" }))
                  .Update(update => update.Action("PeerToPeerPerformanceEvaluations_Update", "PeerToPeerPerformanceEvaluations"))
                  .Destroy(destroy => destroy.Action("PeerToPeerPerformanceEvaluations_Destroy", "PeerToPeerPerformanceEvaluations"))
              ).ToClientTemplate()
    )

}
