@using System.Collections
@using ExceedERP.Core.Domain.HRM.RecruitmentManagment
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>@Resources.Navigator_Recruitment_ApplicantScreeningResult</legend>
@(Html.Kendo().Grid<ApplicantRegistration>()
                          .Name("ApplicantRegistrationgrid")
                          .Columns(columns =>
                          {
                          columns.Bound(c => c.Check).Template(@<text></text>).ClientTemplate("<input type='checkbox' #= Check ? checked='checked':'' # class='chkbx' />")
                              .HeaderTemplate("<input type='checkbox' id='masterCheckBox' onclick='checkAll(this)'/>").Width(60);
                              columns.ForeignKey(c => c.VacancyId, (IEnumerable)ViewData["Vacancy"], "VacancyId", "VaccancyCode").EditorTemplateName("Vacancy").Width(150);
                              columns.Bound(c => c.ApplicantName).Width(200);
                              columns.Bound(c => c.Age).Width(150);
                              columns.Bound(c => c.Sex).Width(150);
                              columns.Bound(c => c.TotalResult).Width(150);
                              columns.Bound(c => c.Rank).Width(80);
                              columns.Command(command =>
                              {
                                  //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  //command.Destroy();
                              }).Width(180);
                          })
                           .ToolBar(toolbar =>
                           {

                           toolbar.Template(@<text>
        <div class="toolbar">

            <label class="category-label">@Resources.HR_HRMPlan_RecruitmentPlan_RecruitmentType</label>


            @(Html.Kendo().ComboBox()
                                             .Placeholder(Resources.HR_HRMPlan_RecruitmentPlan_RecruitmentType)
                                              .Name("VacancyType")
                     .BindTo(EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.Common.VacancyType)))
                                                     .DataTextField("Text")
                                                      .DataValueField("Value")
                                                       .Events(x => x.Change("RecruitmentType"))
                                                   .AutoBind(false)

                            .HtmlAttributes(new { style = "width:200px;" })

            )
            <label class="category-label">@Resources.HR_HRMPlan_RecruitmentPlan_LookupId</label>
            @(Html.Kendo().ComboBox()
                                                                             .Placeholder(Resources.HR_HRMPlan_RecruitmentPlan_LookupId)
                                                             .Name("LookupId")
                                                                     .BindTo((IEnumerable)ViewData["JobTitle"])
                                                             .DataTextField("Description")
                                                                     .DataValueField("LookupId")
                                                                     .Events(x => x.Change("JobTitle"))
                                                   .AutoBind(false)

                            .HtmlAttributes(new { style = "width: 200px;" })

            )

            <br />
            <br />
            @item.SaveButton()
        </div>
        @*@item.SaveButton()*@

        </text>);

                           })
        .Editable(editable => editable.Mode(GridEditMode.InCell))//TemplateName("ApplicantRegistration").Window(window =>
                                                                 //{
                                                                 //    window.Title("Applicant Registration Form");
                                                                 //    window.Scrollable(false);
                                                                 //}))

                          .Groupable()
                                .HtmlAttributes(new { style = "height: 550px;" })
                               .Groupable()
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                               .Filterable()
                              .Scrollable()
                          .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                            .ClientDetailTemplateId("AddressTemplate")
                          .DataSource(dataSource => dataSource
                              .Ajax()
                                    .Sort(sort => sort.Add("TotalResult").Descending())
                                                .Batch(true)
                                                  .Events(events =>
                                                  {
                                                      events.Error("error_handler(\"ApplicantRegistrationgrid\")");
                                                      events.RequestStart("onRequestStart(\"ApplicantRegistrationgrid\")");
                                                      events.RequestEnd("onRequestEnd(\"ApplicantRegistrationgrid\")");
                                                  })

                              .Model(model =>
                              {
                                  model.Id(p => p.ApplicantRegistrationId);
                                  model.Field(p => p.TotalResult).Editable(false);
                                  model.Field(p => p.ApplicantName).Editable(false);
                                  model.Field(p => p.VacancyCode).Editable(false);
                                  model.Field(p => p.Age).Editable(false);

                              })
                                  .Read(read => read.Action("ApplicantRegistration_Read", "ApplicantRegistration"))
                              .Create(create => create.Action("Editing_Create", "ApplicantRegistration"))
                              .Update(update => update.Action("Editing_Create", "ApplicantRegistration"))
                              .Destroy(destroy => destroy.Action("ApplicantRegistration_Destroy", "ApplicantRegistration"))
                              ).ClientDetailTemplateId("template")
)
