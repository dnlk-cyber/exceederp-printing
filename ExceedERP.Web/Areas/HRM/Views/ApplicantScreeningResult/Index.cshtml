<script>

      var ApplicantScreenResultId_Global = 0;

     function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

         var masterGrid = $("#ApplicantScreeninggrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

         ApplicantScreenResultId_Global = masterDataItem.ApplicantScreenResultId;

         masterId = masterDataItem.ApplicantScreenResultId;


     }


     function Pass(e) {

         var masterId = ApplicantScreenResultId_Global;

        var row = $(e.target).closest("tr");
         var grid = $("#ApplicantScreening" + masterId).data("kendoGrid");
        var dataItem = grid.dataItem(row);
       // var masterId = dataItem.CustomerTicket_HelpDeskId;
         var applicantScreeningId = dataItem.ApplicantScreeningId;

        if (confirm('Are you sure you want generate profile for this applicant')) {
            $.ajax({
                url: '@Url.Action("GenerateProfile", "ApplicantScreeningResult")',

                data: { applicantScreeningId: applicantScreeningId },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    if (r === "true") {
                        alert("Successfully Generated");
                    }
                    else if (r === "false") {
                        alert("Already Generated Before");
                    }
                    

                    //var grid = $("#EmployeePerformancegrid").data("kendoGrid");
                    var masterGrid = $("#ApplicantScreeninggrid").data("kendoGrid");
                    masterGrid.dataSource.read();
                }

            });
        }
    }

</script>

<script>


    function DetailDataBound(e) {
        var grid = this;

        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);

            var dataItem = grid.dataItem(row);


            if (dataItem.PassOrFail === "Pass" && !dataItem.IsProfileGenerated) {

               // row.find(".k-grid-edit").hide();
                row.find(".k-grid-pass").show();
                row.css("background-color", "lightGreen");

                //$(".k-grid-top", gridName).hide();

            }
            if (dataItem.PassOrFail === "Pass" && dataItem.IsProfileGenerated) {

                // row.find(".k-grid-edit").hide();
                row.find(".k-grid-pass").hide();
                row.css("background-color", "lightGreen");

                //$(".k-grid-top", gridName).hide();

            }
            else if (dataItem.PassOrFail === "Fail") {

              //  row.find(".k-grid-edit").hide();
                row.find(".k-grid-pass").hide();
                 row.css("background-color", "gray");

                //$(".k-grid-top", gridName).hide();

            }
          
            else {
                //  row.find(".k-grid-edit").show();
                // row.css("background-color", "red");
            }
        }
    }
</script>
