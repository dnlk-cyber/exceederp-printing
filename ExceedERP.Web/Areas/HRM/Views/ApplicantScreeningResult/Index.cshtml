</script>



<script>


    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#ApplicantScreeninggrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        screeningId = masterDataItem.ApplicantScreeningId;
       // var gridName = "#RequestesStatusgrid_" + masterId;
        $.ajax({
            url: '@Url.Action("GenerateScreeningValues", "ApplicantScreeningResult")',

            data: { screeningId: screeningId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

                if (r.toLowerCase() == "True".toLowerCase()) {

                var grid = $("#ApplicantScreeninggrid").data("kendoGrid");

                    grid.dataSource.read();

                }
                //var grid = $("#ApplicantScreeninggrid").data("kendoGrid");

               // grid.dataSource.read();

            }

        });

    }
</script>



<script>
    function VacancyFilter() {
        var vacancy = $("#VacancyId").data("kendoDropDownList");
        var vacancyId = vacancy.value();

        $.ajax({
            url: '@Url.Action("FilterApplicants", "ApplicantScreeningResult")',
            //contentType: "application/json; charset=utf-8",
            data: { vacancyId: vacancyId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
            }

        });
        var value = this.value(),
            grid = $("#ApplicantScreeninggrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "VacancyId", operator: "eq", value: value });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>

