<script type="text/javascript">
    $(function () {
        $('#ApplicantRegistrationgrid').on('click', '.chkbx', function () {
            var checked = $(this).is(':checked');
            var grid = $('#ApplicantRegistrationgrid').data().kendoGrid;
            var dataItem = grid.dataItem($(this).closest('tr'));
            dataItem.set('Check', checked);
        })
    })

    function checkAll(ele) {
        var state = $(ele).is(':checked');
        var grid = $('#ApplicantRegistrationgrid').data().kendoGrid;
        $.each(grid.dataSource.view(), function () {
            if (this['Check'] != state)
                this.dirty = true;
            this['Check'] = state;
        });
        grid.refresh();
    }

</script>

<script>
    function Screen() {

        var vacancyIds = $("#VacancyId").data("kendoDropDownList");
        var vacancyId = vacancyIds.value();
        // $("#EvaluationType").val(0);
        $.ajax({
            url: '@Url.Action("ScreenAndGenerateApplicants", "ApplicantScreeningResult")',
            //contentType: "application/json; charset=utf-8",
            data: { vacancyId: vacancyId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                alert(r.message);
                var grid = $("#ApplicantScreeninggrid").data("kendoGrid");

                //grid.dataSource.transport.read();
                grid.dataSource.read();
            }

        });

    }
</script>

