                  .Read(read => read.Action("ApplicantExamResult_Read", "ApplicantExamResult", new { id = "#=ApplicantRegistrationId#" }))
                  .Create(create => create.Action("ApplicantExamResult_Create", "ApplicantExamResult", new { id = "#=ApplicantRegistrationId#" }))
          .Update(update => update.Action("ApplicantExamResult_Update", "ApplicantExamResult"))
          .Destroy(destroy => destroy.Action("ApplicantExamResult_Destroy", "ApplicantExamResult"))
      ).ToClientTemplate()
                )
