@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.Payroll
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPayroll_OverTimeTransferMaintain </legend>
@(Html.Kendo().Grid<OverTimeTransfer>()
          
        .Name("OverTimeTransfergrid")
      .Columns(columns =>
      {
          //columns.Bound(c => c.Check).ClientTemplate("<input type='checkbox' #= Check ? checked='checked':'' # class='chkbx' />")
          //          .HeaderTemplate("<input type='checkbox' id='masterCheckBox' onclick='checkAll(this)'/>").Width(200);
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "EmployeeId", "FullNameEnglish").EditorTemplateName("EmployeeLists").Width(260);
          columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["PeriodList"], "GLPeriodId", "Name").EditorTemplateName("GLPeriod").Width(150);
          columns.Bound(c => c.NormalHours).Width(150);
          columns.Bound(c => c.NightHours).Width(150);
          columns.Bound(c => c.HolidayHours).Width(150);
          columns.Bound(c => c.RestdayHours).Width(150);
          // columns.Bound(c => c.IsSendForApproval).Width(150);
          columns.Command( command => 
          {
              command.Custom("cmd-request").Text("Send For Approval").Click("sendforapproval");
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);  command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(300);
      })
      .ToolBar(toolbar => {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          // toolbar.Save();
      })
         .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(500))
            //.Groupable()
            //.Sortable(sortable =>
            //{
            //    sortable.SortMode(GridSortMode.SingleColumn);
            //})
            // .Filterable()
            .Events(ev=>ev.DataBound("onDataBound"))
            .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                .Events(events =>
                {
                    events.Error("error_handler(\"OverTimeTransfergrid\")");
                    events.RequestStart("onRequestStart(\"OverTimeTransfergrid\")");
                    events.RequestEnd("onRequestEnd(\"OverTimeTransfergrid\")");
                })
          // .Batch(true)

          .Model(model => model.Id(p => p.OverTimeTransferId))
              .Read(read => read.Action("OverTimeTransfers_Read", "OverTimeTransferMaintain").Data("sendForgery"))
                      .Create(create => create.Action("OverTimeTransfers_Create", "OverTimeTransferMaintain").Data("sendForgery"))
                      .Update(update => update.Action("OverTimeTransfers_Update", "OverTimeTransferMaintain").Data("sendForgery"))
              .Destroy(destroy => destroy.Action("OverTimeTransfers_Destroy", "OverTimeTransferMaintain").Data("sendForgery"))
          )//.ClientDetailTemplateId("template")
      )

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                          .Name("tabstrip_#=OverTimeTransferId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text(Resources.Details).Content(
                @<text>


                  @(Html.Kendo().Grid<OverTime>()
                  .Name("OverTimegrid_#=OverTimeTransferId#")
      .Columns(columns =>
      {
         // columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(200);
          //columns.ForeignKey(c => c.PeriodId, (IEnumerable)ViewData["PeriodList"], "PeriodId", "PeriodName").EditorTemplateName("Period").Width(120);
          columns.Bound(c => c.NormalHours).Width(100);
          columns.Bound(c => c.NightHours).Width(100);
          columns.Bound(c => c.HolidayHours).Width(100);
          columns.Bound(c => c.RestdayHours).Width(100);
          //columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Scrollable(h => h.Height(500))
            
      .DataSource(dataSource => dataSource
          .Ajax()
                  .Events(events =>
        {
            events.Error("error_handler(\"OverTimegrid_#=OverTimeTransferId#\")");
            events.RequestEnd("onRequestEnd(\"OverTimegrid_#=OverTimeTransferId#\")");
        }) 
              
          .Model(model => model.Id(p => p.OverTimeId))
              .Read(read => read.Action("OverTimes_Read", "OverTimeTrasferDetail", new { id = "#=EmployeeId#", period = "#=GLPeriodId#", tId = "#=OverTimeTransferId#" }).Data("sendForgery"))
                                  .Create(create => create.Action("OverTimes_Create", "OverTimeTrasferDetail", new { idTwo = "#=EmployeeId#", periodTwo = "#=GLPeriodId#", tIdTwo = "#=OverTimeTransferId#" }).Data("sendForgery"))
                  .Update(update => update.Action("OverTimes_Update", "OverTimeTrasferDetail").Data("sendForgery"))
                  .Destroy(destroy => destroy.Action("OverTimes_Destroy", "OverTimeTrasferDetail").Data("sendForgery"))
      ).ToClientTemplate()
                )



                </text>
                  );
           


          }).ToClientTemplate())
</script>

<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
    function checkAll(ele) {
        var state = $(ele).is(':checked');
        var grid = $('#OverTimeTransfergrid').data().kendoGrid;
        $.each(grid.dataSource.view(), function () {
            if (this['Check'] != state)
                this.dirty = true;
            this['Check'] = state;
        });
        grid.refresh();
    }
    function onDataBound(e) {

        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            if (dataItem.IsSendForApproval) {
               row.find(".k-grid-edit").remove();
                row.find(".k-grid-delete").remove();
                row.find(".k-grid-cmd-request").remove();

            }
          
        }
    }

</script>

