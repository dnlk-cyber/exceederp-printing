<script>
    function sendforapproval(e) {


        var row = $(e.target).closest("tr");
        var grid = $("#OverTimeTransfergrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.OverTimeTransferId;
        if (id.length !== 0 )
        {

            $.ajax({
                url: '@Url.Action("SendForApproval", "OverTimeTransferMaintain")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    alert(result.Message);

                }



            });

        }
    }
</script>