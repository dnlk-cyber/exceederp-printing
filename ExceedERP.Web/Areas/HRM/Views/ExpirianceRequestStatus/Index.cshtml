    function sync_handler(e) {
        this.read();

    }
    var masterRowId ;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#ExperienceRequestgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.ExperienceRequestId;
        masterRowId = masterId;
        var gridName = "#RequestesStatusgrid_" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatuses", "ExpirianceRequestStatus")',

            data: { masterId: masterRowId },
            type: 'POST',
            cache: false,
            success: function (result)
            {
              

                if (result == "Dapproved") {
                     $(gridName).find(".k-toolbar").show(); //hide toolbar
                     $(".k-grid-top", gridName).show();
                     $(".k-grid-edit", gridName).show();
                     $(".k-grid-delete", gridName).show();

                }
                if (result == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                
            }

        });

    }
    function onDetailDataBound(e) {

        var gridName = "#RequestesStatusgrid_" + masterRowId;
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function (e) {
            var model = grid.dataItem(this);
            if (model.Status == 0 || model.Status == 1 || model.Status == 2 || model.Status == 3) {
                $(this).css("background-color", "#darkgrey");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            if (model.Status == 4) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
               // $(this).find(".k-toolbar").remove(); //hide toolbar
                $(".k-grid-top", gridName).hide();
                $(this).find(".k-grid-top", gridName).remove();
                $(this).css("background-color", "#darkgrey");

            }

            else {

                $(this).css("background-color", "lightgreen");
            }
        });
        //var gridIdentifier = "#" + e.sender.element[0].masterRowId;
        var gridIdentifier = gridName;
        var Exist = $(gridName).data("kendoGrid").dataSource.data().some(
            function (dataItem) {
                return dataItem.Status == 4;
            });
        if (Exist) {
            $(".k-grid-top", gridIdentifier).hide();
        } else {
            $(".k-grid-top", gridIdentifier).show();
        }
    }

</script>


<script>
    function onDataBound(e) {

        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check
            if (dataItem.IsOnlineApproved === true) {

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find("#approve").hide();
                row.css("background-color", "gray");
            }
            if (dataItem.IsDirect === false) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find("#approve").hide();
            }
        }
    }

    
</script>


<script>
    function ApproveExperienceRequest(e) {
         var row = $(e.target).closest("tr");
        var grid = $("#ExperienceRequestgrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.ExperienceRequestId;

        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("ApproveExperienceRequest", "ExpirianceRequestStatus")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert(r.Message);
                    $('#loading-image').hide();
                    grid.dataSource.read();
                }
            });

        }
    }
</script>