@(Html.Kendo().Grid<Attachment>()
      .Name("grid")
      .Columns(columns =>
      {
         // columns.Bound(c => c.Remark).Title("Description");
          columns.Bound(c => c.Description).ClientTemplate((@Html.ActionLink("#=Description#", "DownloadFile", "DownloadDocument", new { filename = "#=Description#" }, null).ToHtmlString())); 
             // columns.Bound(c => c.FileType);
            
              //columns.Command(command =>
              //{
              // //  command.Destroy().Text(Resources.ActionButton_Cancel);
              //  //  command.Custom("Download").Click("DownloadAttachmnets");
               
              //}).Width(300);

          })
                       .Events(e =>
                                           {
                                               e.Edit("onGridEdit");
                                               e.Change("onChange");
                                           }) 
                       .ToolBar(toolbar =>
              {
                 // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
              })
                      //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Upload").Window(window =>
                      //{
                      //    window.Scrollable(false);
                      //    window.Title("Upload Committee Minute");
                      //}))
                       
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
             .Scrollable(h => h.Height(500))
                 .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
              .Filterable()
                 .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                    .Events(events => events.Error("error_handler(\"grid\")")
                             // .Sync("sync_handler")
                              )
          .Model(model => model.Id(p => p.AttachmentId))

                          .Read(read => read.Action("Attachments_Read", "Attachment", new { Area = "Common", attachmentReferenceType = "DOCUMENT", id = "0" }))
                                     .Create(create => create.Action("Attachments_Create", "Attachment", new { Area = "Common", attachmentReferenceType = "DOCUMENT", id = "0" }))
                                      .Destroy(destroy => destroy.Action("Attachments_Destroy", "DownloadDocument"))
      )
)
