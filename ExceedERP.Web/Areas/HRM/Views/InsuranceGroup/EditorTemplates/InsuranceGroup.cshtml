@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Web.Areas.HRM.Controllers
@using ExceedERP.Web.Areas.HRM.Controllers.Company
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.HRM.HealthAndInsurance.InsuranceGroup

<form>

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div>@Html.LabelFor(model => model.OrgStructureId, htmlAttributes: new { @class = "control-label col-md-8" })</div>

                @(Html.Kendo().DropDownListFor(model => model.OrgStructureId)
                                  .OptionLabel(Resources.Select)
                                  .DataTextField("Name")
                                   .Filter("contains")
                                  .DataValueField("OrgStructureId")
                                      .DataSource(dataSource =>
                                      {
                                          dataSource.Read(read => read.Action("GetDepartments", "HRMDataProvider", new { area = "HRM" }))
                                              .ServerFiltering(false);
                                      })
                                  .ValuePrimitive(true)

                )
                @Html.ValidationMessageFor(model => model.OrgStructureId, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">

            <div class="form-group">
                <div>@Html.LabelFor(model => model.LookupId, htmlAttributes: new { @class = "control-label col-md-8" })</div>

                @(Html.Kendo().DropDownListFor(m => m.LookupId)
                                              .DataTextField("Description")
                                                    .DataValueField("LookupId")
                                                    .OptionLabel(Resources.Select)
                                                .DataSource(source =>
                                                {
                                                    source.Read(read =>
                                                    {
                                                        read.Action("GetJobTitle", "InsuranceGroup")
                                                        .Data("filterCategories");
                                                    })
                                                    .ServerFiltering(true);
                                                })

                                                      .CascadeFrom("OrgStructureId")
                                          .AutoBind(false)
                                        .Enable(false)
                )
                @Html.ValidationMessageFor(model => model.LookupId, "", new { @class = "text-danger" })
            </div>

        </div>


    </div>

    <br />

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            @* <div>
                        @Html.LabelFor(model => model.GroupName, htmlAttributes: new { @class = "control-label col-md-8" })
                    </div>
                    <div class="form-group">
                        @Html.Kendo().TextBoxFor(model => model.GroupName)
                        @Html.ValidationMessageFor(model => model.GroupName, "", new { @class = "text-danger" })
                    </div>
                </div>*@


            <div class="form-group">
                <div>@Html.LabelFor(model => model.InsuranceCategoryId, htmlAttributes: new { @class = "control-label col-md-8" })</div>

                @(Html.Kendo().DropDownListFor(m => m.InsuranceCategoryId)
                                                              .DataTextField("Name")
                                                                    .DataValueField("InsuranceCategoryId")
                                                                     .Filter("contains")
                                                     .OptionLabel(Resources.Select)

                                                                 .DataSource(dataSource =>
                                                                  {
                                                                      dataSource.Read(read => read.Action("GroupName", "InsuranceGroup", new { area = "HRM" }))
                                                                          .ServerFiltering(false);
                                                                  })
                                                      .ValuePrimitive(true)
                )
                @Html.ValidationMessageFor(model => model.InsuranceCategoryId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>

                    @Html.TextBoxFor(model => model.Remark)
                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>



    </div>

</form>




