@using System.Collections
@using ExceedERP.Core.Domain.HRM.EmployeeDetail
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.HR_EmployeeDetail_Complain_ComplainDescription</legend>
@(Html.Kendo().Grid<Complain>()
      .Name("Complain")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["EmployeeList"], "PersonId", "FullNameWithOutCode").EditorTemplateName("ListOfEmployee").Width(250);
          columns.ForeignKey(c => c.LookupId, (IEnumerable)ViewData["TypeList"], "LookupId", "Description").EditorTemplateName("LookUpList").Width(140);
          columns.Bound(c => c.DateAmharic).EditorTemplateName ("Calander").Width (200);
          columns.Bound(c => c.ComplainDescription);
          columns.ForeignKey(c => c.RefersTo, (IEnumerable)ViewData["RefersTo"], "OrgStructureId", "Name").EditorTemplateName("OrganizationDept").Width(200);
          columns.Bound(c => c.Remark).Width(150);
          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              // command.Destroy().Text(Resources.ActionButton_Cancel);
          }).Width(180);
      })

      .ToolBar(toolbar =>
          {
             
                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
             
          })

      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(h => h.Height(500))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Groupable()
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Events(e =>
      {
          e.Save("GetDate");

          e.Edit("GetDate");
      })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(events =>
          {
              events.Error("error_handler(\"Complain\")");
              events.RequestStart("onRequestStart(\"Complain\")");
              events.RequestEnd("onRequestEnd(\"Complain\")");
          })
          .Model(model =>
          {
              model.Id(p => p.ComplainId);
              model.Field(p => p.EmployeeId).Editable(false);
              model.Field(p => p.LookupId).Editable(false);
              model.Field(p => p.DateAmharic).Editable(false);
              model.Field(p => p.ComplainDescription).Editable(false);
          })
          .Read(read => read.Action("Complains_Read", "EmployeeComplain"))
          .Create(create => create.Action("Complains_Create", "EmployeeComplain"))
          .Update(update => update.Action("Complains_Update", "EmployeeComplain"))
          .Destroy(destroy => destroy.Action("Complains_Destroy", "EmployeeComplain"))
         ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                                    .Name("tabstrip_#=ComplainId#")
                                            .SelectedIndex(0)
                                            .Items(items =>
                                             {

                                                 items.Add().Text("Responses").Content(
                                        @<text>


                                            @(Html.Kendo().Grid<ComplainResponse>()
                                                    .Name("Response#=ComplainId#")
                                                                              .Columns(columns =>
                                                                              {

                                                                                  columns.Bound(c => c.Response);
                                                                                  //columns.Bound(c => c.IsCurrent).Width(100);
                                                                                  columns.Command(command =>
                                                                                  {
                                                                                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                                                                      command.Destroy().Text(Resources.ActionButton_Cancel);
                                                                                  }).Width(180);
                                                                              })

                                                                               .ToolBar(toolbar =>
                                                                               {

                                                                                   toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

                                                                               })


                                                                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                      .Scrollable()
                                                                      .Selectable()
                                                                      .DataSource(dataSource => dataSource
                                                                          .Ajax()
                                                                                  .Events(events =>
                                                                                  {
                                                                                      events.Error("error_handler(\"Response#=ComplainId#\")");
                                                                                      events.RequestStart("onRequestStart(\"Response#=ComplainId#\")");
                                                                                      events.RequestEnd("onRequestEnd(\"Response#=ComplainId#\")");
                                                                                  })


                                                                          .Model(model => model.Id(p => p.ComplainResponseId))
            .Read(read => read.Action("ComplainResponse_Read", "ComplainResponse", new { id = "#=ComplainId#" }))
          .Create(create => create.Action("ComplainResponse_Create", "ComplainResponse", new { id = "#=ComplainId#" }))
          .Update(update => update.Action("ComplainResponse_Update", "ComplainResponse"))
          .Destroy(destroy => destroy.Action("ComplainResponse_Destroy", "ComplainResponse"))

                                                                      ).ToClientTemplate()
                                            )

                                        </text>
                                                                          );

                                                     }).ToClientTemplate())


</script>



<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#DateAmharic").trigger("change");

        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "Complain")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
