@using ExceedERP.Core.Domain.HRM.Company
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorMiscellaneous_RegionNation</legend>
@(Html.Kendo().Grid<RegionNation>()
          .Name("RegionNation")
      .Columns(columns =>
      {
        columns.Bound(c => c.Region).EditorTemplateName ("Enum");
        columns.ForeignKey(c => c.LookupId, (System.Collections.IEnumerable)ViewData["NationList"], "LookupId", "Description").EditorTemplateName("Nation");
        columns.Bound(c => c.Remark);
        //columns.Bound(c => c.OrgBranchName);
        //columns.Bound(c => c.DateCreated);
        //columns.Bound(c => c.LastModified);
        //columns.Bound(c => c.CreatedBy);
        //columns.Bound(c => c.ModifiedBy);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
 
          .Scrollable(h => h.Height(500))
                     .Groupable()
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                  .Filterable()
                     .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Events(events =>
                                                           {
                                                               events.Error("error_handler(\"RegionNation\")");
                                                               events.RequestStart("onRequestStart(\"RegionNation\")");
                                                               events.RequestEnd("onRequestEnd(\"RegionNation\")");
                                                           })
                        
          .Model(model => model.Id(p => p.RegionNationId))
          .Read(read => read.Action("RegionNation_Read", "RegionNation"))
          .Create(create => create.Action("RegionNation_Create", "RegionNation"))
          .Update(update => update.Action("RegionNation_Update", "RegionNation"))
          .Destroy(destroy => destroy.Action("RegionNation_Destroy", "RegionNation"))
      )
)
