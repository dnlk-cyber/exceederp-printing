@using ExceedERP.Core.Domain.HRM.Discipline
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorDiscipline_DisciplineMeasures</legend>
@(Html.Kendo().Grid<DisciplineMeasures>()
          .Name("DisciplineMeasuresgrid")
      .Columns(columns =>
      {
        columns.Bound(c => c.MeasuresType);
        columns.Bound(c => c.Remark);
        columns.Command(command =>
        {
            if (HttpContext.Current.User.IsInRole("HR_Discipline_User"))
            {

                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
            }
            if (HttpContext.Current.User.IsInRole("HR_Admin"))
            {
                command.Destroy().Text(Resources.ActionButton_Cancel);
            }
        }).Width(200);
      })
      .ToolBar(toolbar => {
                              if (HttpContext.Current.User.IsInRole("HR_Discipline_User"))
                              {
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              }
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(h=> h.Height( 500))
           .Groupable()
                  .Sortable(sortable =>
                  {
                      sortable.SortMode(GridSortMode.SingleColumn);
                  })
                   .Filterable()
                  .Scrollable()
              .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                .Events(events =>
                                {
                                    events.Error("error_handler(\"DisciplineMeasuresgrid\")");
                                    events.RequestStart("onRequestStart(\"DisciplineMeasuresgrid\")");
                                    events.RequestEnd("onRequestEnd(\"DisciplineMeasuresgrid\")");
                                })
                        
          .Model(model => model.Id(p => p.MeasuresId))
          .Read(read => read.Action("DisciplineMeasures_Read", "DisciplineMeasures"))
          .Create(create => create.Action("DisciplineMeasures_Create", "DisciplineMeasures"))
          .Update(update => update.Action("DisciplineMeasures_Update", "DisciplineMeasures"))
          .Destroy(destroy => destroy.Action("DisciplineMeasures_Destroy", "DisciplineMeasures"))
          )//.ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=MeasuresId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text(Resources.NavigatorDiscipline_DisciplineMeasuresDetail).Content(
                  @<text>
                      @*<Legend>Measures Detail</Legend>*@
                   @(Html.Kendo().Grid<DisciplineMeasuresDetail>()
                                 .Name("DisciplineMeasuresDetailgrid_#=MeasuresId#")
                         .Columns(columns =>
                         {
                             //columns.Bound(c => c.MeasuresId);
                             columns.Bound(c => c.Level);
                             columns.Bound(c => c.Description);
                             columns.Bound(c => c.Remark);
                             columns.Command(command =>
                             {
                                 if (HttpContext.Current.User.IsInRole("HR_Discipline_User"))
                                 {
                                     command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                 }
                                 if (HttpContext.Current.User.IsInRole("HR_Admin"))
                                 {
                                     command.Destroy().Text(Resources.ActionButton_Cancel);
                                 }
                             }).Width(180);
                         })
                         .ToolBar(toolbar =>
                         {
                             if (HttpContext.Current.User.IsInRole("HR_Discipline_User"))
                             {
                                 toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                             }
                         })
                         .Editable(editable => editable.Mode(GridEditMode.InLine))
                         .Selectable(selectable =>
                         {
                             selectable.Mode(GridSelectionMode.Single);
                             selectable.Type(GridSelectionType.Row);
                         })
                         .Scrollable()
                         .DataSource(dataSource => dataSource
                             .Ajax()
                                      .Events(events =>
                                        {
                                            events.Error("error_handler(\"DisciplineMeasuresDetailgrid_#=MeasuresId#\")");
                                            events.RequestStart("onRequestStart(\"DisciplineMeasuresDetailgrid_#=MeasuresId#\")");
                                            events.RequestEnd("onRequestEnd(\"DisciplineMeasuresDetailgrid_#=MeasuresId#\")");
                                        })
                                                   
                             .Model(model => model.Id(p => p.DetailMeasuresId))
                             .Read(read => read.Action("DisciplineMeasuresDetail_Read", "DisciplineMeasuresDetail", new {id = "#=MeasuresId#"}))
                             .Create(create => create.Action("DisciplineMeasuresDetail_Create", "DisciplineMeasuresDetail", new {id = "#=MeasuresId#"}))
                             .Update(update => update.Action("DisciplineMeasuresDetail_Update", "DisciplineMeasuresDetail"))
                             .Destroy(destroy => destroy.Action("DisciplineMeasuresDetail_Destroy", "DisciplineMeasuresDetail"))
                         ).ToClientTemplate() 
                         )
                
                   </text>
                  );
              //*****************************************************************************************************//
              items.Add().Text(Resources.NavigatorDiscipline_DisciplineMeasuresType).Content(
                  @<text>
    @*<legend>Measures Type</legend>*@
                    @(Html.Kendo().Grid<DisciplineMeasuresType>()
                                          .Name("DisciplineMeasuresTypegrid_#=MeasuresId#")
                          .Columns(columns =>
                          {
                              //columns.Bound(c => c.MeasuresId);
                              columns.Bound(c => c.ExpireYear);
                              columns.Bound(c => c.PercentageEffectOnPromotion);
                              columns.Bound(c => c.IsByMoney);//.ClientTemplate("<input type='checkbox' disabled='true' value='#=IsByMoney #' " + " # if (IsByMoney) { #" + "checked='checked'" + "# } #" + " />");
                              columns.Bound(c => c.Amount);
                              columns.Bound(c => c.Remark);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                 command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(180);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Scrollable()
                          .DataSource(dataSource => dataSource
                              .Ajax()
                                      .Events(events =>
                                                {
                                                    events.Error("error_handler(\"DisciplineMeasuresTypegrid_#=MeasuresId#\")");
                                                    events.RequestStart("onRequestStart(\"DisciplineMeasuresTypegrid_#=MeasuresId#\")");
                                                    events.RequestEnd("onRequestEnd(\"DisciplineMeasuresTypegrid_#=MeasuresId#\")");
                                                })
                                                        
                              .Model(model => model.Id(p => p.DisciplineTypeId))
                              .Read(read => read.Action("DisciplineMeasuresType_Read", "DisciplineMeasuresType", new {id = "#=MeasuresId#"}))
                              .Create(create => create.Action("DisciplineMeasuresType_Create", "DisciplineMeasuresType", new {id = "#=MeasuresId#"}))
                              .Update(update => update.Action("DisciplineMeasuresType_Update", "DisciplineMeasuresType"))
                              .Destroy(destroy => destroy.Action("DisciplineMeasuresType_Destroy", "DisciplineMeasuresType"))
                          ).ToClientTemplate()
                          )
                
                   </text>
                  );
          }).ToClientTemplate())
</script>
<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>

