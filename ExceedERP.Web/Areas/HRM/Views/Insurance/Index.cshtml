<script>
    function GetInsuranceDetail() {
        var InsuranceGroupIds = $("#InsuranceCategoryId").data("kendoDropDownList");
        var group = InsuranceGroupIds.value();
        //var Classes = $("#LookupId").data("kendoDropDownList");
        //var classe = Classes.value();
        $.ajax({
            url: '@Url.Action("GetInsuranceSalary", "Insurance")',

            data: { group: group },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                var filds = r.split(/-/);
                var sal = filds[0];
                var num = filds[1];
                var si = filds[2];
                //var pi = filds[2];
                $("#Number").val(num);
                $("#Salary").val(sal);
                //$("#SumofInsured").val(si);
                //$("#Salary").val(sal);
                //$("#Premium").val(pi);
                //$("#SumofInsured").val(si);
            }

        });
    }

</script>
<script>
    function GetDate() {

        var x = AssignDate();
        var y = x;
        $("#FromAmharic").trigger("change");
        $("#ToAmharic").trigger("change");
        for (var o in y) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SetDate", "Insurance")',
                data: { name: y[o].id, value: y[o].date },
                type: 'GET',
                cache: false,
                success: function (result) {
                    r = result;
                }

            });
        }
    }

</script>
<script>
    function AssignDate() {
        var list = AssignDates();
        return list;
    }

</script>
<script>
    function filterCategories() {
       
        return {
            InsuranceTypeId: $("#InsuranceTypeId").data("kendoDropDownList").value()
        };
    }
</script>
