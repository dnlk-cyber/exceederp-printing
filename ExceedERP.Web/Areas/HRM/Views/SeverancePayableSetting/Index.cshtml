@using System.Collections
@using ExceedERP.Core.Domain.HRM.Severance
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@(Html.Kendo().TabStrip()
    .Name("tabstrip")
    .Animation(animation =>
        animation.Open(effect =>
            effect.Fade(FadeDirection.In)))
     .Items(tabstrip =>
     {
          tabstrip.Add().Text("Severance Payable setting")
          .Selected(true)
          .Content(@<text>
              @severanceSetting()

            </text>);
         tabstrip.Add().Text("Severance Calculation Setting")
         .Content(@<text>
              @severanceCalculationSetting()

            </text>);
     
     })
)

@helper severanceSetting()
{ 
    <Legend>Severance Payable setting</Legend>
    @(Html.Kendo().Grid<SeverancePayableSetting>()
              .Name("SeverancePayableSetting_grid")
              .Columns(columns =>
              {
                  columns.Bound(c => c.SeverancePayableSettingId).Title("#").Width(100);
                  columns.Bound(c => c.ResponsibilityLevel).Width(200);
                  columns.Bound(c => c.MinYearsOfService).Width(160);
                  columns.Bound(c => c.MaxYearsOfService).Width(160);
                  columns.Bound(c => c.SalaryValue).Width(160);
                  columns.Bound(c => c.YearsPaidWithFullSalary).Width(160);
                  columns.Command(command =>
                  {
                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);

                      command.Destroy().Text(Resources.ActionButton_Cancel);

                  })/*.Width(200)*/;

              })
             .ToolBar(toolbar =>
             {
                 toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

             })
             .Editable(editable => editable.Mode(GridEditMode.InLine))
             .Scrollable(h => h.Height(500))
             .Sortable(sortable =>
             {
                 sortable.SortMode(GridSortMode.SingleColumn);

             })
             .Filterable()

             .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))

            .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events =>
                {
                    events.Error("error_handler(\"SeverancePayableSetting_grid\")");
                    events.RequestStart("onRequestStart(\"SeverancePayableSetting_grid\")");
                    events.RequestEnd("onRequestEnd(\"SeverancePayableSetting_grid\")");

                })

                .Model(model =>
                {

                    model.Id(p => p.SeverancePayableSettingId);
                    model.Field(p => p.SeverancePayableSettingId).Editable(false);
                    model.Field(p => p.YearsPaidWithFullSalary).DefaultValue(1.0m);

                })
                .Read(read => read.Action("SeverancePayableSetting_Read", "SeverancePayableSetting").Data("sendForgery"))
                .Create(create => create.Action("SeverancePayableSetting_Create", "SeverancePayableSetting").Data("sendForgery"))
                .Update(update => update.Action("SeverancePayableSetting_Update", "SeverancePayableSetting").Data("sendForgery"))
                .Destroy(destroy => destroy.Action("SeverancePayableSetting_Destroy", "SeverancePayableSetting").Data("sendForgery")))

    )
}

@helper severanceCalculationSetting()
{ 
    
     @(Html.Kendo().Grid<SeveranceCalculationSetting>()
          .Name("SeveranceCalculationSetting_grid")
          .Columns(columns =>
          {

              columns.Bound(c => c.SeveranceCalculationSettingId).Title("#").Width(100);
              columns.Bound(c => c.FormulaType).EditorTemplateName("Enum").Width(200);

              columns.Bound(c => c.IsActive).ClientTemplate(
                     "<input type='checkbox' disabled = 'true' value='#=IsActive#' " +
                     "# if (IsActive) { #" +
                     "checked='checked'" +
                     "# } #" +
                     "/>").Width(140);
              columns.Bound(c => c.Description).Width(150);
              columns.Command(command =>
              {
                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);

                  command.Destroy().Text(Resources.ActionButton_Cancel);

              })/*.Width(200)*/;
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(550))
            .Sortable(sortable =>
            {
                sortable.SortMode(GridSortMode.SingleColumn);

            })
            .Filterable()
            .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Sort(sort=>sort.Add(x=>x.SeveranceCalculationSettingId).Descending())
              .Events(events =>
              {
                  events.Error("error_handler(\"SeveranceCalculationSetting_grid\")");
                  events.RequestStart("onRequestStart(\"SeveranceCalculationSetting_grid\")");
                  events.RequestEnd("onRequestEnd(\"SeveranceCalculationSetting_grid\")");

              })
              .Model(model => {
                  model.Id(p => p.SeveranceCalculationSettingId);
                  model.Field(p => p.SeveranceCalculationSettingId).Editable(false);
              })
              .Read(read => read.Action("SeveranceCalculationSetting_Read", "SeveranceCalculationSetting").Data("sendForgery"))
              .Create(create => create.Action("SeveranceCalculationSetting_Create", "SeveranceCalculationSetting").Data("sendForgery"))
              .Update(update => update.Action("SeveranceCalculationSetting_Update", "SeveranceCalculationSetting").Data("sendForgery"))
              .Destroy(destroy => destroy.Action("SeveranceCalculationSetting_Destroy", "SeveranceCalculationSetting").Data("sendForgery"))
          )
)

    
 }

<script>
   

    function sync_handler(e) {
        this.read();

    }
</script>