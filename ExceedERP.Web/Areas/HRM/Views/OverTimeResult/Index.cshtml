@using System.Collections
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization 
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>@Resources.NavigatorPayrollReport_OverTimeResult</legend>

@(Html.Kendo().Grid<OverTimeRequest>()
          .Name("OverTimeRequestgrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.OrgStructureId, (IEnumerable)ViewData["organization"], "OrgStructureId", "Name").EditorTemplateName("Organization").Width(150);
          columns.Bound(c => c.Description);
          columns.Bound(c => c.FromDate).Format("{0:yyyy-MM-dd}");
          columns.Bound(c => c.ToDate).Format("{0:yyyy-MM-dd}");
          columns.Bound(c => c.FromTime);//.Format("{0:hh:mm:ss}");
          columns.Bound(c => c.ToTime);//.Format("{0:hh:mm:ss}");

          //columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      //.ToolBar(toolbar =>
      //{
      //    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      //})
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Scrollable(h => h.Height(500))
                                         .Groupable()
                                                  .Sortable(sortable =>
                                                  {
                                                      sortable.SortMode(GridSortMode.SingleColumn);
                                                  })
                                      .Filterable()
                                         .Pageable(pageable => pageable
                                                                    .Input(true)
                                                                    .Numeric(false)
                                                                    .Refresh(true)
                                                                    .PageSizes(true)
                                                                    .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                            .Events(events =>
                                                                                        {
                                                                                            events.Error("error_handler(\"OverTimeRequestgrid\")");
                                                                                            events.RequestStart("onRequestStart(\"OverTimeRequestgrid\")");
                                                                                            events.RequestEnd("onRequestEnd(\"OverTimeRequestgrid\")");
                                                                                        }) 
          .Model(model => model.Id(p => p.OverTimeRequestId))
          .Read(read => read.Action("OverTimeRequest_Read", "OverTimeRequest"))
          .Create(create => create.Action("OverTimeRequest_Create", "OverTimeRequest"))
          .Update(update => update.Action("OverTimeRequest_Update", "OverTimeRequest"))
          .Destroy(destroy => destroy.Action("OverTimeRequest_Destroy", "OverTimeRequest"))
              ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                  .Name("tabstrip_#=OverTimeRequestId#")
          .SelectedIndex(0)
          .Items(items =>
          {

              items.Add().Text(Resources.NavigatorPayrollReport_OverTimeResult).Content(
                @<text>

                    @(Html.Kendo().Grid<OverTimeJobResult>()
                  .Name("OverTimeJobResultgrid_#=OverTimeRequestId#")
      .Columns(columns =>
      {
          columns.Bound(c => c.Date);
          columns.Bound(c => c.JobResult);
          columns.Bound(c => c.Cost);
          columns.Bound(c => c.Benefit);
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); });
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Scrollable(h => h.Height(500))
                            //   .Groupable()
                            //            .Sortable(sortable =>
                            //            {
                            //                sortable.SortMode(GridSortMode.SingleColumn);
                            //            })
                            //.Filterable()
                            //   .Pageable(pageable => pageable
                            //                              .Input(true)
                            //                              .Numeric(false)
                            //                              .Refresh(true)
                            //                              .PageSizes(true)
                            //                              .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                  .Events(events =>
                                                                                                {
                                                                                                    events.Error("error_handler(\"OverTimeJobResultgrid_#=OverTimeRequestId\")");
                                                                                                    events.RequestStart("onRequestStart(\"OverTimeJobResultgrid_#=OverTimeRequestId\")");
                                                                                                    events.RequestEnd("onRequestEnd(\"OverTimeJobResultgrid_#=OverTimeRequestId\")");
                                                                                                }) 
              
          .Model(model => model.Id(p => p.OverTimeJobResultId))
                  .Read(read => read.Action("OverTimeJobResults_Read", "OverTimeResult", new { id = "#=OverTimeRequestId#" }))
                  .Create(create => create.Action("OverTimeJobResults_Create", "OverTimeResult", new { idTwo = "#=OverTimeRequestId#" }))
          .Update(update => update.Action("OverTimeJobResults_Update", "OverTimeResult"))
          .Destroy(destroy => destroy.Action("OverTimeJobResults_Destroy", "OverTimeResult"))
      ).ToClientTemplate()
                    )
                </text>
                  );
          }).ToClientTemplate())
</script>
                    <script>
                        function error_handler(e) {
                            if (e.errors) {
                                var message = "Errors:\n";
                                $.each(e.errors, function (key, value) {
                                    if ('errors' in value) {
                                        $.each(value.errors, function () {
                                            message += this + "\n";
                                        });
                                    }
                                });
                                alert(message);

                            }

                        }

                        function sync_handler(e) {
                            this.read();

                        }
                    </script>
