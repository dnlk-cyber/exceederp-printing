@(Html.Kendo().DropDownListFor(m => m)
                .Name("InventoryId")
                .HtmlAttributes(new { @id = "in_#=EstimationFormId#" })
                .ValuePrimitive(true)
                .OptionLabel("Select Materials...")
                .DataTextField("Name")
                .DataValueField("InventoryId")
                .Filter("contains")
                .DataSource(dataSource =>
                {
                    dataSource.Read(read => read.Action("GetAllInventories", "Material", new { area = "PrintingEstimation" }))
                    .ServerFiltering(false);
                })

)
@Html.ValidationMessageFor(m => m)
