<script> 
    $("#cmdAddRecord").click(function (e) {

        var grid = $("#labor_costs_" + codeid).data("kendoGrid");
        var sorting = grid.dataSource.sort();
        var filtering = grid.dataSource.filter();
        if (filtering) {
            grid.dataSource.filter(null);
        }
        if (sorting) {
            grid.dataSource.sort(null);
        }
        grid.addRow();
        e.preventDefault();

    });
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }

     function selectProduct() {
        var productId = $("#InventoryId").val()
       
         $.ajax({
                type: 'GET',
             url: '@Url.Action("GetUnitPrice", "ProductionDataProvider", new { area = "ProductionFollowUp" })',
             data: {
                 itemCode: productId,

             },
                 async: false,
             success: function (result) {
                 data = result;
                
                 var up = $("#UnitPrice").data("kendoNumericTextBox");
                 up.value(data.AvgPrice);
                 up.trigger("change");



                 
            }
            });
    }
    function onChange() {

        var unitPricenumerictextbox = $("#UnitPrice").data("kendoNumericTextBox");
        var quantitynumerictextbox = $("#Quantity").data("kendoNumericTextBox");
        var totalPricenumerictextbox = $("#TotalPrice").data("kendoNumericTextBox");

        var unitPrice = unitPricenumerictextbox.value();
        var quantity = quantitynumerictextbox.value();
        var totalPrice = unitPrice * quantity;
        totalPricenumerictextbox.value(totalPrice);
        totalPricenumerictextbox.trigger("change");
    }
    function filterCategories() {
        //
        // summary:
        //      send the filtering text along with the parent widget's value
        //var dropdownlist = $("#ItemCode").data("kendoDropDownList");
        return {
            ItemCategoryCode: $("#InventoryCategoryId").val()
        };
    }
    function onSave(e) {
        //$("#grid").data("kendoGrid").dataSource.read();
    }
    function filterPrintingSteps() {
        return {
            PrintingStep: $("#PrintingSteps").val()

        };
    }
    var masterRow;
    var masterGrid;
    var masterDataItem;
    var codeid;
    function detailExpand(e) {
        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.EstimationFormId;

    }
   
    </script>

