@model ExceedERP.Core.Domain.PrintingEstimation.MaterialCost
@using ExceedERP.Core.Localization

<form id="lineForm" method="post">

    <div class="row">
        <div class="col-sm-2">
            <div class="k-label">
                @Html.HiddenFor(model => model.MaterialCostId)
            </div>
        </div>

        <div class="col-sm-5">
            <div class="form-group">
                <div class="k-label">
                    <label for="Product">Inventory Category</label>
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(m => m.InventoryCategoryId)
                                                  .OptionLabel(Resources.Select)
                                                      .DataTextField("Name")
                                                      .DataValueField("ItemCategoryCode")
                                                      //    .BindTo((IEnumerable)ViewData["Items"])
                                                      .DataSource(dataSource =>
                                                      {
                                                          dataSource.Read(read => read.Action("GetItemCategory", "DataProvider", new { Area = "Inventory" }));
                                                              //.ServerFiltering(true);
                                                          })
                                                      .Filter("contains")
                                                      .MinLength(2)
                                                      .ValuePrimitive(true)
                    )
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-2">
        
            </div>
            <div class="col-sm-5">
                <div class="form-group">
                    <div class="k-label">
                        <label for="Product">Inventory</label>
                    </div>
                    <div>
                        @(Html.Kendo().DropDownListFor(model => model.InventoryId)
                                                                                                                            .DataTextField("Name")
                                                                                                                           .DataValueField("ItemCode")
                                                                                                                           .Events(ev =>
                                                                                                                           {
                                                                                                                               ev.Change("selectProduct");

                                                                                                                           })
                                                                                                                                                                                                                                                                      .CascadeFrom("InventoryCategoryId")

                                                                                                                                           //    .BindTo((IEnumerable)ViewData["Items"])
                                                                                                                                           .DataSource(dataSource =>
                                                                                                                                           {
                                                                                                                                               dataSource.Read(read => read.Action("GetItems1", "DataProvider", new { Area = "Inventory" }).Data("filterCategories"))
                                                                                                                                               .ServerFiltering(true);
                                                                                                                                           })

                                                                                                                                           .Filter("contains")
                                                                                                                                           .MinLength(2)
                                                                                                                                           .ValuePrimitive(true)
                        )
                    </div>
                </div>
            </div>
        </div>
    <div class="row">
        <div class="col-sm-2"> </div>

        <div class="col-sm-5">
            <div class="form-group">
                <div class="k-label">
                    <label for="Quantity">Quantity</label>
                </div>
                <div>
                    @(Html.Kendo().NumericTextBoxFor(model => model.Quantity)
                                .Events(ev => ev.Change("onChange")))
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-2"> </div>

        <div class="col-sm-5">
            <div class="form-group">
                <div class="k-label">
                    <label for="UnitPrice">Unit Price</label>
                </div>
                <div>
                    @(Html.Kendo().NumericTextBoxFor(model => model.UnitPrice)
.HtmlAttributes(new { style = "color:red;"/*, @readonly = "readonly" */}))
                </div>
            </div>
        </div>
    </div>
    <div class="row">
            <div class="col-sm-2"> </div>
            <div class="col-sm-5">
                <div class="form-group">
                    <div class="k-label">
                        <label for="TotalPrice">Total Price</label>
                    </div>
                    <div>
                        @(Html.Kendo().NumericTextBoxFor(model => model.TotalPrice)
.HtmlAttributes(new { style = "color:red;", @readonly = "readonly" })     )
                    </div>
                </div>
            </div>
        </div>

</form>

