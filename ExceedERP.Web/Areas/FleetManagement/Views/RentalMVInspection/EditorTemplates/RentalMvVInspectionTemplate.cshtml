<div class="form">
    <div class="row fullrow">
        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.RentalInspectionCriteriaId, "Parameter", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(m => m.RentalInspectionCriteriaId)
                           .OptionLabel("Select Parameter")
                           .DataTextField("CriteriaName")
                           .DataValueField("RentalInspectionCriteriaId")
                           .DataSource(dataSource =>
                           {
                               dataSource.Read(read => read.Action("GetParameterCategory", "FleetMaintenanceDataProvider", new { Area = "FleetManagement" }))
                               .ServerFiltering(false);
                           })
                           .Filter("contains")
                           .MinLength(2)
                           .ValuePrimitive(true)
                    )
                    @Html.ValidationMessageFor(model => model.RentalInspectionCriteriaId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.HeadOfficePoorCondtion, htmlAttributes: new { @class = "control-label col-md-8" })
