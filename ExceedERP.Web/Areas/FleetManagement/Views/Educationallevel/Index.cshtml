@{
    ViewBag.Title = "Educational level";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Educational level</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.Educationallevel>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.Name).Width(140);
        columns.Bound(e => e.Description).Width(140);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

    })
                             .ToolBar(commands => commands.Create())
       .Editable(editable =>
         {
             editable.Mode(GridEditMode.InLine);
             editable.DisplayDeleteConfirmation("Are You Sure To Remove Educational level");
         })
        .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Scrollable(h => h.Height(500))
    .DataSource(dataSource => dataSource
        .Ajax()
    
        .Model(model =>
              {
                  model.Id(p => p.EducationallevelID);

                  model.Field(p => p.EducationallevelID).Editable(false);

              })
                       .Events(ev => ev
                                        .Error("error_handler(\"grid\")")
                                        .RequestStart("onRequestStart(\"grid\")")
                                        .RequestEnd("onRequestEnd(\"grid\")"))
                        .Create(update => update.Action("Educationallevel_Create", "Educationallevel").Data("sendForgery"))
                        .Read(read => read.Action("Educationallevel_Read", "Educationallevel").Data("sendForgery"))
                        .Update(update => update.Action("Educationallevel_Update", "Educationallevel").Data("sendForgery"))
                        .Destroy(update => update.Action("Educationallevel_Destroy", "Educationallevel").Data("sendForgery"))
  )
)
