@model ExceedERP.Core.Domain.FleetManagement.FleetSalvageStore.Cannibalization
@{
    ViewBag.Title = "Cannibalization";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Cannibalization FollowUp</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetSalvageStore.Cannibalization>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.ForeignKey(c => c.PartNeededFleetsID, (System.Collections.IEnumerable)ViewData["Fleets"], "FleetsId", "PlateNumber").Width(120);
        columns.ForeignKey(c => c.PartTakenFleetsID, (System.Collections.IEnumerable)ViewData["Fleets"], "FleetsId", "PlateNumber").Width(120);
        columns.Bound(e => e.IsPermanent).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsPermanent #' " + " # if (IsPermanent) { #" + "checked='checked'" + "# } #" + " />").Width(100);
         columns.Bound(e => e.Status).Width(100);
            columns.Command(command => {  }).Width(150);


    })      .Events(ev =>
                                                 {
                                                     ev.DetailExpand("onDetailExpand");
                                                     ev.DataBound("onDataBound");

                                                 })
                  .ToolBar(commands =>
              {
             commands.Excel();
                  commands.Pdf();
              })
    .Editable(editable =>
      {
          editable.Mode(GridEditMode.PopUp).TemplateName("CannibalizationEditor").Window(x => x.Title("Canibalization"));
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Cannibalization");
      })
        .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                               .Scrollable(h => h.Height(500))
                                  .ClientDetailTemplateId("template")
                                 .Events(ev => { ev.DetailExpand("onDetailExpandUser"); ev.DataBound("onDataBound"); })
       .DataSource(dataSource => dataSource
        .Ajax()
     
       
        .Model(model =>
              {
                  model.Id(p => p.CannibalizationID);
              })
                         .Events(ev => ev
                                .Error("error_handler(\"grid\")")
                                .RequestStart("onRequestStart(\"grid\")")
                                .RequestEnd("onRequestEnd(\"grid\")"))
                    .Read(read => read.Action("CannibalizationFollowUp_Read", "Cannibalization").Data("sendForgery"))
               
  )
)




<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                            .Name("tabStrip_#=CannibalizationID#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
                
                   items.Add().Text("Detail").Content(
                        @<text>
                            <legend>Detail</legend>

                            <div class="box">

                                <div class="box-col">
                                    <a href='@Url.Action("Cannibalization", "PrintJob")/?Id=#=CannibalizationID#' title="Print"><i class="fa fa-print fa-2x"></i></a>

                              
                                </div>
                            </div>
    
                            <div class="demo-section k-header export-app">
                                <div class="demo-section content-wrapper">

                                    <form>

                                       

                                        <div class="row">
                                            <div class="col-md-1">
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.CreatedBy)
                                                    </div>
                                                    <div>
                                                        #=CreatedBy#

                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.DateCreated)
                                                    </div>
                                                    <div>
                                                        #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                                    </div>
                                                </div>
                                            </div>
                                       
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.ModifiedBy)
                                                    </div>
                                                    <div>

                                                        #=ModifiedBy#

                                                    </div>
                                                </div>
                                            </div>
                                       
                                                    <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.LastModified)
                                                    </div>
                                                    <div>
                                                        #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #

                                                    </div>
                                                </div>
                                            </div>
                                          
                                        </div>

                                    </form>

                                </div>
                            </div>



                        </text>


            );
                   items.Add().Text(" Parts").Content(@<text>

                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetSalvageStore.CannibalizationDetail>()
                                                                                        .Name("CannibalizationDetaill#=CannibalizationID#")
                        .Columns(columns =>
                        {

                            columns.Bound(o => o.Model).Width(120);
                            columns.Bound(c => c.PartType).Width(120);
                            columns.Bound(c => c.PartName).Width(120);
                            columns.Bound(o => o.WHPRNo).Width(100);
                            columns.Bound(c => c.Quantity).Width(80);
                            columns.Bound(c => c.Description).Width(120);
                            columns.Command(command => { command.Edit(); command.Destroy(); }).Width(150);

                        }) 
                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                                       .DataSource(dataSource => dataSource
                            .Ajax()
                                .Model(model =>
                                      {
                                          model.Id(p => p.CannibalizationDetailId);
                                          model.Field(p => p.CreatedBy).Editable(false);
                                          model.Field(p => p.DateCreated).Editable(false);
                                      })


                                                                                .Events(ev => ev
                                                            .Error("error_handler(\"CannibalizationDetaill#=CannibalizationID#\")")
                                                            .RequestStart("onRequestStart(\"CannibalizationDetaill#=CannibalizationID#\")")
                                                            .RequestEnd("onRequestEnd(\"CannibalizationDetaill#=CannibalizationID#\")"))
                                                                                                                           .Create(update => update.Action("CannibalizationDetails_Create", "CannibalizationDetail", new { Id = "#=CannibalizationID#" }).Data("sendForgery"))
                                                                                                             .Read(read => read.Action("CannibalizationDetails_Read", "CannibalizationDetail", new { Id = "#=CannibalizationID#" }).Data("sendForgery"))
                                                                                   .Update(update => update.Action("CannibalizationDetails_Update", "CannibalizationDetail").Data("sendForgery"))
                                                                                                     .Destroy(update => update.Action("CannibalizationDetails_Destroy", "CannibalizationDetail").Data("sendForgery"))

                                                      )
                                               .ToClientTemplate())
                </text>
                );

                   items.Add().Text(" Approval").Content(@<text>

                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetSalvageStore.CannibalizationApproval>()
                                                                                        .Name("CannibalizationApproval#=CannibalizationID#")
                        .Columns(columns =>
                        {
                            columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                            columns.Bound(o => o.Remark).Width(200);
                            columns.Bound(c => c.CreatedBy).Width(150);
                            columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                            columns.Command(command => { command.Edit(); }).Width(250);

                        }).Events(ev =>
                                               {
                                                   ev.DataBound("approveonDataBound");
                                               })
                             .Editable(editable => editable.Mode(GridEditMode.InLine))
                                       .DataSource(dataSource => dataSource
                            .Ajax()
                                .Model(model =>
                                      {
                                          model.Id(p => p.CannibalizationApprovalID);
                                          model.Field(p => p.CreatedBy).Editable(false);
                                          model.Field(p => p.DateCreated).Editable(false);
                                      })


                                                                                .Events(ev => ev
                                                    .Error("error_handler(\"CannibalizationApproval#=CannibalizationID#\")")
                                                    .RequestStart("onRequestStart(\"CannibalizationApproval#=CannibalizationID#\")")
                                                    .RequestEnd("onRequestEnd(\"CannibalizationApproval#=CannibalizationID#\")"))
                                                                                                   .Create(update => update.Action("Cannibalization_Approve", "CannibalizationApproval", new { EId = "#=CannibalizationID#" }).Data("sendForgery"))
                                                                                     .Read(read => read.Action("CannibalizationApproval_Read", "CannibalizationApproval", new { EId = "#=CannibalizationID#" }).Data("sendForgery"))
                                                                   .Update(update => update.Action("Cannibalization_Approve", "CannibalizationApproval").Data("sendForgery"))


                                                      )
                                               .ToClientTemplate())
                </text>
                );
                
            })
                                                                                                                                                                                                                                                                                    .ToClientTemplate())
</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
<script type="text/javascript">

 
    var IsApproved;
    var IsSendForApproval;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        IsSendForApproval = masterDataItem.IsSendForApproval
        IsApproved = masterDataItem.IsOnlineApproved;
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            console.log(dataItem.IsOnlineApproved);
            if (dataItem.IsSendForApproval == true || dataItem.IsSendForApproval == "true") {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

      function approveonDataBound(e) {
          var grid = this;

          $(grid).find(".k-toolbar").hide(); //hide toolbar
          $(".k-grid-top", grid).hide();

          grid.tbody.find("tr[role='row']").each(function () {
              var dataItem = grid.dataItem(this);
              if (dataItem.Status == "Approve" || IsApproved == true) {
                  console.log("Approved");
                  $(this).find(".k-grid-edit").remove();
                  $(this).find(".k-grid-delete").remove();
              }
          });
      }

</script>
