<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.FleetsID, "Equipment Name", htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @(Html.Kendo().DropDownListFor(model => model.FleetsID)
                                                      .ValuePrimitive(true)
                                                      .OptionLabel("Select Equipment...")
                                                      .DataTextField("PlateNumber")
                                                      .DataValueField("FleetsID")
                                                      .Filter("contains")
                                                      .MinLength(2)
                                                      .DataSource(dataSource =>
                                                      {
                                                          dataSource.Read(read => read.Action("GetFleet", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery"))
                                                              .ServerFiltering(false);
                                                      }).HtmlAttributes(new { style = "width:100%" })
                )

            </div>
        </div>
    </div>
