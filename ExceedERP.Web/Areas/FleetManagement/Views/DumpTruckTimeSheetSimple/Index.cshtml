<legend>Dump Truck Timesheets</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.DumpTruckTimeSheet>()
                        .Name("grid")
                        .Columns(columns =>
                        {
                            columns.Bound(c => c.DumpTruckTimeSheetId).Title("#").Filterable(false).Width(30);
                            columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["Fleets"], "FleetsID", "PlateNumber").Title("Equipment Name").Width(110);
                            columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["ProcurementSupplier"], "ProcurementSupplierID", "Name").Title("Supplier Name").Width(110);
                            columns.Bound(c => c.Date).Width(70);
                            columns.Bound(c => c.TypeOfWorkExcuted).Title("Work Excuted").Width(100);
                            columns.Bound(c => c.LoadingLocationFrom).Title("Loading From").Width(100);
                            columns.Bound(c => c.LoadingLOactionTo).Title("Loading To").Width(100);
                            columns.Bound(c => c.TimeSheetStatus).Width(100);

                            columns.Command(command => { command.Edit().UpdateText("Save").CancelText("Cancel").Text("Edit"); command.Destroy().Text("Delete"); }).Title("Action").Width(200);
                        })
                        .ToolBar(toolbar =>
                        {
                            toolbar.Create();

                        })
                        .Editable(editable => editable.Mode(GridEditMode.PopUp)
                        .TemplateName("DumpTruckTimeSheetSimpleTemplate")
                        .Window(win => win.Title("Dump Truck Timesheets").Width(800)))
                        .Pageable()
                        .Events(e => e.DataBound("dataBound"))
                        .Events(e => e.DetailExpand("onDetailExpand"))
                        .Filterable()
                        .Scrollable(s => s.Height(550))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Sort(s => s.Add(e => e.DumpTruckTimeSheetId).Descending())
                            .Model(model => model.Id(p => p.DumpTruckTimeSheetId))
                            .Events(ev => ev
                                         .Error("error_handler(\"grid\")")
                                         .RequestStart("onRequestStart(\"grid\")")
                                         .RequestEnd("onRequestEnd(\"grid\")"))
                            .Read(read => read.Action("DumpTruckTimeSheets_Read", "DumpTruckTimeSheetSimple"))
                            .Create(create => create.Action("DumpTruckTimeSheets_Create", "DumpTruckTimeSheetSimple"))
                            .Update(update => update.Action("DumpTruckTimeSheets_Update", "DumpTruckTimeSheetSimple"))
                            .Destroy(destroy => destroy.Action("DumpTruckTimeSheets_Destroy", "DumpTruckTimeSheetSimple"))
                        ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">

    @(Html.Kendo().TabStrip()
                                                                           .Name("tabStrip_#=DumpTruckTimeSheetId#")
                                                                           .SelectedIndex(0)
                                                                           .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                                                                           .Items(items =>
                                                                           {

                                                                               items.Add().Text("Detail").Content(
                                                                                    @<text>
                                                                                        <legend>Detail</legend>
                                                                                        <div class="box">
                                                                                            <div class="box-col">

                                                                                                # if (TimeSheetSendForAproval == false)
                                                                                                {#

                                                                                                <a onclick='return sendForApproval("#=DumpTruckTimeSheetId#")' href=' \#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                                                                                # }#
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="row">
                                                                                            <div class="col-md-1">
                                                                                            </div>
                                                                                            <div class="col-md-6" style="margin-top:20px;">
                                                                                                <div class="form-group">
                                                                                                    <label>Status</label>: <span>#=TimeSheetStatus#</span>
                                                                                                </div>
                                                                                                <div class="form-group">
                                                                                                    <label>Created By</label>: <span>#=CreatedBy#</span>
                                                                                                </div>
                                                                                                <div class="form-group">
                                                                                                    <label>Date Created</label>: <span>#=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #</span>
                                                                                                </div>
                                                                                                <div class="form-group">
                                                                                                    <label>Approved By</label>: <span>#=TimeSheetApprovedBy#</span>
                                                                                                </div>
                                                                                                <div class="form-group">
                                                                                                    <label>Approved Date</label>: <span>#=kendo.toString(kendo.parseDate(TimeSheetApprovedDate), 'dd/MM/yyyy')#</span>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>

                                                                                    </text>
                                                                                                            );
                                                                                       
                                                                           items.Add().Text("Approval").Content(
                                                @<text>

                                                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.TimeSheetApprovalNew>()
                                                        .Name("TimeSheetApproval#=DumpTruckTimeSheetId#")
                                                        .Columns(columns =>
                                                        {
                                                                    columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                                                                    columns.Bound(o => o.Remark).Width(200);
                                                                    columns.Bound(c => c.CreatedBy).Width(150);
                                                                    columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                                                                    columns.Command(command => { command.Edit(); }).Width(250);

                                                                })
                                                        .ToolBar(commands => commands.Create().Text("Approve Request"))
                                                        .Events(ev =>
                                                        {
                                                                    ev.DataBound("approvalDataBound");
                                                                })
                                                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                .DataSource(dataSource => dataSource
                                                                .Ajax()
                                                                .PageSize(5)
                                                                .Model(model =>
                                                                {
                                                                    model.Id(p => p.TimeSheetApprovalNewId);
                                                                    model.Field(p => p.CreatedBy).Editable(false);
                                                                    model.Field(p => p.DateCreated).Editable(false);
                                                                })
                                                                .Events(ev => ev
                                                                .Error("error_handler(\"TimeSheetApproval#=DumpTruckTimeSheetId#\")")
                                                                .RequestStart("onRequestStart(\"TimeSheetApproval#=DumpTruckTimeSheetId#\")")
                                                                .RequestEnd("onRequestEnd(\"TimeSheetApproval#=DumpTruckTimeSheetId#\")"))

                                                                .Create(update => update.Action("DumpTruckTimeSheetApproval_Create", "DumpTruckTimeSheetSimple", new { Id = "#=DumpTruckTimeSheetId#" }))
                                                                .Read(read => read.Action("DumpTruckTimeSheetApproval_Read", "DumpTruckTimeSheetSimple", new { Id = "#=DumpTruckTimeSheetId#" }))
                                                                .Update(update => update.Action("DumpTruckTimeSheetApproval_Create", "DumpTruckTimeSheetSimple"))


                                                            )
                                                            .ToClientTemplate())
                                                </text>
                       );
                                                           }).ToClientTemplate())


</script>




<script type="text/javascript">

    var timeSheetApproved;
    var timeSheetSendForAproval;
    var dumpTruckTimeSheetId;

    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = this;

        var masterDataItem = masterGrid.dataItem(masterRow);

        timeSheetApproved = masterDataItem.TimeSheetApproved;

        timeSheetSendForAproval = masterDataItem.TimeSheetSendForAproval;

        dumpTruckTimeSheetId = masterDataItem.DumpTruckTimeSheetId;


        var firstValidationgridName = "#TimeSheetApproval" + dumpTruckTimeSheetId;



        if (timeSheetApproved == true || timeSheetSendForAproval == false) {

            $(".k-grid-top", firstValidationgridName).hide();

        }
    }

    function filterOperator() {
        return {
            text: $("#OperatorId").data("kendoDropDownList").filterInput.val()
        }
    }

    function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("TimeSheetSendForApproval", "DumpTruckTimeSheetSimple", new { area = "FleetManagement" })',
            data: { id: id },
            success: function (result) {

                alert(result);

                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }

    function approvalDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsApproved == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });

    }

    function dataBound() {


        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.TimeSheetApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
            if (dataItem.TimeSheetApproved == true || dataItem.TimeSheetSendForAproval == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();


            }
        });
    }
</script>

<style>
    div.k-edit-form-container {
        width: auto;
        height: auto;
    }

    .row .col-sm-2 {
        width: 150px;
    }

    .row {
        margin: auto;
    }
</style>