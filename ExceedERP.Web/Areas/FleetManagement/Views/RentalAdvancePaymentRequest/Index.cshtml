
@{
    ViewBag.Title = "RentalPaymentRequest";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Rental Advance Payment Request</legend>
<link href="~/Scripts/Exceed/dist/css/style.css" rel="stylesheet" />
<script src="~/Scripts/Exceed/exceed.js"></script>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.RentalPayment.RentalAdvancePaymentRequest>()
                    .Name("grid")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.RentalAdvancePaymentRequestId).Title("#").Filterable(false).Width(50);
                        columns.Bound(c => c.PlateNumber).Title("Plate/Serial Number").Width(150);
                        columns.ForeignKey(c => c.EmployeeId, (IEnumerable)ViewData["Employee"], "EmployeeId", "FullName").Title("Employee Name").Width(130);
                        columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["Supplier"], "ProcurementSupplierID", "Name").Title("Supplier Name").Width(130);
                        columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["BusinessUnit"], "Id", "Name").Title("Business Unit").Width(120);
                        columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").Title("Branch").Width(110);
                       // columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["GLPeriod"], "GLPeriodId", "Name").Title("Period").Width(110);
                        //columns.ForeignKey(c => c.GLFiscalYearId, (IEnumerable)ViewData["GlFiscalYear"], "GlFiscalYearId", "Name").Title("FiscalYear").Width(110);
                        //columns.Bound(c => c.DurationFrom).Title("Duration From").Width(100);
                        columns.Bound(c => c.AgreementStartDate).Format("{0:yyyy-MM-dd}").Title("Agreement Date").Width(120);
                        columns.Bound(c => c.ReasonofPayment).Title("Reason of Payment").Width(120);
                       // columns.Bound(c => c.AgreementStartDate).Title("Request Date").Width(100);
                        columns.Bound(c => c.Refference).Title("Refference").Width(100);
                        columns.Bound(c => c.TotalAmount).Title("Advance Amount").Width(100);
                        columns.Bound(c => c.Remark).Title("Remark").Width(75);
                        columns.Command(command => { command.Edit().UpdateText("Save").CancelText("Cancel").Text("Edit"); command.Destroy().Text("Delete"); }).Title("Action").Width(200);
                    })
                    .ToolBar(toolbar =>
                    {
                        toolbar.Create();
                    })
                    .Editable(editable =>
                    {
                        editable.Mode(GridEditMode.PopUp).
                        TemplateName("RentalPaymentRequestTemplate")
                        .Window(win => win.Title("Rental Advance Payment Request").Width(800));
                    })
                    .Pageable()
                    .Events(e => e.DetailExpand("onDetailExpand"))
                    .Events(e => e.DataBound("onDataBoundExternalPayment"))
                    .Filterable()
                    .Scrollable(s => s.Height(550))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Sort(sort => sort.Add(e => e.RentalAdvancePaymentRequestId).Descending())
                        .Model(model => model.Id(p => p.RentalAdvancePaymentRequestId))
                        .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
                        .Read(read => read.Action("RentalPaymentRequests_Read", "RentalAdvancePaymentRequest").Data("sendForgery"))
                        .Create(create => create.Action("RentalPaymentRequests_Create", "RentalAdvancePaymentRequest").Data("sendForgery"))
                        .Update(update => update.Action("RentalPaymentRequests_Update", "RentalAdvancePaymentRequest").Data("sendForgery"))
                        .Destroy(destroy => destroy.Action("RentalPaymentRequests_Destroy", "RentalAdvancePaymentRequest").Data("sendForgery"))
                    )
                    .ClientDetailTemplateId("rentalPaymentRequestDetailTemplate")
)
