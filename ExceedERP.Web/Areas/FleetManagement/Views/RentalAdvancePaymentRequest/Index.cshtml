<script>
    var supplierId;
    var branchId;

    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = this;

        var masterDataItem = masterGrid.dataItem(masterRow);
        supplierId = masterDataItem.ProcurementSupplierID;
        branchId = masterDataItem.BranchId;

    }
    function getSupplierAndBranchId() {

        return {
            supplierId: supplierId,/*$("#ProcurementSupplierID").val(),*/
            branchId: branchId/* $("#BranchId").val()*/
        };
    }
    function getProcurementSupplierID() {
        return {
            supplierId: supplierId
        };
    }
    function handleFleetNameChange() {
        $.ajax({
            type: "POST",
            url: '@Url.Action("", "FleetManagementDataProvider", new { area = "FleetManagement"})',
            data: { id: id },
            success: function (result) {
                //$('#PlateNo').data("kendoDropDownList").value(result.PlateNo);
                //$('#PlateNo').data("kendoDropDownList").trigger("change");
            },
            error: function (result) {
                console.log(result);
            }
        });
    }
    function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendforDepartmentApproval", "RentalAdvancePaymentRequest", new { area = "FleetManagement" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                var recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
    function getFiscalYear(){
        return { year: $("#GLFiscalYearId").val() };
    }
    function filterEmployees() {
        return {
            text: $("#EmployeeId").data("kendoDropDownList").filterInput.val(),
        }
    }
    var masterDataItem;
    var masterRow;
    var masterGrid;
    var codeid;
    var isDeptapproved;
    var isDeptSendForApproval;
    var supplierId;
    var branchId;
    function detailExpandMasterDepartment(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        supplierId = masterDataItem.ProcurementSupplierID;
        branchId = masterDataItem.BranchId;
        codeid = masterDataItem.PaymentRequestId;
        isDeptapproved = masterDataItem.IsDepartmentOnlineApproved;
        isDeptSendForApproval = masterDataItem.IsDepartmentSendForApproval;
    }
    function onDataBoundExternalPayment() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            var masterDataItem = grid.dataItem(this);
            $(this).find(".k-grid-reject").hide();
            if (masterDataItem.IsOnlineApproved == true || masterDataItem.IsSendForApproval==true) {
                $(this).find(".k-grid-edit").hide();
                $(this).find(".k-grid-delete").hide();
            }
            if (masterDataItem.IsSendForApproval == true && masterDataItem.IsOnlineApproved == false) {
                $(this).addClass("k-state-waiting-approval");
            }
            if (masterDataItem.IsOnlineApproved == false && masterDataItem.IsSendForApproval == false) {
                $(this).addClass("k-state-Rejected");
            }
            if (dataItem.IsOnlineApproved) {

                $(this).find(".k-grid-approve").hide();
                //$(this).find(".k-grid-reject").hide();

            }
            else if (dataItem.IsSendForApproval) {

                $(this).find(".k-grid-approve").show();
            }
            else {
                $(this).find(".k-grid-approve").hide();
            }

        });
    }
    function onDataBoundMasterDepartment(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsDepartmentOnlineApproved || gridData[i].IsDepartmentSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsDepartmentSendForApproval && !dataItem.IsDepartmentOnlineApproved) {
                row.css("background-color", "lightgreen");
            }
            if (!dataItem.IsDepartmentSendForApproval && !dataItem.IsDepartmentOnlineApproved) {
                row.css("background-color", "lightskyblue");
            }

            if (dataItem.IsBudgetApproved) {
                row.css("background-color", "gold");
            }

            if (dataItem.Paid) {
                row.css("background-color", "honeydew");
            }

            if (dataItem.IsVoid) {
                row.css("background-color", "slategray");
                row.css("color", "black");
            }
        }


    }
    function onDataBoundLineDepartment(e) {

        var detailGrid = "#" + e.sender.element[0].id;
        if (isDeptapproved || isDeptSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundValidationDepartment(e) {
        var detailGrid = "#" + e.sender.element[0].id;

        if (isDeptapproved || isDeptSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
        this.table.find(".k-grid-edit").hide();
    }

    function filterFleetForAdvancePayment() {
            return {
                Text: $("#FleetId").data("kendoDropDownList").filterInput.val(),
            }
        
    }
    function filterFleet() {
        return {
            supplierId: supplierId,
            branchId: branchId,
            equipmentNameId: $("#EquipmentNameId").val()
        };
    }
    function filterEquipmentNames() {
        var dropdownlist = $("#EquipmentNameId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentTypeId: $("#EquipmnetTypeId").val(),
            text: filterInput.val()
        };
    }
    function filterPlateNumber() {
        var dropdownlist = $("#EquipmentName").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentNameID: $("#EquipmentNameID").val(),
            search: filterInput.val()
        };
    }
    function filterCategory() {
        var dropdownlist = $("#EquipmnetTypeId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentIdentityId: $("#EquipmentCategoryId").val(),
            search: filterInput.val()
        };

    }
</script>

