<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
<script type="text/javascript">

    var IsApproved;
    var IsSendForApproved;
    var masterId;
    var equipmentMasterId;
     var fleetPlate; 

    function RejectPopUp(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#Equipment" + masterId).data("kendoGrid");

        var dataItem = masterGrid.dataItem(masterRow);
        equipmentMasterId = dataItem.ExternalRentedEquipmentId;
        fleetPlate = dataItem.AssetCode;
        IsApproved = dataItem.IsOnlineApproved;
        IsSendForApproval = dataItem.IsSendForApproval;

        var category = "";
        var lineitem = "";
        var index = 0;
        if (IsSendForApproval == false) {
            $.ajax({
                url: '@Url.Action("CheckListLog_Read", "CheckListLog")',

                data: { Id: equipmentMasterId, PlateNumber: fleetPlate },
                type: 'POST',
                cache: false,
                success: function (list) {
                    for (var i = 0 ; i < list.length; i++) {

                        lineitem += "    <div class='col-sm-12'>";
                        if (category != list[i].CategoryName) {

                            lineitem += "       <div class='col-sm-12'><h2 style='background-color:greenyellow'>" + list[i].CategoryName + " </h2></div>";
                            category = list[i].CategoryName;
                        }
                        lineitem += "<div class='col-sm-3'  >  <input type='hidden' name=model.CheckListViewModel[" + index + "].InspectionId  value=" + masterId + ">   <input type='hidden' name=model.CheckListViewModel[" + index + "].LineName  value=" + list[i].LineName + " '>     <input type='hidden' name=model.CheckListViewModel[" + index + "].LineCode  value=" + list[i].LineCode + " '>    <input type='hidden' name=model.CheckListViewModel[" + index + "].CategoryName  value=" + list[i].CategoryName + " '>  <label class='k-label' ><h4> " + list[i].LineCode + " - " + list[i].LineName + "</h4></label>  <div class='switch_box box_4'><div class='input_wrapper'>     <input type='checkbox' checked    name='model.CheckListViewModel[" + index + "].IsActive'  class='form-control'>   </div> </div>        </div>  ";
                        lineitem += "  <input type='text' name='model.CheckListViewModel[" + i + "].Remark' value='' class=' form-control'   style='padding: 5px;'>";


                        index++;

                        lineitem += " </div>";
                    } try {
                        document.getElementById("lines" + equipmentMasterId).innerHTML = lineitem;
                    } catch (err) {
                        console.log("error to inner " + err);
                    }
                }

            });
        }
        if (IsSendForApproval == true) {
            $.ajax({
                url: '@Url.Action("AnnualInspectionlogLast_Read", "AnnualEquipmentInventoryInspection")',

                data: { Id: masterId, PlateNumber: fleetPlate },
                type: 'POST',
                cache: false,
                success: function (list) {
                    for (var i = 0 ; i < list.length; i++) {


                        lineitem += "    <div class='col-sm-12'>";
                        if (category != list[i].CategoryName) {

                            lineitem += "       <div class='col-sm-12'><h2 style='background-color:greenyellow'>" + list[i].CategoryName + " </h2></div>";
                            category = list[i].CategoryName;
                        }
                        index++;

                        lineitem += " </div>";
                    }
                    try {
                        document.getElementById("approvedlines" + masterId).innerHTML = lineitem;
                    }
                    catch (Err)
                    { }
                }

            });
        }
    }
   
    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.RentToExternalID;
        IsApproved = masterDataItem.IsOnlineApproved;
        IsSendForApproved = masterDataItem.IsSendForApproval;
        var firstValidationgridName = "#Equipment" + masterId;
        if (IsSendForApproved == true)
        {
            $(".k-grid-top", firstValidationgridName).hide();
            $(".k-grid-delete", firstValidationgridName).remove();
    }
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsOnlineApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
            if (dataItem.IsSendForApproval == true || dataItem.IsOnlineApproved == true || IsSendForApproved == true) {
      
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove(); 
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {

            if ( IsApproved == true) {
                console.log("Approved ");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }


</script>

<script>
    function filterEquipmentCategories() {
        var dropdownlist = $("#EquipmentIdentityID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            search: filterInput.val()
        };
    }
    function filterEquipmentNames() {
        var dropdownlist = $("#EquipmentNameID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentTypeId: $("#EquipmentTypeID").val(),
            search: filterInput.val()
        };
    }
    function filterEquipmentTypes() {
        return {
            equipmentIdentityId: $("#EquipmentIdentityID").val()
        };
    }
    function filterEquipments() {
        return {
            equipmentTypeId: $("#EquipmentTypeID").val()
        };
       
    }
    function filterFleets() {
        return {
            equipmentNameId: $("#EquipmentNameID").val()
        };

    }

    function onChangeFleet()
    {
        $.ajax({
            url: '@Url.Action("GetFleetEquipmentById", "FleetManagementDataProvider")',
            data: { fleetId: this.value() },
            type: 'GET',
            cache: false,
            success: function (result) {
                $("#AssetCode").val(result.AssetCode).trigger("change");
                $("#EquipmentName").val(result.EquipmentName).trigger("change");
              


            }
        });

    }
</script>
