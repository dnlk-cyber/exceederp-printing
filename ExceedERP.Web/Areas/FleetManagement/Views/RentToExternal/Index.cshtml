@model ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentToExternal
 

<style>
    .lbl {
        position: relative;
        display: block;
        height: 40px;
        width: 64px;
        background: #898989;
        border-radius: 100px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .lbl:after {
            position: absolute;
            left: -2px;
            top: -3px;
            display: block;
            height: 40px;
            width: 54px;
            border-radius: 100px;
            background: #fff;
            box-shadow: 0px 3px 3px rgba(243, 245, 247, 0.05);
            content: '';
            transition: all 0.3s ease;
        }

        .lbl:active:after {
            transform: scale(1.15, 0.85);
        }

    .cbx:checked ~ label {
        background: #32a6f3;
    }

        .cbx:checked ~ label:after {
            left: 20px;
            background: #5a666e;
        }

    .cbx:disabled ~ label {
        background: #d5d5d5;
        pointer-events: none;
    }

        .cbx:disabled ~ label:after {
            background: #bcbdbc;
        }

    .container {
        position: absolute;
        top: 250px;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .demo {
        margin-bottom: 40px;
    }

    .hidden {
        display: none;
    }
</style>

<legend>Rent To External</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentToExternal>()
    .Name("grid")
    .Columns(columns =>
    {
        //columns.Bound(o => o.).Width(80);
        columns.Bound(o => o.ProjectLocation).Width(120);
        //columns.Bound(o => o.EquipmentName).Width(120);
        columns.Bound(o => o.NameBankBranch).Title("Company Name ").Width(100);
        columns.Bound(o => o.Quantity).Width(100);
        columns.Bound(o => o.UnitOfWorkMeasurement).Width(100);
        columns.Bound(o => o.AdvancePayment).Width(120);
        columns.Bound(o => o.From).Width(120);
        columns.Bound(o => o.To).Width(120);
        columns.Bound(e => e.Status).Width(100);

        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

    }).Events(ev =>
    {
        ev.DataBound("onDataBound");
    })
               .ToolBar(commands => commands.Create())
       .Editable(editable =>
       {
           editable.Window(w => w.Title("Rent To External"));
           editable.Mode(GridEditMode.PopUp).TemplateName("RentToExternalEditor");
           editable.DisplayDeleteConfirmation("Are You Sure To Remove Rent Information");
       })
         .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                                //.Groupable()
                                .Scrollable(h => h.Height(500))
                                .ClientDetailTemplateId("template")
                                .Events(ev => ev.DetailExpand("onDetailExpand"))
    .DataSource(dataSource => dataSource
        .Ajax()
        .Sort(sort => sort.Add(e => e.DateCreated).Descending())
        .ServerOperation(false)
                    .Model(model =>
                    {
                        model.Id(p => p.RentToExternalID);
                        model.Field(p => p.RentToExternalID).Editable(false);

                    }).Events(ev => ev
                                                          .Error("error_handler(\"grid\")")
                                                          .RequestStart("onRequestStart(\"grid\")")
                                                          .RequestEnd("onRequestEnd(\"grid\")"))
                    .Create(create => create.Action("RentOtherSuppliers_Create", "RentToExternal"))
                    .Read(read => read.Action("RentOtherSuppliers_Read", "RentToExternal"))
                    .Update(read => read.Action("RentOtherSuppliers_Update", "RentToExternal"))
                    .Destroy(read => read.Action("RentOtherSuppliers_Destroy", "RentToExternal"))
  )
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabStrip_#=RentToExternalID#")
          .SelectedIndex(0)
          .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
          .Items(items =>
            {
                  items.Add().Text("Detail").Content(
                        @<text>

                            <div class="box">

                                <div class="box-col">
                                    # if (IsSendForApproval == false || IsSendForApproval == "false")
                                    {#

                                    <a href='@Url.Action("RentOtherSuppliers_SendForOnlineApproval", "RentOtherSuppliersApproval")/?EId=#=RentToExternalID#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                    # }#
                                </div>
                            </div> 
                            <div class="row">
                                <div class="col-md-1">
                                </div>
                                <div class="col-md-6" style="margin-top:20px;">

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CreatedBy):<span>#=CreatedBy#</span>

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.DateCreated):<span>#=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #</span>

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ModifiedBy):<span>#=ModifiedBy#</span>

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.LastModified):<span>#=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy')#</span>

                                    </div>



                                </div>
                            </div>



                        </text>


            );

                items.Add().Text(" Equipments ").Content(@<text>
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.ExternalRentedEquipment>()
              .Name("Equipment#=RentToExternalID#")
      .Columns(columns =>
      {
          columns.ForeignKey(e => e.EquipmentIdentityID, (System.Collections.IEnumerable)ViewData["EquipmentCategories"], "Id", "Name").EditorTemplateName("EquipmentCategoryEditor").Title("Equipment Category").Width(140);
          columns.ForeignKey(e => e.EquipmentTypeID, (System.Collections.IEnumerable)ViewData["EquipmentTypes"], "Id", "Name").EditorTemplateName("EquipmentTypeEditor").Title("Equipment Subcategory").Width(140);
          columns.ForeignKey(e => e.EquipmentNameID, (System.Collections.IEnumerable)ViewData["EquipmentNames"], "Id", "Name").EditorTemplateName("EquipmentNameEditor").Title("Equipment Name").Width(140);
          columns.ForeignKey(e => e.FleetId, (System.Collections.IEnumerable)ViewData["Fleets"], "Id", "Name").EditorTemplateName("FleetEditor").Title("Plate No").Width(140);
          columns.Bound(e => e.AssetCode).Title("Tag No / Serial No").Width(100);
          columns.Bound(e => e.EquipmentName).Title("Fleet Name").Width(100);
          columns.Bound(e => e.RentedRate).Width(100);
          columns.Bound(e => e.OperatorName).Width(100);
          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();

          }).Width(200);

      })
                  .Events(ev =>
                  {
                      ev.DataBound("onDataBound"); ev.DetailExpand("RejectPopUp");
                  })
      .ToolBar(commands => commands.Create())
      .Editable(editable =>
      {
          editable.Mode(GridEditMode.InLine);//.TemplateName("EquipmentEditor");
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Equipment");
      })
             .HtmlAttributes(new { style = "height: 420px;" })
                                   .Pageable(pageable => pageable
                                                    .Input(true)
                                                    .Numeric(false)
                                                    .Refresh(true)
                                                    .PageSizes(true)
                                                    .ButtonCount(5))
                                                            .ClientDetailTemplateId("templateEquipment")
                                                             .Scrollable(h => h.Height(400))
 .DataSource(dataSource => dataSource
          .Ajax()
          .ServerOperation(false)
               .PageSize(6)
          .Model(model =>
          {
              model.Id(p => p.ExternalRentedEquipmentId);
              //   model.Field(p => p.AssetCode).Editable(true);
              model.Field(p => p.RentedRate).Editable(false);
              model.Field(p => p.OperatorName).Editable(false);
              model.Field(p => p.Status).Editable(false);
          }
              ).Events(ev => ev
                                          .Error("error_handler(\"Equipment#=RentToExternalID#\")")
                                          .RequestStart("onRequestStart(\"Equipment#=RentToExternalID#\")")
                                          .RequestEnd("onRequestEnd(\"Equipment#=RentToExternalID#\")"))
                                          .Create(update => update.Action("ExternalRentedEquipments_Create", "ToExternalRentedEquipment", new { Id = "#=RentToExternalID#" }))
                                          .Read(read => read.Action("ExternalRentedEquipments_Read", "ToExternalRentedEquipment", new { Id = "#=RentToExternalID#" }))
                                  .Update(update => update.Action("ExternalRentedEquipments_Update", "ToExternalRentedEquipment"))
                                  .Destroy(update => update.Action("ExternalRentedEquipments_Destroy", "ToExternalRentedEquipment"))

      )

    .ToClientTemplate())

                </text>
                );
                items.Add().Text(" Approval").Content(@<text>
              
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentToExternalApproval>()
                                                                                        .Name("RentOtherSuppliersApproval#=RentToExternalID#")
                        .Columns(columns =>
                        {
                            columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                            columns.Bound(o => o.Remark).Width(200);
                            columns.Bound(c => c.CreatedBy).Width(150);
                            columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                            columns.Command(command => { command.Edit(); }).Width(250);

                        }).Events(ev =>
                        {
                            ev.DataBound("approveonDataBound");
                        })
                             .Editable(editable => editable.Mode(GridEditMode.InLine))
                                       .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(5)
                                                       .Model(model =>
                              {
                                  model.Id(p => p.RentToExternalApprovalID);
                                  model.Field(p => p.CreatedBy).Editable(false);
                                  model.Field(p => p.DateCreated).Editable(false);
                              })
                                 .Events(ev => ev
                                 .Error("error_handler(\"RentOtherSuppliersApproval#=RentToExternalID#\")")
                                 .RequestStart("onRequestStart(\"RentOtherSuppliersApproval#=RentToExternalID#\")")
                                 .RequestEnd("onRequestEnd(\"RentOtherSuppliersApproval#=RentToExternalID#\")"))
                                                                                                           .Create(update => update.Action("RentOtherSuppliers_Approve", "RentOtherSuppliersApproval", new { EId = "#=RentToExternalID#" }))
                                                                                     .Read(read => read.Action("RentOtherSuppliersApproval_Read", "RentOtherSuppliersApproval", new { EId = "#=RentToExternalID#" }))
                                                                                   .Update(update => update.Action("RentOtherSuppliers_Approve", "RentOtherSuppliersApproval"))


                                                      )
                                               .ToClientTemplate())
                </text>
                );
            })
                                                                                                                                                                                                                                                                                                            .ToClientTemplate())
</script>


<script id="templateEquipment" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabStripEquipment_#=ExternalRentedEquipmentId#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
                items.Add().Text("Check List").Content(@<text>



                    <div class="form-group">
                        # if (IsSendForApproval == true || IsOnlineApproved == true)
                        {#

                        <div style=" padding:10px" id="approvedlines#=ExternalRentedEquipmentId #"></div>
                        # }

                        else if (IsSendForApproval == false)
                        {#
