@model ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentToExternal
<script>
        function onUploadSuccess(e) {

        }

    function checkFileType(e) {
        var files = e.files;

        $.each(files, function () {

            if (this.extension.toLowerCase() === ".pdf" || this.extension.toLowerCase() === ".doc" || this.extension.toLowerCase() === ".docx") {

            } else {
                alert("Only .pdf or .docx or .doc files can be uploaded!");
                e.preventDefault();
            }

        });
    }

    function filterEquipmentIdentity() {
        var dropdownlist = $("#EquipmentTypeID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            EquipmentIdentityID: $("#EquipmentIdentityID").val(),
            Search: filterInput.val()
        };

    }
    function filterByType() {
        var dropdownlist = $("#EquipmentName").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            EquipmentTypeId: $("#EquipmentTypeID").val(),
            Search: filterInput.val()
        };

    }

</script>

