                <li><label>Operator Monthly Salary:</label> <span>#=OperatorDriverMonthlySalary#</span></li>
                <li><label>Depreciation:</label> <span>#=Depreciation#</span></li>
                <li><label>Insurance:</label> <span>#=Insurance#</span></li>
                <li><label>Property Tax:</label> <span>#=PropertyTax#</span></li>
            </ul>
        </div>
