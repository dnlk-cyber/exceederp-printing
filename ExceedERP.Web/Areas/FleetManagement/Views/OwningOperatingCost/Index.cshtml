<legend>Owning and Operating Cost</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.OwningandOperatingCost>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Model).Width(100);
          columns.Bound(c => c.OwnerShipPeriod).Width(120);
          columns.Bound(c => c.EstimatedUsage).Width(120);
          columns.Bound(c => c.OwnerShipUsage).Width(120);
          columns.Bound(c => c.DeliveryPrice).Width(100);
          columns.Bound(c => c.RentalRateWithFuel).Width(140).Title("Hourly/Rental cost");
          columns.Bound(c => c.MaintenanceRepairCost).Width(120).Title("Maintenance cost ");
          columns.Bound(c => c.TyreReplacementCost).Width(140);
          columns.Bound(c => c.TotalOperatingWeight).Width(140);
          columns.Bound(c => c.Remark).Title("Condtion").Width(100);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(160);
      })
      .ToolBar(toolbar => {
          toolbar.Create();
      })
          .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("OwningOperatingCostEditor"))
         .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                          .Input(true)
                          .Numeric(false)
                          .Refresh(true)
                          .PageSizes(true)
                          .ButtonCount(5))
                          .Scrollable()
                          .Sortable()
                          .Filterable()
                          .Scrollable(h => h.Height(500))
                          .ClientDetailTemplateId("template")
                          .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.OwningandOperatingCostId))
          .Read(read => read.Action("OwningandOperatingCosts_Read", "OwningOperatingCost").Data("sendForgery"))
          .Create(create => create.Action("OwningandOperatingCosts_Create", "OwningOperatingCost").Data("sendForgery"))
          .Update(update => update.Action("OwningandOperatingCosts_Update", "OwningOperatingCost").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("OwningandOperatingCosts_Destroy", "OwningOperatingCost").Data("sendForgery"))
      )
)

