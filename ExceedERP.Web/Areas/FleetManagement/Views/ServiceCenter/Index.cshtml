                } catch (err) {
                    console.log("error to  approve inner " + err);
                }
            }
        });

        $.ajax({
            url: '@Url.Action("GetJobStatus", "ServiceCenter")',

            data: { JobId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

                if (r != "Pending") {
                    $(linegridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", linegridName).hide();
                    $(".k-grid-edit", linegridName).hide();
                    $(".k-grid-delete", linegridName).hide();


                    $(".k-grid-top", firstValidationgridName).hide();
                    $(".k-grid-edit", firstValidationgridName).hide();
                    $(".k-grid-delete", firstValidationgridName).hide();
                    $(".k-grid-top", SecondValidationgridName).hide();
                    $(".k-grid-edit", SecondValidationgridName).hide();
                    $(".k-grid-delete", SecondValidationgridName).hide();

               
                }

            }

        });



        $("#CostChart" + masterId).kendoChart({
            title: {
                text: " Job Cost Summary " 
            },
            legend: {
                position: "right"
            }, theme: "material",
            seriesDefaults: {
                labels: {
                    template: " ",
                    position: "outsideEnd",
                    visible: true,
                    background: "transparent"
                }
            },
            series: [{
                type: "pie",
                data: [{
                    category: "Spare Part",
                    value: masterDataItem.SpareCost
                }, {
                    category: "Tyre",
                    value: masterDataItem.TyreCost
                }, {
                    category: "Battery",
                    value: masterDataItem.BattreyCost
                }, {
                    category: "Salvage",
                    value: masterDataItem.SalvageCost
                }, {
                    category: "Oil & Lubricant",
                    value: masterDataItem.OilLubricantCost
                }, {
                    category: "Other",
                    value: masterDataItem.OtherCost
                }, {
                    category: "Component",
                    value: masterDataItem.ComponentCost
                }, {
                    category: "Labour",
                    value: masterDataItem.LabourCost
                }]
            }],
            tooltip: {
                visible: true,
                template: "#= category # - #= kendo.format('{0:P}', percentage) #"
            }
        });


        $("#EfficencyGauge" + masterId).kendoRadialGauge({
            title: {
                text: " Efficency"
            },
            pointer: {
                value: kendo.toString(masterDataItem.Efficiency, 'N2')
            },
            theme: "bootstrap",
            scale: {
                minorUnit: 5,
                startAngle: -30,
                endAngle: 210,
                max: 100,
                labels: {
                    position:  "inside"
                },
                ranges: [
                    {
                        from: 0,
                        to: 30,
                        color: "#ffc700"
                    }, {
                        from: 30,
                        to: 60,
                        color: "#ff7a00"
                    }, {
                        from: 60,
                        to: 100,
                        color: "#c20000"
                    }
                ]
            }
        });
    


    }



</script>


@helper  AssignCrew()
{

    @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetMaintenance.ServiceCrew>()
                                             .Name("ServiceCrewAssigngrid_#=JobOrderID#")
                             .Columns(columns =>
                             {
                                 columns.Bound(o => o.ServiceName).Title("Crew Name").EditorTemplateName("CrewEditor").Width(80);
                                 columns.Bound(o => o.ServiceCrewID).Hidden();
                                
                                 columns.Bound(o => o.IsActive).ClientTemplate("<input type='checkbox' \\#= IsActive? checked='checked': checked='' \\# class='checkbox'  />").Width(100);
                                 columns.Bound(o => o.ActivatedDate).Width(100);
                                 columns.Command(command =>
                                 {
                                 }).Width(250);
                             }).ToolBar(toolbar => toolbar.Template(@<text>
 
    

                                @Html.Kendo().Button().Name("AssignCrewbtn_#=JobOrderID#").Content("Save Change").Events(events => events.Click("AssignCrews")).Enable(true).ToClientTemplate()
                           
      </text>))

                                                                        .Editable(editable => editable.Mode(GridEditMode.InLine))

                                                                                     .Sortable(sortable =>
                                                                                     {
                                                                                         sortable.SortMode(GridSortMode.SingleColumn);
                                                                                     })
                                                                                     .Filterable()
                                                                                     .Scrollable()
                                                                          .Events(events => events.DataBound("AssignCrewsDatabound"))

                                                                                     .DataSource(dataSource => dataSource
                                                                              .Ajax()
                                                                    .Group(groups => groups.Add(p => p.IsActive))
                                                                    .PageSize(20)
                                                              .Model(model =>
                                                                          {
                                                                              model.Id(p => p.ServiceCrewID);
                                                                              model.Field(p => p.LabourCost).Editable(false);
                                                                          }
                                                                                              ).Events(ev => ev
                                                                                                                                                         .Error("error_handler(\"ServiceCrewAssigngrid_#=JobOrderID#\")")
                                                                                                                                                         .RequestStart("onRequestStart(\"ServiceCrewAssigngrid_#=JobOrderID#\")")
                                                                                                                                                         .RequestEnd("onRequestEnd(\"ServiceCrewAssigngrid_#=JobOrderID#\")"))
                                                                                          .Create(c => c.Action("Crew_Update", "ServiceCrew", new { cserviceID = "#=JobOrderID#" }).Data("sendForgery"))
                                                                                                                                                    .Read(read => read.Action("ServiceCrewByService", "ServiceCrew", new { Id = "#=JobOrderID#" }).Data("sendForgery"))
                                                                                                                                                                                                        .Update(destroy => destroy.Action("ServiceCrew_Update", "ServiceCrew", new { Id = "#=JobOrderID#" }).Data("sendForgery"))
                                                                                                                                               )
                                                                                       .Pageable()
                                                                                 .ToClientTemplate())
}


