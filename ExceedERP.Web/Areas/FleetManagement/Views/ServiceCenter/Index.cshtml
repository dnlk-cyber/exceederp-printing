            cache: false,
            success: function (list) {
                for (var i = 0; i < list.length; i++) {


                    Approvedlineitem += "    <div class='col-sm-4'>";
                    if (list[i].IsActive == true) {
                        Approvedlineitem +=
                            "       <div class='col-sm-4'><h2 style='background-color:greenyellow'>" +
                            list[i].Name +
                            " </h2></div>";
                    } else {
                        Approvedlineitem += "       <div class='col-sm-4'><h2 style='background-color:red'>" +
                            list[i].Name +
                            " </h2></div>";
                    }
                    index++;

                    Approvedlineitem += " </div>";
                }
                try {
                    document.getElementById("approvedlines" + masterId).innerHTML = Approvedlineitem;
                } catch (err) {
                    console.log("error to  approve inner " + err);
                }
            }

        });

        $.ajax({
            url: '@Url.Action("MaintenaceCheckAccessory_Read", "CheckListLog")',

