<link href="~/Scripts/Exceed/dist/css/style.css" rel="stylesheet" />
<style>
    .switch {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
    }

        .switch input {
            display: none;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        -webkit-transition: .4s;
        transition: .4s;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            -webkit-transition: .4s;
            transition: .4s;
        }

    input:checked + .slider {
        background-color: #2196F3;
    }

    input:focus + .slider {
        box-shadow: 0 0 1px #2196F3;
    }

    input:checked + .slider:before {
        -webkit-transform: translateX(26px);
        -ms-transform: translateX(26px);
        transform: translateX(26px);
    }

    /* Rounded sliders */
    .slider.round {
        border-radius: 34px;
    }

        .slider.round:before {
            border-radius: 50%;
        }
</style>

<script>

    function MaintenacePettyCash(){
        popup = window.open('/FleetManagement/ServiceCenter/RequistionResult?JobOrderId=' + JobNum , 'PoP_Up', 'directories=no,titlebar=no,toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=324,height=268');
        popup.focus();
        return false;
    }

</script>


<legend>Service Center</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetMaintenance.JobOrder>()
        .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.Num).Width(80);
        columns.Bound(e => e.EquipmentName).Width(160);
        columns.Bound(e => e.ProjectName).Title("Location").Width(140);
        columns.Bound(e => e.MaintenanceCenter).Width(200);
        columns.Bound(e => e.Status).Width(200); ;


    })

       .Editable(editable =>
        {
            editable.Mode(GridEditMode.PopUp).TemplateName("JobOrderEditor");
            editable.DisplayDeleteConfirmation("Are You Sure To Send For Approval");
        })
             .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                                 .Scrollable(h => h.Height(500))
        .ClientDetailTemplateId("template")
              .Events(ev => ev.DetailExpand("MasterOnExpand"))
              .DataSource(dataSource => dataSource
            .Ajax()
            .Sort(x => x.Add(s => s.Num).Descending())
            .PageSize(6)
            .Model(model =>
                {
                    model.Id(p => p.JobOrderID);
                    model.Field(p => p.JobOrderID).Editable(false);
                }
                ).Events(ev => ev
                                                            .Error("error_handler(\"grid\")")
                                                            .RequestStart("onRequestStart(\"grid\")")
                                                            .RequestEnd("onRequestEnd(\"grid\")"))
                    .Create(update => update.Action("JobOrder_Create", "JobOrder").Data("sendForgery"))
                                .Read(read => read.Action("ServiceCenter_Read", "ServiceCenter").Data("sendForgery"))
                        .Update(update => update.Action("JobOrder_Update", "ServiceCenter").Data("sendForgery"))
                                .Destroy(update => update.Action("JobOrder_Refer", "ServiceCenter").Data("sendForgery"))

        )
   .Events(events => events.DataBound("dataBound"))
)

