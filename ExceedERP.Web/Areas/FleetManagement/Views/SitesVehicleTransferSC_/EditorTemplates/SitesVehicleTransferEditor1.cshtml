@model  ExceedERP.Core.Domain.FleetManagement.FleetResource.SitesVehicleTransfer

<script>
     function filterEquipmentIdentity() {

         var dropdownlist = $("#EquipmentTypeID").data("kendoDropDownList");
         var filterInput = dropdownlist.filterInput;

         return {
             equipmentIdentityId: $("#EquipmentIdentityID").val(),
             Search: filterInput.val()
         };

     }

     function filterEquipment() {
         var dropdownlist = $("#FleetsID").data("kendoDropDownList");
         var filterInput = dropdownlist.filterInput;

         return {
             equipmentNameId: $("#EquipmentNameID").val(),
             search: filterInput.val()
         };
     }
     function filterByType() {
         var dropdownlist = $("#EquipmentNameID").data("kendoDropDownList");
         var filterInput = dropdownlist.filterInput;

         return {
             equipmentTypeId: $("#EquipmentTypeID").val(),
             search: filterInput.val()
         };

     }
</script>

<div class="demo-section k-content">
    <form>


        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-sm-3">

                @(Html.Kendo().DropDownList().Name("EquipmentIdentityID")
                         .DataTextField("Name")
                         .DataValueField("Id").Filter(FilterType.Contains)
                         .OptionLabel("Select Equipment Category")
                         .HtmlAttributes(new { style = "width:100%" })
                         .DataSource(d => d.Read(r => r.Action("GetEquipmentIdentities", "FleetManagementDataProvider").Data("sendForgery"))
                         .ServerFiltering(false)))

            </div>
            <div class="col-sm-3">
                <div class="form-group">

                    @(Html.Kendo().DropDownList().Name("EquipmentTypeID")
                           .DataTextField("Name")
                           .DataValueField("Id")
                           .OptionLabel("Select Equipment Type")
                           .Filter(FilterType.Contains)
                           .HtmlAttributes(new { style = "width:100%" })
                           .DataSource(d =>
                           {
                                  d.Read(r =>
                              {
                                  r.Action("GetEquipmentTypes", "FleetManagementDataProvider")
                                          .Data("filterEquipmentIdentity");
                                           })
                       .ServerFiltering(true);
                                                 })
                                           .Enable(false)
                                           .AutoBind(false)
                                           .CascadeFrom("EquipmentIdentityID")
                    )



                </div>
            </div>
            <div class="col-sm-3">
                <div class="form-group">

                    @(Html.Kendo().DropDownList().Name("EquipmentNameID")
                                                        .AutoBind(false)
                                                        .Enable(false)
                                                        .DataTextField("Name")
                                                          .DataValueField("Id")
                                                          .Filter(FilterType.Contains)
                                                          .OptionLabel("Select")
                                                        .DataSource(d =>
                                                        d.Read(r => r.Action("GetEquipmentNames", "FleetManagementDataProvider").Data("sendForgery")
                                                        .Data("filterByType")).ServerFiltering(true))
                                                        .CascadeFrom("EquipmentTypeID"))






                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">

                        @Html.LabelFor(model => model.FleetsID)
                        @(Html.Kendo().DropDownListFor(model => model.FleetsID).Name("FleetsID")
                                      .DataTextField("PlateNumber")
                                      .DataValueField("FleetsID").OptionLabel(" Select ")
                                      .Filter(FilterType.Contains)
                                      .DataSource(d => d.Read(r => r.Action("FleetsDDBind", "FleetManagementDataProvider").Data("sendForgery")
                                      .Data("filterEquipment"))
                                      .ServerFiltering(true))
                                      .Events(e => e.Change("BindIntialSite"))
                                      .CascadeFrom("EquipmentNameID"))

                    </div>

                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.InitialSite)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.InitialSite).Enable(false)

                        @Html.ValidationMessageFor(model => model.InitialSite)
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.DestinationSite)
                    </div>
                    <div>
                        @(Html.Kendo().DropDownListFor(model => model.DestinationSite)
                         .DataTextField("Name")
                         .DataValueField("Name").OptionLabel(" Select")
                         .DataSource(d => d.Read(r => r.Action("BranchDDBind", "Branch").Data("sendForgery"))))
                    </div>
                </div>
            </div>


        </div>
        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.StartingDate)
                    </div>
                    <div>
                        @Html.Kendo().DatePickerFor(model => model.StartingDate)
                        @Html.ValidationMessageFor(model => model.StartingDate)
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.ToDate)
                    </div>
                    <div>
                        @Html.Kendo().DatePickerFor(model => model.ToDate)
                        @Html.ValidationMessageFor(model => model.ToDate)
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.Description)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.Description)
                        @Html.ValidationMessageFor(model => model.Description)
                    </div>
                </div>
            </div>



        </div>


        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.BatteryStatus)
                    </div>
                    <div>
                        @Html.EnumDropDownListFor(model => model.BatteryStatus)
                        @Html.ValidationMessageFor(model => model.BatteryStatus)
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.BatteryQuantity)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.BatteryQuantity)
                        @Html.ValidationMessageFor(model => model.BatteryQuantity)
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.BatteryAmpere)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.BatteryAmpere)
                        @Html.ValidationMessageFor(model => model.BatteryAmpere)
                    </div>
                </div>
            </div>



        </div>

        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.EquipmentCondition)
                    </div>
                    <div>
                        @Html.EnumDropDownListFor(model => model.EquipmentCondition)
                        @Html.ValidationMessageFor(model => model.EquipmentCondition)
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.FuelAmount)
                    </div>
                    <div>
                        @Html.EnumDropDownListFor(model => model.FuelAmount)
                        @Html.ValidationMessageFor(model => model.FuelAmount)
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.Hydrolic)
                    </div>
                    <div>
                        @Html.EnumDropDownListFor(model => model.Hydrolic)
                        @Html.ValidationMessageFor(model => model.Hydrolic)
                    </div>
                </div>
            </div>



        </div>

        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.TransferMode)
                    </div>
                    <div>
                        @Html.EnumDropDownListFor(model => model.TransferMode)
                        @Html.ValidationMessageFor(model => model.TransferMode)
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.TransferedOperator)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.TransferedOperator)
                        @Html.ValidationMessageFor(model => model.TransferedOperator)
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.LoadedPlateNo)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.LoadedPlateNo)
                        @Html.ValidationMessageFor(model => model.LoadedPlateNo)
                    </div>
                </div>
            </div>


        </div>

        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        Odometer
                    </div>
                    <div>
                        @(Html.Kendo().TextBoxFor(x => x).Name("Odometer").Enable(true))

                    </div>
                </div>
            </div>



            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.TransferReason)
                    </div>
                    <div>
                        @Html.TextBoxFor(model => model.TransferReason)
                        @Html.ValidationMessageFor(model => model.TransferReason)
                    </div>
                </div>

            </div>
        </div>
        </form>
</div>

