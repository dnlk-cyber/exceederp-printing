<script>
    function filterEquipmentIdentity() {
        return {
            EquipmentIdentityID: $("#EquipmentIdentityID").val()
        };
    }
    function onUploadSuccess(e) {

    }

    function checkFileTypephoto(e) {
        var files = e.files;

        $.each(files, function () {

            if (this.extension.toLowerCase() === ".png" || this.extension.toLowerCase() === ".jpg" || this.extension.toLowerCase() === ".jpeag") {

            } else {
                alert("Only .jpg or .png  files can be uploaded!");
                e.preventDefault();
            }

        });
    }
    function checkFileTypeAttachment(e) {
        var files = e.files;

        $.each(files, function () {

            if (this.extension.toLowerCase() === ".pdf" || this.extension.toLowerCase() === ".doc" || this.extension.toLowerCase() === ".docx") {

            } else {
                alert("Only .pdf , .docx or .doc  files can be uploaded!");
                e.preventDefault();
            }

        });
    }


</script>
