
<legend>Daily Care Detail</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetMaintenance.DailyCareDetailLog>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.DailyCareCategoryId);
        columns.Bound(c => c.Description);
        columns.Bound(c => c.IsActive);
        columns.Bound(c => c.DateCreated);
        columns.Bound(c => c.LastModified);
        columns.Bound(c => c.CreatedBy);
        columns.Bound(c => c.ModifiedBy);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.DailyCareDetailLogId))
          .Read(read => read.Action("DailyCareDetailLogs_Read", "DailyCareDetailLog").Data("sendForgery"))
          .Create(create => create.Action("DailyCareDetailLogs_Create", "DailyCareDetailLog").Data("sendForgery"))
          .Update(update => update.Action("DailyCareDetailLogs_Update", "DailyCareDetailLog").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("DailyCareDetailLogs_Destroy", "DailyCareDetailLog").Data("sendForgery"))
      )
)
