@{
    ViewBag.Title = "Equipment Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>     Equipment Type </legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.EquipmentType>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.ForeignKey(e => e.EquipmentIdentityID, (System.Collections.IEnumerable)ViewData["EquipmentIdentity"], "EquipmentIdentityId", "EquipmentCategoryName").EditorTemplateName("EquipmentTypeEditor").Width(140);

        columns.Bound(e => e.EquipmentTypeName).Width(140);
        columns.ForeignKey(c => c.FixedAssetCategoryID, (System.Collections.IEnumerable)ViewData["AssetCategory"], "FixedAssetCategoryID", "CategoryName").EditorTemplateName("FixedAssetCategoryEditor").Width(140);
        columns.Bound(e => e.Description).Width(140);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

    })
              .ToolBar(commands => commands.Create())
         .Editable(editable =>
         {
             editable.Mode(GridEditMode.InLine);
             editable.DisplayDeleteConfirmation("Are You Sure To Remove Equipment Type");
         }).HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Scrollable(h => h.Height(500))
    .DataSource(dataSource => dataSource
        .Ajax()
        .ServerOperation(false)
        .Model(model =>
              {
                  model.Id(p => p.EquipmentTypeID);

                  model.Field(p => p.EquipmentTypeID).Editable(false);

              }).Events(ev => ev
                                    .Error("error_handler(\"grid\")")
                                    .RequestStart("onRequestStart(\"grid\")")
                                    .RequestEnd("onRequestEnd(\"grid\")"))
                        .Create(update => update.Action("EquipmentType_Create", "EquipmentType"))
                        .Read(read => read.Action("EquipmentType_Read", "EquipmentType"))
                        .Update(update => update.Action("EquipmentType_Update", "EquipmentType"))
                        .Destroy(update => update.Action("EquipmentType_Destroy", "EquipmentType"))
  )
)

