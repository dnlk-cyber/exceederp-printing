@using System.Collections
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@model  ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.WagonDrillTimesheet
@using ExceedERP.Helpers.Common
@Html.HiddenFor(model => model.WagonDrillTimesheetId)

<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            @Html.Label("Equipment Name", htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @(Html.Kendo().DropDownListFor(model => model.FleetsID)
                                                       .ValuePrimitive(true)
                                                       .OptionLabel("Select Equipment...")
                                                       .DataTextField("PlateNumber")
                                                       .DataValueField("FleetsID")
                                                       .Filter("contains")
                                                       .MinLength(2)
                                                       .DataSource(dataSource =>
                                                       {
                                                           dataSource.Read(read => read.Action("GetFleet", "FleetManagementDataProvider", new { area = "FleetManagement" }))
                                                               .ServerFiltering(false);
                                                       }).HtmlAttributes(new { style = "width:100%" }).Enable(false)
                )
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.ProcurementSupplierID, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @(Html.Kendo().DropDownListFor(model => model.ProcurementSupplierID)
                                   .ValuePrimitive(true)
                                   .OptionLabel("Select Supplier...")
                                   .DataTextField("Name")
                                   .DataValueField("Id")
                                   .Filter("contains")
                                   .DataSource(dataSource =>
                                   {
                                       dataSource.Read(read => read.Action("GetSuppliers", "FleetManagementDataProvider", new { area = "FleetManagement" }))
                                       .ServerFiltering(false);
                                   }).HtmlAttributes(new { style = "width:100%" }).Enable(false)
                )
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.IdleRateHour, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().TextBoxFor(model => model.IdleRateHour).HtmlAttributes(new { style = "width:100%" }).Enable(false)
            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.WorkItem, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().TextBoxFor(model => model.WorkItem).HtmlAttributes(new { style = "width:100%" }).Enable(false)
            </div>
        </div>
    </div>

</div>


