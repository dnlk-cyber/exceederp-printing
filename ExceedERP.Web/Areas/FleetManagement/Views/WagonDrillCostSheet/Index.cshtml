


<legend>Wagon Drill Cost Sheet</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.WagonDrillTimesheet>()
                    .Name("grid")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.WagonDrillTimesheetId).Title("#").Width(70);
                        columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["fleet"], "FleetsID", "EquipmentName").Title("Equipment Name").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
                        columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["ProcurementSupplier"], "ProcurementSupplierID", "Name").Title("Supplier Name").Width(100);
                        columns.Bound(c => c.WorkItem).Width(100);
                        columns.Bound(c => c.OperationNetWorkingHour).Width(120);
                        columns.Bound(c => c.Date).Width(80);
                        columns.Bound(c => c.OperationDrilledHoleDepth).Width(145);
                        columns.Bound(c => c.NumberOfHolesDrilled).Width(120);
                        columns.Bound(c => c.CostSheetStatus).Width(120);
                       
                        columns.Command(command => { command.Edit().UpdateText("save").CancelText("Cancel").Text("Edit"); }).Title("Action").Width(200);
                    })
                    
                    .Editable(editable => editable.Mode(GridEditMode.PopUp)
                    .TemplateName("WagonDrillCostSheetTemplate")
                    .Window(win => win.Title("Wagon Drill Cost Sheet").Width(800)))
                    .Pageable()
                    .Events(e => e.DataBound("dataBound"))
                    .Events(e => e.DetailExpand("onDetailExpand"))
                    .Filterable()
                    .Scrollable(s => s.Height(550))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Sort(sort => sort.Add(e => e.WagonDrillTimesheetId).Descending())
                        .Model(model => model.Id(p => p.WagonDrillTimesheetId))
                        .Events(ev => ev
                                     .Error("error_handler(\"grid\")")
                                     .RequestStart("onRequestStart(\"grid\")")
                                     .RequestEnd("onRequestEnd(\"grid\")"))
                        .Read(read => read.Action("WagonDrillCostSheet_Read", "WagonDrillCostSheet"))
                        
                        .Update(update => update.Action("WagonDrillCostSheet_Update", "WagonDrillCostSheet"))
                        
                    ).ClientDetailTemplateId("template")
)


<script id="template" type="text/kendo-tmpl">

    @(Html.Kendo().TabStrip()
                                                           .Name("tabStrip_#=WagonDrillTimesheetId#")
                                                           .SelectedIndex(0)
                                                           .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                                                           .Items(items =>
                                                           {

                                                               items.Add().Text("Detail").Content(
                                                                    @<text>
                                                                        <legend>Detail</legend>
                                                                        <div class="box">
                                                                            <div class="box-col">

                                                                                # if (CostSheetSendForAproval == false)
                                                                                {#

                                                                                <a onclick='return sendForApproval("#=WagonDrillTimesheetId#")' href=' \#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                                                                # }#
                                                                            </div>
                                                                        </div>
                                                                        <div class="row">
                                                                            <div class="col-md-1">
                                                                            </div>
                                                                            <div class="col-md-6" style="margin-top:20px;">
                                                                                <div class="form-group">
                                                                                    <label>Status</label>: <span>#=CostSheetStatus#</span>
                                                                                </div>
                                                                                <div class="form-group">
                                                                                    <label>Created By</label>: <span>#=TimeSheetApprovedBy#</span>
                                                                                </div>
                                                                                <div class="form-group">
                                                                                    <label>Date Created</label>: <span>#=kendo.toString(kendo.parseDate(TimeSheetApprovedDate), 'dd/MM/yyyy') #</span>
                                                                                </div>
                                                                                <div class="form-group">
                                                                                    <label>Approved By</label>: <span>#=CostSheetApprovedBy#</span>
                                                                                </div>
                                                                                <div class="form-group">
                                                                                    <label>Approved Date</label>: <span>#=kendo.toString(kendo.parseDate(CostSheetApprovedDate), 'dd/MM/yyyy')#</span>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                    </text>
                                                                                                       ); items.Add().Text("Approval").Content(@<text>

                                                                                                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.TimeSheetApprovalNew>()
                                                                                                                                                    .Name("CostSheetApproval#=WagonDrillTimesheetId#")
                                                                                                                                                    .Columns(columns =>
                                                                                                                                                    {
                                                                                                                                                             columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                                                                                                                                                             columns.Bound(o => o.Remark).Width(200);
                                                                                                                                                             columns.Bound(c => c.CreatedBy).Width(150);
                                                                                                                                                             columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                                                                                                                                                             columns.Command(command => { command.Edit(); }).Width(250);

                                                                                                                                                         })
                                                                                                                                                    .ToolBar(commands => commands.Create().Text("Approve Request"))
                                                                                                                                                    .Events(ev =>
                                                                                                                                                    {
                                                                                                                                                             ev.DataBound("approvalDataBound");
                                                                                                                                                         })
                                                                                                                                                    .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                                                                                                            .DataSource(dataSource => dataSource
                                                                                                                                                            .Ajax()
                                                                                                                                                            .PageSize(5)
                                                                                                                                                            .Model(model =>
                                                                                                                                                            {
                                                                                                                                                                     model.Id(p => p.TimeSheetApprovalNewId);
                                                                                                                                                                     model.Field(p => p.CreatedBy).Editable(false);
                                                                                                                                                                     model.Field(p => p.DateCreated).Editable(false);
                                                                                                                                                                 })
                                                                                                                                                            .Events(ev => ev
                                                                                                                                                            .Error("error_handler(\"CostSheetApproval#=WagonDrillTimesheetId#\")")
                                                                                                                                                            .RequestStart("onRequestStart(\"CostSheetApproval#=WagonDrillTimesheetId#\")")
                                                                                                                                                            .RequestEnd("onRequestEnd(\"CostSheetApproval#=WagonDrillTimesheetId#\")"))

                                                                                                                                                            .Create(update => update.Action("WagonDrillCostSheetApproval_Create", "WagonDrillCostSheet", new { Id = "#=WagonDrillTimesheetId#" }))
                                                                                                                                                            .Read(read => read.Action("WagonDrillCostSheetApproval_Read", "WagonDrillCostSheet", new { Id = "#=WagonDrillTimesheetId#" }))
                                                                                                                                                            .Update(update => update.Action("WagonDrillCostSheetApproval_Create", "WagonDrillCostSheet"))


                                                                                                                                                        )
                                                                                                                                                        .ToClientTemplate())
                                                                                                    </text>
                                                                                                                         );
                                                                        }).ToClientTemplate())


</script>



<script>

    var timeSheetApproved;
    var timeSheetSendForAproval;
    var wagonDrillTimeSheetId;

    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = this;

        var masterDataItem = masterGrid.dataItem(masterRow);

        timeSheetApproved = masterDataItem.CostSheetApproved;

        timeSheetSendForAproval = masterDataItem.CostSheetSendForAproval;

        wagonDrillTimeSheetId = masterDataItem.WagonDrillTimesheetId;


        var firstValidationgridName = "#CostSheetApproval" + wagonDrillTimeSheetId;



        if (timeSheetApproved == true || timeSheetSendForAproval == false) {

            $(".k-grid-top", firstValidationgridName).hide();

        }
    }

    function dataBound() {


        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.CostSheetApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
            if (dataItem.CostSheetApproved == true || dataItem.CostSheetSendForAproval == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();


            }
        });
    }

    function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("CostSheetSendForApproval", "WagonDrillCostSheet", new { area = "FleetManagement" })',
            data: { id: id },
            success: function (result) {

                alert(result);

                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }

    function approvalDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsApproved == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });

    }

</script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#FuelInLiter").on("change",function () {
            var inputField = $(this).val();
            $("#FuelCost").val(inputField);
        });
    });
</script>

