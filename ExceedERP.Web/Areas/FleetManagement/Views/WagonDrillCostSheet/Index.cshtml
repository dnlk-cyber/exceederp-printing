


<legend>Wagon Drill Cost Sheet</legend>
@{ 
    bool IsMCG = (ViewBag.setting as string) == "MCG";
    bool IsMIDROC = (ViewBag.setting as string) == "MIDROC";
}
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.WagonDrillTimesheet>()
                    .Name("grid")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.WagonDrillTimesheetId).Title("#").Width(70);
                        columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["category"], "Value", "Text").Width(120);
                        columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["type"], "Value", "Text").Width(120);
                        columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["name"], "Value", "Text").Width(120);
                        columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["fleet"], "Value", "Text").Title("Serial No").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
                        columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["ProcurementSupplier"], "ProcurementSupplierID", "Name").Title("Supplier Name").Width(100);
                        columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branch"], "BranchId", "Name").Title("Branch Name").Width(100);
                        columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessunit"], "Id", "Name").Title("Business unit").Width(100);
                        columns.ForeignKey(c => c.OperatorId, (IEnumerable)ViewData["operator"], "Value", "Text").Title("Operator").Width(100);
                        columns.Bound(c => c.WorkItem).Width(100);
                        if (IsMIDROC == false)
                        {
                            columns.Bound(c => c.FuelInLiter).Title("Fuel Consumption").Width(100);
                            columns.Bound(c => c.FuelRate).Title("Fuel Rate").Width(100);
                            columns.Bound(c => c.FuelCost).Title("Fuel Cost").Width(100);
                        }
                        columns.Bound(c => c.IdleHour).Title("Idle Hour").Width(100);
                        columns.Bound(c => c.IdleRateHour).Title("Idle Rate").Width(100);
                        columns.Bound(c => c.MaintenanceCost).Title("Maintenance Cost").Width(100);
                        columns.Bound(c => c.Salary).Title("Salary").Width(100);
                        columns.Bound(c => c.Perdium).Title("Perdium").Width(100);
                       
                        if (IsMCG == false)
                        {
                            columns.Bound(c => c.ReasonForIdle).Title("Idle reason").Width(120);
                            columns.Bound(c => c.ReasonForDown).Title("Down reason").Width(120);
                        }
                        if (IsMCG == true)
                        {
                            columns.Bound(c => c.IdleReason).Title("Idle reason").Width(120);
                            columns.Bound(c => c.IdleReason).Title("Down reason").Width(120);
                            columns.Bound(c => c.TotalTime).Title("Total Payable HR").Width(120);
                        }
                        columns.Bound(c => c.MaintenanceCost).Width(100);
                        columns.Bound(c => c.TireCost).Width(100);
                        columns.Bound(c => c.LabourCost).Title("Labour Cost").Width(120);
                        columns.Bound(c => c.SparePartCost).Title("Spare Part Cost").Width(120);
                        columns.Bound(c => c.BatteryCost).Title("Battery Cost").Width(120);
                        columns.Bound(c => c.BasicSalary).Title("Basic Salary").Width(120);
                        columns.Bound(c => c.OverTime).Title("Over Time").Width(120);
                        columns.Bound(c => c.TotalCost).Width(100);
                        columns.Bound(c => c.OperationNetWorkingHour).Width(120);
                        columns.Bound(c => c.Date).Width(80);
                        columns.Bound(c => c.OperationDrilledHoleDepth).Width(145);
                        columns.Bound(c => c.NumberOfHolesDrilled).Width(120);
                        columns.Bound(c => c.CostSheetStatus).Width(120);

                        columns.Command(command => { command.Edit().UpdateText("save").CancelText("Cancel").Text("Edit"); }).Title("Action").Width(200);
                    })

                    .Editable(editable => editable.Mode(GridEditMode.PopUp)
                    .TemplateName("WagonDrillCostSheetTemplate")
                    .Window(win => win.Title("Wagon Drill Cost Sheet").Width(800)))
                    .Pageable()
                    .Events(e => e.DataBound("dataBound"))
                    .Events(e => e.DetailExpand("onDetailExpand"))
                    .Filterable()
                    .Scrollable(s => s.Height(550))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Sort(sort => sort.Add(e => e.WagonDrillTimesheetId).Descending())
                        .Model(model => model.Id(p => p.WagonDrillTimesheetId))
                        .Events(ev => ev
                                     .Error("error_handler(\"grid\")")
                                     .RequestStart("onRequestStart(\"grid\")")
                                     .RequestEnd("onRequestEnd(\"grid\")"))
                        .Read(read => read.Action("WagonDrillCostSheet_Read", "WagonDrillCostSheet").Data("sendForgery"))

                        .Update(update => update.Action("WagonDrillCostSheet_Update", "WagonDrillCostSheet").Data("sendForgery"))

                    ).ClientDetailTemplateId("template")
)


