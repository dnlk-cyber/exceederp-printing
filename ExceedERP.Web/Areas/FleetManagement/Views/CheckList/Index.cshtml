<legend> Check List   </legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.EquipmentInspection.CheckList>()
        .Name("grid")
        .Columns(columns =>
        {
            columns.Bound(e => e.Code).Width(80);
            columns.ForeignKey(c => c.EquipmentIdentityID, (System.Collections.IEnumerable)ViewData["EquipmentIdentity"], "EquipmentIdentityID", "EquipmentCategoryName").EditorTemplateName("EquipmentCategoryEditor").Title("Equipment Category").Width(140);
            columns.ForeignKey(c => c.EquipmentTypeID, (System.Collections.IEnumerable)ViewData["EquipmentType"], "EquipmentTypeId", "EquipmentTypeName").Title("Equipment Type").EditorTemplateName("EquipmentTypeEditor").Title("Equipment Type").Width(120);
            columns.Bound(e => e.Type).EditorTemplateName("CheckListTypeEditor").Title("Category").Width(120);
            columns.Bound(e => e.Description).Width(120);
            columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);
        })
          .ToolBar(commands => commands.Create())
          .Editable(editable =>
           {
          editable.Mode(GridEditMode.InLine);
          editable.DisplayDeleteConfirmation("Are You Sure To Remove CheckList!");
          }).HtmlAttributes(new { style = "height: 520px;" })
          .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
          .Scrollable()
          .Sortable()
          .Filterable()
          .Scrollable(h => h.Height(500))
          .ClientDetailTemplateId("template")
        .DataSource(dataSource => dataSource
            .Ajax()
     
            .Model(model =>
            {
                model.Id(p => p.CheckListId);
                model.Field(p => p.Code).Editable(false);
                model.Field(p => p.CheckListId).Editable(false);
            }).Events(ev => ev
.Error("error_handler(\"grid\")")
.RequestStart("onRequestStart(\"grid\")")
.RequestEnd("onRequestEnd(\"grid\")"))
                            .Create(update => update.Action("CheckList_Create", "CheckList").Data("sendForgery"))
                            .Read(read => read.Action("CheckList_Read", "CheckList").Data("sendForgery"))
                            .Update(update => update.Action("CheckList_Update", "CheckList").Data("sendForgery"))
                            .Destroy(update => update.Action("CheckList_Destroy", "CheckList").Data("sendForgery"))
      )
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabStrip_#=CheckListId#")
          .SelectedIndex(0)
          .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
          .Items(items =>
          {
          items.Add().Text(" Line  ").Content(@<text>
               @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.EquipmentInspection.LineCheckList>()
               .Name("linechecklistgrid_#=CheckListId#")
          .Columns(columns =>
          {
                      columns.Bound(o => o.Code).Width(120);
                      columns.Bound(o => o.Name).Width(120);
                      columns.Bound(o => o.Description).Width(120);
          
                      columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);
                          })
               .ToolBar(t => { t.Create(); })
               .Editable(editable => editable.Mode(GridEditMode.InLine))
               .HtmlAttributes(new { style = "height: 520px;" })
               .Pageable(pageable => pageable
               .Input(true)
               .Numeric(false)
               .Refresh(true)
               .PageSizes(true)
               .ButtonCount(5))
               .Scrollable()
               .Sortable()
               .Filterable()
               .Scrollable(h => h.Height(500))
               .DataSource(dataSource => dataSource
               .Ajax()
                      .PageSize(5)
                      .Model(model =>
                              {
                                          model.Id(p => p.CheckListId);
                                          model.Field(p => p.Code).Editable(false);
                                      })
                         .Events(ev => ev
                         .Error("error_handler(\"linechecklistgrid_#=CheckListId#\")")
                         .RequestStart("onRequestStart(\"linechecklistgrid_#=CheckListId#\")")
                         .RequestEnd("onRequestEnd(\"linechecklistgrid_#=CheckListId#\")"))
                         .Create(update => update.Action("LineCheckList_Create", "LineCheckList", new { CId = "#=CheckListId#" }).Data("sendForgery"))
                         .Read(read => read.Action("LineCheckList_Read", "LineCheckList", new { Id = "#=CheckListId#" }).Data("sendForgery"))
                         .Update(update => update.Action("LineCheckList_Update", "LineCheckList").Data("sendForgery"))
                         .Destroy(destroy => destroy.Action("LineCheckList_Destroy", "LineCheckList").Data("sendForgery"))
                         )
                         .ToClientTemplate())
                        </text>
                                );
                            })
                        .ToClientTemplate())
</script>
<script>
    function filterEquipmentCategories() {
        var dropdownlist = $("#EquipmentIdentityID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            search: filterInput.val()
        };
    }

    function filterEquipmentTypes() {
        var dropdownlist = $("#EquipmentTypeID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            equipmentIdentityId: $("#EquipmentIdentityID").val(),
            search: filterInput.val()
        };

    }
</script>
    
