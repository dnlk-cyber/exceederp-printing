

@(Html.Kendo().DropDownListFor(model => model)
                                                      .DataTextField("EquipmentTypeName")
                                                      .DataValueField("EquipmentTypeID").OptionLabel("Select ")
                                                                  .Filter(FilterType.Contains)
                                                  .HtmlAttributes(new { style = "width:100%" })

                                                     .DataSource(d =>
                    {
                        d.Read(r =>
                        {
                            r.Action("EquipmentTypeDDDBind", "EquipmentType");
                        })
                      .ServerFiltering(false);
                    })
                             .CascadeFrom("EquipmentTypeId")
)