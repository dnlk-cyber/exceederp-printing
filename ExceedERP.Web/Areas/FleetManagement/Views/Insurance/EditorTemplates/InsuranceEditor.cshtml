    function onUploadSuccess(e) {

    }

    function checkFileType(e) {
        var files = e.files;

        $.each(files, function () {

            if (this.extension.toLowerCase() === ".pdf" || this.extension.toLowerCase() === ".doc" || this.extension.toLowerCase() === ".docx") {

            } else {
                alert("Only .pdf , .doc or .docx  files can be uploaded!");
                e.preventDefault();
            }

        });
    }


