@model ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentInternalProject
@{
    ViewBag.Title = "Rent Internal Project";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Rent To Internal </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentInternalProject>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(o => o.EquipmentIdentity).Title("Type").Width(140);
        columns.Bound(o => o.EquipmentType).Title("Category").Width(140);

        columns.Bound(o => o.RequestQuantity).Title("Quantity").Width(100);
       
        columns.Bound(o => o.StartingDate).Width(120);
        columns.Bound(o => o.ToDate).Width(120);
        columns.Bound(e => e.Status).Width(100);
              columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

    }).Events(ev =>
                        {
                            ev.DataBound("LineonDataBound");
                        })
              .ToolBar(commands => commands.Create())
        .Editable(editable =>
        {
            editable.Mode(GridEditMode.PopUp).TemplateName("RentInternalProjectEditor");
            editable.DisplayDeleteConfirmation("Are You Sure To Remove Rent for Internal ");
        })
        .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                               // .Groupable()
                                .Scrollable(h => h.Height(500))
                                            .ClientDetailTemplateId("template")
                                            .Events(ev => ev.DetailExpand("onDetailExpand"))
      .DataSource(dataSource => dataSource
        .Ajax()
        .ServerOperation(false)
                     .Model(model =>
              {
                  model.Id(p => p.RentInternalProjectID);
                  model.Field(p => p.RentInternalProjectID).Editable(false);

              }) .Events(ev => ev
                                                    .Error("error_handler(\"grid\")")
                                                    .RequestStart("onRequestStart(\"grid\")")
                                                    .RequestEnd("onRequestEnd(\"grid\")")) 
                    .Create(create => create.Action("RentInternalProject_Create", "RentInternalProject"))
                    .Read(read => read.Action("RentInternalProject_Read", "RentInternalProject"))
                    .Update(read => read.Action("RentInternalProject_Update", "RentInternalProject"))
                    .Destroy(read => read.Action("RentInternalProject_Destroy", "RentInternalProject"))
  )
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                            .Name("tabStrip_#=RentInternalProjectID#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
                  items.Add().Text("Detail").Content(
                        @<text>
                            <legend>Detail</legend>

                            <div class="box">

                                <div class="box-col">

                                    # if (IsSendForApproval == false || IsSendForApproval == "false")
                                    {#

                                    <a href='@Url.Action("Rent_SendForOnlineApproval", "RentForInternalApproval")/?EId=#=RentInternalProjectID#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                    # }#
                                </div>
                            </div> 
                            <div class="demo-section k-header export-app">
                                <div class="demo-section content-wrapper">

                                    <form>

                                       

                                        <div class="row">
                                            <div class="col-md-1">
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.CreatedBy)
                                                    </div>
                                                    <div>
                                                        #=CreatedBy#

                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.DateCreated)
                                                    </div>
                                                    <div>
                                                        #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                                    </div>
                                                </div>
                                            </div>
                                       
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.ModifiedBy)
                                                    </div>
                                                    <div>

                                                        #=ModifiedBy#

                                                    </div>
                                                </div>
                                            </div>
                                       
                                                    <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.LastModified)
                                                    </div>
                                                    <div>
                                                        #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #

                                                    </div>
                                                </div>
                                            </div>
                                          
                                        </div>

                                    </form>

                                </div>
                            </div>



                        </text>


            );
                items.Add().Text(" Approval").Content(@<text>
              
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentForInternalApproval>()
                                                                                        .Name("RentForInternalApproval#=RentInternalProjectID#")
                        .Columns(columns =>
                        {
                            columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);
                            columns.Bound(c => c.AssignedQuantity).Title("Quantity").EditorTemplateName("NumEditor").Width(100);
                            columns.Bound(o => o.Remark).Width(200);
                            columns.Bound(c => c.CreatedBy).Width(150);
                             columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                            columns.Command(command => { command.Edit(); }).Width(250);

                        }).Events(ev =>
                        {
                            ev.DataBound("approveonDataBound");
                        })
                             .Editable(editable => editable.Mode(GridEditMode.InLine))
                                       .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(5)
                                                        .Model(model =>
                              {
                                  model.Id(p => p.RentForInternalApprovalID);
                                  model.Field(p => p.CreatedBy).Editable(false);
                                  model.Field(p => p.DateCreated).Editable(false);
                              })
                                                                                .Events(ev => ev
                                                    .Error("error_handler(\"RentForInternalApproval#=RentInternalProjectID#\")")
                                                    .RequestStart("onRequestStart(\"RentForInternalApproval#=RentInternalProjectID#\")")
                                                    .RequestEnd("onRequestEnd(\"RentForInternalApproval#=RentInternalProjectID#\")"))
                                                                                                           .Create(update => update.Action("Rent_Approve", "RentForInternalApproval", new { EId = "#=RentInternalProjectID#" }))
                                                                                     .Read(read => read.Action("RentForInternalApproval_Read", "RentForInternalApproval", new { EId = "#=RentInternalProjectID#" }))
                                                                           .Update(update => update.Action("Rent_Approve", "RentForInternalApproval", new { EId = "#=RentInternalProjectID#" }))


                                                      )
                                               .ToClientTemplate())
                </text>
                );
            })
                                                                                                                                                                                                                                                                                    .ToClientTemplate())
</script>

 
<script type="text/javascript">
 
    var IsApproved;
    var IsSendForApproved;
    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        IsApproved = masterDataItem.IsOnlineApproved;
        IsSendForApproved = masterDataItem.IsSendForApproval;
 
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            console.log(dataItem.IsOnlineApproved);
            if (dataItem.IsSendForApproval == true || dataItem.IsOnlineApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

      function LineonDataBound(e) {
          var grid = this;

          grid.tbody.find("tr[role='row']").each(function () {
              var dataItem = grid.dataItem(this);
              console.log(dataItem.IsOnlineApproved);
              if (dataItem.IsSendForApproval == true || dataItem.IsOnlineApproved == true) {
                  console.log("Approved");
                  $(this).find(".k-grid-edit").remove();
                  $(this).find(".k-grid-delete").remove();
              }
          });
      }
      function approveonDataBound(e) {
          var grid = this;

          grid.tbody.find("tr[role='row']").each(function () {

              if ( IsApproved == true) {
                  console.log("Approved ");
                  $(this).find(".k-grid-edit").remove();
                  $(this).find(".k-grid-delete").remove();
              }
          });
      }
</script>
<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>