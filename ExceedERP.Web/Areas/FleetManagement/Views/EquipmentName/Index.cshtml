@{
    ViewBag.Title = "Equipment Name";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Equipment Name</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.EquipmentName>()
    .Name("grid")
    .Columns(columns =>
    {

        //columns.ForeignKey(e => e.EquipmentTypeId, (System.Collections.IEnumerable)ViewData["EquipmentTypes"], "Id", "Name").EditorTemplateName("EquipmentTypeEditor").Width(140);
        columns.ForeignKey(c => c.EquipmentTypeId, (System.Collections.IEnumerable)ViewData["EquipmentTypes"], "Id", "Name").EditorTemplateName("EquipmentTypesForName").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
        columns.ForeignKey(e => e.FixedAssetSubCategoryNameId, (System.Collections.IEnumerable)ViewData["FixedAssetSubCategoryNames"], "Id", "Name").EditorTemplateName("FixedAssetSubCategoryNameEditor").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
        columns.Bound(e => e.Name).Width(140);
        columns.Bound(e => e.Description).Width(140);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

    })
              .ToolBar(commands => commands.Create())
         .Editable(editable =>
         {
             editable.Mode(GridEditMode.InLine);
             editable.DisplayDeleteConfirmation("Are You Sure To Remove Equipment Name");
         })  .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            //  .Groupable()
                            .Scrollable(h => h.Height(500))
    .DataSource(dataSource => dataSource
        .Ajax()
       

        .Model(model =>
        {
            model.Id(p => p.EquipmentNameID);

            model.Field(p => p.EquipmentNameID).Editable(false);

        })                   .Events(ev => ev
                          .Error("error_handler(\"grid\")")
                          .RequestStart("onRequestStart(\"grid\")")
                          .RequestEnd("onRequestEnd(\"grid\")"))
                        .Create(update => update.Action("EquipmentName_Create", "EquipmentName").Data("sendForgery"))
                        .Read(read => read.Action("EquipmentName_Read", "EquipmentName").Data("sendForgery"))
                        .Update(update => update.Action("EquipmentName_Update", "EquipmentName").Data("sendForgery"))
                        .Destroy(update => update.Action("EquipmentName_Destroy", "EquipmentName").Data("sendForgery"))
  )
)
  <script>
      function filterEquipmentTypes()
      {
          return {
              equipmentIdentityId:""
          };

      }
      function filterFixedAssetSubCategroryNames() {
          return {
              equipmentTypeId: $("#EquipmentTypeId").val(),
          };
      }
      function filterEquipmentType() {
          var dropdownlist = $("#EquipmentTypeId").data("kendoDropDownList");
          var filterInput = dropdownlist.filterInput.val();
          return { text: filterInput };
      }
      function onChangeSubCategoryName(e) {
          //var delivery = $("#assetSubCategoryNameId").data("kendoDropDownList").value();
        $.ajax({
            url: '@Url.Action("GetFixedAssetSubCategoryNameById", "FleetManagementDataProvider")',
            data: { assetSubCategoryNameId: this.value() },
            //data: { assetSubCategoryNameId: delivery },
            type: 'GET',
            cache: false,
            success: function (result) {
                 $("#Name").val(result.Name).trigger("change");
                //$("#Name").val("yibrah").trigger("change");
                $("#Description").val(result.Description).trigger("change");


            }
        });

    }

  </script>