
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.FleetInsuranceTypeDetail>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Name);
        columns.Bound(c => c.Description);
        columns.Bound(c => c.OrgBranchName);
        columns.Bound(c => c.DateCreated);
        columns.Bound(c => c.LastModified);
        columns.Bound(c => c.CreatedBy);
        columns.Bound(c => c.ModifiedBy);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.FleetInsuranceTypeDetailId))
          .Read(read => read.Action("FleetInsuranceTypeDetails_Read", "FleetInsuranceTypeDetail"))
          .Create(create => create.Action("FleetInsuranceTypeDetails_Create", "FleetInsuranceTypeDetail"))
          .Update(update => update.Action("FleetInsuranceTypeDetails_Update", "FleetInsuranceTypeDetail"))
          .Destroy(destroy => destroy.Action("FleetInsuranceTypeDetails_Destroy", "FleetInsuranceTypeDetail"))
      )
)
