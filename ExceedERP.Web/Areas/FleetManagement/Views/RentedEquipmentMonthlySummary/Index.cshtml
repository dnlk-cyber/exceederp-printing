@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.RentedEquipmentMonthlyPaymentSummary
<legend>Monthly Timesheet Summary</legend>
@{

    bool isEquipmentAdministrator = User.IsInRole("EquipmentAdministrator");
    bool isOfficeEngineer = User.IsInRole("OfficeEngineer");
    bool isEquipmentAdministrationOfficer = User.IsInRole("EquipmentAdministrationOfficer");
    bool isConstructionEngineer = User.IsInRole("ConstructionEngineer");
    bool isProjectManager = User.IsInRole("ProjectManager");

}
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.RentedEquipmentMonthlyPaymentSummary>()
                                        .Name("grid")
                                        .Columns(columns =>
                                        {
                                            columns.ForeignKey(x => x.GlPeriodId, (IEnumerable)ViewData["Period"], "Id", "Name").Title("GL Period").Width(100);
                                            columns.Bound(x => x.EquipmentType).Title("Equipment Type").Width(100);
                                            columns.Bound(x => x.PlateNo).Title("Plate No").Width(100);
                                            columns.Bound(x => x.OperatorName).Title("Operator Name").Width(100);
                                            columns.Bound(x => x.BranchName).Title("Branch").Width(100);
                                            columns.Bound(x => x.CustomerName).Title("Customer Name").Width(100);
                                            columns.Bound(x => x.TotalWorkedHR)
                                                .Title("Worked HR/Meter")
                                                .Format("{0:n2}").Width(100);
                                            columns.Command(command =>
                                            {
                                                command.Edit();
                                                command.Destroy();
                                                if (isEquipmentAdministrator)
                                                {
                                                    command.Custom("EquipmentAdminCheck").Click("CheckEquipmentAdminTimeSheetSummery");
                                                }
                                                if (isOfficeEngineer)
                                                {
                                                    command.Custom("OfficeEngineerCheck").Click("CheckOfficeEngineerTimeSheetSummery");
                                                    command.Custom("OfficeEngRejectTimeSheet").Click("RejectTimeSheet");
                                                }
                                                if (isConstructionEngineer)
                                                {

                                                    command.Custom("ConstructionEngineerApprove").Click("CheckConstructionEngineerTimeSheetSummery");
                                                    command.Custom("ConstRejectTimeSheet").Click("RejectTimeSheet");
                                                }
                                                if (isProjectManager)
                                                {

                                                    command.Custom("ProjectManagerApprove").Click("TimeSheetDepartmentManagerTimeSheetSummery");
                                                    command.Custom("RejectTimeSheet").Click("RejectTimeSheet");
                                                }
                                            }
                                                ).Title("Action").Width(200);

                                        })
                                        .ToolBar(toolbar =>
                                        {
                                            toolbar.Create();

                                        })
                                        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("RentedEquipmentTemplate").Window(w => w.Title("Rented Equipment Editor").Width(650).Height(200)))
                                        .Sortable()
                        .Events(ev =>
                        {
                            ev.DataBound("summaryDataBound");
                        }).HtmlAttributes(new { style = "height: 600px;" })
                                        .Filterable()
                                        .Pageable(page => page.Refresh(true).PageSizes(true))
                                        .Scrollable()
                                        .DataSource(dataSource => dataSource
                                            .Ajax()
                                            .PageSize(20)
                                            .Model(model =>
                                            {
                                                model.Id(p => p.RentedEquipmentMonthlyPaymentSummaryId);
                                            })
                                            .Events(ev => ev
                                             .Error("error_handler(\"grid\")")
                                             .RequestStart("onRequestStart(\"grid\")")
                                             .RequestEnd("onRequestEnd(\"grid\")"))
                                            .Read(read => read.Action("Read", "RentedEquipmentMonthlySummary"))
                                            .Create(create => create.Action("RentedEquipmentMonthlyPaymentSummary_Create", "RentedEquipmentMonthlySummary"))
                                            .Update(update => update.Action("Update", "RentedEquipmentMonthlySummary"))
                                            .Destroy(delete => delete.Action("TimeSheetSummaryDestroy", "RentedEquipmentMonthlySummary"))
                                            .Sort(s=>s.Add(i=>i.RentedEquipmentMonthlyPaymentSummaryId).Descending())
                                        ).ClientDetailTemplateId("PaimentDetail")
)

<script id="PaimentDetail" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
