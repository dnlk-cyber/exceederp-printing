</text>);

                                            }).ToClientTemplate())
</script>

<script>
    var approvalStage;
    
            function summaryDataBound() {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.TimeSheetIsEquipmentAdminChecked) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            
            if (!dataItem.TimeSheetIsEquipmentAdminChecked) {
                $(this).find(".k-grid-OfficeEngineerCheck").remove();
                $(this).find(".k-grid-RejectTimeSheet").remove();
                $(this).find(".k-grid-OfficeEngRejectTimeSheet").remove();
                $(this).find(".k-grid-ConstRejectTimeSheet").remove();
                $(this).find(".k-grid-ConstructionEngineerApprove").remove();
                $(this).find(".k-grid-ProjectManagerApprove").remove();
            }
            if (dataItem.TimeSheetIsEquipmentAdminChecked && !dataItem.TimeSheetIsOfficeEngineerChecked) {
                $(this).find(".k-grid-EquipmentAdminCheck").remove();
                $(this).find(".k-grid-ConstructionEngineerApprove").remove();
                $(this).find(".k-grid-RejectTimeSheet").remove();
                $(this).find(".k-grid-ConstRejectTimeSheet").remove();
                $(this).find(".k-grid-ProjectManagerApprove").remove();
            }
            if (dataItem.TimeSheetIsOfficeEngineerChecked && !dataItem.TimeSheetIsConstructionEngineerApproved) {
                $(this).find(".k-grid-ProjectManagerApprove").remove();
                $(this).find(".k-grid-OfficeEngineerCheck").remove();
                $(this).find(".k-grid-EquipmentAdminCheck").remove();
                $(this).find(".k-grid-RejectTimeSheet").remove();
                $(this).find(".k-grid-OfficeEngRejectTimeSheet").remove();
            }
            if (dataItem.TimeSheetIsConstructionEngineerApproved && !dataItem.TimeSheetIsDepartmentManagerApproved) {
                $(this).find(".k-grid-ConstructionEngineerApprove").remove();
                $(this).find(".k-grid-OfficeEngineerCheck").remove();
                $(this).find(".k-grid-EquipmentAdminCheck").remove();
                $(this).find(".k-grid-OfficeEngRejectTimeSheet").remove();
                $(this).find(".k-grid-ConstRejectTimeSheet").remove();
            }
            if (dataItem.TimeSheetIsDepartmentManagerApproved) {
                $(this).find(".k-grid-OfficeEngineerCheck").remove();
                $(this).find(".k-grid-RejectTimeSheet").remove();
                $(this).find(".k-grid-ConstructionEngineerApprove").remove();
                $(this).find(".k-grid-ProjectManagerApprove").remove();
                $(this).find(".k-grid-EquipmentAdminCheck").remove();
                $(this).find(".k-grid-OfficeEngRejectTimeSheet").remove();
                $(this).find(".k-grid-ConstRejectTimeSheet").remove();
            }

        });
    }
    function detailDataBound() {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.TimeSheetIsEquipmentAdminChecked) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }

            if (dataItem.PayedIdleHR == 0) {
                dataItem.set("IdleReasonList", null);
            }
        });
    }
    function drillDataBound() {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.PayedIdleHour == 0) {
                dataItem.set("IdleReasonList", null);
            }
        });
    }
</script>

<script>
    function CheckEquipmentAdminTimeSheetSummery(e) {
    e.preventDefault();
    var grid = this;
    var row = $(e.currentTarget).closest("tr");
    var dataItem = grid.dataItem(row);
    $.ajax({
        type: "POST",
        url: '@Url.Action("CheckEquipmentAdminTimeSheetSummery", "RentedEquipmentMonthlySummary")',
        data: {
            id: dataItem.RentedEquipmentMonthlyPaymentSummaryId
        },
        success: function (result) {
            alert(result.Message);
            approvalStage = "Approver";
            location.reload(true);
        },
        error: function (xhr) {
            alert("Error occurred ");
        }
    });
    }
    function CheckTimeSheet(e) {
    e.preventDefault();
    var grid = this;
    var row = $(e.currentTarget).closest("tr");
    var dataItem = grid.dataItem(row);
    $.ajax({
        type: "POST",
        url: '@Url.Action("CheckTimeSheetSummery", "RentedEquipmentMonthlySummary")',
        data: {
            id: dataItem.RentedEquipmentMonthlyPaymentSummaryId
        },
        success: function (result) {
            alert(result.Message);
            approvalStage = "Approver";
            location.reload(true);
        },
        error: function (xhr) {
            alert("Error occurred ");
        }
    });
    }

</script>
