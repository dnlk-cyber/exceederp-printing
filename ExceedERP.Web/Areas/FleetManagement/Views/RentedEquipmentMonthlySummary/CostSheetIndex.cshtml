<script>
    var approvalStage;
    function summaryDataBound() {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.TimeSheetIsPrepared) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            // PrepareCostSheet CheckerRejectCostSheet
            if (!dataItem.TimeSheetIsPrepared) {
                $(this).find(".k-grid-ApproveCostSheet").remove();
                $(this).find(".k-grid-CheckerRejectCostSheet").remove();
                $(this).find(".k-grid-RejectCostSheet").remove();
                $(this).find(".k-grid-ApprovalRejectCostSheet").remove();
                $(this).find(".k-grid-AuthorizerRejectCostSheet").remove();
                $(this).find(".k-grid-DGM_Approve").remove();
                $(this).find(".k-grid-CheckCostSheet").remove();
                $(this).find(".k-grid-ApproverRejectCostSheet").remove();
                $(this).find(".k-grid-AuthorizeCostSheet").remove();
            }
            if (dataItem.TimeSheetIsPrepared && !dataItem.TimeSheetIsChecked) {
                $(this).find(".k-grid-PrepareCostSheet").remove();
                $(this).find(".k-grid-RejectTimeSheetSummary").remove();
                $(this).find(".k-grid-ApproveCostSheet").remove();
                $(this).find(".k-grid-RejectCostSheet").remove();
                $(this).find(".k-grid-ApprovalRejectCostSheet").remove();
                $(this).find(".k-grid-AuthorizerRejectCostSheet").remove();
                $(this).find(".k-grid-DGM_Approve").remove();
                $(this).find(".k-grid-ApproverRejectCostSheet").remove();
                $(this).find(".k-grid-AuthorizeCostSheet").remove();
            }
            if (dataItem.TimeSheetIsChecked && !dataItem.TimeSheetIsApproved) {
                $(this).find(".k-grid-PrepareCostSheet").remove();
                $(this).find(".k-grid-CheckerRejectCostSheet").remove();
                $(this).find(".k-grid-RejectTimeSheetSummary").remove();
                $(this).find(".k-grid-DGM_Approve").remove();
                $(this).find(".k-grid-CheckCostSheet").remove();
                $(this).find(".k-grid-AuthorizeCostSheet").remove();
                $(this).find(".k-grid-RejectCostSheet").remove();
                $(this).find(".k-grid-AuthorizerRejectCostSheet").remove();
            }
            if (dataItem.TimeSheetIsApproved && !dataItem.TimeSheetIsAuthorized) {
                $(this).find(".k-grid-DGM_Approve").remove();
                $(this).find(".k-grid-PrepareCostSheet").remove();
                $(this).find(".k-grid-RejectTimeSheetSummary").remove();
                $(this).find(".k-grid-CheckerRejectCostSheet").remove();
                $(this).find(".k-grid-CheckCostSheet").remove();
                $(this).find(".k-grid-ApproveCostSheet").remove();
                $(this).find(".k-grid-RejectCostSheet").remove();
                $(this).find(".k-grid-ApproverRejectCostSheet").remove();
            }
            if (dataItem.TimeSheetIsAuthorized && !dataItem.TimeSheetIsDGMApproved) {
                $(this).find(".k-grid-AuthorizeCostSheet").remove();
                $(this).find(".k-grid-PrepareCostSheet").remove();
                $(this).find(".k-grid-RejectTimeSheetSummary").remove();
                $(this).find(".k-grid-CheckerRejectCostSheet").remove();
                $(this).find(".k-grid-CheckCostSheet").remove();
                $(this).find(".k-grid-ApproveCostSheet").remove();
                $(this).find(".k-grid-ApproverRejectCostSheet").remove();
                $(this).find(".k-grid-AuthorizerRejectCostSheet").remove();
            }
            if (dataItem.TimeSheetIsDGMApproved) {
                $(this).find(".k-grid-CheckCostSheet").remove();
                $(this).find(".k-grid-ApproveCostSheet").remove();
                $(this).find(".k-grid-RejectTimeSheetSummary").remove();
                $(this).find(".k-grid-PrepareCostSheet").remove();
                $(this).find(".k-grid-CheckerRejectCostSheet").remove();
                $(this).find(".k-grid-ApproverRejectCostSheet").remove();
                $(this).find(".k-grid-RejectCostSheet").remove();
                $(this).find(".k-grid-DGM_Approve").remove();
                $(this).find(".k-grid-AuthorizeCostSheet").remove();
                $(this).find(".k-grid-AuthorizerRejectCostSheet").remove();

            }

        });
    }

</script>

<script>
     function PrepareTimeSheet(e) {
    e.preventDefault();
    var grid = this;
    var row = $(e.currentTarget).closest("tr");
    var dataItem = grid.dataItem(row);
    $.ajax({
        type: "POST",
        url: '@Url.Action("PrepareTimeSheetSummery", "RentedEquipmentMonthlySummary")',
        data: {
            id: dataItem.RentedEquipmentMonthlyPaymentSummaryId
        },
        success: function (result) {
            alert(result.Message);
            approvalStage = "Approver";
            location.reload(true);
        },
        error: function (xhr) {
            alert("Error occurred ");
        }
    });
    }
    function CheckTimeSheet(e) {
    e.preventDefault();
    var grid = this;
    var row = $(e.currentTarget).closest("tr");
    var dataItem = grid.dataItem(row);
    $.ajax({
        type: "POST",
        url: '@Url.Action("CheckTimeSheetSummery", "RentedEquipmentMonthlySummary")',
        data: {
            id: dataItem.RentedEquipmentMonthlyPaymentSummaryId
        },
        success: function (result) {
            alert(result.Message);
            approvalStage = "Approver";
            location.reload(true);
        },
        error: function (xhr) {
            alert("Error occurred ");
        }
    });
    }

</script>
