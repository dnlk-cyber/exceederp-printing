@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.RentedEquipmentMonthlyPaymentSummary
<legend>Monthly Costsheet Summary</legend>
@{
    bool istimeSheetSummaryChecker = User.IsInRole("TimeSheetSummaryCreator");
    bool istimeSheetSummaryCreator = User.IsInRole("TimeSheetSummaryChecker");
    bool istimeSheetSummaryApprover = User.IsInRole("TimeSheetSummaryApprover");
    bool istimeSheetSummaryAuthorizer = User.IsInRole("TimeSheetSummaryAuthorizer");
    bool isDGMApprover = User.IsInRole("DGMTimeSheetSummaryApprover");

}
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.RentedEquipmentMonthlyPaymentSummary>()
                                        .Name("grid")
                                        .Columns(columns =>
                                        {
                                            columns.ForeignKey(x => x.GlPeriodId, (IEnumerable)ViewData["Period"], "Id", "Name").Title("GL Period").Width(100);
                                            columns.Bound(x => x.EquipmentType).Title("Equipment Type").Width(100);
                                            columns.Bound(x => x.PlateNo).Title("Plate No").Width(100);
                                            columns.Bound(x => x.OperatorName).Title("Operator").Width(100);
                                            columns.Bound(x => x.BranchName).Title("Branch").Width(100);
                                            columns.Bound(x => x.CustomerName).Title("Customer Name").Width(100);
                                            columns.Bound(x => x.RentalRateHour)
                                                .Title("Rate / Hour")
                                                .Format("{0:n2}").Width(100);

                                            columns.Bound(x => x.AgreementDate)
                                                .Title("Agreement Date")
                                                .Format("{0:yyyy-MM-dd}").Width(100);
                                            columns.Bound(x => x.TotalWorkedHR)
                                                .Title("Worked HR")
                                                .Format("{0:n2}").Width(100);

                                            columns.Bound(x => x.GrossBeforeVat)
                                                .Title("Gross")
                                                .Format("{0:n2}").Width(100);

                                            columns.Bound(x => x.VAT)
                                                .Title("VAT")
                                                .Format("{0:n2}").Title("Tax").Width(100);

                                            columns.Bound(x => x.TotalWithVat)
                                                .Title("Total With VAT && TOT")
                                                .Format("{0:n2}").Width(100);

                                            columns.Bound(x => x.AdvancePayedWithVat)
                                                .Title("Advance")
                                                .Format("{0:n2}").Width(100);
                                            columns.Bound(x => x.MaintenanceCost)
                                                   .Title("Maintenance Cost")
                                                   .Format("{0:n2}").Width(100);
                                            columns.Bound(x => x.SparePartCost)
                                                .Title("Sparepart Cost")
                                                .Format("{0:n2}").Width(100);
                                            columns.Bound(x => x.OilLubCost)
                                                .Title("OilLub Cost")
                                                .Format("{0:n2}").Width(100);
                                            columns.Bound(x => x.FuelCost)
                                                .Title("Fuel Cost")
                                                .Format("{0:n2}").Width(100);
                                            columns.Bound(x => x.Deductable)
                                                .Title("Deductable")
                                                .Format("{0:n2}").Width(100);
                                            columns.Bound(x => x.NetPayable)
                                                .Title("Net Payable")
                                                .Format("{0:n2}").Width(100);
                                            columns.Command(command =>
                                            {
                                                command.Edit();
                                                command.Destroy();
                                                if (istimeSheetSummaryCreator)
                                                {
                                                    command.Custom("PrepareCostSheet").Click("PrepareTimeSheet");
                                                    command.Custom("RejectTimeSheetSummary").Click("RejectTimeSheet");
                                                }
                                                if (istimeSheetSummaryChecker)
                                                {
                                                    command.Custom("CheckCostSheet").Click("CheckTimeSheet");
                                                    command.Custom("CheckerRejectCostSheet").Click("RejectTimeSheet");
                                                }
                                                if (istimeSheetSummaryApprover)
                                                {
                                                    command.Custom("ApproveCostSheet").Click("ApproveTimeSheet");
                                                    command.Custom("ApproverRejectCostSheet").Click("RejectTimeSheet");
                                                }
                                                if (istimeSheetSummaryAuthorizer)
                                                {

                                                    command.Custom("AuthorizeCostSheet").Click("TimeSheetAuthorize");
                                                    command.Custom("AuthorizerRejectCostSheet").Click("RejectTimeSheet");
                                                }
                                                if (isDGMApprover)
                                                {

                                                    command.Custom("DGM_Approve").Click("DGM_Approve");
                                                    command.Custom("RejectCostSheet").Click("RejectTimeSheet");
                                                }
                                            }
                                                ).Title("Action").Width(300);

                                        })
                                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                                        .Sortable()
                        .Events(ev =>
                        {
                            ev.DataBound("summaryDataBound");
                        }).HtmlAttributes(new { style = "height: 600px;" })
                                        .Filterable()
                                        .Pageable(page => page.Refresh(true).PageSizes(true))
                                        .Scrollable()
                                        .DataSource(dataSource => dataSource
                                            .Ajax()
                                            .PageSize(20)
                                            .Model(model =>
                                            {
                                                model.Id(p => p.RentedEquipmentMonthlyPaymentSummaryId);
                                                model.Field(p => p.PlateNo).Editable(false);
                                                model.Field(p => p.GlPeriodId).Editable(false);
                                                model.Field(p => p.BranchName).Editable(false);
                                                model.Field(p => p.EquipmentType).Editable(false);
                                                model.Field(p => p.AgreementDate).Editable(false);
                                                model.Field(p => p.Deductable).Editable(false);
                                                model.Field(p => p.GrossBeforeVat).Editable(false);
                                                model.Field(p => p.VAT).Editable(false);
                                                model.Field(p => p.TotalWorkedHR).Editable(false);
                                                model.Field(p => p.TotalWithVat).Editable(false);
                                                model.Field(p => p.NetPayable).Editable(false);
                                            })
                                            .Events(ev => ev
                                             .Error("error_handler(\"grid\")")
                                             .RequestStart("onRequestStart(\"grid\")")
                                             .RequestEnd("onRequestEnd(\"grid\")"))
                                            .Read(read => read.Action("CostSheet_Read", "RentedEquipmentMonthlySummary"))
                                         .Create(create => create.Action("RentedEquipmentMonthlyPaymentSummary_Create", "RentedEquipmentMonthlySummary"))
                                         .Update(update => update.Action("Update", "RentedEquipmentMonthlySummary"))
                                         .Destroy(delete => delete.Action("TimeSheetSummaryDestroy", "RentedEquipmentMonthlySummary"))
                                          .Sort(s => s.Add(i => i.RentedEquipmentMonthlyPaymentSummaryId).Descending())
                                        ).ClientDetailTemplateId("PaimentDetail")
)

