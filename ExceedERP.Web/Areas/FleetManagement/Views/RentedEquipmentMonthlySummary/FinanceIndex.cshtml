<script>
    var approvalStage;
    var isFinanceApproved
    var isFinaneSendForApproval
    function summaryDetailExpand(e) {
        var masterRow = e.masterRow;
        var masterGrid = this;
        var masterDataItem = masterGrid.dataItem(masterRow);
        isFinanceApproved = masterDataItem.IsFinanceApproved;
        isFinaneSendForApproval = masterDataItem.IsFinanceSendForApproval;
    }
    function summaryDataBound() {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.TimeSheetIsPrepared) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            if (!dataItem.TimeSheetIsEquipmentAdminChecked) {
                $(this).find(".k-grid-OfficeEngineerCheck").remove();
                $(this).find(".k-grid-RejectTimeSheet").remove();
                $(this).find(".k-grid-OfficeEngRejectTimeSheet").remove();
                $(this).find(".k-grid-ConstRejectTimeSheet").remove();
                $(this).find(".k-grid-ConstructionEngineerApprove").remove();
                $(this).find(".k-grid-ProjectManagerApprove").remove();
            }
            if (dataItem.TimeSheetIsEquipmentAdminChecked && !dataItem.TimeSheetIsOfficeEngineerChecked) {
                $(this).find(".k-grid-EquipmentAdminCheck").remove();
                $(this).find(".k-grid-ConstructionEngineerApprove").remove();
                $(this).find(".k-grid-RejectTimeSheet").remove();
                $(this).find(".k-grid-ConstRejectTimeSheet").remove();
                $(this).find(".k-grid-ProjectManagerApprove").remove();
            }
            if (dataItem.TimeSheetIsOfficeEngineerChecked && !dataItem.TimeSheetIsConstructionEngineerApproved) {
                $(this).find(".k-grid-ProjectManagerApprove").remove();
                $(this).find(".k-grid-OfficeEngineerCheck").remove();
                $(this).find(".k-grid-EquipmentAdminCheck").remove();
                $(this).find(".k-grid-RejectTimeSheet").remove();
                $(this).find(".k-grid-OfficeEngRejectTimeSheet").remove();
            }
            if (dataItem.TimeSheetIsConstructionEngineerApproved && !dataItem.TimeSheetIsDepartmentManagerApproved) {
                $(this).find(".k-grid-ConstructionEngineerApprove").remove();
                $(this).find(".k-grid-OfficeEngineerCheck").remove();
                $(this).find(".k-grid-EquipmentAdminCheck").remove();
                $(this).find(".k-grid-OfficeEngRejectTimeSheet").remove();
                $(this).find(".k-grid-ConstRejectTimeSheet").remove();
            }
            if (dataItem.TimeSheetIsDepartmentManagerApproved) {
                $(this).find(".k-grid-OfficeEngineerCheck").remove();
                $(this).find(".k-grid-RejectTimeSheet").remove();
                $(this).find(".k-grid-ConstructionEngineerApprove").remove();
                $(this).find(".k-grid-ProjectManagerApprove").remove();
                $(this).find(".k-grid-EquipmentAdminCheck").remove();
                $(this).find(".k-grid-OfficeEngRejectTimeSheet").remove();
                $(this).find(".k-grid-ConstRejectTimeSheet").remove();
            }

            // PrepareCostSheet CheckerRejectCostSheet
            if (!dataItem.TimeSheetIsPrepared) {
                $(this).find(".k-grid-ApproveCostSheet").remove();
                $(this).find(".k-grid-CheckerRejectCostSheet").remove();
                $(this).find(".k-grid-RejectCostSheet").remove();
                $(this).find(".k-grid-ApprovalRejectCostSheet").remove();
                $(this).find(".k-grid-AuthorizerRejectCostSheet").remove();
                $(this).find(".k-grid-DGM_Approve").remove();
                $(this).find(".k-grid-CheckCostSheet").remove();
                $(this).find(".k-grid-ApproverRejectCostSheet").remove();
                $(this).find(".k-grid-AuthorizeCostSheet").remove();
            }
            if (dataItem.TimeSheetIsPrepared && !dataItem.TimeSheetIsChecked) {
                $(this).find(".k-grid-PrepareCostSheet").remove();
                $(this).find(".k-grid-ApproveCostSheet").remove();
                $(this).find(".k-grid-RejectCostSheet").remove();
                $(this).find(".k-grid-ApprovalRejectCostSheet").remove();
                $(this).find(".k-grid-AuthorizerRejectCostSheet").remove();
                $(this).find(".k-grid-DGM_Approve").remove();
                $(this).find(".k-grid-ApproverRejectCostSheet").remove();
                $(this).find(".k-grid-AuthorizeCostSheet").remove();
            }
            if (dataItem.TimeSheetIsChecked && !dataItem.TimeSheetIsApproved) {
                $(this).find(".k-grid-PrepareCostSheet").remove();
                $(this).find(".k-grid-CheckerRejectCostSheet").remove();
                $(this).find(".k-grid-DGM_Approve").remove();
                $(this).find(".k-grid-CheckCostSheet").remove();
                $(this).find(".k-grid-AuthorizeCostSheet").remove();
                $(this).find(".k-grid-RejectCostSheet").remove();
                $(this).find(".k-grid-AuthorizerRejectCostSheet").remove();
            }
            if (dataItem.TimeSheetIsApproved && !dataItem.TimeSheetIsAuthorized) {
                $(this).find(".k-grid-DGM_Approve").remove();
                $(this).find(".k-grid-PrepareCostSheet").remove();
                $(this).find(".k-grid-CheckerRejectCostSheet").remove();
                $(this).find(".k-grid-CheckCostSheet").remove();
                $(this).find(".k-grid-ApproveCostSheet").remove();
                $(this).find(".k-grid-RejectCostSheet").remove();
                $(this).find(".k-grid-ApproverRejectCostSheet").remove();
            }
            if (dataItem.TimeSheetIsAuthorized && !dataItem.TimeSheetIsDGMApproved) {
                $(this).find(".k-grid-AuthorizeCostSheet").remove();
                $(this).find(".k-grid-PrepareCostSheet").remove();
                $(this).find(".k-grid-CheckerRejectCostSheet").remove();
                $(this).find(".k-grid-CheckCostSheet").remove();
                $(this).find(".k-grid-ApproveCostSheet").remove();
                $(this).find(".k-grid-ApproverRejectCostSheet").remove();
                $(this).find(".k-grid-AuthorizerRejectCostSheet").remove();
            }
            if (dataItem.TimeSheetIsDGMApproved) {
                $(this).find(".k-grid-CheckCostSheet").remove();
                $(this).find(".k-grid-ApproveCostSheet").remove();
