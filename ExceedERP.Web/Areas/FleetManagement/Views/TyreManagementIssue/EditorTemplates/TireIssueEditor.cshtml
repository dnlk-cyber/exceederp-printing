@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@model  ExceedERP.Core.Domain.FleetManagement.FleetTireManagement.TireIssue
@using ExceedERP.Core.Domain.FleetManagement.FleetTireManagement
@using ExceedERP.Helpers.Common

<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.Label("Equipment Category", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                 @(Html.Kendo().DropDownListFor(model => model.EquipmentIdentityID)
                       .DataTextField("Name")
                       .ValuePrimitive(true)
                       .AutoBind(true)
                       .DataValueField("Id").Filter(FilterType.Contains)
                       .OptionLabel("Select Equipment Category")
                       .DataSource(d => d.Read(r => r.Action("GetEquipmentIdentities", "FleetManagementDataProvider"))
                       .ServerFiltering(false)))
                </div>
            </div>

            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.FleetId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.FleetId)
                        .AutoBind(true)
                        .ValuePrimitive(true)
                                .DataTextField("EquipmentName")
                                .DataValueField("FleetsID")
                                .OptionLabel(" Select ").Filter(FilterType.Contains)
                                .DataSource(d => d.Read(r => r.Action("FleetsTyreReadingDDBind", "FleetManagementDataProvider")
                                .Data("filterFleets"))
                                .ServerFiltering(true)))
                    @Html.ValidationMessageFor(model => model.FleetId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.Brand, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Brand)
                    @Html.ValidationMessageFor(model => model.Brand, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.TireType, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.TireType)
                    @Html.ValidationMessageFor(model => model.TireType, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.InstalledDate, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-12">
                    @Html.Kendo().DatePickerFor(model => model.InstalledDate)
                    @Html.ValidationMessageFor(model => model.InstalledDate, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
        </div>
        <div class="col-md-3 ro1">

            <div class="form-group">
                @Html.Label("Select Equipment Type", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.EquipmentTypeID)
                            .DataTextField("Name")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .AutoBind(true)
                            .OptionLabel("Select Equipment Type")
                            .Filter(FilterType.Contains)
                            .DataSource(d =>
                            {
                                d.Read(r =>
                            {
                                r.Action("GetEquipmentTypes", "FleetManagementDataProvider")
                                        .Data("filterCategory");
                            })
                            .ServerFiltering(true);
                            })
                            .Enable(false)
                            .AutoBind(false)
                            .CascadeFrom("EquipmentIdentityID"))
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.IssueType, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.IssueType)
                          .DataTextField("Text")
                          .DataValueField("Value")
                          .BindTo(EnumExtension.EnumToSelectList(typeof(FleetBatteryOrTyreType))
                          ))
                    @Html.ValidationMessageFor(model => model.IssueType, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>



            <div class="form-group">
                @Html.LabelFor(model => model.TireSize, "Tax Type", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                   @Html.Kendo().TextBoxFor(model=>model.TireSize)
                    @Html.ValidationMessageFor(model => model.TireSize, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <br />
            <div class="form-group">
                @Html.LabelFor(model => model.KMReading, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-12">
                    @Html.Kendo().TextBoxFor(model => model.KMReading)
                    @Html.ValidationMessageFor(model => model.KMReading, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.DescriptionReason, "Withholding Type", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model=>model.DescriptionReason)
                    @Html.ValidationMessageFor(model => model.DescriptionReason, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>




        </div>

        <div class="col-md-3 ro1">


            <div class="form-group">
                @Html.Label("Equipment Name", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.EquipmentNameID)
                           .AutoBind(true)
                           .Enable(false)
                           .ValuePrimitive(true)
                           .DataTextField("Name")
                           .DataValueField("Id")
                           .Filter(FilterType.Contains)
                           .OptionLabel("Select")
                           .DataSource(d => d.Read(r => r.Action("GetEquipmentNames", "FleetManagementDataProvider")
                           .Data("filterEquipmentNames")).ServerFiltering(true)).CascadeFrom("EquipmentTypeID"))
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.SerialNo, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.SerialNo)
                    @Html.ValidationMessageFor(model => model.SerialNo, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                    @Html.LabelFor(model => model.TireTube, htmlAttributes: new { @class = "control-label col-md-8" })
                    <div class="col-md-6">
                        @Html.Kendo().TextBoxFor(model => model.TireTube)
                        @Html.ValidationMessageFor(model => model.TireTube, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row"></div>


            <div class="form-group">
                    @Html.LabelFor(model => model.UnitPrice, htmlAttributes: new { @class = "control-label col-md-8" })
                    <div class="col-md-6">
                        @Html.Kendo().TextBoxFor(model => model.UnitPrice)
                        @Html.ValidationMessageFor(model => model.UnitPrice, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row"></div>

        </div>
    </div>
</div>
