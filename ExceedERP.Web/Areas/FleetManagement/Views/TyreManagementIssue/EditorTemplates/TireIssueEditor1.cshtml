@model  ExceedERP.Core.Domain.FleetManagement.FleetTireManagement.TireIssue
@using ExceedERP.Core.Domain.FleetManagement.FleetTireManagement
@using ExceedERP.Helpers.Common


<div class="demo-section k-content">
    <form>

        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-sm-3">

                @(Html.Kendo().DropDownListFor(model => model.EquipmentIdentityID)
                       .DataTextField("Name")
                       .DataValueField("Id").Filter(FilterType.Contains)
                       .OptionLabel("Select Equipment Category")
                       .HtmlAttributes(new { style = "width:100%" })
                       .DataSource(d => d.Read(r => r.Action("GetEquipmentIdentities", "FleetManagementDataProvider"))
                       .ServerFiltering(false)))
            </div>
            <div class="col-sm-3">
                <div class="form-group">
                    @(Html.Kendo().DropDownListFor(model => model.EquipmentTypeID)
                                  .DataTextField("Name")
                                  .DataValueField("Id")
                                  .OptionLabel("Select Equipment Type")
                                  .Filter(FilterType.Contains)
                                  .HtmlAttributes(new { style = "width:100%" })
                                  .DataSource(d =>
                                  {
                                      d.Read(r =>
                                  {
                                      r.Action("GetEquipmentTypes", "FleetManagementDataProvider")
                                              .Data("filterCategory");
                                  })
                                  .ServerFiltering(true);
                                        })
                                  .Enable(false)
                                  .AutoBind(false)
                                  .CascadeFrom("EquipmentIdentityID"))
                </div>
            </div>
            <div class="col-sm-3">
                <div class="form-group">

                    @(Html.Kendo().DropDownListFor(model => model.EquipmentNameID)
                          .AutoBind(false)
                          .Enable(false)
                          .DataTextField("Name")
                            .DataValueField("Id")
                            .Filter(FilterType.Contains)
                            .OptionLabel("Select")
                          .DataSource(d => d.Read(r => r.Action("GetEquipmentNames", "FleetManagementDataProvider")
                          .Data("filterEquipmentNames")).ServerFiltering(true)).CascadeFrom("EquipmentTypeID"))
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-1">
            </div>


            
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">

                        @Html.LabelFor(model => model.FleetId)
                        @(Html.Kendo().DropDownListFor(model => model.FleetId)
                        .DataTextField("EquipmentName")
                        .DataValueField("FleetsID")
                        .OptionLabel(" Select ").Filter(FilterType.Contains)
                        .DataSource(d => d.Read(r => r.Action("FleetsTyreReadingDDBind", "FleetManagementDataProvider")
                        .Data("filterFleets"))
                        .ServerFiltering(true)))
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">

                        @Html.LabelFor(model => model.IssueType)
                        @(Html.Kendo().DropDownListFor(model => model.IssueType)
                               .DataTextField("Text")
                               .DataValueField("Value")
                               .BindTo(EnumExtension.EnumToSelectList(typeof(FleetIssueType))
                               ))
)
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.SerialNo)
                    </div>
                    <div>
                        @(Html.Kendo().TextBoxFor(model => model.SerialNo))@*.Name("SerialNo")
                                                                                 .DataTextField("Text")
                                                                         .DataValueField("Value").OptionLabel(" Select ").Filter(FilterType.Contains)
                                                                                                         .DataSource(d => d.Read(r => r.Action("TyreForIssue", "TyreManagementIssue"))).Events(e => e.Change("BindDetail")))*@



                    </div>
                </div>
            </div>
            


        </div>
        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.Brand)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.Brand)@*.Enable(false)*@

                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.TireSize)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.TireSize)@*.Enable(false)*@

                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.TireTube)
                    </div>
                    @Html.Kendo().TextBoxFor(model => model.TireTube)@*.Enable(false)*@
                </div>
            </div>
            

        </div>
        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="form-group">
                        <div class="k-label">
                            @Html.LabelFor(model => model.TireType)
                        </div>
                        @Html.Kendo().TextBoxFor(model => model.TireType)@*.Enable(false)*@
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.KMReading)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.KMReading)@*.Enable(false)*@

                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.UnitPrice)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.UnitPrice)@*.Enable(false)*@

                    </div>
                </div>
            </div>
            

        </div>
        <div class="row">
            <div class="col-md-1">
            </div>          
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.InstalledDate)
                    </div>
                    <div>
                        @Html.Kendo().DatePickerFor(model => model.InstalledDate)@*.Enable(false)*@

                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.DescriptionReason)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.DescriptionReason)
                        @Html.ValidationMessageFor(model => model.DescriptionReason)
                    </div>
                </div>
            </div>

        </div>


    </form>
</div>
