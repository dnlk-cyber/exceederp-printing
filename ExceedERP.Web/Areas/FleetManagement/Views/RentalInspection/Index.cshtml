<script>
    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "RentalInspection", new { area = "FleetManagement" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>

<script>
     function PopulateEquipmentType() {

         var EquipmentTypeObject = $("#EquipmentTypeID").data("kendoDropDownList");
         var EquipmentTypeID = EquipmentTypeObject.value();
         $("#AssetCode").val(EquipmentTypeObject.text());

        $.ajax({
            url: '@Url.Action("EquipmentTypeById", "FleetManagementDataProvider")',
            data: { Id: EquipmentTypeID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r != null || r != "") {

                    //if (r.IsRegistered == true) {
                    //    alert(r.EquipmentTypeID + " Asset No Already Registered");
                    //}

                    $("#ChasisSerialNo").val(r.ChasisSerialNo).trigger("change");
                    $("#EngineModel").val(r.EngineModel).trigger("change");
                    $("#Model").val(r.Model).trigger("change");
                    $("#EngineSerialNo").val(r.EngineSerialNo).trigger("change");
                    $("#ManufacturingYear").val(r.ManufacturingYear).trigger("change");
                    $("#Capacity").val(r.Capacity).trigger("change");
                    $("#PlateNo").val(r.PlateNo).trigger("change");
                    }
                else {
                    $("#ChasisSerialNo").val("");
                    $("#EngineModel").val("");
                    $("#EngineSerialNo").val("");
                    $("#ManufacturingYear").val("");
                    $("#Capacity").val("");
                    $("#PlateNo").val("");
                }
            }

        });
    }
</script>
<style>
    p {
        margin-left: 150px;
    }
</style>
<script>
    function onDataBound() {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsOnlineApproved) { 
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                $(this).css("background-color", "#b7ff9e");
            }
        });
    }
    function onValidationDataBound() {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == 0 ) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();               
            }
        });
    }
    function VoidRecord(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("VoidRentalInspection", "RentalInspection", new { area = "FleetManagement" })',
            data: { id: id },
            success: function (result) {

                alert(result);

                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }
</script>