
@{
    ViewBag.Title = "DryLoadingTimeSheets";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Rental Inspection</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentalInspection>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.Bound(c => c.RentalInspectionId).Title("#").Width(50);
              columns.ForeignKey(c => c.EquipmentTypeID, (IEnumerable)ViewData["EquipmentType"], "EquipmentTypeID", "EquipmentTypeName").Title("Equipment Type").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.ForeignKey(c => c.EquipmentNameID, (IEnumerable)ViewData["EquipmentName"], "EquipmentNameID", "Name").Title("Equipment Name").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["BranchName"], "BranchId", "Name").Title("Branch").Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.Model).Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.ChasisSerialNo).Title("Chasis/Serial No.").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.EngineModel).Title("Engine Model").Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.EngineSerialNo).Title("Engine Serial No.").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.MeterReading).Width(140).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.ManufacturingYear).Title("Manufacturing Year").Width(140).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.Capacity).Title("Capacity").Width(80).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.Hp).Title("HP").Width(80).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.OperatorLicenceNo).Width(140).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.OperatorName).Width(140).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.Lessor).Title("Lessor").Width(80).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.PlateNo).Width(80).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Command(command => { command.Edit().UpdateText("save").CancelText("Cancel").Text("Edit"); command.Destroy().Text("Delete"); }).Title("Action").Width(200);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create();

          })
          .Editable(editable => editable.Mode(GridEditMode.PopUp)
          .TemplateName("RentalInspectionTimesheetTemplate")
          .Window(win => win.Title("Rental Inspection").Width(800)))
          .Pageable()
          .Filterable()
          .Events(ev =>
          {
              ev.DataBound("onDataBound");
          })
          .Scrollable(s => s.Height(550))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Sort(sort => sort.Add(e => e.RentalInspectionId).Descending())
              .Model(model => model.Id(p => p.RentalInspectionId))
              .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))

              .Read(read => read.Action("RentalInspection_Read", "RentalInspection").Data("sendForgery"))
              .Create(create => create.Action("RentalInspection_Create", "RentalInspection").Data("sendForgery"))
              .Update(update => update.Action("RentalInspection_Update", "RentalInspection").Data("sendForgery"))
              .Destroy(destroy => destroy.Action("RentalInspection_Destroy", "RentalInspection").Data("sendForgery"))
          )
          .ClientDetailTemplateId("detailTemplate")
)
