@using System.Collections
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@model ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentalInspection
@using ExceedERP.Helpers.Common

<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1"> 

            <div class="form-group">
                @Html.LabelFor(model=>model.EquipmentTypeID, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.EquipmentTypeID)
                          .ValuePrimitive(true)
                          .OptionLabel("Equipment Type ")
                          .DataTextField("Name")
                          .DataValueField("Id")
                          .Filter("contains")
                          //.Events(ev => ev.Change("PopulateEquipmentType"))
                          .MinLength(2)
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetEquipmentType", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery"))
                              .ServerFiltering(false);
                          })
                    )
                    @Html.ValidationMessageFor(model => model.EquipmentTypeID, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.ChasisSerialNo, htmlAttributes: new { @class = "control-label col-md-8" })
