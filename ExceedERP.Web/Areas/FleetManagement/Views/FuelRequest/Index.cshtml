                                                                                                  columns.Bound(c => c.SideNo).Width(80);
                                                                                                  columns.Bound(c => c.Driver).Width(130);
                                                                                                  columns.Bound(c => c.DepartmentName).Width(130);
                                                                                                  columns.Bound(c => c.DivisionName).Width(110);
                                                                                                  columns.Bound(c => c.OpeningKM).Format("{0:n0}").Width(90);
                                                                                                  columns.Bound(c => c.ClosingKM).Format("{0:n0}").Width(90);
                                                                                                  columns.Bound(c => c.DistanceKM).Format("{0:n0}").Width(90);
                                                                                                  columns.Bound(c => c.FuelConsumedL).Title("Fuel Consumed L").Format("{0:n2}").Width(100);
                                                                                                  columns.Bound(c => c.FuelFilledL).Title("Fuel Filled L").Format("{0:n2}").Width(100);
                                                                                                  columns.Bound(c => c.ConsumptionKMPerL).Title("KM/L").Format("{0:n2}").Width(80);
                                                                                                  columns.Bound(c => c.OperationalDays).Width(90);
                                                                                                  columns.Bound(c => c.RecieptNo).Width(100);
                                                                                                  columns.Bound(c => c.TotalAmount).Format("{0:n2}").Width(100);
                                                                                                  columns.Bound(c => c.FuelOwnerPhoneNumber).Title("Telebirr Phone").Width(120);
                                                                                                  columns.Command(command =>
                          {
                                                  command.Edit();
                                                  command.Destroy();
                                              }).Width(320);
                                                                                              })
                                                                                      .ToolBar(commands =>
                                                                                      {
                                                                                                  commands.Create();
                                                                                              })
                                                                                      .Editable(editable =>
                                                                                      {
                                                                                                  editable.Mode(GridEditMode.PopUp).TemplateName("FuelRequestEditor").Window(x => x.Title("Fuel Request").Width(900));
                                                                                                  editable.DisplayDeleteConfirmation("Are you sure you want to remove this fuel request?");
                                                                                              })
                                                                                      .Events(ev => { ev.DataBound("onDetailDataBound"); ev.Edit("onEdit"); })
                                                                                      .Pageable(pageable => pageable.Input(true).Numeric(false).Refresh(true).PageSizes(true).ButtonCount(5))
                                                                                      .Sortable()
                                                                                      .Filterable()
                                                                                      .Scrollable(h => h.Height(520))
                                                                                      //.ClientDetailTemplateId("template")
                                                                                      .DataSource(dataSource => dataSource
                                                                                          .Ajax()
                                                                                          .PageSize(20)
                                                                                          .Sort(sort => sort.Add(e => e.FuelRequestDetailId).Descending())
                                                                                          .Model(model =>
                                                                                          {
                                                                                                      model.Id(p => p.FuelRequestDetailId);
                                                                                                      model.Field(p => p.RequestDate).DefaultValue(DateTime.Today);
                                                                                                  })
                                                                                          .Events(ev => ev
                                                                                              .Error("error_handler(\"detailGrid_#=FuelRequestId#\")")
                                                                                              .RequestStart("onRequestStart(\"detailGrid_#=FuelRequestId#\")")
                                                                                              .RequestEnd("onRequestEnd(\"detailGrid_#=FuelRequestId#\")"))
                                                                                          .Create(create => create.Action("FuelRequest_Create", "FuelRequestDetail", new { id = "#=FuelRequestId#" }).Data("sendForgery"))
                                                                                          .Read(read => read.Action("FuelRequest_Read", "FuelRequestDetail", new { id = "#=FuelRequestId#" }).Data("sendForgery"))
                                                                                          .Update(update => update.Action("FuelRequest_Update", "FuelRequestDetail").Data("sendForgery"))
                                                                                          .Destroy(destroy => destroy.Action("FuelRequest_Destroy", "FuelRequestDetail").Data("sendForgery"))
                                                                                      ).ToClientTemplate())
            </text>);
                                                                    items.Add().Text("Attachment").Content(@<text>

                                                                        @FileUpload()

                                                                    </text>);
                                                                        }).ToClientTemplate()
    )
</script>

@helper FileUpload()
{
    <text>
        @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FuelManagement.FuelRequestDocument>
                                ()
                                .Name("CompanyDocument#=FuelRequestId#")

                                .Columns(columns =>
                                {
                                    columns.Bound(x => x.FuelRequestDocumentId).Hidden(true);
                                    columns.Bound(c => c.FileName).ClientTemplate("<a href='/FleetManagement/FuelRequest/DownloadBoloDocument?CompanyDocumentId=\\#=FuelRequestDocumentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; \\#=FileName\\# </a>").Width(200);
                                    columns.Command(command =>
                                {
                                    command.Destroy();
                                }).Width(580);
                                })
                              .ToolBar(t => t.Template(
                                        @<text>
                                            @(Html.Kendo().Upload()
                                                                    .Name("attachments")
                                                                    .Async(a => a.Save("Attachment_Create", "FuelRequest", new { id = "#=FuelRequestId #" }))
                                                                    .Events(e => e.Complete("onUploadSuccess").Select("function(e) { globalOnSelect(e, ['.jpg', '.png', '.pdf'], 2 * 1024 * 1024); }")
                                                                    .Error("onUploadError")
                                                                    )
                                                                    .ShowFileList(false)
                                                                    .ToClientTemplate()
                                            )
                                        </text>
                                                        ))
                                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                .HtmlAttributes(new { style = "height: 350px;" })
                                                .Sortable(sortable =>
                                                {
                                                    sortable.SortMode(GridSortMode.SingleColumn);
                                                })
                                                .Scrollable()
                                                .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                                                // .Events(x => x.DataBound("onDataBoundLines"))
                                                .DataSource(dataSource => dataSource
                                                .Ajax()
                                                .Events(ev => ev
                                                    .Error("error_handler(\"CompanyDocument#=FuelRequestId#\")")
                                                    .RequestStart("onRequestStart(\"CompanyDocument#=FuelRequestId#\")")
                                                    .RequestEnd("onRequestEnd(\"CompanyDocument#=FuelRequestId#\")"))
                                                    .Model(model => model.Id(p => p.FuelRequestDocumentId))
                                                    .Read(read => read.Action("Doc_Read", "FuelRequest", new { id = "#=FuelRequestId#", area = "FleetManagement" }).Data("sendForgery"))
                                                    .Destroy(destroy => destroy.Action("Doc_Delete", "FuelRequest", new { area = "FleetManagement" }).Data("sendForgery"))
                                                    ).ToClientTemplate())
    </text>
}

<style type="text/css">
    div.k-edit-form-container {
        width: 860px;
    }
</style>


<script type="text/javascript">
    var isSendForFinance = false;
    function detailExpand(e) {
        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        isSendForFinance = masterDataItem.IsSendForApproval;
    }
    function onDataBound() {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsSendForApproval) {
                $(this).find(".k-grid-edit, .k-grid-delete, .k-grid-SendToFinance").remove();
            }
            if (dataItem.IsFinanceApproved) {
                $(this).addClass("k-state-FleetApproved");
            }
        });
    }
    function onDetailDataBound() {
        var grid = this;
        if (isSendForFinance) {
            grid.wrapper.find(".k-grid-add").hide();
        }
        grid.tbody.find("tr[role='row']").each(function () {
            if (isSendForFinance) {
                $(this).find(".k-grid-edit, .k-grid-delete").remove();
            }
            if (isSendForFinance) {
                $(this).addClass("k-state-FleetApproved");
            }
        });
    }

    // Existing rows: lock Opening KM when a previous request exists for the vehicle.
    function onEdit(e) {
        if (!e.model.isNew() && e.model.FleetId) { loadFleetInfo(); }
    }

    function sendToFinance(e) {
        e.preventDefault();
        var grid = this;
        var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));
        if (!confirm("Send fuel request " + dataItem.FuelRequestId + " to Finance for approval?")) { return; }
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForFinanceApproval", "FuelRequest", new { area = "FleetManagement" })',
            data: $.extend({ id: dataItem.FuelRequestId }, sendForgery()),
            success: function (result) {
                if (result.success) { grid.dataSource.read(); } else { alert(result.message); }
            },
            error: function () { alert("Error occurred"); }
        });
    }

    function filterFuelFleet() {
        var ddl = $("#FleetId").data("kendoDropDownList");
        return { text: ddl ? ddl.filterInput.val() : "" };
    }
    function filterFuelOperator() {
        var ddl = $("#OperatorId").data("kendoDropDownList");
        return { text: ddl ? ddl.filterInput.val() : "" };
    }

