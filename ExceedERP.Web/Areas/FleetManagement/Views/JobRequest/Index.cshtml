 

<legend> Job Request </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetMaintenance.JobRequest>()
            .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.Num).Title("#").Width(100);
        columns.Bound(e => e.IsPM).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsPM #' " + " # if (IsPM) { #" + "checked='checked'" + "# } #" + " />").Title("Is PM").Width(100);
        columns.Bound(e => e.Requester).Width(140);
        columns.Bound(e => e.OperatorName).Width(120);
        columns.Bound(e => e.EquipmentName).Title("Plate/Tag").Width(150);
        columns.Bound(e => e.FuelAmount).Width(100);
        columns.Bound(e => e.Status).Width(100); ;


        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(200);

    })
          .ToolBar(commands =>
                  {
                      commands.Create(); commands.Excel();
                      commands.Pdf();
                  }).Editable(editable =>
        {
            editable.Window(w => w.Title("Job Request"));
            editable.Mode(GridEditMode.PopUp).TemplateName("JobOrderEditor");
            editable.DisplayDeleteConfirmation("Are You Sure To Send Job Request for Approval ");
        })
                 .HtmlAttributes(new { style = "height: 520px;" })
                                  .Pageable(pageable => pageable
                                                    .Input(true)
                                                    .Numeric(false)
                                                    .Refresh(true)
                                                    .PageSizes(true)
                                                    .ButtonCount(5))

                                        .Scrollable()
                                        .Sortable()
                                        .Filterable()
                                          .Scrollable(h => h.Height(500))
                                     .ClientDetailTemplateId("template")
                                     .Events(ev => ev.DetailExpand("onDetailExpandUser"))

                .DataSource(dataSource => dataSource
            .Ajax()
                    .Sort(x => x.Add(s => s.Num).Descending())
            .PageSize(6)
            .Model(model =>
                {
                    model.Id(p => p.JobRequestId);
                    model.Field(p => p.JobRequestId).Editable(false);
                    model.Field(p => p.RequestNumber).Editable(false);
                }
                ).Events(ev => ev
                                            .Error("error_handler(\"grid\")")
                                            .RequestStart("onRequestStart(\"grid\")")
                                            .RequestEnd("onRequestEnd(\"grid\")"))
                            .Create(update => update.Action("JobRequest_Create", "JobRequest").Data("sendForgery"))
                                    .Read(read => read.Action("JobRequest_Read", "JobRequest").Data("sendForgery"))
                                    .Update(update => update.Action("JobRequest_Update", "JobRequest").Data("sendForgery"))
                                        .Destroy(d => d.Action("JobRequest_Destroy", "JobRequest").Data("sendForgery"))

        )
         .Events(events => events.DataBound("dataBound"))
)

