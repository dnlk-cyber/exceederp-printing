@using System.Collections
@{
    ViewBag.Title = "Equipment Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend> Equipment availability Hour Plan </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.EquipmentOperationPlan>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.EquipmentOperationHR).EditorTemplateName("OperationPlanTemplate").Title("Equipment Plan").Width(120);
          columns.ForeignKey(c => c.GLFiscalYearId, (IEnumerable)ViewData["FiscalYear"], "Value", "Text").EditorTemplateName("FiscalYrTemplate").Width(140).Title("Fiscal Year");
          columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["GLPeriod"], "Value", "Text").EditorTemplateName("GLPeriodTemplate").Width(140).Title("GL Period");
          columns.ForeignKey(c => c.CategoryId, (IEnumerable)ViewData["category"], "Value", "Text").EditorTemplateName("InternalRateCategoryTemplate").Width(140).Title("Equipment Category");
          columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["EquipmentType"], "Value", "Text").EditorTemplateName("InternalRateTemplate").Filterable(ftb => ftb.Multi(true).Search(true)).Title("Equipment Type").Width(140);
          columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["EquipmentName"], "Value", "Text").EditorTemplateName("EquipmentNameTemplate").Filterable(ftb => ftb.Multi(true).Search(true)).Title("Equipment Name").Width(140);
          columns.ForeignKey(c => c.FleetId, (IEnumerable)ViewData["PlateNumber"], "Value", "Text").EditorTemplateName("FleetFilterTemplate").Filterable(ftb => ftb.Multi(true).Search(true)).Title("Plate Number").Width(140);
          columns.Bound(e => e.SerialNumber).Title("Serial Number").Width(140);
          columns.Bound(e => e.FuelConsumption).Title("Fuel Consumption").Width(140);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

      })
      .ToolBar(commands => commands.Create())
      .Events(ev=>ev.DataBound("parentDataBound"))
      .Editable(editable =>
      {
          editable.Mode(GridEditMode.InLine);
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Equipment Category");
      })
            .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model =>
          {
              model.Id(p => p.EquipmentOperationPlanId);

          })
          .Sort(so=>so.Add(s=>s.EquipmentOperationPlanId).Descending())
                       .Events(ev => ev
                                        .Error("error_handler(\"grid\")")
                                        .RequestStart("onRequestStart(\"grid\")")
                                        .RequestEnd("onRequestEnd(\"grid\")"))
          .Create(update => update.Action("Fuel_Create", "EquipmentOperationPlan").Data("sendForgery"))
          .Read(read => read.Action("Fuel_Read", "EquipmentOperationPlan").Data("sendForgery"))
          .Update(update => update.Action("_Update", "EquipmentOperationPlan").Data("sendForgery"))
          .Destroy(update => update.Action("_Destroy", "EquipmentOperationPlan").Data("sendForgery"))
      ).ClientDetailTemplateId("template")

      )
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                      .Name("tabStrip_#=EquipmentOperationPlanId#")
                                      .SelectedIndex(0)
                                      .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                                      .Items(items =>
                                      {
                                          items.Add().Text("Detail").Content(
                                        @<text>
                                            #if(IsSendForApproval==false){#
                    <a onclick='return sendForApproval("#=EquipmentOperationPlanId#")' href='\#' title="Send For Approval"><i class="fa fa-2x fa-share-square"></i></a>

    #}#
                                        </text>
);
                                          items.Add().Text("Validation")
                                          .Content(
                                              @<text>
      @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.EquipmentOperationPlanValidation>()
            .Name("ValidationGrid#=EquipmentOperationPlanId#")
            .Columns(columns =>
                  {
                              columns.Bound(o => o.Status).EditorTemplateName("ApprovalStatus").Width(126);
                              columns.Bound(o => o.Remark).Width(200);
                              columns.Bound(c => c.CreatedBy).Width(150);
                              columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                              columns.Command(command => { command.Edit(); }).Width(250);

                          })
                          .ToolBar(toolbar=>toolbar.Create())
                  .Events(ev =>
                  {
                              ev.DataBound("approvalDataBound");
                          })
                  .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .PageSize(5)
                          .Model(model =>
                          {
                                      model.Id(p => p.EquipmentOperationPlanValidationId);
                                      model.Field(p => p.CreatedBy).Editable(false);
                                      model.Field(p => p.DateCreated).Editable(false);
                                  })
                          .Events(ev => ev
                          .Error("error_handler(\"ValidationGrid#=EquipmentOperationPlanId#\")")
                          .RequestStart("onRequestStart(\"ValidationGrid#=EquipmentOperationPlanId#\")")
                          .RequestEnd("onRequestEnd(\"ValidationGrid#=EquipmentOperationPlanId#\")"))

                          .Create(create => create.Action("_Create", "EquipmentOperationPlanValidation", new { id = "#=EquipmentOperationPlanId#" }).Data("sendForgery"))
                          .Read(read => read.Action("_Read", "EquipmentOperationPlanValidation", new { id = "#=EquipmentOperationPlanId#" }).Data("sendForgery"))
                          .Update(update => update.Action("_Create", "EquipmentOperationPlanValidation").Data("sendForgery"))
                      )
                          .ToClientTemplate())
              </text>
                                              );
                 }).ToClientTemplate())
        </script>
    <script>
        function sendForApproval(id) {
            $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "EquipmentOperationPlanValidation", new { area = "FleetManagement" })',
            data: { id: id },
            success: function (result) {
               
                alert(result.message);
               
               // location.reload(true);
            }, 
                error: function (result) {
                    alert(result.message);
            }
        });
    }
        function filterCategory() {
            var dropdownlist = $("#EquipmentTypeId").data("kendoDropDownList");
            var filterInput = dropdownlist.filterInput;

            return {
                equipmentIdentityId: $("#CategoryId").val(),
                search: filterInput.val()
            };

        }
        function filterEquipmentNames() {
            var dropdownlist = $("#EquipmentNameId").data("kendoDropDownList");
            var filterInput = dropdownlist.filterInput;

            return {
                equipmentTypeId: $("#EquipmentTypeId").val(),
                search: filterInput.val()
            };
        }
        function filterFleets() {
            var dropdownlist = $("#FleetId").data("kendoDropDownList");
            var filterInput = dropdownlist.filterInput;

            return {
                equipmentNameId: $("#EquipmentNameId").val(),
                Text: filterInput.val()
            };
        }
        function filterFiscalYears() {
            return {
                Year: $("#GLFiscalYearId").val(),
            };
        }
        function approvalDataBound() {
            var grid = this;
            grid.tbody.find("tr[role='row']").each(function () {
                var dataItem = grid.dataItem(this);
                if (dataItem.Status == 1||dataItem.Status==0) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                }
                
            });
        }
        function parentDataBound() {
            var grid = this;
            parentApproved = false;
            grid.tbody.find("tr[role='row']").each(function () {
                var dataItem = grid.dataItem(this);
                if (dataItem.IsSendForApproval == true) {
                    parentApproved = true;
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                }
                
            });
            if (parentApproved == true) {
                $(this).find(".k-grid-add").hide();
            }
        }
    </script>
