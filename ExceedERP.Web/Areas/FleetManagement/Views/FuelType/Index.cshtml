@{
    ViewBag.Title = "FuelType";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Fuel Type</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FuelManagement.FuelType>()
    .Name("grid")
    .Columns(columns =>
    {

         columns.Bound(e => e.Remark).Title(" Name").Width(140);
        columns.Bound(e => e.DateCreated).Format("{0:d}").Width(140);
        columns.Command(command => {   }).Width(250);

    })
         
         .Editable(editable =>
         {
             editable.Mode(GridEditMode.InLine);
             editable.DisplayDeleteConfirmation("Are You Sure To Remove Fuel Type");
         })  .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                             .Scrollable(h => h.Height(500))
    .DataSource(dataSource => dataSource
        .Ajax()
        .ServerOperation(false)

        .Model(model =>
              {
                  model.Id(p => p.FuelTypeId);

                  model.Field(p => p.FuelTypeId).Editable(false);

              })                   .Events(ev => ev
                                .Error("error_handler(\"grid\")")
                                .RequestStart("onRequestStart(\"grid\")")
                                .RequestEnd("onRequestEnd(\"grid\")"))
                            .Create(update => update.Action("FuelType_Create", "FuelType"))
                        .Read(read => read.Action("FuelType_Read", "FuelType"))
                        .Update(update => update.Action("FuelType_Update", "FuelType"))
                        .Destroy(update => update.Action("FuelType_Destroy", "FuelType"))
  )
)
  