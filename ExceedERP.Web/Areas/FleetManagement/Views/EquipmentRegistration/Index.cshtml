<script>

     function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "EquipmentRegistration", new { area = "FleetManagement" })',
            data: { id: id },
            success: function(result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function(result) {
                alert(result);
            }
        });
    }

    function LineonDataBound(e) {
