<script>

    var progress,
        tabsssss,
        currentIndex = 0;
    function onOpenPopUpEditor() {
        progress = $("#profileCompleteness").data("kendoProgressBar");
        tabsssss = $("#tabstrip").data("kendoTabStrip");
        $(".k-edit-buttons").remove();
