    function PopulateFixedAsset() {

        var UnitNumObject = $("#AssetId").data("kendoDropDownList");
        var UnitNumID = UnitNumObject.value();
        $("#AssetCode").val(UnitNumObject.text());

        $.ajax({
            url: '@Url.Action("FixedAssetById", "FleetManagementDataProvider")',
            data: { Id: UnitNumID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r != null || r != "") {

                    //if (r.IsRegistered == true) {
                    //    alert(r.Tag + " Asset No Already Registered");
                    //}
                    $("#AssetCode").val(r.Tag);

                    $("#SelectedPlate").val(r.PlateNo);
                    $("#SelectedSerial").val(r.SerialNo);
                    $("#SelectedChasis").val(r.ChasisNo);
                    $("#HistoricalCost").val(r.BookValue);
                    $("#Manufacturer").val(r.Manufacturer);
                    $("#SerialNo").val(r.SerialNo);
                    $("#PlateNumber").val(r.PlateNo);
                    $("#EngineNumber").val(r.EngineNo);
