    function CalculateConsuption() {


        $.ajax({
            url: '@Url.Action("GetEquipmentFuelEfficency", "FleetDataProvider")',
            data: { Id: masterId, From: $("#From" + masterId).val(), To: $("#To" + masterId).val() },
            type: 'POST',
            cache: false,
            success: function (r) {
                var s = r.split(/_/);
                $("#FuelConsumptionLevel" + masterId).val(s[1]);
                //  $("#kmh" + masterId).data("kendoRadialGauge").value(s[1]);

                if (s[0] >= 0 && s[0] < 110) {
                    $("#FuelConsumptionLevel" + masterId).css("background-color", "green");
                }
                if (s[0] >= 110 && s[0] < 150) {
                    $("#FuelConsumptionLevel" + masterId).css("background-color", "yellow");
                }
                if (s[0] > 150) {
                    $("#FuelConsumptionLevel" + masterId).css("background-color", "red");
                }
            }
        });
    }


    function ApproveEquipment(e) {
        var items = {};

        var count = 0;
        // Get reference to Grid object
        var grid = $("#grid").data("kendoGrid");
        // Get selected rows
        var sel = $("input:checked", grid.tbody).closest("tr");
       
        $.each(sel, function (idx, row) {
            var item = grid.dataItem(row);
            items['model.ServiceCrews[' + count + '].ServiceCrewId'] = item.FleetsID;
            count++;
        });
        // Show results
    
        $.ajax({
            type: "POST",
            data: items,
            url: '@Url.Action("ApproveBatch", "EquipmentRegistration")',
            success: function (result) {
                grid.dataSource.read();
            }
        });


    }
