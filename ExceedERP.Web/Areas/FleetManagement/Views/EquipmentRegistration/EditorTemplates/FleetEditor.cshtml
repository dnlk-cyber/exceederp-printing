    function filterByEquipmentTypeDD() {

        var dropdownlist = $("#EquipmentTypeID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentIdentityID: $("#EquipmentIdentityID").val(),
            Search: filterInput.val()
        };

    }
    function filterFixedAssetSubCategory() {
        var dropdownlist = $("#SubType").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            Id: $("#EquipmentTypeID").val(),
            Search: filterInput.val()
        };

    }
