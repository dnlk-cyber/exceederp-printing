@{
    ViewBag.Title = "Manufacturer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend> Equipment Manufacturer </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.Manufacturer>()
      .Name("grid")
      .Columns(columns =>
          {
          columns.Bound(e => e.Name).Width(140);
          columns.Bound(e => e.Description).Width(140);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

          })
      .ToolBar(commands => commands.Create())

      .Editable(editable =>
          {
          editable.Mode(GridEditMode.InLine);
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Manufacturer");
          })
           .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Groupable()
                            .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .ServerOperation(false)
              .Model(model =>
              {
              model.Id(p => p.ManufacturerID);

              model.Field(p => p.ManufacturerID).Editable(false);

              })
                                 .Events(ev => ev
                                            .Error("error_handler(\"grid\")")
                                            .RequestStart("onRequestStart(\"grid\")")
                                            .RequestEnd("onRequestEnd(\"grid\")"))
          .Create(update => update.Action("Manufacturer_Create", "EquipmentManufacturer"))
          .Read(read => read.Action("Manufacturer_Read", "EquipmentManufacturer"))
          .Update(update => update.Action("Manufacturer_Update", "EquipmentManufacturer"))
          .Destroy(update => update.Action("Manufacturer_Destroy", "EquipmentManufacturer"))
      ))
