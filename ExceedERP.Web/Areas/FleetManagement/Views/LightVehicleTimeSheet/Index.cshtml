<legend>Light Vehicle Timesheet</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.LightVehicleTimeSheet>()
                    .Name("grid")
                    .Columns(columns =>
                    {

                        columns.Bound(c => c.LightVehicleTimeSheetId).Title("S.No").Width(50);
                        columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["category"], "Value", "Text").Width(120);
                        columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["type"], "Value", "Text").Width(120);
                        columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["name"], "Value", "Text").Width(120);
                        columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["fleet"], "FleetsID", "Name").Title("Equipment Name").Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
                        columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["ProcurementSupplier"], "ProcurementSupplierID", "Name").Title("Supplier Name").Width(100); columns.Bound(c => c.Date).Width(100);
                        columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branch"], "Value", "Text").Title("Branch Name").Width(100);
                        columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessunit"], "Value", "Text").Title("Business unit").Width(100);
                        columns.ForeignKey(c => c.OperatorId, (IEnumerable)ViewData["operator"], "Value", "Text").Title("Operator").Width(100);
                        columns.Bound(c => c.MorningTimeStart).Title("Morning Time Start").Width(100);
                        columns.Bound(c => c.MorningTimeEnd).Title("Morning Time End").Width(100);
                        columns.Bound(c => c.AfternoonTimeStart).Title("Afternoon Time Start").Width(100);
                        columns.Bound(c => c.AfternoonTimeEnd).Title("Afternoon Time End").Width(100);
                        columns.Bound(c => c.NightTimeStart).Title("Night Time Start").Width(100);
                        columns.Bound(c => c.NightTimeEnd).Title("Night Time End").Width(100);
                        columns.Bound(c => c.NetHour).Title("Net Houre").Width(100);
                        columns.Bound(c => c.DownHours).Title("Down Hours").Width(100);
                        columns.Bound(c => c.LubricantCost).Title("Lubricant Cost").Width(100);

                        columns.Bound(c => c.TimeSheetStatus).Width(100);
                        //columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["category"], "Value", "Text").Width(120);
                        // columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["type"], "Value", "Text").Width(120);
                        //columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["name"], "Value", "Text").Width(120);


                        columns.Command(command => { command.Edit().UpdateText("Save").CancelText("Cancel").Text("Edit"); command.Destroy().Text("Delete"); }).Title("Action").Width(160);
                    })
                    .ToolBar(toolbar =>
                    {
                        toolbar.Create();

                    })
                    .Editable(editable => editable.Mode(GridEditMode.PopUp)
                    .TemplateName("lightVehicleTimeSheetTemplate")
                    .Window(win => win.Title("Light Vehicle Timesheet").Width(820)))
                    .Pageable()
                    .Filterable()
                    .Events(e => e.DataBound("dataBound"))
                    .Events(e => e.DetailExpand("onDetailExpand"))
                    .Scrollable(s => s.Height(550))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Model(model => model.Id(p => p.LightVehicleTimeSheetId))
                        .Events(ev => ev
                        .Error("error_handler(\"grid\")")
                        .RequestStart("onRequestStart(\"grid\")")
                        .RequestEnd("onRequestEnd(\"grid\")"))
                        .Read(read => read.Action("LightVehicleTimeSheets_Read", "LightVehicleTimeSheet").Data("sendForgery"))
                        .Create(create => create.Action("LightVehicleTimeSheets_Create", "LightVehicleTimeSheet").Data("sendForgery"))
                        .Update(update => update.Action("LightVehicleTimeSheets_Update", "LightVehicleTimeSheet").Data("sendForgery"))
                        .Destroy(destroy => destroy.Action("LightVehicleTimeSheets_Destroy", "LightVehicleTimeSheet").Data("sendForgery"))
                        .Sort(e => e.Add(a => a.LightVehicleTimeSheetId).Descending())
                    ).ClientDetailTemplateId("template")
)

