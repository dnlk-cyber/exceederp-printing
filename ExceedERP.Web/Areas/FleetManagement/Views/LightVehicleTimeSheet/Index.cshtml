<script type="text/javascript">
     function filterEquipmentType() {
        var dropdownlist = $("#EquipmentTypeId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            timeSheetEquipmentType: "@ViewBag.machineryType",
            equipmentIdentityId: $("#EquipmentCategoryId").val(),
            search: filterInput.val()
        };

    }

    function filterEquipmentNames() {
        var dropdownlist = $("#EquipmentNameId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentTypeId: $("#EquipmentTypeId").val(),
            search: filterInput.val()
        };
    }

function filterPlateNumber() {
        return {
            equipmentNameId: $("#EquipmentNameId").val(),
            text: $("#FleetsID").data("kendoDropDownList").filterInput.val(),
        }
    }
</script>
<script type="text/javascript">

    var timeSheetApproved;
    var timeSheetSendForAproval;
    var lightVehicleTimeSheetId;

    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = this;

        var masterDataItem = masterGrid.dataItem(masterRow);

        timeSheetApproved = masterDataItem.TimeSheetApproved;

        timeSheetSendForAproval = masterDataItem.TimeSheetSendForAproval;

        lightVehicleTimeSheetId = masterDataItem.LightVehicleTimeSheetId;


        var firstValidationgridName = "#TimeSheetApproval" + lightVehicleTimeSheetId;



        if (timeSheetApproved == true || timeSheetSendForAproval == false) {

            $(".k-grid-top", firstValidationgridName).hide();

        }
    }


    function dataBound() {


        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.TimeSheetApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
            if (dataItem.TimeSheetApproved == true || dataItem.TimeSheetSendForAproval == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();


            }
        });
    }
    function approvalDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsApproved == true ) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });

    }
    function handleSupplierChange() {
        var id = $("#FleetsID").data("kendoDropDownList").value();
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetFleetValues", "MachineryWorkingTimeSheet", new { area = "FleetManagement" })',
            dataType: "json",
            data: { fleetId: id },
            success: function (result) {
                console.log(result);
                $('#IdealRentalRate').data("kendoNumericTextBox").value(result.IdealRentalRate);
                $('#IdealRentalRate').data("kendoNumericTextBox").trigger("change");

                $('#RentalRate').data("kendoNumericTextBox").value(result.RentalRate);
                $('#RentalRate').data("kendoNumericTextBox").trigger("change");

                //$('#ProcurementSupplierID').data("kendoDropDownList").value(result.LoadingPortId);
                //$('#ProcurementSupplierID').data("kendoDropDownList").trigger("change");
            },
            error: function (result) {
                console.log(result);
            }

        });
    }



     function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("TimeSheetSendForApproval", "LightVehicleTimeSheet", new { area = "FleetManagement" })',
            data: { lightVehicleTimeSheetId: id },
            success: function (result) {

                alert(result);

                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }
    function voidTimeSheet(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("VoidTimeSheet", "LightVehicleTimeSheet", new { area = "FleetManagement" })',
            data: { lightVehicleTimeSheetId: id },
            success: function (result) {

                alert(result);

                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }

</script>

<script>

    function calculateNetHour() {
        //let mts = kendo.parseDate($("#mts").val(), "HH:mm");
        //let mte = kendo.parseDate($("mte").val(), "HH:mm");
        //var result = new Date(mte.getTime() - mts.getTime());
        //$("#result").val(kendo.toString(result, "HH:mm"));
        //let mts = $("#NightTimeStart").data("kendoTimePicker").value();

        let mts = new Date($("#MorningTimeStart").data("kendoTimePicker").value());
        let mte = new Date($("#MorningTimeEnd").data("kendoTimePicker").value());
        let ats = new Date($("#AfternoonTimeStart").data("kendoTimePicker").value());
        let ate = new Date($("#AfternoonTimeEnd").data("kendoTimePicker").value());
        let nts = new Date($("#NightTimeStart").data("kendoTimePicker").value());
        let nte = new Date($("#NightTimeEnd").data("kendoTimePicker").value());


        let morningTime = mte - mts;
        let afternoonTime = ate - ats;
        let nightTime = nte - nts;
        if (morningTime >= 0 && afternoonTime >= 0 && nightTime)
        {
            let morningTimeInMinut = Math.floor(morningTime / (1000 * 60));
            let afternoonTimeInMinut = Math.floor(afternoonTime / (1000 * 60));
            let nightTimeInMinut = Math.floor(nightTime / (1000 * 60));
            let netHourInMinut = morningTimeInMinut + afternoonTimeInMinut + nightTimeInMinut;
            let netHourInHours = (netHourInMinut / 60);
            $("#NetHour").val(netHourInHours).trigger("change");
        }
        //let netHour = morningTime + afternoonTime + nightTime;

        //alert(netHourInHours)



    }
