<legend>Light Vehicle Timesheet</legend>
@{
    var checkIsMIDROC = (string)ViewBag.IsMIDROC;
    bool isMIDROC = (ViewBag.Setting as string) == "MIDROC";
    bool IsMCG = (ViewBag.Setting as string) == "MCG";
}

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.LightVehicleTimeSheet>()
               .Name("grid")
               .Columns(columns =>
               {
               columns.Bound(c => c.LightVehicleTimeSheetId).Title("S.No").Width(50);
               columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["category"], "Value", "Text").Width(120);
               columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["type"], "Value", "Text").Width(120);
               columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["name"], "Value", "Text").Width(120);
               columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["fleet"], "FleetsID", "Name").Title("Plate/Serial").Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
               columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["ProcurementSupplier"], "ProcurementSupplierID", "Name").Title("Supplier Name").Width(100); columns.Bound(c => c.Date).Width(100);
               columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branch"], "BranchId", "Name").Title("Branch Name").Width(100);
               columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessunit"], "Id", "Name").Title("Business unit").Width(100);
               columns.ForeignKey(c => c.OperatorId, (IEnumerable)ViewData["operator"], "Value", "Text").Title("Operator").Width(100);
               columns.Bound(c => c.ExternalOperatorName).Title("External Operator").Width(100);

               columns.Bound(c => c.MorningTimeStart).Title("Morning Time Start").Width(100);
               columns.Bound(c => c.MorningTimeEnd).Title("Morning Time End").Width(100);
               columns.Bound(c => c.AfternoonTimeStart).Title("Afternoon Time Start").Width(100);
               columns.Bound(c => c.AfternoonTimeEnd).Title("Afternoon Time End").Width(100);
               columns.Bound(c => c.NightTimeStart).Title("Night Time Start").Width(100);

               columns.Bound(c => c.NightTimeEnd).Title("Night Time End").Width(100);

               if (IsMCG == false)
               {
                   columns.Bound(c => c.NetHour).Title("Total Time").Width(100);
               }
               if (IsMCG == true)
               {
                   columns.Bound(c => c.TotalTime).Title("Total Time").Width(100);
                   columns.Bound(c => c.ReasonForDown).Title("Reason For Down").Width(100);
                   columns.Bound(c => c.ReasonForIdle).Title("Reason For Idle").Width(100);
                   columns.Bound(c => c.InitialKMR).Title("Initial KMR").Width(100);
                   columns.Bound(c => c.FinalKMR).Title("Final KMR").Width(100);
                   columns.Bound(c => c.DifferenceKMR).Title("KMR Difference").Width(100);
               }
               if (isMIDROC == false)
               {
                   columns.Bound(c => c.FuelConsumption).Title("Fuel Consumption").Width(100);
               }
               if (IsMCG == true)
               {
                   columns.Bound(c => c.FuelKMR).Title("Fuel KMR").Width(100);
               }
               columns.Bound(c => c.DownHours).Title("Down Hours").Width(100);
               if (isMIDROC == false)
               {
                   columns.Bound(c => c.GreaseCost).Title("Lubricant Cost").Width(100);
               }
               columns.Bound(c => c.TimeSheetStatus).Width(100);
               columns.Command(command => { command.Edit().UpdateText("Save").CancelText("Cancel").Text("Edit"); command.Destroy().Text("Delete"); }).Title("Action").Width(160);
               if (IsMCG || isMIDROC)
               {
                   columns.Template(@<text></text>)
                                   .ClientTemplate(
                                   "# if (!TimeSheetSendForAproval&& !TimeSheetApproved) { #" +
                                       "<input type='checkbox' class='approveCheckbox' />" +
                                   "# } else { #" +
                                       "<input type='checkbox' disabled='disabled' />" +
                                   "# } #")
                                   .Title("Request Approval")
                                   .Width(60);
                   columns.Template(@<text></text>)
                                   .ClientTemplate(
                                   "# if (TimeSheetSendForAproval&& !TimeSheetApproved) { #" +
                                       "<input type='checkbox' class='approveCheckbox' />" +
                                   "# } else { #" +
                                       "<input type='checkbox' disabled='disabled' />" +
                                   "# } #")
                                   .Title("Approve")
                                   .Width(60);
                   columns.Template(@<text></text>)
                                   .ClientTemplate(
                                   "# if (TimeSheetSendForAproval&& TimeSheetApproved&&!CostSheetApproved) { #" +
                                       "<input type='checkbox' class='approveCheckbox' />" +
                                   "# } else { #" +
                                       "<input type='checkbox' disabled='disabled' />" +
                                   "# } #")
                                   .Title("Reject")
                                   .Width(60);
                   }
               })
                                                     .ToolBar(toolbar =>
                                                     {
                                                     toolbar.Template(@<text>
   <!-- Always visible -->
   <a class="k-button k-button-icontext k-grid-add" href="#">
       <span class="k-icon k-i-plus"></span>
       Add New Record
   </a>
   <!-- Conditional content -->
   @if (isMIDROC || IsMCG)
               {
       <label style="margin-left:20px;">Branch:</label>
       @(Html.Kendo().DropDownList()
                                   .Name("branchDropdown")
                                   .DataTextField("Text")
                                   .DataValueField("Value")
                                   .BindTo((IEnumerable<SelectListItem>)ViewData["branchh"])
                                   .OptionLabel("Select Branch")
                                   .HtmlAttributes(new { style = "width:200px;margin-right:10px;" })
       )

       <label style="margin-left:10px;">Date:</label>
       @(Html.Kendo().DatePicker()
                                   .Name("datePicker")
                                   .Format("yyyy-MM-dd")
                                   .Value(DateTime.Now)
                                   .HtmlAttributes(new { style = "width:180px;margin-right:10px;" })
       )

       <button class="k-button k-primary" onclick="generateTimesheet()">
           Auto Generate Timesheet
       </button>
       <button type="button"
               class="k-button k-primary"
               onclick="SendForApprovalSelected()">
           Request Approval
       </button>
<button type="button"
               class="k-button k-primary"
               onclick="ApproveSelected()">
           Approve Selected
       </button><button type="button"
               class="k-button k-primary"
               onclick="RejectSelected()">
           Reject Selected
       </button>
               }
  

                                                        </text>);
                                                            })
                                             .Editable(editable => editable.Mode(GridEditMode.PopUp)
                                             .TemplateName("lightVehicleTimeSheetTemplate")
                                             .Window(win => win.Title("Light Vehicle Timesheet").Width(820)))
                                             .Pageable()
                                             .Filterable()
                                             .Events(e => e.DataBound("dataBound"))
                                             .Events(e => e.DetailExpand("onDetailExpand"))
                                             .Scrollable(s => s.Height(550))
                                             .DataSource(dataSource => dataSource
                                                 .Ajax()
                                                 .Model(model => model.Id(p => p.LightVehicleTimeSheetId))
                                                 .Events(ev => ev
                                                 .Error("error_handler(\"grid\")")
                                                 .RequestStart("onRequestStart(\"grid\")")
                                                 .RequestEnd("onRequestEnd(\"grid\")"))
                                                 .Read(read => read.Action("LightVehicleTimeSheets_Read", "LightVehicleTimeSheet").Data("sendForgery"))
                                                 .Create(create => create.Action("LightVehicleTimeSheets_Create", "LightVehicleTimeSheet").Data("sendForgery"))
                                                 .Update(update => update.Action("LightVehicleTimeSheets_Update", "LightVehicleTimeSheet").Data("sendForgery"))
                                                 .Destroy(destroy => destroy.Action("LightVehicleTimeSheets_Destroy", "LightVehicleTimeSheet").Data("sendForgery"))
                                                 .Sort(e => e.Add(a => a.LightVehicleTimeSheetId).Descending())
                                             ).ClientDetailTemplateId("template")
)

