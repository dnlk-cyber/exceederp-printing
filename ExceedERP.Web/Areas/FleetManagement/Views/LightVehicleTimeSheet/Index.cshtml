<script>
    function getSparePartData() {
        var grid = $("#grid").data("kendoGrid");
        var row = $(".k-detail-row:visible").prev();
        var dataItem = grid.dataItem(row);

        return {
            fleetId: dataItem.FleetsID,
            date: kendo.toString(dataItem.Date, "yyyy-MM-dd")
        };
    }

function generateTimesheet() {

    var branchId = $("#branchDropdown").data("kendoDropDownList").value();
    var selectedDate = $("#datePicker").data("kendoDatePicker").value();

    if (!branchId) {
        alert("Please select a branch");
        return;
    }

    if (!selectedDate) {
        alert("Please select a date");
        return;
    }

    $.ajax({
        url: '@Url.Action("AutoGenerateTimeSheet", "GenerateTimeSheet")',
        type: "POST",
        data: {
            id: branchId,
            date: kendo.toString(selectedDate, "yyyy-MM-dd")
        },
        success: function (response) {

            if (response.Result == "OK") {
                alert(response.Message);
                $("#grid").data("kendoGrid").dataSource.read();
            }
        },
        error: function () {
            alert("Error generating timesheets");
        }
    });
    }
    $(document).ready(function () {
        var fleetDropdown = $("#FleetsID").data("kendoDropDownList");

        if (fleetDropdown && fleetDropdown.value()) {
            fleetDropdown.trigger("change");
        }
    });
    function onFleetChange(e) {
    var fleetId = this.value();

    if (!fleetId) return;

    $.ajax({
        url: '@Url.Action("GetFleetIsExternal", "FleetManagementDataProvider")',
        type: 'GET',
        data: { fleetId: fleetId },
        success: function (res) {

            if (res.isExternal === true) {
                $('#ProcurementSupplierID').data("kendoDropDownList").value(res.SupplierId);
                $('#ProcurementSupplierID').data("kendoDropDownList").trigger("change");
                $("#internalOperatorDiv").show();
                $("#externalOperatorDiv").show();
            } else {
                $("#internalOperatorDiv").show();
                $("#externalOperatorDiv").hide();
            }

        }
    });
    }
    </script>
<script>
    function ApproveSelected() {

    var grid = $("#grid").data("kendoGrid");
    var ids = [];

    $("#grid tbody tr").each(function () {

        var checkbox = $(this).find(".approveCheckbox");

        if (checkbox.is(":checked")) {

            var dataItem = grid.dataItem(this);

            ids.push(dataItem.LightVehicleTimeSheetId);
        }
    });

    if (ids.length === 0) {
        alert("Please select at least one record.");
        return;
