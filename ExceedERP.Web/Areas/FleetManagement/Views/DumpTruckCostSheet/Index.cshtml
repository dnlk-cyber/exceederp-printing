
@{
    ViewBag.Title = "DumpTruckTimeSheets";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Dump Truck Cost Sheet</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.DumpTruckTimeSheet>()
                    .Name("grid")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.DumpTruckTimeSheetId).Title("#").Filterable(false).Width(30);
                        columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["Fleets"], "FleetsID", "PlateNumber").Title("Equipment Name").Width(110).Filterable(ftb => ftb.Multi(true).Search(true));
                        columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["ProcurementSupplier"], "ProcurementSupplierID", "Name").Title("Supplier Name").Width(110);
                        columns.Bound(c => c.Date).Width(70);
                        columns.Bound(c => c.TypeOfWorkExcuted).Title("Work Excuted").Width(100);
                        
                        columns.Bound(c => c.CostSheetStatus).Width(120);
                        
                        columns.Command(command => { command.Edit().UpdateText("Save").CancelText("Cancel").Text("Edit"); }).Title("Action").Width(200);
                    })
                    
                    .Editable(editable => editable.Mode(GridEditMode.PopUp)
                    .TemplateName("DumpTruckCostSheetTemplate")
                    .Window(win => win.Title("Dump Truck Cost Sheet").Width(800)))
                    .Pageable()
                    .Events(e => e.DataBound("dataBound"))
                    .Events(e => e.DetailExpand("onDetailExpand"))
                    .Filterable()
                    .Scrollable(s => s.Height(550))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Sort(sort => sort.Add(e => e.DumpTruckTimeSheetId).Descending())
                        .Model(model => model.Id(p => p.DumpTruckTimeSheetId))
                        .Events(ev => ev
                                     .Error("error_handler(\"grid\")")
                                     .RequestStart("onRequestStart(\"grid\")")
                                     .RequestEnd("onRequestEnd(\"grid\")"))
                        .Read(read => read.Action("DumpTruckCostSheet_Read", "DumpTruckCostSheet"))
                       
                        .Update(update => update.Action("DumpTruckCostSheet_Update", "DumpTruckCostSheet"))
                        ).ClientDetailTemplateId("template")
                    )

<script id="template" type="text/kendo-tmpl">

    @(Html.Kendo().TabStrip()
                .Name("tabStrip_#=DumpTruckTimeSheetId#")
                .SelectedIndex(0)
                .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                .Items(items =>
                {

                    items.Add().Text("Detail").Content(
                        @<text>
                            <legend>Detail</legend>
                            <div class="box">
                                <div class="box-col">

                                    # if (CostSheetSendForAproval == false)
                                    {#

                                    <a onclick='return sendForApproval("#=DumpTruckTimeSheetId#")' href=' \#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                    # }#
                                </div>
                            </div>

                        </text>
                                    );
                            items.Add().Text("Costsheet Detail").Content(@<text>
                                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.DumpTruckTimeSheetDetail>()
                                    .Name("grid_Detail")
                                    .Columns(columns =>
                                    {
                                        // m3*notrips = to
                                        columns.Bound(c => c.LoadingLocationFrom).Width(100);
                                        columns.Bound(c => c.LoadingLocationTo).Width(100);
                                        columns.Bound(c => c.NumberOfTrip).Width(100);
                                        columns.Bound(c => c.ActualDistance).Width(100);
                                        columns.Bound(c => c.Capacity).Width(100);
                                        columns.Bound(c => c.TotalHaulage).Width(100);
                                        columns.Bound(c => c.TypeOfWork).Width(100);
                                        columns.Bound(c => c.RentalRate).Width(100);


                                        columns.Command(command => { command.Edit().UpdateText("Save").CancelText("Cancel").Text("Edit"); command.Destroy().Text("Delete"); }).Title("Action").Width(200);
                                    })

                                    .Editable(editable => editable.Mode(GridEditMode.InLine))

                                    .Pageable()
                                    //.Events(e => e.DataBound("dataBound"))
                                    //.Events(e => e.DetailExpand("onDetailExpand"))
                                    .Filterable()
                                    .Scrollable(s => s.Height(550))
                                    .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Sort(s => s.Add(e => e.DumpTruckTimeSheetDetailId).Descending())
                                        .Model(model =>
                                        {
                                            model.Id(p => p.DumpTruckTimeSheetDetailId);
                                            model.Field(p => p.LoadingLocationFrom).Editable(false);
                                            model.Field(p => p.LoadingLocationTo).Editable(false);
                                            model.Field(p => p.NumberOfTrip).Editable(false);
                                            model.Field(p => p.TotalHaulage).Editable(false);
                                            model.Field(p => p.TypeOfWork).Editable(false);
                                            model.Field(p => p.ActualDistance).Editable(false);
                                            model.Field(p => p.Capacity).Editable(false);
                                        })
                                        .Events(ev => ev
                                                        .Error("error_handler(\"grid_Detail\")")
                                                        .RequestStart("onRequestStart(\"grid_Detail\")")
                                                        .RequestEnd("onRequestEnd(\"grid_Detail\")"))
                                        .Read(read => read.Action("DumpTruckTimeSheetsDetail_Read", "DumpTruckTimeSheetDetail", new { dumpTruckTimesheetId = "#=DumpTruckTimeSheetId#" }))
                                        .Create(create => create.Action("DumpTruckTimeSheetsDetail_Create", "DumpTruckTimeSheetDetail", new { dumpTruckTimesheetId = "#=DumpTruckTimeSheetId#" }))
                                        .Update(update => update.Action("DumpTruckTimeSheetsDetail_Update", "DumpTruckTimeSheetDetail"))
                                        .Destroy(destroy => destroy.Action("DumpTruckTimeSheetsDetail_Destroy", "DumpTruckTimeSheetDetail"))
                                    ).ToClientTemplate()
                                )
                            </text>);
                                    items.Add().Text("Approval").Content(@<text>

                                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.TimeSheetApprovalNew>()
                                                                .Name("TimeSheetApproval#=DumpTruckTimeSheetId#")
                                                                .Columns(columns =>
                                                                {
                                                                    columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                                                                    columns.Bound(o => o.Remark).Width(200);
                                                                    columns.Bound(c => c.CreatedBy).Width(150);
                                                                    columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                                                                    columns.Command(command => { command.Edit(); }).Width(250);

                                                                })
                                                                .ToolBar(commands => commands.Create().Text("Approve Request"))
                                                                .Events(ev =>
                                                                {
                                                                    ev.DataBound("approvalDataBound");
                                                                })
                                                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                    .DataSource(dataSource => dataSource
                                                                    .Ajax()
                                                                    .PageSize(5)
                                                                    .Model(model =>
                                                                    {
                                                                        model.Id(p => p.TimeSheetApprovalNewId);
                                                                        model.Field(p => p.CreatedBy).Editable(false);
                                                                        model.Field(p => p.DateCreated).Editable(false);
                                                                    })
                                                                    .Events(ev => ev
                                                                    .Error("error_handler(\"TimeSheetApproval#=DumpTruckTimeSheetId#\")")
                                                                    .RequestStart("onRequestStart(\"TimeSheetApproval#=DumpTruckTimeSheetId#\")")
                                                                    .RequestEnd("onRequestEnd(\"TimeSheetApproval#=DumpTruckTimeSheetId#\")"))

                                                                    .Create(update => update.Action("DumpTruckCostSheetApproval_Create", "DumpTruckCostSheet", new { Id = "#=DumpTruckTimeSheetId#" }))
                                                                    .Read(read => read.Action("DumpTruckCostSheetApproval_Read", "DumpTruckCostSheet", new { Id = "#=DumpTruckTimeSheetId#" }))
                                                                    .Update(update => update.Action("DumpTruckCostSheetApproval_Create", "DumpTruckCostSheet"))


                                                                )
                                                                .ToClientTemplate())
                                    </text>
                                                    );
                                        }).ToClientTemplate())


</script>





<script>
    var timeSheetApproved;
    var timeSheetSendForAproval;
    var dumpTruckTimeSheetId;

    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = this;

        var masterDataItem = masterGrid.dataItem(masterRow);

        timeSheetApproved = masterDataItem.CostSheetApproved;

        timeSheetSendForAproval = masterDataItem.CostSheetSendForAproval;

        dumpTruckTimeSheetId = masterDataItem.DumpTruckTimeSheetId;


        var firstValidationgridName = "#TimeSheetApproval" + dumpTruckTimeSheetId;



        if (timeSheetApproved == true || timeSheetSendForAproval == false) {

            $(".k-grid-top", firstValidationgridName).hide();

        }
    }

    function dataBound() {


        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.CostSheetApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
            if (dataItem.CostSheetApproved == true || dataItem.CostSheetSendForAproval == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();


            }
        });
    }


    function sendForApproval(id) {
        
        $.ajax({
            type: "POST",
            url: '@Url.Action("CostSheetSendForApproval", "DumpTruckCostSheet", new { area = "FleetManagement" })',
            data: { id: id },
            success: function (result) {
               
                alert(result);
               
                location.reload(true);
            }, 
            error: function (result) {
                alert(result);
            }
        });
    }

    function approvalDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsApproved == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });

    }
    function filterOperator() {
        return {
            text: $("#OperatorId").data("kendoDropDownList").filterInput.val()
        }
    }
</script>
<style>
    div.k-edit-form-container {
        width: auto;
        height: auto;
    }

    .row .col-sm-2 {
        width: 150px;
    }

    .row {
        margin: auto;
    }
</style>