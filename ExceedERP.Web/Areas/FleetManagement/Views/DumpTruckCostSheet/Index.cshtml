                                                        .RequestStart("onRequestStart(\"grid_Detail\")")
                                                        .RequestEnd("onRequestEnd(\"grid_Detail\")"))
                                        .Read(read => read.Action("DumpTruckTimeSheetsDetail_Read", "DumpTruckTimeSheetDetail", new { dumpTruckTimesheetId = "#=DumpTruckTimeSheetId#" }).Data("sendForgery"))
                                        .Create(create => create.Action("DumpTruckTimeSheetsDetail_Create", "DumpTruckTimeSheetDetail", new { dumpTruckTimesheetId = "#=DumpTruckTimeSheetId#" }).Data("sendForgery"))
                                        .Update(update => update.Action("DumpTruckTimeSheetsDetail_Update", "DumpTruckTimeSheetDetail").Data("sendForgery"))
                                        .Destroy(destroy => destroy.Action("DumpTruckTimeSheetsDetail_Destroy", "DumpTruckTimeSheetDetail").Data("sendForgery"))
                                    ).ToClientTemplate()
                                )
                            </text>);
                if (IsMCG == false)
                {
                    items.Add().Text("Maintenance Cost Detail")
                                                                                   .Content(@<text>
                                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.MaintenanceCostDetail>()
                                                                                                             .Name("MaintenanceCD#=DumpTruckTimeSheetId#")
                                                                                                             .Columns(columns =>
                                                                                                             {
                                                                                                                 columns.ForeignKey(c => c.RepairTypeId, (IEnumerable)ViewData["RepairTypes"], "Code", "Name").Title("Repair Type").Width(50);
                                                                                                                 columns.Bound(c => c.Cost).Title("Cost").Width(50);
                                                                                                                 columns.Command(command =>
                                                                                                                 {
                                                                                                                     command.Edit();
                                                                                                                     command.Destroy();
                                                                                                                 }).Title("Action").Width(50);

                                                                                                             })
                                                                                                             .ToolBar(commands => commands.Create())
                                                                                                        .Events(ev =>
                                                                                                        {
                                                                                                            //ev.DataBound("approvalDataBound");
                                                                                                        })
                                                                                                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                            .TableHtmlAttributes(new { style = "table-layout:fixed; width:50%;" })
                                                            .DataSource(dataSource => dataSource
                                                                                                                .Ajax()
                                                                                                                .PageSize(5)
                                                                                                                .Model(model =>
                                                                                                                {
                                                                                                                    model.Id(p => p.MaintenanceCostDetailId);
                                                                                                                    model.Field(p => p.CreatedBy).Editable(false);
