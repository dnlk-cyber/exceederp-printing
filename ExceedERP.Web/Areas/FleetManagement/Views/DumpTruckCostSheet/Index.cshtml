                                                                                                                    .RequestEnd("onRequestEnd(\"MaintenanceCD#=DumpTruckTimeSheetId#\")"))

                                                                                                                    .Create(create => create.Action("RepairType_Create", "MaintenanceCostDetail", new { id = "#=DumpTruckTimeSheetId#", Text = "DumpTruck" }).Data("sendForgery"))
