                                            model.Field(p => p.NumberOfTrip).Editable(false);
                                            model.Field(p => p.TotalHaulage).Editable(false);
                                            model.Field(p => p.TypeOfWork).Editable(false);
                                            model.Field(p => p.ActualDistance).Editable(false);
                                            model.Field(p => p.Capacity).Editable(false);
                                        })
