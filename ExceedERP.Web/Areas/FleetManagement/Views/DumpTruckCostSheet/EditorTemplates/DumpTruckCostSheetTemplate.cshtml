@using System.Collections
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@model  ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.DumpTruckTimeSheet
@using ExceedERP.Helpers.Common
@Html.HiddenFor(model => model.DumpTruckTimeSheetId)

<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Category</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentCategoryId)
                                                                                .DataTextField("Name")
                                                                                .DataValueField("Id")
                                                                                .ValuePrimitive(true)
                                                                                .AutoBind(true)
                                                                                .Enable(false)
                                                                                .Filter(FilterType.Contains)
                                                                                .OptionLabel("Select Category")
                                                                                .HtmlAttributes(new { style = "width:100%" })
                                                                                .DataSource(d => d.Read(r => r.Action("GetEquipmentIdentitiesNullable", "FleetManagementDataProvider").Data("sendForgery"))
                                                                                .ServerFiltering(false)))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Type</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentTypeId)
                                                            .DataTextField("Name")
                                                            .DataValueField("Id")
                                                            .ValuePrimitive(true)
                                                            .Enable(false)
                                                            .OptionLabel("Select Equipment Type")
                                                            .Filter(FilterType.Contains)
                                                            .DataSource(d =>
                                                            {
                                                                d.Read(r =>
                                                                {
                                                                    r.Action("GetEquipmentTypesTimeSheet", "FleetManagementDataProvider")
                                                                    .Data("filterEquipmentType");
                                                                })
                                                                .ServerFiltering(true);
                                                            })

                                                            .AutoBind(true)
                                                            .CascadeFrom("EquipmentCategoryId")
                )
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Name</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentNameId)
                                                            .AutoBind(true)
                                                            .Enable(false)
                                                            .ValuePrimitive(true)

                                                            .DataTextField("Name")
                                                            .DataValueField("Id")
                                                            .Filter(FilterType.Contains)
                                                            .OptionLabel("Select")
                                                            .DataSource(d => d.Read(r => r.Action("GetEquipmentNamesNullable", "FleetManagementDataProvider").Data("sendForgery")
                                                            .Data("filterEquipmentNames"))
                                                            .ServerFiltering(true))
                                                            .CascadeFrom("EquipmentTypeId"))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Plate No</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.FleetsID)
                                                    .ValuePrimitive(true)
                                                    .AutoBind(true)
                                                    .Enable(false)
                                                    .OptionLabel("Select Equipment...")
                                                    .DataTextField("PlateNumber")
                                                    .DataValueField("FleetsID")
                                                    .Filter("contains")
                                                    .MinLength(2)
                                                    .CascadeFrom("EquipmentNameId")
                                                    .DataSource(dataSource =>
                                                    {
                                                        dataSource.Read(read => read.Action("GetFleetIdTimesheetNew", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery")
                                                        .Data("handleFleetId"))
                                                            .ServerFiltering(true);
                                                    }).HtmlAttributes(new { style = "width:100%" })
                )

            </div>
        </div>
    </div>
</div>
<div class="row">

    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.FuelConsumption, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.FuelConsumption).HtmlAttributes(new { style = "width:100%" }).Enable(false)

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.FuelRate, htmlAttributes: new { @class = "control-label col-sm-2", style = "width:100%" })
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.FuelRate).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.ProcurementSupplierID, htmlAttributes: new { @class = "control-label col-sm-2", style = "width:100%" })
            <div>
                @(Html.Kendo().DropDownListFor(model => model.ProcurementSupplierID)
                                                                                      .ValuePrimitive(true)
                                                                                      .OptionLabel("Select Supplier...")
                                                                                      .DataTextField("Name")
                                                                                      .DataValueField("Id")
                                                                                      .Filter("contains")
                                                                                      //.Events(e => e.Change("handleSupplierChange"))
                                                                                      .DataSource(dataSource =>
                                                                                      {
                                                                                          dataSource.Read(read => read.Action("GetSuppliers", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery"))
                                                                                          .ServerFiltering(false);
                                                                                      }).Enable(false)
                )
            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.Date, htmlAttributes: new { @class = "control-label col-sm-2", style = "width:100%" })
            <div>
                @Html.Kendo().DatePickerFor(model => model.Date).HtmlAttributes(new { style = "width:100%" }).Enable(false)

            </div>
        </div>
    </div>
   

</div>
