        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.OperatorId, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @(Html.Kendo().DropDownListFor(model => model.OperatorId)
                                                            .ValuePrimitive(true)
                                                            .OptionLabel("Select Operator...")
                                                            .DataTextField("Text")
                                                            .DataValueField("Value")
                                                            .Filter("contains")
                                                            .AutoBind(true)
                                                            .DataSource(dataSource =>
                                                            {
                                                                dataSource.Read(read => read.Action("Operators", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery").Data("filterOperator"))
                                                                .ServerFiltering(true);
                                                            }).Enable(false)
                )
            </div>
        </div>
    </div>
</div>