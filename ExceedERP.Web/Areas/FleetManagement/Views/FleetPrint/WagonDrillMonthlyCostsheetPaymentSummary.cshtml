@using Telerik.ReportViewer.Mvc
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>Wagon Drill Costsheet Summary</title>

    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <meta name="viewport" content="width=device-width, initial-scale=1, maximuma-scale=1" />
    <script src="~/ReportViewer/content/jquery-1.9.1.min.js"></script>
    <link href="~/ReportViewer/content/kendo.common.min.css" rel="stylesheet" />
    <link href="~/ReportViewer/content/kendo.blueopal.min.css" rel="stylesheet" />
    <script src="@Url.Content("~/ReportViewer/js/telerikReportViewer.kendo-12.2.18.912.min.js")"></script>
    <script src="@Url.Content("~/ReportViewer/js/telerikReportViewer-12.2.18.912.min.js")"></script>

    <style>
        #reportViewer1 {
            position: relative;
            width: 100%;
            height: 900px;
            font-family: Verdana, Arial;
        }
    </style>
</head>
<body>

    @(Html.TelerikReporting().ReportViewer()
                .Id("reportViewer1")
                .ServiceUrl(Url.Content("/api/reports/"))
                .ReportSource(new TypeReportSource() { TypeName = "ExceedERP.Reporting.Fleet.Printing.View.WagonDrillMonthlyCostsheetPaymentSummary, ExceedERP.Reporting, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null", Parameters = {
                        new Parameter("Id", ViewBag.Id),
                        new Parameter("FormTitle",ViewBag.FormTitle),
                        new Parameter("IssueNumber",ViewBag.IssueNumber),
                        new Parameter("FormNumber",ViewBag.FormNumber)
                    } })
                .ViewMode(ViewMode.PrintPreview)
                .ScaleMode(ScaleMode.Specific)
                .Scale(1.0)
                .PersistSession(false)
                .PrintMode(PrintMode.AutoSelect)
    )

</body>
</html>
