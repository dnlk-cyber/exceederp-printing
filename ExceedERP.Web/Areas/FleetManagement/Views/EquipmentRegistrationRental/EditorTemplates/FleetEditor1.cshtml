    function checkFileType(e) {
        var files = e.files;

        $.each(files, function () {

            if (this.extension.toLowerCase() === ".png" || this.extension.toLowerCase() === ".jpg" || this.extension.toLowerCase() === ".jpeag") {

            } else {
                alert("Only .jpg or .png  files can be uploaded!");
                e.preventDefault();
            }

        });
    }
