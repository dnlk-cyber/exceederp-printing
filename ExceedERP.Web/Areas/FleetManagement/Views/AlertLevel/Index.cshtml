@{
 
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>     Alert Level </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.FuelConsumptionAlertLevel>()
      .Name("grid")
      .Columns(columns =>
          {
              columns.Bound(e => e.Name).Width(140);
              columns.Bound(e => e.FromValue).Width(100);
              columns.Bound(e => e.ToValue).Width(100);
              columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

          })
      .ToolBar(commands => commands.Create())
      .Editable(editable =>
          {
              editable.Mode(GridEditMode.InLine);
              editable.DisplayDeleteConfirmation("Are You Sure To Remove Alert Level");
          })
            .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .ServerOperation(false)
          .Model(model =>
              {
                  model.Id(p => p.FuelConsumptionAlertLevelId);

                  model.Field(p => p.FuelConsumptionAlertLevelId).Editable(false);

              })
                       .Events(ev => ev
                                        .Error("error_handler(\"grid\")")
                                        .RequestStart("onRequestStart(\"grid\")")
                                        .RequestEnd("onRequestEnd(\"grid\")"))
          .Create(update => update.Action("FuelConsumptionAlertLevel_Create", "AlertLevel"))
              .Read(read => read.Action("FuelConsumptionAlertLevel_Read", "AlertLevel"))
              .Update(update => update.Action("FuelConsumptionAlertLevel_Update", "AlertLevel"))
              .Destroy(update => update.Action("FuelConsumptionAlertLevel_Destroy", "AlertLevel"))
      ))

