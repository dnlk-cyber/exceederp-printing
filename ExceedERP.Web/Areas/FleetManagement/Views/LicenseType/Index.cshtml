@{
    ViewBag.Title = "License Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend> License Type</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.LicenseType>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.Name).Width(140);
        columns.Bound(e => e.Description).Width(140);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

    })
        .ToolBar(commands => commands.Create())
       .Editable(editable =>
         {
             editable.Mode(GridEditMode.InLine);
             editable.DisplayDeleteConfirmation("Are You Sure To Remove License Type");
         })
        .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                                .Scrollable(h => h.Height(500))
         .DataSource(dataSource => dataSource
        .Ajax()
                       .Model(model =>
              {
                  model.Id(p => p.LicenseTypeId);

                  model.Field(p => p.LicenseTypeId).Editable(false);

              }).Sort(so => so.Add(s => s.LicenseTypeId).Descending())

              .Events(ev => ev
                                            .Error("error_handler(\"grid\")")
                                            .RequestStart("onRequestStart(\"grid\")")
                                            .RequestEnd("onRequestEnd(\"grid\")"))
                        .Create(update => update.Action("LicenseType_Create", "LicenseType"))
                        .Read(read => read.Action("LicenseType_Read", "LicenseType"))
                        .Update(update => update.Action("LicenseType_Update", "LicenseType"))
                        .Destroy(update => update.Action("LicenseType_Destroy", "LicenseType"))
  )
)

