

@using System.Collections
<legend>Battery and Tire Items</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FuelManagement.FleetBatteryAndTire>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.ForeignKey(p => p.ItemCategoryCode, (IEnumerable)ViewData["Category"], "ItemCategoryCode", "Name").EditorTemplateName("ItemCategorySelector").Width(150);
              columns.ForeignKey(p => p.ItemCode, (IEnumerable)ViewData["Items"], "ItemCode", "Name").Title("Item Name").EditorTemplateName("ItemSelector").Width(150);
              columns.Bound(c => c.FleetBatteryOrTireType).Width(150);
              columns.Bound(c => c.DateCreated).Width(150).Hidden(true);
              columns.Bound(c => c.LastModified).Width(150).Hidden(true);
              columns.Bound(c => c.CreatedBy).Width(100).Hidden(true);
              columns.Bound(c => c.ModifiedBy).Width(100).Hidden(true);
              columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create();
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
          .HtmlAttributes(new { style = "height: 550px;" })
          .Pageable(pageable => pageable
              .Input(true)
              .Numeric(false)
              .Refresh(true)
              .PageSizes(true)
              .ButtonCount(20))
          .Scrollable()
          .Sortable()
          .Filterable()

          .DataSource(dataSource => dataSource
              .Ajax()
              .Events(ev => ev
                  .Error("error_handler(\"grid\")")
                  .RequestStart("onRequestStart(\"grid\")")
                  .RequestEnd("onRequestEnd(\"grid\")"))
              .Model(
                  model =>
                  {
                      model.Id(p => p.FleetBatteryAndTireId);
                      model.Field(p => p.CreatedBy).Editable(false);
                      model.Field(p => p.ModifiedBy).Editable(false);
                      model.Field(p => p.LastModified).Editable(false);
                      model.Field(p => p.DateCreated).Editable(false);
                  })
              .Read(read => read.Action("FleetBatteryAndTire_Read", "FleetBatteryAndTire").Data("sendForgery"))
              .Create(create => create.Action("FleetBatteryAndTire_Create", "FleetBatteryAndTire").Data("sendForgery"))
              .Update(update => update.Action("FleetBatteryAndTire_Update", "FleetBatteryAndTire").Data("sendForgery"))
              .Destroy(destroy => destroy.Action("FleetBatteryAndTire_Destroy", "FleetBatteryAndTire").Data("sendForgery"))
          ))


