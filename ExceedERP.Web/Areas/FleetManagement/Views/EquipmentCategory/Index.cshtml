@{
    ViewBag.Title = "Equipment Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend> Equipment Category </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.EquipmentIdentity>()
      .Name("grid")
      .Columns(columns =>
          {
          columns.Bound(e => e.EquipmentCategoryName).Width(140);
          columns.Bound(e => e.Description).Width(140);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

          })
      .ToolBar(commands => commands.Create())
      .Editable(editable =>
          {
          editable.Mode(GridEditMode.InLine);
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Equipment Category");
          })
            .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .ServerOperation(false)
          .Model(model =>
              {
              model.Id(p => p.EquipmentIdentityID);

              model.Field(p => p.EquipmentIdentityID).Editable(false);

              })
                       .Events(ev => ev
                                        .Error("error_handler(\"grid\")")
                                        .RequestStart("onRequestStart(\"grid\")")
                                        .RequestEnd("onRequestEnd(\"grid\")"))
          .Create(update => update.Action("EquipmentIdentity_Create", "EquipmentCategory"))
          .Read(read => read.Action("EquipmentIdentity_Read", "EquipmentCategory"))
          .Update(update => update.Action("EquipmentIdentity_Update", "EquipmentCategory"))
          .Destroy(update => update.Action("EquipmentIdentity_Destroy", "EquipmentCategory"))
      ))

