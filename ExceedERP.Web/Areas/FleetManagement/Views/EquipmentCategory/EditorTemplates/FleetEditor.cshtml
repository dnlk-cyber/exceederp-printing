@model ExceedERP.Core.Domain.FleetManagement.FleetRegistration.Fleets

<h3>Edit Fleet</h3>
<br />
@Html.HiddenFor(model => model.FleetsID)

<div>
    @Html.LabelFor(model => model.EquipmentName)
</div>
<div>
    @Html.TextBoxFor(model => model.EquipmentName)
    @Html.ValidationMessageFor(model => model.EquipmentName)
</div>
@(Html.Kendo().DropDownList().Name("Fleets")
      .DataTextField("PlateNumber")
      .DataValueField("FleetsID")
      .DataSource(d => d.Read(r => r.Action("FleetsDDBind", "EquipmentRegistration"))))