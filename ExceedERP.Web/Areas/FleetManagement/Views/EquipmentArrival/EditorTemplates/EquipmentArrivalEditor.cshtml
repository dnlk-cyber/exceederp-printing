@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@using ExceedERP.Core.Domain.FleetManagement.FleetRegistration
@model  ExceedERP.Core.Domain.FleetManagement.FleetRegistration.EquipmentArrival


<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(m => m.FleetsId)
            </div>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.FleetsId).Name("FleetsId")
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .OptionLabel(" Select ")
                                            .Filter(FilterType.Contains)
                                            .DataSource(d => d.Read(r => r.Action("DistrubutedEquipmentDDBind", "EquipmentArrival").Data("sendForgery"))
                                            .ServerFiltering(false))
                                            .Events(e => e.Change("BindDetail"))
                                            .HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(m => m.KMHRReading)
            </div>
            <div>
                @Html.Kendo().TextBoxFor(model => model.KMHRReading).HtmlAttributes(new { @disabled = "disabled" }).HtmlAttributes(new { style = "width:100%" })
            </div>
        </div>
    </div>

   
    <div class="col-sm-2">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(m => m.Date)
            </div>
            <div>
                @Html.Kendo().DatePickerFor(model => model.Date).HtmlAttributes(new { style = "width:100%" })
            </div>
        </div>
    </div> 
    <div class="col-sm-2">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(m => m.Date)
            </div>
            <div>
                @Html.Kendo().DatePickerFor(model => model.Date).HtmlAttributes(new { style = "width:100%" })
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(m => m.MeansOfTravelling)
            </div>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.MeansOfTravelling)
                    .DataTextField("Text")
                    .DataValueField("Value")

                    .BindTo(ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(MeansOfTravelling))
                    ).HtmlAttributes(new { style = "width:100%" })
                )
            </div>
        </div>
    </div>

</div>
