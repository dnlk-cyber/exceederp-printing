@model ExceedERP.Core.Domain.FleetManagement.FleetRegistration.EquipmentArrival
 
<legend>Equipment Arrival</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.EquipmentArrival>()
      .Name("grid")
      .Columns(columns =>
      {

          //columns.Bound(c => c.EquipmentType).ClientTemplate("<img class='img-circle' src='" + Url.Content("~/Content/Images/Fleet/Equipment/") + "#=EquipmentType#.jpg?q=" + DateTime.Now + "' alt='#=EquipmentType #' Title='#=EquipmentType #'  height='62' width='62'  />").Width(150);
          columns.ForeignKey(o => o.EquipmentIdentityId, (System.Collections.IEnumerable)ViewData["EquipmentCat"], "Value", "Text").Width(100).Title("Equipment Category").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(o => o.EquipmentTypeId, (System.Collections.IEnumerable)ViewData["EquipmentType"], "Value", "Text").Width(100).Title("Equipment Type").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(o => o.EquipmentNameId, (System.Collections.IEnumerable)ViewData["EquipmentName"], "Value", "Text").Width(100).Title("Equipment Name").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(o => o.FleetsId, (System.Collections.IEnumerable)ViewData["FleetsAssignedEquip"], "Value", "Name").Width(80).Title("Plate No").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(o => o.DCENo).Title("Asset No").Width(90).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(o => o.KMHRReading).Width(80).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(o => o.OwnedBy).Width(80);
          columns.Bound(o => o.MeansOfTravelling).Width(90);
          columns.Bound(o => o.Date).Format("{0:d}").Width(80).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(o => o.OperatorName, (System.Collections.IEnumerable)ViewData["Operator"], "Value", "Text").Width(90).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(o => o.Status).Width(80).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);

      }).Events(ev =>
      {
          ev.DataBound("onDataBound"); ev.DetailExpand("onDetailExpandUser");
      })
           .ToolBar(commands =>
           {
               commands.Create(); 
           }).Editable(editable =>
           {
               editable.Mode(GridEditMode.PopUp).TemplateName("EquipmentArrivalEditor").Window(x => x.Title("Equipment Arrival"));
               editable.DisplayDeleteConfirmation("Are You Sure To Remove Arrival");
           }).ClientDetailTemplateId("template")
           .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            //.Groupable()
                            .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
        
          .Model(model =>
          {
              model.Id(p => p.EquipmentArrivalId);
              model.Field(p => p.EquipmentArrivalId).Editable(false);

          })
                               .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
              .Create(update => update.Action("EquipmentArrival_Create", "EquipmentArrival").Data("sendForgery"))
          .Read(read => read.Action("EquipmentArrival_Read", "EquipmentArrival").Data("sendForgery"))
          .Update(update => update.Action("EquipmentArrival_Update", "EquipmentArrival").Data("sendForgery"))
          .Destroy(update => update.Action("EquipmentArrival_Destroy", "EquipmentArrival").Data("sendForgery"))
      ))



<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                                            .Name("tabStrip_#=EquipmentArrivalId#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
                items.Add().Text("Detail").Content(
                    @<text>
                        <legend>Detail</legend>

                        <div class="box">

                            <div class="box-col">

                                # if (IsSendForApproval == false || IsSendForApproval == "false")
                                {#
                                <a href='@Url.Action("EquipmentArrival_SendForOnlineApproval", "EquipmentArrivalApproval")/?Id=#=EquipmentArrivalId#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                # }#
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-1">
                            </div>
                            <div class="col-md-6" style="margin-top:20px;">

                                <div class="form-group">
                                    @Html.LabelFor(model => model.CreatedBy):<span>#=CreatedBy#</span>

                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.DateCreated):<span>#=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #</span>

                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.ModifiedBy):<span>#=ModifiedBy#</span>

                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.LastModified):<span>#=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy')#</span>

                                </div>



                            </div>
                        </div>



                    </text>


            );
                items.Add().Text(" Approval").Content(@<text>
              
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.EquipmentArrivalApproval>()
                                                                                                .Name("EquipmentArrivalApproval#=EquipmentArrivalId#")
                        .Columns(columns =>
                        {
                            columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                            columns.Bound(o => o.Remark).Width(200);
                            columns.Bound(c => c.CreatedBy).Width(150);
                            columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                            columns.Command(command => { command.Edit(); }).Width(250);

                        }).Events(ev =>
                                               {
                                                   ev.DataBound("approveonDataBound");
                                               })
                             .Editable(editable => editable.Mode(GridEditMode.InLine))
                                       .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(5)
                                                        .Model(model =>
                              {
                                  model.Id(p => p.EquipmentArrivalApprovalId);
                                  model.Field(p => p.CreatedBy).Editable(false);
                                  model.Field(p => p.DateCreated).Editable(false);
                              })
                                                                                .Events(ev => ev
                                                            .Error("error_handler(\"EquipmentArrivalApproval#=EquipmentArrivalId#\")")
                                                            .RequestStart("onRequestStart(\"EquipmentArrivalApproval#=EquipmentArrivalId#\")")
                                                            .RequestEnd("onRequestEnd(\"EquipmentArrivalApproval#=EquipmentArrivalId#\")"))
                                                                                                                                                                           .Create(update => update.Action("EquipmentArrival_Approve", "EquipmentArrivalApproval", new { EId = "#=EquipmentArrivalId#" }).Data("sendForgery"))
                                                                                                                                                                             .Read(read => read.Action("EquipmentArrivalApproval_Read", "EquipmentArrivalApproval", new { EId = "#=EquipmentArrivalId#" }).Data("sendForgery"))
                                                                                                                   .Update(update => update.Action("EquipmentArrival_Approve", "EquipmentArrivalApproval", new { EId = "#=EquipmentArrivalId#" }).Data("sendForgery"))


                                                      )
                                               .ToClientTemplate())
                </text>
                );
            })
                                                                                                                                                                                                                                                                                                                                                    .ToClientTemplate())
</script>

<style>
    div.k-edit-form-container {
        width: auto;
        height: auto;
    }

    .row .col-sm-2 {
        width: 150px;
    }

    .row {
        margin: auto;
    }

    .chkbx {
        pointer-events: none;
    }

    .chkbox {
        width: 100px;
        height: 25px;
    }
</style>



<script type="text/javascript">


    var IsApproved;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        IsApproved = masterDataItem.IsOnlineApproved;
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            console.log(dataItem.IsOnlineApproved);
            if (dataItem.IsSendForApproval == true || dataItem.IsSendForApproval == "true") {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            } if (dataItem.IsOnlineApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

    function BindDetail() {

        var Fleetsobj = $("#FleetsId").data("kendoDropDownList");
        var fleetID = Fleetsobj.value();
        $.ajax({
            url: '@Url.Action("GetAssignEquipmentDDBind", "FleetDataProvider")',
            data: { Id: fleetID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r != 0) {
                    var s = r.split(/_/);
                    $("#EquipmentType").val(s[0]);
                    $("#KMHRReading").val(s[1]);
                    $("#Model").val(s[2]);
                    $("#OperatorName").val(s[3]);
                    $("#DCENo").val(s[4]);
                    $("#OwnedBy").val(s[5]);
                  



                } else {
                    

                }
            }

        });
    }
</script>