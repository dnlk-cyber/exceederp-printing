@model ExceedERP.Core.Domain.FleetManagement.FleetRegistration.EquipmentArrival
 
<legend>Equipment Arrival</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.EquipmentArrival>()
      .Name("grid")
      .Columns(columns =>
          {
       
          columns.Bound(o => o.EquipmentType);
         
          columns.Bound(o => o.DCENo).Title("Asset No");
          columns.Bound(o => o.KMHRReading);
          columns.Bound(o => o.OwnedBy);
          columns.Bound(o => o.MeansOfTravelling);
          columns.Bound(o => o.Date).Format("{0:d}");
          columns.Bound(o => o.OperatorName);
          columns.Bound(o => o.Status);

          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

          }).Events(ev =>
                                               {
                                                   ev.DataBound("onDataBound"); ev.DetailExpand("onDetailExpandUser");
                                               })
           .ToolBar(commands =>
                  {
                      commands.Create(); commands.Excel();
                      commands.Pdf();
                  }).Editable(editable =>
          {
              editable.Mode(GridEditMode.PopUp).TemplateName("EquipmentArrivalEditor").Window(x => x.Title("Equipment Arrival"));
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Arrival");
          }).ClientDetailTemplateId("template")
           .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Groupable()
                            .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .ServerOperation(false)
          .Model(model =>
              {
              model.Id(p => p.EquipmentArrivalId);
              model.Field(p => p.EquipmentArrivalId).Editable(false);
                 
              })
                               .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
              .Create(update => update.Action("EquipmentArrival_Create", "EquipmentArrival"))
          .Read(read => read.Action("EquipmentArrival_Read", "EquipmentArrival"))
          .Update(update => update.Action("EquipmentArrival_Update", "EquipmentArrival"))
          .Destroy(update => update.Action("EquipmentArrival_Destroy", "EquipmentArrival"))
      ))



<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                                            .Name("tabStrip_#=EquipmentArrivalId#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
                items.Add().Text("Detail").Content(
                    @<text>
                        <legend>Detail</legend>

                        <div class="box">

                            <div class="box-col">

                                # if (IsSendForApproval == false || IsSendForApproval == "false")
                                {#
                                <a href='@Url.Action("EquipmentArrival_SendForOnlineApproval", "EquipmentArrivalApproval")/?Id=#=EquipmentArrivalId#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                # }#
                            </div>
                        </div>

                        <div class="demo-section k-header export-app">
                            <div class="demo-section content-wrapper">

                                <form>



                                    <div class="row">
                                        <div class="col-md-1">
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <div class="label">
                                                    @Html.LabelFor(model => model.CreatedBy)
                                                </div>
                                                <div>
                                                    #=CreatedBy#

                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <div class="label">
                                                    @Html.LabelFor(model => model.DateCreated)
                                                </div>
                                                <div>
                                                    #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <div class="label">
                                                    @Html.LabelFor(model => model.ModifiedBy)
                                                </div>
                                                <div>

                                                    #=ModifiedBy#

                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <div class="label">
                                                    @Html.LabelFor(model => model.LastModified)
                                                </div>
                                                <div>
                                                    #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #

                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                </form>

                            </div>
                        </div>



                    </text>


            );
                items.Add().Text(" Approval").Content(@<text>
              
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.EquipmentArrivalApproval>()
                                                                                                .Name("EquipmentArrivalApproval#=EquipmentArrivalId#")
                        .Columns(columns =>
                        {
                            columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                            columns.Bound(o => o.Remark).Width(200);
                            columns.Bound(c => c.CreatedBy).Width(150);
                            columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                            columns.Command(command => { command.Edit(); }).Width(250);

                        }).Events(ev =>
                                               {
                                                   ev.DataBound("approveonDataBound");
                                               })
                             .Editable(editable => editable.Mode(GridEditMode.InLine))
                                       .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(5)
                                                        .Model(model =>
                              {
                                  model.Id(p => p.EquipmentArrivalApprovalId);
                                  model.Field(p => p.CreatedBy).Editable(false);
                                  model.Field(p => p.DateCreated).Editable(false);
                              })
                                                                                .Events(ev => ev
                                                            .Error("error_handler(\"EquipmentArrivalApproval#=EquipmentArrivalId#\")")
                                                            .RequestStart("onRequestStart(\"EquipmentArrivalApproval#=EquipmentArrivalId#\")")
                                                            .RequestEnd("onRequestEnd(\"EquipmentArrivalApproval#=EquipmentArrivalId#\")"))
                                                                                                                                                                           .Create(update => update.Action("EquipmentArrival_Approve", "EquipmentArrivalApproval", new { EId = "#=EquipmentArrivalId#" }))
                                                                                                                                                                             .Read(read => read.Action("EquipmentArrivalApproval_Read", "EquipmentArrivalApproval", new { EId = "#=EquipmentArrivalId#" }))
                                                                                                                   .Update(update => update.Action("EquipmentArrival_Approve", "EquipmentArrivalApproval", new { EId = "#=EquipmentArrivalId#" }))


                                                      )
                                               .ToClientTemplate())
                </text>
                );
            })
                                                                                                                                                                                                                                                                                                                                                    .ToClientTemplate())
</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>



<script type="text/javascript">


    var IsApproved;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        IsApproved = masterDataItem.IsOnlineApproved;
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            console.log(dataItem.IsOnlineApproved);
            if (dataItem.IsSendForApproval == true || dataItem.IsSendForApproval == "true") {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            } if (dataItem.IsOnlineApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

    function BindDetail() {

        var Fleetsobj = $("#FleetsId").data("kendoDropDownList");
        var fleetID = Fleetsobj.value();
        $.ajax({
            url: '@Url.Action("GetAssignEquipmentDDBind", "FleetDataProvider")',
            data: { Id: fleetID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r != 0) {
                    var s = r.split(/_/);
                    $("#EquipmentType").val(s[0]);
                    $("#KMHRReading").val(s[1]);
                    $("#Model").val(s[2]);
                    $("#OperatorName").val(s[3]);
                    $("#DCENo").val(s[4]);
                    $("#OwnedBy").val(s[5]);
                  



                } else {
                    

                }
            }

        });
    }
</script>