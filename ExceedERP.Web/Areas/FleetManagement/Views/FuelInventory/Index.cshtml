@model ExceedERP.Core.Domain.FleetManagement.FuelManagement.FuelInventory
@{
    ViewBag.Title = "Fuel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Fuel Depot</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FuelManagement.FuelInventory>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.SiteName).Width(140);

        columns.Bound(e => e.Quantity).Title("Qty (Liter)").Width(120);
        columns.Bound(e => e.TotalPrice).Width(120);

        columns.Command(command => {   }).Width(200);


    })
                .ToolBar(commands => commands.Create())
      .Editable(editable =>
      {
          editable.Mode(GridEditMode.PopUp).TemplateName("FuelEditor");
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Fuel Fill Information");
      })
     .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                                //.Groupable()
                                .Scrollable(h => h.Height(500))
                                       .ClientDetailTemplateId("template")
                                  .Events(ev => {
                                      ev.DetailExpand("onDetailExpandUser");
                                      ev.DataBound("onDataBound");
                                  })

    .DataSource(dataSource => dataSource
        .Ajax()
        .Model(model =>
        {
            model.Id(p => p.FuelInventoryId);

        })                          .Events(ev => ev
                              .Error("error_handler(\"grid\")")
                              .RequestStart("onRequestStart(\"grid\")")
                              .RequestEnd("onRequestEnd(\"grid\")"))
                        .Create(update => update.Action("FuelInventory_Create", "FuelInventory").Data("sendForgery"))
                            .Read(read => read.Action("FuelInventoryDistinctSite_Read", "FuelInventory").Data("sendForgery"))
                        .Update(update => update.Action("FuelInventory_Update", "FuelInventory").Data("sendForgery"))
                        .Destroy(update => update.Action("FuelInventory_Destroy", "FuelInventory").Data("sendForgery"))
  )
)


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                            .Name("tabStrip_#=FuelInventoryId#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
                items.Add().Text("Detail").Content(
                    @<text>
                        <div>
                            <div class="box">

                                <div class="box-col">

                                    # if (IsSendForApproval == false || IsSendForApproval == "false")
                                    {#

                                    <a href='@Url.Action("Fuel_SendForOnlineApproval", "FuelIssueApproval")/?EId=#=FuelInventoryId#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                    # }#
                                </div>
                            </div>
                            <div class="demo-section k-header export-app">
                                <div class="demo-section content-wrapper">

                                    <form>



                                        <div class="row">
                                            <div class="col-md-1">
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.CreatedBy)
                                                    </div>
                                                    <div>
                                                        #=CreatedBy#

                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.DateCreated)
                                                    </div>
                                                    <div>
                                                        #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.ModifiedBy)
                                                    </div>
                                                    <div>

                                                        #=ModifiedBy#

                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.LastModified)
                                                    </div>
                                                    <div>
                                                        #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #

                                                    </div>
                                                </div>
                                            </div>

                                        </div>


                                        <div class="row">
                                            <div class="col-md-1">
                                            </div>

                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.Remark)
                                                    </div>
                                                    <div>
                                                        #=Remark#

                                                    </div>
                                                </div>
                                            </div>
                                            </div>
</form>

                                </div>
                            </div>

                        </div>

                    </text>


            );
            
             items.Add().Text(" Log ").Content(@<text>

             
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FuelManagement.FuelInventory>()
        .Name("gridLog")
    .Columns(columns =>
    {
        
        columns.Bound(e => e.FuelType).Width(140);
        columns.Bound(e => e.UnitPrice).Title("Unit Price").Width(140);
        columns.Bound(e => e.Quantity).Title("Qty").Width(120);
        columns.Bound(e => e.TotalPrice).Width(120);
        
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(200);


    })
       
      .Editable(editable =>
      {
          editable.Mode(GridEditMode.PopUp).TemplateName("FuelEditor");
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Fuel Fill Information");
      })
 
                                 
                                  .Groupable().Events(ev => {   ev.DataBound("onDataBound"); })
 
    .DataSource(dataSource => dataSource
        .Ajax()
        .Model(model =>
              {
                  model.Id(p => p.FuelInventoryId);
               
              })                          .Events(ev => ev
                                        .Error("error_handler(\"gridLog\")")
                                        .RequestStart("onRequestStart(\"gridLog\")")
                                        .RequestEnd("onRequestEnd(\"gridLog\")"))
                        .Create(update => update.Action("FuelInventory_Create", "FuelInventory").Data("sendForgery"))
                                .Read(read => read.Action("FuelInventoryBySite_Read", "FuelInventory", new { Site = "#=SiteName#" }).Data("sendForgery"))
                        .Update(update => update.Action("FuelInventory_Update", "FuelInventory").Data("sendForgery"))
                        .Destroy(update => update.Action("FuelInventory_Destroy", "FuelInventory").Data("sendForgery"))
  
)
                                               .ToClientTemplate())
                </text>
                );
                items.Add().Text(" Approval").Content(@<text>

                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FuelManagement.FuelIssueApproval>()
                                                                                        .Name("FuelApproval#=FuelInventoryId#")
                        .Columns(columns =>
                        {
                            columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                            columns.Bound(o => o.Remark).Width(200);
                            columns.Bound(c => c.CreatedBy).Width(150);
                            columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                            columns.Command(command => { command.Edit(); }).Width(250);

                        }).Events(ev =>
                        {
                            ev.DataBound("approveonDataBound");
                        })
                             .Editable(editable => editable.Mode(GridEditMode.InLine))
                                       .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(5)
                                                            .Model(model =>
                                      {
                                          model.Id(p => p.FuelIssueApprovalID);
                                          model.Field(p => p.CreatedBy).Editable(false);
                                          model.Field(p => p.DateCreated).Editable(false);
                                      })
                                                           
                                                                                .Events(ev => ev
                                                    .Error("error_handler(\"FuelApproval#=FuelInventoryId#\")")
                                                    .RequestStart("onRequestStart(\"FuelApproval#=FuelInventoryId#\")")
                                                    .RequestEnd("onRequestEnd(\"FuelApproval#=FuelInventoryId#\")"))
                                                                                                   .Create(update => update.Action("Fuel_Approve", "FuelIssueApproval", new { EId = "#=FuelInventoryId#" }).Data("sendForgery"))
                                                                                     .Read(read => read.Action("FuelIssueApproval_Read", "FuelIssueApproval", new { EId = "#=FuelInventoryId#" }).Data("sendForgery"))
                                                                   .Update(update => update.Action("Fuel_Approve", "FuelIssueApproval").Data("sendForgery"))


                                                      )
                                               .ToClientTemplate())
                </text>
                );
            })
                                                                                                                                                                                                                                                                                .ToClientTemplate())
</script>



<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
<script type="text/javascript">
    
    function BindFuelDetail() {

        var Fleetsobj = $("#FleetsID").data("kendoDropDownList");
        var fleetID = Fleetsobj.value();
        $.ajax({
            url: '@Url.Action("FleetsDetailDDBind", "EquipmentRegistration")',
            data: { FleetsID: fleetID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r != 0) {
                    var s = r.split(/_/);
                    $("#FuelType").val(s[1]);
                    $("#FuelStandard").val(s[0]);
                } else {
                    $("#FuelType").val('0.0');
                    $("#FuelStandard").val('0.0');
                }
            }

        });
     
    }
    var IsApproved;
    var IsSendForApproved;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        IsApproved = masterDataItem.IsOnlineApproved;
        IsSendForApproved = masterDataItem.IsSendForApproval;
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            console.log(dataItem.IsOnlineApproved);
            if (dataItem.IsSendForApproval == true || dataItem.IsSendForApproval == "true") {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

      function approveonDataBound(e) {
          var grid = this;

          grid.tbody.find("tr[role='row']").each(function () {
              var dataItem = grid.dataItem(this);
              if (dataItem.Status == "Approve" || IsApproved == true) {
                  console.log("Approved");
                  $(this).find(".k-grid-edit").remove();
                  $(this).find(".k-grid-delete").remove();
              }
          });
      }
      
  </script>
