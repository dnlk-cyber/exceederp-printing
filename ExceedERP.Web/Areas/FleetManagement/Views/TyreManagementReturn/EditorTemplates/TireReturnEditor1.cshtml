@model ExceedERP.Core.Domain.FleetManagement.FleetTireManagement.TireReturn
@using ExceedERP.Core.Domain.FleetManagement.FleetTireManagement
@using ExceedERP.Helpers.Common


<script>
    function filterTyre() {

        var dropdownlist = $("#SerialNo").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            fleetId: $("#FleetId").val(),
            search: filterInput.val()
        };


    }
</script>
<div class="demo-section k-content">
    <form>



        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.PlateNumber)
                        @(Html.Kendo().DropDownListFor(model => model.FleetId)
                               .DataTextField("PlateNumber")
                               .DataValueField("FleetsID")
                               .OptionLabel(" Select ")
                               // .Events(e => e.Change("BinddDetail"))
                               .Filter(FilterType.Contains)
                               .DataSource(d => d.Read(r =>
                               r.Action("FleetsTyreIssuedDDBind", "FleetManagementDataProvider"))
                               .ServerFiltering(false)))
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.SerialNo)
                    </div>
                    <div>
                        @(Html.Kendo().DropDownListFor(model => model.SerialNo)
                                                        .DataTextField("SerialNo")
                                                        .DataValueField("SerialNo")
                                                        .Filter(FilterType.Contains)
                                                        .OptionLabel("Select ")
                                                        .DataSource(d =>
                                                           {
                                                               d.Read(r =>
                                                                       {
                                                                           r.Action("FleetsTyreIssuedSerialsDDBind", "FleetManagementDataProvider").Data("filterTyre");
                                                                       })
                                                                       .ServerFiltering(true);
                                                           }).Events(e => e.Change("BindDetail"))
                                                           .Enable(false)
                                                           .AutoBind(false)
                                                              .CascadeFrom("FleetId"))
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">

                        @Html.LabelFor(model => model.IssueType)
                        @(Html.Kendo().DropDownListFor(model => model.IssueType)
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .BindTo(EnumExtension.EnumToSelectList(typeof(FleetIssueType))
                            )
                        )
                    </div>
                </div>
            </div>



        </div>

        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.Brand)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.Brand).Enable(false)
                        @Html.ValidationMessageFor(model => model.Brand)
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.TireTube)
                    </div>
                    @( Html.Kendo().TextBoxFor(m => m.TireTube).Enable(false))
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        <div class="k-label">
                            @Html.LabelFor(model => model.TireType)
                        </div>
                        @( Html.Kendo().TextBoxFor(m => m.TireType).Enable(false))
                    </div>
                </div>
            </div>




        </div>
       
        
        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.StoreCode)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.StoreCode).Enable(false)
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.InstalledDate)
                    </div>
                    <div>
                        @Html.Kendo().DatePickerFor(model => model.InstalledDate).Enable(false)
                        @Html.ValidationMessageFor(model => model.InstalledDate)
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.UnitPrice)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.UnitPrice).Enable(false)
                        @Html.ValidationMessageFor(model => model.UnitPrice)
                    </div>
                </div>
            </div>

            
        </div>

        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.KMReading)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.KMReading).Enable(false)
                        @Html.ValidationMessageFor(model => model.KMReading)
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.TireSize)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.TireSize).Enable(false)
                        @Html.ValidationMessageFor(model => model.TireSize)
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.DescriptionReason)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.DescriptionReason)
                        @Html.ValidationMessageFor(model => model.DescriptionReason)
                    </div>
                </div>
            </div>


        </div>
    </form>
</div>
