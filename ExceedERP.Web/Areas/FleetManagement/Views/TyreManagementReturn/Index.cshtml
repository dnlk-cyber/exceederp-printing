@model ExceedERP.Core.Domain.FleetManagement.FleetTireManagement.TireReturn
@{
    ViewBag.Title = "Tire Return";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Tire/Battery Return</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTireManagement.TireReturn>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.ReturnType).Width(140);
        columns.Bound(e => e.StoreCode).Width(140);
        columns.Bound(e => e.PlateNumber).Width(140);
        columns.Bound(e => e.SerialNo).Width(140);
        columns.Bound(e => e.Brand).Width(140);
        columns.Bound(e => e.TireSize).Width(120);

        columns.Bound(e => e.UnitPrice).Width(120);
        columns.Bound(e => e.Status).Width(100);



        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);


    })
           .ToolBar(toolbar => toolbar.Create())
      .Editable(editable =>
      {
          editable.Window(w => w.Title("Tyre Return"));
          editable.Mode(GridEditMode.PopUp).TemplateName("TireReturnEditor");
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Tire Return Information");
      })
         .HtmlAttributes(new { style = "height: 520px;" })
                              .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))

                                    .Scrollable()
                                    .Sortable()
                                    .Filterable()
                                    //.Groupable()
                                    .Scrollable(h => h.Height(500))
                                              .ClientDetailTemplateId("template")
                                                                       .Events(ev => { ev.DetailExpand("onDetailExpandUser"); ev.DataBound("onDataBound"); })
    .DataSource(dataSource => dataSource
        .Ajax()
        .ServerOperation(false)
        .Model(model =>
              {
                  model.Id(p => p.TireReturnID);

              }).Events(ev => ev
                                                            .Error("error_handler(\"grid\")")
                                                            .RequestStart("onRequestStart(\"grid\")")
                                                            .RequestEnd("onRequestEnd(\"grid\")"))
                    .Create(update => update.Action("TireReturn_Create", "TyreManagementReturn"))
                    .Read(read => read.Action("TireReturn_Read", "TyreManagementReturn"))
                    .Update(update => update.Action("TireReturn_Update", "TyreManagementReturn"))
                    .Destroy(update => update.Action("TireReturn_Destroy", "TyreManagementReturn"))
  )
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                            .Name("tabStrip_#=TireReturnID#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {


                items.Add().Text("Detail").Content(
                    @<text>
                        <legend>Detail</legend>

                        <div class="box">

                            <div class="box-col">
                                # if (IsSendForApproval == false || IsSendForApproval == "false")
                                {#

                                <a href='@Url.Action("TireReturn_SendForOnlineApproval", "TireReturnApproval")/?EId=#=TireReturnID#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                # }#

                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-1">
                            </div>
                            <div class="col-md-6" style="margin-top:20px;">

                                <div class="form-group">
                                    @Html.LabelFor(model => model.CreatedBy):<span>#=CreatedBy#</span>

                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.DateCreated):<span>#=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #</span>

                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.ModifiedBy):<span>#=ModifiedBy#</span>

                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.LastModified):<span>#=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy')#</span>

                                </div>



                            </div>
                        </div>



                    </text>


            );
                items.Add().Text(" Approval").Content(@<text>

                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTireManagement.TireReturnApproval>()
                                                                                        .Name("TireReturnApproval#=TireReturnID#")
                        .Columns(columns =>
                        {
                            columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                            columns.Bound(o => o.Remark).Width(200);
                            columns.Bound(c => c.CreatedBy).Width(150);
                            columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                            columns.Command(command => { command.Edit(); }).Width(250);

                        }).Events(ev =>
                                               {
                                                   ev.DataBound("approveonDataBound");
                                               })
                             .Editable(editable => editable.Mode(GridEditMode.InLine))
                                 .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(5)
                                                        .Model(model =>
                              {
                                  model.Id(p => p.TireReturnApprovalID);
                                  model.Field(p => p.CreatedBy).Editable(false);
                                  model.Field(p => p.DateCreated).Editable(false);
                              })
                                                                                .Events(ev => ev
                                                    .Error("error_handler(\"TireReturnApproval#=TireReturnID#\")")
                                                    .RequestStart("onRequestStart(\"TireReturnApproval#=TireReturnID#\")")
                                                    .RequestEnd("onRequestEnd(\"TireReturnApproval#=TireReturnID#\")"))
                                                                                                           .Create(update => update.Action("TireReturn_Approve", "TireReturnApproval", new { EId = "#=TireReturnID#" }))
                                                                                             .Read(read => read.Action("TireReturnApproval_Read", "TireReturnApproval", new { EId = "#=TireReturnID#" }))
                                                                                           .Update(update => update.Action("TireReturn_Approve", "TireReturnApproval", new { EId = "#=TireReturnID#" }))


                                                      )
                                               .ToClientTemplate())
                </text>
                );
            })
                                                                                                                                                                                                                                                                                                                                                                                                    .ToClientTemplate())
</script>

<script type="text/javascript">

    function BindDetail() {

        var fleetIdDropDown = $("#FleetId").data("kendoDropDownList");
        var fleetId = fleetIdDropDown.value();
        $.ajax({
            url: '@Url.Action("GetTyreInfo", "EquipmentTyre")',
            data: { Id: fleetId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r != 0) {
                    var s = r.split(/_/);
                    $("#IssueType").val(s[8]);
                    $("#Brand").val(s[0]);
                    $("#TireTube").val(s[7]);
                    $("#TireType").val(s[2]);
                    $("#TireSize").val(s[1]);
                    $("#UnitPrice").val(s[4]);
                    $("#InstalledDate").val(s[6]);
                    $("#StoreCode").val(s[5]);
                    $("#KMReading").val(s[3]);
                } else {
                    $("#KMReading").val('0.0');

                }
            }

        });

    }

</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
<script type="text/javascript">


    var IsApproved;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        IsApproved = masterDataItem.IsOnlineApproved;
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            console.log(dataItem.IsOnlineApproved);
            if (dataItem.IsSendForApproval == true || dataItem.IsSendForApproval == "true") {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            } if (dataItem.IsOnlineApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

</script>