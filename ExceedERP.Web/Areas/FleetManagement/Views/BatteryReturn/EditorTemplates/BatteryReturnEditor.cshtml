@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@model  ExceedERP.Core.Domain.FleetManagement.BatteryManagement.BatteryReturn
@Html.HiddenFor(model => model.BatteryReturnId)

<script>
    function filterBattery() {
        return {
            Id: $("#PlateNumber").val()
        };
    }
</script>

<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.PlateNumber, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.PlateNumber).Name("PlateNumber")
                          .DataTextField("SerialNo")
                          .DataValueField("EquipmentBatteryId").OptionLabel(" Select ").Filter(FilterType.Contains)
                          .DataSource(d => d.Read(r => r.Action("FleetsTyreReadingDDBind", "EquipmentRegistration").Data("sendForgery")).ServerFiltering(false)))
                    @Html.ValidationMessageFor(model => model.PlateNumber, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.BatteryType, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.BatteryType).HtmlAttributes(new { @disabled = "disabled" })
                    @Html.ValidationMessageFor(model => model.BatteryType, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.KMReading, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.KMReading).HtmlAttributes(new { @disabled = "disabled" })
                    @Html.ValidationMessageFor(model => model.KMReading, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
        </div>

        <div class="col-md-3 ro1">

            <div class="form-group">
                @Html.LabelFor(model => model.SerialNo, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.SerialNo).Name("SerialNo")
                           .DataTextField("Text")
                           .DataValueField("Value")
                           .OptionLabel("Select ").DataSource(d =>
                               {
                                   d.Read(r =>
                                   {
                                       r.Action("BatteryByFleetByPlate", "EquipmentBattery").Data("filterBattery");
                                   })
                                   .ServerFiltering(true);
                               })
                           .Events(e => e.Change("BindDetail"))
                           .Enable(false)
                           .AutoBind(false)
                           .CascadeFrom("PlateNumber"))
                    @Html.ValidationMessageFor(model => model.SerialNo, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.StoreCode, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.StoreCode).Enable(false)
                    @Html.ValidationMessageFor(model => model.StoreCode, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>



            <div class="form-group">
                @Html.LabelFor(model => model.InstalledDate, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model=>model.InstalledDate).Enable(false)
                    @Html.ValidationMessageFor(model => model.InstalledDate, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
        </div>

        <div class="col-md-3 ro1">


            <div class="form-group">
                @Html.LabelFor(model => model.Brand, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Brand).Enable(false)
                    @Html.ValidationMessageFor(model => model.Brand, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.UnitPrice, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.UnitPrice).Enable(false)
                    @Html.ValidationMessageFor(model => model.UnitPrice, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                    @Html.LabelFor(model => model.DescriptionReason, htmlAttributes: new { @class = "control-label col-md-8" })
                    <div class="col-md-6">
                        @Html.Kendo().TextBoxFor(model => model.DescriptionReason)
                        @Html.ValidationMessageFor(model => model.DescriptionReason, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row"></div>


            @*<div class="form-group">
                    @Html.LabelFor(model => model.OutstandingBalance, htmlAttributes: new { @class = "control-label col-md-8" })
                    <div class="col-md-6">
                        @Html.Kendo().TextBoxFor(model => model.OutstandingBalance).HtmlAttributes(new {@disabled="disabled", @style = "color: coral;" })
                        @Html.ValidationMessageFor(model => model.OutstandingBalance, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row"></div>*@

        </div>
    </div>
</div>
