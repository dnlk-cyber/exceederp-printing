@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@model  ExceedERP.Core.Domain.FleetManagement.EquipmentPlanandEvaluation.EquipmentPlanandEvaluations

<script>

    function filterByType() {
        var dropdownlist = $("#EquipmentName").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
           equipmentTypeId: $("#EquipmentCategoryId").val(),
            Search: filterInput.val()
        };

    }

    function filterEquipmentName() {

        var dropdownlist = $("#EquipmentNameId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentTypeId: $("#EquipmentTypeId").val(),
            search: filterInput.val()
        };

    }
    function PopulateFleets() {
        var dropdownlist = $("#FleetId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentNameId: $("#EquipmentNameId").val(),
            search: filterInput.val()
        };


    }
    function filterEquipmentIdentity() {
        var dropdownlist = $("#EquipmentTypeId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentIdentityId: $("#EquipmentCategoryId").val(),
            search: filterInput.val()
        };
    }
</script>

<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.EquipmentCategoryId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.EquipmentCategoryId)
                          .DataTextField("Name")
                          .DataValueField("Id").Filter(FilterType.Contains)
                          .OptionLabel("Select Equipment Category")
                          //.HtmlAttributes(new { style = "width:100%" })
                          .DataSource(d => d.Read(r => r.Action("GetEquipmentIdentities", "FleetManagementDataProvider"))
                          .ServerFiltering(false)))
                    @Html.ValidationMessageFor(model => model.EquipmentCategoryId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.FleetId)
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.FleetId)
                                              .AutoBind(false)
                                              .Enable(false)
                                              .DataTextField("PlateNumber")
                                              .DataValueField("FleetsID")
                                              .Filter(FilterType.Contains)
                                              .OptionLabel("Select")
                                              .DataSource(d => d.Read(r => r.Action("FleetsDDBind", "FleetManagementDataProvider")
                                              .Data("PopulateFleets")).ServerFiltering(true)).CascadeFrom("EquipmentNameId"))
                    @Html.ValidationMessageFor(model => model.FleetId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.PlanTyreUtilization, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().NumericTextBoxFor(model => model.PlanTyreUtilization)
                    @Html.ValidationMessageFor(model => model.PlanTyreUtilization, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.UnitOfMeasurement, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.UnitOfMeasurement)
                    @Html.ValidationMessageFor(model => model.UnitOfMeasurement, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.VolumeUnit, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-12">
                    @Html.Kendo().TextBoxFor(model => model.VolumeUnit)
                    @Html.ValidationMessageFor(model => model.VolumeUnit, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

        </div>

        <div class="col-md-3 ro1">

            <div class="form-group">
                @Html.LabelFor(model => model.EquipmentTypeId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">

                    @(Html.Kendo().DropDownListFor(model => model.EquipmentTypeId)
                            .DataTextField("Name")
                            .DataValueField("Id")
                            .OptionLabel("Select Equipment Type")
                            .Filter(FilterType.Contains)
                            //.HtmlAttributes(new { style = "width:100%" })
                            .DataSource(d =>
                            {
                                d.Read(r =>
                            {
                                r.Action("GetEquipmentTypes", "FleetManagementDataProvider")
                                        .Data("filterEquipmentIdentity");
                            })
                           .ServerFiltering(true);
                            })
                             .Enable(false)
                             .AutoBind(false)
                             .CascadeFrom("EquipmentCategoryId")
                    )

                    @Html.ValidationMessageFor(model => model.EquipmentTypeId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.PlanIdletime, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().NumericTextBoxFor(model=>model.PlanIdletime)
                    @Html.ValidationMessageFor(model => model.PlanIdletime, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.PlanIncome, "Tax Type", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().NumericTextBoxFor(model=>model.PlanIncome)
                    @Html.ValidationMessageFor(model => model.PlanIncome, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                    @Html.Label("Other Cost", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-12">
                    @Html.Kendo().NumericTextBoxFor(model => model.PlanEquipmentsPittyCashExpenditure)
                    @Html.ValidationMessageFor(model => model.PlanEquipmentsPittyCashExpenditure, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.WorkingVolume, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().NumericTextBoxFor(model=>model.WorkingVolume)
                    @Html.ValidationMessageFor(model => model.WorkingVolume, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>




        </div>

        <div class="col-md-3 ro1">


            <div class="form-group">
                @Html.LabelFor(model => model.EquipmentNameId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.EquipmentNameId)
                                      .AutoBind(false)
                                      .Enable(false)
                                      .DataTextField("Name")
                                      .DataValueField("Id")
                                      .Filter(FilterType.Contains)
                                      .OptionLabel("Select")
                                      .DataSource(d => d.Read(r => r.Action("GetEquipmentNames", "FleetManagementDataProvider")
                                      .Data("filterEquipmentName")).ServerFiltering(true)).CascadeFrom("EquipmentTypeId"))
                    @Html.ValidationMessageFor(model => model.EquipmentNameId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.PlanDowntime, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-12">
                    @Html.Kendo().TextBoxFor(model => model.PlanDowntime)
                    @Html.ValidationMessageFor(model => model.PlanDowntime, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Description)
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.PlanWorkingtime, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().NumericTextBoxFor(model => model.PlanWorkingtime)
                    @Html.ValidationMessageFor(model => model.PlanWorkingtime, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>


            <div class="form-group">
                @Html.LabelFor(model => model.PlanFuelConsumption, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().NumericTextBoxFor(model => model.PlanFuelConsumption)
                    @Html.ValidationMessageFor(model => model.PlanFuelConsumption, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

        </div>
    </div>
</div>
