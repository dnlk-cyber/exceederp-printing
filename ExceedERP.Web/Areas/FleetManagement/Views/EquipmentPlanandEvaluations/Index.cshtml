@model ExceedERP.Core.Domain.FleetManagement.EquipmentPlanandEvaluation.EquipmentPlanandEvaluations
@{
    ViewBag.Title = "Equipment Plan and Evaluations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    function filterEquipmentIdentity() {
        var dropdownlist = $("#EquipmentCategoryId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            EquipmentIdentityID: $("#EquipmentTypeId").val(),
            Search: filterInput.val()
        };
         
    }
</script>
<legend>Equipment Plan and Evaluations</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.EquipmentPlanandEvaluation.EquipmentPlanandEvaluations>()
    .Name("grid")
    .Columns(columns =>
    {
     //   columns.ForeignKey(c => c.Category, (System.Collections.IEnumerable)ViewData["EquipmentCategory"], "EquipmentCategoryName", "EquipmentCategoryName").Width(140);
      //  columns.ForeignKey(c => c.Type, (System.Collections.IEnumerable)ViewData["EquipmentType"], "EquipmentTypeName", "EquipmentTypeName").Width(140);
        columns.Bound(e => e.EquipmentName).Title("Plate No./ Tag No. ").Width(100);
    
         columns.Bound(e => e.PlanFuelConsumption).Title("Plan Consumption ").Width(120);
        columns.Bound(e => e.PlanIncome).Width(100);
        columns.Bound(e => e.PlanWorkingtime).Width(100);
        columns.Bound(e => e.Status).Width(100);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(200);

    })
               .ToolBar(commands => commands.Create())
         .Editable(editable =>
         {
             editable.Mode(GridEditMode.PopUp).TemplateName("PlanEditor").Window(x => x.Title("Equipment Plan and Evaluations "));
             editable.DisplayDeleteConfirmation("Are You Sure To Remove Plan");
         })
           .HtmlAttributes(new { style = "height: 520px;" })
                        .Pageable(pageable => pageable
                                          .Input(true)
                                          .Numeric(false)
                                          .Refresh(true)
                                          .PageSizes(true)
                                          .ButtonCount(5))

                              .Scrollable()
                              .Sortable()
                              .Filterable()
                              .Groupable()
                              .Scrollable(h => h.Height(500))
                                           .ClientDetailTemplateId("template")
                                        .Groupable().Events(ev => { ev.DetailExpand("onDetailExpandUser"); ev.DataBound("onDataBound"); })

                              .DataSource(dataSource => dataSource
        .Ajax()
        .ServerOperation(false)
              .Model(model => model.Id(p => p.EquipmentPlanandEvaluationsID))
                                       .Events(ev => ev
                                      .Error("error_handler(\"grid\")")
                                      .RequestStart("onRequestStart(\"grid\")")
                                      .RequestEnd("onRequestEnd(\"grid\")"))
                                   .Create(update => update.Action("EquipmentPlanandEvaluations_Create", "EquipmentPlanandEvaluations"))
                                          .Read(read => read.Action("EquipmentPlanandEvaluations_Read", "EquipmentPlanandEvaluations"))
                                          .Update(update => update.Action("EquipmentPlanandEvaluations_Update", "EquipmentPlanandEvaluations"))
                                    .Destroy(update => update.Action("EquipmentPlanandEvaluations_Destroy", "EquipmentPlanandEvaluations"))
  )
)


<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                            .Name("tabStrip_#=EquipmentPlanandEvaluationsID#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
                items.Add().Text("Detail").Content(
                    @<text>
                        <div>
                            <div class="box">

                                <div class="box-col">

                                    # if (IsSendForApproval == false || IsSendForApproval == "false")
                                    {#

                                    <a href='@Url.Action("EquipmentPlanandEvaluations_SendForOnlineApproval", "PlanAndEvaluationApproval")/?EId=#=EquipmentPlanandEvaluationsID#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                    # }#
                                </div>
                            </div>
                            <div class="demo-section k-header export-app">
                                <div class="demo-section content-wrapper">

                                    <form>



                                        <div class="row">
                                            <div class="col-md-1">
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.CreatedBy)
                                                    </div>
                                                    <div>
                                                        #=CreatedBy#

                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.DateCreated)
                                                    </div>
                                                    <div>
                                                        #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.ModifiedBy)
                                                    </div>
                                                    <div>

                                                        #=ModifiedBy#

                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <div class="label">
                                                        @Html.LabelFor(model => model.LastModified)
                                                    </div>
                                                    <div>
                                                        #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #

                                                    </div>
                                                </div>
                                            </div>

                                        </div>

                                    </form>

                                </div>
                            </div>

                        </div>

                    </text>


            );
                items.Add().Text(" Approval").Content(@<text>

                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.EquipmentPlanandEvaluation.EquipmentPlanEvaluationApproval>()
                                                                                        .Name("Approval#=EquipmentPlanandEvaluationsID#")
                        .Columns(columns =>
                        {
                            columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                            columns.Bound(o => o.Remark).Width(200);
                            columns.Bound(c => c.CreatedBy).Width(150);
                            columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                            columns.Command(command => { command.Edit(); }).Width(250);

                        }).Events(ev =>
                        {
                            ev.DataBound("approveonDataBound");
                        })
                             .Editable(editable => editable.Mode(GridEditMode.InLine))
                                       .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(5)
                                                            .Model(model =>
                                      {
                                          model.Id(p => p.EquipmentPlanEvaluationApprovalId);
                                          model.Field(p => p.CreatedBy).Editable(false);
                                          model.Field(p => p.DateCreated).Editable(false);
                                      })

                                                                                .Events(ev => ev
                                                    .Error("error_handler(\"Approval#=EquipmentPlanandEvaluationsID#\")")
                                                    .RequestStart("onRequestStart(\"Approval#=EquipmentPlanandEvaluationsID#\")")
                                                    .RequestEnd("onRequestEnd(\"Approval#=EquipmentPlanandEvaluationsID#\")"))
                                                                                                                   .Create(update => update.Action("EquipmentPlanandEvaluations_Approve", "PlanAndEvaluationApproval", new { EId = "#=EquipmentPlanandEvaluationsID#" }))
                                                                                                     .Read(read => read.Action("EquipmentPlanEvaluationApproval_Read", "PlanAndEvaluationApproval", new { EId = "#=EquipmentPlanandEvaluationsID#" }))
                                                                                   .Update(update => update.Action("EquipmentPlanandEvaluations_Approve", "PlanAndEvaluationApproval"))


                                                      )
                                               .ToClientTemplate())
                </text>
                );
            })
                                                                                                                                                                                                                                                                                                                                            .ToClientTemplate())
</script>



<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
<script type="text/javascript">

    var IsApproved;
    var IsSendForApproved;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        IsApproved = masterDataItem.IsOnlineApproved;
        IsSendForApproved = masterDataItem.IsSendForApproval;
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            console.log(dataItem.IsOnlineApproved);
            if (dataItem.IsSendForApproval == true || dataItem.IsSendForApproval == "true") {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

</script>

<script type="text/javascript">

    function BindFuelDetail() {

        var Fleetsobj = $("#FleetsID").data("kendoDropDownList");
        var fleetID = Fleetsobj.value();

        $.ajax({
            url: '@Url.Action("FleetsDetailDDBind", "EquipmentRegistration")',
            data: { FleetsID: fleetID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r != 0) {
                    var s = r.split(/_/);
                    $("#RentalRate").val(s[2]);
                } else {
                    $("#RentalRate").val('0');

                }
            }

        });
    }
</script>
