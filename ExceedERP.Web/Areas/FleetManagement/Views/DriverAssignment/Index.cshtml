@model ExceedERP.Core.Domain.FleetManagement.FleetResource.DriverAssignment
@{
    ViewBag.Title = "Driver Assignment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Driver Assignment</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.DriverAssignment>()
      .Name("grid")
      .Columns(columns =>
          {
              columns.Bound(e => e.EquipmentName).Width(120);
             columns.Bound(e => e.ToOperatorName).Width(120);
              columns.Bound(e => e.DateCreated).Title("Date").Format("{0:d}").Width(100);
              columns.Bound(e => e.Status).Width(100);


              columns.Command(command =>
                  {
                      command.Edit(); command.Destroy();
                  }).Width(250);


          }).Events(ev =>
                                                 {
                                                     ev.DetailExpand("onDetailExpand");
                                                     ev.DataBound("onDataBound");

                                                 })
      .ToolBar(commands => commands.Create())
      .Editable(editable =>
          {
              editable.Mode(GridEditMode.PopUp).TemplateName("DriverVehicleTransferEditor").Window(x => x.Title(" Driver Assignemnt "));
              editable.DisplayDeleteConfirmation("Are You Sure To Remove Driver Assignment");
          })
          .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Groupable()
                            .Scrollable(h => h.Height(500))
                                            .ClientDetailTemplateId("template")
                                         .Groupable().Events(ev => { ev.DetailExpand("onDetailExpandUser"); ev.DataBound("onDataBound"); })
               .DataSource(dataSource => dataSource
          .Ajax()
          .ServerOperation(false)
                   .Model(model =>
              {
                  model.Id(p => p.DriverAssignmentId);

              })
                         .Events(ev => ev
                                .Error("error_handler(\"grid\")")
                                .RequestStart("onRequestStart(\"grid\")")
                                .RequestEnd("onRequestEnd(\"grid\")"))
                  .Create(update => update.Action("DriverAssignment_Create", "DriverAssignment"))
                  .Read(read => read.Action("DriverAssignment_Read", "DriverAssignment"))
                  .Update(update => update.Action("DriverAssignment_Update", "DriverAssignment"))
                  .Destroy(update => update.Action("DriverAssignment_Destroy", "DriverAssignment"))
      ))


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                            .Name("tabStrip_#=DriverAssignmentId#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
                items.Add().Text("Detail").Content(
                    @<text>
                        <legend>Detail</legend>

                        <div class="box">

                            <div class="box-col">

                                # if (IsSendForApproval == false || IsSendForApproval == "false")
                                {#
                                <a href='@Url.Action("DriverVehicleTransfer_SendForOnlineApproval", "DriverAssignmentApproval")/?EId=#=DriverAssignmentId#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                # }#
                            </div>
                        </div>

                        <div class="demo-section k-header export-app">
                            <div class="demo-section content-wrapper">

                                <form>



                                    <div class="row">
                                        <div class="col-md-1">
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <div class="label">
                                                    @Html.LabelFor(model => model.CreatedBy)
                                                </div>
                                                <div>
                                                    #=CreatedBy#

                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <div class="label">
                                                    @Html.LabelFor(model => model.DateCreated)
                                                </div>
                                                <div>
                                                    #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <div class="label">
                                                    @Html.LabelFor(model => model.ModifiedBy)
                                                </div>
                                                <div>

                                                    #=ModifiedBy#

                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <div class="label">
                                                    @Html.LabelFor(model => model.LastModified)
                                                </div>
                                                <div>
                                                    #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #

                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                </form>

                            </div>
                        </div>



                    </text>


            );
                items.Add().Text(" Approval").Content(@<text>
     
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.DriverTransferApproval>()
                                                                                        .Name("DriverTransferApproval#=DriverAssignmentId#")
                        .Columns(columns =>
                        {
                            columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                            columns.Bound(o => o.Remark).Width(200);
                            columns.Bound(c => c.CreatedBy).Width(150);
                            columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                            columns.Command(command => { command.Edit(); }).Width(250);

                        }).Events(ev =>
                                               {
                                                   ev.DataBound("approveonDataBound");
                                               })
                             .Editable(editable => editable.Mode(GridEditMode.InLine))
                                       .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(5)
                                                        .Model(model =>
                              {
                                  model.Id(p => p.DriverTransferApprovalID);
                                  model.Field(p => p.CreatedBy).Editable(false);
                                  model.Field(p => p.DateCreated).Editable(false);
                              })
                                                                                .Events(ev => ev
                                                    .Error("error_handler(\"DriverTransferApproval#=DriverAssignmentId#\")")
                                                    .RequestStart("onRequestStart(\"DriverTransferApproval#=DriverAssignmentId#\")")
                                                    .RequestEnd("onRequestEnd(\"DriverTransferApproval#=DriverAssignmentId#\")"))
                                                                                                                                                                           .Create(update => update.Action("DriverVehicleTransfer_Approve", "DriverAssignmentApproval", new { EId = "#=DriverAssignmentId#" }))
                                                                                                                                                                             .Read(read => read.Action("DriverVehicleTransferApproval_Read", "DriverAssignmentApproval", new { EId = "#=DriverAssignmentId#" }))
                                                                                                                           .Update(update => update.Action("DriverVehicleTransfer_Approve", "DriverAssignmentApproval", new { EId = "#=DriverAssignmentId#" }))


                                                      )
                                               .ToClientTemplate())
                </text>
                );
            })
                                                                                                                                                                                                                                                                                                                                                    .ToClientTemplate())
</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>

<script type="text/javascript">
    function filterEquipmentType() {
        return {
            Id: $("#EquipmentTypeID").val()
        };
    }
   
    var IsApproved;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        IsApproved = masterDataItem.IsOnlineApproved;
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
           
            if (dataItem.IsSendForApproval == true || dataItem.IsSendForApproval == "true") {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            if (dataItem.IsOnlineApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

</script>