@model ExceedERP.Core.Domain.FleetManagement.FleetResource.DriverAssignment
@{
    ViewBag.Title = "Driver Assignment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Driver Assignment</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.DriverAssignment>()
      .Name("grid")
      .Columns(columns =>
      {
          
          columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["category"], "Value", "Text").Width(120);
          columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["type"], "Value", "Text").Width(120);
          columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["name"], "Value", "Text").Width(120);
          columns.ForeignKey(e => e.FleetId, (System.Collections.IEnumerable)ViewData["equipmentName"], "Id", "Name").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);
          columns.ForeignKey(e => e.BranchId, (System.Collections.IEnumerable)ViewData["Branch"], "Value", "Text").Width(120);
          columns.ForeignKey(e => e.OperatorId, (System.Collections.IEnumerable)ViewData["Operators"], "Id", "Name").Width(120);
          columns.ForeignKey(e => e.SecondOperatorId, (System.Collections.IEnumerable)ViewData["OperatorTwo"], "Id", "Name").Width(120);
                   columns.Bound(e => e.StartingDate).Title("Starting Date").Format("{0:d}").Width(100);
          columns.Bound(e => e.Status).Width(100);
          columns.Command(command =>
          {
              command.Edit(); command.Destroy();
          }).Width(250);


      }).Events(ev =>
      {
          ev.DetailExpand("onDetailExpand");
          ev.DataBound("onDataBound");

      })
      .ToolBar(commands => commands.Create())
      .Editable(editable =>
      {
          editable.Mode(GridEditMode.PopUp).TemplateName("DriverVehicleAssignmentEditor").Window(x => x.Title(" Driver Assignemnt "));
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Driver Assignment");
      })
          .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            //.Groupable()
                            .Scrollable(h => h.Height(500))
                                            .ClientDetailTemplateId("template")
                                         .Events(ev => {
                                             ev.DetailExpand("onDetailExpandUser");
                                             ev.DataBound("onDataBound");
                                         })
               .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add(e => e.DateCreated).Descending())
      
                   .Model(model =>
                   {
                       model.Id(p => p.DriverAssignmentId);

                   })
                         .Events(ev => ev
                                .Error("error_handler(\"grid\")")
                                .RequestStart("onRequestStart(\"grid\")")
                                .RequestEnd("onRequestEnd(\"grid\")"))
                  .Create(update => update.Action("DriverAssignment_Create", "DriverAssignment").Data("sendForgery"))
                  .Read(read => read.Action("DriverAssignment_Read", "DriverAssignment").Data("sendForgery"))
                  .Update(update => update.Action("DriverAssignment_Update", "DriverAssignment").Data("sendForgery"))
                  .Destroy(update => update.Action("DriverAssignment_Destroy", "DriverAssignment").Data("sendForgery"))
      ))


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                            .Name("tabStrip_#=DriverAssignmentId#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
                items.Add().Text("Detail").Content(
                    @<text>
                        <legend>Detail</legend>

                        <div class="box">

                            <div class="box-col">

                                # if (!IsSendForApproval)
                                {#
                                <a href='@Url.Action("DriverVehicleTransfer_SendForOnlineApproval", "DriverAssignmentApproval")/?EId=#=DriverAssignmentId#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                # }#
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-1">
                            </div>
                            <div class="col-md-6" style="margin-top:20px;">
                                <ul>
                                    <li>
                                        @Html.LabelFor(model => model.CreatedBy):<span>#=CreatedBy#</span>
                                    </li>
                                    <li>
                                        @Html.LabelFor(model => model.DateCreated):<span>#=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #</span>
                                    </li>
                                    <li>
                                        @Html.LabelFor(model => model.ModifiedBy):<span>#=ModifiedBy#</span>
                                    </li>
                                    <li>
                                        @Html.LabelFor(model => model.LastModified):<span>#=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy')#</span>
                                    </li>
                                </ul>




                            </div>

                        </div>



                    </text>


            );
                items.Add().Text("Approval").Content(@<text>
     
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.DriverTransferApproval>()
                        .Name("DriverTransferApproval#=DriverAssignmentId#")
                        .Columns(columns =>
                        {
                            columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126); 

                            columns.Bound(o => o.Remark).Width(200);
                            columns.Bound(c => c.CreatedBy).Width(150);
                            columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                            columns.Command(command => { command.Edit(); }).Width(250);

                        }).Events(ev =>
                        {
                            ev.DataBound("approveonDataBound");
                        })
                        .ToolBar(commands => commands.Create())
                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .DataSource(dataSource => dataSource
                        .Ajax()
                        .PageSize(5)
                        .Model(model =>
                        {
                            model.Id(p => p.DriverTransferApprovalID);
                            model.Field(p => p.CreatedBy).Editable(false);
                            model.Field(p => p.DateCreated).Editable(false);
                        })
                        .Events(ev => ev
                        .Error("error_handler(\"DriverTransferApproval#=DriverAssignmentId#\")")
                        .RequestStart("onRequestStart(\"DriverTransferApproval#=DriverAssignmentId#\")")
                        .RequestEnd("onRequestEnd(\"DriverTransferApproval#=DriverAssignmentId#\")"))
                        .Create(update => update.Action("DriverVehicleTransfer_Approve", "DriverAssignmentApproval", new { EId = "#=DriverAssignmentId#" }).Data("sendForgery"))
                        .Read(read => read.Action("DriverVehicleTransferApproval_Read", "DriverAssignmentApproval", new { EId = "#=DriverAssignmentId#" }).Data("sendForgery"))
                        .Update(update => update.Action("DriverVehicleTransfer_Approve", "DriverAssignmentApproval", new { EId = "#=DriverAssignmentId#" }).Data("sendForgery"))
                        )
                        .ToClientTemplate())
                </text>
                );
            })
                                                                                                                                                                                                                                                                                                                                                    .ToClientTemplate())
</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>

<script type="text/javascript">
    function filterEquipmentType() {
        return {
            Id: $("#EquipmentTypeID").val()
        };
    }
   
    var IsApproved;
    var driverAssignmentId;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        driverAssignmentId = masterDataItem.DriverAssignmentId;
        IsApproved = masterDataItem.IsOnlineApproved;
        var approve = "#DriverTransferApproval" + driverAssignmentId;
        if (IsApproved) {
            $(".k-grid-top", approve).hide();
        }
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
           
            if (dataItem.IsSendForApproval == true || dataItem.IsSendForApproval == "true") {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            if (dataItem.IsOnlineApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }
    function filterOperator() {
        return {
            text: $("#OperatorId").data("kendoDropDownList").filterInput.val()
        }
    }
    function filterOperatorTwo() {
        return {
            text: $("#SecondOperatorId").data("kendoDropDownList").filterInput.val()
        }
    }
    function filterEquipmentNames() {
        var dropdownlist = $("#EquipmentNameId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentTypeId: $("#EquipmentTypeId").val(),
            search: filterInput.val()
        };
    }
    function filterPlateNumber() {
        var dropdownlist = $("#EquipmentName").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentNameID: $("#EquipmentNameID").val(),
            search: filterInput.val()
        };
    }
    function filterCategory() {
        var dropdownlist = $("#EquipmentTypeId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentIdentityId: $("#EquipmentCategoryId").val(),
            search: filterInput.val()
        };

    }
    function filterFleet() {
        return {
            text: $("#FleetId").data("kendoDropDownList").filterInput.val(),
            equipmentNameId: $("#EquipmentNameId").val()
        };
    }

</script>
<style>
    div.k-edit-form-container {
        width: auto;
        height: auto;
    }

    .row .col-sm-2 {
        width: 150px;
    }

    .row {
        margin: auto;
    }
</style>