@model ExceedERP.Core.Domain.FleetManagement.FleetResource.DriverAssignment



<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Category</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentCategoryId)
                            .AutoBind(true)
                            .DataTextField("Name")
                            .DataValueField("Id")
                            .Filter(FilterType.Contains)
                            .OptionLabel("Select Category")
                            .HtmlAttributes(new { style = "width:100%" })
                            .DataSource(d => d.Read(r => r.Action("GetEquipmentIdentities", "FleetManagementDataProvider").Data("sendForgery"))
                            .ServerFiltering(false)))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Type</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentTypeId)
                            .AutoBind(true)
                            .DataTextField("Name")
                            .DataValueField("Id")
                            .OptionLabel("Select Equipment Type")
                            .Filter(FilterType.Contains)
                            .DataSource(d =>
                            {
                                d.Read(r =>
                                {
                                    r.Action("GetEquipmentTypes", "FleetManagementDataProvider")
                                    .Data("filterCategory");
                                })
                                .ServerFiltering(true);
                            })
                            .Enable(false)
                            .AutoBind(false)
                            .CascadeFrom("EquipmentCategoryId")
                )
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Name</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentNameId)
                            .AutoBind(true)
                            .Enable(false)
                            .DataTextField("Name")
                            .DataValueField("Id")
                            .Filter(FilterType.Contains)
                            .OptionLabel("Select")
                            .DataSource(d => d.Read(r => r.Action("GetEquipmentNames", "FleetManagementDataProvider").Data("sendForgery")
                            .Data("filterEquipmentNames"))
                            .ServerFiltering(true))
                            .CascadeFrom("EquipmentTypeId"))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Plate/Serial</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.FleetId)
                            .AutoBind(true)
                            .Enable(false)
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .Filter(FilterType.Contains)
                            .OptionLabel("Select")
                            .DataSource(d => d.Read(r => r.Action("GetFleetForPlanAndEvaluation", "FleetManagementDataProvider").Data("sendForgery")
                            .Data("filterFleet"))
                            .ServerFiltering(true))
                            .CascadeFrom("EquipmentNameId"))
            </div>
        </div>
    </div>

</div>
<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Operator Name</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.OperatorId)
                                                           .ValuePrimitive(true)
                                                           .OptionLabel("Select Operator...")
                                                           .DataTextField("Text")
                                                           .DataValueField("Value")
                                                           .Filter("contains")

                                                           .DataSource(dataSource =>
                                                           {
                                                               dataSource.Read(read => read.Action("Operators", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery").Data("filterOperator"))
                                                               .ServerFiltering(true);
                                                           })
                )

            </div>
        </div>
    </div> 
    <div class="col-sm-2">
        <div class="form-group">
            <label>Operator Name</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.SecondOperatorId)
                                                           .ValuePrimitive(true)
                                                           .OptionLabel("Select Operator...")
                                                           .DataTextField("Text")
                                                           .DataValueField("Value")
                                                           .Filter("contains")

                                                           .DataSource(dataSource =>
                                                           {
                                                               dataSource.Read(read => read.Action("Operators", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery").Data("filterOperatorTwo"))
                                                               .ServerFiltering(true);
                                                           })
                )

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Branch</label>
            <div>
                @(Html.Kendo().DropDownListFor(m => m.BranchId)
                                        .DataTextField("Name")
                                        .DataValueField("Id")
                                        .Filter(FilterType.Contains)
                                        .OptionLabel("Select Branch")
                                        .HtmlAttributes(new { style = "width:100%" })
                                        .DataSource(d => d.Read(r => r.Action("GetBranches", "FleetManagementDataProvider").Data("sendForgery"))
                                        .ServerFiltering(false)))

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Starting Date</label>
            <div>
                @Html.Kendo().DatePickerFor(model => model.StartingDate)

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Remark</label>
            <div>
                @Html.Kendo().TextBoxFor(model => model.Remark)

            </div>
        </div>
    </div>
</div>
