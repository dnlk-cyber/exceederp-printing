@model ExceedERP.Core.Domain.FleetManagement.FleetResource.DriverAssignment

 <script>
     function filterEquipmentIdentity() {
      
         var dropdownlist = $("#EquipmentTypeID").data("kendoDropDownList");
         var filterInput = dropdownlist.filterInput;

         return {
             EquipmentIdentityID: $("#EquipmentIdentityID").val(),
             Search: filterInput.val()
         };

     }

     function filterEquipment() {
         var dropdownlist = $("#FleetId").data("kendoDropDownList");
         var filterInput = dropdownlist.filterInput;

         return {
             Type: $("#EquipmentName").val(), Search: filterInput.val()
         };
     }
     function filterByType() {
         var dropdownlist = $("#EquipmentName").data("kendoDropDownList");
         var filterInput = dropdownlist.filterInput;

         return {
             EquipmentTypeId: $("#EquipmentTypeID").val(),
             Search: filterInput.val()
         };

     }
 </script>

<div class="demo-section k-content">
    <form>
     

                    <div class="row">
                        <div class="col-md-1">
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <div class="k-label">
                              Equipment Category
                                </div>
                                @(Html.Kendo().DropDownList().Name("EquipmentIdentityID")
                                          .DataTextField("EquipmentCategoryName")
                                          .DataValueField("EquipmentIdentityID").Filter(FilterType.Contains).OptionLabel("Select ").HtmlAttributes(new { style = "width:100%" })
                                          .DataSource(d => d.Read(r => r.Action("EquipmentIdentityDDBind", "EquipmentCategory")).ServerFiltering(false)))

                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <div class="k-label">


                                   Equipment Type
                                </div>
                                @(Html.Kendo().DropDownList().Name("EquipmentTypeID")
                    .DataTextField("EquipmentTypeName")
                    .DataValueField("EquipmentTypeID").OptionLabel("Select").Filter(FilterType.Contains)
                    .HtmlAttributes(new { style = "width:100%" })
                    .DataSource(d =>
                    {
                        d.Read(r =>
                        {
                            r.Action("EquipmentTypeDDBind", "EquipmentType").Data("filterEquipmentIdentity");
                        })
                      .ServerFiltering(true);
                    })
              .Enable(false)
                      .AutoBind(false)
               .CascadeFrom("EquipmentIdentityID")
                                )



                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <div class="k-label">
                                    Equipment Name 
                                </div>
                                @(Html.Kendo().DropDownList().Name("EquipmentName")
                            .DataTextField("EquipmentName")
                            .DataValueField("EquipmentName").OptionLabel("Select").Filter(FilterType.Contains)
                    .HtmlAttributes(new { style = "width:100%" })
                    .DataSource(d =>
                    {
                        d.Read(r =>
                        {
                            r.Action("EquipmentNameFilterDDBind", "EquipmentRegistration").Data("filterByType");
                        })
                      .ServerFiltering(true);
                    })
              .Enable(false)
                              .AutoBind(false)
                                               .CascadeFrom("EquipmentTypeID")
                                )



                            </div>
                        </div>
               
                  

                      

                    </div>
                    <div class="row">
                        <div class="col-md-1">
                        </div>
     
            
                    </div>

        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.FleetId)
                    </div>
                    <div>
                        @(Html.Kendo().DropDownListFor(model => model.FleetId).Name("FleetId")
                          .DataTextField("PlateNumber")
                                  .DataValueField("FleetsID").OptionLabel(" Select ").Filter(FilterType.Contains)
                                                                                  .DataSource(d => d.Read(r => r.Action("UnAssignedEquipmentDDBind", "EquipmentRegistration").Data("filterEquipment")).ServerFiltering(true)).CascadeFrom("EquipmentName"))





                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.ToOperatorName)
                    </div>
                    <div>
                        @(Html.Kendo().DropDownListFor(model => model.ToOperatorName).Name("ToOperatorName")
                                          .DataTextField("FullName")
                                                          .DataValueField("FullName").OptionLabel(" Select ").Filter(FilterType.Contains)
                                                          .DataSource(d => d.Read(r => r.Action("OperatorUnAssignedDDBind", "OperatorRegistration").Data("filterEquipmentType")).ServerFiltering(false)))


                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.StartingDate)
                    </div>
                    <div>
                        @Html.Kendo().DatePickerFor(model => model.StartingDate)
                        @Html.ValidationMessageFor(model => model.StartingDate)
                    </div>
                </div>
            </div>

            </div>

        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.ToDate)
                    </div>
                    <div>
                        @Html.Kendo().DatePickerFor(model => model.ToDate)
                        @Html.ValidationMessageFor(model => model.ToDate)
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.Remark)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.Remark)
                        @Html.ValidationMessageFor(model => model.Remark)
                    </div>
                </div>
            </div>
        </div>



             
    </form>
</div>
