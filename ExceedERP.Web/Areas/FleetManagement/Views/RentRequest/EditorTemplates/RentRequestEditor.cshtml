@model ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentRequest


<div class="demo-section k-content">
    <form>
      

                    <div class="row">
                        <div class="col-md-1">
                        </div>
                    

                        <div class="col-md-3">
                            <div class="form-group">
                                <div class="k-label">
                                    @(Html.LabelFor(m => m.FromBranchName))
                                    @(Html.Kendo().DropDownListFor(model => model.FromBranchName).Name("FromBranchName")
        .DataTextField("Name")
                                .DataValueField("Name").OptionLabel(" Select ")
                    .DataSource(d => d.Read(r => r.Action("BranchDDBind", "Branch").Data("sendForgery"))))
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <div class="k-label">
                                    @(Html.LabelFor(m => m.FromStructureName))
                                    @(Html.Kendo().DropDownListFor(model => model.FromStructureName).Name("FromStructureName")
                                           .DataTextField("Name")
                                        .DataValueField("Name").OptionLabel(" Select")
                                    .DataSource(d => d.Read(r => r.Action("StructureDDBind", "Structure").Data("sendForgery"))))
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-1">
                        </div>
                      
                 
       
        
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.Description)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.Description)
                        @Html.ValidationMessageFor(model => model.Description)
                    </div>
                </div>
            </div>
            </div>
    
</form> 
</div>