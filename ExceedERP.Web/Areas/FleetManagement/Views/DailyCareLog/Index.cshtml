@model ExceedERP.Core.Domain.FleetManagement.FleetMaintenance.DailyCareLog



<legend>Daily Care Log</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetMaintenance.DailyCareLog>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.FleetsId, (System.Collections.IEnumerable)ViewData["Fleets"], "FleetsId", "PlateNumber").EditorTemplateName("EquipmentEditor");
          columns.Bound(c => c.Operator);
          columns.Bound(c => c.Location);
          columns.Bound(c => c.Description);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
               .HtmlAttributes(new { style = "height: 520px;" })
                                  .Pageable(pageable => pageable
                                                    .Input(true)
                                                    .Numeric(false)
                                                    .Refresh(true)
                                                    .PageSizes(true)
                                                    .ButtonCount(5))
                                         .Sortable()
                                        .Filterable()
                                         .Scrollable(h => h.Height(500))
                                           .ClientDetailTemplateId("template").DataSource(dataSource => dataSource
          .Ajax()
                  .Model(model => { model.Id(p => p.DailyCareLogId); model.Field(x => x.Location).Editable(false); model.Field(x => x.Operator).Editable(false); })
                          .Events(ev => ev
                                                            .Error("error_handler(\"grid\")")
                                                            .RequestStart("onRequestStart(\"grid\")")
                                                            .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("DailyCareLogs_Read", "DailyCareLog"))
          .Create(create => create.Action("DailyCareLogs_Create", "DailyCareLog"))
          .Update(update => update.Action("DailyCareLogs_Update", "DailyCareLog"))
          .Destroy(destroy => destroy.Action("DailyCareLogs_Destroy", "DailyCareLog"))
      )
)

