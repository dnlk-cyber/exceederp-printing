@(Html.Kendo().DropDownListFor(model => model) 
      .DataTextField("UoMName")
      .DataValueField("UoMName")
      .OptionLabel("Select Unit of Measurement")
      .Filter("contains")
      .IgnoreCase(true)
      .HtmlAttributes(new { style = "width:100%" })
      .DataSource(d => d.Read(r => r.Action("getUnitOfMeasurement", "FleetManagementDataProvider").Data("sendForgery"))
      .ServerFiltering(true)))
