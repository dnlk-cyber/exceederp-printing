@(Html.Kendo().DropDownListFor(model => model) 
      .DataTextField("Name")
      .DataValueField("Id")
      .OptionLabel("Select Fleet Category")
      .Filter("contains")
      .IgnoreCase(true)
      .HtmlAttributes(new { style = "width:100%" })
      .DataSource(d => d.Read(r => r.Action("GetEquipmentIdentities", "FleetManagementDataProvider")
      .Data("filterEquipmentCategories")).ServerFiltering(true)))
