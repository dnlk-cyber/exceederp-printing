@model ExceedERP.Web.Areas.FleetManagement.Models.TechnicalApprovalViewModel
@(Html.Kendo().ComboBoxFor(model => model.MaintenanceCenter).Name("MaintenanceCenter").HtmlAttributes(new { @class = "form-control" })
                                .DataTextField("Text")
                                .DataValueField("Value").Placeholder("Select Center")
                    .HtmlAttributes(new { style = "width:100%" })
                    .DataSource(d =>
                    {
                        d.Read(r =>
                        {
                            r.Action("MaintenanceCenterByTypeDDBind", "MaintenanceCenter").Data("filterMaintenanceCenter");
                     })
                                  .ServerFiltering(true);
                          }).ValuePrimitive(true)
                           .CascadeFrom("Type"))