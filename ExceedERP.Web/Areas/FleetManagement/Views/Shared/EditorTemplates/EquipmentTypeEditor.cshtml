
    @(Html.Kendo().DropDownListFor(model => model)
        .HtmlAttributes(new { @class = "form-control" })
        .Enable(false)
        .AutoBind(false)
        .DataTextField("Name")
        .ValuePrimitive(true)
        .DataValueField("Id")
        .OptionLabel("Select")
        .Filter("contains")
        .IgnoreCase(true)
        .CascadeFrom("EquipmentIdentityID")
        .DataSource(d => d.Read(r => r.Action("GetEquipmentTypes", "FleetManagementDataProvider").Data("sendForgery")
        .Data("filterEquipmentTypes"))
        .ServerFiltering(true)))