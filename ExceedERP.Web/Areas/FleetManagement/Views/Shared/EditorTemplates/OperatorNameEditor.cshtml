            .DataValueField("OperatorID")
            .OptionLabel("Select")
            .Filter("contains")
            .DataSource(d => d.Read(r => r.Action("OperatorForDistribution", "FleetManagementDataProvider")
            .Data("filterEquipmentTypes"))
            ))