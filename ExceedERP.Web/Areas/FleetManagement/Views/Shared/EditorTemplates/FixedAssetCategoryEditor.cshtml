<script>
    function onChangeCategory(e) {
       
        $.ajax({
            url: '@Url.Action("GetFixedAssetCategoryById", "FleetManagementDataProvider")',
            data: { assetCategoryId: this.value() },
            type: 'GET',
            cache: false,
            success: function (result) {
                $("#EquipmentCategoryName").val(result.Name).trigger("change");
                $("#Description").val(result.Description).trigger("change");


            }
        });

    }
</script>

@(Html.Kendo().DropDownListFor(m=>m)
    .Name("FixedAssetCategoryId")
    .ValuePrimitive(true)
    .OptionLabel("Select")

      .DataTextField("Name")
      .DataValueField("Id")
      .Events(ev=>ev.Change("onChangeCategory"))
      .Filter("contains")
      .IgnoreCase(true)
      .DataSource(d => d.Read(r => 







      r.Action("GetFixedAssetCategories", "FleetManagementDataProvider"))))