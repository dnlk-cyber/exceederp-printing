
@{
    ViewBag.Title = "Wagon Drill Timesheet";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var checkIsMIDROC = (string)ViewBag.IsMIDROC;
    bool isMIDROC = (ViewBag.setting as string) == "MIDROC";
    var IsMCG = (ViewBag.setting as string) == "MCG";
}


<legend>Wagon Drill Timesheet</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.WagonDrillTimesheet>()
                   .Name("grid")
                   .Columns(columns =>
                   {
                   columns.Bound(c => c.WagonDrillTimesheetId).Title("#").Width(70);
                   columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["category"], "Value", "Text").Width(120);
                   columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["type"], "Value", "Text").Width(120);
                   columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["name"], "Value", "Text").Width(120);
                   columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["fleet"], "Value", "Text").Title("Serial No").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
                   columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["ProcurementSupplier"], "ProcurementSupplierID", "Name").Title("Supplier Name").Width(100);
                   columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branch"], "BranchId", "Name").Title("Branch Name").Width(100);
                   columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessunit"], "Id", "Name").Title("Business unit").Width(100);
                   columns.ForeignKey(c => c.OperatorId, (IEnumerable)ViewData["operator"], "Value", "Text").Title("Operator").Width(100);
                   columns.Bound(c => c.ExternalOperatorName).Title("External Operator").Width(100);
                   if (isMIDROC == false)
                   {
                       columns.Bound(c => c.FuelInLiter).Width(100);
                       columns.Bound(c => c.FuelType).Width(100);
                   }
                   if (IsMCG == true)
                   {
                       columns.Bound(c => c.IdleReason).Width(100);
                       columns.Bound(c => c.DownReason).Width(100);
                       columns.Bound(c => c.FuelKMR).Width(100);
                       columns.Bound(c => c.InitialEHR).Width(100);
                       columns.Bound(c => c.FinalEHR).Width(100);
                       columns.Bound(c => c.DifferenceEHR).Width(100);
                       columns.Bound(c => c.MorningTimeStart).Width(100);
                       columns.Bound(c => c.MorningTimeEnd).Width(100);
                       columns.Bound(c => c.AfternoonTimeStart).Width(100);
                       columns.Bound(c => c.AfternoonTimeEnd).Width(100);
                       columns.Bound(c => c.NightTimeStart).Width(100);
                       columns.Bound(c => c.NightTimeEnd).Width(100);
                       columns.Bound(c => c.TotalTime).Width(100);
                       columns.Bound(c => c.Unit).Title("Unit").Width(100);
                       columns.Bound(c => c.Volume).Title("Volume").Width(100);
                       columns.Bound(c => c.OilConsumption).Title("Oil Consumption").Width(100);
                   }
                   columns.Bound(c => c.MaintenanceCost).Width(100);
                   columns.Bound(c => c.TireCost).Width(100);
                   columns.Bound(c => c.TotalCost).Width(100);
                   columns.Bound(c => c.WorkItem).Width(100);
                   columns.Bound(c => c.OperationNetWorkingHour).Width(120);
                   columns.Bound(c => c.IdleHour).Width(120);
                   columns.Bound(c => c.DownTime).Width(120);
                   columns.Bound(c => c.NumberOfHolesDrilled).Width(120);
                   columns.Bound(c => c.OperationDrilledHoleDepth).Width(120);
                   columns.Bound(c => c.IdleRateHour).Width(120);
                   columns.Bound(c => c.TimeSheetStatus).Width(120);


                   columns.Command(command => { command.Edit().UpdateText("save").CancelText("Cancel").Text("Edit"); command.Destroy().Text("Delete"); }).Title("Action").Width(200);
                   if (IsMCG || isMIDROC)
                   {
                       columns.Template(@<text></text>)
                                                  .ClientTemplate(
                                                  "# if (!TimeSheetSendForAproval&& !TimeSheetApproved) { #" +
                                                      "<input type='checkbox' class='approveCheckbox' />" +
                                                  "# } else { #" +
                                                      "<input type='checkbox' disabled='disabled' />" +
                                                  "# } #")
                                                  .Title("Request Approval")
                                                  .Width(60);
                       columns.Template(@<text></text>)
                                                  .ClientTemplate(
                                                  "# if (TimeSheetSendForAproval&& !TimeSheetApproved) { #" +
                                                      "<input type='checkbox' class='approveCheckbox' />" +
                                                  "# } else { #" +
                                                      "<input type='checkbox' disabled='disabled' />" +
                                                  "# } #")
                                                  .Title("Approve")
                                                  .Width(60);
                       columns.Template(@<text></text>)
                                                  .ClientTemplate(
                                                  "# if (TimeSheetSendForAproval&& TimeSheetApproved&&!CostSheetApproved) { #" +
                                                      "<input type='checkbox' class='approveCheckbox' />" +
                                                  "# } else { #" +
                                                      "<input type='checkbox' disabled='disabled' />" +
                                                  "# } #")
                                                  .Title("Reject")
                                                  .Width(60);
                       }
                   })
                             .ToolBar(toolbar =>
                             {
                             toolbar.Template(@<text>
                                    <!-- Always visible -->
                                    <a class="k-button k-button-icontext k-grid-add" href="#">
                                        <span class="k-icon k-i-plus"></span>
                                        Add New Record
                                    </a>
                                    <!-- Conditional content -->
                                    @if (isMIDROC||IsMCG)
