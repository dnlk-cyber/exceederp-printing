                                        </button><button type="button"
                                                class="k-button k-primary"
                                                onclick="RejectSelected()">
                                            Reject Selected
                                        </button>
                                                }
                                    /**/
                                    /**/
                                    /**/

                                </text>);
                                    })
                                      .Editable(editable => editable.Mode(GridEditMode.PopUp)
                                      .TemplateName("WagonDrillTimesheetTemplate")
                                      .Window(win => win.Title("Wagon Drill Timesheets").Width(800)))
                                      .Pageable()
                                      .Filterable()
                                      .Events(e => e.DataBound("dataBound"))
                                      .Events(e => e.DetailExpand("onDetailExpand"))
                                      .Scrollable(s => s.Height(550))
                                      .DataSource(dataSource => dataSource
                                          .Ajax()
                                          .Sort(s => s.Add(e => e.WagonDrillTimesheetId).Descending())
                                          .Model(model => model.Id(p => p.WagonDrillTimesheetId))
                                          .Events(ev => ev
                                                       .Error("error_handler(\"grid\")")
                                                       .RequestStart("onRequestStart(\"grid\")")
                                                       .RequestEnd("onRequestEnd(\"grid\")"))
                                          .Read(read => read.Action("WagonDrillTimesheets_Read", "WagonDrillTimesheet").Data("sendForgery"))
                                          .Create(create => create.Action("WagonDrillTimesheets_Create", "WagonDrillTimesheet").Data("sendForgery"))
                                          .Update(update => update.Action("WagonDrillTimesheets_Update", "WagonDrillTimesheet").Data("sendForgery"))
                                          .Destroy(destroy => destroy.Action("WagonDrillTimesheets_Destroy", "WagonDrillTimesheet").Data("sendForgery"))
                                      ).ClientDetailTemplateId("template")
)




