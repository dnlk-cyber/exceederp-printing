
@{
    ViewBag.Title = "Wagon Drill Timesheet";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Wagon Drill Timesheet</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.WagonDrillTimesheet>()
                    .Name("grid")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.WagonDrillTimesheetId).Title("#").Width(70);
                        columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["category"], "Value", "Text").Width(120);
                        columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["type"], "Value", "Text").Width(120);
                        columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["name"], "Value", "Text").Width(120);
                        columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["fleet"], "Value", "Text").Title("Serial No").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
                        columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["ProcurementSupplier"], "ProcurementSupplierID", "Name").Title("Supplier Name").Width(100);
                        columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branch"], "Value", "Text").Title("Branch Name").Width(100);
                        //columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branch"], "Value", "Text").Title("Branch Name").Width(100);
                        columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessunit"], "Value", "Text").Title("Business unit").Width(100);
                        columns.ForeignKey(c => c.OperatorId, (IEnumerable)ViewData["operator"], "Value", "Text").Title("Operator").Width(100);
                        columns.Bound(c => c.FuelCost).Width(100);
                        columns.Bound(c => c.LubricantCost).Title("Lubricant Consumption").Width(100);
                        columns.Bound(c => c.MaintenanceCost).Width(100);
                        columns.Bound(c => c.TireCost).Width(100);
                        columns.Bound(c => c.TotalCost).Width(100);
                        columns.Bound(c => c.WorkItem).Width(100);
                        columns.Bound(c => c.OperationNetWorkingHour).Width(120);
                        columns.Bound(c => c.IdleHour).Width(120);
                        columns.Bound(c => c.DownTime).Width(120);
                        columns.Bound(c => c.NumberOfHolesDrilled).Width(120);
                        columns.Bound(c => c.OperationDrilledHoleDepth).Width(120);
                        columns.Bound(c => c.IdleRateHour).Width(120);
                        columns.Bound(c => c.TimeSheetStatus).Width(120);


                        columns.Command(command => { command.Edit().UpdateText("save").CancelText("Cancel").Text("Edit"); command.Destroy().Text("Delete"); }).Title("Action").Width(200);
                    })
                    .ToolBar(toolbar =>
                    {
                        toolbar.Create();

                    })
                    .Editable(editable => editable.Mode(GridEditMode.PopUp)
                    .TemplateName("WagonDrillTimesheetTemplate")
                    .Window(win => win.Title("Wagon Drill Timesheets").Width(800)))
                    .Pageable()
                    .Filterable()
                    .Events(e => e.DataBound("dataBound"))
                    .Events(e => e.DetailExpand("onDetailExpand"))
                    .Scrollable(s => s.Height(550))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Sort(s => s.Add(e => e.WagonDrillTimesheetId).Descending())
                        .Model(model => model.Id(p => p.WagonDrillTimesheetId))
                        .Events(ev => ev
                                     .Error("error_handler(\"grid\")")
                                     .RequestStart("onRequestStart(\"grid\")")
                                     .RequestEnd("onRequestEnd(\"grid\")"))
                        .Read(read => read.Action("WagonDrillTimesheets_Read", "WagonDrillTimesheet").Data("sendForgery"))
                        .Create(create => create.Action("WagonDrillTimesheets_Create", "WagonDrillTimesheet").Data("sendForgery"))
                        .Update(update => update.Action("WagonDrillTimesheets_Update", "WagonDrillTimesheet").Data("sendForgery"))
                        .Destroy(destroy => destroy.Action("WagonDrillTimesheets_Destroy", "WagonDrillTimesheet").Data("sendForgery"))
                    ).ClientDetailTemplateId("template")
)




<script id="template" type="text/kendo-tmpl">

    @(Html.Kendo().TabStrip()
                                                   .Name("tabStrip_#=WagonDrillTimesheetId#")
                                                   .SelectedIndex(0)
                                                   .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                                                   .Items(items =>
                                                   {

                                                       items.Add().Text("Detail").Content(
                                                            @<text>
                                                                <legend>Detail</legend>
                                                                <div class="box">
                                                                    <div class="box-col">

                                                                        # if (TimeSheetSendForAproval == false)
                                                                        {#

                                                                        <a onclick='return sendForApproval("#=WagonDrillTimesheetId#")' href=' \#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                                                        # }#
                                                                        # if (TimeSheetSendForAproval == true&&TimeSheetApproved==true)
                                                                        {#

                                                                        <a onclick='return voidTimeSheet("#=WagonDrillTimesheetId#")' href=' \#' title="Void Record"><i class='fa  fa-bolt fa-2x' style='color:red'></i></a>
                                                                        # }#
                                                                    </div>
                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-md-1">
                                                                    </div>
                                                                    <div class="col-md-6" style="margin-top:20px;">
                                                                        <div class="form-group">
                                                                            <label>Status</label>: <span>#=TimeSheetStatus#</span>
                                                                        </div>
                                                                        <div class="form-group">
                                                                            <label>Created By</label>: <span>#=CreatedBy#</span>
                                                                        </div>
                                                                        <div class="form-group">
                                                                            <label>Date Created</label>: <span>#=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #</span>
                                                                        </div>
                                                                        <div class="form-group">
                                                                            <label>Approved By</label>: <span>#=TimeSheetApprovedBy#</span>
                                                                        </div>
                                                                        <div class="form-group">
                                                                            <label>Approved Date</label>: <span>#=kendo.toString(kendo.parseDate(TimeSheetApprovedDate), 'dd/MM/yyyy')#</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </text>
                                                                                       ); items.Add().Text("Approval").Content(@<text>

                                                                                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.TimeSheetApprovalNew>()
                                                                                                                            .Name("TimeSheetApproval#=WagonDrillTimesheetId#")
                                                                                                                            .Columns(columns =>
                                                                                                                            {
                                                                                                                                     columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                                                                                                                                     columns.Bound(o => o.Remark).Width(200);
                                                                                                                                     columns.Bound(c => c.CreatedBy).Width(150);
                                                                                                                                     columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                                                                                                                                     columns.Command(command => { command.Edit(); }).Width(250);

                                                                                                                                 })
                                                                                                                            .ToolBar(commands => commands.Create().Text("Approve Request"))
                                                                                                                            .Events(ev =>
                                                                                                                            {
                                                                                                                                     ev.DataBound("approvalDataBound");
                                                                                                                                 })
                                                                                                                            .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                                                                                    .DataSource(dataSource => dataSource
                                                                                                                                    .Ajax()
                                                                                                                                    .PageSize(5)
                                                                                                                                    .Model(model =>
                                                                                                                                    {
                                                                                                                                             model.Id(p => p.TimeSheetApprovalNewId);
                                                                                                                                             model.Field(p => p.CreatedBy).Editable(false);
                                                                                                                                             model.Field(p => p.DateCreated).Editable(false);
                                                                                                                                         })
                                                                                                                                    .Events(ev => ev
                                                                                                                                    .Error("error_handler(\"TimeSheetApproval#=WagonDrillTimesheetId#\")")
                                                                                                                                    .RequestStart("onRequestStart(\"TimeSheetApproval#=WagonDrillTimesheetId#\")")
                                                                                                                                    .RequestEnd("onRequestEnd(\"TimeSheetApproval#=WagonDrillTimesheetId#\")"))

                                                                                                                                    .Create(update => update.Action("WagonDrillTimeSheetApproval_Create", "WagonDrillTimesheet", new { Id = "#=WagonDrillTimesheetId#" }).Data("sendForgery"))
                                                                                                                                    .Read(read => read.Action("DumpTruckTimeSheetApproval_Read", "WagonDrillTimesheet", new { Id = "#=WagonDrillTimesheetId#" }).Data("sendForgery"))
                                                                                                                                    .Update(update => update.Action("WagonDrillTimeSheetApproval_Create", "WagonDrillTimesheet").Data("sendForgery"))


                                                                                                                                )
                                                                                                                                .ToClientTemplate())
                                                                                    </text>
                                                                                                    );
                                                                }).ToClientTemplate())


</script>


<script>
    function filterEquipmentType() {
        var dropdownlist = $("#EquipmentTypeId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        
        return {
            timeSheetEquipmentType: "@ViewBag.wagonDrill",
            equipmentIdentityId: $("#EquipmentCategoryId").val(),
            search: filterInput.val()
        };

    }

    function filterEquipmentNames() {
        var dropdownlist = $("#EquipmentNameId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentTypeId: $("#EquipmentTypeId").val(),
            search: filterInput.val()
        };
    }

    function filterFleet() {
        return {
            text: $("#FleetId").data("kendoDropDownList").filterInput.val(),
            equipmentNameId: $("#EquipmentNameId").val()
        };
    }
    var timeSheetApproved;
    var timeSheetSendForAproval;
    var wagonDrillTimeSheetId;

    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = this;

        var masterDataItem = masterGrid.dataItem(masterRow);

        timeSheetApproved = masterDataItem.TimeSheetApproved;

        timeSheetSendForAproval = masterDataItem.TimeSheetSendForAproval;

        wagonDrillTimeSheetId = masterDataItem.WagonDrillTimesheetId;


        var firstValidationgridName = "#TimeSheetApproval" + wagonDrillTimeSheetId;



        if (timeSheetApproved == true || timeSheetSendForAproval == false) {

            $(".k-grid-top", firstValidationgridName).hide();

        }
    }

    function dataBound() {


        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.TimeSheetApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
            if (dataItem.TimeSheetApproved == true || dataItem.TimeSheetSendForAproval == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();


            }
        });
    }

    function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("TimeSheetSendForApproval", "WagonDrillTimesheet", new { area = "FleetManagement" })',
            data: { id: id },
            success: function (result) {

                alert(result);

                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }
    function VoidTimeSheet(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("VoidTimeSheet", "WagonDrillTimesheet", new { area = "FleetManagement" })',
            data: { id: id },
            success: function (result) {

                alert(result);

                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }

    function approvalDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsApproved == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });

    }

    function filterPlateNumber() {
        return {
            equipmentNameId: $("#EquipmentNameId").val(),
            text: $("#FleetsID").data("kendoDropDownList").filterInput.val(),
        }
    }
    function handleFleetId() {
        return {
            equipmentNameId: $("#EquipmentNameId").val(),
            
        text: $("#FleetsID").data("kendoDropDownList").filterInput.val(),
        }
    }
    function filterOperator() {
        return {
            text: $("#OperatorId").data("kendoDropDownList").filterInput.val()
        }
    }
</script>



<script type="text/javascript">
    $(document).ready(function () {
        $("#FuelInLiter").on("change", function () {
            var inputField = $(this).val();
            $("#FuelCost").val(inputField);
        });
    });
</script>

