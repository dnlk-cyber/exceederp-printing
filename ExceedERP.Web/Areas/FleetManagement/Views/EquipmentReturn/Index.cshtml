<script type="text/javascript">

    const handleOnEdit = () => {

        //$("#StartOdometer").prop("disabled", true);
        $("#NetOdometer").prop("disabled", true);
        //$("#EquipmentNameID").prop("disabled", true);
        //$("#FleetId").prop("disabled", true);
    }

    var masterId;
    var IsApproved;
    var IsSendForApproved;
    function dataBound() {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            var linegridName = "#AssignedConfirmedEquipmentgrid_" + masterId;


            if (dataItem.ReturnStatus == "Finished") {
                console.log("Forwarded");
                $(this).find(".k-grid-delete").remove();
                $(".k-grid-top", linegridName).hide();
                $(".k-grid-edit", linegridName).hide();
                $(".k-grid-delete", linegridName).hide();
            }
        });
    }


    function acceptdataBound() {
         this.expandRow(this.tbody.find("tr.k-master-row").first());

        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            console.log("stat " + dataItem.IsAssigned);
            if (dataItem.IsAssigned == false) {
                console.log("Forwarded");
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-edit").remove();

            }
        });
    }

    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        var r = masterDataItem.ReturnStatus;
        masterId = masterDataItem.JobOrderID;
        IsApproved = masterDataItem.IsOnlineApproved;
        IsSendForApproved = masterDataItem.IsSendForApproval;

        var linegridName = "#JobOrderDetailgrid_" + masterId;
        var firstValidationgridName = "#gridd_" + masterId;
        var SecondValidationgridName = "#JobOrderAdmingrid_" + masterId;
        console.error(" status " + r);
                if (r == "Waiting Technical Approval") {
                    $(linegridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", linegridName).hide();
                    $(".k-grid-edit", linegridName).hide();
                    $(".k-grid-delete", linegridName).hide();
                }
                else if (r == "Waiting Administrative Approval") {
                    $(linegridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", linegridName).hide();
                    $(".k-grid-edit", linegridName).hide();
                    $(".k-grid-delete", linegridName).hide();

                    $(".k-grid-top", firstValidationgridName).hide();
                    $(".k-grid-edit", firstValidationgridName).hide();
                    $(".k-grid-delete", firstValidationgridName).hide();
                }
                else if (r == "Closed") {
                    $(linegridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", linegridName).hide();
                    $(".k-grid-edit", linegridName).hide();
                    $(".k-grid-delete", linegridName).hide();


                    $(".k-grid-top", firstValidationgridName).hide();
                    $(".k-grid-edit", firstValidationgridName).hide();
                    $(".k-grid-delete", firstValidationgridName).hide();
                    $(".k-grid-top", SecondValidationgridName).hide();
                    $(".k-grid-edit", SecondValidationgridName).hide();
                    $(".k-grid-delete", SecondValidationgridName).hide();
                }
                else if (r == "Closed") {
                    $(linegridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", linegridName).hide();
                    $(".k-grid-edit", linegridName).hide();
                    $(".k-grid-delete", linegridName).hide();

                    $(".k-grid-top", firstValidationgridName).hide();
                    $(".k-grid-edit", firstValidationgridName).hide();
                    $(".k-grid-delete", firstValidationgridName).hide();

                    $(".k-grid-top", SecondValidationgridName).hide();
                    $(".k-grid-edit", SecondValidationgridName).hide();
                    $(".k-grid-delete", SecondValidationgridName).hide();
                }
                else {
                    $(linegridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", linegridName).show();
                }

            }
    function approveonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }


</script>
