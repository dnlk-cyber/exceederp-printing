@{
    ViewBag.Title = "Vehicle Distribution";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend> Equipment Return </legend>


@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.VehicleDistribution>()
      .Name("grid")
      .Columns(columns =>
      {

             columns.Bound(e => e.Type).Width(100);
          columns.Bound(e => e.FromBranchName).Width(100);
          columns.Bound(e => e.FromStructureName).Width(100);
          columns.Bound(o => o.RequestNumber).Width(80);


  
      })
      .Editable(editable =>
          {
                editable.DisplayDeleteConfirmation("Are You Sure You Recieved All Requested Equipment");
          })
           .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                           // .Groupable()
                            .Scrollable(h => h.Height(500))
      .ClientDetailTemplateId("template")

      .DataSource(dataSource => dataSource
          .Ajax()
                    .Sort(x => x.Add(s => s.RequestNumber).Descending())
          .Model(model =>
              {
                  model.Id(p => p.VehicleDistributionID);

              })
                                     .Events(ev => ev
                                    .Error("error_handler(\"grid\")")
                                    .RequestStart("onRequestStart(\"grid\")")
                                    .RequestEnd("onRequestEnd(\"grid\")"))
          .Create(update => update.Action("VehicleDistribution_Create", "EquipmentDistribution").Data("sendForgery"))
              .Read(read => read.Action("VehicleReturn_Read", "EquipmentDistribution").Data("sendForgery"))
          .Update(update => update.Action("VehicleDistribution_Update", "EquipmentDistribution").Data("sendForgery"))
          .Destroy(update => update.Action("VehicleDistribution_Destroy", "EquipmentDistribution").Data("sendForgery"))
      )
      .Events(events => events.DataBound("dataBound")))


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                            .Name("tabStrip_#=VehicleDistributionID#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {

        
                items.Add().Text("Assigned List").Content(@<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.AssignedEquipment>()
                        .Name("AssignedConfirmedEquipmentgrid_#=RequestID#")
                        .Columns(columns =>
                        {
                            columns.ForeignKey(e => e.EquipmentNameID, (System.Collections.IEnumerable)ViewData["EquipmentNames"], "Id", "Name")/*.EditorTemplateName("EquipmentNameEditor")*/.Title("Equipment Name").Width(140);
                            columns.ForeignKey(e => e.FleetId, (System.Collections.IEnumerable)ViewData["Fleets"], "Id", "Name")/*.EditorTemplateName("FleetEditor")*/.Title("Plate No").Width(140);
                            columns.Bound(e => e.ReturnDate);
                            columns.Bound(e => e.StartOdometr);
                            columns.Bound(e => e.EndOdometer);
                            columns.Bound(e => e.NetOdometer);

                            columns.Command(command => { command.Destroy().Text(" Accept Equipment "); command.Edit(); }).Width(180);


                        })  .Editable(editable =>
                        {
                            editable.DisplayDeleteConfirmation("Are You Sure You Want To Return This Equipment");
                        })
                        .Events(e=>
                        {
                            e.DataBound("acceptdataBound");
                            e.Edit("handleOnEdit");
                        })
                              .DataSource(dataSource => dataSource
                            .Ajax()
                                                    .PageSize(5)
                                 .Model(model =>
                                 {
                                     model.Id(p => p.AssignedEquipmentID);
                                     //model.Field(p => p.EquipmentName).Editable(false);
                                     model.Field(p => p.EquipmentNameID).Editable(false);
                                     model.Field(p => p.FleetId).Editable(false);
                                     model.Field(p => p.StartOdometr).Editable(false);
                                     model.Field(p => p.ReturnDate).Editable(false);
                                 })                   .Events(ev => ev
                                                   .Error("error_handler(\"AssignedConfirmedEquipmentgrid_#=RequestID#\")")
                                                   .RequestStart("onRequestStart(\"AssignedConfirmedEquipmentgrid_#=RequestID#\")")
                                                   .RequestEnd("onRequestEnd(\"AssignedConfirmedEquipmentgrid_#=RequestID#\")"))
                                                       .Create(update => update.Action("AssignedEquipment_Create", "AssignedEquipment", new { createRequestNumber = "#=RequestID#", createType = "R" }).Data("sendForgery"))
                                                       //.Update(update => update.Action("AssignEquipment", "AssignedEquipment").Data("sendForgery"))
                                                       .Update(update => update.Action("AssignEqupment_Update", "AssignedEquipment").Data("sendForgery"))
                                                       .Read(read => read.Action("ArrivedEquipment", "AssignedEquipment", new { readRequestNumber = "#=RequestID#", type = "R" }).Data("sendForgery"))
                                                       .Destroy(update => update.Action("AcceptEquipment", "AssignedEquipment", new { acceptId = "#=RequestID#", type = "R" }).Data("sendForgery")))

                        .Sortable()
                        .ToClientTemplate())
                </text>
                );


    @*
                items.Add().Text(" Approval").Content(@<text>
                    # if (IsSendForApproval == false || IsSendForApproval == "false")
                    {#

                    <a href='@Url.Action("VehicleReturn_SendForOnlineApproval", "VehicleReturnApproval")/?EId=#=VehicleDistributionID#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                    # }#
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.VehicleReturnApproval>()
                                                                                                                .Name("VehicleDistributionApproval#=VehicleDistributionID#")
                        .Columns(columns =>
                        {
                            columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                            columns.Bound(o => o.Remark).Width(200);
                            columns.Command(command => { command.Edit(); }).Width(250);

                        }).Events(ev =>
                        {
                            ev.DataBound("approveonDataBound");
                        })
                             .Editable(editable => editable.Mode(GridEditMode.InLine))
                                       .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(5)
                                              .Model(model => model.Id(p => p.VehicleReturnId))
                                                                                .Events(ev => ev
                                                            .Error("error_handler(\"VehicleDistributionApproval#=VehicleDistributionID#\")")
                                                            .RequestStart("onRequestStart(\"VehicleDistributionApproval#=VehicleDistributionID#\")")
                                                            .RequestEnd("onRequestEnd(\"VehicleDistributionApproval#=VehicleDistributionID#\")"))
                                                                                                                                   .Create(update => update.Action("VehicleReturn_Approve", "VehicleReturnApproval", new { EId = "#=VehicleDistributionID#" }).Data("sendForgery"))
                                                                                                                                             .Read(read => read.Action("VehicleReturnApproval_Read", "VehicleReturnApproval", new { EId = "#=VehicleDistributionID#" }).Data("sendForgery"))
                                                                                                                                           .Update(update => update.Action("VehicleReturn_Approve", "VehicleReturnApproval").Data("sendForgery"))


                                                      )
                                               .ToClientTemplate())
                </text>
                );
        *@
            }).ToClientTemplate())
</script>

