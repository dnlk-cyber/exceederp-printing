                            columns.Bound(o => o.EquipmentName).Title("Type").EditorTemplateName("EquipmentSubTypeEditor").Width(120);

                            columns.Bound(o => o.SubEquipmentName).Title("Name").EditorTemplateName("RequestEquipmentName").Width(120);
                            columns.Bound(o => o.ManufacturedYear).EditorTemplateName("ManfacturedYearEditor").Width(80);
