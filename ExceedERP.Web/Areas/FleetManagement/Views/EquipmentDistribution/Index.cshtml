<script>
    var masterId;
    var status;
    var IsApproved;
    var IsSendForApproved;
    function filterRequest() {
        return {
            readRequestNumber: masterId
        };
    }
    function filterEquipment() {
        var dropdownlist = $("#EquipmentName").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            Id : $("#CategoryRef").data("kendoDropDownList").value(),
            Search: filterInput.val()
        };
        
    }
    function onDetailExpand(e) {
        var masterRow = e.masterRow;
        //var masterGrid = $("#grid").data("kendoGrid");
        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        IsApproved = masterDataItem.IsOnlineApproved;
        IsSendForApproved = masterDataItem.IsSendForApproval;
        masterId = masterDataItem.RequestID;
        status = masterDataItem.EquipmentStatus;
        var linegridName = "#grid_" + masterId;
        var firstValidationgridName = "#AssignedEquipmentgrid_" + masterId;
        var SecondValidationgridName = "#AssignedConfirmedEquipmentgrid_" + masterId;
        var linegridName = "#RequestEquipmentgrid_" + masterId;


        if (  IsSendForApproved == true || IsApproved == true ) {
            console.log("Finished");
            $(this).find(".k-grid-delete").remove();
            $(this).find(".k-grid-edit").remove();

            $(".k-grid-top", firstValidationgridName).hide();
            $(".k-grid-edit", firstValidationgridName).hide();
             $(".k-grid-delete", firstValidationgridName).hide();
            $(".k-grid-top", SecondValidationgridName).hide();
            $(".k-grid-edit", SecondValidationgridName).hide();
            $(".k-grid-delete", SecondValidationgridName).hide();
            $(".k-grid-edit", linegridName).hide();
            $(linegridName).find(".k-grid-edit").remove();
        }
       
      
    }




    function dataBoundAssign() {
        var SecondValidationgridName = "#AssignedConfirmedEquipmentgrid_" + masterId;

        if (IsApproved == true || IsSendForApproved == true) {

            $(SecondValidationgridName).find(".k-grid-edit").remove();
            $(SecondValidationgridName).find(".k-grid-delete").remove();
         
        }
    }
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());

        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            var linegridName = "#grid_" + masterId;
            var firstValidationgridName = "#AssignedEquipmentgrid_" + masterId;
            var SecondValidationgridName = "#AssignedConfirmedEquipmentgrid_" + masterId;
            console.log("Is Approved " + IsApproved);
            if (IsApproved == true || IsSendForApproved == true) {

                if (IsApproved == true) {

                    $(this).find(".k-grid-delete").remove();
                }
                $(this).find(".k-grid-edit").remove();

            }

            if (dataItem.IsOnlineApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }

        });
    }




    function requestonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (IsApproved == true || IsSendForApproved == true) {
                 $(this).find(".k-grid-edit").remove();
               
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

</script>

