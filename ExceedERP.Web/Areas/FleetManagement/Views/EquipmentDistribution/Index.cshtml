    function calcDifference() {
        var current = $("#CurrentKm").val();
        var prev = $("#PrevKm").val();
        var litre = $("#PrevLT").val();

        var diff = current - prev;
        $("#DifferenceKm").val(diff).trigger("change");
        if (litre != 0) {
            var consum = diff / litre;
            $("#Consumption").val(consum.toFixed(2)).trigger("change");
        }


    }


