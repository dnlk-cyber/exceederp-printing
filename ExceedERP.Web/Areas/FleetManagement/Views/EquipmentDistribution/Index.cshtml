        function handleKmTravedTotal(value) {
            let grandTotal = 0;
            let kmTravelledTotal = Number(value)
            let kmInterSiteValue = $('#KmInterSite').data("kendoNumericTextBox").value();
            if (kmInterSiteValue) {
                grandTotal = kmTravelledTotal + kmInterSiteValue;
                $('#KmGrandTotal').data("kendoNumericTextBox").value(grandTotal);
                $('#KmGrandTotal').data("kendoNumericTextBox").trigger("change");
            } else {
                $('#KmGrandTotal').data("kendoNumericTextBox").value(kmTravelledTotal);
                $('#KmGrandTotal').data("kendoNumericTextBox").trigger("change");
            }

        }
        function handleKmInterSite(value) {
            let grandTotal = 0;
            let kmInterSiteValue = Number(value)
            let kmTravelledTotal = $('#KmTravelledTotal').data("kendoNumericTextBox").value();
            if (kmTravelledTotal) {
                grandTotal = kmTravelledTotal + kmInterSiteValue;
                $('#KmGrandTotal').data("kendoNumericTextBox").value(grandTotal);
                $('#KmGrandTotal').data("kendoNumericTextBox").trigger("change");
            } else if (kmInterSiteValue && !kmTravelledTotal) {
