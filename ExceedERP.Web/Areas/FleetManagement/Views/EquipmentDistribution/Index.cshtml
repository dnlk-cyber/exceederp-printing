@model ExceedERP.Core.Domain.FleetManagement.FleetResource.VehicleDistribution
@using System.Collections
@using ExceedERP.Core.Domain.Finance.AP.Travel
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.Inventory
<legend> Equipment Distribution </legend>


<script type="text/javascript">

    function filterEquipmentIdentity() {

        var dropdownlist = $("#EquipmentName").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            EquipmentIdentityID: $("#Type").val(),
            Search: filterInput.val()
        };

    }


    function filterFixedAssetSubCategory() {
        var dropdownlist = $("#SubEquipmentName").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            Id: $("#EquipmentName").val(),
            Search: filterInput.val()
        };

    }
</script>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.VehicleDistribution>()
                            .Name("grid")
                            .Columns(columns =>
                            {
                                columns.Bound(e => e.RequestNumber).Title(" Request Number").Width(70);
                                columns.ForeignKey(e => e.EmployeeId, (System.Collections.IEnumerable)ViewData["Employee"], "Id", "Name").Width(130);
                                columns.Bound(e => e.FromBranchName).Title("Branch").Width(100);
                                columns.Bound(e => e.FromStructureName).Title("Department").Width(100);
                                columns.Bound(e => e.ReasonForTravel).Width(120);
                                columns.Bound(e => e.RequestDate).Title("Assign Date").Width(100);
                                columns.Bound(e => e.Status).Width(100);
                                columns.Bound(o => o.DistrubtionNumber).Title("Referance").Width(80);
                                columns.Bound(o => o.Num).Visible(false);
                                columns.Bound(e => e.IsExternal).Width(80).Title("Is External");
                                columns.Command(command =>
                                {
                                // command.Edit();
                                command.Custom("toggleExternal")
                                                   .Click("onToggleExternalClick")
                                                   .Text("Toggle")
                                                   .HtmlAttributes(new { @class = "k-button k-button-icontext k-grid-toggleExternal" });
                            }).Width(150);
    })
                            .ToolBar(commands =>
                            {
        commands.Create();
    }).Editable(editable =>
                            {
        editable.Mode(GridEditMode.PopUp).TemplateName("VehicleDistributionEditor").Window(x => x.Title("Equipment Distribution"));
        editable.DisplayDeleteConfirmation("Are You Sure To Remove This");
    })
                            .Events(e => e.DataBound("dataBound"))
                            .HtmlAttributes(new { style = "height: 520px;" })
                                        .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
                                            .Scrollable()
                                            .Sortable()
                                            .Filterable()
                                            .Scrollable(h => h.Height(500))
                        .ClientDetailTemplateId("template")
                        .Events(ev => ev.DetailExpand("onDetailExpand"))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            //.ServerOperation(false)
                            .Sort(x => x.Add(s => s.RequestNumber).Descending())
                            .Model(model =>
                            {
                                model.Id(p => p.VehicleDistributionID);
                            })
                            .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
                            .Create(update => update.Action("VehicleDistribution_Create", "EquipmentDistribution").Data("sendForgery"))
                            .Read(read => read.Action("VehicleDistribution_Read", "EquipmentDistribution").Data("sendForgery"))
                            .Update(update => update.Action("VehicleDistribution_Update", "EquipmentDistribution").Data("sendForgery"))
                            .Destroy(update => update.Action("VehicleDistribution_Destroy", "EquipmentDistribution").Data("sendForgery"))
                        )
)
