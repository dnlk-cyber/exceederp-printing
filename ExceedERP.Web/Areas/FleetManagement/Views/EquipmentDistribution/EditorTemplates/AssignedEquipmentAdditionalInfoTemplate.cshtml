
@using ExceedERP.Core.Domain.FleetManagement.FleetResource
@model ExceedERP.Core.Domain.FleetManagement.FleetResource.AssignedEquipmentAdditionalInfo


<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.KmTravelledPerLitre, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.KmTravelledPerLitre).HtmlAttributes(new { style = "width:100%" }).Enable(true)
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.KmTravelledTotal, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.KmTravelledTotal).HtmlAttributes(new { style = "width:100%", onInput = "handleKmTravedTotal(this.value)" })
            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.KmInterSite, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.KmInterSite).HtmlAttributes(new { style = "width:100%", onInput = "handleKmInterSite(this.value)" })

            </div>
        </div>

    </div>



    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.KmGrandTotal, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.KmGrandTotal).Events(e => e.Change("handleChangeKmGrandTotal")).HtmlAttributes(new { style = "width:100%"@*, onChange = "handleChangeKmGrandTotal(this.value)"*@ })

            </div>
        </div>


    </div>


</div>

