@model ExceedERP.Core.Domain.FleetManagement.FleetResource.VehicleDistribution
<script>
    function filterRentRequest() {
        return {
            requestType: 'Company'
        };
    }
</script>
   <div class="demo-section k-content">
       <div class="col-md-9">
           <div class="form-group">
               <div class="k-label">
                   @Html.LabelFor(model => model.RequestID)
               </div>
               @(Html.Kendo().DropDownListFor(model => model.RequestID)
                   //.Name("RequestID")
                   .HtmlAttributes(new { style = "width: 100%" })
                   .DataTextField("Name")
                   .DataValueField("Id")
                   .Filter(FilterType.Contains)
                    .MinLength(2) // 🔥 only search after typing 2 chars
                       .AutoBind(false) // 🔥 do NOT load on page load
                   .DataSource(d =>
                   {
                       d.Read(r =>
                       {
                           r.Action("RequestDemand", "RentRequest").Data("filterRequestNumber");
                       })
                   .ServerFiltering(true);
                   })
                   )
           </div>
       </div>
   </div>

 