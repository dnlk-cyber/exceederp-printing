
@(Html.Kendo().DropDownListFor(model => model)
            .HtmlAttributes(new { @class = "form-control" })
            .Enable(false)
            .AutoBind(false)
            .DataTextField("Name")
            .ValuePrimitive(true)
            .DataValueField("Id")
            .OptionLabel("Select")
            .Filter("contains")
            .IgnoreCase(true)
            .CascadeFrom("EquipmentTypeID")
            .DataSource(d => d.Read(r => r.Action("GetEquipmentNamesFromEquipmentType", "FleetManagementDataProvider").Data("sendForgery")
            .Data("getEquipmentTypeId"))
            .ServerFiltering(true)))