@using ExceedERP.Core.Domain.FleetManagement.FleetViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<label>Fleet Equipment History Jacket</label>

@(Html.Kendo().Grid<FleetEquipmentHistoryJacketViewModel>()
                                                            .Name("grid")
                                                            .Columns(columns =>
                                                            {
                                                                columns.Bound(c => c.EquipmentCategoryName);
                                                                columns.Bound(c => c.EquipmentTypeName);
                                                                columns.Bound(c => c.EquipmentName);
                                                                columns.Bound(c => c.PlateNo);
                                                                columns.Bound(c => c.PurchasingCost);
                                                                columns.Bound(c => c.SerialNo);
                                                            })
                                                            .Filterable()
                                                             .Scrollable(h => h.Height(500)).Scrollable()
                                                            .DataSource(dataSource => dataSource
                                                                .Ajax()
                                                                .Model(model => model.Id(p => p.FleetId))
                                                                .Read(read => read.Action("Equipment_Read", "FleetEquipmentHistoryJacket").Data("sendForgery"))

                                                            ).ClientDetailTemplateId("tabs")
)

<script id="tabs" type="text/x-kendo-template">
    @(Html.Kendo().TabStrip()
                                                                                .Name("tabstrip_grid_#=FleetId#")
                                                                                .SelectedIndex(0)
                                                                                .Items(itemn =>
                                                                                {
                                                                        //itemn.Add().Text("Equipment Distribution").Content(@<text>@EquipmentDistribution()</text>);
                                                                        itemn.Add().Text("Insurance History").Content(@<text>@Insurance()</text>);
                                                                                itemn.Add().Text("Bolo Registration History").Content(@<text>@FleetBoloRegistrationHistory()</text>);
                                                                                        itemn.Add().Text("Accident History").Content(@<text>@Accident()</text>);
                                                                                                itemn.Add().Text("Timesheet History").Content(@<text>@FleetTimesheet()</text>);
                                                                                            @*itemn.Add().Text("Dry Loading Timesheet History").Content(@<text>@DryLoadingTimeSheet()</text>);*@
                                                                                            //itemn.Add().Text("Dump Truck Timesheet History").Content(@<text>@DumptruckTimeSheetHistory()</text>);
                                                                                            // itemn.Add().Text("Timesheet History").Content(@<text>@FleetTimesheet()</text>);
                                                                                            // itemn.Add().Text("Timesheet History").Content(@<text>@FleetTimesheet()</text>);
                                                                                            itemn.Add().Text("Annual Inspection ").Content(@<text>@AnnualInspection()</text>);
                                                                                                    itemn.Add().Text("Costsheet History").Content(@<text>@Costsheet()</text>);
                                                                                                            itemn.Add().Text("Tire and Battery History").Content(@<text>@TireAndBattery()</text>);
                                                                                                                    itemn.Add().Text("Maintenance History").Content(@<text>@Maintenance()</text>);
                                                                                                                            itemn.Add().Text("Distribution History").Content(@<text>@Distribution()</text>);
                                                                                                                                    itemn.Add().Text("Fuel Consumption History").Content(@<text>@Fuel()</text>);

                                                                                                                                        }).ToClientTemplate())
</script>

