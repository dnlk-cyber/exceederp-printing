
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Fleet Equipment History Jacket</h2>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetViewModel.FleetEquipmentHistoryJacketViewModel>()
                        .Name("grid")
                        .Columns(columns =>
                        {
                            columns.Bound(c => c.EquipmentCategoryName);
                            columns.Bound(c => c.EquipmentTypeName);
                            columns.Bound(c => c.EquipmentName);
                            columns.Bound(c => c.PlateNo);
                            columns.Bound(c => c.SerialNo);
                        })
                        .Filterable()
                        .Scrollable()
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Model(model => model.Id(p => p.FleetId))
                            .Read(read => read.Action("Equipment_Read", "FleetEquipmentHistoryJacket"))

                        ).ClientDetailTemplateId("tabs")
)

<script id="tabs" type="text/x-kendo-template">
    @(Html.Kendo().TabStrip()
                                                .Name("tabstrip_grid_#=FleetId#")
                                                .SelectedIndex(0)
                                                .Items(itemn =>
                                                {
                                                    itemn.Add().Text("Insurance History").Content(@<text>@Insurance()</text>);
                                                            itemn.Add().Text("Accident History").Content(@<text>@Accident()</text>);
                                                                    itemn.Add().Text("Timesheet History").Content(@<text>@FleetTimesheet()</text>);
                                                                            itemn.Add().Text("Costsheet History").Content(@<text>@Costsheet()</text>);
                                                                                    itemn.Add().Text("Tire and Battery History").Content(@<text>@TireAndBattery()</text>);
                                                                                            itemn.Add().Text("Maintenance History").Content(@<text></text>);
                                                                                                    itemn.Add().Text("Distribution History").Content(@<text></text>);
                                                                                                            itemn.Add().Text("Fuel Consumption History").Content(@<text></text>);

                                                                                                                }).ToClientTemplate())
</script>

@helper Insurance()
{
    @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetViewModel.FleetInsuranceViewModel>()
                                            .Name("ins_#=FleetId#")
                                            .Columns(columns =>
                                            {
                                                columns.Bound(c => c.PolicyNo).Width(100);
                                                columns.Bound(c => c.PremiumCost).Width(100);
                                                columns.Bound(c => c.InsuranceType).Width(100);
                                                columns.Bound(c => c.InsuranceCompanyName).Width(100);
                                                columns.Bound(c => c.DueDate).Width(100);
                                            })
                                            .Filterable()
                                            .Scrollable()
                                            .DataSource(dataSource => dataSource
                                                .Ajax()
                                                .Model(model => model.Id(p => p.FleetInsuranceId))
                                                .Read(read => read.Action("Insurance_Read", "FleetEquipmentHistoryJacket", new { id = "#=FleetId#" }))

                                            ).ToClientTemplate()
    )
}

