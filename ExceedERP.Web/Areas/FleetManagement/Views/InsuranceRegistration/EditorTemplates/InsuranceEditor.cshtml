@model ExceedERP.Core.Domain.FleetManagement.FleetRegistration.FleetInsurance

<script>

    function filterFleets() {
        return {
            FleetsID: $("#FleetsID").val()
        };
    }
    
    function onUploadSuccess(e) {

    }

    function checkFileType(e) {
        var files = e.files;

        $.each(files, function () {

            if (this.extension.toLowerCase() === ".pdf" || this.extension.toLowerCase() === ".doc" || this.extension.toLowerCase() === ".docx") {

            } else {
                alert("Only .pdf , .doc or .docx  files can be uploaded!");
                e.preventDefault();
            }

        });
    }


</script>
<div class="demo-section k-content">
    <form>
     

        <div class="row">
            <div class="col-md-1">
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @(Html.LabelFor(m => m.FleetsID))
                        @(Html.Kendo().DropDownListFor(model => model.FleetsID).Name("FleetsID")
                              .DataTextField("PlateNumber")
                                      .DataValueField("FleetsID").OptionLabel(" Select Equipment").Filter(FilterType.Contains)
                              .DataSource(d => d.Read(r => r.Action("FleetsDDBind", "EquipmentRegistration")).ServerFiltering(false)))
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.InsuranceCompany)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.InsuranceCompany)
                        @Html.ValidationMessageFor(model => model.InsuranceCompany)
                    </div>
                </div>
            </div>
       

            
       
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.City)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.City)
                        @Html.ValidationMessageFor(model => model.City)
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.Description)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.Description)
                        @Html.ValidationMessageFor(model => model.Description)
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        <div>
                            @Html.LabelFor(model => model.Email)
                        </div>
                        <div>
                            @Html.Kendo().TextBoxFor(model => model.Email)
                            @Html.ValidationMessageFor(model => model.Email)
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.PremiumCost)
                    </div>
                    <div>
                        @Html.Kendo().NumericTextBoxFor(model => model.PremiumCost).Min(0)
                        @Html.ValidationMessageFor(model => model.PremiumCost)
                    </div>
                </div>
            </div>
            </div>
          

        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.ExpireDate)
                    </div>
                    <div>
                        @Html.Kendo().DatePickerFor(model => model.ExpireDate)
                        @Html.ValidationMessageFor(model => model.ExpireDate)
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        <div>
                            @Html.LabelFor(model => model.DueDate)
                        </div>
                        <div>
                            @Html.Kendo().DatePickerFor(model => model.DueDate)
                            @Html.ValidationMessageFor(model => model.DueDate)
                        </div>
                    </div>
                </div>
            </div>
 
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.PhoneNo)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.PhoneNo)
                        @Html.ValidationMessageFor(model => model.PhoneNo)
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-1">
            </div>
 
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        <h6 style="margin-top: 0.3em;"> @(Html.LabelFor(m => m.Attachment)) </h6>
                        @(Html.Kendo().Upload()
                                         .Name("file")
                                                         .Async(a => a.Save("UploadAttachment", "Insurance"))
                                         .Events(e => e.Complete("onUploadSuccess").Upload("checkFileType"))
                                         .ShowFileList(false).Events(events => events.Error("error_handler")))
                    </div>
                </div>
            </div>
       
    
             </div>

</form>
        </div>
