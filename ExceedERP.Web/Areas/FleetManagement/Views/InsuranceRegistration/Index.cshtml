@model ExceedERP.Core.Domain.FleetManagement.FleetRegistration.FleetInsurance

<legend>Insurance Registration </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.FleetInsurance>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.ForeignKey(e => e.FleetsID, (System.Collections.IEnumerable)ViewData["Fleets"], "FleetsID", "UnitNum").EditorTemplateName("EquipmentGenericEditor").Width(140);
        columns.Bound(e => e.PlateNo).Width(140);
        columns.Bound(e => e.SerialNo).Width(120);
        columns.Bound(e => e.ChasisNo).Width(100);
        columns.Bound(e => e.InsuranceCompany).Width(140);
          columns.Bound(c => c.DateCreated).Format("{0:d}").Width(100);
       
    
        columns.Bound(e => e.PhoneNo).Width(140);
        columns.Bound(e => e.PremiumCost).Width(120);
        columns.Bound(e => e.Status).Width(100);

        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);


    })
         .ToolBar(commands =>
         {
             commands.Create(); commands.Excel();
             commands.Pdf();
         })     .Events(ev =>
         {
             ev.DataBound("onDataBound"); ev.DetailExpand("onDetailExpand");
         })
                  .Editable(editable =>
                  {
                      editable.Mode(GridEditMode.InLine);//.TemplateName("InsuranceEditor").Window(x => x.Title("Insurance Registration"));
                      editable.DisplayDeleteConfirmation("Are You Sure To Remove Insurance");
                  })
      .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                                 .Scrollable(h => h.Height(500)).ClientDetailTemplateId("template")
    .DataSource(dataSource => dataSource
        .Ajax()
        .ServerOperation(false)
              .Model(model =>
              {
                  model.Id(p => p.FleetInsuranceID);
                  model.Field(x => x.InsuranceCompany).Editable(false);
                  model.Field(x => x.PhoneNo).Editable(false);
                  model.Field(x => x.PremiumCost).Editable(false);
                  model.Field(x => x.Status).Editable(false);
                  model.Field(x => x.PlateNo).Editable(false);
                  model.Field(x => x.ChasisNo).Editable(false);
                  model.Field(x => x.SerialNo).Editable(false);
              })
             .Events(ev => ev
                                        .Error("error_handler(\"grid\")")
                                        .RequestStart("onRequestStart(\"grid\")")
                                        .RequestEnd("onRequestEnd(\"grid\")"))
                    .Create(update => update.Action("Insurance_Create", "InsuranceRegistration"))
                    .Read(read => read.Action("Insurance_Read", "InsuranceRegistration"))
                    .Update(update => update.Action("Insurance_Update", "InsuranceRegistration"))
                    .Destroy(update => update.Action("Insurance_Destroy", "InsuranceRegistration"))
  )
)


