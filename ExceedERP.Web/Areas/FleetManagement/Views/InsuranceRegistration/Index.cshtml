@using ExceedERP.Core.Domain.FleetManagement.FleetRegistration
@{
    ViewBag.Title = "InsuranceCompany";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool IsMIDROC = (ViewBag.setting as string) == "MIDROC";
}

<legend>Fleet Insurance</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.FleetInsurance>()
                    .Name("grid")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.FleetInsuranceId).Title("S.No").Width(50);
                        columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["Category"], "Value", "Text").Width(120);
                        columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["Type"], "Value", "Text").Width(120);
                        columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["Name"], "Value", "Text").Width(120);
                        columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["fleet"], "Id", "Name").Title("Fleet Plate No").Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
                        columns.ForeignKey(c => c.InsuranceCompanyId, (IEnumerable)ViewData["InsuranceCompany"], "InsuranceCompanyId", "InsuranceCompanyName").Title("Company").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
                        columns.ForeignKey(c => c.InsuranceCoverTypeId, (IEnumerable)ViewData["InsuranceCover"], "Id", "Name").Title("Insurance Cover Type").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
                        columns.Bound(c => c.InsuranceType).Width(80);
                        columns.Bound(c => c.PremiumCost).Width(80);
                        columns.Bound(c => c.DueDate).Title("Start Date").Width(80).Filterable(ftb => ftb.Multi(true).Search(true));
                        columns.Bound(c => c.ExpireDate).Title("End Date").Width(80);
                        columns.Bound(c => c.StatusEnum).Title("Status").Width(80);
                        if (IsMIDROC == false)
                        {
                            columns.Bound(c => c.ThirdPartyInsurance).Width(80).Filterable(ftb => ftb.Multi(true).Search(true));
                            columns.Bound(c => c.ComprehensiveInsurance).Width(80);
                        }
                        if (IsMIDROC == true)
                        {
                            columns.Bound(c => c.Payment).Width(80);
                        }
                        columns.Bound(c => c.PolicyNo).Width(80);
                        columns.Bound(c => c.Attachment).Width(80);
                        columns.Bound(c => c.Description).Title("Descrption").Width(140);
                        columns.Bound(c => c.HasExpired).Visible(false);
                        columns.Command(command => { command.Edit().UpdateText("Save").CancelText("Cancel").Text("Edit");
                            command.Destroy().Text("Delete"); }).Title("Action").Width(200);
                    })
                     .ToolBar(toolbar =>
                     {
                         toolbar.Create();

                     }).Events(e => e.DataBound("onDataBoundMaster"))
                      .Events(ev => ev.DetailExpand("detailExpand"))
                     .Editable(editable => editable.Mode(GridEditMode.PopUp)
                     .TemplateName("FleetInsuranceTemplate")
                     .Window(win => win.Title("Fleet Insurance")))
                     .Pageable()
                     .Filterable()
                     .Scrollable(s => s.Height(550))
                     .DataSource(dataSource => dataSource
                         .Ajax()
                         .Sort(sort => sort.Add(e => e.FleetInsuranceId).Descending())
                         .Model(model =>
                         {
                             model.Id(p => p.FleetInsuranceId);

                             //model.Field(p => p.AddToHistory, typeof(bool));

                         })
                         .Events(ev => ev
                         .Error("error_handler(\"grid\")")
                         .RequestStart("onRequestStart(\"grid\")")
                         .RequestEnd("onRequestEnd(\"grid\")"))
                         .Read(read => read.Action("FleetInsurances_Read", "InsuranceRegistration").Data("sendForgery"))
                         .Create(create => create.Action("FleetInsurances_Create", "InsuranceRegistration").Data("sendForgery"))
                         .Update(update => update.Action("FleetInsurances_Update", "InsuranceRegistration").Data("sendForgery"))
                         .Destroy(destroy => destroy.Action("FleetInsurances_Destroy", "InsuranceRegistration").Data("sendForgery"))
                                        )
                    .ClientDetailTemplateId("template"))

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                        .Name("tabstrip_#=FleetInsuranceId#")
                                        .SelectedIndex(0)
                                        .Items(items =>
                                        {
                                        items.Add().Text("Detail").Content(@<text>
    
    #if(!IsSendForApproval){#
    <a onclick='return sendForApproval("#=FleetInsuranceId#")' href=' \#' title="Send For Approval"><i class="fa fa-share-square fa-2x"></i></a>

    #}#
    </text>);
                                            items.Add().Text("Attachment").Content(@<text>

                                                @FileUpload()

                                            </text>); items.Add().Text("Approval").Content(@<text>
                                                        @(Html.Kendo().Grid<FleetInsuranceValidation>()
                                                         .Name("Approval#=FleetInsuranceId#")
                                                         .Columns(columns =>
                                                         {
                                                             columns.Bound(o => o.Status).EditorTemplateName("ApprovalStatus").Width(126);
                                                            columns.Bound(c => c.Remark).Width(150);
                                                             columns.Command(command => { command.Edit(); }).Width(250);

                                                         })
                                                             .ToolBar(commands => commands.Create().Text("Approve Request"))
                                                             .Events(ev =>
                                                              ev.DataBound("approveonDataBound")
                                                                    )
                                                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                        .DataSource(dataSource => dataSource
                                                             .Ajax()
                                                             .PageSize(5)
                                                             .Model(model =>
                                                             {
                                                                 model.Id(p => p.FleetInsuranceValidationId);
                                                                 model.Field(p => p.CreatedBy).Editable(false);
                                                                 model.Field(p => p.DateCreated).Editable(false);
                                                             })
                                                                     .Events(ev => ev
                                                                     .Error("error_handler(\"Approval#=FleetInsuranceId#\")")
                                                                     .RequestStart("onRequestStart(\"Approval#=FleetInsuranceId#\")")
                                                                     .RequestEnd("onRequestEnd(\"Approval#=FleetInsuranceId#\")"))
                                                                     .Create(update => update.Action("Admin_Create", "InsuranceRegistration", new { id = "#=FleetInsuranceId#" }).Data("sendForgery"))
                                                                     .Read(read => read.Action("Admin_Read", "InsuranceRegistration", new { id = "#=FleetInsuranceId#" }).Data("sendForgery"))
                                                                     .Update(update => update.Action("Admin_Create", "InsuranceRegistration", new { id = "#=FleetInsuranceId#" }).Data("sendForgery"))


                                                                                       )
                                                                                     .ToClientTemplate())
                                            </text>
                                                                                                       );

                                                }).ToClientTemplate())
</script>

<script type="text/javascript">

    @helper FileUpload()
        {
            <text>
                @(Html.Kendo().Grid<FleetInsuranceDocument>
                ()
                .Name("CompanyDocument#=FleetInsuranceId#")

                .Columns(columns =>
                {
                    columns.Bound(x => x.FleetInsuranceDocumentId).Hidden(true);
                    columns.Bound(c => c.FileName).ClientTemplate("<a href='/FleetManagement/InsuranceRegistration/DownloadCompanyDocument?CompanyDocumentId=\\#=FleetInsuranceDocumentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; \\#=FileName\\# </a>").Width(200);

                    columns.Command(command =>
                    {
                        //command.Edit();
                        command.Destroy();
                    }).Width(580);
                })
              .ToolBar(t => t.Template(
                        @<text>
                        @(Html.Kendo().Upload()
                        .Name("attachments")
                        .Async(a => a.Save("InsuranceAttachment_Create", "InsuranceRegistration", new { id = "#=FleetInsuranceId #" }))
                        .Events(e => e.Complete("onUploadSuccess").Select("function(e) { globalOnSelect(e, ['.jpg', '.png', '.pdf'], 2 * 1024 * 1024); }")
                        .Error("onUploadError"))
                        .ShowFileList(false)
                        .ToClientTemplate()
                        )
                        </text>
                        ))
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                .HtmlAttributes(new { style = "height: 350px;" })
                .Sortable(sortable =>
                {
                sortable.SortMode(GridSortMode.SingleColumn);
                })
                .Scrollable()
                .Pageable(pageable => pageable
                .Input(true)
                .Numeric(false)
                .Refresh(true)
                .PageSizes(true)
                .ButtonCount(5))
                //.Events(x => x.DataBound("onDataBoundLines"))
                .DataSource(dataSource => dataSource
                .Ajax()
                .Events(ev => ev
                    .Error("error_handler(\"CompanyDocument#=FleetInsuranceId#\")")
                    .RequestStart("onRequestStart(\"CompanyDocument#=FleetInsuranceId#\")")
                    .RequestEnd("onRequestEnd(\"CompanyDocument#=FleetInsuranceId#\")"))
                    .Model(model => model.Id(p => p.FleetInsuranceDocumentId))
                    .Read(read => read.Action("FleetInsuranceDoc_Read", "InsuranceRegistration", new { id = "#=FleetInsuranceId#", area = "FleetManagement" }).Data("sendForgery"))
                    .Destroy(destroy => destroy.Action("FleetInsuranceDoc_Delete", "InsuranceRegistration", new { area = "FleetManagement" }).Data("sendForgery"))
                    ).ToClientTemplate())
        </text>
    }



    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;

    var isDeptapproved;
    var isDeptSendForApproval;
    var isParentApproved;

    function detailExpand(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.FleetInsuranceId;
        isParentSendForApproval = masterDataItem.IsSendForApproval;
        isParentApproved = masterDataItem.IsOnlineApproved;
        //isDeptapproved = masterDataItem.IsDepartmentOnlineApproved;
        //isDeptSendForApproval = masterDataItem.IsDepartmentSendForApproval;
    }
