
@{
    ViewBag.Title = "Bolo Registration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Bolo Registration</legend>

@using ExceedERP.Core.Domain.FleetManagement.FleetRegistration;
@(Html.Kendo().Grid<FleetBoloRegistration>()
                  .Name("grid")
                  .Columns(columns =>
                  {
                      //columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["Category"], "Value", "Text").Width(120).Title("Category");
                      //columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["Type"], "Value", "Text").Width(120).Title("Type");
                      //columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["Name"], "Value", "Text").Width(120).Title("Name");
                      columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["Category"], "Value", "Text").EditorTemplateName("EquipmentIdentity").Width(120).Title("Category");
                      columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["Type"], "Value", "Text").EditorTemplateName("EquipmentType").Width(120).Title("Type");
                      columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["Name"], "Value", "Text").EditorTemplateName("EquipmentName").Width(120).Title("Name");
                      columns.ForeignKey(c => c.FleetId, (IEnumerable)ViewData["Fleet"], "Value", "Text").Filterable(ftb => ftb.Multi(true).Search(true)).Title("Plate No").Width(100);
                      columns.Bound(c => c.BoloRegistrationDate).Width(100).Title("Registration Date");
                      columns.Bound(c => c.BoloExpireDate).Width(120).Title("Expiry Date");
                      columns.Bound(c => c.Remark).Width(100);
                      //columns.Bound(c => c.AddToHistory).Title("Add to history").Width(120);
                      columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
                  })
                  .ToolBar(toolbar =>
                  {
                      toolbar.Create();
                  })
                  .Events(e => e.DataBound("onDataBoundMaster"))
                      .Events(ev => ev.DetailExpand("detailExpand"))
                  .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("boloregTemp"))
                   .Pageable()
                     .Filterable()
                     .Scrollable(s => s.Height(550))
                  .DataSource(dataSource => dataSource
                      .Ajax()
                      .Model(model => model.Id(p => p.FleetBoloRegistrationId))
                      .Read(read => read.Action("Read", "FleetBoloRegistration").Data("sendForgery"))
                      .Create(create => create.Action("Create", "FleetBoloRegistration").Data("sendForgery"))
                      .Update(update => update.Action("Update", "FleetBoloRegistration").Data("sendForgery"))
                      .Destroy(destroy => destroy.Action("Delete", "FleetBoloRegistration").Data("sendForgery"))
                  ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                                        .Name("tabstrip_#=FleetBoloRegistrationId#")
                                                        .SelectedIndex(0)
                                                        .Items(items =>
                                                        {
                                                            items.Add().Text("Attachment").Content(@<text>

                                                                @FileUpload()

                                                            </text>);

                                                                }).ToClientTemplate())
</script>
@helper FileUpload()
{
    <text>
        @(Html.Kendo().Grid<BoloRegistrationDocument>
                        ()
                        .Name("CompanyDocument#=FleetBoloRegistrationId#")

                        .Columns(columns =>
                        {
                            columns.Bound(x => x.BoloRegistrationDocumentId).Hidden(true);
                            columns.Bound(c => c.FileName).ClientTemplate("<a href='/FleetManagement/FleetBoloRegistration/DownloadBoloDocument?CompanyDocumentId=\\#=BoloRegistrationDocumentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; \\#=FileName\\# </a>").Width(200);
                            columns.Command(command =>
                        {
                command.Destroy();
                        }).Width(580);
                        })
                      .ToolBar(t => t.Template(
                                @<text>
                                    @(Html.Kendo().Upload()
                                                    .Name("attachments")
                                                    .Async(a => a.Save("BoloRegistrationAttachment_Create", "FleetBoloRegistration", new { id = "#=FleetBoloRegistrationId #" }))
                                                    .Events(e => e.Complete("onUploadSuccess").Select("function(e) { globalOnSelect(e, ['.jpg', '.png', '.pdf'], 2 * 1024 * 1024); }")
                                                    .Error("onUploadError")
                                                    )
                                                    .ShowFileList(false)
                                                    .ToClientTemplate()
                                    )
                                </text>
                                        ))
                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .HtmlAttributes(new { style = "height: 350px;" })
                                .Sortable(sortable =>
                                {
                                    sortable.SortMode(GridSortMode.SingleColumn);
                                })
                                .Scrollable()
                                .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
                                // .Events(x => x.DataBound("onDataBoundLines"))
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .Events(ev => ev
                                    .Error("error_handler(\"CompanyDocument#=FleetBoloRegistrationId#\")")
                                    .RequestStart("onRequestStart(\"CompanyDocument#=FleetBoloRegistrationId#\")")
                                    .RequestEnd("onRequestEnd(\"CompanyDocument#=FleetBoloRegistrationId#\")"))
                                    .Model(model => model.Id(p => p.BoloRegistrationDocumentId))
                                    .Read(read => read.Action("BoloRegistrationDoc_Read", "FleetBoloRegistration", new { id = "#=FleetBoloRegistrationId#", area = "FleetManagement" }).Data("sendForgery"))
                                    .Destroy(destroy => destroy.Action("BoloRegistrationDoc_Delete", "FleetBoloRegistration", new { area = "FleetManagement" }).Data("sendForgery"))
                                    ).ToClientTemplate())
    </text>
}
<script type="text/javascript">
    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    //function filterFleet() {
    //    return {
    //        text: $("#FleetId").data("kendoDropDownList").filterInput.val(),
    //        equipmentNameId: $("#EquipmentNameId").val()
    //    };
    //}
    function detailExpand(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.FleetInsuranceId;
        //isDeptapproved = masterDataItem.IsDepartmentOnlineApproved;
        //isDeptSendForApproval = masterDataItem.IsDepartmentSendForApproval;
    }
    function onDataBoundMaster(e) {
        var grid = this;
        var data = grid.dataSource.view();
        var today = new Date();
        var expiredPlates = [];

        // Find the index of the column with title "Plate No"
        var fleetColIndex = grid.columns.findIndex(c => c.title === "Plate No");

        for (var i = 0; i < data.length; i++) {
            var row = grid.tbody.find("tr[data-uid='" + data[i].uid + "']");
            var expireDate = new Date(data[i].BoloExpireDate);

            if (expireDate < today) {
                row.css("background-color", "#ffcccc"); // light red for expired rows

                // Get displayed Plate No (text from the "Plate No" column)
                var plateNo = row.find("td").eq(fleetColIndex).text().trim();
                expiredPlates.push(plateNo);
            }
        }

        if (expiredPlates.length > 0) {
            alert("Bolo Registration of vehicle(s) with red backgroud is expired ");
        }
    }
    function filterFleet() {
        return {
            text: $("#FleetId").data("kendoDropDownList").filterInput.val(),
            // equipmentNameId: $("#EquipmentNameId").val()
        };
    }
   
    function filterEquipmentNames() {
        var dropdownlist = $("#EquipmentNameId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentTypeId: $("#EquipmentTypeId").val(),
            search: filterInput.val()
        };
    }
    function filterPlateNumber() {
        var dropdownlist = $("#EquipmentName").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentNameID: $("#EquipmentNameID").val(),
            search: filterInput.val()
        };
    }
    function filterCategory() {
        var dropdownlist = $("#EquipmentTypeId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentIdentityId: $("#EquipmentCategoryId").val(),
            search: filterInput.val()
        };

    }
    function onUploadSuccess(e) {
        var gridname = "#CompanyDocument" + codeid;
        $(gridname).data("kendoGrid").dataSource.read();
    }
    function globalOnSelect(e)
    {

    }
    function onUploadError(e) {

    }
</script>
<style>
    div.k-edit-form-container {
        width: auto;
        height: auto;
    }

    .row .col-sm-2 {
        width: 150px;
    }

    .row {
        margin: auto;
    }
</style>