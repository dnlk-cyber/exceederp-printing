
@{
    ViewBag.Title = "Tire Return";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend> Tire Return</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTireManagement.TireReturn>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.Brand).Width(140);
        columns.Bound(e => e.TireSize).Width(140);
     //   columns.Bound(e => e.Quantity).Width(200);
        columns.Bound(e => e.UnitPrice).Width(140);
        columns.Bound(e => e.InstalledDate).Width(200);
        
       
   
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);


    })
           .ToolBar(toolbar => toolbar.Create())
      .Editable(editable =>
      {
          editable.Mode(GridEditMode.PopUp).TemplateName("TireReturnEditor");
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Tire Return Information");
      })
    .Pageable()
    .Sortable()
    .Filterable()
    .Scrollable()
   // .Groupable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .ServerOperation(false)
                 .Events(events => events.Error("error_handler").Sync("sync_handler"))
        .Model(model =>
              {
                  model.Id(p => p.TireReturnID);
               
              })
                .Create(update => update.Action("TireReturn_Create", "TireReturn"))
                .Read(read => read.Action("TireReturn_Read", "TireReturn"))
                .Update(update => update.Action("TireReturn_Update", "TireReturn"))
                .Destroy(update => update.Action("TireReturn_Destroy", "TireReturn"))
  )
)

<script type="text/javascript">
    function error_handler(e) {    
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });        
            alert(message);
        }
    }
    function sync_handler(e) {
        this.read();

    }
    function onClick() {
        $("#grid").data("kendoGrid").addRow();
    }
</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
