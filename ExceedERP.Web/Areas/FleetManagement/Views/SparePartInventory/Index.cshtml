
<legend>    SparePart Inventory Map </legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetMaintenance.InventorySparePartMapping>()
    .Name("grid")
    .Columns(columns =>
    {

        columns.Bound(e => e.SpareType).EditorTemplateName("SpareTypeEditor").Width(140);
        columns.ForeignKey(c => c.InventoryCategoryId, (System.Collections.IEnumerable)ViewData["ItemCategorys"], "ItemCategoryCode", "Name").EditorTemplateName("ItemCategoryEditor").Width(140);
        columns.Bound(e => e.Remark).Width(140);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

    })
              .ToolBar(commands => commands.Create())
         .Editable(editable =>
         {
             editable.Mode(GridEditMode.InLine);
             editable.DisplayDeleteConfirmation("Are You Sure To Remove ");
         })  .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                             .Scrollable(h => h.Height(500))
    .DataSource(dataSource => dataSource
        .Ajax()
        .Model(model =>
              {
                  model.Id(p => p.InventorySparePartMappingId);

                  model.Field(p => p.InventorySparePartMappingId).Editable(false);

              })                          .Events(ev => ev
                                    .Error("error_handler(\"grid\")")
                                    .RequestStart("onRequestStart(\"grid\")")
                                    .RequestEnd("onRequestEnd(\"grid\")"))
                            .Create(update => update.Action("SparePartInventory_Create", "SparePartInventory").Data("sendForgery"))
                            .Read(read => read.Action("SparePartInventory_Read", "SparePartInventory").Data("sendForgery"))
                            .Update(update => update.Action("SparePartInventory_Update", "SparePartInventory").Data("sendForgery"))
                            .Destroy(update => update.Action("SparePartInventory_Destroy", "SparePartInventory").Data("sendForgery"))
  )
)

