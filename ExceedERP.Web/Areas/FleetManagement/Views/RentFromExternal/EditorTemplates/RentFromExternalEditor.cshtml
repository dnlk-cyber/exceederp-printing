@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@model ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentFromExternal
<script>
    function filterEquipmentIdentity() {
        return {
            EquipmentIdentityID: $("#EquipmentIdentity").val()
        };
    }
</script>
<div class="form">
    <div class="row fullrow">
        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.ProcurementSupplierID, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.ProcurementSupplierID)
                                   .ValuePrimitive(true)
                                   .OptionLabel("Select Supplier...")
                                   .DataTextField("Name")
                                   .DataValueField("Id")
                                   .Filter("contains")
                                   .DataSource(dataSource =>
                                   {
                                       dataSource.Read(read => read.Action("GetSuppliersForRentFromExternal", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("filterSupplier"))
                                       .ServerFiltering(true);
                                   })
                    )
                    @Html.ValidationMessageFor(model => model.ProcurementSupplierID, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.StartDate, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().DatePickerFor(model => model.StartDate)
                    @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <br />
            <div class="form-group">
                <div class="col-md-6">
                    @Html.Kendo().CheckBoxFor(model => model.RentalRateIncludingVAT)
                    @Html.ValidationMessageFor(model => model.RentalRateIncludingVAT, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.WorkingCapacity, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.WorkingCapacity)
                    @Html.ValidationMessageFor(model => model.WorkingCapacity, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.HP_CC, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.HP_CC)
                    @Html.ValidationMessageFor(model => model.HP_CC, "", new { @class = "text-danger" })
                </div>
            </div>

        </div>
        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.BranchId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.BranchId)
                                  .DataTextField("Text")
                                  .DataValueField("Value")
                                  .OptionLabel("Select Branch")
                                  .Filter(FilterType.Contains)
                                  .DataSource(d => d.Read(r => r.Action("GetBranchForRentFromExternal", "FleetManagementDataProvider"))))
                    @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            
            <div class="form-group">
                @Html.LabelFor(model => model.EndDate, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().DatePickerFor(model => model.EndDate)
                    @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.Description, "Descrption", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Description)
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.AdvancePayment, "Advanced Payment", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().NumericTextBoxFor(model => model.AdvancePayment)
                    @Html.ValidationMessageFor(model => model.AdvancePayment, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
        </div>
        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.CompanyAddress, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.CompanyAddress)
                    @Html.ValidationMessageFor(model => model.CompanyAddress, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.FuelCoveredBy, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.FuelCoveredBy)
                            .OptionLabel(" Select ")
                            .BindTo(EnumHelper.GetSelectList(typeof(ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentFromExternal.FuelCoveredenum))))
                    @Html.ValidationMessageFor(model => model.FuelCoveredBy, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.UnitOfWorkMeasurement, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.UnitOfWorkMeasurement)
                    @Html.ValidationMessageFor(model => model.UnitOfWorkMeasurement, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            
                <div class="form-group">
                   @Html.LabelFor(model => model.Hour, htmlAttributes: new { @class = "control-label col-md-8" })
                   <div class="col-md-6">
                      @Html.Kendo().TextBoxFor(model => model.Hour).HtmlAttributes(new {@disabled="disabled"})
                      @Html.ValidationMessageFor(model => model.Hour, "", new { @class = "text-danger" })
                   </div>
                </div>
               
            
        </div>
       
    </div>
</div>