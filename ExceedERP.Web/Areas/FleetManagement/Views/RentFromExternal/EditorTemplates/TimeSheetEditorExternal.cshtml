                    @(Html.Kendo().DropDownListFor(model => model.ChargeMethod)
                 .Name("ChargeMethod")     // <-- Required for popup editors
                 .DataTextField("Text")
                 .DataValueField("Value")
                 .ValuePrimitive(true)
                 .Events(ev => ev.Change("onChargeMethodChange"))
                 .BindTo(EnumExtension.EnumToSelectList(
                     typeof(ExceedERP.Core.Domain.FleetManagement.FleetRegistration.ChargeMethod)
                 ))
                    )
                    @Html.ValidationMessageFor(model => model.ChargeMethod, "", new { @class = "text-danger" })
                </div>
            </div>

