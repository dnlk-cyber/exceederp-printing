@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@model ExceedERP.Core.Domain.FleetManagement.FleetRegistration.TimeSheet
<div class="form">
    <div class="row fullrow">
        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.FleetsID, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.FleetsID).Name("FleetsID")
                          .DataTextField("PlateNumber")
                          .DataValueField("FleetsID")
                          .OptionLabel("Select ").Filter(FilterType.Contains)
                          .DataSource(d => d.Read(r => r.Action("OnTimeSheetFleetDDBind", "FleetManagementDataProvider").Data("FilterFleetId")).ServerFiltering(false)).Events(e => e.Change("BindFleetDetail")))
                    @Html.ValidationMessageFor(model => model.FleetsID, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.TypeofWork, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.TypeofWork)
                    @Html.ValidationMessageFor(model => model.TypeofWork, "", new { @class = "text-danger" })
                </div>
            </div> 
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.ChargeMethod, htmlAttributes: new { @class = "control-label col-md-8" })
