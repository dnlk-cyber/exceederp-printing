@helper FileUpload()
{
    <text>
        @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentFromExternalDocument>
                        ()
                        .Name("CompanyDocument#=RentFromExternalID#")

                        .Columns(columns =>
                        {
                            columns.Bound(x => x.RentFromExternalDocumentId).Hidden(true);
                            columns.Bound(c => c.FileName).ClientTemplate("<a href='/FleetManagement/RentFromExternal/DownloadRentFromExternalDocument?CompanyDocumentId=\\#=RentFromExternalDocumentId\\#'> <f class = 'fa fa-download'></i>&nbsp;&nbsp; \\#=FileName\\# </a>").Width(200);
                            columns.Command(command =>
                        {
                //command.Edit();
                command.Destroy();
                        }).Width(580);
                        })
                      .ToolBar(t => t.Template(
                                @<text>
                                    @(Html.Kendo().Upload()
                                    .Name("attachments")
                                    .Async(a => a.Save("RentFromExternalAttachment_Create", "RentFromExternal", new { id = "#=RentFromExternalID #" }))
                                    .Events(e => e.Complete("onUploadSuccess").Select("function(e) { globalOnSelect(e, ['.jpg', '.png', '.pdf'], 2 * 1024 * 1024); }")
                                    .Error("onUploadError")
                                    )
                                    .ShowFileList(false)
                                    .ToClientTemplate()
                                    )
                                </text>
                                        ))
                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .HtmlAttributes(new { style = "height: 350px;" })
                                .Sortable(sortable =>
                                {
                                    sortable.SortMode(GridSortMode.SingleColumn);
                                })
                                .Scrollable()
                                .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
                                // .Events(x => x.DataBound("onDataBoundLines"))
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .Events(ev => ev
                                    .Error("error_handler(\"CompanyDocument#=RentFromExternalID#\")")
                                    .RequestStart("onRequestStart(\"CompanyDocument#=RentFromExternalID#\")")
                                    .RequestEnd("onRequestEnd(\"CompanyDocument#=RentFromExternalID#\")"))
                                    .Model(model => model.Id(p => p.RentFromExternalDocumentId))
                                    .Read(read => read.Action("RentFromExternalDoc_Read", "RentFromExternal", new { id = "#=RentFromExternalID#", area = "FleetManagement" }).Data("sendForgery"))
                                    .Destroy(destroy => destroy.Action("RentFromExternalDoc_Delete", "RentFromExternal", new { area = "RentFromExternalID" }).Data("sendForgery"))
                                    ).ToClientTemplate())
    </text>
}
