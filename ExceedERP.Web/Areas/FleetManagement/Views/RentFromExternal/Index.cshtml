<script type="text/javascript">

    var IsApproved;
    var IsSendForApproved;
    var masterId;
    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.RentFromExternalID;
        IsApproved = masterDataItem.IsOnlineApproved;
        IsSendForApproved = masterDataItem.IsSendForApproval;

        var Equipmentgrid = "#Equipment" + masterId;
        if (IsSendForApproved == true) {
            $(Equipmentgrid).find(".k-toolbar").hide(); //hide toolbar
            $(".k-grid-top", Equipmentgrid).hide();
        }
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            console.log(dataItem.IsOnlineApproved);
            if (dataItem.IsSendForApproval == true && dataItem.IsExpired == false) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                $("Equipment" + masterId).find("k-header k-grid-toolbar k-grid-top").remove();
            }
            //if (dataItem.IsSendForApproval == true && dataItem.IsExpired == true && dataItem.IsOnlineApproved == false)
            //{
            //    console.log("Approved");
            //    $(this).find(".k-grid-edit").remove();
            //    $(this).find(".k-grid-delete").remove();
            //    $("Equipment" + masterId).find("k-header k-grid-toolbar k-grid-top").remove();
            //}

            if (dataItem.IsOnlineApproved == true || dataItem.IsOnlineApproved ==true) {
                $(this).css("background-color", "#b7ff9e");
            }
            if (dataItem.IsExpired == true)
            {
                $(this).find(".k-grid-edit").show();
                $(this).find(".k-grid-delete").show();
            }
            if (dataItem.DateDifference > 0 && dataItem.DateDifference <= 7) {
                $(this).css("background-color", "#ff9");
            }
            else if (dataItem.DateDifference < 0) {
                $(this).css("background-color", "#f00");
                var rentId = dataItem.RentFromExternalID;
                $.ajax({
                    url: "RentFromExternal/checkIfExpired",
                    data: { id: rentId },
                    type: "GET",
                    success: function (response) {
                        console.log("Expiration check successful:", response);
                    },
                    error: function (xhr, status, error) {
                        console.error("Error checking expiration:", error);
                    }
                });


            }
        });
    }
      function ChangeTruckType(e) {
    e.preventDefault(); // Prevent default button behavior
    var childGrid = $(e.currentTarget).closest(".k-grid").data("kendoGrid"); // Get the child grid instance
    var row = $(e.currentTarget).closest("tr"); // Find the closest row
          var dataItem = childGrid.dataItem(row); // Get data from the row
          if (dataItem.IsDumpTruck) {
              $.ajax({
                  type: "POST",
                  url: '@Url.Action("IsNotDumpTruck", "RentFromExternalEquipment", new { area = "FleetManagement" })',
                  data: { id: dataItem.RentFromExternalEquipmentId }, // Send the correct ID
                  success: function (result) {
                      console.log(result.Message);
                      location.reload(true);
                  },
                  error: function (result) {
                      alert(result);
                  }
              });
          }
          else {
               $.ajax({
        type: "POST",
        url: '@Url.Action("IsDumpTruck", "RentFromExternalEquipment", new { area = "FleetManagement" })',
        data: { id: dataItem.RentFromExternalEquipmentId }, // Send the correct ID
        success: function (result) {
            console.log(result.Message);
