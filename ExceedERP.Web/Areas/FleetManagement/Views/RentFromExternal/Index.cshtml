@model ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentFromExternal
@{
    var checkIsECWC = (string)ViewData["IsECWC"];
    bool isECWC = (checkIsECWC == "ECWC");
    bool IsMCG = (ViewBag.setting as string) == "MCG";
}
<script>
    function filterByEquipmentTypeDD() {
        return {
            EquipmentIdentityID: $("#EquipmentIdentityID").val()//,
            //    Search: filterInput.val()
        };

    }
    function filterFixedAssetSubCategory() {
        var dropdownlist = $("#SubType").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            Id: $("#EquipmentTypeID").val(),
            Search: filterInput.val()
        };
        return {

        };
    }
    function filterFixedAssetCategory() {

        var dropdownlist = $("#UnitNum").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            Id: $("#SubType").val(),
            Search: filterInput.val()
        };
    }
    function filterNameByTypePopUp() {

        var dropdownlist = $("#EquipmentName").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            EquipmentTypeId: "",
            Search: filterInput.val()
        };

    }
    function filterPlateNo() {

        var dropdownlist = $("#PlateNumber").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            Id: $("#SubType").val(),
            Search: filterInput.val()
        };
    }

    function filterChasisNo() {

        var dropdownlist = $("#ChasisNumber").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            Id: $("#SubType").val(),
            Search: filterInput.val()
        };
    }

    function filterSerialNo() {

        var dropdownlist = $("#SerialNo").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            Id: $("#SubType").val(),
            Search: filterInput.val()
        };
    }
    function onUploadSuccess(e) {

    }
</script>
<legend>Rent From External</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentFromExternal>()
                        .Name("grid")
                        .Columns(columns =>
                        {
                            columns.Bound(o => o.EndDate).Visible(false).Width(80);
                            columns.Bound(o => o.Num).Width(80);
                            columns.Bound(o => o.PlateNo).Width(90).Filterable(ftb => ftb.Multi(true).Search(true));
                            columns.ForeignKey(o => o.BranchId,(IEnumerable)ViewData["Branch"],"Value","Name").Width(130).Filterable(ftb => ftb.Multi(true).Search(true));
                            columns.Bound(o => o.Quantity).Width(100);
                            columns.Bound(o => o.StartDate).Width(80);
                            columns.Bound(o => o.EndDate).Width(80);
                            //columns.Bound(o => o.HP_CC).Width(80);
                            //columns.Bound(o => o.Hour).Width(80);
                            //columns.Bound(o => o.AdvancePayment).Width(80);
                            // columns.Bound(e => e.RentalRateIncludingVAT).Width(100).ClientTemplate("<input type='checkbox' disabled = 'true' #: RentalRateIncludingVAT? checked='checked': checked='' #/>");
                            columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["Supplier"], "ProcurementSupplierID", "Name").Width(130).Filterable(ftb => ftb.Multi(true).Search(true));
                            columns.Bound(o => o.TotalCost).Width(70);
                            columns.Bound(o => o.Operator).Width(70);
                            columns.Bound(e => e.Status).Width(100);
                            columns.Bound(e => e.DateDifference).Width(100);
                            columns.Bound(e => e.IsExpired).Width(100).ClientTemplate("<input type='checkbox' disabled = 'true' #: IsExpired? checked='checked': checked='' #/>");
                            columns.Bound(e => e.IsReplaced).Width(100).ClientTemplate("<input type='checkbox' disabled = 'true' #: IsReplaced? checked='checked': checked='' #/>");
                            columns.Command(command => { command.Edit(); command.Destroy(); }).Width(200);
                        }).Events(ev =>
                        {
                            ev.DataBound("onDataBound");
                        })
                        .ToolBar(t => { t.Create();
                            t.Custom()
                                .Text("Equipment Type")
                                .HtmlAttributes(new
                                {
                                    id = "approveEquipmentType"
                                });
                            t.Custom()
    .Text("Approve Rented Equipments")
    .Name("ApproveRentedEquipments")
    .HtmlAttributes(new
    {
        id = "approveRentedEquipments"
    });

                            
                            t.Custom()
                             .Text("Arrange Fleet Reference In TimeSheets")
                             .Name("ArrangeFleetReferenceInTimeSheets")
                             .HtmlAttributes(new
                             {
                                 id = "arrangeFleetReferenceInTimeSheets"
                             });
                        })

                        .Editable(editable =>
                        {
                            editable.Window(w => w.Title("Rent From External"));
                            editable.Mode(GridEditMode.PopUp).TemplateName("RentFromExternalEditor");
                            editable.DisplayDeleteConfirmation("Are You Sure To Remove Rent Information");
                        })
                        .HtmlAttributes(new { style = "height: 520px;" })
                        .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))
                        .Scrollable()
                        .Sortable()
                        .Filterable()
                        //.Groupable()
                        .Scrollable(h => h.Height(500))
                        .ClientDetailTemplateId("template")
                        .Events(ev =>
                        {
                            ev.DetailExpand("onDetailExpand");
                            //ev.DataBound("expiredDataBound");
                        })
                        .DataSource(dataSource => dataSource
    .Ajax()
    .ServerOperation(false)
    .Sort(sort => sort.Add(so => so.DateCreated).Descending())
    .Model(model =>
    {
        model.Id(p => p.RentFromExternalID);
        model.Field(p => p.RentFromExternalID).Editable(false);
        model.Field(p => p.Num).Editable(false);
    })
    .Events(ev => ev
        .Error("error_handler(\"grid\")")
        .RequestStart("onRequestStart(\"grid\")")
        .RequestEnd("onRequestEnd(\"grid\")")
    )
    .Create(create => create.Action("RentFromExternal_Create", "RentFromExternal").Data("sendForgery"))
    .Read(read => read.Action("RentFromExternal_Read", "RentFromExternal").Data("sendForgery"))
    .Update(update => update.Action("RentFromExternal_Update", "RentFromExternal").Data("sendForgery"))
    .Destroy(del => del.Action("RentFromExternal_Destroy", "RentFromExternal").Data("sendForgery"))
)
)
