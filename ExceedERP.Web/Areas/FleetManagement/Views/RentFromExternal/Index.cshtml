<legend>Rent From External</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetEquipmentRent.RentFromExternal>()
        .Name("grid")
        .Columns(columns =>
        {
            columns.Bound(o => o.Num).Width(80);
            columns.Bound(o => o.ProjectLocation).Width(120);
            columns.Bound(o => o.Quantity).Width(100);
            columns.Bound(o => o.CompanyName).Width(120);
            columns.Bound(o => o.TotalCost).Width(120);
            columns.Bound(e => e.Status).Width(100);

            columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

        }).Events(ev =>
                            {
                                ev.DataBound("onDataBound");
                            })
               .ToolBar(t => t.Create())


            .Editable(editable =>
            {
                editable.Window(w => w.Title("Rent From External"));
                editable.Mode(GridEditMode.PopUp).TemplateName("RentFromExternalEditor");
                editable.DisplayDeleteConfirmation("Are You Sure To Remove Rent Information");
            })
             .HtmlAttributes(new { style = "height: 520px;" })
                              .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))

                                    .Scrollable()
                                    .Sortable()
                                    .Filterable()
                                    .Groupable()
                                    .Scrollable(h => h.Height(500))
                                              .Groupable().ClientDetailTemplateId("template").Groupable().Events(ev => ev.DetailExpand("onDetailExpand"))
                                    .DataSource(dataSource => dataSource
            .Ajax()
            .ServerOperation(false)
                         .Model(model =>
                  {
                      model.Id(p => p.RentFromExternalID);
                      model.Field(p => p.RentFromExternalID).Editable(false);
                      model.Field(p => p.Num).Editable(false);
                  }).Events(ev => ev
                                                        .Error("error_handler(\"grid\")")
                                                        .RequestStart("onRequestStart(\"grid\")")
                                                        .RequestEnd("onRequestEnd(\"grid\")"))
                        .Create(create => create.Action("RentFromExternal_Create", "RentFromExternal"))
                        .Read(read => read.Action("RentFromExternal_Read", "RentFromExternal"))
                        .Update(read => read.Action("RentFromExternal_Update", "RentFromExternal"))
                        .Destroy(read => read.Action("RentFromExternal_Destroy", "RentFromExternal"))
      )
)




