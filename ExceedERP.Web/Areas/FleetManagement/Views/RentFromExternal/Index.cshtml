<script type="text/javascript">

    var IsApproved;
    var IsSendForApproved;
    var masterId;
    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.RentFromExternalID;
        IsApproved = masterDataItem.IsOnlineApproved;
        IsSendForApproved = masterDataItem.IsSendForApproval;

        var Equipmentgrid = "#Equipment" + masterId;
        if (IsSendForApproved == true) {
            $(Equipmentgrid).find(".k-toolbar").hide(); //hide toolbar
            $(".k-grid-top", Equipmentgrid).hide();
        }
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            console.log(dataItem.IsOnlineApproved);
            if (dataItem.IsSendForApproval == true || dataItem.IsSendForApproval == "true") {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                $("Equipment" + masterId).find("k-header k-grid-toolbar k-grid-top").remove();
            }
            if (dataItem.IsOnlineApproved == true || dataItem.IsOnlineApproved == "true")
            {

                $(this).css("background-color", "#b7ff9e");

            }
            if (dataItem.DateDifference > 0 && dataItem.DateDifference <= 7) {
                $(this).css("background-color", "#ff9");
            }
            else if (dataItem.DateDifference < 0) {
                $(this).css("background-color", "#f00");
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }
    function filterEquipments() {
        return {
            equipmentTypeId: $("#EquipmentTypeID").val()
        };
   
    }
    function filterSupplier() {
        return {
            text: $("#ProcurementSupplierID").val()
        };
    }
    function onChangeFleet()
    {
        $.ajax({
            url: '@Url.Action("GetFleetEquipmentById", "FleetManagementDataProvider")',
            data: { fleetId: this.value() },
            type: 'GET',
            cache: false,
            success: function (result) {
                $("#SerialNumber").val(result.SerialNo).trigger("change");
                $("#Model").val(result.Model).trigger("change");
                $("#ChasisNumber").val(result.ChasisNo).trigger("change");
                $("#EngineManufacturer").val(result.EngineManufacturer).trigger("change");
                $("#EngineNumber").val(result.EngineNumber).trigger("change");
                $("#AssetCode").val(result.UnitNum).trigger("change");
                $("#EquipmentName").val(result.EquipmentName).trigger("change");


            }
        });

    }
</script>



