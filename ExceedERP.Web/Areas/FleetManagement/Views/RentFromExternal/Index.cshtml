<script>
    function PopulateFleetInformation() {

        var EquipmentNameObject = $("#EquipmentName").data("kendoDropDownList");
        var EquipmentNameID = EquipmentNameObject.value();
        $.ajax({
            url: '@Url.Action("FleetInformationByPlateNumber", "FleetManagementDataProvider")',
            data: { Id: EquipmentNameID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r != null || r != "") {

                    //if (r.IsRegistered == true) {
                    //    alert(r.Tag + " Asset No Already Registered");
                    //}
                    $("#PlateNumber").val(r.PlateNumber).trigger("change");
                    $("#Model").val(r.Model).trigger("change");
                    $("#Capacity").val(r.ChasisNo).trigger("change");
                    $("#Capacity").val(r.Capacity).trigger("change");
                    $("#SerialNo").val(r.SerialNo).trigger("change");
                    $("#RentalRate").val(r.RentalRate).trigger("change");
                    $("#ChasisNumber").val(r.ChasisNumber).trigger("change");
                    $("#EngineNumber").val(r.EngineNumber).trigger("change");
                    $("#EngineModel").val(r.Location).trigger("change");
                    $("#Manufacturer").val(r.Manufacturer).trigger("change");
                    $("#Libre").val(r.Libre).trigger("change");
                    $("#ManufacturerYear").val(r.ManufacturerYear).trigger("change");
                    $("#PlannerID").val(r.PlannerID).trigger("change");
                    $("#IdealRentalRate").val(r.IdealRentalRate).trigger("change");
                    $("#RentType").val(r.RentType).trigger("change");
                    $("#MinFuelStandard").val(r.MaxFuelStandard).trigger("change");
                    $("#MaxFuelStandard").val(r.MinFuelStandard).trigger("change");
                    }
                else {
                    $("#Manufacturer").val("");
                    $("#SerialNo").val("");
                    $("#PlateNumber").val("");
                    $("#EngineNumber").val("");
                    $("#Location").val("");
                    $("#Model").val("");
                    $("#TyreSize").val("");
                    $("#SupplierCompany").val("");
                    $("#Condition").val("");
                    $("#EquipmentName").val("");
                    $("#Battery").val("");
                    $("#Capacity").val("");
