              $.ajax({
                  type: "POST",
                  url: '@Url.Action("IsNotDumpTruck", "RentFromExternalEquipment", new { area = "FleetManagement" })',
                  data: { id: dataItem.RentFromExternalEquipmentId }, // Send the correct ID
                  success: function (result) {
                      console.log(result.Message);
                      location.reload(true);
