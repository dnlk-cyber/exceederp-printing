@{
    ViewBag.Title = "Equipment Type ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>     Equipment Type Fuel Consumption  </legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.FleetIFuelConsumption>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.ForeignKey(e => e.EquipmentIdentityID, (System.Collections.IEnumerable)ViewData["EquipmentIdentity"], "EquipmentIdentityId", "EquipmentCategoryName").EditorTemplateName("EquipmentIdentitiesEditor").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);

        columns.ForeignKey(c => c.EquipmentTypeID, (System.Collections.IEnumerable)ViewData["EquipmentType"], "EquipmentTypeId", "EquipmentTypeName").EditorTemplateName("EquipmentTypeEditor").Title("Equipment Type").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
        columns.Bound(e => e.MaxConsupmtion).Width(120);
        columns.ForeignKey(c => c.UoMName, (System.Collections.IEnumerable)ViewData["UoM"], "UoMName", "UoMName").EditorTemplateName("UnitOfMeasurement1").Title("Unit of Measurment").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120);


        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

    })
              .ToolBar(commands => commands.Create())
         .Editable(editable =>
         {
             editable.Mode(GridEditMode.InLine);
             editable.DisplayDeleteConfirmation("Are You Sure To Remove Equipment Type");
         }).HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Scrollable(h => h.Height(500))
    .DataSource(dataSource => dataSource
        .Ajax()
        .Model(model =>
        {
            model.Id(p => p.FleetIFuelConsumptionId);

            model.Field(p => p.FleetIFuelConsumptionId).Editable(false);

        })
              .Sort(so => so.Add(s => s.FleetIFuelConsumptionId).Descending())
              .Events(ev => ev
                                    .Error("error_handler(\"grid\")")
                                    .RequestStart("onRequestStart(\"grid\")")
                                    .RequestEnd("onRequestEnd(\"grid\")"))
                            .Create(update => update.Action("FleetIFuelConsumption_Create", "EquipmentTypeFuelConsumption").Data("sendForgery"))
                            .Read(read => read.Action("FleetIFuelConsumption_Read", "EquipmentTypeFuelConsumption").Data("sendForgery"))
                            .Update(update => update.Action("FleetIFuelConsumption_Update", "EquipmentTypeFuelConsumption").Data("sendForgery"))
                            .Destroy(update => update.Action("FleetIFuelConsumption_Destroy", "EquipmentTypeFuelConsumption").Data("sendForgery"))
  )
)

<script>
    function filterEquipmentTypes() {
        var dropdownlist = $("#EquipmentTypeID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentIdentityId: $("#EquipmentIdentityID").val(),
            search: filterInput.val()
        };
    }

    function filterEquipmentCategories() {
        var dropdownlist = $("#EquipmentIdentityID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            search: filterInput.val()
        };
    }
</script>