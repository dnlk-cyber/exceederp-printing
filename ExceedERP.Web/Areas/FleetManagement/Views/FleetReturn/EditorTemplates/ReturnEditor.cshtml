@model  ExceedERP.Core.Domain.FleetManagement.FleetRegistration.FleetReturn

<script>

    function filterByType() {
        var dropdownlist = $("#EquipmentName").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            EquipmentTypeId: $("#EquipmentCategoryId").val(),
            Search: filterInput.val()
        };
     
    }
    function filterEquipmentIdentity() {

        var dropdownlist = $("#EquipmentCategoryId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            EquipmentIdentityID: $("#EquipmentTypeId").val(),
            Search: filterInput.val()
        };

    }
    function PopulateFleets()
    {
        var dropdownlist = $("#FleetsId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            Id: $("#EquipmentName").val(),
            Search: filterInput.val()
        };

       
    }
    function filterEquipment() {
        var dropdownlist = $("#FleetsId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            Type: $("#EquipmentName").val(), Search: filterInput.val()
        };
    }
     
    </script>
<br />

