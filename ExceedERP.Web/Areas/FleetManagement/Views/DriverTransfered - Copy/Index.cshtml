@model ExceedERP.Core.Domain.FleetManagement.FleetResource.DriverVehicleTransfer
@{
    ViewBag.Title = "Driver Transfer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .lbl {
        position: relative;
        display: block;
        height: 40px;
        width: 64px;
        background: #898989;
        border-radius: 100px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .lbl:after {
            position: absolute;
            left: -2px;
            top: -3px;
            display: block;
            height: 40px;
            width: 54px;
            border-radius: 100px;
            background: #fff;
            box-shadow: 0px 3px 3px rgba(243, 245, 247, 0.05);
            content: '';
            transition: all 0.3s ease;
        }

        .lbl:active:after {
            transform: scale(1.15, 0.85);
        }

    .cbx:checked ~ label {
        background: #32a6f3;
    }

        .cbx:checked ~ label:after {
            left: 20px;
            background: #5a666e;
        }

    .cbx:disabled ~ label {
        background: #d5d5d5;
        pointer-events: none;
    }

        .cbx:disabled ~ label:after {
            background: #bcbdbc;
        }

    .container {
        position: absolute;
        top: 250px;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .demo {
        margin-bottom: 40px;
    }

    .hidden {
        display: none;
    }
</style>
<legend>Driver Transfer</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.DriverVehicleTransfer>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["Category"], "Value", "Text").Width(120);
              columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["Type"], "Value", "Text").Width(120);
              columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["Name"], "Value", "Text").Width(120);
              columns.ForeignKey(c => c.FleetId, (IEnumerable)ViewData["Fleet"], "Value", "Text").Width(120);
              columns.ForeignKey(e => e.FromOperatorId, (System.Collections.IEnumerable)ViewData["Operators"], "Id", "Name").Width(140);
              columns.ForeignKey(e => e.ToOperatorId, (System.Collections.IEnumerable)ViewData["Operators"], "Id", "Name").Width(140);
              columns.Bound(e => e.StartingDate).Width(140);
              columns.Bound(e => e.ToDate).Width(140);
              columns.Bound(e => e.Status).Width(100);
              columns.Command(command =>
              {
                  command.Edit(); command.Destroy();
              }).Width(250);


          }).Events(ev =>
          {
              ev.DetailExpand("onDetailExpand");
              ev.DataBound("onDataBound");

          })
              .ToolBar(commands =>
              {
                  commands.Create();
              }).Editable(editable =>
              {
                  editable.Mode(GridEditMode.PopUp).TemplateName("DriverVehicleTransferEditor").Window(x => x.Title(" Driver Transfer"));
                  editable.DisplayDeleteConfirmation("Are You Sure To Remove Driver Transfer");
              })
              .HtmlAttributes(new { style = "height: 520px;" })
                  .Pageable(pageable => pageable
                     .Input(true)
                     .Numeric(false)
                     .Refresh(true)
                     .PageSizes(true)
                     .ButtonCount(5))
                     .Scrollable()
                     .Sortable()
                     .Filterable()
                     .Scrollable(h => h.Height(500))
                     .ClientDetailTemplateId("template")
                     .Events(ev =>
                     {
                         ev.DetailExpand("onDetailExpandUser");
                         ev.DataBound("onDataBound");
                     })
                   .DataSource(dataSource => dataSource
              .Ajax()
          
                       .Model(model =>
                       {
                           model.Id(p => p.DriverVehicleTransferID);

                       })
                             .Events(ev => ev
                                    .Error("error_handler(\"grid\")")
                                    .RequestStart("onRequestStart(\"grid\")")
                                    .RequestEnd("onRequestEnd(\"grid\")"))
              .Create(create => create.Action("DriverVehicleTransfer_Create", "DriverTransfer").Data("sendForgery"))
              .Read(read => read.Action("DriverVehicleTransfer_Read", "DriverTransfer").Data("sendForgery"))
              .Update(update => update.Action("DriverVehicleTransfer_Update", "DriverTransfer").Data("sendForgery"))
              .Destroy(update => update.Action("DriverVehicleTransfer_Destroy", "DriverTransfer").Data("sendForgery"))
          ))


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                            .Name("tabStrip_#=DriverVehicleTransferID#")
                            .SelectedIndex(0)
                            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                            .Items(items =>
                            {
                                items.Add().Text("Detail").Content(
                                    @<text>
                                        <legend>Detail</legend>

                                        <div class="box">

                                            <div class="box-col">

                                                # if (IsSendForApproval == false || IsSendForApproval == "false")
                                                {#
                                                <a href='@Url.Action("DriverVehicleTransfer_SendForOnlineApproval", "DriverVehicleTransferApproval")/?EId=#=DriverVehicleTransferID#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                                # }#
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-1">
                                            </div>
                                            <div class="col-md-6" style="margin-top:20px;">
                                                <ul>
                                                    <li>
                                                        @Html.LabelFor(model => model.CreatedBy):<span>#=CreatedBy#</span>
                                                    </li>
                                                    <li>
                                                        @Html.LabelFor(model => model.DateCreated):<span>#=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #</span>
                                                    </li>
                                                    <li>
                                                        @Html.LabelFor(model => model.ModifiedBy):<span>#=ModifiedBy#</span>
                                                    </li>
                                                    <li>
                                                        @Html.LabelFor(model => model.LastModified):<span>#=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy')#</span>
                                                    </li>
                                                </ul>




                                            </div>

                                        </div>



                                    </text>


                                            );

                                        items.Add().Text(" Tyre ").Content(@<text>

                                            @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.SiteVechicleTransferTyreDetail>()
                                                                .Name("TyresGrid_#=DriverVehicleTransferID#")
                                                                .Columns(columns =>
                                                                {
                                                                                    columns.Bound(o => o.Type).Width(120);
                                                                                    columns.Bound(o => o.SerialNo).Width(120);
                                                                                    columns.Bound(o => o.Description).Width(126);
                                                                                    columns.Bound(c => c.CreatedBy).Width(150);
                                                                                    columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                                                                                })

                                                                     .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                               .DataSource(dataSource => dataSource
                                                                    .Ajax()
                                                                    .PageSize(5)
                                                                                              .Model(model =>
                                                                      {
                                                                                          model.Id(p => p.SiteVechicleTransferTyreDetailId);
                                                                                          model.Field(p => p.CreatedBy).Editable(false);
                                                                                          model.Field(p => p.DateCreated).Editable(false);
                                                                                      })
                                                                                               .Events(ev => ev
                                                                                                   .Error("error_handler(\"TyresGrid_#=DriverVehicleTransferID#\")")
                                                                                                           .RequestStart("onRequestStart(\"TyresGrid_#=DriverVehicleTransferID#\")")
                                                                                                           .RequestEnd("onRequestEnd(\"TyresGrid_#=DriverVehicleTransferID#\")"))
                                                                                                                                                                                   .Create(update => update.Action("SiteVechicleTransferDetail_Create", "SiteVechicleTransferDetail", new { Id = "#=DriverVehicleTransferID#" }).Data("sendForgery"))
                                                                                                                                                                                             .Read(read => read.Action("SiteVechicleTransferTyre_Read", "SiteVechicleTransferTyre", new { Id = "#=DriverVehicleTransferID#" }).Data("sendForgery"))
                                                                                                                                                                                   .Update(update => update.Action("SiteVechicleTransferDetail_Update", "SiteVechicleTransferTyre").Data("sendForgery"))


                                                                                              )
                                                                                       .ToClientTemplate())
                                        </text>
                                           );


                                                items.Add().Text(" Check List ").Content(@<text>



                                                    <div class="form-group">
                                                        # if (  IsOnlineApproved == true)
                                                        {#

                                                        <div style=" padding:10px" id="approvedlines#=DriverVehicleTransferID#"></div>
                                                        # }

                                                        else
                                                        {#
                                                        <form action="/CheckListLog/DriverTransferCheckList" method="post">

                                                            <div style=" padding:30px" id="lines#=DriverVehicleTransferID#"></div>
                                                            <input type="hidden" name="Id" value="#=DriverVehicleTransferID#">
                                                            <input type="submit" class="k-primary  form-control " value=" Inspect " />

                                                        </form>
                                                        # }#
                                                    </div>

                                                </text>


                                                );

                                                        items.Add().Text(" Approval").Content(@<text>

                                                            @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.DriverTransferApproval>()
                                                                                     .Name("DriverTransferApproval#=DriverVehicleTransferID#")
                                                                                    .Columns(columns =>
                                                                                    {
                                                                                                                        columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                                                                                                                        columns.Bound(o => o.Remark).Width(200);
                                                                                                                        columns.Bound(c => c.CreatedBy).Width(150);
                                                                                                                        columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                                                                                                                        columns.Command(command => { command.Edit(); }).Width(250);

                                                                                                                    }).Events(ev =>
                                                                                                                               {
                                                                                                                                                   ev.DataBound("approveonDataBound");
                                                                                                                                               })
                                                                                         .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                                                   .DataSource(dataSource => dataSource
                                                                                        .Ajax()
                                                                                        .PageSize(5)
                                                                                                                    .Model(model =>
                                                                                          {
                                                                                                                              model.Id(p => p.DriverTransferApprovalID);
                                                                                                                              model.Field(p => p.CreatedBy).Editable(false);
                                                                                                                              model.Field(p => p.DateCreated).Editable(false);
                                                                                                                          })
                                                                                                                                            .Events(ev => ev
                                                                                                                .Error("error_handler(\"DriverTransferApproval#=DriverVehicleTransferID#\")")
                                                                                                                .RequestStart("onRequestStart(\"DriverTransferApproval#=DriverVehicleTransferID#\")")
                                                                                                                .RequestEnd("onRequestEnd(\"DriverTransferApproval#=DriverVehicleTransferID#\")"))
                                                                                                                                                                                                                               .Create(update => update.Action("DriverVehicleTransfer_Approve", "DriverVehicleTransferApproval", new { EId = "#=DriverVehicleTransferID#" }).Data("sendForgery"))
                                                                                                                                                                                                                                 .Read(read => read.Action("DriverVehicleTransferApproval_Read", "DriverVehicleTransferApproval", new { EId = "#=DriverVehicleTransferID#" }).Data("sendForgery"))
                                                                                                                                                                       .Update(update => update.Action("DriverVehicleTransfer_Approve", "DriverVehicleTransferApproval").Data("sendForgery"))


                                                                                                                  )
                                                                                                           .ToClientTemplate())
                                                        </text>
                                                            );
                                                            })
                                                                                                                                                                                                                                                                                                                                                                                                                .ToClientTemplate())
</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
<script type="text/javascript">
    function filterFleet() {
        return {
            text: $("#FleetId").data("kendoDropDownList").filterInput.val(),
            equipmentNameId: $("#EquipmentNameId").val()
        };
    }
    function filterEquipmentNames() {
        var dropdownlist = $("#EquipmentNameId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentTypeId: $("#EquipmentTypeId").val(),
            search: filterInput.val()
        };
    }
    function filterPlateNumber() {
        var dropdownlist = $("#EquipmentName").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentNameID: $("#EquipmentNameID").val(),
            search: filterInput.val()
        };
    }
    function filterCategory() {
        var dropdownlist = $("#EquipmentTypeId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentIdentityId: $("#EquipmentCategoryId").val(),
            search: filterInput.val()
        };

    }
    var masterId;
    var fleetPlate;
      var IsSendForApproval;
    var PlateNo;
    var IsApproved;
    var FromFleet;
    var ToFleet;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        IsApproved = masterDataItem.IsOnlineApproved;
        masterId = masterDataItem.DriverVehicleTransferID;
        ToFleet = masterDataItem.ToEquipment;
        FromFleet = masterDataItem.FromEquipment;
        IsSendForApproval = masterDataItem.IsSendForApproval;
        var category = "";
        var lineitem = "";
        var index = 0;

        if (IsSendForApproval == false) {
            $.ajax({
                url: '@Url.Action("DriverTransferCheckList_Read", "CheckListLog")',
                data: { FromFleetId: FromFleet, ToFleetId: ToFleet },
                  type: 'POST',
                cache: false,
                success: function (list) {
                    try {
                    for (var i = 0 ; i < list.length; i++) {

                        lineitem += "    <div class='col-sm-12 form-group'>";
                        if (category != list[i].CategoryName) {

                            lineitem += "       <div class='col-sm-6'><h2 style='background-color:greenyellow'>" + list[i].CategoryName + " </h2></div>";
                            category = list[i].CategoryName;
                        }
                        lineitem += "<div class='col-sm-3'  >  <input type='hidden' name=model.CheckListViewModel[" + index + "].InspectionId  value=" + masterId + ">   <input type='hidden' name=model.CheckListViewModel[" + index + "].LineName  value=" + list[i].LineName + " '>     <input type='hidden' name=model.CheckListViewModel[" + index + "].LineCode  value=" + list[i].LineCode + " '>    <input type='hidden' name=model.CheckListViewModel[" + index + "].CategoryName  value=" + list[i].CategoryName + " '>  <label class='k-label' ><h4> " + list[i].LineName + "</h4></label>   <input type='checkbox' id='checked" + i + "' class='cbx hidden' checked    name='model.CheckListViewModel[" + i + "].IsActive'   >   <label for='checked" + i + "' class='lbl'></label>    </div>    ";
                        lineitem += "  <input type='text' name='model.CheckListViewModel[" + i + "].Remark' value='' class=' '   style='padding: 5px;'>";

                        index++;

                        lineitem += "</div> </div>";
                    }
                        document.getElementById("lines" + masterId).innerHTML = lineitem;
                    } catch (err) {
                        console.log("error to inner " + err);
                    }
                }

            });
        }
        if (IsSendForApproval == true) {
            $.ajax({
                url: '@Url.Action("DriverTransferCheckList_Read", "CheckListLog")',
                data: { FromFleetId: FromFleet, ToFleetId: ToFleet },

                type: 'POST',
                cache: false,
                success: function (list) {
                    for (var i = 0 ; i < list.length; i++) {


                        lineitem += "    <div class='col-sm-12'>";
                        if (category != list[i].CategoryName) {

                            lineitem += "       <div class='col-sm-12'><h2 style='background-color:greenyellow'>" + list[i].CategoryName + " </h2></div>";
                            category = list[i].CategoryName;
                        }
                        index++;

                        lineitem += " </div>";
                    }
                    try {
                        document.getElementById("approvedlines" + masterId).innerHTML = lineitem;
                    }
                    catch (Err)
                    { }
                }

            });
        }
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            console.log(dataItem.IsOnlineApproved);
            if (dataItem.IsSendForApproval == true || dataItem.IsSendForApproval == "true") {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            } if (dataItem.IsOnlineApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

</script>

<style>
    div.k-edit-form-container {
        width: auto;
        height: auto;
    }

    .row .col-sm-2 {
        width: 150px;
    }

    .row {
        margin: auto;
    }
</style>