@model ExceedERP.Core.Domain.FleetManagement.EquipmentInspection.AnnualEquipmentInventoryInspection
@{
   
    Layout = "~/Views/Shared/_Layout.cshtml";
}
 <link href="~/Scripts/Exceed/dist/css/style.css" rel="stylesheet" />

<legend>Annual Equipment Inspection</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.EquipmentInspection.AnnualEquipmentInventoryInspection>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["Category"], "Value", "Text").Width(120);
        columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["Type"], "Value", "Text").Width(120);
        columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["Name"], "Value", "Text").Width(120);
        columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["Fleet"], "Value", "Text").Width(120);
        columns.Bound(e => e.InspectedBy).Width(140);
        columns.Bound(e => e.DateofInspection).Title("Date").Format("{0:d}").Width(100);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

    })
        .ToolBar(commands =>
        {
            commands.Create();

        }).Events(ev =>
        {
            ev.DataBound("onDataBound");
        })
         .Editable(editable =>
         {
             editable.Mode(GridEditMode.PopUp)
             .TemplateName("InspectionEditor");
             //editable.DisplayDeleteConfirmation("Are You Sure To Remove Plan and Evaluations");
         })
         .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Scrollable(h => h.Height(500))
                            .ClientDetailTemplateId("template")
                            .Events(ev => ev.DetailExpand("RejectPopUp"))
                            .DataSource(dataSource => dataSource
                            .Ajax()
                           
                            .Model(model => model.Id(p => p.AnnualEquipmentInventoryInspectionID))
                            .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
                            .Create(update => update.Action("AnnualEquipmentInventoryInspection_Create", "AnnualEquipmentInventoryInspection").Data("sendForgery"))
                            .Read(read => read.Action("AnnualEquipmentInventoryInspection_Read", "AnnualEquipmentInventoryInspection").Data("sendForgery"))
                            .Update(update => update.Action("AnnualEquipmentInventoryInspection_Update", "AnnualEquipmentInventoryInspection").Data("sendForgery"))
                            .Destroy(update => update.Action("AnnualEquipmentInventoryInspection_Delete", "AnnualEquipmentInventoryInspection").Data("sendForgery"))
  )
      )


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                    .Name("tabStrip_#=AnnualEquipmentInventoryInspectionID#")
                    .SelectedIndex(0)
                    .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                    .Items(items =>
                    {
                        items.Add().Text("Check List").Content(@<text>


                            # if (IsSendForApproval == false || IsSendForApproval == "false")
                            {#
                            <a onclick='return sendForApproval("#=AnnualEquipmentInventoryInspectionID#")' href=' \#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>

                            @*<a href='@Url.Action("SendForOnlineApproval", "AnnualEquipmentInventoryInspection")/?id=#=AnnualEquipmentInventoryInspectionID#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>*@
                            # }#
                            <div class="form-group">
                                <div class="label">
                                    <label>Status</label>
                                </div>
                                <div>
                                    # if (IsSendForApproval == false && IsOnlineApproved == false)
                                    {#

                                    <p>Editing</p>
                                    # }

                                    else if (IsSendForApproval == true && IsOnlineApproved == false)
                                    {#

                                    <p>Waiting For Approval</p>
                                    # }

                                    else if (IsOnlineApproved == true)
                                    {#

                                    <p>  Approved </p>
                                    # }#
                                </div>

                            </div>
                        </text>
                                );

                                items.Add().Text("Inspection Log").Content(@<text>
                                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.EquipmentInspection.InspectionLog>()
                                                .Name("loggrid_#=AnnualEquipmentInventoryInspectionID#")
                                                .Columns(columns =>
                                                {
                                                    columns.Bound(o => o.SystemName).Width(100);
                                                    columns.Bound(o => o.CheckList).Width(100);
                                                    //columns.Bound(o => o.StatusKey).Width(100);
                                                    columns.ForeignKey(o => o.StatusKeyId, (IEnumerable)ViewData["StatusKey"], "Value", "Name").EditorTemplateName("StatusKeySelector").Width(100);
                                                    columns.Bound(o => o.Remark).Width(100);
                                                    columns.Command(command => { command.Edit(); }).Width(250);
                                                })
                                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                .Events(ev =>
                                                {
                                                    ev.DataBound("approveonDataBound");
                                                })
                                                .DataSource(dataSource => dataSource
                                                    .Ajax()
                                                    .PageSize(5)

                                                     .Model(model =>
                                                     {
                                                         model.Id(p => p.InspectionLogId);
                                                         model.Field(f => f.SystemName).Editable(false);
                                                         model.Field(f => f.CheckList).Editable(false);

                                                     })
                                                                .Events(ev => ev
                                                                    .Error("error_handler(\"loggrid_#=AnnualEquipmentInventoryInspectionID#\")")
                                                                    .RequestStart("onRequestStart(\"loggrid_#=AnnualEquipmentInventoryInspectionID#\")")
                                                                    .RequestEnd("onRequestEnd(\"loggrid_#=AnnualEquipmentInventoryInspectionID#\")"))
                                                                    .Read(read => read.Action("AnnualInspectionlog_Read", "AnnualEquipmentInventoryInspection", new { Id = "#=AnnualEquipmentInventoryInspectionID#" }).Data("sendForgery"))
                                                                    .Update(read => read.Action("InspectionLog_Update", "AnnualEquipmentInventoryInspection").Data("sendForgery"))
                                                                    )
                                                                    .ToClientTemplate())
                                </text>
                           );
                                        items.Add().Text("Approval").Content(
            @<text>

                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.EquipmentInspection.InspectionApproval>()
                            .Name("approvalitemgrid_#=AnnualEquipmentInventoryInspectionID#")
                            .Columns(columns =>
                            {
                                        columns.Bound(c => c.Status).EditorTemplateName("ApprovalEditor").Width(100);
                                        columns.Bound(c => c.Remark).Width(150);
                                        columns.Bound(c => c.CreatedBy).Width(150);
                                        columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                                        columns.Command(command => { command.Edit().Text("Approve"); }).Width(180);
                                    })
                            .ToolBar(commands => commands.Create().Text("Approve Request"))
                            .Events(ev =>
                            {
                                        ev.DataBound("approveonDataBound");
                                    })
                                .Editable(editable =>
                                {
                                            editable.Mode(GridEditMode.InLine);
                                            editable.DisplayDeleteConfirmation("Are You Sure To Approve ?");
                                        })

                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Model(model =>
                                {
                                            model.Id(p => p.InspectionApprovalId);
                                            model.Field(p => p.CreatedBy).Editable(false);
                                            model.Field(p => p.DateCreated).Editable(false);
                                        })
                                .Read(read => read.Action("Approval_Read", "AnnualEquipmentInventoryInspection", new { id = "#=AnnualEquipmentInventoryInspectionID#" }).Data("sendForgery"))
                                .Create(create => create.Action("Approval_Create", "AnnualEquipmentInventoryInspection", new { id = "#=AnnualEquipmentInventoryInspectionID#" }).Data("sendForgery"))
                                .Update(update => update.Action("Approval_Create", "AnnualEquipmentInventoryInspection", new { id = "#=AnnualEquipmentInventoryInspectionID#" }).Data("sendForgery"))

                            ).ToClientTemplate()

                )
            </text>


);
                })
                                                                                                                                                                                                                                                                .ToClientTemplate())
</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
 

<script>

    var masterId;
    var fleetPlate;
    var IsApproved;
    var IsSendForApproval;

    function RejectPopUp(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var dataItem = masterGrid.dataItem(masterRow);
        masterId = dataItem.AnnualEquipmentInventoryInspectionID;
        fleetPlate = dataItem.VoidBy;
        IsApproved = dataItem.IsOnlineApproved;
        IsSendForApproval = dataItem.IsSendForApproval;

        var firstValidationgridName = "#approvalitemgrid_" + masterId;



        if (!IsSendForApproval || IsApproved) {

            $(".k-grid-top", firstValidationgridName).hide();

        }
        
        
        
    }

    
    function onDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsOnlineApproved == true) { $(this).addClass("k-state-FleetApproved"); }
            if (dataItem.IsSendForApproval == true || dataItem.IsOnlineApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();

        grid.tbody.find("tr[role='row']").each(function () {
           
            if (IsApproved == "true" || IsApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }
    function filterCategory() {
        var dropdownlist = $("#EquipmentTypeId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentIdentityId: $("#EquipmentCategoryId").val(),
            search: filterInput.val()
        };

    }
    function filterEquipmentNames() {
        var dropdownlist = $("#EquipmentNameId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentTypeId: $("#EquipmentTypeId").val(),
            search: filterInput.val()
        };
    }
    function filterFleet() {
        return {
            text: $("#FleetsID").data("kendoDropDownList").filterInput.val(),
            equipmentNameId: $("#EquipmentNameId").val()
        };
    }
    function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForOnlineApproval", "AnnualEquipmentInventoryInspection", new { area = "FleetManagement" })',
            data: { id: id },
            success: function (result) {

                alert(result);

                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }

</script>

<style>
    div.k-edit-form-container {
        width: auto;
        height: auto;
    }

    .row .col-sm-2 {
        width: 150px;
    }

    .row {
        margin: auto;
    }
</style>