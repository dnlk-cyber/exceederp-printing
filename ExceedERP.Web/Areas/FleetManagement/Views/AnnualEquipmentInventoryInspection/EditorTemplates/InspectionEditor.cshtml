@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@model  ExceedERP.Core.Domain.FleetManagement.EquipmentInspection.AnnualEquipmentInventoryInspection
<div class="form">
    <div class="row fullrow">
        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.FleetsID, "Equipment", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.FleetsID)
                                  .ValuePrimitive(true)
                                  .OptionLabel("Select Equipment...")
                                  .DataTextField("PlateNumber")
                                  .DataValueField("FleetsID")
                                  .Filter("contains")
                                  .MinLength(2)
                                  .DataSource(dataSource =>
                                  {
                                      dataSource.Read(read => read.Action("FleetsDDBind", "EquipmentRegistration", new { area = "FleetManagement" }))
                                          .ServerFiltering(false);
                                  })
                    )
                    @Html.ValidationMessageFor(model => model.FleetsID, "", new { @class = "text-danger" })


                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.InspectedBy, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.TextBoxFor(model => model.InspectedBy)
                    @Html.ValidationMessageFor(model => model.InspectedBy, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="row"></div>

        </div>

        <div class="col-md-3 ro1">

            <div class="form-group">
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Remark)
                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.FindingsOutcome, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.FindingsOutcome)
                    @Html.ValidationMessageFor(model => model.FindingsOutcome, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>


        </div>

        <div class="col-md-3 ro1">


            <div class="form-group">
                @Html.LabelFor(model => model.DateofInspection, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().DatePickerFor(model => model.DateofInspection)
                    @Html.ValidationMessageFor(model => model.DateofInspection, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.Status, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Status)
                    @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
        </div>
    </div>
</div>
