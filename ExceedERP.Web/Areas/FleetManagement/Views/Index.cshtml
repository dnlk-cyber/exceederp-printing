
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetMaintenance.FailureReason>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Description);
        columns.Bound(c => c.DateCreated);
        columns.Bound(c => c.LastModified);
        columns.Bound(c => c.CreatedBy);
        columns.Bound(c => c.ModifiedBy);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.FailureReasonId))
          .Read(read => read.Action("FailureReasons_Read", "").Data("sendForgery"))
          .Create(create => create.Action("FailureReasons_Create", "").Data("sendForgery"))
          .Update(update => update.Action("FailureReasons_Update", "").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("FailureReasons_Destroy", "").Data("sendForgery"))
      )
)
