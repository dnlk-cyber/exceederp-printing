
<legend>Light-Vehicle Cost Sheet</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.LightVehicleTimeSheet>()
                        .Name("grid")
                        .Columns(columns =>
                        {

                            columns.Bound(c => c.LightVehicleTimeSheetId).Title("S.No").Width(50);
                            columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["fleet"], "FleetsID", "PlateNumber").Title("Equipment Name").Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
                            columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["ProcurementSupplier"], "ProcurementSupplierID", "Name").Title("Supplier Name").Width(100); columns.Bound(c => c.Date).Width(100);
                            columns.Bound(c => c.CostSheetStatus).Width(120);
                            columns.Command(command => { command.Edit().UpdateText("Save").CancelText("Cancel").Text("Edit"); }).Title("Action").Width(160);
                        })

                        .Editable(editable => editable.Mode(GridEditMode.PopUp)
                        .TemplateName("LightVehicleCostSheetTemplate")
                        .Window(win => win.Title("Light Vehicle Cost Sheet").Width(820)))
                        .Pageable()
                        .Filterable()
                        .Events(e => e.DataBound("dataBound"))
                        .Events(e => e.DetailExpand("onDetailExpand"))
                        .Scrollable(s => s.Height(550))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Sort(sort => sort.Add(e => e.LightVehicleTimeSheetId).Descending())
                            .Model(model => model.Id(p => p.LightVehicleTimeSheetId))
                            .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
                            .Read(read => read.Action("LightVehicleCostSheet_Read", "LightVehicleCostSheet"))
                            .Update(update => update.Action("LightVehicleCostSheet_Update", "LightVehicleCostSheet"))

                        ).ClientDetailTemplateId("template")
)


<script id="template" type="text/kendo-tmpl">

    @(Html.Kendo().TabStrip()
                                                   .Name("tabStrip_#=LightVehicleTimeSheetId#")
                                                   .SelectedIndex(0)
                                                   .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                                                   .Items(items =>
                                                   {

                                                       items.Add().Text("Detail").Content(
                                                            @<text>
                                                                <legend>Detail</legend>
                                                                <div class="box">
                                                                    <div class="box-col">

                                                                        # if (CostSheetSendForAproval == false)
                                                                        {#

                                                                        <a onclick='return sendForApproval("#=LightVehicleTimeSheetId#")' href=' \#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                                                        # }#
                                                                    </div>
                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-md-1">
                                                                    </div>
                                                                    <div class="col-md-6" style="margin-top:20px;">
                                                                        <div class="form-group">
                                                                            <label>Status</label>: <span>#=CostSheetStatus#</span>
                                                                        </div>
                                                                        <div class="form-group">
                                                                            <label>Created By</label>: <span>#=TimeSheetApprovedBy#</span>
                                                                        </div>
                                                                        <div class="form-group">
                                                                            <label>Date Created</label>: <span>#=kendo.toString(kendo.parseDate(TimeSheetApprovedDate), 'dd/MM/yyyy') #</span>
                                                                        </div>
                                                                        <div class="form-group">
                                                                            <label>Approved By</label>: <span>#=CostSheetApprovedBy#</span>
                                                                        </div>
                                                                        <div class="form-group">
                                                                            <label>Approved Date</label>: <span>#=kendo.toString(kendo.parseDate(CostSheetApprovedDate), 'dd/MM/yyyy')#</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </text>
                                                                        ); items.Add().Text("Approval").Content(@<text>

                                                                            @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.CostSheetApproval>()
                                                                                                .Name("CostSheetApproval#=LightVehicleTimeSheetId#")
                                                                                                .Columns(columns =>
                                                                                                {
                                                                                                            columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                                                                                                            columns.Bound(o => o.Remark).Width(200);
                                                                                                            columns.Bound(c => c.CreatedBy).Width(150);
                                                                                                            columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                                                                                                            columns.Command(command => { command.Edit(); }).Width(250);

                                                                                                        })
                                                                                                .ToolBar(commands => commands.Create().Text("Approve Request"))
                                                                                                .Events(ev =>
                                                                                                {
                                                                                                            ev.DataBound("approvalDataBound");
                                                                                                        })
                                                                                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                                                    .DataSource(dataSource => dataSource
                                                                                                    .Ajax()
                                                                                                    .PageSize(5)
                                                                                                    .Model(model =>
                                                                                                    {
                                                                                                                model.Id(p => p.CostSheetApprovalId);
                                                                                                                model.Field(p => p.CreatedBy).Editable(false);
                                                                                                                model.Field(p => p.DateCreated).Editable(false);
                                                                                                            })
                                                                                                    .Events(ev => ev
                                                                                                    .Error("error_handler(\"CostSheetApproval#=LightVehicleTimeSheetId#\")")
                                                                                                    .RequestStart("onRequestStart(\"CostSheetApproval#=LightVehicleTimeSheetId#\")")
                                                                                                    .RequestEnd("onRequestEnd(\"CostSheetApproval#=LightVehicleTimeSheetId#\")"))

                                                                                                    .Create(update => update.Action("LightVehicleCostSheetApproval_Create", "LightVehicleCostSheet", new { Id = "#=LightVehicleTimeSheetId#" }))
                                                                                                    .Read(read => read.Action("LightVehicleCostSheetApproval_Read", "LightVehicleCostSheet", new { Id = "#=LightVehicleTimeSheetId#" }))
                                                                                                    .Update(update => update.Action("LightVehicleCostSheetApproval_Create", "LightVehicleCostSheet"))

                                                                                                    )
                                                                                                    .ToClientTemplate())
                                                                        </text>
                                                                                                );
                                                                   }).ToClientTemplate())


</script>













<script type="text/javascript">

    var costSheetApproved;
    var timeSheetSendForAproval;
    var lightVehicleTimeSheetId;

    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = this;

        var masterDataItem = masterGrid.dataItem(masterRow);

        costSheetApproved = masterDataItem.CostSheetApproved;

        timeSheetSendForAproval = masterDataItem.CostSheetSendForAproval;

        lightVehicleTimeSheetId = masterDataItem.LightVehicleTimeSheetId;


        var firstValidationgridName = "#CostSheetApproval" + lightVehicleTimeSheetId;



        if (costSheetApproved == true || timeSheetSendForAproval == false) {

            $(".k-grid-top", firstValidationgridName).hide();

        }
    }

    function dataBound() {


        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.CostSheetApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
            if (dataItem.CostSheetApproved == true || dataItem.CostSheetSendForAproval == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();


            }
        });
    }


    function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("CostSheetSendForApproval", "LightVehicleCostSheet", new { area = "FleetManagement" })',
            data: { lightVehicleTimeSheetId: id },
            success: function (result) {

                alert(result);

                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }

    function approvalDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsApproved == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });

    }

    function handleSupplierChange() {
        var id = $("#FleetsID").data("kendoDropDownList").value();
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetFleetValues", "LightVehicleCostSheet", new { area = "FleetManagement" })',
            dataType: "json",
            data: { fleetId: id },
            success: function (result) {
                console.log(result);
                $('#IdealRentalRate').data("kendoNumericTextBox").value(result.IdealRentalRate);
                $('#IdealRentalRate').data("kendoNumericTextBox").trigger("change");

                $('#RentalRate').data("kendoNumericTextBox").value(result.RentalRate);
                $('#RentalRate').data("kendoNumericTextBox").trigger("change");

                //$('#ProcurementSupplierID').data("kendoDropDownList").value(result.LoadingPortId);
                //$('#ProcurementSupplierID').data("kendoDropDownList").trigger("change");
            },
            error: function (result) {
                console.log(result);
            }

        });
    }
</script>

<script>

    function calculateNetHour() {
        //let mts = kendo.parseDate($("#mts").val(), "HH:mm");
        //let mte = kendo.parseDate($("mte").val(), "HH:mm");
        //var result = new Date(mte.getTime() - mts.getTime());
        //$("#result").val(kendo.toString(result, "HH:mm"));
        //let mts = $("#NightTimeStart").data("kendoTimePicker").value();

        let mts = new Date($("#MorningTimeStart").data("kendoTimePicker").value());
        let mte = new Date($("#MorningTimeEnd").data("kendoTimePicker").value());
        let ats = new Date($("#AfternoonTimeStart").data("kendoTimePicker").value());
        let ate = new Date($("#AfternoonTimeEnd").data("kendoTimePicker").value());
        let nts = new Date($("#NightTimeStart").data("kendoTimePicker").value());
        let nte = new Date($("#NightTimeEnd").data("kendoTimePicker").value());


        let morningTime = mte - mts;
        let afternoonTime = ate - ats;
        let nightTime = nte - nts;
        if (morningTime >= 0 && afternoonTime >= 0 && nightTime)
        {
            let morningTimeInMinut = Math.floor(morningTime / (1000 * 60));
            let afternoonTimeInMinut = Math.floor(afternoonTime / (1000 * 60));
            let nightTimeInMinut = Math.floor(nightTime / (1000 * 60));
            let netHourInMinut = morningTimeInMinut + afternoonTimeInMinut + nightTimeInMinut;
            let netHourInHours = (netHourInMinut / 60);
            $("#NetHour").val(netHourInHours).trigger("change");
        }
        //let netHour = morningTime + afternoonTime + nightTime;

        //alert(netHourInHours)



    }
</script>

