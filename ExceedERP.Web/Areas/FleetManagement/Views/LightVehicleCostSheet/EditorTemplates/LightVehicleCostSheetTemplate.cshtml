@Html.HiddenFor(model => model.LightVehicleTimeSheetId)
@{ 
    bool isMCG = (ViewBag.setting as string) == "MCG";
    bool IsMIDROC = (ViewBag.setting as string) == "MIDROC";
}
@*@{
        bool isECWC = false;
        using (var db = new ExceedDbContext()) // replace with your context type
        {
            var fetchSetting = db.RequestToInspections.FirstOrDefault();
            if (fetchSetting != null && fetchSetting.Remark == "ECWC")
