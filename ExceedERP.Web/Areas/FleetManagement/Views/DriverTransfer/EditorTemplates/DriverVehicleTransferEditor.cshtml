@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@model ExceedERP.Core.Domain.FleetManagement.FleetResource.DriverVehicleTransfer

<script>
    function filterOperator() {
        return {
            FromOperatorId: $("#FromOperatorId").val()
        };
    }
</script>



<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.FleetId)
                                        .DataTextField("PlateNumber")
                                        .DataValueField("FleetsID")

                                        .OptionLabel("Select..")
                                        .Filter(FilterType.Contains)
                                        .DataSource(d => d.Read(r => r.Action("GetFleet", "FleetManagementDataProvider", new { area = "FleetManagement" }))

                                        .ServerFiltering(false)).HtmlAttributes(new { style="width:100%"}))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>From</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.FromOperatorId)
                                 .DataTextField("FullName")
                                 .DataValueField("OperatorID")
                                 //.DataTextField("FullName")
                                 //.DataValueField("Remark")
                                 .OptionLabel(" Select To")
                                 .Filter(FilterType.Contains)
                                 .DataSource(d => d.Read(r => r.Action("OperatorDdBind", "OperatorRegistration", new { area = "FleetManagement" }))
                                 //.DataSource(d => d.Read(r => r.Action("OperatorTransferDDBind", "OperatorRegistration"))
                                 .ServerFiltering(false)).HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>To</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.ToOperatorId)
                               .Name("ToOperatorId")
                                 //.DataTextField("FullName")
                                 //.DataValueField("Remark")
                                 .DataTextField("FullName")
                                 .DataValueField("OperatorID")
                                 .OptionLabel(" Select To")
                                 .Filter(FilterType.Contains)
                                 //.DataSource(d => d.Read(r => r.Action("OperatorTransferDDBind", "OperatorRegistration"))
                                 .DataSource(d => d.Read(r => r.Action("OperatorDdBind", "OperatorRegistration", new { area = "FleetManagement" }))
                                 .ServerFiltering(false)).HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Start Date</label>
            <div>
                @Html.Kendo().DatePickerFor(model => model.StartingDate).HtmlAttributes(new { style = "width:100%" })
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>End Date</label>
            <div>
                @Html.Kendo().DatePickerFor(model => model.ToDate).HtmlAttributes(new { style = "width:100%" })
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Description</label>
            <div>
                @Html.Kendo().TextBoxFor(model => model.Description).HtmlAttributes(new { style = "width:100%" })
            </div>
        </div>
    </div>
   
</div>