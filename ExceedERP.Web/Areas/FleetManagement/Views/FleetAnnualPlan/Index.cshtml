
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Annual Plan</h2>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.EquipmentPlanandEvaluation.FleetAnnualPlan>()
                                    .Name("grid")
                                    .Columns(columns =>
                                    {
                                        columns.Bound(c => c.EquipmentGrade).Width(100);
                                        columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["Category"], "Value", "Text").Width(120);
                                        columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["Type"], "Value", "Text").Width(120);
                                        columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["Name"], "Value", "Text").Width(120);
                                        columns.ForeignKey(c => c.FleetId, (IEnumerable)ViewData["Fleet"], "Value", "Text").Width(120);
                                        columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["GlFiscalYear"], "Value", "Text").Width(120);
                                        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);
                                    })
                                    .ToolBar(commands => { commands.Create();
                                        commands.Custom()
                                              .Text("Generate Next Annual Plan")
                                              .HtmlAttributes(new { id = "btnGenerateAnnualPlan" });
                                    })
                                    .Editable(editable =>
                                    {
                                        editable.Mode(GridEditMode.PopUp).TemplateName("FleetAnnualPlan");
                                        editable.DisplayDeleteConfirmation("Are You Sure To Remove Equipment Name");
                                    })
                                    .Filterable()
                                    .Pageable()
                                    .Events(e => e.DetailExpand("DetailExpand"))
                                    .Scrollable(e => e.Height(550))
                                    .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Events(ev => ev
                                                    .Error("error_handler(\"grid\")")
                                                    .RequestStart("onRequestStart(\"grid\")")
                                                    .RequestEnd("onRequestEnd(\"grid\")"))
                                        .Model(model => model.Id(p => p.FleetAnnualPlanId))
                                        .Read(read => read.Action("FleetAnnualPlan_Read", "FleetAnnualPlan").Data("sendForgery"))
                                        .Create(create => create.Action("FleetAnnualPlan_Create", "FleetAnnualPlan").Data("sendForgery"))
                                        .Update(update => update.Action("FleetAnnualPlan_Update", "FleetAnnualPlan").Data("sendForgery"))
                                        .Destroy(delete => delete.Action("FleetAnnualPlan_Delete", "FleetAnnualPlan").Data("sendForgery"))

                                    ).ClientDetailTemplateId("tabs")
)

<script id="tabs" type="text/x-kendo-template">
    @(Html.Kendo().TabStrip()
                                                                        .Name("tabstrip_grid_#=FleetAnnualPlanId#")
                                                                        .SelectedIndex(0)
                                                                        .Items(itemn =>
                                                                        {
                                                                            itemn.Add().Text("Monthly Plan").Content(@<text>@Detail()</text>);

                                                                                }).ToClientTemplate())
</script>


