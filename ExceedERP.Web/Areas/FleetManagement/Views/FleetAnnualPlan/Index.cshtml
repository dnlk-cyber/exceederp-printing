                                            .Columns(columns =>
                                            {
                                                columns.ForeignKey(c => c.GlPeriodId, (IEnumerable)ViewData["GlPeriod"], "Value", "Text").Width(120);

                                                columns.Bound(c => c.NumberOfEquipmentInMonth).Width(100);
                                                columns.Bound(c => c.WorkingHourPerDay).Width(100);
                                                columns.Bound(c => c.WorkingDaysInMonth).Width(100);
                                                columns.Bound(c => c.WorkingHourPerMonth).Width(100);
                                                columns.Bound(c => c.InefficiencyPercentile).Width(100);
                                                columns.Bound(c => c.EfficiencyPercentile).Width(100);
                                                columns.Bound(c => c.HourForInefficiencyPerMonth).Width(100);
                                                columns.Bound(c => c.ExpectedEffectiveWorkingHrPerMonth).Width(100);
                                                columns.Bound(c => c.ChargingRate).Width(100);
                                                columns.Bound(c => c.ExpectedMonthlyIncome).Width(100);
                                                columns.Bound(c => c.TyreCost).Width(100);
                                                columns.Bound(c => c.LiterPerHour).Width(100);
                                                columns.Bound(c => c.TotalLiter).Width(100);
                                                columns.Bound(c => c.FuelCostPerLiter).Width(100);
                                                columns.Bound(c => c.TotalFuelCost).Width(100);
                                                columns.Bound(c => c.MaintenanceCost).Width(100);
                                                columns.Bound(c => c.Perduim).Width(100);
                                                columns.Bound(c => c.Salary).Width(100);
                                                columns.Bound(c => c.TotalExpectedExpense).Width(100);
                                                columns.Bound(c => c.ExpectedTotalProfit).Width(100);

                                                columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);
                                            })
                                            .ToolBar(commands => commands.Create())
                                            .Editable(editable =>
                                            {
                                                editable.Mode(GridEditMode.PopUp).TemplateName("AnnualPlanDetail");
                                                editable.DisplayDeleteConfirmation("Are You Sure To Remove Equipment Name");
                                            })
                                            .Filterable()
                                            .Scrollable()
                                            .DataSource(dataSource => dataSource
                                                .Ajax()
                                                    .Events(ev => ev
                                                    .Error("error_handler(\"grid_#=FleetAnnualPlanId#\")")
