                                                .Model(model => 
                                                {
                                                    model.Id(p => p.FleetAnnualPlanDetailId);
                                                    //model.Field(p => p.GlPeriodId).Editable(false);
                                                    model.Field(p => p.DateFrom).Editable(false);
                                                    model.Field(p => p.DateTo).Editable(false);
                                                    })
                                                .Read(read => read.Action("FleetAnnualPlanDetail_Read", "FleetAnnualPlanDetail", new { id = "#=FleetAnnualPlanId#" }).Data("sendForgery"))
                                                .Create(create => create.Action("FleetAnnualPlanDetail_Create", "FleetAnnualPlanDetail", new { id = "#=FleetAnnualPlanId#" }).Data("sendForgery"))
                                                .Update(update => update.Action("FleetAnnualPlanDetail_Update", "FleetAnnualPlanDetail").Data("sendForgery"))
                                                .Destroy(delete => delete.Action("FleetAnnualPlanDetail_Delete", "FleetAnnualPlanDetail").Data("sendForgery"))

                                            ).ClientDetailTemplateId("DailyPlan").ToClientTemplate()
    )
}<script id="DailyPlan" type="text/x-kendo-template">
    @(Html.Kendo().TabStrip()
                                                                        .Name("dailytabstrip_grid_#=FleetAnnualPlanDetailId#")
