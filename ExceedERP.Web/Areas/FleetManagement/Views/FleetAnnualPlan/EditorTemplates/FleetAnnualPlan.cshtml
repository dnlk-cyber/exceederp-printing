@model ExceedERP.Core.Domain.FleetManagement.EquipmentPlanandEvaluation.FleetAnnualPlan

<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Category</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentCategoryId)
                                        .DataTextField("Name")
                                        .DataValueField("Id")
                                        .Filter(FilterType.Contains)
                                        .OptionLabel("Select Category")
                                        .HtmlAttributes(new { style = "width:100%" })
                                        .DataSource(d => d.Read(r => r.Action("GetEquipmentIdentities", "FleetManagementDataProvider"))
                                        .ServerFiltering(false)))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Type</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentTypeId)
                    .DataTextField("Name")
                    .DataValueField("Id")
                    .OptionLabel("Select Equipment Type")
                    .Filter(FilterType.Contains)
                    .DataSource(d =>
                    {
                        d.Read(r =>
                        {
                            r.Action("GetEquipmentTypes", "FleetManagementDataProvider")
                            .Data("filterCategory");
                        })
                        .ServerFiltering(true);
                    })
                    .Enable(false)
                    .AutoBind(false)
                    .CascadeFrom("EquipmentCategoryId")
                )
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Name</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentNameId)
                    .AutoBind(false)
                    .Enable(false)
                    .DataTextField("Name")
                    .DataValueField("Id")
                    .Filter(FilterType.Contains)
                    .OptionLabel("Select")
                    .DataSource(d => d.Read(r => r.Action("GetEquipmentNames", "FleetManagementDataProvider")
                    .Data("filterEquipmentNames"))
                    .ServerFiltering(true))
                    .CascadeFrom("EquipmentTypeId"))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Plate/Serial</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.FleetId)
                    .AutoBind(false)
                    .Enable(false)
                    .DataTextField("Text")
                    .DataValueField("Value")
                    .Filter(FilterType.Contains)
                    .OptionLabel("Select")
                    .DataSource(d => d.Read(r => r.Action("GetFleetForPlanAndEvaluation", "FleetManagementDataProvider")
                    .Data("filterFleet"))
                    .ServerFiltering(true))
                    .CascadeFrom("EquipmentNameId"))
            </div>
        </div>
    </div>

</div>
<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Fiscal year</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.GlFiscalYearId)
                                                         .OptionLabel("Select Year")
                                                         .AutoBind(false)
                                                         .DataValueField("GlFiscalYearId")
                                                         .DataTextField("Name")
                                                         .DataSource(dataSource =>
                                                         {
                                                             dataSource.Read(read => read.Action("GetOpenYears", "GlobalDataProvider", new { area = "Common" }))
                                                              .ServerFiltering(false);
                                                         }))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Grade</label>
            <div>
                @(Html.Kendo().DropDownListFor(m => m.EquipmentGrade)
                         .OptionLabel("Task Type...")
                         .DataTextField("Text")
                         .DataValueField("Value")

                         .BindTo(ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.FleetManagement.EquipmentPlanandEvaluation.EquipmentGrade))
                         )
                )
            </div>
        </div>
    </div>
</div>