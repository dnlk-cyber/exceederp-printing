@model ExceedERP.Core.Domain.FleetManagement.EquipmentPlanandEvaluation.FleetAnnualPlanDetail

<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Period</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.GlPeriodId)
                                          .OptionLabel("Select Period")
                                          .AutoBind(true)
                                          .DataValueField("Value")
                                          .DataTextField("Text")
                                          
                                          .DataSource(dataSource =>
                                          {
                                              dataSource.Read(read => read.Action("GetGlPeriodForPlanAndEvaluation", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery").Data("getFiscalYear"))
                                              .ServerFiltering(true);
                                          }).Enable(false)
                )
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>No of equipment in month</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.NumberOfEquipmentInMonth).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Working hour/day</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.WorkingHourPerDay).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>working days in month</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.WorkingDaysInMonth).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>


</div>

<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Inefficiency %</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.InefficiencyPercentile).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            <label>Efficienct %</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.EfficiencyPercentile).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Charging rate</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.ChargingRate).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Tyre cost</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.TyreCost).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
    

</div>

<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Liter/hr</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.LiterPerHour).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            <label>Fuel cost/liter</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.FuelCostPerLiter).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Maintenance Cost</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.MaintenanceCost).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Perduim</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.Perduim).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
   

</div>
<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Salary</label>
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.Salary).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
</div>