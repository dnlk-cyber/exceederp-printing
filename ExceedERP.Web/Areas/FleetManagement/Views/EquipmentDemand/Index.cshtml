<script>



    function dataBound() {
        

        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsOnlineApproved == true)
            {
                $(this).addClass("k-state-FleetApproved");
            }
            if (dataItem.IsOnlineApproved == true || dataItem.IsSendForApproval == true) {
          
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove(); 
                  
                
            }
        });
    }

    var expandedRow;
    var IsApproved;
    var IsSendForApproved;

    function onDetailExpand(e) {
        var masterRow = e.masterRow;
        //var masterGrid = $("#grid").data("kendoGrid");
        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.VehicleDemandId;
        status = masterDataItem.Status;
        IsApproved = masterDataItem.IsOnlineApproved;
        IsSendForApproved = masterDataItem.IsSendForApproval;
        IsOnlineApproved = masterDataItem.IsOnlineApproved;

        var linegridName = "#RequestEquipmentgrid_" + masterId;
        var approvalGridName = "#VehicleDemandApproval" + masterId;
         
        if (IsSendForApproved == true) {

            $(".k-grid-top", linegridName).hide();
            $(".k-grid-edit", linegridName).hide();
            $(".k-grid-delete", linegridName).hide();

        }
        if (IsSendForApproved == false || IsOnlineApproved == true) {
            
            $(".k-grid-top", approvalGridName).hide();
        }
        // Only one open at a time
        if (expandedRow != null && expandedRow[0] != e.masterRow[0]) {
            masterGrid.collapseRow(expandedRow);
        }
        expandedRow = e.masterRow;
       
    }
    function lineonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (IsSendForApproved == true|| IsApproved == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }
    function approveonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });

    }
        function filterEquipmentCategories() {
            var dropdownlist = $("#EquipmentIdentityID").data("kendoDropDownList");
            var filterInput = dropdownlist.filterInput;

            return {
                search: filterInput.val()
            };
        }
        function filterEquipmentNames() {
            var dropdownlist = $("#EquipmentNameID").data("kendoDropDownList");
            var filterInput = dropdownlist.filterInput;

            return {
                equipmentTypeId: $("#EquipmentTypeID").val(),
                search: filterInput.val()
            };
        }
        function filterEquipmentTypes() {
            return {
                equipmentIdentityId: $("#EquipmentIdentityID").val(),
                search: $("#EquipmentTypeID").data("kendoDropDownList").filterInput.val()
            };
        }

    function getEquipmentTypeId() {
        return {
            equipmentTypeId: $("#EquipmentTypeID").val(),
            text: $("#EquipmentNameId").data("kendoDropDownList").filterInput.val()
        };
    }
    


    function handleEmployeeChange() {

        var id = $("#EmployeeId").data("kendoDropDownList").value();

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetBranchAjax", "Branch", new { area = "FleetManagement" })',

            data: { empId: id },
            success: function (result) {

                console.log(result);
                //$('#FromBranchName').data("kendoDropDownList").value(result.BranchId);
                //$('#FromBranchName').data("kendoDropDownList").trigger("change");

                //$('#FromBranchName').data("kendoTextBox").value(result.BranchName);
                //$('#FromBranchName').data("kendoTextBox").trigger("change");
                $('#FromBranchName').val(result.BranchName).trigger("change");
                $('#FromStructureName').val(result.OrgName).trigger("change");
            },
            error: function (result) {
                console.log(result);
            }
        });
    }

    const handleEdit = () => {
        $('#FromBranchName').prop("disabled", true);
        $('#FromStructureName').prop('disabled', true);
    }


     function sendForApproval(id) {
        
        $.ajax({
            type: "POST",
            url: '@Url.Action("VehicleDemandSendForOnlineApproval", "EquipmentDemand", new { area = "FleetManagement" })',
            data: { vehicleDemandId: id },
            success: function (result) {
               
                alert(result);
               
                location.reload(true);
            }, 
            error: function (result) {
                alert(result);
            }
        });
    }

</script>

