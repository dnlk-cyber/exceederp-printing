                                                                                                                                   .Update(update => update.Action("VehicleDemand_Approve", "VehicleDemandApproval"))


                                                      )
                                               .ToClientTemplate())
                </text>
                );
            })
                                                                                                                                                                                                                                    .ToClientTemplate())
</script>

<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());

        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsOnlineApproved == true)
            {
                $(this).addClass("k-state-FleetApproved");
            }
            if (dataItem.IsOnlineApproved == true || dataItem.IsSendForApproval == true) {
          
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove(); 
                  
                
            }
        });
    }


    var IsApproved;
    var IsSendForApproved;

    function onDetailExpand(e) {
        var masterRow = e.masterRow;
        //var masterGrid = $("#grid").data("kendoGrid");
        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.VehicleDemandId;
        status = masterDataItem.Status;
        IsApproved = masterDataItem.IsOnlineApproved;
        IsSendForApproved = masterDataItem.IsSendForApproval;
        var linegridName = "#RequestEquipmentgrid_" + masterId;

         
        if (IsSendForApproved == true) {
             
            $(".k-grid-top", linegridName).hide();
          $(".k-grid-edit", linegridName).hide();
           $(".k-grid-delete", linegridName).hide();
        }
       
    }
    function lineonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (IsSendForApproved == true|| IsApproved == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }
    function approveonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }


</script>

<script type="text/javascript">

