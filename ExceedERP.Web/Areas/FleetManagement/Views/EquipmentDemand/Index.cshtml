@model ExceedERP.Core.Domain.FleetManagement.FleetResource.VehicleDemand
 
<script>

    function filterFixedAssetSubCategory() {
        var dropdownlist = $("#SubEquipmentName").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            Id: $("#EquipmentName").val(),
            Search: filterInput.val()
        };
      
     }
 </script>
<legend> Equipment Demand</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.VehicleDemand>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(e => e.RequestNumber).Width(120);
          columns.Bound(e => e.FromBranchName).Title("Location / Project").Width(140);
          columns.Bound(e => e.FromStructureName).Width(140);
           columns.Bound(e => e.Status).Width(100);



          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);


      })
          .ToolBar(commands =>
                  {
                      commands.Create(); commands.Excel();
                      commands.Pdf();
                  }).Editable(editable =>
          {
              editable.Mode(GridEditMode.PopUp).TemplateName("VehicleDemandEditor");
              editable.DisplayDeleteConfirmation("Are You Sure To Remove Equipment Demand");
          })
              .Events(ev =>
                        {
                            ev.DataBound("dataBound");
                        })
          .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Groupable()
                            .Scrollable(h => h.Height(500))
                                  .Groupable().Events(ev => ev.DetailExpand("onDetailExpand"))
      .ClientDetailTemplateId("template")
      .HtmlAttributes(new { style = "height:520px;" })
      .DataSource(dataSource => dataSource
          .Ajax().Sort(x=>x.Add(y=>y.DateCreated).Descending())
          .ServerOperation(false)
           .Model(model =>
              {
                  model.Id(p => p.VehicleDemandId);

              })
                       .Events(ev => ev
                                        .Error("error_handler(\"grid\")")
                                        .RequestStart("onRequestStart(\"grid\")")
                                        .RequestEnd("onRequestEnd(\"grid\")"))
          .Create(update => update.Action("VehicleDemand_Create", "EquipmentDemand"))
          .Read(read => read.Action("VehicleDemand_Read", "EquipmentDemand"))
          .Update(update => update.Action("VehicleDemand_Update", "EquipmentDemand"))
          .Destroy(update => update.Action("VehicleDemand_Destroy", "EquipmentDemand"))
      )
      .Events(events => events.DataBound("dataBound")))


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                    .Name("tabStrip_#=VehicleDemandId#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {

                items.Add().Text("Detail").Content(
