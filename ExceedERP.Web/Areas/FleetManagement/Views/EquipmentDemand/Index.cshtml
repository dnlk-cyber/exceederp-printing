@model ExceedERP.Core.Domain.FleetManagement.FleetResource.VehicleDemand
 
<script>
    function filterFixedAssetSubCategory() {
        var dropdownlist = $("#SubEquipmentName").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            Id: $("#EquipmentName").val(),
            Search: filterInput.val()
        };      
     }
 </script>
<legend> Equipment Demand</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.VehicleDemand>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(e => e.RequestNumber).Width(120);
          columns.ForeignKey(e => e.EmployeeId, (System.Collections.IEnumerable)ViewData["Employee"], "Id", "Name").EditorTemplateName("EmployeeDemandEditor").Width(130).Filterable(true);
          columns.Bound(e => e.FromBranchName).Width(150)/*.EditorTemplateName("FromBranchEditor")*/;
          columns.Bound(e => e.FromStructureName).Width(120)/*.EditorTemplateName("FromStructureEditor")*/;
          columns.Bound(e => e.ReasonForTravel).Width(120);
          columns.Bound(e => e.RequestDate).Width(100);
          columns.Bound(e => e.IsAssigned).Width(100);
          columns.Bound(e => e.Status).Width(100);
          columns.Bound(e => e.Num).Visible(false);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(200);
      })
          .ToolBar(commands =>
          {
              commands.Create();
          }).Editable(editable =>
          {
              editable.Mode(GridEditMode.InLine);//.TemplateName("VehicleDemandEditor");
              editable.DisplayDeleteConfirmation("Are You Sure To Remove Equipment Demand");
          })
              .Events(ev =>
              {
                  ev.DataBound("dataBound");
                  ev.Edit("handleEdit");
              })
          .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
                            .Scrollable()
                            //.Sortable()
                            .Filterable()
                            //  .Groupable()
                            .Scrollable(h => h.Height(500))
                            .Events(ev => ev.DetailExpand("onDetailExpand"))
      .ClientDetailTemplateId("template")
      .HtmlAttributes(new { style = "height:520px;" })
      .DataSource(dataSource => dataSource
          .Ajax()
          .ServerOperation(false)
           .Model(model =>
           {
               model.Id(p => p.VehicleDemandId);
               model.Field(p=>p.RequestNumber).Editable(false);
               model.Field(p => p.Status).Editable(false);
               model.Field(p => p.IsAssigned).Editable(false);
               model.Field(p => p.OrgStructureId).Editable(false);
               model.Field(p => p.BranchId).Editable(false);
               model.Field(p => p.BusinessUnitId).Editable(false);
               
           })
               .Events(ev => ev
               .Error("error_handler(\"grid\")")
               .RequestStart("onRequestStart(\"grid\")")
               .RequestEnd("onRequestEnd(\"grid\")"))
          .Create(update => update.Action("VehicleDemand_Create", "EquipmentDemand"))
          .Read(read => read.Action("VehicleDemand_Read", "EquipmentDemand"))
          .Update(update => update.Action("VehicleDemand_Update", "EquipmentDemand"))
          .Destroy(update => update.Action("VehicleDemand_Destroy", "EquipmentDemand"))
      )
      .Events(events => events.DataBound("dataBound")))
