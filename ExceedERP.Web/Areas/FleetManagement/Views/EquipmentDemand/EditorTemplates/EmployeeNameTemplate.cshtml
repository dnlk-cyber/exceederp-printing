
@(Html.Kendo().DropDownListFor(model => model)
        .ValuePrimitive(true)
        .DataTextField("Name")
        .DataValueField("Id")
        .OptionLabel("Select").
        Filter(FilterType.Contains)
        .DataSource(d => d.Read(r => r.Action("GetEquipmentIdentities", "FleetManagementDataProvider")
        .Data("filterEquipmentCategories"))
        .ServerFiltering(true)))