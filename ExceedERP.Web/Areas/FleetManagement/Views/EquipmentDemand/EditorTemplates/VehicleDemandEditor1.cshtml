@model ExceedERP.Core.Domain.FleetManagement.FleetResource.VehicleDemand


<div class="demo-section k-content">
 
                    <div class="row">
                        <div class="col-md-1">
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <div class="k-label">
                                    @(Html.LabelFor(m => m.FromBranchName))
                                    @(Html.Kendo().DropDownListFor(model => model.FromBranchName).Name("FromBranchName")
        .DataTextField("Name")
                                .DataValueField("Name").OptionLabel(" Select ")
                    .DataSource(d => d.Read(r => r.Action("BranchDDBind", "Branch"))))
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <div class="k-label">
                                    @(Html.LabelFor(m => m.FromStructureName))
                                    @(Html.Kendo().DropDownListFor(model => model.FromStructureName).Name("FromStructureName")
                                           .DataTextField("Name")
                                        .DataValueField("Name").OptionLabel(" Select ")
                                    .DataSource(d => d.Read(r => r.Action("StructureDDBind", "Structure"))))
                                </div>
                            </div>
                        </div>


                    </div>
  
   
    
</div>
