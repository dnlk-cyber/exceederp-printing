                    .ValuePrimitive(true)
                    .OptionLabel("Select Supplier...")
                    .DataTextField("Name")
                    .DataValueField("Id")
                    .Filter("contains")
                    .DataSource(dataSource =>
                    {
                        dataSource.Read(read => read.Action("GetSuppliers", "FleetManagementDataProvider", new { area = "FleetManagement" }))
                        .ServerFiltering(false);
                    }).HtmlAttributes(new { style = "width:100%" })
                )

            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.TripStartDate, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().DatePickerFor(model => model.TripStartDate).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>

    </div>

    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.TripStartPlace, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().TextBoxFor(model => model.TripStartPlace).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>


</div>
