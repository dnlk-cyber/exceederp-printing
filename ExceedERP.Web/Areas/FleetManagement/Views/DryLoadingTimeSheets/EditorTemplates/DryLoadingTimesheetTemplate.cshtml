@using System.Collections
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@model  ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.DryLoadingTimeSheet
@using ExceedERP.Helpers.Common
@using ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet
@Html.HiddenFor(model => model.DryLoadingTimeSheetId)

<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Category</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentCategoryId)
                                                        .DataTextField("Name")
                                                        .DataValueField("Id")
                                                        .ValuePrimitive(true)
                                                        .Filter(FilterType.Contains)
                                                        .OptionLabel("Select Category")
                                                        .HtmlAttributes(new { style = "width:100%" })
                                                        .DataSource(d => d.Read(r => r.Action("GetEquipmentIdentitiesNullable", "FleetManagementDataProvider"))
                                                        .ServerFiltering(false)))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Type</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentTypeId)
                                    .DataTextField("Name")
                                    .DataValueField("Id")
                                     .ValuePrimitive(true)
                                    .OptionLabel("Select Equipment Type")
                                    .Filter(FilterType.Contains)
                                    .DataSource(d =>
                                    {
                                        d.Read(r =>
                                        {
                                            r.Action("GetEquipmentTypesTimeSheet", "FleetManagementDataProvider")
                                            .Data("filterEquipmentType");
                                        })
                                        .ServerFiltering(true);
                                    })
                                    .Enable(false)
                                    .AutoBind(true)
                                    .CascadeFrom("EquipmentCategoryId")
                )
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <label>Equipment Name</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentNameId)
                                    .AutoBind(true)
                                    .Enable(false)
                                     .ValuePrimitive(true)
                                    .DataTextField("Name")
                                    .DataValueField("Id")
                                    .Filter(FilterType.Contains)
                                    .OptionLabel("Select")
                                    .DataSource(d => d.Read(r => r.Action("GetEquipmentNamesNullable", "FleetManagementDataProvider")
                                    .Data("filterEquipmentNames"))
                                    .ServerFiltering(true))
                                    .CascadeFrom("EquipmentTypeId"))
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.FleetsID, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @(Html.Kendo().DropDownListFor(model => model.FleetsID)
                    .ValuePrimitive(true)
                    .OptionLabel("Select Equipment...")
                    .DataTextField("PlateNumber")
                    .DataValueField("FleetsID")
                    .Filter("contains")
                    .MinLength(2)
                    .DataSource(dataSource =>
                    {
                        dataSource.Read(read => read.Action("GetFleetTimesheet", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("fetchTimesheetEquipmentType"))
                            .ServerFiltering(true);
                    }).HtmlAttributes(new { style = "width:100%" })
                )

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
