@using System.Collections
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@model  ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.DryLoadingTimeSheet
@using ExceedERP.Helpers.Common
@using ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet
@Html.HiddenFor(model => model.DryLoadingTimeSheetId)

@{ 
    bool IsMCG = (ViewBag.setting as string) == "MCG";
    bool IsMIDROC = (ViewBag.setting as string) == "MIDROC";
}
<div class="row">
    
    <div class="col-sm-2">
        <div class="form-group">
            <label>Plate No</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.FleetsID)
                  .ValuePrimitive(true)
                  .OptionLabel("Select Equipment...")
                  .DataTextField("PlateNumber")
                  .DataValueField("FleetsID")
                  .Filter("contains")
                  .MinLength(2)
                  //.CascadeFrom("EquipmentNameId")
                  .Events(ev => ev.Change("onFleetChange"))
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetFleetIdTimesheetNew", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery")
                      .Data("handleFleetId"))
                          .ServerFiltering(true);
                  }).HtmlAttributes(new { style = "width:100%" })
                )

            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.Downhour, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.Downhour).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
        @if (IsMCG == false)
        {
            <div class="form-group">
                @Html.LabelFor(model => model.DownReason, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
                <div>
                    @Html.Kendo().TextBoxFor(model => model.DownReason).HtmlAttributes(new { style = "width:100%" })

                </div>
            </div>
        }
        @if (IsMCG == true)
        {
            <div class="form-group">
                Reason For Down
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.ReasonForDown)
                             .DataValueField("Value")
                             .DataTextField("Text")
                             .Filter("Contains")
                             .OptionLabel("Select Reason")
                             .BindTo(ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.DownReasonList)))
                    .ValuePrimitive(true)
                    )

                </div>
            </div>
        }
    </div>
