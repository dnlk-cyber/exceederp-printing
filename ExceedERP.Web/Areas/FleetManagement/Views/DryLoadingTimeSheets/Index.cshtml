                                                                 .DataTextField("Text")
                                                                    .DataValueField("Value")
                                                                    .BindTo((IEnumerable<SelectListItem>)ViewData["branchh"])
                                                                    .OptionLabel("Select Branch")
                                                                    .HtmlAttributes(new { style = "width:200px;margin-right:10px;" })
