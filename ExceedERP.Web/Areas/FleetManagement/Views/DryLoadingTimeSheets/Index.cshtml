<script>

    var timeSheetApproved;
    var timeSheetSendForAproval;
    var dryLoadingTimeSheetId;

    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = this;

        var masterDataItem = masterGrid.dataItem(masterRow);

        timeSheetApproved = masterDataItem.TimeSheetApproved;

        timeSheetSendForAproval = masterDataItem.TimeSheetSendForAproval;

        dryLoadingTimeSheetId = masterDataItem.DryLoadingTimeSheetId;


        var firstValidationgridName = "#TimeSheetApproval" + dryLoadingTimeSheetId;



        if (timeSheetApproved == true || timeSheetSendForAproval == false) {

            $(".k-grid-top", firstValidationgridName).hide();

        }
    }

    function dataBound() {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.TimeSheetApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
            if (dataItem.TimeSheetSendForAproval == true && dataItem.TimeSheetApproved==false) {
                $(this).addClass("k-state-FleetSendForApproval");
            }
            if (dataItem.TimeSheetApproved == true || dataItem.TimeSheetSendForAproval == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();


            }
        });
    }

