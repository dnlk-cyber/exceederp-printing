                                    Request Approval
                                </button>
                                <button type="button"
                                        class="k-button k-primary"
                                        onclick="ApproveSelected()">
                                    Approve Selected
                                </button>
                               <button type="button"
                                        class="k-button k-primary"
                                        onclick="RejectApproved()">
                                    Reject Approved
                                </button>
                                        }
                            /**/
                            /**/
                            /**/

                        </text>);
