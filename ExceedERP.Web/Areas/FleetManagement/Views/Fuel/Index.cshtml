@model ExceedERP.Core.Domain.FleetManagement.FuelManagement.Fuel
@{
    ViewBag.Title = "Fuel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    function PrintFuelIssue() {
        var AssetCodeObj = $("#AssetCode");
        var AssetCode = AssetCodeObj.val();

        var DateFromObj = $("#From");
        var DateFrom = DateFromObj.val();

        var DateToObj = $("#To");
        var DateTo = DateToObj.val();

        window.location = '@Url.Action("FuelPrint", "FleetPrint")?from=' + DateFrom + '&&to=' + DateTo + '&&plateno=' + AssetCode;
    }

    function filterFuelIssue() {

        var gridfilter = [];
         var AssetCodeObj = $("#AssetCode");
         var AssetCode = AssetCodeObj.val();

         var DateFromObj = $("#From");
         var DateFrom = DateFromObj.val();

         var DateToObj = $("#To");
         var DateTo = DateToObj.val();

        var grid = $('#grid').data('kendoGrid');

      
        gridfilter.push({ field: "PlateNo", operator: "contains", value: AssetCode } );
        gridfilter.push(   { field: "To", operator: "lte", value: DateTo });
        gridfilter.push({ field: "From", operator: "gte", value: DateFrom });
        grid.dataSource.filter({ logic: "or", filters: gridfilter });
    }
  
</script>
<legend>Fuel</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FuelManagement.Fuel>()
        .Name("grid")
        .Columns(columns =>
        {
            columns.Bound(e => e.Description).Title("Referance").Width(100);
            columns.Bound(e => e.Remark).Title("Plate No").Width(100);
            columns.Bound(e => e.EquipmentName).Width(100);
            columns.Bound(e => e.AssetNo).Width(100);

            columns.Bound(e => e.ReceiptNo).Title("Store Code").Width(100);
            columns.Bound(e => e.FinalKmHr).Title(" Odometer (KM/HR)").Width(80);//.ClientFooterTemplate("Total Count: #=sum#").ClientGroupHeaderColumnTemplate("Sum : #=sum#") ;
            columns.Bound(e => e.FuelType).Width(120);
            columns.Bound(e => e.FuelFilledAmount).Title("Qty").Width(80).ClientFooterTemplate("Total Qty: #=sum#").ClientGroupHeaderColumnTemplate("Total Qty : #=sum#");
            columns.Bound(e => e.TotalFuelcost).Width(100).ClientFooterTemplate("Total Cost: #=sum#").ClientGroupHeaderColumnTemplate("Total Cost : #=sum#");
            columns.Bound(e => e.RequestedQty).Width(100).ClientFooterTemplate("Requested Qty: #=sum#").ClientGroupHeaderColumnTemplate("Requested Qty : #=sum#");
           
            columns.Bound(e => e.DateCreated).Title("Issue Date").Format("{0:yyyy-MM-dd}").Width(120);

        })
               .ToolBar(toolbar =>
               {

               toolbar.Template(@<text>
                <div class="row pull-right">
                    <a href='#' onclick="return PrintFuelIssue();" title="Print"><i class="fa fa-print fa-2x"></i></a>
                </div>
                <div class="toolbar row">

       
                <div class="col-md-3">
                    <label>Date From:</label>
                    @(Html.Kendo().DatePicker().Name("From").Value(DateTime.Now.Date))
                </div>  
                <div class="col-md-3" style="margin-left:5px">
                    <label>Date To:</label>
                    @(Html.Kendo().DatePicker().Name("To").Value(DateTime.Now.Date))
                </div>   
                <div class="col-md-3" style="margin-left:5px">
                    <label>Plate No:</label>
                    @(Html.Kendo().TextBox().Name("AssetCode").HtmlAttributes(new { placeholder = " Plate Number", @class = "k-primary" }))

                </div>

                <div class="col-md-1">

                    @(Html.Kendo().Button()
                        .Name("btnSearch")
                        .HtmlAttributes(new { type = "search", @class = "k-button k-button-icontext k-primary" })
                        .Events(e => e.Click("filterFuelIssue"))
                        .Content("Search"))
                </div>
       
                </div>


            </text>);
               })
               .HtmlAttributes(new { style = "height: 520px;" })
                    .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            //.Groupable()
                            .Scrollable(h => h.Height(500))

              .DataSource(dataSource => dataSource
                  .Ajax().Aggregates(aggregates =>
                  {
                      aggregates.Add(p => p.TotalFuelcost).Sum();
                
                      aggregates.Add(p => p.FuelFilledAmount).Sum();
                     
                  })
                  .ServerOperation(true)
                  .Model(model =>
                  {
                      model.Id(p => p.FuelID);

                  }).Events(ev => ev
                                .Error("error_handler(\"grid\")")
                                .RequestStart("onRequestStart(\"grid\")")
                                .RequestEnd("onRequestEnd(\"grid\")"))

                          .Read(read => read.Action("Fuel_Read", "Fuel").Data("sendForgery"))

            )
)

