@using ExceedERP.Core.Domain.FleetManagement.FleetMaintenance
@using ExceedERP.Web.Areas.FleetManagement.Models
 

<script>
    function filterMaintenanceCenter() {
        return {
            Type: $("#Type").val()
        };
    }
    function filterCause() {
        return {
            Id: Referance
        };
    }
    function filterSerivce() {
        return {
            IsPm: IsPm
        };
    }
</script>


<legend>Job Orders</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetMaintenance.JobOrder>()
        .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.Num).Width(80);
        columns.Bound(e => e.IsPM).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsPM #' " + " # if (IsPM) { #" + "checked='checked'" + "# } #" + " />").Title("Is PM").Width(100);
      
        columns.Bound(e => e.EquipmentName).Width(120);
        columns.Bound(e => e.ProjectName).Title("Location").Width(100);
        columns.Bound(e => e.Type).Width(100);
        columns.Bound(e => e.MaintenanceCenter).Width(140);
        columns.Bound(e => e.Status).Width(100);

        columns.Bound(e => e.Referance).Width(100);



        columns.Command(command => { command.Destroy().Text(" Close "); }).Width(250);


    })

       .Editable(editable =>
        {
            editable.Mode(GridEditMode.PopUp).TemplateName("JobOrderEditor").Window(x => x.Title("Job Order "));
            editable.Window(w => w.Title(" Job Order"));
            editable.DisplayDeleteConfirmation("Are You Sure To Close Job Order");
        })
             .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                                 .Scrollable(h => h.Height(500))
        .ClientDetailTemplateId("template")
   .Events(ev => ev.DetailExpand("onDetailExpandUser"))
              .DataSource(dataSource => dataSource
            .Ajax()
                   .Sort(x => x.Add(s => s.Num).Descending())
            .PageSize(6)
            .Model(model =>
                {
                    model.Id(p => p.JobOrderID);
                    model.Field(p => p.JobOrderID).Editable(false);
                }
                ).Events(ev => ev
                                        .Error("error_handler(\"grid\")")
                                        .RequestStart("onRequestStart(\"grid\")")
                                        .RequestEnd("onRequestEnd(\"grid\")"))
                    .Create(update => update.Action("JobOrder_Create", "JobOrder").Data("sendForgery"))
                            .Read(read => read.Action("JobOrder_Read", "JobOrder").Data("sendForgery"))
                    .Update(update => update.Action("JobOrder_Update", "JobOrder").Data("sendForgery"))
                    .Destroy(update => update.Action("JobOrder_Destroy", "JobOrder").Data("sendForgery"))

        )
   .Events(events => events.DataBound("dataBound"))
)

