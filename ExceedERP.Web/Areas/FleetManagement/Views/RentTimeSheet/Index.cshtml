@model ExceedERP.Core.Domain.FleetManagement.FleetRegistration.TimeSheet
@{
    ViewBag.Title = "Time Sheet";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script> 
 function onUploadError(e) {

        var response = jQuery.parseJSON(e.XMLHttpRequest.responseText);
        alert(response.data);
    }

 function onUploadSuccess(e) {
     $("#grid").data("kendoGrid").dataSource.read();
     $("#grid").data("kendoGrid").refresh();


 }

 function checkFileType(e) {
     var files = e.files;

     $.each(files, function () {

         if (this.extension.toLowerCase() === ".xls" || this.extension.toLowerCase() === ".xlsx" || this.extension.toLowerCase() === ".xlsm") {

         } else {
             alert("Only .xls, .xlsx, .xlsm files can be uploaded!");
             e.preventDefault();
         }

     });
 }


</script>
<legend> Rent Time Sheet</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.TimeSheet>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.CustomerName).Width(140);
        columns.Bound(e => e.PlateSerialNo).Width(100);
        columns.Bound(e => e.EquipmentName).Width(120); 
        columns.Bound(e => e.KMHrReading).Width(140);
        columns.Bound(e => e.TypeofWork).Width(140);
        columns.Bound(e => e.IdleTime).Width(80);
        columns.Bound(e => e.DownTime).Width(100);
        columns.Bound(e => e.Status).Width(100);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(200);
    }).Events(ev =>
                        {
                            ev.DataBound("onDataBound");
                        })
          .ToolBar(toolbar =>
      {
          toolbar.Template(@<text>
                <div class="toolbar row ">
                    <div class="col-sm-3">
                    <a class="k-button k-button-icontext k-grid-add k-primary" href='#'>Add New Record</a>
                    </div>
                </div>
               
        </text>);})
    .Editable(editable =>
        {
            editable.Window(w => w.Title("TimeSheet"));
            editable.Mode(GridEditMode.PopUp).TemplateName("TimeSheetEditor");
            editable.DisplayDeleteConfirmation("Are You Sure To Remove Time Sheet");
        })
            .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
                                .Scrollable()
                                .Sortable()
                                .Filterable()
                             //   .Groupable()
                                .Scrollable(h => h.Height(500))
                                           .ClientDetailTemplateId("template")
                                     .Events(ev => { ev.DetailExpand("onDetailExpandUser"); })
        .DataSource(dataSource => dataSource
            .Ajax()
                 .PageSize(6)
                 .Model(model => model.Id(p => p.TimeSheetID)).Events(ev => ev
                                                            .Error("error_handler(\"grid\")")
                                                            .RequestStart("onRequestStart(\"grid\")")
                                                            .RequestEnd("onRequestEnd(\"grid\")"))
                            .Read(read => read.Action("TimeSheet_Read", "RentTimeSheet").Data("sendForgery"))
                                .Create(create => create.Action("TimeSheet_Create", "RentTimeSheet").Data("sendForgery"))
                                .Update(update => update.Action("TimeSheet_Update", "RentTimeSheet").Data("sendForgery"))
                                      .Destroy(update => update.Action("TimeSheet_Destroy", "RentTimeSheet").Data("sendForgery"))
        )
)   
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                            .Name("tabStrip_#=TimeSheetID#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
                items.Add().Text("Detail").Content(
                    @<text>
                        <div>
                            <div class="box">

                                <div class="box-col">

                                    # if (IsSendForApproval == false || IsSendForApproval == "false")
                                    {#

                                    <a href='@Url.Action("TimeSheet_SendForOnlineApproval", "TimeSheetApproval")/?EId=#=TimeSheetID#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                    # }#
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-1">
                                </div>
                                <div class="col-md-6" style="margin-top:20px;">

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CreatedBy):<span>#=CreatedBy#</span>

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.DateCreated):<span>#=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #</span>

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ModifiedBy):<span>#=ModifiedBy#</span>

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.LastModified):<span>#=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy')#</span>

                                    </div>



                                </div>
                            </div>

                        </div>

                    </text>


            );
                items.Add().Text(" Approval").Content(@<text>

                @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.EquipmentPlanandEvaluation.EquipmentPlanEvaluationApproval>()
                                                                                        .Name("Approval#=TimeSheetID#")
                        .Columns(columns =>
                        {
                            columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                            columns.Bound(o => o.Remark).Width(200);
                            columns.Bound(c => c.CreatedBy).Width(150);
                            columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                            columns.Command(command => { command.Edit(); }).Width(250);

                        }).Events(ev =>
                        {
                            ev.DataBound("approveonDataBound");
                        })
                             .Editable(editable => editable.Mode(GridEditMode.InLine))
                                       .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(5)
                                                            .Model(model =>
                                      {
                                          model.Id(p => p.EquipmentPlanEvaluationApprovalId);
                                          model.Field(p => p.CreatedBy).Editable(false);
                                          model.Field(p => p.DateCreated).Editable(false);
                                      })

                                                                                .Events(ev => ev
                                                    .Error("error_handler(\"Approval#=TimeSheetID#\")")
                                                    .RequestStart("onRequestStart(\"Approval#=TimeSheetID#\")")
                                                    .RequestEnd("onRequestEnd(\"Approval#=TimeSheetID#\")"))
                                                                                                                                   .Create(update => update.Action("TimeSheet_Approve", "TimeSheetApproval", new { EId = "#=TimeSheetID#" }).Data("sendForgery"))
                                                                                                                     .Read(read => read.Action("TimeSheetApproval_Read", "TimeSheetApproval", new { EId = "#=TimeSheetID#" }).Data("sendForgery"))
                                                                                                   .Update(update => update.Action("TimeSheet_Approve", "TimeSheetApproval", new { EId = "#=TimeSheetID#" }).Data("sendForgery"))


                                                      )
                                               .ToClientTemplate())
                </text>
                );
            })
                                                                                                                                                                                                                                                                                                                        .ToClientTemplate())
</script>



<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
<script type="text/javascript">
    function BindFleetDetail() {

        var Fleetsobj = $("#FleetsID").data("kendoDropDownList");
        var fleetID = Fleetsobj.value();
        $.ajax({
            url: '@Url.Action("FleetsDetailDDBind", "EquipmentRegistration")',
            data: { FleetsID: fleetID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r != 0) {
                    var s = r.split(/_/);
                    $("#CustomerName").val(s[4]);
                    $("#RentalRate").val(s[2]);
                    $("#IdealRentalRate").val(s[6]);
                } else {
                    $("#CustomerName").val("UnAssigned");
                    $("#RentalRate").val(" 0 ");
                    $("#IdealRentalRate").val(" 0 ");
                }
            }

        });

    }
    var IsApproved;
    var IsSendForApproved;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        IsApproved = masterDataItem.IsOnlineApproved;
        IsSendForApproved = masterDataItem.IsSendForApproval;
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsOnlineApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
            if (dataItem.IsSendForApproval == true || dataItem.IsSendForApproval == "true") {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

</script>


<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>                            

<script type="text/javascript">
  
   
    function BindFuelDetail() {

        var Fleetsobj = $("#FleetsID").data("kendoDropDownList");
        var fleetID = Fleetsobj.value();

        $.ajax({
            url: '@Url.Action("FleetsDetailDDBind", "EquipmentRegistration")',
            data: { FleetsID: fleetID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r != 0) {
                    var s = r.split(/_/);
                    $("#RentalRate").val(s[2]);
                    $("#IdealRentalRate").val(s[6]);
           
                } else {
                    $("#RentalRate").val('0.0');
                    $("#IdealRentalRate").val('0.0');
                }
            }

        });
    }

</script>
