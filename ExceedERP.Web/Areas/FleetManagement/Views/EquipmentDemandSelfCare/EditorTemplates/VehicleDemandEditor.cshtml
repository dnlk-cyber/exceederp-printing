@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@model ExceedERP.Core.Domain.FleetManagement.FleetResource.VehicleDemand

<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.FromBranchName, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.FromBranchName).Name("FromBranchName")
                        .DataTextField("Name")
                        .DataValueField("Name").OptionLabel(" Select ")
                        .DataSource(d => d.Read(r => r.Action("BranchDDBind", "Branch").Data("sendForgery"))))
                    @Html.ValidationMessageFor(model => model.FromBranchName, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="row"></div>

        </div>

        <div class="col-md-3 ro1">




            <div class="form-group">
                @Html.LabelFor(model => model.FromStructureName, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.FromStructureName).Name("FromStructureName")
                            .DataTextField("Name")
                            .DataValueField("Name").OptionLabel(" Select ")
                            .DataSource(d => d.Read(r => r.Action("StructureDDBind", "Structure").Data("sendForgery"))))
                    @Html.ValidationMessageFor(model => model.FromStructureName, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

        </div>


    </div>
</div>
