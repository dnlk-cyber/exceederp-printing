<legend>Work Shop </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetMaintenance.JobOrder>()
        .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.Num).Width(80);
        columns.Bound(e => e.EquipmentName).Width(160);
        columns.Bound(e => e.ProjectName).Title("Location").Width(140);
        columns.Bound(e => e.MaintenanceCenter).Width(200);
        columns.Bound(e => e.Status).Width(200); ;



    })


       .Editable(editable =>
        {
            editable.Mode(GridEditMode.PopUp).TemplateName("JobOrderEditor");
            editable.DisplayDeleteConfirmation("Are You Sure To Send For Approval");
        })
             .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()

                                .Scrollable(h => h.Height(500))
        .ClientDetailTemplateId("template")
           .Events(ev => ev.DetailExpand("MasterOnExpand"))
              .DataSource(dataSource => dataSource
            .Ajax()
           .Sort(x => x.Add(s => s.Num).Descending())
            .PageSize(6)
            .Model(model =>
                {
                    model.Id(p => p.JobOrderID);
                    model.Field(p => p.JobOrderID).Editable(false);
                }
                ).Events(ev => ev
                                                            .Error("error_handler(\"grid\")")
                                                            .RequestStart("onRequestStart(\"grid\")")
                                                            .RequestEnd("onRequestEnd(\"grid\")"))
                    .Create(update => update.Action("JobOrder_Create", "JobOrder").Data("sendForgery"))
                                .Read(read => read.Action("ServiceCenter_Read", "ServiceCenter").Data("sendForgery"))
                        .Update(update => update.Action("JobOrder_Update", "ServiceCenter").Data("sendForgery"))
                                .Destroy(update => update.Action("JobOrder_Refer", "ServiceCenter").Data("sendForgery"))

        )
   .Events(events => events.DataBound("dataBound"))
)

