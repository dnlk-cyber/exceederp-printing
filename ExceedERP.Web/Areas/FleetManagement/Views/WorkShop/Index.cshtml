                                                                     .DataSource(dataSource => dataSource
                                                              .Ajax()//.Filter(x=>x.Add(y=>y.IsActive == true))
                                                   // .Group(groups => groups.Add(p => p.IsActive))
                                                    .PageSize(20)
                                              .Model(model =>
                                                          {
