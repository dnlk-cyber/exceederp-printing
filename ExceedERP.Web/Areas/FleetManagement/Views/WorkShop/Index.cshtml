<script>

    var masterId;
    var fleetPlate;
    var IsApproved;
    var IsSecondSendForApproval;
    var IsOnlineTransfered;
    function OnExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var dataItem = masterGrid.dataItem(masterRow);
        masterId = dataItem.JobOrderID;
        fleetPlate = dataItem.VoidBy;
        IsApproved = dataItem.IsSecondOnlineApproved;
        IsSecondSendForApproval = dataItem.IsSecondSendForApproval;
        IsOnlineTransfered = dataItem.IsOnlineTransferred;

        var category = "";
        var lineitem = "";
        var index = 0;

        $.ajax({
            url: '@Url.Action("MaintenaceCheckList_Read", "CheckListLog")',

            data: {},
            type: 'POST',
            cache: false,
            success: function (list) {
                for (var i = 0 ; i < list.length; i++) {

                    lineitem += "    <div class='col-sm-5'>";
                    if (category != list[i].CategoryName) {

                        lineitem += "       <div class='col-sm-5'><h2 style='background-color:greenyellow'>" + list[i].CategoryName + " </h2></div><hr/>";
                        category = list[i].CategoryName;
                    }
                    lineitem += "       <h2>" + list[i].CategoryName + " </h2> ";
                    var CategoryName = list[i].CategoryName.replace(/\s+/g, '_');
                    lineitem += "<div class='col-sm-4'  >  <input type='hidden' name=model.CheckListViewModel[" + index + "].InspectionId  value=" + masterId + ">   <input type='hidden' name=model.CheckListViewModel[" + index + "].LineName  value=" + list[i].LineName + " >     <input type='hidden' name=model.CheckListViewModel[" + index + "].LineCode  value=" + list[i].LineCode + " >    <input type='hidden' name=model.CheckListViewModel[" + index + "].CategoryName  value=" + CategoryName + " >  <label class='k-label' ><h4> " + list[i].LineCode + " - " + list[i].LineName + "</h4></label>  <div class='switch_box box_4'><div class='input_wrapper'>     <input type='checkbox' checked    name='model.CheckListViewModel[" + index + "].IsActive'  class='switch_4'> <svg class='is_checked' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 426.67 426.67'>     <path d='M153.504 366.84c-8.657 0-17.323-3.303-23.927-9.912L9.914 237.265c-13.218-13.218-13.218-34.645 0-47.863 13.218-13.218 34.645-13.218 47.863 0l95.727 95.727 215.39-215.387c13.218-13.214 34.65-13.218 47.86 0 13.22 13.218 13.22 34.65 0 47.863L177.435 356.928c-6.61 6.605-15.27 9.91-23.932 9.91z' />     </svg>       <svg class='is_unchecked' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 212.982 212.982'>       <path d='M131.804 106.49l75.936-75.935c6.99-6.99 6.99-18.323 0-25.312-6.99-6.99-18.322-6.99-25.312 0L106.49 81.18 30.555 5.242c-6.99-6.99-18.322-6.99-25.312 0-6.99 6.99-6.99 18.323 0 25.312L81.18 106.49 5.24 182.427c-6.99 6.99-6.99 18.323 0 25.312 6.99 6.99 18.322 6.99 25.312 0L106.49 131.8l75.938 75.937c6.99 6.99 18.322 6.99 25.312 0 6.99-6.99 6.99-18.323 0-25.313l-75.936-75.936z' fill-rule='evenodd' clip-rule='evenodd' />   </svg>  </div> </div>        </div>  ";
                    index++;

                    lineitem += " </div>";
                } try {
                    document.getElementById("lines" + masterId).innerHTML = lineitem;
                } catch (err) {
                    
                }
            }

        });


    }


    function ServiceDataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);

            if (  IsOnlineTransfered == true) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }
</script>





