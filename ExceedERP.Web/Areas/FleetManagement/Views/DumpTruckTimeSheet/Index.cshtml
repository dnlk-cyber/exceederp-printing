            //$('#EquipmentTypeId').data("kendoDropDownList").trigger("change");
            //$('#EquipmentNameId').data("kendoDropDownList").trigger("change");
        }
    });
}


</script>
<script>
    function SendForApprovalSelected() {

    var grid = $("#grid").data("kendoGrid");
    var ids = [];

    $("#grid tbody tr").each(function () {

        var checkbox = $(this).find(".approveCheckbox");

        if (checkbox.is(":checked")) {

            var dataItem = grid.dataItem(this);

            ids.push(dataItem.DumpTruckTimeSheetId);
        }
    });

    if (ids.length === 0) {
        alert("Please select at least one record.");
        return;
    }

    $.ajax({
        url: '@Url.Action("SendForApprovalSelected", "DumpTruckTimeSheet")',
        type: "POST",
        traditional: true,
        data: { ids: ids },
