@using ExceedERP.Core.Domain.FleetManagement.FleetRegistration

@{
    ViewBag.Title = "DumpTruckTimeSheets";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var dumpTruckEnum = ViewBag.dumpTruck as TimeSheetType?;
    var enumParam = Json.Encode(ViewBag.dumpTruck);
}

<legend>Dump Truck Timesheets</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.DumpTruckTimeSheet>()
        .Name("grid")
        .Columns(columns =>
        {
            columns.Bound(c => c.DumpTruckTimeSheetId).Title("#").Filterable(false).Width(30);
            columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["category"], "Value", "Text").Width(120);
            columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["type"], "Value", "Text").Width(120);
            columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["name"], "Value", "Text").Width(120);

            columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["Fleets"], "Value", "Text").Title("Plate No").Width(110).Filterable(ftb => ftb.Multi(true).Search(true));
            columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["ProcurementSupplier"], "ProcurementSupplierID", "Name").Title("Supplier Name").Width(110);
            columns.Bound(c => c.Date).Width(70);
            columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branch"], "Value", "Text").Title("Branch Name").Width(100);
            columns.ForeignKey(c => c.BusinessUnitId, (IEnumerable)ViewData["businessunit"], "Value", "Text").Title("Business unit").Width(100);
            columns.Bound(c => c.NetworkingHour).Width(100);
            columns.Bound(c => c.DownHour).Width(100);
            columns.Bound(c => c.ReasonForDown).Width(100);
            columns.Bound(c => c.IdleHour).Width(100);
            columns.Bound(c => c.TimeSheetStatus).Width(100);
            columns.Bound(c => c.OilConsumption).Width(100);
            columns.Bound(c => c.LubricantCost).Title("Lubricant Cost").Width(100);
            columns.Bound(c => c.FuelConsumption).Width(100);
            columns.Bound(c => c.GreaseConsumption).Width(120);
            columns.ForeignKey(c => c.OperatorId, (IEnumerable)ViewData["operator"], "Value", "Text").Width(120).Title("Operator Name");


            columns.Command(command => { command.Edit().UpdateText("Save").CancelText("Cancel").Text("Edit"); command.Destroy().Text("Delete"); }).Title("Action").Width(200);
        })
        .ToolBar(toolbar =>
        {
            toolbar.Create();

        })
        .Editable(editable => editable.Mode(GridEditMode.PopUp)
        .TemplateName("DumpTruckTimeSheetTemplate")
        .Window(win => win.Title("Dump Truck Timesheets").Width(800)))
        .Pageable()
        .Events(e => e.DataBound("dataBound"))
        .Events(e => e.DetailExpand("onDetailExpand"))
        .Filterable()
        .Scrollable(s => s.Height(550))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Sort(s => s.Add(e => e.DumpTruckTimeSheetId).Descending())
            .Model(model => model.Id(p => p.DumpTruckTimeSheetId))
            .Events(ev => ev
                         .Error("error_handler(\"grid\")")
                         .RequestStart("onRequestStart(\"grid\")")
                         .RequestEnd("onRequestEnd(\"grid\")"))
            .Read(read => read.Action("DumpTruckTimeSheets_Read", "DumpTruckTimeSheet").Data("sendForgery"))
            .Create(create => create.Action("DumpTruckTimeSheets_Create", "DumpTruckTimeSheet").Data("sendForgery"))
            .Update(update => update.Action("DumpTruckTimeSheets_Update", "DumpTruckTimeSheet").Data("sendForgery"))
            .Destroy(destroy => destroy.Action("DumpTruckTimeSheets_Destroy", "DumpTruckTimeSheet").Data("sendForgery"))
        ).ClientDetailTemplateId("template")
)

