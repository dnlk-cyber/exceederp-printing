@using ExceedERP.Core.Domain.FleetManagement.FleetRegistration

@{
    ViewBag.Title = "DumpTruckTimeSheets";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var dumpTruckEnum = ViewBag.dumpTruck as TimeSheetType?;
    var enumParam = Json.Encode(ViewBag.dumpTruck);
    bool IsMidroc = (ViewBag.setting as string) == "MIDROC";
    bool IsMCG = (ViewBag.setting as string) == "MCG";
    bool isECWC = (ViewBag.setting as string) == "ECWC";

}
<script>
    function equipmentNameFilter(element) {
        element.kendoComboBox({
            dataTextField: "Name",
            dataValueField: "Id",
            placeholder: "Search equipment...",
            filter: "contains",
            suggest: true,
            minLength: 1,
            autoBind: false,
            dataSource: {
                serverFiltering: true,
                transport: {
                    read: {
                        url: "/FleetManagementDataProvider/GetEquipmentNamesNullable",
                        data: function () {
                            return {
                                equipmentTypeId: $("#EquipmentTypeId").val()
                            };
                        }
                    }
                }
            }
        });
    }
</script>

<legend>Dump Truck Timesheets</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.DumpTruckTimeSheet>()
