@model ExceedERP.Core.Domain.FleetManagement.BatteryManagement.BatteryIssue
 

<legend> Battery Issue</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.BatteryManagement.BatteryIssue>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.StoreCode).Width(140);
        columns.Bound(e => e.PlateNumber).Width(140);
        columns.Bound(e => e.Brand).Width(140);
        columns.Bound(e => e.SerialNo).Width(140);
        columns.Bound(e => e.BatteryType).Width(140);
        columns.Bound(e => e.UnitPrice).Width(80);
        columns.Bound(e => e.Status).Width(100);
       
   
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);


    })
                                                       .ToolBar(commands =>
              {
                  commands.Create(); commands.Excel();
                  commands.Pdf();
              })
      .Editable(editable =>
      {
          editable.Mode(GridEditMode.PopUp).TemplateName("BatteryIssueEditor").Window(x => x.Title(" Battery Issue "));
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Battery Issue Information");
      })
        .HtmlAttributes(new { style = "height: 520px;" })
                              .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                                     .Sortable()
                                    .Filterable()
                                     .Scrollable(h => h.Height(500))
                                       .ClientDetailTemplateId("template")
                                            .Events(ev => { ev.DetailExpand("onDetailExpandUser"); ev.DataBound("onDataBound"); })
      
    .DataSource(dataSource => dataSource
        .Ajax()
        .ServerOperation(false) 
        .Model(model =>
              {
                  model.Id(p => p.BatteryIssueId);
               
              }).Events(ev => ev
                                                            .Error("error_handler(\"grid\")")
                                                            .RequestStart("onRequestStart(\"grid\")")
                                                            .RequestEnd("onRequestEnd(\"grid\")")) 
                    .Create(update => update.Action("BatteryIssue_Create", "BatteryIssue"))
                    .Read(read => read.Action("BatteryIssue_Read", "BatteryIssue"))
                    .Update(update => update.Action("BatteryIssue_Update", "BatteryIssue"))
                    .Destroy(update => update.Action("BatteryIssue_Destroy", "BatteryIssue"))
  )
)


<script id="template" type="text/kendo-tmpl">
   @(Html.Kendo().TabStrip()
                                            .Name("tabStrip_#=BatteryIssueId#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
            items.Add().Text("Detail").Content(
                @<text>
                    <legend>Detail</legend>

                    <div class="box">

                        <div class="box-col">
                            # if (IsSendForApproval == false || IsSendForApproval == "false")
                            {#

                            <a href='@Url.Action("BatteryIssue_SendForOnlineApproval", "BatteryIssueApproval")/?Id=#=BatteryIssueId#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                            # }#

                        </div>
                    </div>
                    <div class="demo-section k-header export-app">
                        <div class="demo-section content-wrapper">

                            <form>



                                <div class="row">
                                    <div class="col-md-1">
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <div class="label">
                                                @Html.LabelFor(model => model.CreatedBy)
                                            </div>
                                            <div>
                                                #=CreatedBy#

                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <div class="label">
                                                @Html.LabelFor(model => model.DateCreated)
                                            </div>
                                            <div>
                                                #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <div class="label">
                                                @Html.LabelFor(model => model.ModifiedBy)
                                            </div>
                                            <div>

                                                #=ModifiedBy#

                                            </div>
                                        </div>
                                    </div>

                                            <div class="col-md-2">
                                        <div class="form-group">
                                            <div class="label">
                                                @Html.LabelFor(model => model.LastModified)
                                            </div>
                                            <div>
                                                #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #

                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </form>

                        </div>
                    </div>



                </text>


    );
        items.Add().Text(" Approval").Content(@<text>

            @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.BatteryManagement.BatteryApproval>()
                                                                                .Name("BatteryIssueApproval#=BatteryIssueId#")
                .Columns(columns =>
                {
                   columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                    columns.Bound(o => o.Remark).Width(200);
                    columns.Bound(c => c.CreatedBy).Width(150);
                    columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                    columns.Command(command => { command.Edit(); }).Width(250);

                }).Events(ev =>
                                       {
                                           ev.DataBound("approveonDataBound");
                                       })
                     .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                      .DataSource(dataSource => dataSource
                    .Ajax()
                    .PageSize(5)
                                           .Model(model =>
                      {
                          model.Id(p => p.BatteryApprovalId);
                          model.Field(p => p.CreatedBy).Editable(false);
                          model.Field(p => p.DateCreated).Editable(false);
                      })
                                                                        .Events(ev => ev
                                            .Error("error_handler(\"BatteryIssueApproval#=BatteryIssueId#\")")
                                            .RequestStart("onRequestStart(\"BatteryIssueApproval#=BatteryIssueId#\")")
                                            .RequestEnd("onRequestEnd(\"BatteryIssueApproval#=BatteryIssueId#\")"))
                                                                                                                   .Create(update => update.Action("BatteryIssue_Approve", "BatteryIssueApproval", new { EId = "#=BatteryIssueId#" }))
                                                                                                     .Read(read => read.Action("BatteryIssueApproval_Read", "BatteryIssueApproval", new { EId = "#=BatteryIssueId#" }))
                                                                                                   .Update(update => update.Action("BatteryIssue_Approve", "BatteryIssueApproval", new { EId = "#=BatteryIssueId#" }))


                                              )
                                       .ToClientTemplate())
        </text>
        );
    })
                                                                                                                                                                                                                                                                                                                  .ToClientTemplate())
</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
<script type="text/javascript">


    var IsApproved;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        IsApproved = masterDataItem.IsOnlineApproved;
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            console.log(dataItem.IsOnlineApproved);
            if (dataItem.IsSendForApproval == true || dataItem.IsSendForApproval == "true") {
                  $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            if (dataItem.IsOnlineApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {
                console.log("Approved");
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

</script>



<script type="text/javascript">

    function BindDetail() {

        var SerialNo = $("#SerialNo").data("kendoDropDownList");
        var SerialNoId = SerialNo.value();
        $.ajax({
            url: '@Url.Action("GetReturnBatteryInfo", "BatteryReturn")',
            data: { Id: SerialNoId },
            type: 'POST',
            cache: false,
            success: function (r) {
               
                if (r != 0) {
                    var s = r.split(/_/);
                    $("#Brand").val(s[0]);
                    $("#StoreCode").val(s[5]);
                    $("#BatteryType").val(s[1]);
                    $("#KMReading").val(s[2]);
                    $("#UnitPrice").val(s[3]);
                    $("#InstalledDate").val(s[4]);
                }  
            }

        });
    }
</script>