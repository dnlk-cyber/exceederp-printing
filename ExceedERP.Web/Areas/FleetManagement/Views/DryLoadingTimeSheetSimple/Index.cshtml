<legend>Dry Loading Timesheet</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.DryLoadingTimeSheet>()
                                    .Name("grid")
                                    .Columns(columns =>
                                    {
                                        columns.Bound(c => c.DryLoadingTimeSheetId).Title("#").Width(60);
                                        columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["fleet"], "FleetsID", "PlateNumber").Title("Equipment Name").Width(120);
                                        columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["ProcurementSupplier"], "ProcurementSupplierID", "Name").Title("Supplier Name").Width(100);
                                        columns.Bound(c => c.WorkItem).Width(100);
                                        columns.Bound(c => c.WorkingHour).Width(100);
                                        columns.Bound(c => c.TripStartPlace).Title("Start Place").Width(100);
                                        columns.Bound(c => c.TriplArrivalPlace).Title("Arrival Place").Width(100);
                                        columns.Bound(c => c.TripStartDate).Title("Start Date").Width(100);
                                        columns.Bound(c => c.TripArrivalDate).Title("Arrival Date").Width(100);
                                        columns.Bound(c => c.Asphalt).Title("Asphalt  (Km)").Width(100);

                                        columns.Command(command => { command.Edit().UpdateText("save").CancelText("Cancel").Text("Edit"); command.Destroy().Text("Delete"); }).Title("Action").Width(200);
                                    })
                                    .ToolBar(toolbar =>
                                    {
                                        toolbar.Create();

                                    })
                                    .Editable(editable => editable.Mode(GridEditMode.PopUp)
                                    .TemplateName("DryLoadingTimesheetSimpleTemplate")
                                    .Window(win => win.Title("Dry Loading Timesheets").Width(800)))
                                    .Pageable()
                                    .Filterable()
                                    .Events(e => e.DataBound("dataBound"))
                                    .Events(e => e.DetailExpand("onDetailExpand"))
                                    .Scrollable(s => s.Height(550))
                                    .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Sort(sort => sort.Add(e => e.DryLoadingTimeSheetId).Descending())
                                        .Model(model => model.Id(p => p.DryLoadingTimeSheetId))
                                        .Events(ev => ev
                                                     .Error("error_handler(\"grid\")")
                                                     .RequestStart("onRequestStart(\"grid\")")
                                                     .RequestEnd("onRequestEnd(\"grid\")"))
                                        .Read(read => read.Action("DryLoadingTimeSheets_Read", "DryLoadingTimeSheetSimple"))
                                        .Create(create => create.Action("DryLoadingTimeSheets_Create", "DryLoadingTimeSheetSimple"))
                                        .Update(update => update.Action("DryLoadingTimeSheets_Update", "DryLoadingTimeSheetSimple"))
                                        .Destroy(destroy => destroy.Action("DryLoadingTimeSheets_Destroy", "DryLoadingTimeSheetSimple"))
                                    ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">

    @(Html.Kendo().TabStrip()
                                                                   .Name("tabStrip_#=DryLoadingTimeSheetId#")
                                                                   .SelectedIndex(0)
                                                                   .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                                                                   .Items(items =>
                                                                   {

                                                                       items.Add().Text("Detail").Content(
                                                                            @<text>
                                                                                <legend>Detail</legend>
                                                                                <div class="box">
                                                                                    <div class="box-col">

                                                                                        # if (TimeSheetSendForAproval == false)
                                                                                        {#

                                                                                        <a onclick='return sendForApproval("#=DryLoadingTimeSheetId#")' href=' \#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                                                                                        # }#
                                                                                    </div>
                                                                                </div>
                                                                                <div class="row">
                                                                                    <div class="col-md-1">
                                                                                    </div>
                                                                                    <div class="col-md-6" style="margin-top:20px;">
                                                                                        <div class="form-group">
                                                                                            <label>Status</label>: <span>#=TimeSheetStatus#</span>
                                                                                        </div>
                                                                                        <div class="form-group">
                                                                                            <label>Created By</label>: <span>#=CreatedBy#</span>
                                                                                        </div>
                                                                                        <div class="form-group">
                                                                                            <label>Date Created</label>: <span>#=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #</span>
                                                                                        </div>
                                                                                        <div class="form-group">
                                                                                            <label>Approved By</label>: <span>#=TimeSheetApprovedBy#</span>
                                                                                        </div>
                                                                                        <div class="form-group">
                                                                                            <label>Approved Date</label>: <span>#=kendo.toString(kendo.parseDate(TimeSheetApprovedDate), 'dd/MM/yyyy')#</span>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </text>
                                                                                                                       ); items.Add().Text("Approval").Content(@<text>

                                                                                                                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.TimeSheetApprovalNew>()
                                                                                                                                                                            .Name("TimeSheetApproval#=DryLoadingTimeSheetId#")
                                                                                                                                                                            .Columns(columns =>
                                                                                                                                                                            {
                                                                                                                                                                                     columns.Bound(o => o.Status).EditorTemplateName("ApprovalEditor").Width(126);

                                                                                                                                                                                     columns.Bound(o => o.Remark).Width(200);
                                                                                                                                                                                     columns.Bound(c => c.CreatedBy).Width(150);
                                                                                                                                                                                     columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}").Width(150);
                                                                                                                                                                                     columns.Command(command => { command.Edit(); }).Width(250);

                                                                                                                                                                                 })
                                                                                                                                                                            .ToolBar(commands => commands.Create().Text("Approve Request"))
                                                                                                                                                                            .Events(ev =>
                                                                                                                                                                            {
                                                                                                                                                                                     ev.DataBound("approvalDataBound");
                                                                                                                                                                                 })
                                                                                                                                                                            .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                                                                                                                                    .DataSource(dataSource => dataSource
                                                                                                                                                                                    .Ajax()
                                                                                                                                                                                    .PageSize(5)
                                                                                                                                                                                    .Model(model =>
                                                                                                                                                                                    {
                                                                                                                                                                                             model.Id(p => p.TimeSheetApprovalNewId);
                                                                                                                                                                                             model.Field(p => p.CreatedBy).Editable(false);
                                                                                                                                                                                             model.Field(p => p.DateCreated).Editable(false);
                                                                                                                                                                                         })
                                                                                                                                                                                    .Events(ev => ev
                                                                                                                                                                                    .Error("error_handler(\"TimeSheetApproval#=DryLoadingTimeSheetId#\")")
                                                                                                                                                                                    .RequestStart("onRequestStart(\"TimeSheetApproval#=DryLoadingTimeSheetId#\")")
                                                                                                                                                                                    .RequestEnd("onRequestEnd(\"TimeSheetApproval#=DryLoadingTimeSheetId#\")"))

                                                                                                                                                                                    .Create(update => update.Action("DryLoadingTimeSheetApproval_Create", "DryLoadingTimeSheetSimple", new { Id = "#=DryLoadingTimeSheetId#" }))
                                                                                                                                                                                    .Read(read => read.Action("DryLoadingTimeSheetApproval_Read", "DryLoadingTimeSheetSimple", new { Id = "#=DryLoadingTimeSheetId#" }))
                                                                                                                                                                                    .Update(update => update.Action("DryLoadingTimeSheetApproval_Create", "DryLoadingTimeSheetSimple"))


                                                                                                                                                                                )
                                                                                                                                                                                .ToClientTemplate())
                                                                                                                    </text>
                                                                                                                                              );
                                                                                }).ToClientTemplate())


</script>
<script>

    var timeSheetApproved;
    var timeSheetSendForAproval;
    var dryLoadingTimeSheetId;

    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = this;

        var masterDataItem = masterGrid.dataItem(masterRow);

        timeSheetApproved = masterDataItem.TimeSheetApproved;

        timeSheetSendForAproval = masterDataItem.TimeSheetSendForAproval;

        dryLoadingTimeSheetId = masterDataItem.DryLoadingTimeSheetId;


        var firstValidationgridName = "#TimeSheetApproval" + dryLoadingTimeSheetId;



        if (timeSheetApproved == true || timeSheetSendForAproval == false) {

            $(".k-grid-top", firstValidationgridName).hide();

        }
    }

    function dataBound() {


        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.TimeSheetApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
            if (dataItem.TimeSheetApproved == true || dataItem.TimeSheetSendForAproval == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();


            }
        });
    }

    function sendForApproval(id) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("TimeSheetSendForApproval", "DryLoadingTimeSheetSimple", new { area = "FleetManagement" })',
            data: { id: id },
            success: function (result) {

                alert(result);

                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }

    function approvalDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsApproved == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });

    }

     function fetchTimesheetEquipmentType() {
        return {
            timeSheetEquipmentType: "@ViewBag.dryLoading",
            text: $("#FleetsID").data("kendoDropDownList").filterInput.val(),
        }
    }

    function filterOperator() {
        return {
            text: $("#OperatorId").data("kendoDropDownList").filterInput.val()
        }
    }
</script>

<script type="text/javascript">
    function filterOperator() {
        return {
            text: $("#OperatorId").data("kendoDropDownList").filterInput.val()
        }
    }
</script>
<style>
    div.k-edit-form-container {
        width: auto;
        height: auto;
    }

    .row .col-sm-2 {
        width: 150px;
    }

    .row {
        margin: auto;
    }
</style>