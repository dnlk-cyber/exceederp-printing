    

<label> @ViewBag.Type </label>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.AssignedEquipment>()
                        .Name("grid")
                        .Columns(columns =>
                        {
                            columns.ForeignKey(e => e.EquipmentNameID, (System.Collections.IEnumerable)ViewData["EquipmentNames"], "Id", "Name").EditorTemplateName("EquipmentNameEditor").Title("Equipment Name").Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
                            columns.ForeignKey(e => e.FleetId, (System.Collections.IEnumerable)ViewData["FleetsAssignedEquip"], "Id", "Name").EditorTemplateName("FleetEditor").Title("Plate No").Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
                            columns.ForeignKey(e => e.OperatorId, (System.Collections.IEnumerable)ViewData["Operators"], "Id", "Name").EditorTemplateName("OperatorNameEditor").Title("Operator Name").Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
                            columns.Bound(e => e.ReturnDate).Width(100);
                            columns.Bound(e => e.StartOdometr).Width(100);
                            columns.Bound(e => e.EndOdometer).Width(100);
                            columns.Bound(e => e.NetOdometer).Width(100);
                            columns.Bound(e => e.StartDate).Title("Sent Date").Width(100);
                            columns.Bound(e => e.EndDate).Title("Arrival Date").Width(100);
                            columns.Bound(e => e.ArrivalPlace).Title("Arrival Place").Width(100);
                            //columns.Command(command => { command.Edit().UpdateText("Save").CancelText("Cancel").Text("Edit"); }).Title("Action").Width(200);
                            columns.Command(command => { command.Destroy().Text(" Accept Equipment "); command.Edit(); }).Width(200);
                        })

                        .Editable(editable => { editable.Mode(GridEditMode.InLine); editable.DisplayDeleteConfirmation("Are You Sure You Want To Return This Equipment"); })
                        .Pageable()
                        .Events(e => e.Edit("handleEdit"))
                        .Events(e => e.DataBound("dataBound"))
                        //.Events(e => e.DetailExpand("onDetailExpand"))
                        .Filterable()
                        .Scrollable(s => s.Height(550))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Model(model =>
                            {
                                model.Id(p => p.AssignedEquipmentID);
                                model.Field(p => p.OperatorId).Editable(false);
                                model.Field(p => p.EquipmentNameID).Editable(false);
                                model.Field(p => p.FleetId).Editable(false);
                                model.Field(p => p.StartOdometr).Editable(false);
                                model.Field(p => p.ReturnDate).Editable(false);
                                model.Field(p => p.ArrivalPlace).Editable(false);
                            })
                            .Events(ev => ev
                                         .Error("error_handler(\"grid\")")
                                         .RequestStart("onRequestStart(\"grid\")")
                                         .RequestEnd("onRequestEnd(\"grid\")"))
                            .Read(read => read.Action("AssignedEquipment_Read", "AssignedEquipments").Data("sendForgery"))
                            .Update(update => update.Action("AssignEqupment_Update", "AssignedEquipment").Data("sendForgery"))
                            .Destroy(update => update.Action("AcceptEquipment", "AssignedEquipment").Data("sendForgery"))
                            .Sort(s=>s.Add("AssignedEquipmentID").Descending())
                            )
)

<script type="text/javascript">
    const handleEdit = () => {
        $("#NetOdometer").prop("disabled", true);
    }

    function dataBound() {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Returned == true) {
                $(this).find(".k-grid-delete").hide();
               $(this).find(".k-grid-edit").hide();
            }
        }            
            )
    }
</script>