    function onPlateNumberChange() {
        var ddl = $("#FleetsID").data("kendoDropDownList");
        var plateNumber = ddl.value(); // Gets the PlateNumber text (not ID)

        if (plateNumber && plateNumber !== "Select") {
            $.ajax({
                url: '@Url.Action("GetLocation", "FleetManagementDataProvider")',
                type: 'GET',
                data: { PlateNumber: plateNumber },
                success: function (result) {
                    if (result && result.From) {
                        $("#FromLocation").val(result.From);
                    } else {
                        $("#FromLocation").val("");
                    }
                },
                error: function () {
                    $("#FromLocation").val("");
                }
            });
        } else {
            $("#FromLocation").val("");
        }
    }
