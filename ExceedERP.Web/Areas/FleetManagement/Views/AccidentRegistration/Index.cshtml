@model ExceedERP.Core.Domain.FleetManagement.FleetRegistration.Accident

<legend>Accident Registration</legend>


@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetRegistration.Accident>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(o => o.AssetCode);
          columns.Bound(o => o.PlateNo);
          columns.Bound(o => o.SerialNo);
          columns.Bound(o => o.ChasisNo);
          columns.ForeignKey(e => e.OperatorId, (System.Collections.IEnumerable)ViewData["Operators"], "Id", "Name").Title("Operator Name").Width(140);
          columns.Bound(o => o.AccidentLocation);
          columns.Bound(o => o.Status);
          columns.Bound(o => o.DateOfOccurrence).Format("{0:d}");



          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);

      })
      .ToolBar(commands => commands.Create())
      .Events(ev =>
      {
          ev.DataBound("onDataBound");
          ev.DetailExpand("onDetailExpand");
      })
      .Editable(editable =>
      {
          editable.Mode(GridEditMode.PopUp).TemplateName("AccidentEditor").Window(x => x.Title("Accident Registration "));
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Accident");
      })
           .HtmlAttributes(new { style = "height: 520px;" })
           .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

              .Scrollable()
              .Sortable()
              .Filterable()
              .Scrollable(h => h.Height(500))
              .ClientDetailTemplateId("template")
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add(e => e.DateCreated).Descending())
          .ServerOperation(false)
          .Model(model =>
          {
              model.Id(p => p.AccidentID);
              model.Field(p => p.AccidentID).Editable(false);

          })
                               .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
          .Create(update => update.Action("Accident_Create", "AccidentRegistration"))
          .Read(read => read.Action("Accident_Read", "AccidentRegistration"))
          .Update(update => update.Action("Accident_Update", "AccidentRegistration"))
          .Destroy(update => update.Action("Accident_Destroy", "AccidentRegistration"))
      ))

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabStrip_#=AccidentID#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
                items.Add().Text("Detail").Content(
                    @<text>
                            <div class="box">

                                <div class="box-col">
                                    # if (IsSendForApproval == false || IsSendForApproval == "false")
                                    {#
                                  <a href='@Url.Action("SendForOnlineApproval", "AccidentRegistration")/?Id=#=AccidentID#' title="Send for Insurance"><i class="fa fa-share-square fa-2x"></i></a>
                                    # }#

                                  
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-1">
                                </div>
                                <div class="col-md-6" style="margin-top:20px;">

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CreatedBy):<span>#=CreatedBy#</span>

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.DateCreated):<span>#=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #</span>

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ModifiedBy):<span>#=ModifiedBy#</span>

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.LastModified):<span>#=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy')#</span>

                                    </div>
                                 


                                </div>
                            </div>  

                    </text>


            );  })
                                                                                                                                                                                                                                                                                                                        .ToClientTemplate())
</script>

    <style type="text/css">
        div.k-edit-form-container {
            width: 700px;
        }
    </style>

<script>

    var IsApproved;
    var IsSendForApproved;
    var masterId;
 
    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.RentFromExternalID;
        IsApproved = masterDataItem.IsOnlineApproved;
        IsSendForApproved = masterDataItem.IsSendForApproval;

        var FleetInsuranceTypegrid = "#FleetInsuranceTypegrid" + masterId;
        if (IsSendForApproved == true) {
            $(FleetInsuranceTypegrid).find(".k-toolbar").hide(); //hide toolbar
            $(".k-grid-top", FleetInsuranceTypegrid).remove();
        }
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
             if (dataItem.IsSendForApproval == true || dataItem.IsSendForApproval == "true") {
                  $(this).find(".k-grid-edit").remove();
                 $(this).find(".k-grid-delete").remove(); $(this).addClass("k-state-FleetApproved");
            }
     
        });
    }

    function filterOperators() {
        return {
            text: $("#OperatorId").val()
        };
    }

</script>


<style>
    div.k-edit-form-container {
        width: auto;
        height: auto;
    }

    .row .col-sm-2 {
        width: 150px;
    }

    .row {
        margin: auto;
    }
</style>