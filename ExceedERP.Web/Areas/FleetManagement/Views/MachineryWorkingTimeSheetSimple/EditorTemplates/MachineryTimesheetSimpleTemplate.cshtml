                @(Html.Kendo().DropDownListFor(model => model.BusinessUnitId)
                    .ValuePrimitive(true)
                    .OptionLabel("Select Business Unit...")
                    .DataTextField("Name")
                    .DataValueField("Id")
                    .Filter("contains")

                    .DataSource(dataSource =>
                    {
                        dataSource.Read(read => read.Action("GetBusinessUnits", "FleetManagementDataProvider", new { area = "FleetManagement" }))
                        .ServerFiltering(false);
                    })
                )
            </div>
        </div>
    </div>





</div>
