@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Core.Domain
@using ExceedERP.Helpers
@using ExceedERP.Core.Domain.FleetManagement
@model  ExceedERP.Core.Domain.FleetManagement.FleetResource.SitesVehicleTransfer
<script>
    function filterEquipmentIdentity() {

        var dropdownlist = $("#EquipmentTypeID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentIdentityId: $("#EquipmentIdentityID").val(),
            Search: filterInput.val()
        };

    }

    function filterEquipment() {
        var dropdownlist = $("#FleetsID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentNameId: $("#EquipmentNameID").val(),
            search: filterInput.val()
        };
    }
    function filterByType() {
        var dropdownlist = $("#EquipmentNameID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            equipmentTypeId: $("#EquipmentTypeID").val(),
            search: filterInput.val()
        };

    }
</script>

<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            <div>Equipment Category</div>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentIdentityID)
                                      .DataTextField("Name")
                                      .DataValueField("Id").Filter(FilterType.Contains)
                                      .OptionLabel("Select Category")
                                      .HtmlAttributes(new { style = "width:100%" })
                                      .DataSource(d => d.Read(r => r.Action("GetEquipmentIdentities", "FleetManagementDataProvider"))
                                      .ServerFiltering(false)))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <div>Equipment Type</div>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentTypeID)
                                             .DataTextField("Name")
                                             .DataValueField("Id")
                                             .OptionLabel("Select Equipment Type")
                                             .Filter(FilterType.Contains)
                                             .DataSource(d =>
                                             {
                                                 d.Read(r =>
                                                  {
                                                      r.Action("GetEquipmentTypes", "FleetManagementDataProvider")
                                                        .Data("filterCategory");
                                                  })
                                                   .ServerFiltering(true);
                                             })
                                                   .Enable(false)
                                                   .AutoBind(false)
                                                   .CascadeFrom("EquipmentIdentityID")
                )
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <div>Equipment Name</div>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentNameID)
                                                               .AutoBind(false)
                                                               .Enable(false)
                                                               .DataTextField("Name")
                                                                 .DataValueField("Id")
                                                                 .Filter(FilterType.Contains)
                                                                 .OptionLabel("Select")
                                                               .DataSource(d => d.Read(r => r.Action("GetEquipmentNames", "FleetManagementDataProvider")
                                                               .Data("filterEquipmentNames")).ServerFiltering(true)).CascadeFrom("EquipmentTypeID"))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <div>Plate No</div>
            <div>
                @(Html.Kendo().DropDownListFor(m => m.FleetsID)

                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .ValuePrimitive(true)
                                            .Filter(FilterType.Contains)
                                            .OptionLabel("Select Plate No")

                                            .DataSource(d => d.Read(r => r.Action("GetPlateNoForSiteVehicleTransfer", "FleetManagementDataProvider").Data("filterPlateNo"))
                                            .ServerFiltering(true)).HtmlAttributes(new { style = "width:100%" }).CascadeFrom("EquipmentNameID"))
            </div>
        </div>
    </div>
</div>

<div class="row">

    <div class="col-sm-2">
        <div class="form-group">
            <div> Starting Date</div>
            <div>
                @Html.Kendo().DatePickerFor(model => model.StartingDate).HtmlAttributes(new { style = "width:100%" })
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <div>To Date</div>
            <div>
                @Html.Kendo().DatePickerFor(model => model.ToDate).HtmlAttributes(new { style = "width:100%" })
            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            <div>Destination Site</div>
            <div>


                @(Html.Kendo().DropDownListFor(m => m.BranchId)

                                                   .DataTextField("Text")
                                                   .DataValueField("Value")
                                                   .Filter(FilterType.Contains)
                                                   .OptionLabel("Select Plate No")
                                                   .DataSource(d => d.Read(r => r.Action("GetBranchForSiteVehicleTransfer", "FleetManagementDataProvider").Data("filterBranch"))
                                                   .ServerFiltering(true)).HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <div>Battery Status</div>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.BatteryStatus)
                                                                                    .DataTextField("Text")
                                                                                    .DataValueField("Value")
                                                                                    .HtmlAttributes(new { style = "width:100%" })
                                                                                    .BindTo(EnumExtension.EnumToSelectList(typeof(BatteryStatus))
                                                                                    ))
            </div>
        </div>
    </div>
</div>

@* 2nd Row *@

<div class="row">



    <div class="col-sm-2">
        <div class="form-group">
            <div>Equipment Condition</div>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.EquipmentCondition)
                                                                            .DataTextField("Text")
                                                                            .DataValueField("Value")
                                                                            .HtmlAttributes(new { style = "width:100%" })
                                                                            .BindTo(EnumExtension.EnumToSelectList(typeof(EquipmentCondition))
                                                                            ))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <div>Transfer Mode</div>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.TransferMode)
                                                                            .DataTextField("Text")
                                                                            .DataValueField("Value")
                                                                            .HtmlAttributes(new { style = "width:100%" })
                                                                            .BindTo(EnumExtension.EnumToSelectList(typeof(TransferMode))
                                                                            ))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <div>Transered Operator</div>
            <div>
                @*@Html.Kendo().TextBoxFor(model => model.TransferedOperator).HtmlAttributes(new { style = "width:100%" })*@
                @(Html.Kendo().DropDownListFor(m => m.OperatorId)
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .Filter(FilterType.Contains)
                                    .OptionLabel("Select Operator")
                                    .DataSource(d => d.Read(r => r.Action("GetOperatorForVehicleTransfer", "FleetManagementDataProvider"))
                                    .ServerFiltering(false)).HtmlAttributes(new { style = "width:100%" }))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            <div>Battery Quantity</div>
            <div>
                @Html.Kendo().TextBoxFor(model => model.BatteryQuantity).HtmlAttributes(new { style = "width:100%" })
            </div>
        </div>
    </div>
    @*<div class="col-sm-2">
            <div class="form-group">
                <div>Odo Meter</div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.OdoMeter).HtmlAttributes(new { style = "width:100%" }))
                </div>
            </div>
        </div>*@
</div>
    
   
<div class="row">

    <div class="col-sm-2">
        <div class="form-group">
            <div>Fuel Amount</div>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.FuelAmount)
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .HtmlAttributes(new { style = "width:100%" })
                                            .BindTo(EnumExtension.EnumToSelectList(typeof(FuelAmount))
                                            ))
            </div>
        </div>
    </div>
    
    <div class="col-sm-2">
        <div class="form-group">
            <div>Transfer Reason</div>
            <div>
                @Html.Kendo().TextBoxFor(model => model.TransferReason).HtmlAttributes(new { style = "width:100%" })
            </div>
        </div>
    </div>
</div>





