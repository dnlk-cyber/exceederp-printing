<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
<script type="text/javascript">
    var masterId;
    var fleetPlate;
    var IsApproved;
    var IsSendForApproval;
    var PlateNo;
    function RejectPopUp(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var dataItem = masterGrid.dataItem(masterRow);
        masterId = dataItem.SitesVehicleTransferID;
        fleetPlate = dataItem.VoidBy;
        IsApproved = dataItem.IsOnlineApproved;
        IsSendForApproval = dataItem.IsSendForApproval;
        PlateNo = dataItem.PlateNo;
        var PartGrid = "#PartsGrid_" + masterId;
        if (IsApproved == true || IsSendForApproved == true) {
            $(".k-grid-top", PartGrid).hide();

        }
        var category = "";
        var lineitem = "";
        var index = 0;
      
        if (IsSendForApproval == false) {
            $.ajax({
                url: '@Url.Action("CheckListLog_Read", "CheckListLog")',

                data: { Id: masterId, PlateNumber: PlateNo },
                type: 'POST',
                cache: false,
                success: function (list) {
                    for (var i = 0 ; i < list.length; i++) {

                        lineitem += "    <div class='col-sm-12 form-group'>";
                        if (category != list[i].CategoryName) {

                            lineitem += "       <div class='col-sm-12'><h2 style='background-color:greenyellow'>" + list[i].CategoryName + " </h2></div>";
                            category = list[i].CategoryName;
                        }
                       
                        lineitem += "<div class='col-sm-3'  >  <input type='hidden' name=model.CheckListViewModel[" + index + "].InspectionId  value=" + masterId + ">   <input type='hidden' name=model.CheckListViewModel[" + index + "].LineName  value=" + list[i].LineName + " '>     <input type='hidden' name=model.CheckListViewModel[" + index + "].LineCode  value=" + list[i].LineCode + " '>    <input type='hidden' name=model.CheckListViewModel[" + index + "].CategoryName  value=" + list[i].CategoryName + " '>  <label class='k-label' ><h4> " + list[i].LineName + "</h4></label>   <input type='checkbox' id='checked" + i + "' class='cbx hidden' checked    name='model.CheckListViewModel[" + i + "].IsActive'   >   <label for='checked" + i + "' class='lbl'></label>            </div>  ";

                        lineitem += "  <input type='text' name='model.CheckListViewModel[" + i + "].Remark' value='' class=' form-control'   style='padding: 5px;'>";

                        index++;

                        lineitem += "</div> </div>";
                    } try {
                        document.getElementById("lines" + masterId).innerHTML = lineitem;
                    } catch (err) {
                       
                    }
                }

            });
        }
        if (IsSendForApproval == true) {
            $.ajax({
                url: '@Url.Action("AnnualInspectionlogLast_Read", "AnnualEquipmentInventoryInspection")',

                data: { Id: masterId, PlateNumber: PlateNo },
                type: 'POST',
                cache: false,
                success: function (list) {
                    for (var i = 0 ; i < list.length; i++) {


                        lineitem += "    <div class='col-sm-12'>";
                        if (category != list[i].CategoryName) {

                            lineitem += "       <div class='col-sm-12'><h2 style='background-color:greenyellow'>" + list[i].CategoryName + " </h2></div>";
                            category = list[i].CategoryName;
                        }
                        lineitem += "<div class='row form-control' ><label   >  * " + list[i].LineName + "   </label> <p>" + list[i].Remark + " </p>   </div>";
                        index++;

                        lineitem += " </div>";
                    }
                    try {
                        document.getElementById("approvedlines" + masterId).innerHTML = lineitem;
                    }
                    catch (Err)
                    { }
                }

            });
        }
    }
    function BindIntialSite() {

        var Fleetsobj = $("#FleetsID").data("kendoDropDownList");
        var fleetID = Fleetsobj.value();
        $.ajax({
            url: '@Url.Action("FleetsDetailDDBind", "EquipmentRegistration")',
            data: { FleetsID: fleetID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r != 0) {
                    var s = r.split(/_/);
                    if (s[4] == "" || s[4] == null)
                    {
                        $("#InitialSite").val("Not Assigned");
                    }
                    else
                    {

                    $("#Odometer").val(s[3]);
                    $("#InitialSite").val(s[4]);
                }
                  
                } else {
                    $("#InitialSite").val('UnAssigned');
                  
                }
            }

        });

    }
    var IsApproved;
    var IsSendForApproved;
    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        IsApproved = masterDataItem.IsOnlineApproved;
        var masterId = masterDataItem.SitesVehicleTransferID;
        IsSendForApproved = masterDataItem.IsSendForApproval;
        var PartGrid = "#PartsGrid_" + masterId;
        if (IsApproved == true || IsSendForApproved == true)
        {
            $(".k-grid-top", PartGrid).hide();
           
        }
    }
    function onDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsSendForApproval == true || dataItem.IsOnlineApproved == true) {
               
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }

            if (dataItem.IsOnlineApproved == true) {
                $(this).addClass("k-state-FleetApproved");
            }
        });
    }

    function lineonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (IsApproved == true || IsSendForApproved == true) {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }
    function approveonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approve" || IsApproved == true) {
             
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

</script>
