@model ExceedERP.Core.Domain.FleetManagement.FleetResource.SitesVehicleTransfer

<legend> Sites Vehicle Transfer</legend>

<style>
    .lbl {
        position: relative;
        display: block;
        height: 40px;
        width: 64px;
        background: #898989;
        border-radius: 100px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .lbl:after {
            position: absolute;
            left: -2px;
            top: -3px;
            display: block;
            height: 40px;
            width: 54px;
            border-radius: 100px;
            background: #fff;
            box-shadow: 0px 3px 3px rgba(243, 245, 247, 0.05);
            content: '';
            transition: all 0.3s ease;
        }

        .lbl:active:after {
            transform: scale(1.15, 0.85);
        }

    .cbx:checked ~ label {
        background: #32a6f3;
    }

        .cbx:checked ~ label:after {
            left: 20px;
            background: #5a666e;
        }

    .cbx:disabled ~ label {
        background: #d5d5d5;
        pointer-events: none;
    }

        .cbx:disabled ~ label:after {
            background: #bcbdbc;
        }

    .container {
        position: absolute;
        top: 250px;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .demo {
        margin-bottom: 40px;
    }

    .hidden {
        display: none;
    }
</style>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetResource.SitesVehicleTransfer>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.Remark).Title("Equipment Name").Width(140);
        columns.Bound(e => e.InitialSite).Width(120);
        columns.Bound(e => e.DestinationSite).Width(120);
        columns.Bound(e => e.StartingDate).Width(120);
        columns.Bound(e => e.ToDate).Format(("{0:d}")).Width(120);
        columns.Bound(e => e.Status).Width(100);
   
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);


    })
                                          .ToolBar(commands => commands.Create())
  .Editable(editable =>
      {
          editable.Window(w => w.Title("Site Transfer"));
          editable.Mode(GridEditMode.PopUp).TemplateName("SitesVehicleTransferEditor");
          editable.DisplayDeleteConfirmation("Are You Sure To Remove Sites Vehicle Transfer ");
      })
         .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                                 .Scrollable(h => h.Height(500))
                                              .ClientDetailTemplateId("template").Groupable().Events(ev => ev.DetailExpand("RejectPopUp"))
    .DataSource(dataSource => dataSource
        .Ajax()
        .ServerOperation(false)
                       .Model(model =>
              {
                  model.Id(p => p.SitesVehicleTransferID);
               
              }).Events(ev => ev
                                                            .Error("error_handler(\"grid\")")
                                                            .RequestStart("onRequestStart(\"grid\")")
                                                            .RequestEnd("onRequestEnd(\"grid\")")) 
                .Create(update => update.Action("SitesVehicleTransfer_Create", "SitesVehicleTransfer"))
                .Read(read => read.Action("SitesVehicleTransfer_Read", "SitesVehicleTransfer"))
                .Update(update => update.Action("SitesVehicleTransfer_Update", "SitesVehicleTransfer"))
                .Destroy(update => update.Action("SitesVehicleTransfer_Destroy", "SitesVehicleTransfer"))
  )
     .Events(events => events.DataBound("onDataBound"))
)


