@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Fleet Inspection Setting</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.EquipmentInspection.FleetCheckList>()
            .Name("grid")
            .Columns(columns =>
            {
                columns.Bound(e => e.FleetCheckListId).Width(80);
                columns.ForeignKey(c => c.EquipmentIdentityID, (System.Collections.IEnumerable)ViewData["EquipmentIdentity"], "EquipmentIdentityID", "EquipmentCategoryName").EditorTemplateName("EquipmentCategoryEditor").Title("Equipment Category").Width(140);
                columns.ForeignKey(c => c.EquipmentTypeID, (System.Collections.IEnumerable)ViewData["EquipmentType"], "EquipmentTypeId", "EquipmentTypeName").Title("Equipment Type").EditorTemplateName("EquipmentTypeEditor").Title("Equipment Type").Width(120);
                columns.Bound(e => e.Description).Width(120);
                columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);
            })
              .ToolBar(commands => commands.Create())
              .Editable(editable =>
               {
                   editable.Mode(GridEditMode.InLine);
                   editable.DisplayDeleteConfirmation("Are You Sure To Remove CheckList!");
               }).HtmlAttributes(new { style = "height: 520px;" })
              .Pageable(pageable => pageable
              .Input(true)
              .Numeric(false)
              .Refresh(true)
              .PageSizes(true)
              .ButtonCount(5))
              .Scrollable()
              .Sortable()
              .Filterable()
              .Scrollable(h => h.Height(500))
              .ClientDetailTemplateId("template")
            .DataSource(dataSource => dataSource
                .Ajax()
                .Model(model =>
                {
                    model.Id(p => p.FleetCheckListId);
                    model.Field(p => p.Code).Editable(false);
                    model.Field(p => p.FleetCheckListId).Editable(false);
                }).Events(ev => ev
    .Error("error_handler(\"grid\")")
    .RequestStart("onRequestStart(\"grid\")")
    .RequestEnd("onRequestEnd(\"grid\")"))
    .Create(update => update.Action("FleetCheckLists_Create", "FleetChecklist").Data("sendForgery"))
    .Read(read => read.Action("FleetCheckLists_Read", "FleetChecklist").Data("sendForgery"))
    .Update(update => update.Action("FleetCheckLists_Update", "FleetChecklist").Data("sendForgery"))
    .Destroy(update => update.Action("FleetCheckLists_Destroy", "FleetChecklist").Data("sendForgery"))
          )
)
<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("tabStrip_#=FleetCheckListId#")
                  .SelectedIndex(0)
                  .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                  .Items(items =>
                  {
                      items.Add().Text("Check List").Content(@<text>
                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.EquipmentInspection.FleetLineCheckList>()
                                .Name("fleetlinechecklistgrid_#=FleetCheckListId#")
                           .Columns(columns =>
                           {
                                    columns.Bound(o => o.SystemName).Width(120);
                                    columns.Bound(o => o.CheckList).Width(120);

                                    columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);
                                })
                                .ToolBar(t => { t.Create(); })
                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .HtmlAttributes(new { style = "height: 520px;" })
                                .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
                                .Scrollable()
                                .Sortable()
                                .Filterable()
                                .Scrollable(h => h.Height(500))
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .PageSize(5)
                                .Model(model =>
                                     {
                                       model.Id(p => p.FleetLineCheckListId);
                                       model.Field(p => p.Code).Editable(false);
                                     })
                                .Events(ev => ev
                                .Error("error_handler(\"fleetlinechecklistgrid_#=FleetCheckListId#\")")
                                .RequestStart("onRequestStart(\"fleetlinechecklistgrid_#=FleetCheckListId#\")")
                                .RequestEnd("onRequestEnd(\"fleetlinechecklistgrid_#=FleetCheckListId#\")"))
                                .Create(create => create.Action("FleetLineCheckList_Create", "FleetLineCheckList", new { Id = "#=FleetCheckListId#" }).Data("sendForgery"))
                                .Read(read => read.Action("FleetLineCheckList_Read", "FleetLineCheckList", new { Id = "#=FleetCheckListId#" }).Data("sendForgery"))
                                .Update(update => update.Action("FleetLineCheckList_Update", "FleetLineCheckList").Data("sendForgery"))
                                .Destroy(destroy => destroy.Action("FleetLineCheckList_Destroy", "FleetLineCheckList").Data("sendForgery"))
                                )
                                          .ToClientTemplate())
                             </text>
                               );
                        })
                                      .ToClientTemplate())
</script>
<script>
    function filterEquipmentCategories() {
        var dropdownlist = $("#EquipmentIdentityID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;

        return {
            search: filterInput.val()
        };
    }

    function filterEquipmentTypes() {
        var dropdownlist = $("#EquipmentTypeID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            equipmentIdentityId: $("#EquipmentIdentityID").val(),
            search: filterInput.val()
        };

    }
</script>

