    function getSparePartData() {
        var grid = $("#grid").data("kendoGrid");
        var row = $(".k-detail-row:visible").prev();
        var dataItem = grid.dataItem(row);

        return {
            fleetId: dataItem.FleetsID,
            date: kendo.toString(dataItem.Date, "yyyy-MM-dd")
        };
    }

    function filterEquipmentType() {
    var dropdownlist = $("#EquipmentTypeId").data("kendoDropDownList");
    var filterInput = dropdownlist.filterInput;

