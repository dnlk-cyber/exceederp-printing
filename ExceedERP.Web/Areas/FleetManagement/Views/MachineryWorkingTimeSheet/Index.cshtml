
@{
    ViewBag.Title = "MachineryWorkingTimesheet";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isMIDROC = (ViewBag.setting as string) == "MIDROC";
    bool IsMCG = (ViewBag.setting as string) == "MCG";

}

<legend>Machinery Timesheet</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.MachineryWorkingTimeSheet>()
                            .Name("grid")
                            .Columns(columns =>
                            {

                                columns.Bound(c => c.MachineryWorkingTimeSheetId).Title("S.No").Width(50);
                                columns.ForeignKey(c => c.EquipmentCategoryId, (IEnumerable)ViewData["category"], "Value", "Text").Width(120);
                                columns.ForeignKey(c => c.EquipmentTypeId, (IEnumerable)ViewData["type"], "Value", "Text").Width(120);
                                columns.ForeignKey(c => c.EquipmentNameId, (IEnumerable)ViewData["name"], "Value", "Text").Width(120);
                                columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["fleet"], "Value", "Text").Title("Plate/Serial No").Width(100).Filterable(ftb => ftb.Multi(true).Search(true));
                                columns.ForeignKey(c => c.ProcurementSupplierID, (IEnumerable)ViewData["ProcurementSupplier"], "ProcurementSupplierID", "Name").Title("Supplier Name").Width(100);
                                columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branch"], "BranchId", "Name").Title("Branch Name").Width(100);
                                columns.Bound(c => c.Date).Width(100);
                                if (IsMCG)
                                {
                                    columns.Bound(c => c.ReasonForDown).Title("Reason For Down").Width(100);
                                    columns.Bound(c => c.ReasonForIdle).Title("Reason For Idle").Width(100);
                                    columns.Bound(c => c.MorningTimeStart).Title("Morning Time Start").Width(100);
                                    columns.Bound(c => c.MorningTimeEnd).Title("Morning Time End").Width(100);
                                    columns.Bound(c => c.AfternoonTimeStart).Title("Afternoon Time Start").Width(100);
                                    columns.Bound(c => c.AfternoonTimeEnd).Title("Afternoon Time End").Width(100);
                                    columns.Bound(c => c.NightTimeStart).Title("Night Time Start").Width(100);
                                    columns.Bound(c => c.NightTimeEnd).Title("Night Time End").Width(100);
                                    columns.Bound(c => c.TotalTime).Title("Total Time").Width(100);
                                }
                                if (!IsMCG)
                                { 
                                columns.Bound(c => c.NetHour).Title("Net Working HR").Width(120);
                            }
                            columns.Bound(c => c.OilConsumption).Title("Oil Consumption").Width(100);
    columns.Bound(c => c.DownHours).Title("Down Hour").Width(100);
    columns.Bound(c => c.DownHourRate).Title("Down Rate").Width(100);
    if (!IsMCG)
    {
        columns.Bound(c => c.DownReason).Title("Down Reason").Width(100);
        columns.Bound(c => c.IdleReason).Title("Idle Reason").Width(100);
    }
    columns.Bound(c => c.IdleHours).Title("Idle Hours").Width(100);
    if (isMIDROC == false)
    {
        columns.Bound(c => c.FuelConsumption).Title("Fuel consumption").Width(100);
    }
    if (IsMCG == true)
    {
        columns.Bound(c => c.FuelKMR).Title("Fuel KMR").Width(100);
        columns.Bound(c => c.InitialEHR).Title("Initial EHR").Width(100);
        columns.Bound(c => c.FinalEHR).Title("Final EHR").Width(100);
        columns.Bound(c => c.DifferenceEHR).Title("EHR Difference").Width(100);
    }
    if (isMIDROC == false)
    {
        columns.Bound(c => c.FuelType).Title("Fuel Type").Width(100);
        columns.Bound(c => c.GreaseConsumption).Title("Grease consumption").Width(100);
        columns.Bound(c => c.OilType).Title("Oil Type").Width(100);
    }
    columns.Bound(c => c.WorkType).Title("Worek type").Width(100);
    columns.ForeignKey(c => c.OperatorId, (IEnumerable)ViewData["operator"], "Value", "Text").Title("Operator Name").Width(100);
    columns.Bound(c => c.ExternalOperatorName).Title("External Operator").Width(100);
    // columns.Bound(c => c.GreaseRate).Title("Grease rate").Width(100);
    // columns.Bound(c => c.GreaseRate).Title("Grease rate").Width(100);
    columns.Bound(c => c.TimeSheetStatus).Width(150);
    columns.Bound(c => c.Remark).Title("Remark").Width(100);

    columns.Command(command => { command.Edit().UpdateText("Save").CancelText("Cancel").Text("Edit"); command.Destroy().Text("Delete"); }).Title("Action").Width(160);
    if (IsMCG || isMIDROC)
    {
        columns.Template(@<text></text>)
                                                        .ClientTemplate(
                                                        "# if (!TimeSheetSendForAproval&& !TimeSheetApproved) { #" +
                                                            "<input type='checkbox' class='approveCheckbox' />" +
                                                        "# } else { #" +
                                                            "<input type='checkbox' disabled='disabled' />" +
                                                        "# } #")
                                                        .Title("Request Approval")
                                                        .Width(60);
                                columns.Template(@<text></text>)
                                                        .ClientTemplate(
                                                        "# if (TimeSheetSendForAproval&& !TimeSheetApproved) { #" +
                                                            "<input type='checkbox' class='approveCheckbox' />" +
                                                        "# } else { #" +
                                                            "<input type='checkbox' disabled='disabled' />" +
                                                        "# } #")
                                                        .Title("Approve")
                                                        .Width(60);
                                columns.Template(@<text></text>)
                                                        .ClientTemplate(
                                                        "# if (TimeSheetSendForAproval&& TimeSheetApproved&&!CostSheetApproved) { #" +
                                                            "<input type='checkbox' class='approveCheckbox' />" +
                                                        "# } else { #" +
                                                            "<input type='checkbox' disabled='disabled' />" +
                                                        "# } #")
                                                        .Title("Reject")
                                                        .Width(60);
                                }
                            })
                                            .ToolBar(toolbar =>
                                            {
                                            toolbar.Template(@<text>
                                                    <!-- Always visible -->
                                                    <a class="k-button k-button-icontext k-grid-add" href="#">
                                                        <span class="k-icon k-i-plus"></span>
                                                        Add New Record
                                                    </a>
                                                    <!-- Conditional content -->
                                                    @if (isMIDROC||IsMCG)
                                                                {
                                                        <label style="margin-left:20px;">Branch:</label>
                                                        @(Html.Kendo().DropDownList()
                                                                                            .Name("branchDropdown")
                                                                                            .DataTextField("Text")
                                                                                            .DataValueField("Value")
                                                                                            .BindTo((IEnumerable<SelectListItem>)ViewData["branchh"])
                                                                                            .OptionLabel("Select Branch")
                                                                                            .HtmlAttributes(new { style = "width:200px;margin-right:10px;" })
                                                        )

                                                        <label style="margin-left:10px;">Date:</label>
                                                        @(Html.Kendo().DatePicker()
                                                                                            .Name("datePicker")
                                                                                            .Format("yyyy-MM-dd")
                                                                                            .Value(DateTime.Now)
                                                                                            .HtmlAttributes(new { style = "width:180px;margin-right:10px;" })
                                                        )

                                                        <button class="k-button k-primary" onclick="generateTimesheet()">
                                                            Auto Generate Timesheet
                                                        </button>
                                                        <button type="button"
                                                                class="k-button k-primary"
                                                                onclick="SendForApprovalSelected()">
                                                           Request Approval
                                                        </button><button type="button"
                                                                class="k-button k-primary"
                                                                onclick="ApproveSelected()">
                                                            Approve Selected
                                                        </button><button type="button"
                                                                class="k-button k-primary"
                                                                onclick="RejectSelected()">
                                                            Reject Selected
                                                        </button>
                                                                }
                                                    /**/
                                                    /**/
                                                    /**/

                                                </text>);
                                                    })
                                                                                .Editable(editable => editable.Mode(GridEditMode.PopUp)
                                                                                .TemplateName("MachineryTimesheetTemplate")
                                                                                .Window(win => win.Title("Machinery Timesheet").Width(820)))
                                                                                .Pageable()
                                                                                .Filterable()

                                                                                .Events(e => e.DataBound("dataBound"))
                                                                                .Events(e => e.DetailExpand("onDetailExpand"))
                                                                                .Scrollable(s => s.Height(550))
                                                                                .DataSource(dataSource => dataSource
                                                                                .Ajax()
                                                                                .Model(model => model.Id(p => p.MachineryWorkingTimeSheetId))
                                                                                .Events(ev => ev
                                                                                .Error("error_handler(\"grid\")")
                                                                                .RequestStart("onRequestStart(\"grid\")")
                                                                                .RequestEnd("onRequestEnd(\"grid\")"))
                                                                                .Read(read => read.Action("MachineryWorkingTimeSheets_Read", "MachineryWorkingTimeSheet").Data("sendForgery"))
                                                                                .Create(create => create.Action("MachineryWorkingTimeSheets_Create", "MachineryWorkingTimeSheet").Data("sendForgery"))
                                                                                .Update(update => update.Action("MachineryWorkingTimeSheets_Update", "MachineryWorkingTimeSheet").Data("sendForgery"))
                                                                                .Destroy(destroy => destroy.Action("InsuranceCompanies_Destroy", "MachineryWorkingTimeSheet").Data("sendForgery"))
                                                                                .Sort(e => e.Add(a => a.MachineryWorkingTimeSheetId).Descending())
                                                                                ).ClientDetailTemplateId("template")
)

