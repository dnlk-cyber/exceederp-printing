@using System.Collections
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Finance.AP
@using ExceedERP.Helpers
@model  ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.MachineryWorkingTimeSheet
@using ExceedERP.Helpers.Common
@Html.HiddenFor(model => model.MachineryWorkingTimeSheetId)
@using ExceedERP.DataAccess.Context
@{
    bool isMCG = (ViewBag.setting as string) == "MCG";
    bool IsMIDROC = (ViewBag.setting as string) == "MIDROC";
}
<div class="row">

    <div class="col-sm-2">
        <div class="form-group">
            <label>Plate No</label>
            <div>
                @(Html.Kendo().DropDownListFor(model => model.FleetsID)
                                          .ValuePrimitive(true)
                                          .OptionLabel("Select Equipment...")
                                          .DataTextField("PlateNumber")
                                          .DataValueField("FleetsID")
                                          .Filter("contains")
                                          .MinLength(2)
                                          //.CascadeFrom("EquipmentNameId")
                                          .Events(ev => ev.Change("onFleetChange"))
                                          .DataSource(dataSource =>
                                          {
                                              dataSource.Read(read => read.Action("GetFleetIdTimesheetNew", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery")
                                              .Data("handleFleetId"))
                                                  .ServerFiltering(true);
                                          }).HtmlAttributes(new { style = "width:100%" })
                )

            </div>
        </div>
    </div>
</div>
<div class="row">

    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.ProcurementSupplierID, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @(Html.Kendo().DropDownListFor(model => model.ProcurementSupplierID)
                                          .ValuePrimitive(true)
                                          .OptionLabel("Select Supplier...")
                                          .DataTextField("Name")
                                          .DataValueField("Id")
                                          .Filter("contains")
                                          .Events(e => e.Change("handleSupplierChange"))
                                          .DataSource(dataSource =>
                                          {
                                              dataSource.Read(read => read.Action("GetSuppliers", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery"))
                                              .ServerFiltering(false);
                                          }).Enable(false)
                )
            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.BranchId, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @(Html.Kendo().DropDownListFor(model => model.BranchId)
                                          .ValuePrimitive(true)
                                          .OptionLabel("Select Branch...")
                                          .DataTextField("Name")
                                          .DataValueField("Id")
                                          .Filter("contains")

                                          .DataSource(dataSource =>
                                          {
                                              dataSource.Read(read => read.Action("GetBranches", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery"))
                                              .ServerFiltering(false);
                                          })
                )
            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.BusinessUnitId, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @(Html.Kendo().DropDownListFor(model => model.BusinessUnitId)
                                          .ValuePrimitive(true)
                                          .OptionLabel("Select Business Unit...")
                                          .DataTextField("Name")
                                          .DataValueField("Id")
                                          .Filter("contains")

                                          .DataSource(dataSource =>
                                          {
                                              dataSource.Read(read => read.Action("GetBusinessUnits", "FleetManagementDataProvider", new { area = "FleetManagement" }).Data("sendForgery"))
                                              .ServerFiltering(false);
                                          })
                )
            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.Date, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().DatePickerFor(model => model.Date).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>

    </div>



</div>
<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.MorningTimeStart, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @*@Html.Kendo().TimePickerFor(model => model.MorningTimeStart).HtmlAttributes(new { style = "width:100%" })*@
                @(Html.Kendo().TimePickerFor(m => m.MorningTimeStart)
                              .Min(new DateTime(2000, 1, 1, 0, 0, 0))
                              .Max(new DateTime(2000, 1, 1, 6, 0, 0))
                              .Interval(30))
            </div>
        </div>


    </div>
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.MorningTimeEnd, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @*@Html.Kendo().TimePickerFor(model => model.MorningTimeEnd).HtmlAttributes(new { style = "width:100%" })*@
                @(Html.Kendo().TimePickerFor(m => m.MorningTimeEnd)
                              .Min(new DateTime(2000, 1, 1, 0, 0, 0))
                              .Max(new DateTime(2000, 1, 1, 6, 0, 0))
                              .Interval(30))
            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.AfternoonTimeStart, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @*@Html.Kendo().TimePickerFor(model => model.AfternoonTimeStart).HtmlAttributes(new { style = "width:100%" })*@
                @(Html.Kendo().TimePickerFor(m => m.AfternoonTimeStart)
                              .Min(new DateTime(2000, 1, 1, 6, 0, 0))
                              .Max(new DateTime(2000, 1, 1, 12, 0, 0))
                              .Interval(30))
            </div>
        </div>

    </div>
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.AfternoonTimeEnd, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @*@Html.Kendo().TimePickerFor(model => model.AfternoonTimeEnd).HtmlAttributes(new { style = "width:100%" })*@
                @(Html.Kendo().TimePickerFor(m => m.AfternoonTimeEnd)
                              .Min(new DateTime(2000, 1, 1, 6, 0, 0))
                              .Max(new DateTime(2000, 1, 1, 12, 0, 0))
                              .Interval(30))
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.NightTimeStart, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @*@Html.Kendo().TimePickerFor(model => model.NightTimeStart).HtmlAttributes(new { style = "width:100%" })*@
                @(Html.Kendo().TimePickerFor(m => m.NightTimeStart)
                              .Min(new DateTime(2000, 1, 1, 12, 0, 0))
                              .Max(new DateTime(2000, 1, 1, 23, 59, 0))
                              .Interval(30))
            </div>
        </div>
    </div><div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.NightTimeEnd, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @*@Html.Kendo().TimePickerFor(model => model.NightTimeEnd).HtmlAttributes(new { style = "width:100%" })*@
                @(Html.Kendo().TimePickerFor(m => m.NightTimeEnd)
                              .Min(new DateTime(2000, 1, 1, 12, 0, 0))
                              .Max(new DateTime(2000, 1, 1, 23, 59, 0))
                              .Interval(30))
            </div>
        </div>
    </div>
</div>

<div class="row">
    @if (IsMIDROC == false)
    {
        <div class="col-sm-2">
            <div class="form-group">
                @Html.LabelFor(model => model.GreaseConsumption, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
                <div>
                    @Html.Kendo().NumericTextBoxFor(model => model.GreaseConsumption).HtmlAttributes(new { style = "width:100%" })

                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                @Html.LabelFor(model => model.OilType, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
                <div>
                    @Html.Kendo().TextBoxFor(model => model.OilType).HtmlAttributes(new { style = "width:100%" })

                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                @Html.LabelFor(model => model.FuelConsumption, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
                <div>
                    @Html.Kendo().NumericTextBoxFor(model => model.FuelConsumption).HtmlAttributes(new { style = "width:100%" })

                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                @Html.LabelFor(model => model.FuelType, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
                <div>
                    @Html.Kendo().TextBoxFor(model => model.FuelType).HtmlAttributes(new { style = "width:100%" })

                </div>
            </div>
        </div>
    }
</div>

<div class="row">

    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.DownHours, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.DownHours).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>

    @if (isMCG == false)
    {
        <div class="col-sm-2">
            <div class="form-group">
                @Html.LabelFor(model => model.IdleReason, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
                <div>
                    @Html.Kendo().TextBoxFor(model => model.IdleReason).HtmlAttributes(new { style = "width:100%" })

                </div>
            </div>
        </div>
    }
    @if (isMCG == true)
    {
        <div class="col-sm-2">
            <div class="form-group">
                Reason For Idle
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.ReasonForIdle)
                                                            .DataValueField("Value")
                                                            .DataTextField("Text")
                                                            .Filter("Contains")
                                                            .OptionLabel("Select Reason")
                                                            .BindTo(ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.IdleReasonList))).ValuePrimitive(true))

                </div>
            </div>
        </div>
    }
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.WorkType, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().TextBoxFor(model => model.WorkType).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.IdleHours, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().NumericTextBoxFor(model => model.IdleHours).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
</div>
<div class="row">
    @if (isMCG == false)
    {
        <div class="col-sm-2">
            <div class="form-group">
                @Html.LabelFor(model => model.DownReason, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
                <div>
                    @Html.Kendo().TextBoxFor(model => model.DownReason).HtmlAttributes(new { style = "width:100%" })

                </div>
            </div>
        </div>
    }
    @if (isMCG == true)
    {
        <div class="col-sm-2">
            <div class="form-group">
                Reason For Down
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.ReasonForDown)
                                                                                    .DataValueField("Value")
                                                                                    .DataTextField("Text")
                                                                                    .Filter("Contains")
                                                                                    .OptionLabel("Select Reason")
                                                                                    .BindTo(ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.FleetManagement.FleetTimeSheet.DownReasonList))).ValuePrimitive(true))


                </div>
            </div>
        </div>
    }
    <div class="col-sm-2">
        <div class="form-group">
            @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
            <div>
                @Html.Kendo().TextBoxFor(model => model.Remark).HtmlAttributes(new { style = "width:100%" })

            </div>
        </div>
    </div>
    @if (IsMIDROC == false)
    {
        <div class="col-sm-2">
            <div class="form-group">
                @Html.LabelFor(model => model.OilConsumption, htmlAttributes: new { @class = "control-label col-md-8", style = "width:100%" })
                <div>
                    @Html.Kendo().TextBoxFor(model => model.OilConsumption).HtmlAttributes(new { style = "width:100%" })

                </div>
            </div>
        </div>
    }
    <div class="col-sm-2">
        <div id="internalOperatorDiv" class="col-sm-2">
            <div class="form-group">
                @Html.LabelFor(model => model.OperatorId, new { @class = "control-label col-md-8", style = "width:100%" })
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.OperatorId)
                                                     .ValuePrimitive(true)
                                                     .OptionLabel("Select Operator...")
                                                     .DataTextField("Text")
                                                     .DataValueField("Value")
                                                     .Filter("contains")
                                                     .DataSource(dataSource =>
                                                     {
                                                         dataSource.Read(read => read
                                                             .Action("Operators", "FleetManagementDataProvider", new { area = "FleetManagement" })
                                                             .Data("sendForgery")
                                                             .Data("filterOperator"))
                                                             .ServerFiltering(true);
                                                     })
                    )
                </div>
            </div>
        </div>
        <div id="externalOperatorDiv" class="col-sm-2" style="display:none;">
            <div class="form-group">
                @Html.LabelFor(m => m.ExternalOperatorName)
                <div>
                    @(Html.Kendo().TextBoxFor(m => m.ExternalOperatorName))
                </div>
            </div>
        </div>
    </div>
</div>
@if (isMCG)
{
    <div class="row">
        <div class="col-sm-2">
            <div class="form-group">
                Initial EHR
                <div>
                    @Html.Kendo().NumericTextBoxFor(m => m.InitialEHR);
                </div>
            </div>
        </div> <div class="col-sm-2">
            <div class="form-group">
                Final EHR
                <div>
                    @Html.Kendo().NumericTextBoxFor(m => m.FinalEHR);
                </div>
            </div>
        </div> <div class="col-sm-2">
            <div class="form-group">
                Fuel KMR
                <div>
                    @Html.Kendo().NumericTextBoxFor(m => m.FuelKMR);
                </div>
            </div>
        </div>
    </div>
}





