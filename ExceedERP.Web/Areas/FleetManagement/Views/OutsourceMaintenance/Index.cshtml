@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script>

    function SelectInventoryStore(e, JobOrderDetailID) {
        popup = window.open('/FleetManagement/ServiceCenter/InventoryStoreSelector?Id=' + JobOrderDetailID, 'WindowPopup', 'top=200, left=400, width=350, height=200, resizable=no,');
        popup.focus();
        return false;
    }

</script>

<legend>OutSource Maintenance</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FleetManagement.FleetMaintenance.JobOrder>()
        .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(e => e.Num).Width(120);
        columns.Bound(e => e.EquipmentName).Width(140);

        columns.Bound(e => e.ProjectName).Width(140);
        columns.Bound(e => e.MaintenanceCenter).Width(200);
        columns.Bound(e => e.Status).Width(200); ;


        columns.Command(command => { }).Width(250);

    })

             .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                                .Groupable()
                                .Scrollable(h => h.Height(500))
        .ClientDetailTemplateId("template")
      .Groupable().Events(ev => ev.DetailExpand("onDetailExpandUser"))
                      .DataSource(dataSource => dataSource
            .Ajax()
            .ServerOperation(false)
        .Sort(x => x.Add(s => s.JobOrderNum).Descending())
            .PageSize(6)
            .Model(model =>
                {
                    model.Id(p => p.JobOrderID);
                    model.Field(p => p.JobOrderID).Editable(false);
                }
                ).Events(ev => ev
                                                    .Error("error_handler(\"grid\")")
                                                    .RequestStart("onRequestStart(\"grid\")")
                                                    .RequestEnd("onRequestEnd(\"grid\")"))
                    .Create(update => update.Action("JobOrder_Create", "JobOrder"))
                                .Read(read => read.Action("OutSource_Read", "JobOrder"))
                    .Update(update => update.Action("JobOrder_Update", "JobOrder"))
                          .Destroy(update => update.Action("TransferJob", "ServiceCenter"))

        )
   .Events(events => events.DataBound("dataBound"))
)

