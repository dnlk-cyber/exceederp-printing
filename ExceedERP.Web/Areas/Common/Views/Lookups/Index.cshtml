    function sync_handler(e) {
        this.read();

    }

    function onUploadSuccess(e) {
        $("#Lookupgrid").data("kendoGrid").dataSource.read();
        $("#Lookupgrid").data("kendoGrid").refresh();
    }

    function checkFileType(e) {
        var files = e.files;

        $.each(files, function () {

            if (this.extension.toLowerCase() === ".xls" || this.extension.toLowerCase() === ".xlsx" || this.extension.toLowerCase() === ".xlsm") {

            } else {
                alert("Only .xls, .xlsx, .xlsm files can be uploaded!");
                e.preventDefault();
            }

        });
    }

    function DownLoadTemplate(e) {
        try {


            var wnd = $("#AttachmentWindow").data("kendoWindow");
            wnd.center().open();

        } catch (ex) {
            // alert("Please select the row!!");
        }

    }
</script>

@(Html.Kendo().Window().Name("AttachmentWindow")
    .Title(Resources.Templates)
    .Visible(false)
    .Modal(true)
      .Content(@<text>

        @(Html.Kendo().Grid<Attachment>()
                  .Name("AttachmentGrid")
          .Columns(columns =>
          {
              columns.Bound(c => c.Description).Width(200); //.Title("File Name").ClientTemplate((@Html.ActionLink("#=Description#", "DownloadFile", "DownloadDocument", new { filename = "#=Description#" }, null).ToHtmlString()));
              columns.Bound(c => c.FileType).ClientTemplate(Html.ActionLink("DownLoad", "DownloadTemplate", new { area = "HRM", filename = "#=Description#" }).ToHtmlString()).Width(200);

          })

              .Scrollable()
              .Selectable()
              .DataSource(dataSource => dataSource
                  .Ajax()
                       .Events(events => events.Error("error_handler(\"AttachmentGrid\")"))

                  .Model(model => model.Id(p => p.AttachmentId))
                                  .Read(read => read.Action("Attachments_Read", "Attachment", new { Area = "Common", attachmentReferenceType = "TEMPLATE", id = 0 }))


              )
        )

    </text>)
.Width( 500)

)

