           columns.Bound(c => c.LookupId).Title("#").Width(90);
          //columns.Bound(c => c.Category).EditorTemplateName("LookUpCategories").Width(150);
          //columns.Bound(c => c.Index);
          columns.Bound(c => c.LookupType).EditorTemplateName("LookUpTypes").Filterable(f=>f.Multi(true).Search(true)).Width(150);
          //  .ClientGroupHeaderTemplate("");
          columns.Bound(c => c.EvalutionType).Filterable(f => f.Multi(true).Search(true)).Width(150);
          columns.Bound(c => c.Description).Width(170);
          columns.Bound(c => c.DescriptionEng).Width(170);
          // columns.Bound(c => c.IsDefault).ClientTemplate("<input type='checkbox' disabled = 'true' \\#=IsDefault ? checked='checked' :'' \\# />").Width(100);
          //columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox' disabled = 'true' \\#=IsActive ? checked='checked' :'' \\# />").Width(100);
          columns.Bound(c => c.TaxTresholdAmount).Width(150);
          columns.Bound(c => c.Percentage).Width(120);
          columns.Bound(c => c.MainFunction).Width(120);
          columns.Bound(c => c.InformationOne).Width(120);
          columns.Bound(c => c.InformationTwo).Width(120);
          columns.Bound(c => c.Index).Width(100);
          columns.Bound(c => c.IsActive).ClientTemplate(
                                       "<input type='checkbox' disabled = 'true' value='#= IsActive#' " +
                                       "# if (IsActive) { #" +
                                       "checked='checked'" +
                                       "# } #" +
                                       "/>").Width(120);
          columns.Bound(c => c.Remark).Width(100);
