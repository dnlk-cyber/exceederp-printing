      })
      .ToolBar(toolbar =>
      {
          toolbar.Template(@<text>

    <div class="row">
        <div class="col-sm-6">
            <div style="display:inline;">
                @if (HttpContext.Current.User.IsInRole("HR_Admin"))
                {
                    @item.CreateButton(Resources.ActionButton_AddNewRecord)
                }
                @*@if (HttpContext.Current.User.IsInRole("HR_Admin"))
                {
                 @(Html.Kendo().Button()
                .Name("btnDownLoad")
               
                .HtmlAttributes(new { type = "button", @class = "k-primary" })
                .Events(e => e.Click("DownLoadTemplate"))
                .Content(Resources.DownloadTemplate))

                  @(Html.Kendo().Upload()
                 .Name("file")
                 .Async(a => a.Save("Lookup_Import", "Lookups"))
                 .Events(e => e.Complete("onUploadSuccess").Upload("checkFileType"))
                  //.ShowFileList(false).
                  // .HtmlAttributes(new { type = "button", @class = "k-primary" })
                    )
                }*@
            </div>
          
        </div>
        <div class="col-sm-4">
            @*@item.CustomCommandToolBarButton("Excel", "<span class='k-icon k-i-excel'></span>" + Resources.ActionButton_ExportExcel, "Excel_Export_Save", "Lookups", "", new { @class = "k-button k-button-icontext k-grid-excel btn btn-primary btn-xs pull-right" })*@
            @*@item.CustomCommandToolBarButton("PDF", "<span class='k-icon k-i-pdf'></span>" + Resources.ActionButton_ExportPDF, "Pdf_Export_Save", "Lookups", "", new { @class = "k-button k-button-icontext k-grid-pdf  btn btn-primary btn-xs pull-right" });*@
        </div>

        
    </div>
   

 </text>);


      })

          //Excel(excel => excel
          //         .FileName(Resources.NavigatorPlacment_EmployeePlacment + ".xlsx")
          //         .Filterable(true)
          //         .AllPages(true)
          //     //.ProxyURL(Url.Action("Excel_Export_Save", "EmployeePlacmentWithJ"))
          //     )

          //.Pdf(pdf => pdf
          //    .AllPages()
          //    .FileName(Resources.NavigatorPlacment_EmployeePlacment + ".pdf")
          //   // .ProxyURL(Url.Action("Pdf_Export_Save", "EmployeePlacmentWithJ"))
          //)
          .Editable(editable => editable.Mode(GridEditMode.InLine))//.TemplateName("Lookup").Window(window => { window.Title("Maintain Lookup"); window.Scrollable(false); }))
          .Scrollable(h => h.Height(500))
            .Sortable(sortable =>
            {
                sortable.SortMode(GridSortMode.SingleColumn);
            })
          .Filterable()
             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
        .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(srt=>srt.Add(x=>x.LookupId).Descending())
                   .Events(events => events.Error("error_handler(\"Lookupgrid\")"))
          .Group(groups => groups.Add(p => p.LookupType))
          .Model(model => {
              model.Id(p => p.LookupId);
              model.Field(p => p.LookupId).Editable(false);
              model.Field(p => p.IsActive).Editable(false);
          })
          .Read(read => read.Action("Lookups_Read", "Lookups").Data("sendForgery"))
          .Create(create => create.Action("Lookups_Create", "Lookups").Data("sendForgery"))
          .Update(update => update.Action("Lookups_Update", "Lookups").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("Lookups_Destroy", "Lookups").Data("sendForgery"))
      )
)
<style>
    div.k-edit-form-container {
        width: 700px;
    }
</style>

<script>
   
    function enableOrDisableActive(e)
    {

        var row = $(e.target).closest("tr");
        var grid = $("#Lookupgrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
        var id = dataItem.LookupId;
        if (id.length !== 0 )
        {

            $('#loading-image').show();
            $.ajax({
                url: '@Url.Action("EnableOrDisable", "Lookups",new { area= "Common" })',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                r = result;
                alert(r.Message);
                $('#loading-image').hide();
                grid.dataSource.read();
                }

            });


        }


    }

    function sync_handler(e) {
        this.read();

    }

    function onUploadSuccess(e) {
        $("#Lookupgrid").data("kendoGrid").dataSource.read();
        $("#Lookupgrid").data("kendoGrid").refresh();
    }

    function checkFileType(e) {
        var files = e.files;

        $.each(files, function () {

            if (this.extension.toLowerCase() === ".xls" || this.extension.toLowerCase() === ".xlsx" || this.extension.toLowerCase() === ".xlsm") {

            } else {
                alert("Only .xls, .xlsx, .xlsm files can be uploaded!");
                e.preventDefault();
            }

        });
    }

    function DownLoadTemplate(e) {
        try {


            var wnd = $("#AttachmentWindow").data("kendoWindow");
            wnd.center().open();

        } catch (ex) {
            // alert("Please select the row!!");
        }

    }
</script>

@(Html.Kendo().Window().Name("AttachmentWindow")
    .Title(Resources.Templates)
    .Visible(false)
    .Modal(true)
      .Content(@<text>

        @(Html.Kendo().Grid<Attachment>()
             .Name("AttachmentGrid")
             .Columns(columns =>
             {
                 columns.Bound(c => c.Description).Width(200); //.Title("File Name").ClientTemplate((@Html.ActionLink("#=Description#", "DownloadFile", "DownloadDocument", new { filename = "#=Description#" }, null).ToHtmlString()));
                 columns.Bound(c => c.FileType).ClientTemplate(Html.ActionLink("DownLoad", "DownloadTemplate", new { area = "HRM", filename = "#=Description#" }).ToHtmlString()).Width(200);


             })

              .Scrollable()
              .Selectable()
              .DataSource(dataSource => dataSource
                  .Ajax()
                       .Events(events => events.Error("error_handler(\"AttachmentGrid\")"))

                  .Model(model => model.Id(p => p.AttachmentId))
                  .Read(read => read.Action("Attachments_Read", "Attachment", new { Area = "Common", attachmentReferenceType = "TEMPLATE", id = 0 }).Data("sendForgery"))


              )
        )

    </text>)
.Width( 500)

)

