@using System.Collections
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Localization
<legend>@Resources.NavigatorMiscellaneous_Lookups</legend>
@(Html.Kendo().Grid<Lookup>()
      .Name("Lookupgrid")
      .Columns(columns =>
