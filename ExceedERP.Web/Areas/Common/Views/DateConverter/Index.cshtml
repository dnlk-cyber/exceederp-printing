<script>
          function ConvertToGergorian() {


              //var day = $("#day").val();
              //var month = $("#month").val();
              //var year = $("#year").val();

              var date = $("#EthiopianDate").val();
        $.ajax({
            url: '@Url.Action("ConvertToGergorian", "DateConvertor")',
            //contentType: "application/json; charset=utf-8",
            data: { date: date,},
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                $("#ConvertedGergorian").val(r);
            }

        });

    }
</script>

<script>
          function ConvertToEthiopian() {

              var date = $("#GergorianDate").val();

              $.ajax({
            url: '@Url.Action("ConvertToEthiopian", "DateConvertor")',
            //contentType: "application/json; charset=utf-8",
                  data: { date: date },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                $("#ConvertedEthiopian").val(r);
            }

        });

    }
</script>