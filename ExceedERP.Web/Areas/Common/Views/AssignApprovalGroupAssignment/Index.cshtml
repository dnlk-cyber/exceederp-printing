
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Common.DocumentApproval.AssignApprovalGroupAssignment>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.DocumentType);
        columns.Bound(c => c.From);
        columns.Bound(c => c.To);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.AssignApprovalGroupAssignmentId))
          .Read(read => read.Action("AssignApprovalGroupAssignments_Read", "AssignApprovalGroupAssignment"))
          .Create(create => create.Action("AssignApprovalGroupAssignments_Create", "AssignApprovalGroupAssignment"))
          .Update(update => update.Action("AssignApprovalGroupAssignments_Update", "AssignApprovalGroupAssignment"))
          .Destroy(destroy => destroy.Action("AssignApprovalGroupAssignments_Destroy", "AssignApprovalGroupAssignment"))
      )
)
