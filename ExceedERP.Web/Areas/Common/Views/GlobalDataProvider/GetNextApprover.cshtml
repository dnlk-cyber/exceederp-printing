@{
    Layout = "~/Views/Shared/_Popup.cshtml";
}

<div class="form">
    <div class="row fullrow">
        <input type="hidden" id="id" value=@ViewBag.id>
        <input type="hidden" id="type" value=@ViewBag.type>
        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.Label("Users", htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownList()
                                                  .Name("User")
                                                  .SelectedIndex(0)
                                                  .HtmlAttributes(new { style = "width:250px" })
                                                  .ValuePrimitive(true)
                                                  .DataTextField("FullName")
                                                  .DataValueField("UserName")
                                                  .Filter("contains")
                                                  .DataSource(dataSource =>
                                                  {
                                                      dataSource.Read(read => read.Action("GetNextApproverList", "GlobalDataProvider", new { id = ViewBag.id, type = ViewBag.type }))
                                                          .ServerFiltering(false);
                                                  })
                    )
                </div>
            </div>
            <div class="row"></div>

            <div class="col-md-offset-3 col-md-9">
                <button type="submit" class="saveBtn btn btn-primary" onclick="javascript:changeparent();"><i class="fa fa-suitcase"></i> Submit</button>
            </div>
        </div>
    </div>
</div>



<script language="javascript">

    var supplier ="";

    function changeparent() {
        
        if ((document.getElementById('User').value.length === 0)) {
            alert("Please select user.");
        }
        else {
            user = document.getElementById('User').value;
            id = document.getElementById('id').value;
            type = document.getElementById('type').value;
            $.ajax({
                type: "POST",
                url: '/Common/GlobalDataProvider/UpdateNextApprover',
                data: {
                    id: id,
                    type: type,
                    user :user
                },
                success: function (result) {
                   alert(result.Message);                 
                    var approverElement = window.opener.document.getElementById("new_user_name_display");
                    approverElement.innerText = " Sent to :"+user;
                    //window.opener.setChoice(user);
                    window.close();

                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
           
        }
    }
    function closeWin() {
        document.close();
    }


</script>

<style>
    .k-list-container ul li.k-item {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .k-list-container ul {
        overflow: hidden !important;
    }
</style>