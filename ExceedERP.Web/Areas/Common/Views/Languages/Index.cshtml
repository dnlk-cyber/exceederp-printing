@using System.Collections
@using ExceedERP.Core.Domain.Common.HRM
@using ExceedERP.Core.Localization
<legend>@Resources.NavigatorMiscellaneous_Language</legend>
@(Html.Kendo().Grid<Language>()
          .Name("Languagegrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.LanguageType).EditorTemplateName("Enum").Width(150);
        columns.Bound(c => c.Description).Width (150);
        columns.ForeignKey(c => c.CountryId, (System.Collections.IEnumerable)ViewData["CountryList"], "CountryId", "Name").EditorTemplateName("Countries").Width(150);
        //columns.Bound(c => c.Remark);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Scrollable(h => h.Height(500))
                             .Groupable()
                                      .Sortable(sortable =>
                                      {
                                          sortable.SortMode(GridSortMode.SingleColumn);
                                      })
                          .Filterable()
                             .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                       .Events(events => events.Error("error_handler(\"Languagegrid\")"))
          .Model(model => model.Id(p => p.LanguageId))
          .Read(read => read.Action("Languages_Read", "Languages"))
          .Create(create => create.Action("Languages_Create", "Languages"))
          .Update(update => update.Action("Languages_Update", "Languages"))
          .Destroy(destroy => destroy.Action("Languages_Destroy", "Languages"))
      )
)
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
</script>