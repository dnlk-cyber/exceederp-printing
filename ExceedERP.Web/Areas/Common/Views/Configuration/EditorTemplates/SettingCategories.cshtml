@using ExceedERP.Core.Domain.Common
@(Html.Kendo().DropDownListFor(m => m)
        .Name("Reference")
        .OptionLabel( "--Select Category--")
        .DataTextField("Text")
            .DataValueField("Text")
               .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetCategories", "Configuration");

                        })
                        .ServerFiltering(true);
                    })
)
