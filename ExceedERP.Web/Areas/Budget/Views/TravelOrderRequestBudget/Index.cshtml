@using System.Collections
@using ExceedERP.Core.Domain.Finance.AP.Travel
@using ExceedERP.Core.Domain.HRM.SelfCare
@using ExceedERP.Core.Localization
@using ExceedERP.Helpers.Common
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Travel Order Request</legend>
@(Html.Kendo().Grid<ApTravelOrder>()
          .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ApTravelOrderId).ClientTemplate("#=appendZeros(ApTravelOrderId)#").Width(100).Title("ID");
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(200).EditorTemplateName("EmployeeSelector").Filterable(ftb => ftb.Multi(true).Search(true));
          if (GlobalHelper.IsMultipleBusinessUnit())
          {
              columns.ForeignKey(c => c.FromBusinessUnitId, (IEnumerable)ViewData["BusinessUnits"], "BusinessUnitId", "Name").Width(180).EditorTemplateName("BusinessUnitSelector");
          }
          columns.ForeignKey(c => c.FromBranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").Width(180).EditorTemplateName("AllBranchSelector");
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["Structure"], "OrgStructureId", "Name").Title("Work Unit").Width(160).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(200);
          columns.Bound(c => c.PurposeOfTravel).Width(150);
          columns.Bound(c => c.RequestDate).Width(130);
          columns.Bound(c => c.TotalDuration).Width(120);
          columns.Bound(c => c.AdvanceAmount).Width(120);
          columns.Bound(c => c.TransportReference).Width(150);
          columns.Bound(c => c.Reference).Width(150);
          columns.Bound(c => c.Status).Width(90);
          //columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(190);
      })
      .ToolBar(toolbar =>
      {
          // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })

     .Editable(editable => editable.Mode(GridEditMode.InLine))//.TemplateName("ExpenseClaim"))//.Window(window => { window.Title(Resources.NavigatorTermination_TerminationRequest); window.Scrollable(false); }))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Events(ev => ev.DetailExpand("detailExpandMasterDepartment"))
      .Events(x => x.DataBound("onDataBoundMasterDepartment"))
      .Scrollable(h => h.Height(500))

                      .Sortable(sortable =>
                      {
                          sortable.SortMode(GridSortMode.SingleColumn);
                      })
          .Filterable()

             .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource

          .Ajax()
          .Sort(sort => sort.Add("ApTravelOrderId").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.ApTravelOrderId);

              model.Field(p => p.ApTravelOrderId).Editable(false);
              model.Field(p => p.TotalDuration).Editable(false);
              model.Field(p => p.AdvanceAmount).Editable(false);
              model.Field(p => p.Status).Editable(false);
              model.Field(p => p.Paid).Editable(false);
              model.Field(p => p.Claimed).Editable(false);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.BusinessUnitId).Editable(false);
              model.Field(p => p.OrgStructureId).Editable(false);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.FromBusinessUnitId).Editable(false);
              model.Field(p => p.FromBranchId).Editable(false);
              model.Field(p => p.CreatedAtBranchId).Editable(false);
              model.Field(p => p.CreatedAtBusinessUnitId).Editable(false);
              model.Field(p => p.CreatedAtOrgStructureId).Editable(false);
              model.Field(p => p.IsForOther).Editable(false);
              model.Field(p => p.VehicleDistributionID).Editable(false);
              model.Field(p => p.EpmSalary).Editable(false);
              model.Field(p => p.TotalPayable).Editable(false);
              model.Field(p => p.AmountClaimed).Editable(false);
              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.LastModified).Editable(false);
          })
            .Events(events =>
            {
                events.Error("error_handler(\"grid\")");
                events.RequestStart("onRequestStart(\"grid\")");
                events.RequestEnd("onRequestEnd(\"grid\")");
            })
                  .Read(read => read.Action("ApTravelOrderRequest_Read", "TravelOrderRequestBudget").Data("sendForgery"))
                  .Create(create => create.Action("ApTravelOrderRequest_Create", "TravelOrderRequestBudget").Data("sendForgery"))
                  .Update(update => update.Action("ApTravelOrderRequest_Update", "TravelOrderRequestBudget").Data("sendForgery"))

                  ).ClientDetailTemplateId("template")
)



