                        .Window(win => win.Title("Rental Payment Request").Width(800));
                    })
                    .Pageable()
                    .Filterable()
                    .Scrollable(s => s.Height(550))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Model(model => model.Id(p => p.RentalPaymentRequestId))
                        .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
                        .Read(read => read.Action("RentalPaymentRequests_Read", "BudgetRentalPaymentRequest").Data("sendForgery"))
                        .Create(create => create.Action("RentalPaymentRequests_Create", "BudgetRentalPaymentRequest").Data("sendForgery"))
                        .Update(update => update.Action("RentalPaymentRequests_Update", "BudgetRentalPaymentRequest").Data("sendForgery"))
                        .Destroy(destroy => destroy.Action("RentalPaymentRequests_Destroy", "BudgetRentalPaymentRequest").Data("sendForgery"))
                    )
                    .ClientDetailTemplateId("rentalPaymentRequestDetailTemplate")
)
