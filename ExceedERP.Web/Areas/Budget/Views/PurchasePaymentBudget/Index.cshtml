@using ExceedERP.Core.Domain.Procurement.PaymentRequest
@using ExceedERP.Web.Areas.Procurement.Models
@using ExceedERP.Helpers.Finance

<legend>Purchase Payment Request (Budget)</legend>

@(Html.Kendo().Grid<PurchasePayment>()
                              .Name("grid")
                              .Columns(columns =>
                              {
                                  columns.Bound(c => c.PurchasePaymentId).Title("Payment No.").Width(120).ClientTemplate("#=appendZeros(PurchasePaymentId)#");
                                  columns.Bound(p => p.Date).Width(130);
                                  columns.Bound(c => c.SupplierId).Width(100).EditorTemplateName("SupplierSelector");
                                  columns.Bound(c => c.SupplierName).Width(120);
                                  columns.Bound(p => p.SupplierInvoice).Width(130);
                                  columns.ForeignKey(p => p.ProcurementOfficer, (IEnumerable)ViewData["Purchasers"], "EmployeeId", "FullNameEnglish").Width(130).Filterable(ftb => ftb.Multi(true).Search(true));
                                  //columns.Bound(c => c.WithOutGRN).Width(110).ClientTemplate("<input type='checkbox' disabled = 'true' #= WithOutGRN ? checked='checked' :'' # />");
                                  columns.Bound(c => c.Type).Width(110);
                                  //columns.Bound(c => c.PoOrContractNumber).Width(80).Title("Ref.");
                                  columns.Bound(o => o.PoOrContractNumber).Width(80).Title("Ref.").ClientTemplate(
                                    "# if (PoOrContractNumber) { #" +
                                    @Html.ActionLink("#=PoOrContractNumber#", "PurchaseOrderPrint", "ProcurementPrint", new { area = "Procurement", Id = "#=PoOrContractNumber#" }, new { @class = "detail-link", @target = "_blank" }).ToHtmlString()
                                    + "# } #"
                                    );
                                  columns.Bound(c => c.PaymentType).Width(110);
                                  columns.Bound(c => c.PurchasePaymentType).Width(130);
                                  columns.Bound(p => p.PaymentAmount).Width(130);
                                  columns.Bound(p => p.PenalityAmount).Width(130);
                                  columns.Bound(c => c.ApplyPenality).Width(90).ClientTemplate("<input type='checkbox' disabled = 'true' #= ApplyPenality ? checked='checked' :'' # />");
                                  columns.Bound(p => p.ServiceCharge).Width(130);
                                  columns.Bound(p => p.OtherPayment).Width(130);
                                  columns.Bound(p => p.NetPayable).Width(130);
                                  columns.Bound(p => p.AmountDue).Width(130);
                                  columns.Bound(c => c.Paid).Width(80).ClientTemplate("<input type='checkbox' disabled = 'true' #= Paid ? checked='checked' :'' # />");
                                  columns.ForeignKey(p => p.ForBranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").Width(130);
                                  columns.Bound(p => p.Remark).Width(150);
                                  columns.Bound(p => p.Status).Width(150);
                                  columns.Command(command =>
                                  {
                                      //command.Edit();
                                      //command.Destroy();
                                  }).Width(180);
                              })
                              .ToolBar(toolbar =>
                              {
                                  // toolbar.Create();
                              })
                              .Editable(editable => editable.Mode(GridEditMode.InLine))

                              .Scrollable()
                              .Sortable()
                              .Filterable()

                               .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                              .Events(ev => ev.DetailExpand("detailExpandMasterNew"))
                              .Scrollable(h => h.Height(500))
                              .Events(x => x.DataBound("onDataBoundMasterNew"))
                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .Sort(sort => sort.Add("PurchasePaymentId").Descending())
                                  .Model(
                                      model =>
                                      {
                                          model.Id(p => p.PurchasePaymentId);
                                          model.Field(p => p.PurchasePaymentId).Editable(false);
                                         // model.Field(p => p.WithholdingType).Editable(false);
                                          //model.Field(p => p.WithholdingAmount).Editable(false);
                                          model.Field(p => p.ForBranchId).Editable(false);
                                          model.Field(p => p.BranchId).Editable(false);
                                          model.Field(p => p.BusinessUnitId).Editable(false);
                                          model.Field(p => p.Paid).Editable(false);
                                          model.Field(p => p.TenderRef).Editable(false);
                                          model.Field(p => p.ProformaRef).Editable(false);
                                          model.Field(p => p.NetPayable).Editable(false);
                                          model.Field(p => p.AmountDue).Editable(false);

                                          model.Field(p => p.BudgetApprovedBy).Editable(false);
                                          model.Field(p => p.IsBudgetApproved).Editable(false);
                                          model.Field(p => p.BudgetApprovedTime).Editable(false);

                                          model.Field(p => p.AuthorizedBy).Editable(false);
                                          model.Field(p => p.IsAuthorized).Editable(false);
                                          model.Field(p => p.AuthorizedTime).Editable(false);

                                          model.Field(p => p.OrgBranchName).Editable(false);
                                          model.Field(p => p.CreatedBy).Editable(false);
                                          model.Field(p => p.ModifiedBy).Editable(false);
                                          model.Field(p => p.LastModified).Editable(false);
                                          model.Field(p => p.DateCreated).Editable(false);
                                          model.Field(p => p.Status).Editable(false);

                                      })

                                  .Events(ev => ev
                                     .Error("error_handler(\"grid\")")
                              .RequestStart("onRequestStart(\"grid\")")
                              .RequestEnd("onRequestEnd(\"grid\")"))
                                  .Read(read => read.Action("PurchasePayments_Read", "PurchasePaymentBudget").Data("sendForgery"))
                                  .Create(create => create.Action("PurchasePayments_Create", "PurchasePaymentBudget").Data("sendForgery"))
                                  .Update(update => update.Action("PurchasePayments_Update", "PurchasePaymentBudget").Data("sendForgery"))
                                  .Destroy(destroy => destroy.Action("PurchasePayments_Destroy", "PurchasePaymentBudget").Data("sendForgery"))
                              ).ClientDetailTemplateId("template")
                              )



