    function applyPenalty(obj) {

        if ($(obj).is(":checked")) {
            var amount = $("#PaymentAmount").val();
            var penalty = $("#PenalityAmount").val();
            var net = amount - penalty;
            $("#NetPayable").val(net).trigger("change");

        } else {
            var amount = $("#PaymentAmount").val();
            $("#NetPayable").val(amount).trigger("change");
        }

    }


