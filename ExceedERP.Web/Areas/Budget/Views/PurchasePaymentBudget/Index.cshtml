@helper PurchasePaymentFileUpload()
{
    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Procurement.PaymentRequest.PurchasePaymentAttachment>()
                  .Name("Purchasedocument_#=PurchasePaymentId#")
                  .Columns(columns =>
                  {
                      columns.Bound(c => c.FileName).ClientTemplate("<a href='/PurchasePaymentDocument/FileDwonload?id=\\#=PurchasePaymentAttachmentId \\#'>\\#=FileName \\#</a>").Width(200);
                      columns.Command(command => {
                          //command.Edit();
                          //command.Destroy();
                      }).Width(580);
                  })


                            .Editable(editable => editable.Mode(GridEditMode.InLine))
                            .HtmlAttributes(new { style = "height: 350px;" })
                            .Scrollable()
                            .Events(x => x.DataBound("onDataBoundFisrtValidation"))
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Events(ev => ev
                                    .Error("error_handler(\"Purchasedocument_#=PurchasePaymentId#\")")
                                    .RequestStart("onRequestStart(\"Purchasedocument_#=PurchasePaymentId#\")")
                                    .RequestEnd("onRequestEnd(\"Purchasedocument_#=PurchasePaymentId#\")"))
                                .Model(model => model.Id(p => p.PurchasePaymentAttachmentId))
                                .Read(read => read.Action("PurchasePaymentAttachments_Read", "PurchasePaymentDocumentBudget", new { id = "#= PurchasePaymentId #" }).Data("sendForgery"))
                                .Create(create => create.Action("PurchasePaymentAttachments_Create", "PurchasePaymentDocumentBudget", new { id = "#=PurchasePaymentId #" }).Data("sendForgery"))
                                .Update(update => update.Action("PurchasePaymentAttachments_Update", "PurchasePaymentDocumentBudget").Data("sendForgery"))
                                .Destroy(destroy => destroy.Action("PurchasePaymentAttachments_Destroy", "PurchasePaymentDocumentBudget").Data("sendForgery"))
                            ).ToClientTemplate())
}


<script>

     function voidRecord(id) {
 var recordStatus = "";
 var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
 if (conf === true) {
     $.ajax({
         type: "POST",
         url: '@Url.Action("Void", "PurchasePaymentBudget", new {area = "Budget"})',
     data: { id: id },
     success: function (result) {
         // toastr.warnning(result.Message);
         alert(result.Message);
         recordStatus = result.Status;
         location.reload(true);
     }, //end succ
     error: function (result) {
         alert(result);
     }
 });
}
 }
    function sendForBudgetApproval(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to approve this Payment number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("ApproveBudget", "PurchasePaymentBudget", new { area = "Budget" })',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }






    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    var isapproved;
    var issecondapproved;
    var isSendForApproval;
    var isOnlineTransferred;
    var nextApprover;
    var isFinanceApproved;
    var isAuthorized;
    var isBudgetApproved;

    function detailExpandMasterNew(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.PurchasePaymentId;
        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;
        nextApprover = masterDataItem.ForwardedTo;
        isAuthorized = masterDataItem.IsAuthorized;
        isFinanceApproved = masterDataItem.IsFinanceApproved;
        isBudgetApproved = masterDataItem.IsBudgetApproved;

    }
    function onDataBoundMasterNew(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved || gridData[i].IsSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsOnlineApproved && !dataItem.IsBudgetApproved) {
                row.css("background-color", "lightgreen");
            }

            if (dataItem.IsAuthorized) {
                row.css("background-color", "blue");
            }

            if (dataItem.IsBudgetApproved) {
                row.css("background-color", "gold");
            }

            if (dataItem.Paid) {
                row.css("background-color", "honeydew");
            }

            if (dataItem.IsVoid) {
                row.css("background-color", "slategray");
                row.css("color", "black");
            }
        }


    }
    function onDataBoundLineNew(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionItem_" + codeid;
        if (isapproved || isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundValidationNew(e) {
        var currentUser=@Html.Raw(Json.Encode(User.Identity.Name));


        var detailGrid = "#" + e.sender.element[0].id;

        if (isapproved || !isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        if (nextApprover !== currentUser) {
            $(".k-grid-add", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }

    function onDataBoundValidationBudget(e) {


        var detailGrid = "#" + e.sender.element[0].id;

        if (isBudgetApproved || !isapproved) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }



        this.table.find(".k-grid-edit").hide();
    }

    function onDataBoundAuthorization(e) {


        var detailGrid = "#" + e.sender.element[0].id;

        if (isAuthorized || !isFinanceApproved) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }



        this.table.find(".k-grid-edit").hide();
    }


