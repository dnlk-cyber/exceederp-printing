 
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.Budget.Task.TaskPerformance

<form>

    <div class="row col-md-12">

        <div class="col-md-2" style="padding-left:30px;">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.BudgetCategoryID)
                </div>
                <div>
                 @(Html.Kendo().DropDownListFor(model => model.BudgetCategoryID).HtmlAttributes(new { @class = "form-control" })
                                    .DataTextField("Text")
                                                        .DataValueField("Value").OptionLabel("Select ").Filter(FilterType.Contains)
                                                    .DataSource(d => d.Read(r => r.Action("TaskCategoryDDBind", "BudgetDataProvider").Data("sendForgery")).ServerFiltering(false)))

                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.GlFiscalYearId)
                </div>
                <div>
                 @(Html.Kendo().DropDownListFor(model => model.GlFiscalYearId).HtmlAttributes(new { @class = "form-control", @required = "required" })
                                    .DataTextField("Name").Filter(FilterType.Contains)
                                                    .DataValueField("GlFiscalYearId").OptionLabel("Select")
                                                        .DataSource(d => d.Read(r => r.Action("YearDDBind", "BudgetDataProvider").Data("sendForgery")).ServerFiltering(false)).ValuePrimitive(true))

                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.GLChartOfAccountCostCenterId)
                </div>
                <div>
                  @(Html.Kendo().DropDownListFor(model => model).HtmlAttributes(new { @class = "form-control" }).Name("GLChartOfAccountCostCenterId")
                                        .DataTextField("Text").Filter(FilterType.Contains)
                                                .DataValueField("Value").OptionLabel("Select")
                                                    .DataSource(d => d.Read(r => r.Action("WorkUnitDDBind", "BudgetDataProvider").Data("sendForgery")).ServerFiltering(false)))


                </div>
            </div>
        </div>
      
        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.GLPeriodId)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.GLPeriodId).HtmlAttributes(new { @class = "form-control", @required = "required" })
                                    .DataTextField("Text")
                                                        .DataValueField("Value").OptionLabel("Select ").Filter(FilterType.Contains)
                                                                    .DataSource(d => d.Read(r => r.Action("MonthDDBind", "BudgetDataProvider").Data("sendForgery")).ServerFiltering(false)))

                </div>
            </div>
        </div>


          <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.TaskPlanId)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.OrgBranchName).HtmlAttributes(new { @class = "form-control" })//.Name("TaskPlanId")
                            .DataTextField("Text")
                                        .DataValueField("Value").OptionLabel(" Select ").Filter(FilterType.Contains)
                    .HtmlAttributes(new { style = "width:100%" })
                    .DataSource(d =>
                    {
                        d.Read(r =>
                        {
                            r.Action("TaskPlanDDBind", "BudgetDataProvider").Data("filterPlan");
                        })
                      .ServerFiltering(false);
                    })
                       .AutoBind(false)
                           .CascadeFrom("GLChartOfAccountCostCenterId"))



                </div>
            </div>
        </div>

    </div>

    <div class="row">
        <div class="col-md-1">
        </div>

         <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Remark)
                </div>
                <div>

                    @(Html.Kendo().TextBoxFor(model => model.Remark)
                       
                    )
                  
                </div>
            </div>
        </div>
 
    </div>

    

   
</form>