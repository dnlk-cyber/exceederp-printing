                                                  model.Field(p => p.OnlineApprovedBy).Editable(false);
                                                  model.Field(p => p.OnlineApprovedTime).Editable(false);

                                                  model.Field(p => p.IsOpenforrevision).Editable(false);

                                                  model.Field(p => p.IsRevisionSendForApproval).Editable(false);
                                                  model.Field(p => p.RevisionSendForApprovalBy).Editable(false);
                                                  model.Field(p => p.RevisionSendForApprovalTime).Editable(false);
                                                  model.Field(p => p.IsRevisionOnlineApproved).Editable(false);
