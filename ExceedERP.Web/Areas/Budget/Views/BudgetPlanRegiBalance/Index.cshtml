                                                                    .RequestStart("onRequestStart(\"grid\")")
                                                                    .RequestEnd("onRequestEnd(\"grid\")"))
                                              .Read(read => read.Action("BudgetPlanRegistration_Read", "BudgetPlanRegiBalance").Data("sendForgery"))
                                              .Create(create => create.Action("BudgetPlanRegistration_Create", "BudgetPlanRegiBalance").Data("sendForgery"))
                                              .Update(update => update.Action("BudgetPlanRegistration_Update", "BudgetPlanRegiBalance").Data("sendForgery"))
                                              .Destroy(destroy => destroy.Action("BudgetPlanRegistration_Destroy", "BudgetPlanRegiBalance").Data("sendForgery"))
