<script>
    var masterId;
    var Isapproved;
    var BudgetCategory;
    function filterCategory() {
        return {
            Group: $("#CategoryName").val()
        };
    }
    function filterAccCode() {
        return {
            PlanCategoryID: masterId,
        };
    }
    function SelectBudgetAccCode(e, BudgetCategory) {
        // BudgetCategory = BudgetCategory;
        console.log("budget category " + BudgetCategory);
        accountCodeTextBox = $(e).prev('input').attr('id');
        popup = window.open('/Budget/BudgetPlanRegistration/GLAccountSelector?Category=' + BudgetCategory, 'WindowPopup', 'top=100, left=400, width=650, height=320, resizable=no,');
        popup.focus();
        return false;
    }

    function filterWorkUnit() {
        return {
            PlanCategoryID: $("#Name").val(),

            AccCode: $("#AccountCode").val()
        };
    }


    function onUploadError(e) {

        var response = jQuery.parseJSON(e.XMLHttpRequest.responseText);
        alert(response.data);
    }

    function ExcelExportEvent(e) {
        e.sender.hideColumn("0");

        //     e.sender.hideColumn("ReportStartDateTime");
    }

    function getBudgetCategoryId() {
        return {
            catId: masterId,
            text: $("#BudgetItem").data("kendoDropDownList").filterInput.val()
        };
    }




</script>



<script type="text/javascript">


    function onUploadSuccess(e) {
        $("#gridCategory").data("kendoGrid").dataSource.read();
        $("#gridCategory").data("kendoGrid").refresh();


    }

    function checkFileType(e) {
        var files = e.files;

        $.each(files, function () {

            if (this.extension.toLowerCase() === ".xls" || this.extension.toLowerCase() === ".xlsx" || this.extension.toLowerCase() === ".xlsm") {

            } else {
                alert("Only .xls, .xlsx, .xlsm files can be uploaded!");
                e.preventDefault();
            }

        });
    }

     function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "BudgetPlanRegiBalance", new { area = "Budget" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

</script>