@(Html.Kendo().DropDownListFor(model => model)
    .HtmlAttributes(new { @class = "form-control" ,@required ="required" })
    .DataTextField("Name")
    .DataValueField("Code")
    .OptionLabel("Select ")
    .Filter("Contains")
    .Filter(FilterType.Contains)
    .DataSource(d => d.Read(r => r.Action("CategoryDDBind", "BudgetDataProvider").Data("sendForgery")).ServerFiltering(false)))