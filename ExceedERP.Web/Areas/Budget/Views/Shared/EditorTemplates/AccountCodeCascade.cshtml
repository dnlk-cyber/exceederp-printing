
@(Html.Kendo().DropDownListFor(model => model).HtmlAttributes(new { @class = "form-control", @required = "required" })
                            .DataTextField("Text")
                                    .DataValueField("Text").OptionLabel(" Select ")
                    .HtmlAttributes(new { style = "width:100%" })
                    .DataSource(d =>
                    {
                        d.Read(r =>
                        {
                            r.Action("AccCodeByGroupYear", "BudgetDataProvider").Data("filterAccCode");
                        })
                      .ServerFiltering(true);
                    })
                   .AutoBind(false)
                           .CascadeFrom("BudgetYear"))