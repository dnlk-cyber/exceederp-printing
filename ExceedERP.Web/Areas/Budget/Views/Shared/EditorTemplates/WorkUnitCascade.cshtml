@(Html.Kendo().DropDownListFor(model => model).HtmlAttributes(new { @class = "form-control" , @required = "required"})
                        .DataTextField("Text")
                                    .DataValueField("Value").OptionLabel(" Select ").Filter(FilterType.Contains)
                    .HtmlAttributes(new { style = "width:100%" })
                    .DataSource(d =>
                    {
                        d.Read(r =>
                        {
                            r.Action("WorkUnitDDBind", "BudgetDataProvider").Data("filterWorkUnit");
                        })
                      .ServerFiltering(true);
                    })
                       .AutoBind(false) 
                               .CascadeFrom("FromAccountCode"))