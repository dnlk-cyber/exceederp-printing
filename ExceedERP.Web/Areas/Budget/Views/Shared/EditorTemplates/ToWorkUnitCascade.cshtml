@(Html.Kendo().DropDownListFor(model => model).HtmlAttributes(new { @class = "form-control" })
                        .DataTextField("Text")
                                    .DataValueField("Value").OptionLabel(" Select ").Filter(FilterType.Contains)
                    .HtmlAttributes(new { style = "width:100%" })
                    .DataSource(d =>
                    {
                        d.Read(r =>
                        {
                            r.Action("BudgetToWorkUnit", "BudgetDataProvider").Data("filterToWorkUnit");
                        })
                      .ServerFiltering(false);
                    })
                       .AutoBind(false) 
                                   .CascadeFrom("FromWorkUnit"))