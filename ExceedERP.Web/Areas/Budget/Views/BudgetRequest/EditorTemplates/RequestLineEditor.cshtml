@model  ExceedERP.Core.Domain.Budget.BudgetRequestLine




<div class="demo-section k-content">
    <form>

        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.BudgetRequestType)

                    </div>
                    <div>
                        @(Html.Kendo().DropDownListFor(model => model.BudgetRequestType).Name("BudgetRequestType")
                                                                                                      .DataTextField("Text")
                                                .DataValueField("Value").OptionLabel(" Select ").Events(x => x.Change("BindDetail").DataBound("BindDetail"))
.BindTo(EnumHelper.GetSelectList(typeof(ExceedERP.Core.Domain.Budget.BudgetRequestType))))

                    </div>

                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.AccountCode)

                    </div>
                    <div>
                        <input   data-val="true" data-val-required="The AccountCode field is required." disabled="  disabled" id="AccountCode" name="AccountCode" data-bind="value:AccountCode">
  <img src="~/Content/Images/search.png" onclick="SelectAccCode(this)" />


                    </div>

                </div>
            </div>


            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.Remark)
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.Remark)
                        @Html.ValidationMessageFor(model => model.Remark)
                    </div>

                </div>
            </div>



        </div>

