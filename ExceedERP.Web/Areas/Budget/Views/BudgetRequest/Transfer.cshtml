<script>



    function LineOnDatabound(e) {

        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);

            if (dataItem.Accepted) {
                row.addClass("k-state-Issued");
              }


        }
    }
    function AcceptRequests(e, buttonName, grid) {
        var items = {};
        var GridId = "#" + grid;
        var BtnId = "#" + buttonName;
        var count = 0;
        var grid = $(GridId).data("kendoGrid");
        $(GridId).find("input:checked").each(function () {

            var item = grid.dataItem($(this).closest('tr'));
            items['model.BudgetRequestLine[' + count + '].BudgetRequestLineId'] = item.BudgetRequestLineId;
            items['model.BudgetRequestLine[' + count + '].Accepted'] = true;
            count++;
        });

        var button = $(BtnId).data("kendoButton");
        //  button.enable(false);
        $.ajax({
            type: "POST",
            data: items,
            url: '@Url.Action("BudgetRequest_BatchUpdate", "BudgetRequestLine")',
            success: function (result) {
                alert(result);
            }
        });


    }

    var IsOnlineApproved;
    var IsOnlineTransferred;
    var IsSecondSendForApproval;
    var IsSecondOnlineApproved;
    function approveonDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();

        grid.tbody.find("tr[role='row']").each(function () {
