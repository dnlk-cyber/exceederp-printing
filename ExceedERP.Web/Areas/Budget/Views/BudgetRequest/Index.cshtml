@model ExceedERP.Core.Domain.Budget.BudgetRequest


<script>
    var masterId;
    function filterCategory() {
        return {
            Group: $("#BudgetGroup").val()
        };
    }
    function filterAccCode() {
        return {
            PlanCategoryID: $("#PlanCategoryId").val(),
        };
    }
    function filterWorkUnit() {
        return {
            PlanCategoryID: $("#PlanCategoryId").val(),

            AccCode: $("#AccountCode").val()
        };
    }

</script>

<legend>     Budget Request </legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Budget.BudgetRequest>()
                                  .Name("grid")
      .Columns(columns =>
      {

          columns.Bound(c => c.BudgetRequestID).Title(" No.").Width(80);
          columns.Bound(c => c.PlanCategoryId).EditorTemplateName("RequestCategoryEditor").Width(120);
          columns.ForeignKey(c => c.BranchId, (System.Collections.IEnumerable)ViewData["Branches"], "BranchID", "Name").EditorTemplateName("BranchEditor").Width(120);
          columns.Bound(c => c.BudgetYear).Width(100);
          columns.ForeignKey(c => c.WorkUnit, (System.Collections.IEnumerable)ViewData["MainCompanyStructures"], "Values", "Description").EditorTemplateName("WorkUnitEditor").Width(120);
          columns.Bound(c => c.FromDate).Title("From Date").EditorTemplateName("DateEditor").Width(120);
          columns.Bound(c => c.ToDate).Title("To Date").EditorTemplateName("DateEditor").Width(120);

          columns.Bound(c => c.Amount).Width(120);
        //  columns.Bound(c => c.Reason).Width(160);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })      .Events(ev =>
                                                                                                 {
                                                                                                     ev.DataBound("onDataBound"); ev.DetailExpand("onDetailExpandUser");
                                                                                                 })

      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
                               .Sortable()
                            .Filterable()
                             .Scrollable(h => h.Height(500))
                     .ClientDetailTemplateId("template")
        //  .Events(ev => ev.DetailExpand("onDetailExpandUser"))
           .DataSource(dataSource => dataSource
              .Ajax().Sort(x => x.Add("BudgetRequestID").Descending())
                  .Model(model =>
                  {
                      model.Id(p => p.BudgetRequestID);
                      model.Field(p => p.BudgetRequestID).Editable(false);
                      model.Field(p => p.BudgetYear).Editable(false);
                      model.Field(p => p.Amount).Editable(false);
                  }).Events(ev => ev
                                                    .Error("error_handler(\"grid\")")
                                                    .RequestStart("onRequestStart(\"grid\")")
                                                    .RequestEnd("onRequestEnd(\"grid\")"))
              .Read(read => read.Action("BudgetRequest_Read", "BudgetRequest"))
              .Create(create => create.Action("BudgetRequest_Create", "BudgetRequest"))
              .Update(update => update.Action("BudgetRequest_Update", "BudgetRequest"))
              .Destroy(destroy => destroy.Action("BudgetRequest_Destroy", "BudgetRequest"))
                    )
)




