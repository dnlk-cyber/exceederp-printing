<script>



    var IsOnlineApproved;
    var IsSendForApproval;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

      
        masterId = masterDataItem.BudgetRequestID;
        BudgetCategory = masterDataItem.Name;
        IsSendForApproval = masterDataItem.IsSendForApproval;
        IsOnlineApproved = masterDataItem.IsOnlineApproved;
     
        var LineGrid = "#BudgetLine_" + masterId;
        if (IsSendForApproval == true) {
            $(LineGrid).find(".k-toolbar").hide(); //hide toolbar
            $(".k-grid-top", LineGrid).hide();
            $(".k-grid-edit", LineGrid).hide();
            $(".k-grid-delete", LineGrid).hide();
        }

    }

     


     function approveonDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
           
            if (IsOnlineApproved == true || IsSendForApproval == true) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }
    function toapproveonDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);

            if (IsOnlineApproved == true  ) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }
    function  onDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.IsOnlineApproved == true || dataItem.IsSendForApproval == true) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

    function BindDetail() {
        var RequestType = $("#BudgetRequestType").data("kendoDropDownList").value();
        if (RequestType == 0) {
            $("#Purchase").show();
            $("#DailyLabour").hide();
            $("#Labour").hide();
            $("#Rent").hide();
            $("#OutSourceService").hide();
        }
        if (RequestType == 1) {
            $("#Rent").show();
            $("#Purchase").hide();
            $("#DailyLabour").hide();
            $("#Labour").hide();
            $("#OutSourceService").hide();

        }
        if (RequestType == 2) {
            $("#Purchase").show();
            $("#DailyLabour").hide();
            $("#Labour").hide();
            $("#Rent").hide();
            $("#OutSourceService").hide();
        }

        if (RequestType == 3) {
            $("#OutSourceService").hide();
            $("#Purchase").show();
            $("#DailyLabour").hide();
            $("#Labour").hide();
            $("#Rent").hide();
        }
        if (RequestType == 4) {
            $("#OutSourceService").show();
            $("#Purchase").hide();
            $("#DailyLabour").hide();
            $("#Labour").hide();
            $("#Rent").hide();
        }
        if (RequestType == 5) {
            $("#Purchase").show();
            $("#DailyLabour").hide();
            $("#Labour").hide();
            $("#Rent").hide();
        }
        if (RequestType == 8) {
            $("#Purchase").show();
            $("#DailyLabour").hide();
            $("#Labour").hide();
            $("#Rent").hide();
        }
        if (RequestType == 7) {
            $("#OutSourceService").hide();
            $("#Labour").show();
            $("#Purchase").hide();
            $("#Rent").hide();
        }

        if (RequestType == 6) {
            $("#DailyLabour").show();
            $("#OutSourceService").hide();
            $("#Labour").hide();
            $("#Purchase").hide();
            $("#Rent").hide();
        }
    }
</script>

