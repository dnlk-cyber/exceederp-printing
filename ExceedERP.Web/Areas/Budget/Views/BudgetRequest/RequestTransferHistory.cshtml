@model ExceedERP.Core.Domain.Budget.BudgetRequest


<script>
    var masterId;
    function filterCategory() {
        return {
            Group: $("#BudgetGroup").val()
        };
    }
    function filterAccCode() {
        return {
            PlanCategoryID: $("#PlanCategoryId").val(),
        };
    }
    function filterWorkUnit() {
        return {
            PlanCategoryID: $("#PlanCategoryId").val(),

            AccCode: $("#AccountCode").val()
        };
    }

</script>

<legend>     Request Transfer History </legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Budget.BudgetRequestTransferLog>()
      .Name("grid")
      .Columns(columns =>
      {

          //   columns.ForeignKey(c => c.PlanCategoryId, (System.Collections.IEnumerable)ViewData["PlanCategory"], "PlanCategoryId", "Name").EditorTemplateName("OtherCategoryEditor").Width(100);
          columns.Bound(c => c.BudgetRequestTransferLogId).Title("Transfer No.").Width(100);
          columns.Bound(c => c.RequestNo).Title("Request No.").Width(100);

          columns.Bound(c => c.PlanCategoryId).EditorTemplateName("RequestCategoryEditor").Width(100);
          columns.ForeignKey(c => c.BranchId, (System.Collections.IEnumerable)ViewData["Branches"], "BranchID", "Name").EditorTemplateName("BranchEditor").Width(120);
          columns.Bound(c => c.BudgetYear).Width(100);
          columns.ForeignKey(c => c.WorkUnit, (System.Collections.IEnumerable)ViewData["MainCompanyStructures"], "Values", "Description").EditorTemplateName("WorkUnitEditor").Width(120);
          columns.Bound(c => c.FromDate).Title("From Date").EditorTemplateName("DateEditor").Width(120);
          columns.Bound(c => c.ToDate).Title("To Date").EditorTemplateName("DateEditor").Width(120);
          columns.Bound(c => c.Amount).Width(120);
          columns.Bound(c => c.Reason).Width(160);
      })

      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                             .Scrollable(h => h.Height(500))
                .ClientDetailTemplateId("template")
           //  .Events(ev => ev.DetailExpand("onDetailExpandUser"))
           .DataSource(dataSource => dataSource
          .Ajax()
                  .Model(model =>
                  {
                      model.Id(p => p.BudgetRequestTransferLogId);
                      model.Field(p => p.BudgetYear).Editable(false);
                      model.Field(p => p.Amount).Editable(false);
                  }).Events(ev => ev
                                                    .Error("error_handler(\"grid\")")
                                                    .RequestStart("onRequestStart(\"grid\")")
                                                    .RequestEnd("onRequestEnd(\"grid\")"))
                      .Read(read => read.Action("BudgetRequestAccepted_Read", "BudgetRequest").Data("sendForgery"))
              .Create(create => create.Action("BudgetRequest_Create", "BudgetRequest").Data("sendForgery"))
              .Update(update => update.Action("BudgetRequest_Update", "BudgetRequest").Data("sendForgery"))
              .Destroy(destroy => destroy.Action("BudgetRequest_Destroy", "BudgetRequest").Data("sendForgery"))
                    )
)




