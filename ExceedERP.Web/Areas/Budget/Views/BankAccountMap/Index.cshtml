@model ExceedERP.Core.Domain.Budget.BudgetBankAccountMap


<legend>   Bank Account Map </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Budget.BudgetBankAccountMap>()
              .Name("grid")
      .Columns(columns =>
      {
        
          columns.Bound(c => c.Name).Width(100);
          columns.ForeignKey(c => c.BranchId, (System.Collections.IEnumerable)ViewData["Branches"], "BranchID", "Name").EditorTemplateName("BranchEditor").Width(120);
          columns.Bound(e => e.IsHeadOffice).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsHeadOffice #' " + " # if (IsHeadOffice) { #" + "checked='checked'" + "# } #" + " />").Width(100);
    
          columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(200);

          columns.Bound(c => c.BankNumber).Width(200);
          columns.Bound(c => c.Address).Width(200); 
       

          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })

      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Scrollable(h => h.Height(500)).DataSource(dataSource => dataSource
          .Ajax()
                  .Model(model =>
                      {
                          model.Id(p => p.BudgetBankAccountMapId);
                         
                      })
                      .Events(ev => ev
                                            .Error("error_handler(\"grid\")")
                                            .RequestStart("onRequestStart(\"grid\")")
                                            .RequestEnd("onRequestEnd(\"grid\")"))
                  .Read(read => read.Action("BudgetBankAccountMap_Read", "BankAccountMap"))
                  .Create(create => create.Action("BudgetBankAccountMap_Create", "BankAccountMap"))
                  .Update(update => update.Action("BudgetBankAccountMap_Update", "BankAccountMap"))
                  .Destroy(destroy => destroy.Action("BudgetBankAccountMap_Destroy", "BankAccountMap"))
          )

)

