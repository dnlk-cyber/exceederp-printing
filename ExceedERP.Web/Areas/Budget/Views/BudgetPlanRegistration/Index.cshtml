                                        .Error("error_handler(\"gridCategory\")")
                                        .RequestStart("onRequestStart(\"gridCategory\")")
                                                            .RequestEnd("onRequestEnded(\"gridCategory\")"))
              .Read(read => read.Action("BudgetPlanRegistration_Read", "BudgetPlanRegistration"))
                                  .Create(create => create.Action("BudgetPlanRegistration_Create", "BudgetPlanRegistration"))
              .Update(update => update.Action("BudgetPlanRegistration_Update", "BudgetPlanRegistration"))
              .Destroy(destroy => destroy.Action("BudgetPlanRegistration_Destroy", "BudgetPlanRegistration"))
          )
               .ClientDetailTemplateId("template")
)





