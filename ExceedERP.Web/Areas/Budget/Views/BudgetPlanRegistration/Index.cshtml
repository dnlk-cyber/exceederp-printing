<script>
    var masterId;
    var Isapproved;
    var BudgetCategory;
    function filterCategory() {
        return {
            Group: $("#CategoryName").val()
        };
    }
    function filterAccCode() {
        return {
            PlanCategoryID: masterId,
        };
    }
    function SelectBudgetAccCode(e, BudgetCategory) {
        // BudgetCategory = BudgetCategory;
        console.log("budget category " + BudgetCategory);
        accountCodeTextBox = $(e).prev('input').attr('id');
        popup = window.open('/Budget/BudgetPlanRegistration/GLAccountSelector?Category=' + BudgetCategory, 'WindowPopup', 'top=100, left=400, width=650, height=320, resizable=no,');
        popup.focus();
        return false;
    }

    function filterWorkUnit() {
        return {
            PlanCategoryID: $("#Name").val(),

            AccCode: $("#AccountCode").val()
        };
    }
    function onDetailExpand(e) {
        var masterRow = e.masterRow;
        var masterGrid = $("#gridCategory").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.PlanCategoryID;

    }

    function onUploadError(e) {

        var response = jQuery.parseJSON(e.XMLHttpRequest.responseText);
        alert(response.data);
    }

    function ExcelExportEvent(e) {
        e.sender.hideColumn("0");

        //     e.sender.hideColumn("ReportStartDateTime");
    }

</script>



<script type="text/javascript">


    function onUploadSuccess(e) {
        $("#gridCategory").data("kendoGrid").dataSource.read();
        $("#gridCategory").data("kendoGrid").refresh();


    }

    function checkFileType(e) {
        var files = e.files;

        $.each(files, function () {

            if (this.extension.toLowerCase() === ".xls" || this.extension.toLowerCase() === ".xlsx" || this.extension.toLowerCase() === ".xlsm") {

            } else {
                alert("Only .xls, .xlsx, .xlsm files can be uploaded!");
                e.preventDefault();
            }

        });
    }


    var IsOnlineApproved;
    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#gridCategory").data("kendoGrid");
        
        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.PlanCategoryID;
        BudgetCategory = masterDataItem.Name;
        Isapproved = masterDataItem.IsSendForApproval;
        IsOnlineApproved = masterDataItem.IsOnlineApproved;
        var linegridName = "#gridplan_" + masterId;
        var approvalItemGridName = "#approvalitemgrid_" + masterId;
        if (masterDataItem.IsOnlineApproved == true)
        {
            $(".k-grid-edit", approvalItemGridName).hide();
        }
                $.ajax({
            url: '@Url.Action("GetStatus", "BudgetPlan")',

            data: { Id: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {

         
                if (result == "Approved") {
                   $(linegridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", linegridName).hide();
                    $(".k-grid-edit", linegridName).hide();
                    $(".k-grid-delete", linegridName).hide();

                    $(approvalItemGridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", approvalItemGridName).hide();
                    $(".ApprovalAdd", approvalItemGridName).hide();

                
                    $(".k-grid-delete", approvalItemGridName).hide();
                }

         

            }

        });

        


    }



    function onDataBound(e) {
        var grid = this; 
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            //get the item uid
            var currentUid = gridData[i].uid;
            //if the record fits the custom condition
            if (gridData[i].BudgetStatus == "Bad") {
                //find the row based on the uid and the custom class
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                $(currenRow).addClass("k-state-Rejected");
            }
            if (gridData[i].BudgetStatus == "Good") {
                //find the row based on the uid and the custom class
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                $(currenRow).addClass("k-state-Issued");
            }
        }
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            
            if (dataItem.IsSendForApproval == true || dataItem.IsOnlineApproved == true) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }


    function lineonDataBound(e) {
        var grid = this;

        var gridData = grid.dataSource.view();

        
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            for (var i = 0; i < gridData.length; i++) {
                //get the item uid
                var currentUid = gridData[i].uid;
                //if the record fits the custom condition
                if (gridData[i].BudgetStatus == "Bad") {
                    //find the row based on the uid and the custom class
                    var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                    $(currenRow).addClass("k-state-Rejected");
                }
                if (gridData[i].BudgetStatus == "Good") {
                    //find the row based on the uid and the custom class
                    var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                    $(currenRow).addClass("k-state-Issued");
                }
            }
            if (Isapproved == "true" || Isapproved == true)
            {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }

    function approveonDataBound(e) {
        var grid = this;

        $(grid).find(".k-toolbar").hide(); //hide toolbar
        $(".k-grid-top", grid).hide();

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            console.log(dataItem.IsOnlineApproved);
            if (IsOnlineApproved == true || Isapproved == false) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }



    function onRequestEnded(gridName) {
        return function (args) {
            var grid = $("#" + gridName).data("kendoGrid");
            var data = grid.dataSource;
          
            if (args.type === "destroy") {
                var id = args.response.Data[0].PlanCategoryID;

                $.ajax({
                    url: '@Url.Action("BudgetPlanRegistration_RemoveDependancy", "BudgetPlanRegistration")',

                    data: { PlanId: id },
                    type: 'GET',
                    cache: false,
                    success: function (result) {
                        console.log(result);
                    }
                });
            }
            if (args.type === "create") {
                if (!args.response.Errors) {
                    data.read();
                    $(".k-edit-form-container .k-grid-update").removeClass("k-state-disabled");
                    $(".k-edit-form-container .k-grid-cancel").removeClass("k-state-disabled");
                    $(".k-grid .k-grid-update").removeClass("k-state-disabled");
                    $(".k-grid .k-grid-edit").removeClass("k-state-disabled");
                    $(".k-grid .k-grid-delete").removeClass("k-state-disabled");
                    $(".k-grid .k-grid-cancel").removeClass("k-state-disabled");
                    //$(".k-grid .k-state-disabled").addClass("k-grid-add").removeClass("k-state-disabled");
                    console.log("show");
                }
                var id = args.response.Data[0].PlanCategoryID;

                $.ajax({
                    url: '@Url.Action("ProcessBudgetPlan", "BudgetPlanRegistration")',

                    data: { PlanId: id },
                    type: 'GET',
                    cache: false,
                    beforeSend :function (result) {
                        alert("Budget Plan Process Started Please Wait... ");
                    },  error: function () {
                        alert("Budget Plan Process Completed Succesfully!");
                    },
                    success: function (result) {
                        alert("Budget Plan Process Completed Succesfully!");
                    }
                });

            }
                if (  args.type === "update") {
                    if (!args.response.Errors) {
                        data.read();
                        $(".k-edit-form-container .k-grid-update").removeClass("k-state-disabled");
                        $(".k-edit-form-container .k-grid-cancel").removeClass("k-state-disabled");
                        $(".k-grid .k-grid-update").removeClass("k-state-disabled");
                        $(".k-grid .k-grid-edit").removeClass("k-state-disabled");
                        $(".k-grid .k-grid-delete").removeClass("k-state-disabled");
                        $(".k-grid .k-grid-cancel").removeClass("k-state-disabled");
                        //$(".k-grid .k-state-disabled").addClass("k-grid-add").removeClass("k-state-disabled");
                        console.log("show");
                    }
                else {
                    console.log("I had some issues");
                    $(".k-edit-form-container .k-grid-update").removeClass("k-state-disabled");
                    $(".k-edit-form-container .k-grid-cancel").removeClass("k-state-disabled");
                    $(".k-grid .k-grid-update").removeClass("k-state-disabled");
                    $(".k-grid .k-grid-edit").removeClass("k-state-disabled");
                    $(".k-grid .k-grid-delete").removeClass("k-state-disabled");
                    $(".k-grid .k-grid-cancel").removeClass("k-state-disabled");
                  
                }

            }
        }
    }
</script>