          columns.Bound(c => c.Remark).Width(100);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
   .ToolBar(toolbar =>
      {
          toolbar.Template(@<text>



            <div class="toolbar" style="">
                <div class="row">
                    <div class="col-md-8">
                        <form action="@Url.Action("DownloadCustomTemplate", "Attachment")" method="post">
                            <div class="col-md-12">
                                <fieldset>
                                    <div class="row">
                                        @(Html.Kendo().DropDownListFor(model => model).HtmlAttributes(new { @class = "form-control", @required = "required" }).Name("CategoryName")
                                    .DataTextField("Text")
                                            .DataValueField("Text").OptionLabel("Select Budget Category ")
                                                                    .DataSource(d => d.Read(r => r.Action("BudgetGroupDistinctDDBind", "BudgetDataProvider"))))

                                        @(Html.Kendo().DropDownListFor(model => model).HtmlAttributes(new { @class = "form-control", @required = "required" }).Name("FiscalYear")
                            .DataTextField("Text")
                                    .DataValueField("Text").OptionLabel(" Select Fiscal Year ")
                                   .DataSource(d =>
                    {
                        d.Read(r =>
                        {
                            r.Action("PlanYearByGroup", "BudgetDataProvider").Data("filterCategory");
                        })
                      .ServerFiltering(true);
                    })
                   .AutoBind(false)
                               .CascadeFrom("CategoryName"))

                                        @(Html.Kendo().DropDownListFor(model => model).HtmlAttributes(new { @class = "form-control"  }).Name("Branch")
                                    .DataTextField("Name")
                                            .DataValueField("BranchId").OptionLabel("Select Branch ")
                                                .DataSource(d => d.Read(r => r.Action("BranchDDBind", "BudgetDataProvider"))))
                                        @(Html.Kendo().DropDownListFor(model => model).HtmlAttributes(new { @class = "form-control" }).Name("WorkUnitName")
                                    .DataTextField("Text")
                                                    .DataValueField("Text").OptionLabel("Select WorkUnit ")
                                                        .DataSource(d => d.Read(r => r.Action("WorkUnitDDBind", "BudgetDataProvider"))))
                                        <button type="submit" class="k-button k-primary  "> <i class="fa fa-cloud-download fa-2x"></i></button>
                                        @*<input type="submit" value=""   class="fa-download k-button k-button-icontext  " />*@
                                    </div>
                                    <div class="row">
                                    </div>
                                    <div class="row">
                                        <a class="k-button k-button-icontext k-grid-add k-primary" href='#'>Add New Record</a>


                                    </div>

                                </fieldset>
                            </div>

                        </form>
                    </div>
               
                    
                         <div class="col-md-2 pull-right">
                        @(Html.Kendo().Upload()

        .Name("file")
                                .Async(a => a.Save("BudgetPlan_Import", "BudgetPlan"))
                                        .Messages(m => m.Select("Import Budget Plan"))
        .Events(e =>
        {
            e.Complete("onUploadSuccess").Upload("checkFileType"); e.Error("onUploadError"); e.Success("onUploadError");

        }))
                             <a href='@Url.Action("Index", "BudgetPlanRegistration")/?Reset=Reset' title="Reset" class="pull-right"><i class="fa fa-refresh fa-2x"></i></a>

                    </div>
               </div>
                @if(ViewBag.Error == true)
                { 
                <div class="row alert-danger"> <span>@ViewBag.Msg</span></div>
                }



            </div>
        </text>);



      }) 
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .HtmlAttributes(new { style = "height: 520px;" })
                      .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
                                        .Scrollable()
                           .Filterable()
                                                    .Sortable()
                           .Scrollable(h => h.Height(300))
                                    .Events(ev => { ev.DetailExpand("onDetailExpandUser"); ev.DataBound("onDataBound"); })
                          .DataSource(dataSource => dataSource
          .Ajax()
                  .Model(model =>
                  {
                      model.Id(p => p.PlanCategoryID);
                     model.Field(p => p.ActualConsumption).Editable(false);
                      model.Field(p => p.CurrentTotal).Editable(false);
                      model.Field(p => p.Progress).Editable(false);
                      model.Field(p => p.BudgetType).Editable(false);
