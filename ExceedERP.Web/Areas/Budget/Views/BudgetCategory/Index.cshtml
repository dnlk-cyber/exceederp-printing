@model ExceedERP.Core.Domain.Budget.BudgetCategory


<legend>Budget Category</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Budget.BudgetCategory>()
      .Name("gridCategory")
      .Columns(columns =>
      {
          columns.Bound(c => c.BudgetCategoryCode).Title("Code");
          columns.Bound(c => c.Name);
          columns.Bound(c => c.BudgetType).EditorTemplateName("BudgetTypeEditor").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(c => c.BudgetControlId, (System.Collections.IEnumerable)ViewData["BudgetControl"], "BudgetControlId", "Name").EditorTemplateName("BudgetControlEditor").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.FromAccountCode).EditorTemplateName("AccountCode").Width(200);
          columns.Bound(c => c.ToAccountCode).EditorTemplateName("AccountCode").Width(200);
          columns.Command(command => { command.Edit();/* command.Destroy();*/ }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
       
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 520px;" })
                  .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Scrollable(h => h.Height(500))
          .DataSource(dataSource => dataSource
          .Ajax()
            .Model(model =>
            {
                model.Id(p => p.BudgetCategoryID);

            })
            .Events(ev => ev
                .Error("error_handler(\"gridCategory\")")
                .RequestStart("onRequestStart(\"gridCategory\")")
                .RequestEnd("onRequestEnd(\"gridCategory\")")
                )
              .Read(read => read.Action("BudgetCategory_Read", "BudgetCategory").Data("sendForgery"))
              .Create(create => create.Action("BudgetCategory_Create", "BudgetCategory").Data("sendForgery"))
              .Update(update => update.Action("BudgetCategory_Update", "BudgetCategory").Data("sendForgery"))
              .Destroy(destroy => destroy.Action("BudgetCategory_Destroy", "BudgetCategory").Data("sendForgery"))
          )
          .ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
  @(Html.Kendo().TabStrip()
        .Name("tabstripMain_#=BudgetCategoryID#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Category Detail").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Budget.BudgetCategoryDetail>()
                        .Name("gridBudgetCategory_#=BudgetCategoryID#")
                        .Columns(column =>
                        {
                            column.Bound(c => c.BudgetCode).Width(120);
                            column.Bound(c => c.BudgetItem).Width(200);
                            column.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(220);
                            column.Bound(c => c.BudgetCategoryDetailDescription).Width(250);
                            column.Command(command => { command.Edit(); command.Destroy(); });
                        })
                        .ToolBar(toolbar => toolbar.Create())
                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .HtmlAttributes(new { style = "height: 520px;" })
                        .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
                        .Scrollable()
                        .Sortable()
                        .Filterable()
                        .DataSource(dataSource => dataSource
                                .Ajax()
                                 .Model(model =>
                                 {
                                     model.Id(p => p.BudgetCategoryDetailID);
                                     model.Field(p => p.BudgetCode).Editable(false);
                                 })                               
                                .Read(read => read.Action("BudgetCategoryDetail_Read", "BudgetCategory", new { Id = "#=BudgetCategoryID#" }).Data("sendForgery"))
                                .Create(create => create.Action("BudgetCategoryDetail_Create", "BudgetCategory", new { Id = "#=BudgetCategoryID#" }).Data("sendForgery"))
                                .Update(update => update.Action("BudgetCategoryDetail_Update", "BudgetCategory").Data("sendForgery"))
                                .Destroy(destroy => destroy.Action("BudgetCategoryDetail_Destroy", "BudgetCategory").Data("sendForgery"))
                        ).ToClientTemplate()
    )                
                </text>);
        }).ToClientTemplate()
    )
</script>

