                                                                                                                                                                                                            .Error("error_handler(\"PaymentRequestAttachment#=PaymentRequestId#\")")
                                                                                                                                                                                                            .RequestStart("onRequestStart(\"PaymentRequestAttachment#=PaymentRequestId#\")")
                                                                                                                                                                                                            .RequestEnd("onRequestEnd(\"PaymentRequestAttachment#=PaymentRequestId#\")"))
                                                                                                                                                                                                            .Model(model => model.Id(p => p.PaymentRequestAttachmentId))
                                                                                                                                                                                                        .Read(read => read.Action("PaymentRequestAttachment_Read", "PaymentRequestAttachmentBudget", new { id = "#=PaymentRequestId #" }).Data("sendForgery"))
                                                                                                                                                                                                        .Create(create => create.Action("PaymentRequestAttachment_Create", "PaymentRequestAttachmentBudget", new { id = "#=PaymentRequestId #" }).Data("sendForgery"))
                                                                                                                                                                                                        .Update(update => update.Action("PaymentRequestAttachment_Update", "PaymentRequestAttachmentBudget").Data("sendForgery"))
                                                                                                                                                                                                        .Destroy(destroy => destroy.Action("PaymentRequestAttachment_Destroy", "PaymentRequestAttachmentBudget").Data("sendForgery"))
                                                                                                                                                                                            ).ToClientTemplate())
        </text>
    }

</script>
