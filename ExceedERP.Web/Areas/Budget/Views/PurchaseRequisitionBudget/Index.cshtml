@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using ExceedERP.Core.Domain.Procurement.PR
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Purchase Requisition Budget Approval </legend>
@(Html.Kendo().Grid<PurchaseRequisition>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.PurchaseRequisitionID).Title("PR No.").Width(80);
          columns.Bound(c => c.StoreRequisitionID).Title("SR No.").EditorTemplateName("StoreRequisitionSelector").Width(80);
          columns.Bound(c => c.ReferenceNo).Title("Reference").Width(120);
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(130).EditorTemplateName("EmployeeSelector").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(150).EditorTemplateName("WorkUnitCostCenterSelector").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(160).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(p => p.ProcurementOfficer, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Team Leader").Width(130).EditorTemplateName("PurchaserSelector").Filterable(ftb => ftb.Multi(true).Search(true));
          //columns.Bound(c => c.PurchaseCategory).EditorTemplateName("PurchaseCategory").Width(100);
          //columns.Bound(c => c.ProcurementMethod).EditorTemplateName("ProcurementMethod").Width(100);
          //columns.Bound(c => c.TenderType).EditorTemplateName("TenderType").Width(110);
          //columns.Bound(c => c.ModelNo).Width(100);
          //columns.Bound(c => c.PlateNo).Width(100);
          columns.Bound(c => c.Remark).Width(100);
          columns.Bound(c => c.Status).Width(110);
          columns.Command(command =>
          {
              //command.Edit();
              // command.Destroy();
          }).Width(180);
      })
      .Events(ev => ev.DetailExpand("detailExpandMasterNew"))
                              .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMasterNew"))

      //.Editable(editable => editable.Mode(GridEditMode.InLine))
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("PurchaseRequisition").Window(w => w.Title("Purchase Requisition Review")))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Sortable()
      .Filterable()



     .Events(ev => ev.DetailExpand("detailExpandMasterNew"))
                              .Scrollable(h => h.Height(500))
                              .Events(x => x.DataBound("onDataBoundMasterNew"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("PurchaseRequisitionID").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.PurchaseRequisitionID);
              model.Field(p => p.PurchaseRequisitionID).Editable(false);
              model.Field(p => p.StoreRequisitionID).Editable(false);
              model.Field(p => p.OrgStructureId).Editable(false);
              model.Field(p => p.EmployeeId).Editable(false);
              model.Field(p => p.BusinessUnitId).Editable(false);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.ReferenceNo).Editable(false);
              model.Field(p => p.ModelNo).Editable(false);
              model.Field(p => p.Remark).Editable(false);
              model.Field(p => p.Status).Editable(false);
              model.Field(p => p.ItemType).Editable(false);
              model.Field(p => p.IsManual).Editable(false);

              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.LastModified).Editable(false);
              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
          })
          .Read(read => read.Action("PurchaseRequisitionBudgets_Read", "PurchaseRequisitionBudget").Data("sendForgery"))
          .Create(create => create.Action("PurchaseRequisitionBudgets_Create", "PurchaseRequisitionBudget").Data("sendForgery"))
          .Update(create => create.Action("PurchaseRequisitionBudgets_Update", "PurchaseRequisitionBudget").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("PurchaseRequisitionBudgets_Destroy", "PurchaseRequisitionBudget").Data("sendForgery"))
      ).Resizable(resizable => resizable.Columns(true))
      .ClientDetailTemplateId("purchaserequsitiontemplate"))

