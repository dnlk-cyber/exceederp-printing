                      .Events(x => x.DataBound("onDataBoundLines"))
                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                      //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ItemDetail").Window(w => w.Title("Item Detail")))
                      .Scrollable()
                      .DataSource(dataSource => dataSource
                          .Ajax()

                          .Events(ev => ev
                              .Error("error_handler(\"PurchaseRequisitionItemSpecification#=PurchaseRequisitionItemID#\")")
                              .RequestStart("onRequestStart(\"PurchaseRequisitionItemSpecification#=PurchaseRequisitionItemID#\")")
                              .RequestEnd("onRequestEnd(\"PurchaseRequisitionItemSpecification#=PurchaseRequisitionItemID#\")"))
                          .Model(model =>
                          {
                              model.Id(p => p.PurchaseRequisitionItemSpecificationId);

                              model.Field(p => p.CreatedBy).Editable(false);
                              model.Field(p => p.DateCreated).Editable(false);
                              model.Field(p => p.ModifiedBy).Editable(false);
                              model.Field(p => p.LastModified).Editable(false);


                          })
                          .Read(read => read.Action("PurchaseRequisitionItemSpecifications_Read", "PurchaseRequisitionItemSpec", new { id = "#=PurchaseRequisitionItemID#",area="Procurement" }).Data("sendForgery"))
                          .Create(create => create.Action("PurchaseRequisitionItemSpecifications_Create", "PurchaseRequisitionItemSpec", new { id = "#=PurchaseRequisitionItemID#", area = "Procurement" }).Data("sendForgery"))
                          .Update(update => update.Action("PurchaseRequisitionItemSpecifications_Update", "PurchaseRequisitionItemSpec", new {  area = "Procurement" }).Data("sendForgery"))
                          .Destroy(destroy => destroy.Action("PurchaseRequisitionItemSpecifications_Destroy", "PurchaseRequisitionItemSpec", new {area = "Procurement" }).Data("sendForgery"))
                          ).ToClientTemplate())


            </text>);

}).ToClientTemplate())
</script>

<script>


    function voidRecord(id) {
    var recordStatus = "";
    var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
    if (conf === true) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("Void", "PurchaseRequisitionBudget", new {area = "Budget"})',
        data: { id: id },
        success: function (result) {
            // toastr.warnning(result.Message);
            alert(result.Message);
            recordStatus = result.Status;
            location.reload(true);
        }, //end succ
        error: function (result) {
            alert(result);
        }
    });
   }
    }

    function sendForBudgetApproval(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to approve this PR number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("ApproveBudget", "PurchaseRequisitionBudget", new { area = "Budget" })',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }




    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    var isapproved;
    var issecondapproved;
    var isSendForApproval;
    var isOnlineTransferred;
    var nextApprover;
    var isFinanceApproved;
    var isAuthorized;
    var isBudgetApproved;

    function detailExpandMasterNew(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.PurchasePaymentId;
        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;
        nextApprover = masterDataItem.ForwardedTo;
        isAuthorized = masterDataItem.IsAuthorized;
        isFinanceApproved = masterDataItem.IsFinanceApproved;
        isBudgetApproved = masterDataItem.IsBudgetApproved;

    }
    function onDataBoundMasterNew(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved || gridData[i].IsSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsOnlineApproved && !dataItem.IsBudgetApproved) {
                row.css("background-color", "lightgreen");
            }

            if (dataItem.IsAuthorized) {
                row.css("background-color", "blue");
            }

            if (dataItem.IsBudgetApproved) {
                row.css("background-color", "gold");
            }

            if (dataItem.Paid) {
                row.css("background-color", "honeydew");
            }

            if (dataItem.IsVoid) {
                row.css("background-color", "slategray");
                row.css("color", "black");
            }
        }


    }
    function onDataBoundLineNew(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionItem_" + codeid;
        if (isapproved || isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundValidationNew(e) {
        var currentUser=@Html.Raw(Json.Encode(User.Identity.Name));


        var detailGrid = "#" + e.sender.element[0].id;

        if (isapproved || !isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        if (nextApprover !== currentUser) {
            $(".k-grid-add", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }

    function onDataBoundValidationBudget(e) {


        var detailGrid = "#" + e.sender.element[0].id;

        if (isBudgetApproved /* || !isapproved */) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }



        this.table.find(".k-grid-edit").hide();
    }


    ////////////////for assignment////////////////

    var assignmentMasterDataItem;
    var assignmentMasterRow;
    var assignmentMasterGrid;;

    var assignmentcodeid;
    var assignmentisapproved;

    function detailExpandPurchaseAssignment(e) {

        assignmentMasterRow = e.masterRow;
        assignmentMasterGrid = $("#" + e.sender.element[0].id).data("kendoGrid");
        assignmentMasterDataItem = assignmentMasterGrid.dataItem(assignmentMasterRow);
        assignmentcodeid = assignmentMasterDataItem.PurchaseRequisitionAssignmentId;
        assignmentisapproved = assignmentMasterDataItem.IsOnlineApproved;


    }
    function onDataBoundMasterPurchaseAssignment(e) {

        var grid = $("#" + e.sender.element[0].id).data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
            var deleteButton = $(currenRow).find(".k-grid-delete");
            deleteButton.hide();
            if (gridData[i].IsOnlineApproved) {
                var editButton = $(currenRow).find(".k-grid-edit");
                editButton.hide();
            }
        }

    }

    function onDataBoundPurchaseAssignmentValidation(e) {
        var detailGrid = "#" + e.sender.element[0].id;
        $(".k-grid-delete", detailGrid).hide();
        if (assignmentisapproved) {
            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }


    function filterMethods() {
        return { procurementMethod: $("#PreviousProcurementMethod").data("kendoDropDownList").value() }
    }

    function onItemEdit(e) {

        if (e.model.isNew() === false) {
            $("#ItemCategoryCode").attr("readonly", true);
            $("#ItemCode").attr("readonly", true);
            $("#PartNo").attr("readonly", true);
           // $("#Quantity").attr("readonly", true);

            var dropdownlistCat = $("#ItemCategoryCode").data("kendoDropDownList");
            dropdownlistCat.enable(false);


        }
    }


    function OnIndexCall(elem) {

        var a = codeid;
        $(elem).attr('href', $(elem).attr('href') + '?id=' + a);


    }
    function autocompleteValue(e) {
        var DataItem = this.dataItem(e.item.index());
        var code = DataItem.code;
        $("#ProcurementOfficer").val(code);


    }
</script>
