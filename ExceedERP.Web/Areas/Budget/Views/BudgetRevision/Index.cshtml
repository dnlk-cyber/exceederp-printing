<script>

    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;

    var isRevisionApproved;
    var isApproved;
    var isRevisionSendForApproval;
    var isSendForApproval;

    function detailExpandMasterRevision(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        // codeid = masterDataItem.PurchaseOrderID;
        isRevisionApproved = masterDataItem.IsRevisionOnlineApproved;
        isApproved = masterDataItem.IsOnlineApproved;
        isRevisionSendForApproval = masterDataItem.IsRevisionSendForApproval;
        isDeptSendForApproval = masterDataItem.IsSendForApproval;
    }
    function onDataBoundMasterRevision(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsRevisionOnlineApproved || gridData[i].IsRevisionSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsRevisionSendForApproval && !dataItem.IsRevisionOnlineApproved) {
                row.css("background-color", "lightgreen");
            }
            if (!dataItem.IsRevisionSendForApproval && !dataItem.IsRevisionOnlineApproved) {
                row.css("background-color", "lightskyblue");
            }

            if (dataItem.IsBudgetApproved) {
                row.css("background-color", "gold");
            }

            if (dataItem.Paid) {
                row.css("background-color", "honeydew");
            }

            if (dataItem.IsVoid) {
                row.css("background-color", "slategray");
                row.css("color", "black");
            }
        }


    }
    function onDataBoundLineFirst(e) {

        var detailGrid = "#" + e.sender.element[0].id;
        if (isApproved || IsSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }

    function onDataBoundLineRevision(e) {

        var detailGrid = "#" + e.sender.element[0].id;
        if (isRevisionApproved || isRevisionSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }

    function onDataBoundValidationFirst(e) {


        var detailGrid = "#" + e.sender.element[0].id;

        if (isApproved || !isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }



        this.table.find(".k-grid-edit").hide();
    }
    function onDataBoundValidationRevision(e) {


