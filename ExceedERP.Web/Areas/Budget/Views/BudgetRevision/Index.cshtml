    function checkFileType(e) {
        var files = e.files;

        $.each(files, function () {

            if (this.extension.toLowerCase() === ".xls" || this.extension.toLowerCase() === ".xlsx" || this.extension.toLowerCase() === ".xlsm") {

            } else {
                alert("Only .xls, .xlsx, .xlsm files can be uploaded!");
                e.preventDefault();
            }

        });
    }

    function OpenForRevision(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("OpenForRevision", "BudgetRevision", new { area = "Budget" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
    function sendForApproval(id) {
