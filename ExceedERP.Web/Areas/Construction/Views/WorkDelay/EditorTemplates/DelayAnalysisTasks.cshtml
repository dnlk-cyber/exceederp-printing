@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        .Name("DelayAnalysisTaskId")
        .DataTextField("Title")
        .DataValueField("DelayAnalysisTaskId")
        //    .BindTo((IEnumerable)ViewData["Items"])
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetDelayAnalysisTasks", "DataProvider", new { projectId = "#=ProjectInformationId#" }))
            .ServerFiltering(true);
        })
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)