@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        .Name("ID")
        .DataTextField("Title")
        .DataValueField("ID")
        //    .BindTo((IEnumerable)ViewData["Items"])
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetScheduleTasksForDelayAnalysis", "DataProvider", new {projectId = "#=ProjectInformationId#", revisionId = "#=ScheduleRevisionId#" }));
            //.ServerFiltering(true);
        })
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)