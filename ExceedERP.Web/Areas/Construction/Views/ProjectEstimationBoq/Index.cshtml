@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Estimation BOQ</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectEstimationBoq>()
          .Name("ProjectEstimationBoq")
      .Columns(columns =>
      {
        columns.Bound(c => c.TypeOfBoq);
        columns.Bound(c => c.BillNumber);
        columns.Bound(c => c.Description);
        columns.Bound(c => c.TotalCost);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
           .Scrollable(h => h.Height(500))
                                     .Groupable()
                                              .Sortable(sortable =>
                                              {
                                                  sortable.SortMode(GridSortMode.SingleColumn);
                                              })
                                  .Filterable()
                                     .Pageable(pageable => pageable
                                                                .Input(true)
                                                                .Numeric(false)
                                                                .Refresh(true)
                                                                .PageSizes(true)
                                                                .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                      .Events(events => events.Error("error_handler(\"grid_#=ProjectEstimationBoq#\")"))
          .Model(model => model.Id(p => p.ProjectEstimationBoqid))
          .Read(read => read.Action("ProjectEstimationBoq_Read", "ProjectEstimationBoq"))
          .Create(create => create.Action("ProjectEstimationBoq_Create", "ProjectEstimationBoq"))
          .Update(update => update.Action("ProjectEstimationBoq_Update", "ProjectEstimationBoq"))
          .Destroy(destroy => destroy.Action("ProjectEstimationBoq_Destroy", "ProjectEstimationBoq"))
      )
)
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
</script>