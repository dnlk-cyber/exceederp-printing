@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Budget Transfer</legend>
<div>
    <div class="toolbar">
        <label class="category-label" for="ProjectInformationId">Select Project Name:</label>
        @(Html.Kendo().DropDownListFor(m => m)

                              .Name("ProjectInformationId")
              .OptionLabel("Project Name..")
              .BindTo((IEnumerable)ViewData["ProjectList"])
              .DataTextField("Name")
                              .DataValueField("ProjectInformationId")
              .HtmlAttributes(new { style = "width: 300px;" })
              .ValuePrimitive(true)
              .Events(x => x.Change("filter"))

        )
        <br />
    </div>
</div>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectDefineBudget>()
                      .Name("ProjectDefineBudget")
      .Columns(columns =>
      {

          columns.Bound(c => c.BudgetCode);
          columns.Bound(c => c.TotalBudget);
          columns.Bound(c => c.EstimatedAmount);
          columns.Bound(c => c.Description);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
            .Scrollable(h => h.Height(500))
                                 .Groupable()
                                          .Sortable(sortable =>
                                          {
                                              sortable.SortMode(GridSortMode.SingleColumn);
                                          })
                              .Filterable()
                                 .Pageable(pageable => pageable
                                                            .Input(true)
                                                            .Numeric(false)
                                                            .Refresh(true)
                                                            .PageSizes(true)
                                                            .ButtonCount(5))

      .DataSource(dataSource => dataSource
          .Ajax()
                      .Events(events => events.Error("error_handler(\"ProjectDefineBudget\")"))
          .Model(model => model.Id(p => p.ProjectDefineBudgetId))
                  .Read(read => read.Action("ProjectDefineBudgets_Read", "ProjectBudgetDefination", new { idOne = "-1" }))
                  .Create(create => create.Action("ProjectDefineBudgets_Create", "ProjectBudgetDefination", new { idTwo = "-1" }))
          .Update(update => update.Action("ProjectDefineBudgets_Update", "ProjectBudgetDefination"))
          .Destroy(destroy => destroy.Action("ProjectDefineBudgets_Destroy", "ProjectBudgetDefination"))
          ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("tabstrip_#=ProjectDefineBudgetId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("Budget Transfer").Content(
                @<text>
                   @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectBudgetUtilization>()
      .Name("grid_#=ProjectDefineBudgetId#")
      .Columns(columns =>
      {
          columns.Bound(c => c.RequestedFor);
          columns.Bound(c => c.Transferred);
          columns.Bound(c => c.Utilized);
          columns.Bound(c => c.Difference);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
                          .Events(events => events.Error("error_handler(\"grid_#=ProjectDefineBudgetId#\")"))
          .Model(model => model.Id(p => p.ProjectBudgetUtilizationId))
                  .Read(read => read.Action("ProjectBudgetUtilization_Read", "ProjectBudgetUtilization", new { id = "#=ProjectDefineBudgetId#" }))
                  .Create(create => create.Action("ProjectBudgetUtilization_Create", "ProjectBudgetUtilization", new { idTwo = "#=ProjectDefineBudgetId#" }))
          .Update(update => update.Action("ProjectBudgetUtilization_Update", "ProjectBudgetUtilization"))
          .Destroy(destroy => destroy.Action("ProjectBudgetUtilization_Destroy", "ProjectBudgetUtilization"))
      ).ToClientTemplate() 
                )



                </text>
                  );


          }).ToClientTemplate())
</script>


<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }

    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }
    function filter() {
        var value = this.value(),
          grid = $("#ProjectDefineBudget").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "ProjectInformationId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }

        $.ajax({
            url: '@Url.Action("SetProjectId", "ProjectBudgetDefination")',
            //contentType: "application/json; charset=utf-8",
            data: { value: value },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

            }

        });
    }

</script>
<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>



