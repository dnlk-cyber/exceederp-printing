@using ExceedERP.Core.Localization
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Estimation | Splitted Version</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
      .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Name).Width(400);
          columns.Bound(c => c.Code);
          columns.Bound(c => c.ProjectType).ClientGroupHeaderTemplate(
              "# if (value === 0) { #" +
                " Building ( #= aggregates.ProjectInformationId.count # projects)" +
              "# } else if (value === 1) {#" +
                " Road ( #= aggregates.ProjectInformationId.count # projects)" +
              "# } else if (value === 2) {#" +
                " Dam ( #= aggregates.ProjectInformationId.count # projects)" +
              "# } else if (value === 3) {#" +
                " Irrigation ( #= aggregates.ProjectInformationId.count # projects)" +
              "# } #"
              ).Hidden(true);
          columns.Bound(c => c.ProjectScope);
          columns.Bound(c => c.Consultant);
          columns.Bound(c => c.Client);
          columns.Command(command =>
          {
              command.Custom("CmdOpenProjectView").Text("&nbsp;&nbsp;Expand").Click("openSpecificProjectView").IconClass("fa fa-expand");
          }).Width(120);
      })
      .Scrollable(h => h.Height(700))
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Group(groups =>
          {
              groups.Add(p => p.ProjectType);
          })
          .Aggregates(ag =>
          {
              ag.Add(f => f.ProjectInformationId).Count();
          })
          .PageSize(20)
          .Events(events =>
          {
              events.Error("error_handler(\"ProjectInformationgrid\")");
              events.RequestStart("onRequestStart(\"ProjectInformationgrid\")");
              events.RequestEnd("onRequestEnd(\"ProjectInformationgrid\")");

          })

          .Model(model => model.Id(p => p.ProjectInformationId))
          .Read(read => read.Action("ProjectInformation_Read", "ProjectEstimationSplit"))
          .Create(create => create.Action("ProjectInformation_Create", "ProjectEstimationSplit"))
          .Update(update => update.Action("ProjectInformation_Update", "ProjectEstimationSplit"))
          .Destroy(destroy => destroy.Action("ProjectInformation_Destroy", "ProjectEstimationSplit"))
      ).ClientDetailTemplateId("template")
)

