@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend><a href='/Construction/ProjectEstimationSplit/' title="Back To All Projects"><i class="fa fa-chevron-circle-left fa-1.5x"></i></a> &nbsp; &nbsp; Project Estimation (Splitted Version) / @ViewBag.Project</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.WorkItemPerProjectViewModel>()
                                  .Name("workItemsGrid")
                                  .Columns(columns =>
                                  {
                                      columns.Bound(c => c.SubProjectTypeName).Hidden(true)
                                      .ClientGroupHeaderTemplate(
                                          "#=value#"
                                          );
                                      columns.Bound(c => c.BlockName).Hidden(true).ClientGroupHeaderTemplate(
                                          "#=value#"
                                          );
                                      columns.Bound(c => c.StructureyType).Hidden(true).ClientGroupHeaderTemplate(
                                          "#=value#"
                                          );
                                      columns.Bound(c => c.WorkCategory).Hidden(true).ClientGroupHeaderTemplate(
                                          "#=value#"
                                          );
                                      columns.Bound(c => c.ItemName).Width(200).Title("Item Name");
                                      columns.Bound(c => c.UnitOfMeasurement).Width(60).Title("UoM");
                                      columns.Bound(c => c.TotalQuantityOfWork).Width(100).ClientTemplate(
                                                "# if (IsSubCategory) { #" +
                                                    " -----" +
                                                    "# } else {#" +
                                                    "#: kendo.toString( TotalQuantityOfWork, 'N4') #" +
                                                    "# } #"
                                                );
                                      columns.Bound(c => c.ActualQuantityOfWork).Width(100).ClientTemplate(
                                         "# if (IsSubCategory) { #" +
                                                " -----" +
                                                "# } else {#" +
                                                "#: kendo.toString( ActualQuantityOfWork, 'N2') #" +
                                                "# } #"
                                            );
                                      columns.Bound(c => c.TotalUnitCost).Width(100).ClientTemplate(
                                          "# if (IsSubCategory) { #" +
                                                  " -----" +
                                                  "# } else {#" +
                                                  "#: kendo.toString( TotalUnitCost, 'N4') #" +
                                                  "# } #"
                                              );
                                      columns.Bound(c => c.ItemCode).Width(100);

                                  })
                                  .Scrollable(h => h.Height(700))
                                  .Sortable(sortable =>
                                  {
                                      sortable.SortMode(GridSortMode.SingleColumn);
                                  })
                                  .Selectable(selectable =>
                                  {
                                      selectable.Mode(GridSelectionMode.Single);
                                      selectable.Type(GridSelectionType.Row);
                                  })
                                  .Pageable(pageable => pageable
                                      .Input(true)
                                      .Numeric(false)
                                      .Refresh(true)
                                      .PageSizes(true)
                                      .ButtonCount(5))
                                  .DataSource(dataSource => dataSource
                                      .Ajax()
                                      .PageSize(100)
                                      .Sort(srt =>
                                      {
                                          srt.Add(f => f.ItemCode);
                                      })
                                      .Events(events =>
                                      {
                                          events.Error("error_handler(\"workItemsGrid\")");
                                          events.RequestStart("onRequestStart(\"workItemsGrid\")");
                                          events.RequestEnd("onRequestEnd(\"workItemsGrid\")");
                                      })
                                      .Group(g =>
                                      {
                                          g.Add(f => f.SubProjectTypeName);
                                          g.Add(f => f.BlockName);
                                          g.Add(f => f.StructureyType);
                                          g.Add(f => f.WorkCategory);
                                      })
                                      .Model(model =>
                                      {
                                          model.Id(p => p.Id);
                                      }
                                      )
                                      .Read(read => read.Action("WorkItem_Read", "ProjectEstimationSplit").Data("getIdOfOpenedProject"))
                                  ).ClientDetailTemplateId("workItem_detail")
)

