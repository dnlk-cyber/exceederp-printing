@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        //.Name("structureTypesDropdownList")
        .DataTextField("CurrentValue")
        .DataValueField("ConfigurationId")
        //.BindTo((IEnumerable)ViewData["StrTypes"])
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetStructureTypes", "DataProvider", new { blockId = "#=BlockId#" }));
            //.ServerFiltering(true);
        })
        //.Events(ev => {
        //    ev.Change("onStructureTypeMapping");
        //})
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)