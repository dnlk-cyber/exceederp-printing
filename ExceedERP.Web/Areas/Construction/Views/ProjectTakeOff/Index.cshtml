<script id="template_building" type="text/kendo-tmpl">
    #if(!IsSubCategory){#
    @(Html.Kendo().TabStrip()
                .Name("tabs_#=Id#")
                .SelectedIndex(0)
                  .Items(items =>
                  {
                      items.Add().Text("Detail").Content(
                        @<text>
                            @(Html.Kendo().PanelBar()
                              .Name("panelbar_#=Id#")
                              .ExpandMode(PanelBarExpandMode.Single)
                              .Items(panelbar =>
                              {
                                  panelbar.Add()
                                      .Expanded(true)
                                      .Content(
                                         "<div class='workItem-details'>" +
                                            "<ul>" +
                                                 "<li> <label> Work Item: </label> <strong> #=ItemName# </strong> </li>" +
                                                 "<li> <label> Total Quantity Of Work </label> #= kendo.toString(TotalQuantityOfWork, 'N4')# </li>" +
                                                 "<li> <label> A=  Material Unit Cost:</label> #= kendo.toString(MaterialCost, 'N2')# </li>" +
                                                 "<li> <label> B=Manpower Unit Cost: </label> #= kendo.toString(LabourOutPut, 'N2')# </li>" +
                                                 "<li> <label> C=Equipment Unit Cost:</label> #= kendo.toString(EquipmentOutput, 'N2')# </li>" +
                                                 "<li> <label> Direct Cost of work item=  A+B+C= </label> #= kendo.toString(DirectCost, 'N2')# </li>" +
                                                 "<li> <label> Over head Cost:</label> #= kendo.toString(OverHeadCost, 'N2')# </li>" +
                                                 "<li> <label> Profit Cost:</label> #= kendo.toString(ProfitCost, 'N2')# </li>" +
                                                 "<li> <label>T otal Unit Cost :</label> #= kendo.toString(TotalUnitCost, 'N4')# </li>" +
                                            "</ul>" +
                                        "</div>"

                                );
                              }).ToClientTemplate()
                            )
                        </text>

                      );

                  items.Add().Text("Take Off Sheet").Content(
                    @<text>
                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectTakeOff>()
                                .Name("actualTakeOff_#=Id#")
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.TakeOffNo);
                                    columns.Bound(c => c.IsReinforcementbarTakeOff)
                                    .ClientTemplate(
                                            "<input type='checkbox' value='\\#= ProjectTakeOffId \\#' " +
                                                "\\# if (IsReinforcementbarTakeOff) { \\#" +
                                                    "checked='checked'" +
                                                "\\# } \\#" +
                                            "/>"
                                    );
                                    columns.Bound(c => c.Remark);

                                    columns.Command(command =>
                                    {
                                        command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                        command.Destroy().Text(Resources.ActionButton_Cancel);
                                    }).Width(200);
                                })
                                .ToolBar(toolbar =>
                                {
                                    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                })
                                .Selectable(selectable =>
                                {
                                    selectable.Mode(GridSelectionMode.Single);
                                    selectable.Type(GridSelectionType.Row);
                                })
                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .Scrollable(h => h.Height(500))
                                .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Events(events =>
                                        {
                                            events.Error("error_handler(\"actualTakeOff_#=Id#\")");
                                            events.RequestStart("onRequestStart(\"actualTakeOff_#=Id#\")");
                                            events.RequestEnd("onRequestEnd(\"actualTakeOff_#=Id#\")");
                                        })

                                .Model(model =>
                                {
                                    model.Id(p => p.ProjectTakeOffId);

                                    model.Field(f => f.TakeOffNo).Editable(false);
                                })
                                .Read(read => read.Action("ProjectTakeOff_Read", "ProjectTakeOff", new { workItemId = "#=Id#" }))
                                .Create(create => create.Action("ProjectTakeOff_Create", "ProjectTakeOff", new { workItemId = "#=Id#" }))
                                .Update(update => update.Action("ProjectTakeOff_Update", "ProjectTakeOff"))
                                .Destroy(destroy => destroy.Action("ProjectTakeOff_Destroy", "ProjectTakeOff"))
                                ).ClientDetailTemplateId("takeoff_content_building")
                                .ToClientTemplate()
                        )
                    </text>
                      );
                  }).ToClientTemplate()
    )
    #} else {#
    @(Html.Kendo().TabStrip()
              .Name("tab_#=Id#")
              .SelectedIndex(0)
              .Items(items =>
              {
                  items.Add().Text("Work Items").Content(
                    @<text>

                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.WorkItemPerProjectViewModel>()
                        .Name("workItem_#=Id#")
                        .Columns(columns =>
                        {
                            columns.Bound(c => c.SubProjectTypeName).Hidden(true);
                            columns.Bound(c => c.BlockName).Hidden(true);
                            columns.Bound(c => c.StructureyType).Hidden(true);
                            columns.Bound(c => c.WorkCategory).Hidden(true);
                            columns.Bound(c => c.ItemName).Width(200).Title("Item Name");
                            columns.Bound(c => c.UnitOfMeasurement).Width(60).Title("UoM");
                            columns.Bound(c => c.TotalQuantityOfWork).Width(100).ClientTemplate(
                                      "\\# if (IsSubCategory) { \\#" +
                                          " -----" +
                                          "\\# } else {\\#" +
                                          "\\#: kendo.toString( TotalQuantityOfWork, 'N4') \\#" +
                                          "\\# } \\#"
                                      );
                            columns.Bound(c => c.ActualQuantityOfWork).Width(100).ClientTemplate(
                                 "\\# if (IsSubCategory) { \\#" +
                                        " -----" +
                                        "\\# } else {\\#" +
                                        "\\#: kendo.toString( ActualQuantityOfWork, 'N2') \\#" +
                                        "\\# } \\#"
                                    );
                            
                            columns.Bound(c => c.TotalUnitCost).Width(100).ClientTemplate(
                                "\\# if (IsSubCategory) { \\#" +
                                        " -----" +
                                        "\\# } else {\\#" +
                                        "\\#: kendo.toString( TotalUnitCost, 'N4') \\#" +
                                        "\\# } \\#"
                                    );
                            columns.Bound(c => c.ItemCode).Width(100);
                        })
                        .Scrollable(h => h.Height(500))
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                        .Selectable(selectable =>
                        {
                            selectable.Mode(GridSelectionMode.Single);
                            selectable.Type(GridSelectionType.Row);
                        })
                        .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
                        .DataSource(dataSource => dataSource
                        .Ajax()
                        .Events(events =>
                        {
                            events.Error("error_handler(\"workItem_#=Id#\")");
                            events.RequestStart("onRequestStart(\"workItem_#=Id#\")");
                            events.RequestEnd("onRequestEnd(\"workItem_#=Id#\")");

                        })
                        .Model(model =>
                        {
                            model.Id(p => p.Id);
                            model.Field(p => p.TotalUnitCost).Editable(false);
                            model.Field(p => p.ProfitMargin).Editable(false);
                            model.Field(p => p.OverheadRate).Editable(false);
                        }
                        )
                        .Read(read => read.Action("WorkItemUnderWorkItem_Read", "ProjectTakeOff", new { parentWorkItemId = "#=Id#" }))
                        ).ClientDetailTemplateId("template_building")
                        .ToClientTemplate()
                        )

                    </text>
                    );

              }).ToClientTemplate()
    )
    #}#
</script>

