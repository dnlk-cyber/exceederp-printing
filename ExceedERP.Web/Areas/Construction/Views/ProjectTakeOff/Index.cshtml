        //} else {
        //    grid.dataSource.filter({});
        //}

        $.ajax({
            url: '@Url.Action("SetProjectId", "ProjectTakeOff")',
            //contentType: "application/json; charset=utf-8",
            data: { value: value },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

            }

        });
    }
    function filterWorkItem() {
        var value = this.value(),
          grid = $("#ProjectTakeOff").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "ProjectEstimationWorkItemId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }

        $.ajax({
            url: '@Url.Action("SetWorkItemId", "ProjectTakeOff")',
            //contentType: "application/json; charset=utf-8",
            data: { value: value },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

            }

        });
    }
