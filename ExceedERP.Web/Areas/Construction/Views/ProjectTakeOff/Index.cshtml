    function sync_handler(e) {
        this.read();
    }
    function openSpecificProjectView(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.ProjectInformationId;
        @*window.location.href = "@Url.Action("Project", "ProjectEstimation", new { area = "Construction", p = id })";*@
        window.location.href = "/Construction/ProjectTakeOff/Project?p=" + id;
    }
    function projectssGridDataBound(e) {
        $(".k-grid-CmdOpenProjectView").find("span").addClass("fa fa-expand ");
    }
    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }

    function filter() {
        //var value = this.value(),
