<script>
    function ConstructionPeriodChanged(e, id, defaultBAC){
        var periodId = $('#ConstructionPeriodId').val();
        $("#BAC").val(defaultBAC);
        $("#BAC").trigger("change");
        $.ajax({
            url: '@Url.Action("GetCalculatedBudgetedCostOfWorkScheduled", "EarnedValuePerProject", new {area = "Construction"})',
            data: { constructionPeriodId: periodId, projectId: id },
            type: 'POST',
            cache: false,
            success: function (result) {
                //var bcws = result[0];
                $("#BCWS").val(result);
                $("#BCWS").trigger("change");
            }

        });

        $.ajax({
            url: '@Url.Action("GetCalculatedBudgetedCostOfWorkPerformed", "EarnedValuePerProject", new {area = "Construction"})',
            data: { constructionPeriodId: periodId, projectId: id },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#BCWP").val(result);
                $("#BCWP").trigger("change");
            }

        });

        $.ajax({
            url: '@Url.Action("GetCalculatedActualCostOfWorkPerformed", "EarnedValuePerProject", new {area = "Construction"})',
            data: { constructionPeriodId: periodId, projectId: id },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#ACWP").val(result);
                $("#ACWP").trigger("change");
            }

        });
    }
</script>


