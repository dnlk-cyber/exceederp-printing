<legend>Earned Value Analysis | Analysis by Project</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.EVMProjectGeneralInfomationViewModel>()
        .Name("ProjectInformationgrid")
        .Columns(columns =>
        {
            columns.Bound(c => c.Name).Width(150);
            //columns.Bound(c => c.Code).Width(150);
            columns.Bound(c => c.ProjectType).Width(150);
            columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").EditorTemplateName("Branch").Width(150);
            columns.Bound(c => c.ContractAmount).Width(150).ClientTemplate(
                "# if (ContractAmount === 0) { #" +
                                            " -----" +
                                            "# } else {#" +
                                            "#: kendo.toString( ContractAmount, 'N2') #" +
                                            "# } #"
                );
            columns.Bound(c => c.Client).Width(150);

        })
        .Scrollable(h => h.Height(700))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        .Filterable()
        .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")")
                )
            .Model(model => model.Id(p => p.ProjectInformationId))
            .Read(read => read.Action("ProjectInformation_Read", "EarnedValuePerProject"))
        //.Create(create => create.Action("ProjectInformation_Create", "ProjectInformation"))
        //.Update(update => update.Action("ProjectInformation_Update", "ProjectInformation"))
        //.Destroy(destroy => destroy.Action("ProjectInformation_Destroy", "ProjectInformation"))
        ).ClientDetailTemplateId("monthly-records")
)

