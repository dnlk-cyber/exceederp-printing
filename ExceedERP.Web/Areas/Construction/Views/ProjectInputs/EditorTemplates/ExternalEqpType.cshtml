@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        //.Name("ExternalEqpTypes")
        .DataTextField("EquipmentName")
        .DataValueField("FleetsID")
        //.BindTo((IEnumerable)ViewData["ExternalEquipments"])
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetExternalEquipments", "DataProvider"));
        })
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)