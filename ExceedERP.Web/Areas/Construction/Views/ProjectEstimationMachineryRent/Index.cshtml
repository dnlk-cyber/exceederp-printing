@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Estimation Machinery Rent</legend>
<div>
    <div class="toolbar">
        <label class="category-label" for="ProjectEstimationNameId">Select Project Name:</label>
        @(Html.Kendo().DropDownListFor(m => m)

              .Name("ProjectEstimationNameId")
              .OptionLabel("Project Name..")
              .BindTo((IEnumerable)ViewData["ProjectList"])
              .DataTextField("ProjectName")
              .DataValueField("ProjectEstimationNameId")
              .HtmlAttributes(new { style = "width: 300px;" })
              .ValuePrimitive(true)
              .Events(x => x.Change("filter"))

        )
        <br />
    </div>
</div>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectMachineryRentHeader>()
          .Name("ProjectMachineryRentHeader")
      .Columns(columns =>
      {
        columns.Bound(c => c.FuelPurchase);
        columns.Bound(c => c.FuelCost);
        columns.Bound(c => c.FuelSupply);
        columns.Bound(c => c.FuelDistribution);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
           .Scrollable(h => h.Height(500))
                                                             .Groupable()
                                                                      .Sortable(sortable =>
                                                                      {
                                                                          sortable.SortMode(GridSortMode.SingleColumn);
                                                                      })
                                                          .Filterable()
                                                             .Pageable(pageable => pageable
                                                                                        .Input(true)
                                                                                        .Numeric(false)
                                                                                        .Refresh(true)
                                                                                        .PageSizes(true)
                                                                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                       .Events(events => events.Error("error_handler(\"ProjectMachineryRentHeader\")"))
          .Model(model =>
          {
              model.Id(p => p.ProjectEstimationMachineryRentId);
              model.Field(p => p.FuelSupply).Editable( false);
              model.Field(p => p.FuelDistribution).Editable(false);
          })
          .Read(read => read.Action("ProjectEstimationMachineryRent_Read", "ProjectEstimationMachineryRent"))
          .Create(create => create.Action("ProjectEstimationMachineryRent_Create", "ProjectEstimationMachineryRent"))
          .Update(update => update.Action("ProjectEstimationMachineryRent_Update", "ProjectEstimationMachineryRent"))
          .Destroy(destroy => destroy.Action("ProjectEstimationMachineryRent_Destroy", "ProjectEstimationMachineryRent"))
      )
)
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
    function filter() {
        var value = this.value(),
          grid = $("#ProjectMachineryRentHeader").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "ProjectEstimationNameId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }

        $.ajax({
            url: '@Url.Action("SetProjectId", "ProjectEstimationMachineryRent")',
            //contentType: "application/json; charset=utf-8",
            data: { value: value },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

            }

        });
    }
</script>