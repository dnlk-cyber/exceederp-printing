@using ExceedERP.Core.Localization
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Setting | Reinforcement Bars</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.DeformedBar>()
      .Name("deformedBarGrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.ItemCode, (IEnumerable)ViewData["ReinforcementBars"], "ItemCode", "Name").EditorTemplateName("DeformedBars");
          //columns.Bound(c => c.ResourceTypeId);
          //columns.Bound(c => c.Name);
          //columns.Bound(c => c.ConcatnatedCode);
          columns.Bound(c => c.Diameter).Title("Diameter (mm)");
          columns.Bound(c => c.UnitWeight);

          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Resources").Window(window => { window.Title("Resource"); window.Scrollable(false); }))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Scrollable(h => h.Height(500))
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(events =>
          {
              events.Error("error_handler(\"deformedBarGrid\")");
              events.RequestStart("onRequestStart(\"deformedBarGrid\")");
              events.RequestEnd("onRequestEnd(\"deformedBarGrid\")");
          })
          .Model(model => {
                              model.Id(res => res.DeformedBarId);
                              model.Field(res => res.UnitWeight).Editable(false);
          })
          .Read(read => read.Action("DeformedBars_Read", "DeformedBar"))
          .Create(create => create.Action("DeformedBar_Create", "DeformedBar"))
          .Update(update => update.Action("DeformedBar_Update", "DeformedBar"))
          .Destroy(destroy => destroy.Action("DeformedBar_Destroy", "DeformedBar"))
      ))
