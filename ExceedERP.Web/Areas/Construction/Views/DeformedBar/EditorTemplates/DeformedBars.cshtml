@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        //.Name("deformedBarsList")
        .DataTextField("Name")
        .DataValueField("ItemCode")
        //.BindTo((IEnumerable)ViewData["ReinforcementBars"])
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetAvailableDeformedBars", "DataProvider"));
            //.ServerFiltering(true);
        })
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)