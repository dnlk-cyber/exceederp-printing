<script>
    var workItemIdToCopyResourceFrom = 0;
    function copySourceIdToClipBoard(workItemId) {
        workItemIdToCopyResourceFrom = workItemId;
    }
    function pasteSourceIdFromClipBoardToDestinationItem(itemId) {
        if (workItemIdToCopyResourceFrom > 0 && itemId > 0) {
            copyResourcesFromSourceItemToDestinationItem(workItemIdToCopyResourceFrom, itemId)
        }
    }
    function copyResourcesFromSourceItemToDestinationItem(src, destination) {
        //alert("Source: " + src + " and destination: " + destination);
        $.ajax({
            type: "POST",
            url: '@Url.Action("copyResourcesFromSourceItemToDestinationItem", "ProjectEstimationDetail", new { area = "Construction" })',
            data: { sourceId: src, destinationId: destination },
            success: function (result) {
                alert(result.Message);
                //recordStatus = result.Status;
                //location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
    function deleteAllWorkItemResources(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("DeleteAllResourcesUnderWorkItem", "ProjectEstimationDetail", new { area = "Construction" })',
            data: { id: id},
            success: function (result) {
                alert(result.Message);
            }, 
            error: function (result) {
                alert(result);
            }
        });
    }
    function sync_handler(e) {
        this.read();
    }

    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }

    function filterCategories() {
        // 
        // summary:
        //      send the filtering text along with the parent widget's value
        var dropdownlist = $("#ItemCode").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            ItemCategoryCode: $("#ItemCategoryCode").val(), filterString: filterInput.val()
        };
    }
    function filterType() {
        return {
            EquipmentIdentityID: $("#EquipmentIdentityID").val()
        };
    }
    function FilterAsset() {
        return {
            EquipmentTypeID: $("#EquipmentTypeID").val()
        };
    }
    function Refresh() {
        window.location.reload();
    }

    function detailedViewClicked(e) {
        e.preventDefault();
        window.location.href = "@Url.Action("Index", "ProjectEstimationDetail")";
    }
    function materialChanged(e) {
        var itmCode = $('#ItemCode').val();
        $.ajax({
            url: '@Url.Action("GetUnitPrice", "ProjectMaterial", new {area = "Construction"})',
            data: { itemCode: itmCode },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#UnitPrice").val(result);
                $("#UnitPrice").trigger("change");
            }

        });
    }
    function laborDropDownListChanged(e) {
        var jobTitleId = $('#ProjectEstimationIndexLabourId').val();
        $.ajax({
            url: '@Url.Action("GetIndexedHourlyPayPerJobTitle", "ProjectDirectLabour", new {area = "Construction"})',
            data: { id: jobTitleId },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#IndexedHourlySalary").val(result);
                $("#IndexedHourlySalary").trigger("change");
            }

        });
    }
    function equipmentDropDownList(e) {
        var fleetId = $('#FleetsID').val();
        $.ajax({
            url: '@Url.Action("GetRentalRate", "ProjectEquipment", new {area = "Construction"})',
            data: { id: fleetId },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#RentalCost").val(result);
                $("#RentalCost").trigger("change");
            }

        });
    }
</script>

<script>
    function OnChange(e) {
        var grid = e.select;
        var selectedRows = this.select();
        var rowData = this.dataItem(selectedRows[0]);
        var Quantity = rowData.Quantity;
        var UnitPrice = rowData.Quantity;
        $("#TotalCost").val(Quantity * UnitPrice);
    }

     function calculateWorkItemTransportCost(e, projId, totalMaterialCost) {
        $("#TotalMaterailCost").val(totalMaterialCost);
        $("#TotalMaterailCost").trigger("change");

        $.ajax({
            url: '@Url.Action("GetProjectTransportCostRate", "WorkItemTransportCost", new { area = "Construction" })',
            data: { projectId: projId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                $("#TransportCostRate").val(r);
                $("#TransportCostRate").trigger("change");

                $("#CalculatedTransportCost").val((Number(r) / 100) * Number(totalMaterialCost));
                $("#CalculatedTransportCost").trigger("change");
            }
        });

        var transportRateField = $("#TransportCostRate");
        transportRateField.bind('blur', function () {
            var rate = transportRateField.val();
            var total = $('#TotalMaterailCost').val();
            $("#CalculatedTransportCost").val((Number(rate) / 100) * Number(total));
            $("#CalculatedTransportCost").trigger("change");
        });
        var totalCostField = $("#TotalMaterailCost");
        totalCostField.bind('blur', function () {
            var rate = $('#TransportCostRate').val();
            var total = totalCostField.val();
            $("#CalculatedTransportCost").val((Number(rate) / 100) * Number(total));
            $("#CalculatedTransportCost").trigger("change");
        });
    }
</script>

