<script id="workItem_detail" type="text/kendo-tmpl">
    #if(!IsSubCategory && !ContainsWorkItemAsInput){#
        @(Html.Kendo().TabStrip()
        .Name("tabstrip_#=Id#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Detail").Content(
            @<text>
                <a onclick='return copySourceIdToClipBoard("#=Id#")' href=' \#' title="Copy Resources(material, labor and equipment) from this work item"><i class="fa fa-copy fa-1x"></i></a>
                &nbsp;
                <a onclick='return pasteSourceIdFromClipBoardToDestinationItem("#=Id#")' href=' \#' title="Paste Resources(material, labor and equipment) to this work item"><i class="fa fa-paste fa-1x"></i></a>
                &nbsp;&nbsp;
                <text style="font-size:20px;">|</text>
                &nbsp;&nbsp;
                <a onclick='return deleteAllWorkItemResources("#=Id#")' href=' \#' title="Delete Resources(material, labor and equipment) of this item"><i class="fa fa-trash fa-1.5x"></i></a>
                <br />
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.WorkItemDetailViewModel>()
                            .Name("detail__#=Id#")
                            .Columns(columns =>
                            {
                                        columns.Bound(c => c.Attribute).Title(" ").ClientTemplate("\\#=Attribute\\#: \\#=Value\\#");
                                    })

                                .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Events(events =>
                                {
                                            events.Error("error_handler(\"detail__#=Id#\")");
                                            events.RequestStart("onRequestStart(\"detail__#=Id#\")");
                                            events.RequestEnd("onRequestEnd(\"detail__#=Id#\")");
                                        })
                                .Model(model =>
                                {
                                            model.Id(p => p.Id);
                                        })
                                .Read(read => read.Action("SpecificWorkItemDetail_Read", "GenericWorkItemPerProject", new { workItemId = "#=Id#" }))
                            ).ToClientTemplate()
                            )
                        </text>);

                    items.Add().Text("Material Cost").Content(
            @<text>
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.GenericProjectMaterial>()
                                        .Name("ProjectMaterial_#=Id#")
                                        .Columns(columns =>
                                        {
                                            columns.ForeignKey(c => c.ItemCategoryCode, (IEnumerable)ViewData["ItemCategorys"], "ItemCategoryCode", "Name").EditorTemplateName("ItemCategory").Width(200);
                                            columns.ForeignKey(c => c.ItemCode, (IEnumerable)ViewData["Items"], "ItemCode", "Name").EditorTemplateName("Item").Width(200);
                                            columns.Bound(c => c.Unit).Width(100);//, (IEnumerable)ViewData["Unit"], "LookupId", "Description").EditorTemplateName("Unit").Width(75);
                                            columns.Bound(c => c.Quantity).Width(75);
                                            columns.Bound(c => c.UnitPrice).Width(75).Format("{0:N2}");
                                            columns.Bound(c => c.TotalCost).Width(75)
                                                .ClientFooterTemplate("Total: \\#= kendo.toString(sum, 'N2')\\#")
                                                .ClientGroupFooterTemplate("Total: \\#= kendo.toString(sum, 'N2')\\#");
                                            columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);

                                        })
                                        .ToolBar(toolbar =>
                                        {
                                            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                        })
                                        //.Events(e => e.Save("actionSave"))
                                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                                        .Selectable(selectable =>
                                        {
                                            selectable.Mode(GridSelectionMode.Single);
                                            selectable.Type(GridSelectionType.Row);
                                        })
                                        //.Scrollable(h => h.Height(500))
                                        .Pageable(pageable => pageable
                                                            .Input(true)
                                                            .Numeric(false)
                                                            .Refresh(true)
                                                            .PageSizes(true)
                                                            .ButtonCount(5))
                                        .DataSource(dataSource => dataSource
                                            .Ajax()
                                            .Events(events =>
                                            {
                                                events.Error("error_handler(\"ProjectMaterial_#=Id#\")");
                                                events.RequestStart("onRequestStart(\"ProjectMaterial_#=Id#\")");
                                                events.RequestEnd("onRequestEnd(\"ProjectMaterial_#=Id#\")");
                                            })
                                            .Aggregates(aggregates =>
                                            {
                                                aggregates.Add(p => p.TotalCost).Sum();
                                                aggregates.Add(p => p.Quantity).Sum();
                                                aggregates.Add(p => p.UnitPrice).Sum();
                                            })
                                            .Model(model =>
                                            {
                                                model.Id(p => p.GenericProjectMaterialId);
                                                model.Field(p => p.TotalCost).Editable(false);
                                                model.Field(p => p.Unit).Editable(false);
                                                //model.Field(p => p.UnitPrice).Editable(false);
                                            })
                                            .Read(read => read.Action("ProjectMaterial_Read", "GenericProjectMaterial", new { id = "#=Id#" }))
