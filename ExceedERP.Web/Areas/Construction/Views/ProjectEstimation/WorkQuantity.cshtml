<script>
    var selectedProjectId = 0;
    function filterGridWhenProjectChanged(e) {
        var projectId = $("#ProjectInformationId").data("kendoDropDownList").value();
        selectedProjectId = projectId;
        var workItemGrid = $("#workItems").data("kendoGrid");
        workItemGrid.dataSource.read();

        //var div = $("#importQuantityDiv");
        //if (projectId) {
        //    div.show();
        //}
        //else {
        //    db.hide();
        //}
        //workItemGrid.dataSource.filter({ field: "ProjectInformationId", operator: "eq", value: parseInt(projectId) });
    }
    function sync_handler(e) {
        this.read();
    }
    function importFromExcel() {
        var workItemGrid = $("#workItems").data("kendoGrid");

    }
    //function customCommand(e) {
    //    //alert("Clicked");
    //    var param = this.element.attr("param");
    //    var grid = $("#" + param).data("kendoGrid");
    //    //var grid = e.sender();
    //    grid.dataSource.read();
    //}
    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }
    function showFileBrowseForm() {
        var icHide = $("#hideBrowseWindow");
        icHide.show();
        $("#importQuantityDiv").show();
        var icShow = icShow = $("#showBrowseWindow");
        icShow.hide();
    }
    function hideFileBrowseForm() {
        var icHide = $("#hideBrowseWindow");
        icHide.hide();
        $("#importQuantityDiv").hide();
        var icShow = icShow = $("#showBrowseWindow");
        icShow.show();
    }
    function projectDropDownChanged() {
        return {
            currentProjectId: selectedProjectId
        };
    }
    function filterCategories() {
        //
        // summary:
        //      send the filtering text along with the parent widget's value
        var dropdownlist = $("#ItemCode").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            ItemCategoryCode: $("#ItemCategoryCode").val(), filterString: filterInput.val()
        };
    }
    function filterType() {
        return {
            EquipmentIdentityID: $("#EquipmentIdentityID").val()
        };
    }
    function FilterAsset() {
        return {
            EquipmentTypeID: $("#EquipmentTypeID").val()
        };
    }
    function Refresh() {
        window.location.reload();
    }

    function detailedViewClicked(e) {
        e.preventDefault();
        window.location.href = "@Url.Action("Index", "ProjectEstimationDetail")";
    }
    function materialChanged(e) {
        var itmCode = $('#ItemCode').val();
        $.ajax({
            url: '@Url.Action("GetUnitPrice", "ProjectMaterial", new {area = "Construction"})',
            data: { itemCode: itmCode },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#UnitPrice").val(result);
                $("#UnitPrice").trigger("change");
            }

        });
    }
    function laborDropDownListChanged(e) {
        var jobTitleId = $('#ProjectEstimationIndexLabourId').val();
        $.ajax({
            url: '@Url.Action("GetIndexedHourlyPayPerJobTitle", "ProjectDirectLabour", new {area = "Construction"})',
            data: { id: jobTitleId },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#IndexedHourlySalary").val(result);
                $("#IndexedHourlySalary").trigger("change");
            }

        });
    }
    function equipmentDropDownList(e) {
        var fleetId = $('#FleetsID').val();
        $.ajax({
            url: '@Url.Action("GetRentalRate", "ProjectEquipment", new {area = "Construction"})',
            data: { id: fleetId },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#RentalCost").val(result);
                $("#RentalCost").trigger("change");
            }

        });
    }
</script>

