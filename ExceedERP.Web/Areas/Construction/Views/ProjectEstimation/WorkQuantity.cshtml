    function OnChange(e) {
        var grid = e.select;
        var selectedRows = this.select();
        var rowData = this.dataItem(selectedRows[0]);
        var Quantity = rowData.Quantity;
        var UnitPrice = rowData.Quantity;
        $("#TotalCost").val(Quantity * UnitPrice);
    }

    function workItemsGridDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");

        //for (var i = 0; i < gridRows.length; i++) {
        //    var row = $(gridRows[i]);

        //    row.addClass("custom-info-row");
        //}
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            if (dataItem.HasParent === true) {
                row.addClass("custom-info-row");
            }
        }
    }
