@using ExceedERP.Core.Localization
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Estimation | Work Item Quantity Estimation</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.GenericWorkItemPerProjectViewModel>()
                          .Name("workItems")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.SubProjectTypeName).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "#=value#"
                                  );
                              columns.Bound(c => c.StructureyType).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "#=value#"
                                  );
                              columns.Bound(c => c.WorkCategory).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "#=value#"
                                  );
                              columns.Bound(c => c.Id).Width(50);
                              columns.Bound(c => c.ItemName).Width(260).Title("Item Name");
                              columns.Bound(c => c.UnitOfMeasurement).Width(40).Title("UoM").Filterable(false);
                              columns.Bound(c => c.TotalQuantityOfWork).Width(70).ClientTemplate(
                                        "# if (IsSubCategory) { #" +
                                            " -----" +
                                            "# } else {#" +
                                            "#: kendo.toString( TotalQuantityOfWork, 'N2') #" +
                                            "# } #"
                                        );
                              //columns.Bound(c => c.LabourHourlyOutPut).Width(100).ClientTemplate(
                              //     "# if (IsSubCategory) { #" +
                              //            " -----" +
                              //            "# } else {#" +
                              //            "#: kendo.toString( LabourHourlyOutPut, 'N2') #" +
                              //            "# } #"
                              //        );

                              columns.Bound(c => c.TotalUnitCost).Width(80).ClientTemplate(
                                  "# if (IsSubCategory) { #" +
                                          " -----" +
                                          "# } else {#" +
                                          "#: kendo.toString( TotalUnitCost, 'N2') #" +
                                          "# } #"
                                      );
                              columns.Bound(c => c.ItemCode).Width(70);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                              }).Width(100);
                          })
                          //.ToolBar(toolBar =>
                          //{
                          //    toolBar.Excel();
                          //    //toolBar.Custom().Name("importQuantity").Url("\\#").Text(" Import Quantity From Excel").HtmlAttributes(new { @type = "button", @onclick = "customCommand()", param = "workItems_#=ProjectInformationId#" });
                          //})
                          .ToolBar(toolbar =>
                          {
                          toolbar.Template(@<text>

                            <label class="category-label">Project; &nbsp;</label>
                            @(Html.Kendo().DropDownList()
                                                .Name("ProjectInformationId")
                                                .OptionLabel("Select ...")
                                                .DataSource(source =>
                                                {
                                                    source.Read(read =>
                                                    {
                                                        read.Action("GetAllProjects", "DataProvider", new { area = "Construction" });
                                                    });
                                                })
                                                .Filter("contains")
                                                .DataTextField("Name")
                                                .DataValueField("ProjectInformationId")
                                                .HtmlAttributes(new { style = "width: 250px;" })
                                                .ValuePrimitive(true)
                                                .Events(x => x.Change("filterGridWhenProjectChanged"))

                            )
                            &nbsp;
                            <a class="k-button k-button-icontext k-grid-excel" href='#'><span class="k-icon k-i-excel"></span>Excport to Excel</a>
                            @*<a onclick='return importFromExcel()' class="k-button k-button-icontext " href='#'><span class="k-icon k-i-plus"></span>Import Quantity From Excel</a>*@

                            <div class="pull-right" style="margin-right:20px; width:400px">
                                <div class="row">
                                    <div class="col-md-11">
                                        <div id="importQuantityDiv" hidden>
                                            <h4>Note:</h4>
                                            <p>
                                                For effective update, export the required work items to excel and do the
                                                necessary modifications there and import the excel file(s) back .....
                                            </p>
                                            <form method="post" action='@Url.Action("ImportQuantitiesFromExcel")'>
                                                <div class="demo-section k-content">
                                                    @(Html.Kendo().Upload()
                                                                            .Name("file")
                                                                            .Messages(msg =>
                                                                            {
                                                                                msg.Select("Browse  Excel file ....");
                                                                            })
                                                    )
                                                    <p style="padding-top: 1em; text-align: right">
                                                        <input type="submit" value="Submit" class="k-button k-primary" />
                                                    </p>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                    <div class="col-md-1 pull-right">
                                        <a href='#' id="showBrowseWindow" title="show file browse form "><i class="fa fa-chevron-down" onclick='return showFileBrowseForm()'></i></a>
                                        <a href='#' id="hideBrowseWindow" onclick='return hideFileBrowseForm()' title="hide file browse form " hidden><i class="fa fa-chevron-up"></i></a>

                                    </div>
                                </div>

                            </div>

                        </text>);
                          })
                          .Excel(excel => excel
                            .FileName("Work Items Export.xlsx")
                            //.Filterable(true)
                            //.AllPages(true)
                            .ProxyURL(Url.Action("Excel_Export_Save", "ProjectEstimation", new { area = "Construction" }))
                            )
                            .Filterable()
                          .Scrollable(h => h.Height(700))
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Events(ev =>
                          {
                              ev.DataBound("workItemsGridDataBound");
                          })
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          //.Events(e => e.Edit("onEdit"))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .PageSize(100)
                              .Sort(srt =>
                              {
                                  srt.Add(f => f.ItemCode).Ascending();
                              })
                              .Group(g =>
                              {
                                  g.Add(f => f.SubProjectTypeName);
                                  g.Add(f => f.StructureyType);
                                  g.Add(f => f.WorkCategory);
                              })
                              .Events(events =>
                              {
                                  events.Error("error_handler(\"workItems\")");
                                  events.RequestStart("onRequestStart(\"workItems\")");
                                  events.RequestEnd("onRequestEnd(\"workItems\")");
                              })

                              .Model(model =>
                              {
                                  model.Id(p => p.Id);
                                  model.Field(p => p.Id).Editable(false);
                                  model.Field(p => p.TotalUnitCost).Editable(false);
                                  model.Field(p => p.SubProjectTypeName).Editable(false);
                                  model.Field(p => p.WorkCategory).Editable(false);
                                  model.Field(p => p.StructureyType).Editable(false);
                                  model.Field(p => p.UnitOfMeasurement).Editable(false);
                                  model.Field(p => p.ProfitMargin).Editable(false);
                                  model.Field(p => p.OverheadRate).Editable(false);
                                  model.Field(p => p.ItemName).Editable(false);
                                  model.Field(p => p.LabourHourlyOutPut).Editable(false);
                                  model.Field(p => p.ItemCode).Editable(false);
                              }
                              )
                              .Read(read => read.Action("WorkItemsForQualityImportExport_Read", "ProjectEstimation").Data("projectDropDownChanged"))
                          //.Create(create => create.Action("WorkItemPerProject_Create", "ProjectList"))
                          .Update(update => update.Action("WorkItemForQualityImportExport_Update", "ProjectEstimation"))
                          //.Destroy(destroy => destroy.Action("WorkItem_Destroy", "ProjectEstimation"))
                          ).ClientDetailTemplateId("workItem_detail")
)

