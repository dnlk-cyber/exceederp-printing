@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Internal Equipment Rent</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.InternalMachinaryRent>()
          .Name("ExternalMachinaryRentgrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["Items"], "ItemCode", "Name").EditorTemplateName("Item").Width(200);
        columns.Bound(c => c.PurchaseCost).Width( 150);
        columns.Bound(c => c.MaximumLife).Width( 150);
        columns.Bound(c => c.DepCostPerHour).Width( 180);
        columns.Bound(c => c.DailyRentalCost).Width( 150);
        columns.Bound(c => c.Remark);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
                                                                                             .Groupable()
                                                                                                      .Sortable(sortable =>
                                                                                                      {
                                                                                                          sortable.SortMode(GridSortMode.SingleColumn);
                                                                                                      })
                                                                                          .Filterable()
                                                                                             .Pageable(pageable => pageable
                                                                                                                        .Input(true)
                                                                                                                        .Numeric(false)
                                                                                                                        .Refresh(true)
                                                                                                                        .PageSizes(true)
                                                                                                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                        .Events(events => events.Error("error_handler(\"ExternalMachinaryRentgrid\")")

                                                                //  .Sync("sync_handler")
                                                                  )
          .Model(model =>
          {
              model.Id(p => p.InternalMachinaryRentId);
              model.Field( p => p.DailyRentalCost).Editable( false);
              model.Field(p => p.DepCostPerHour).Editable(false);
              model.Field(p => p.PurchaseCost).Editable(false);
          })
                  .Read(read => read.Action("ExternalMachinaryRent_Read", "InternalMachinaryRent"))
              .Create(create => create.Action("ExternalMachinaryRent_Create", "InternalMachinaryRent"))
              .Update(update => update.Action("ExternalMachinaryRent_Update", "InternalMachinaryRent"))
              .Destroy(destroy => destroy.Action("ExternalMachinaryRent_Destroy", "InternalMachinaryRent"))
      )
)
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
</script>