@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend><a onclick='return goToAllProjects()' href='/Construction/ProjectEstimationDetail/' title="Back To All Projects"><i class="fa fa-chevron-circle-left fa-1.5x"></i></a> &nbsp; &nbsp; Project Estimation / @ViewBag.Project</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.GenericWorkItemPerProjectViewModel>()
                              .Name("workItems")
                              .Columns(columns =>
                              {
                                  columns.Bound(c => c.SubProjectTypeName).Hidden(true)
                                  .ClientGroupHeaderTemplate(
                                      "#=value#"
                                      );
                                  columns.Bound(c => c.StructureyType).Hidden(true)
                                  .ClientGroupHeaderTemplate(
                                      "#=value#"
                                      );
                                  columns.Bound(c => c.WorkCategory).Hidden(true)
                                  .ClientGroupHeaderTemplate(
                                      "#=value#"
                                      );
                                  columns.Bound(c => c.ItemName).Width(260).Title("Item Name");
                                  //columns.Bound(c => c.UnitOfMeasurement).Width(30).Title("UoM").Filterable(false);
                                  columns.ForeignKey(c => c.UnitOfMeasurementId, (IEnumerable)ViewData["uom"], "UnitOfMeasurementId", "Abbreviation").Filterable(false).EditorTemplateName("Unit").Width(75);
                                  columns.Bound(c => c.TotalQuantityOfWork).Width(50).Filterable(false).ClientTemplate(
                                            "# if (IsSubCategory) { #" +
                                                " -----" +
                                                "# } else {#" +
                                                "#: kendo.toString( TotalQuantityOfWork, 'N4') #" +
                                                "# } #"
                                            );
                                  columns.Bound(c => c.LabourHourlyOutPut).Width(50).Filterable(false).ClientTemplate(
                                       "# if (IsSubCategory) { #" +
                                              " -----" +
                                              "# } else {#" +
                                              "#: kendo.toString( LabourHourlyOutPut, 'N4') #" +
                                              "# } #"
                                          );

                                  columns.Bound(c => c.TotalUnitCost).Width(80).Filterable(false).ClientTemplate(
                                                  "# if (IsSubCategory) { #" +
                                                          " -----" +
                                                          "# } else {#" +
                                                          "#: kendo.toString( TotalUnitCost, 'N4') #" +
                                                          "# } #"
                                                      );
                                  columns.Bound(c => c.ItemCode).Width(70);
                                  columns.Command(command =>
                                  {
                                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                      command.Destroy().Text(Resources.ActionButton_Cancel);
                                  }).Width(150);

                              })
                              .Scrollable(h => h.Height(700))
                              .Filterable()
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                              .Selectable(selectable =>
                              {
                                  selectable.Mode(GridSelectionMode.Single);
                                  selectable.Type(GridSelectionType.Row);
                              })
                              .Pageable(pageable => pageable
                                  .Input(true)
                                  .Numeric(false)
                                  .Refresh(true)
                                  .PageSizes(true)
                                  .ButtonCount(5))
                              //.Events(e => e.Edit("onEdit"))
                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .PageSize(50)
                                  .Sort(srt =>
                                  {
                                      srt.Add(f => f.ItemCode).Ascending();
                                  })
                                  .Events(events =>
                                  {
                                      events.Error("error_handler(\"workItems\")");
                                      events.RequestStart("onRequestStart(\"workItems\")");
                                      events.RequestEnd("onRequestEnd(\"workItems\")");
                                  })
                                  .Group(g =>
                                  {
                                      g.Add(f => f.SubProjectTypeName);
                                      //g.Add(f => f.StructureTypeCode);
                                      g.Add(f => f.StructureyType);
                                      g.Add(f => f.WorkCategory);
                                  })
                                  .Aggregates(ag => ag.Add(f => f.StructureyType).ToString())
                                  .Model(model =>
                                  {
                                      model.Id(p => p.Id);
                                      model.Field(p => p.TotalUnitCost).Editable(false);
                                      model.Field(p => p.SubProjectTypeName).Editable(false);
                                      model.Field(p => p.WorkCategory).Editable(false);
                                      model.Field(p => p.StructureyType).Editable(false);
                                      //model.Field(p => p.UnitOfMeasurement).Editable(false);
                                      model.Field(p => p.ProfitMargin).Editable(false);
                                      model.Field(p => p.OverheadRate).Editable(false);
                                  }
                                  )
                                  .Read(read => read.Action("WorkItem_Read", "ProjectEstimation").Data("getIdOfOpenedProject"))
                                  .Update(update => update.Action("WorkItem_Update", "ProjectEstimation"))
                                .Destroy(destroy => destroy.Action("WorkItem_Destroy", "ProjectEstimation"))
                              ).ClientDetailTemplateId("workItem_detail")
    //.ToClientTemplate()
)

