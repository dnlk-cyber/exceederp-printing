@using ExceedERP.Core.Localization
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Estimation</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
      .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Name).Width(300);
          //columns.Bound(c => c.ProjectInformationId).Width(300);
          columns.Bound(c => c.Code).Width(80).Title("Code");
          columns.Bound(c => c.ProjectType).ClientGroupHeaderTemplate(
              "# if (value === 0) { #" +
                " Building ( #= aggregates.ProjectInformationId.count # projects)" +
              "# } else if (value === 1) {#" +
                " Road ( #= aggregates.ProjectInformationId.count # projects)" +
              "# } else if (value === 2) {#" +
                " Dam ( #= aggregates.ProjectInformationId.count # projects)" +
              "# } else if (value === 3) {#" +
                " Irrigation ( #= aggregates.ProjectInformationId.count # projects)" +
              "# } #"
              ).Hidden(true);
          columns.Bound(c => c.ProjectScope);
          columns.Bound(c => c.Consultant);
          columns.Bound(c => c.Client);
          columns.Command(command =>
          {
              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
              command.Destroy().Text(Resources.ActionButton_Cancel);
              command.Custom("CmdOpenProjectView").Text("&nbsp;&nbsp;Expand").Click("openSpecificProjectView").IconClass("fa fa-expand &nbsp;");
          }).Width(300);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Template(
            @<text>
                <div class="toolbar row">
                    <div class="col-md-2">
                        <a class="k-button k-button-icontext k-grid-add" href='#'><span class="k-icon k-i-plus"></span>Add New</a>
                    </div>
                    <div class="pull-right" style="margin-right:20px;">
                        <a href='/Construction/ProjectEstimation/' title="Change to Collapsed View Mode"><i class="fa fa-compress fa-2x"></i></a>
                        @*@Html.Kendo().Button().Name("goCllapsedView").Content("Collapsed View").Events(events => events.Click("collapseViewClicked")).Icon("k-icon k-i-plus").HtmlAttributes(new { @class = "btn btn-primary" })*@
                    </div>
                </div>
            </text>);
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ProjectInformation").Window(window => { window.Title("Project Information"); window.Scrollable(false); }))
      .Scrollable(h => h.Height(700))
      ////.Groupable()
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Events(ev =>
      {
          ev.DataBound("projectsGridDataBound");
      })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .PageSize(20)
          .Group(groups =>
          {
              groups.Add(p => p.ProjectType);
          })
          .Aggregates(ag =>
          {
              ag.Add(f => f.ProjectInformationId).Count();
          })
          .Events(events =>
          {
              events.Error("error_handler(\"ProjectInformationgrid\")");
              events.RequestStart("onRequestStart(\"ProjectInformationgrid\")");
              events.RequestEnd("onRequestEnd(\"ProjectInformationgrid\")");

          })

          .Model(model => model.Id(p => p.ProjectInformationId))
          .Read(read => read.Action("ProjectInformation_Read", "ProjectEstimationDetail"))
          .Create(create => create.Action("ProjectInformation_Create", "ProjectEstimationDetail"))
          .Update(update => update.Action("ProjectInformation_Update", "ProjectEstimationDetail"))
          .Destroy(destroy => destroy.Action("ProjectInformation_Destroy", "ProjectEstimationDetail"))
      ).ClientDetailTemplateId("template")
)

