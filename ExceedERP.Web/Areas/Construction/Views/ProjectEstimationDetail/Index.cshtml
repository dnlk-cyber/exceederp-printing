    function calculateWorkItemTransportCost(e, projId, totalMaterialCost) {
        $("#TotalMaterailCost").val(totalMaterialCost);
        $("#TotalMaterailCost").trigger("change");

        $.ajax({
            url: '@Url.Action("GetProjectTransportCostRate", "WorkItemTransportCost", new { area = "Construction" })',
            data: { projectId: projId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                $("#TransportCostRate").val(r);
                $("#TransportCostRate").trigger("change");

                $("#CalculatedTransportCost").val((Number(r) / 100) * Number(totalMaterialCost));
                $("#CalculatedTransportCost").trigger("change");
            }
        });

        var transportRateField = $("#TransportCostRate");
        transportRateField.bind('blur', function () {
            var rate = transportRateField.val();
            var total = $('#TotalMaterailCost').val();
            $("#CalculatedTransportCost").val((Number(rate) / 100) * Number(total));
            $("#CalculatedTransportCost").trigger("change");
        });
        var totalCostField = $("#TotalMaterailCost");
        totalCostField.bind('blur', function () {
            var rate = $('#TransportCostRate').val();
            var total = totalCostField.val();
            $("#CalculatedTransportCost").val((Number(rate) / 100) * Number(total));
            $("#CalculatedTransportCost").trigger("change");
        });
    }
</script>

