@helper RenderWorkItemTransportCostGrid() { 
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.GenericWorkItemTransportCostViewwModel>()
        .Name("workItemTransport_#=GenericWorkItemPerProjectId#")
        .Columns(columns =>
        {
            columns.Bound(c => c.TotalMaterailCost).Format("{0:N2}");
            columns.Bound(c => c.TransportCostRate).Format("{0:N2}");
            columns.Bound(c => c.CalculatedTransportCost).Format("{0:N2}");
            columns.Command(command =>
            {
                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);

        })
        .ToolBar(toolbar =>
        {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
        })
        //.Events(e => e.Save("actionSave"))
        .Events(events => events.Edit(
            @<text>
                function(e) {
                calculateWorkItemTransportCost(e, "#=ProjectInformationId#", "#=MaterialCostPerUnit#")
                }
            </text>
        ))
        .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        //.Scrollable(h => h.Height(500))
        //.Events(e => e.Change("OnChange"))
        .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events =>
            {
                events.Error("error_handler(\"workItemTransport_#=GenericWorkItemPerProjectId#\")");
                events.RequestStart("onRequestStart(\"workItemTransport_#=GenericWorkItemPerProjectId#\")");
                events.RequestEnd("onRequestEnd(\"workItemTransport_#=GenericWorkItemPerProjectId#\")");

            })

                                                                       
            .Model(model =>
            {
                model.Id(p => p.ItemId);
                //model.Field(p => p.TotalCost).Editable(false);
                //model.Field(p => p.Unit).Editable(false);
                //model.Field(p => p.UnitPrice).Editable(false);
            })
            .Read(read => read.Action("WorkItemTransportCost_Read", "WorkItemTransportCost", new { id = "#=GenericWorkItemPerProjectId#" }))
            .Create(create => create.Action("WorkItemTransportCost_Create", "WorkItemTransportCost", new { id = "#=GenericWorkItemPerProjectId#" }))
            .Update(update => update.Action("WorkItemTransportCost_Update", "WorkItemTransportCost"))
            .Destroy(destroy => destroy.Action("WorkItemTransportCost_Destroy", "WorkItemTransportCost"))
        ).ToClientTemplate()
)
    }

