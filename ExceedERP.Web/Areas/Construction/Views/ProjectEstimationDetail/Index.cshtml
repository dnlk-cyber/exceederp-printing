    //$(document).ready(function () {
    //    var btn = ("#loadingButton");
    //    btn.hide();
    //});
    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }
    function subProjectTypeDataBound(e) {
        var grid = this;
        $(".btnUp").on("click", function (e) {
            var selectedItem = $(this).closest("tr");
            //var itemIndex = selectedItem.index();
            var selectedUid = selectedItem.attr("data-uid");
            var dataItem = grid.dataItem(selectedItem);
            var itemIndex = dataItem.OrderIndex;
            var id = dataItem.SubProjectTypeId;
            //alert("existing order: " + itemIndex);
            var newIndex = itemIndex - 1;
            //alert("new order: " + newIndex);

            if (newIndex <= 1) {
                newIndex = 1;
            }
            if (itemIndex != newIndex) {
                $.ajax({
                type: "POST",
                    url: '@Url.Action("UpdateSubProjectTypeOrder", "SubProjectType", new { area = "Construction" })',
                    data: { id: id, oldOrderIndex: itemIndex, newOrderIndex: newIndex },
                cache: false,
                success: function (result) {
                    grid.dataSource.read();
                    grid.select("[data-uid=" + selectedUid + "]");
                }, //end succ
                error: function (result) {
                }
            });
            }
        });
        $(".btnDown").on("click", function (e) {
            var selectedItem = $(this).closest("tr");
            var selectedUid = selectedItem.attr("data-uid");
            //var itemIndex = selectedItem.index();
            var dataItem = grid.dataItem(selectedItem);
            var itemIndex = dataItem.OrderIndex;
            var id = dataItem.SubProjectTypeId;
            //alert("existing order: " + itemIndex);
            var newIndex = itemIndex + 1;
            //alert("new order: " + newIndex);
            
            if (newIndex > grid.dataSource.view().length) {
                newIndex = grid.dataSource.view().length;
            }
            if (itemIndex != newIndex) {
                $.ajax({
                type: "POST",
                    url: '@Url.Action("UpdateSubProjectTypeOrder", "SubProjectType", new { area = "Construction" })',
                    data: { id: id, oldOrderIndex: itemIndex, newOrderIndex: newIndex },
                cache: false,
                success: function (result) {
                    grid.dataSource.read();
                }, 
                error: function (result) {
                }
            });
            }
        });
    }
    function syncEstimationData(id) {
        var recordStatus = "";

        var btn = $("#syncButton");
        btn.hide();
        var bt = $("#loadingButton");
        bt.show();
        $.ajax({
            type: "POST",
            url: '@Url.Action("SplitProjectAndAddWorkItemsToSpecificBlocks", "ProjectEstimationSplit", new { area = "Construction" })',
            data: { projectId: id },
            cache: false,
            success: function (result) {
                // toastr.warnning(result.Message);
                bt.hide();
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                bt.hide();
                alert(result);
            }
        });
    }
    function filterCategories() {
        //
        // summary:
        //      send the filtering text along with the parent widget's value
        var dropdownlist = $("#ItemCode").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            ItemCategoryCode: $("#ItemCategoryCode").val(), filterString: filterInput.val()
        };
    }
    function filterType() {
        return {
            EquipmentIdentityID: $("#EquipmentIdentityID").val()
        };
    }
    function FilterAsset() {
        return {
            EquipmentTypeID: $("#EquipmentTypeID").val()
        };
    }
    function Refresh() {
        window.location.reload();
    }

    function onStructureTypeMapping(e) {
        var strTypeDropDownList = $("#structureTypesDropdownList").data("kendoDropDownList");
        var selectedValue = $("#structureTypesDropdownList").val();
        alert(selectedValue);
    }

</script>

