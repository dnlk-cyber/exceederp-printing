@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend >Block List</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.Block>()
              .Name("Blockgrid")
      .Columns(columns =>
      {

          columns.ForeignKey(c => c.ProjectTypeId, (IEnumerable)ViewData["Project"], "ProjectTypeId", "Name").EditorTemplateName("Project").Width(150);
        columns.Bound(c => c.Name);
          columns.Bound(c => c.Remark);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Selectable(selectable =>
             {
                 selectable.Mode(GridSelectionMode.Single);
                 selectable.Type(GridSelectionType.Row);
             })
                 .Scrollable(h => h.Height(500))
                     .Groupable()
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                  .Filterable()
                     .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()

                                  .Events(events =>
                                                                      {
                                                                          events.Error("error_handler(\"Blockgrid\")");
                                                                          events.RequestStart("onRequestStart(\"Blockgrid\")");
                                                                          events.RequestEnd("onRequestEnd(\"Blockgrid\")");

                                                                      })
          .Model(model => model.Id(p => p.BlockId))
                          .Read(read => read.Action("Blocks_Read", "Block"))
                                  .Create(create => create.Action("Blocks_Create", "Block"))
                                  .Update(update => update.Action("Blocks_Update", "Block"))
                                  .Destroy(destroy => destroy.Action("Blocks_Destroy", "Block"))
          ).ClientDetailTemplateId("templateOne")
      )


<script id="templateOne" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                  .Name("tabstrip_#=BlockId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("Structure Types").Content(
                @<text>

                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.BlockMapping >()
                                                          .Name("ProjectTypeMapping_#=BlockId#")
                          .Columns(columns =>
                          {
                              columns.ForeignKey(c => c.ConfigurationId, (IEnumerable)ViewData["Types"], "ConfigurationId", "CurrentValue").EditorTemplateName("Type").Title("Type");
                              columns.Bound(c => c.Remark).Width(200);
                            
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(200);
                          })
                                  .ToolBar(toolbar =>
                  {
                      toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                  })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                         
                          .Scrollable(h => h.Height(500))
                          .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          .Filterable()
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          //.Events(e => e.Edit("onEdit"))
                          .DataSource(dataSource => dataSource
                              .Ajax()

                              .Events(events =>
                              {
                                  events.Error("error_handler(\"ProjectTypeMapping_#=BlockId#\")");
                                  events.RequestStart("onRequestStart(\"ProjectTypeMapping_#=BlockId#\")");
                                  events.RequestEnd("onRequestEnd(\"ProjectTypeMapping_#=BlockId#\")");

                              })

                              .Model(model =>
                              {
                                  model.Id(p => p.BlockMappingId );

                                
                              }
                              )
                                                                                                              .Read(read => read.Action("BlockMappings_Read", "BlockMapping", new { id = "#=BlockId#" }))
                                                                                                      .Create(create => create.Action("BlockMappings_Create", "BlockMapping", new { idTwo = "#=BlockId#" }))
                                                                      .Update(update => update.Action("BlockMappings_Update", "BlockMapping"))
                                                                      .Destroy(destroy => destroy.Action("BlockMappings_Destroy", "BlockMapping"))
                                   ).ToClientTemplate()
                    )
                </text>
                  );


          }).ToClientTemplate())
</script>

