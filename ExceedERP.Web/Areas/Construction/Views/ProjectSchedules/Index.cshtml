<legend>Project Schedules and Schedule Revision</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ScheduleRevisionProjectViewModel>()
      .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
          //columns.Bound(c => c.ProjectInformationId).Title("Id");
          columns.Bound(c => c.Name);
          columns.Bound(c => c.Code);
          //columns.Bound(c => c.Category).Width(200);
          //columns.Bound(c => c.BranchId).Width(150);
          columns.Bound(c => c.ContractAmount).ClientTemplate(
