@using ExceedERP.Core.Localization
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Deleted Sub-Project Types </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
      .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Name).Width(300);
          columns.Bound(c => c.Code).Width(80).Title("Code");
          columns.Bound(c => c.ProjectType).ClientGroupHeaderTemplate(
              "# if (value === 0) { #" +
                " Building ( #= aggregates.ProjectInformationId.count # projects)" +
              "# } else if (value === 1) {#" +
                " Road ( #= aggregates.ProjectInformationId.count # projects)" +
              "# } else if (value === 2) {#" +
                " Dam ( #= aggregates.ProjectInformationId.count # projects)" +
              "# } else if (value === 3) {#" +
                " Irrigation ( #= aggregates.ProjectInformationId.count # projects)" +
              "# } #"
              ).Hidden(true);
          columns.Bound(c => c.ProjectScope);
          columns.Bound(c => c.Consultant);
          columns.Bound(c => c.Client);
          //columns.Command(command =>
          //{
          //    //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
          //    command.Custom("CmdRestore").Text("&nbsp;&nbsp;Restore").Click("restoreSelectedProject").IconClass("fa fa-undo &nbsp;");
          //    command.Destroy().Text("Delete Permanently");
          //}).Width(300);
      })
     
      .Scrollable(h => h.Height(700))
      ////.Groupable()
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      //.Events(ev =>
      //{
      //    ev.DataBound("projectsGridDataBound");
      //})
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .PageSize(20)
          .Group(groups =>
          {
              groups.Add(p => p.ProjectType);
          })
          .Aggregates(ag =>
          {
              ag.Add(f => f.ProjectInformationId).Count();
          })
          .Events(events =>
          {
              events.Error("error_handler(\"ProjectInformationgrid\")");
              events.RequestStart("onRequestStart(\"ProjectInformationgrid\")");
              events.RequestEnd("onRequestEnd(\"ProjectInformationgrid\")");

          })

          .Model(model => model.Id(p => p.ProjectInformationId))
          .Read(read => read.Action("Read_ProjectsWithDeletedSubProjectTypes", "ProjectEstimationDetail"))
          //.Create(create => create.Action("ProjectInformation_Create", "ProjectEstimationDetail"))
          //.Update(update => update.Action("ProjectInformation_Update", "ProjectEstimationDetail"))
          //.Destroy(destroy => destroy.Action("ProjectInformation_Destroy_Permanently", "ProjectEstimationDetail"))
      ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("tabstrip_1_#=ProjectInformationId#")
                  .SelectedIndex(0)
                  .Items(items =>
                  {
                  items.Add().Text("Sub Projects (Sub-Project Types)").Content(
                    @<text>
                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.SubProjectType>()
                                .Name("subProjectgrid_#=ProjectInformationId#")
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.OrderIndex).Title("No.").Width(60).Hidden(true).Filterable(false);
                                    columns.Bound(c => c.Name);
                                    columns.Bound(c => c.NumberOfBlocks).Width(60).Filterable(false);
                                    columns.Bound(c => c.Remark);
                                    columns.Command(command =>
                                    {
                                        command.Custom("CmdRestoreSubProject").Text("&nbsp;&nbsp;Restore").Click("restoreSubProjectType").IconClass("fa fa-undo &nbsp;");
                                        command.Destroy().Text("Delete Permanently");
                                    }).Width(300);
                                })
                                //.Events(ev =>
                                //{
                                //    ev.DataBound("subProjectTypeDataBound");
                                //})
                                //.ToolBar(toolbar =>
                                //{
                                //    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                //})
                                .Selectable(selectable =>
                                {
                                    selectable.Mode(GridSelectionMode.Single);
                                    selectable.Type(GridSelectionType.Row);
                                })
                                //.Editable(editable => editable.Mode(GridEditMode.InLine))
                                .Selectable(selectable =>
                                {
                                    selectable.Mode(GridSelectionMode.Single);
                                    selectable.Type(GridSelectionType.Row);
                                })
                                .Scrollable(h => h.Height(300))
                                //.Groupable()
                                .Sortable(sortable =>
                                {
                                    sortable.SortMode(GridSortMode.SingleColumn);
                                })
                                .Filterable()
                                .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Sort(srt => {
                                        srt.Add(f => f.OrderIndex);
                                    })
                                    .Events(events =>
                                    {
                                        events.Error("error_handler(\"subProjectgrid_#=ProjectInformationId#\")");
                                        events.RequestStart("onRequestStart(\"subProjectgrid_#=ProjectInformationId#\")");
                                        events.RequestEnd("onRequestEnd(\"subProjectgrid_#=ProjectInformationId#\")");

                                    })
                                    .Model(model =>
                                    {
                                        model.Id(p => p.SubProjectTypeId);
                                        model.Field(p => p.NumberOfBlocks).DefaultValue(1);
                                        model.Field(f => f.OrderIndex).Editable(false);
                                    })
                                    .Read(read => read.Action("SubProjectTypes_Read_Deleted", "SubProjectType", new { idd = "#=ProjectInformationId#" }))
                                    //.Create(create => create.Action("SubProjectType_Create", "SubProjectType", new { iddTwo = "#=ProjectInformationId#" }))
                                    //.Update(update => update.Action("SubProjectType_Update", "SubProjectType"))
                                    .Destroy(destroy => destroy.Action("SubProjectType_Destroy", "SubProjectType"))
                                    )//.ClientDetailTemplateId("template_building_str_and_blocks")
                                    .ToClientTemplate()
                        )
                    </text>
                  );
                  }).ToClientTemplate())
    
</script>



<script type="text/javascript">
    function restoreSubProjectType(e) {
         var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.SubProjectTypeId;
        //var grd = $('#ProjectInformationgrid').data('kendoGrid');
       
        $.ajax({
                url: '@Url.Action("RestoreSubProjectType", "Recycler", new { area = "Construction" })',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    //grd.dataSource.read();
                    location.reload();
                }
            });
    }
</script>
