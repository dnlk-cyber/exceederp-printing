@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Estimation Mobilization</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectEstimationMobilization>()
      .Name("ProjectEstimationMobilization")
      .Columns(columns =>
      {
          columns.Bound(c => c.ItemNo);
          columns.Bound(c => c.TypeOfMachinery);
          columns.Bound(c => c.Quantity);
          columns.Bound(c => c.Trip);
          columns.Bound(c => c.Distance);
          columns.Bound(c => c.Speed);
          columns.Bound(c => c.Time);
          columns.Bound(c => c.RentalCost);
          columns.Bound(c => c.TotalCost);
          columns.Bound(c => c.StaffName);
          columns.Bound(c => c.StaffQuantity);
          columns.Bound(c => c.StaffTime);
          columns.Bound(c => c.Perdiem);
          columns.Bound(c => c.StaffTotalCost);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(h => h.Height(500))
      .Groupable()
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(events => events.Error("error_handler(\"ProjectEstimationMobilization\")"))
          .Model(model => model.Id(p => p.ProjectEstimationMobilizationId))
          .Read(read => read.Action("ProjectEstimationMobilization_Read", "ProjectEstimationMobilization"))
          .Create(create => create.Action("ProjectEstimationMobilization_Create", "ProjectEstimationMobilization"))
          .Update(update => update.Action("ProjectEstimationMobilization_Update", "ProjectEstimationMobilization"))
          .Destroy(destroy => destroy.Action("ProjectEstimationMobilization_Destroy", "ProjectEstimationMobilization"))
      ))
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
</script>