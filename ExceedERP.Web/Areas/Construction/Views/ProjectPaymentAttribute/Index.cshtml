@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Setting | Payment Terms(for all Projects)</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectPaymentAttribute>()
        .Name("attributeGrid")
        .Columns(columns =>
        {
            columns.Bound(c => c.AttributeName).EditorTemplateName("AttributeNames");
            columns.Bound(c => c.Value).ClientTemplate("#=Value#%");

            columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
        })
        .ToolBar(toolbar =>
        {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
        })
        .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        .Scrollable(h => h.Height(500))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Filterable()
        .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))
        .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events =>
        {
            events.Error("error_handler(\"attributeGrid\")");
            events.RequestStart("onRequestStart(\"attributeGrid\")");
            events.RequestEnd("onRequestEnd(\"attributeGrid\")");

        })
        .Model(model => model.Id(p => p.ProjectPaymentAttributeId))
        .Read(read => read.Action("PaymentAttribute_Read", "ProjectPaymentAttribute"))
        .Create(create => create.Action("PaymentAttribute_Create", "ProjectPaymentAttribute"))
        .Update(update => update.Action("PaymentAttribute_Update", "ProjectPaymentAttribute"))
        .Destroy(destroy => destroy.Action("PaymentAttribute_Destroy", "ProjectPaymentAttribute"))
    )
)




<script>

    function sync_handler(e) {
        this.read();

    }
</script>