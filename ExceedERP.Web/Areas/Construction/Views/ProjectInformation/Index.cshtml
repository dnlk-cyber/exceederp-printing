    div.k-edit-form-container {
        width: 700px;
    }
</style>
<script>
    //var masterGrid = $("#ProjectInformationgrid").data("kendoGrid");
    function Approved(e) {
        try {
            var grid = $("#ProjectInformationgrid").data("kendoGrid");
            var dataItem = grid.dataItem(grid.select());
            var id = dataItem.ProjectInformationId;
            var state = "APPROVED";
            $.ajax({
                url: '@Url.Action("ChangeTheState", "ProjectInformation")',

                data: { id: id, state: state },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    //window.location.reload();
                    grid.dataSource.read();
                }
            });
        } catch (e) {

            alert("Please select the Project!!");
        }
    }

    function Closed(e) {
        try {
            var grid = $("#ProjectInformationgrid").data("kendoGrid");
            var dataItem = grid.dataItem(grid.select());
            var id = dataItem.ProjectInformationId;
            $.ajax({
                url: '@Url.Action("ChangeTheState", "ProjectInformation")',

                data: { id: id, state: "CLOSED" },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    //window.location.reload();
                    grid.dataSource.read();
                }
            });
        } catch (e) {

            alert("Please select the project!!");
        }
    }

    function Started(e) {
        try {
            var grid = $("#ProjectInformationgrid").data("kendoGrid");
            var dataItem = grid.dataItem(grid.select());
            var id = dataItem.ProjectInformationId;
            $.ajax({
                url: '@Url.Action("ChangeTheState", "ProjectInformation")',

                data: { id: id, state: "STARTED" },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    grid.dataSource.read();
                }
            });
        } catch (e) {

            alert("Please select the Project!!");
        }
    }

    var masterId;

    function onDataBound(e) {
        var grid = $("#LineDate_" + masterId).data("kendoGrid");
        var gridData = grid.dataSource.view();
        if (gridData.length > 0) {
            $(".k-grid-add", "#LineDate_" + masterId).hide();
            //editButton.hide();
        }
        //for (var i = 0; i < gridData.length; i++) {
        //    var currentUid = gridData[i].uid;
        //    if (gridData[i].ProcessedDate != null) {
        //        var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
        //        var editButton = $(currenRow).find(".k-grid-add");
        //        editButton.hide();
        //    }
        //}
    }

    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#ProjectInformationgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.ProjectInformationId;

        var grid = $("#LineDate_" + masterId).data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].ProcessedDate != null) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-add");
                editButton.hide();
            }
        }
    }
</script>

<script>
    function CheckDisablity(e) {
        var btnStart = $("#btnStarted").data("kendoButton");
        var btnClose = $("#btnClosed").data("kendoButton");
        var btnApprove = $("#btApproved").data("kendoButton");

        var grid = $("#ProjectInformationgrid").data("kendoGrid");

        var dataItem = grid.dataItem(grid.select());
        var id = dataItem.ProjectInformationId;

        $.ajax({
            url: '@Url.Action("CheckStatus", "ProjectInformation")',
            contentType: "application/json; charset=utf-8",
            data: { 'id': id },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "s") {
                    if ($('#btnStarted').length > 0) {
                        btnStart.enable(false);
                    }
                    if ($('#btnClosed').length > 0) {
                        btnClose.enable(true);
                    }
                    if ($('#btApproved').length > 0) {
                        btnApprove.enable(true);
                    }
                }
                else if (r == "a") {
                    if ($('#btnStarted').length > 0) {
                        btnStart.enable(false);
                    } if ($('#btnClosed').length > 0) {
                        btnClose.enable(true);
                    } if ($('#btApproved').length > 0) {
                        btnApprove.enable(false);
                    }
                } else if (r == "c") {
                    if ($('#btnStarted').length > 0) {
                        btnStart.enable(false);
                    }
                    if ($('#btnClosed').length > 0) {
                        btnClose.enable(false);
                    } if ($('#btApproved').length > 0) {
                        btnApprove.enable(false);
                    }
                } else {
                    if ($('#btnStarted').length > 0) {
                        btnStart.enable(true);
                    }
                    if ($('#btnClosed').length > 0) {
                        btnClose.enable(false);
                    }
                    if ($('#btApproved').length > 0) {
                        btnApprove.enable(false);
                    }
                }
            }
        });
    }
</script>
