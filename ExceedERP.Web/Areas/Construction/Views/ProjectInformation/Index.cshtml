<legend>Project Information</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
    .Name("ProjectInformationgrid")
    .Columns(columns =>
    {
        columns.Bound(c => c.Name).Width(180);
        columns.Bound(c => c.Code).Width(75);
        //columns.Bound(c => c.ProjectType).Width(120);
        columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").EditorTemplateName("Branch").Width(150);
        columns.Bound(c => c.ContractAmount).Width(120).ClientTemplate(
            "# if (ContractAmount === 0) { #" +
                                        " -----" +
                                        "# } else {#" +
                                        "#: kendo.toString( ContractAmount, 'N2') #" +
                                        "# } #"
            );
        columns.Bound(c => c.Client).Width(120);
        columns.Bound(c => c.ProjectType).ClientGroupHeaderTemplate(
          "# if (value === 0) { #" +
              " Building " +
            "# } else if (value === 1) {#" +
              " Road " +
            "# } else if (value === 2) {#" +
               " Dam " +
            "# } else if (value === 3) {#" +
              " Irrigation" +
            "# } #"
          ).Hidden(true);
        columns.Bound(c => c.ProjectStatus).EditorTemplateName("Enum").Width(100);
        columns.Command(command =>
        {
            command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
            command.Destroy().Text(Resources.ActionButton_Cancel);
        }).Width(200);
    })
    .ToolBar(toolbar =>
    {
    toolbar.Template(@<text>
        <div class="toolbar">
            @*  @item.CreateButton(Resources.ActionButton_AddNewRecord)*@
            @(Html.Kendo().Button()
                                .Name("btnStarted")
                                .HtmlAttributes(new { type = "button", @class = "k-primary" })
                                .Events(e => e.Click("Started"))
                                .Content("Start")
                                .Enable(false)
                                .Icon("k-icon k-i-check")
            )

            @(Html.Kendo().Button()
                                .Name("btApproved")
                                .HtmlAttributes(new { type = "button", @class = "k-primary" })
                                .Events(e => e.Click("Approved"))
                                .Content("Approve")
                                .Enable(false)
                                .Icon("k-icon k-i-check")
            )

            @(Html.Kendo().Button()
                                .Name("btnClosed")
                                .HtmlAttributes(new { type = "button", @class = "k-primary" })
                                .Events(e => e.Click("Closed"))
                                .Content("Close")
                                .Enable(false)
                                .Icon("k-icon k-i-check")
            )
        </div>
    </text>);

    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ProjectInformation").Window(window => { window.Title("Project Information"); window.Scrollable(false); }))
    .Scrollable(h => h.Height(700))
    .Sortable(sortable =>
    {
        sortable.SortMode(GridSortMode.SingleColumn);
    })
    .Filterable()
    .Selectable()
    .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
    .Events(e =>
    {
        //e.DetailExpand("onDetailExpandUser");
        e.Change("CheckDisablity");
    })
    .DataSource(dataSource => dataSource
        .Ajax()
        .Group(g =>
        {
            g.Add(f => f.ProjectType);
        })
        .PageSize(20)
        .Events(events =>
        {
            events.Error("error_handler(\"ProjectInformationgrid\")");
            events.RequestStart("onRequestStart(\"ProjectInformationgrid\")");
            events.RequestEnd("onRequestEnd(\"ProjectInformationgrid\")");
        })
        .Model(model => model.Id(p => p.ProjectInformationId))
        .Read(read => read.Action("ProjectInformation_Read", "ProjectInformation"))
        .Create(create => create.Action("ProjectInformation_Create", "ProjectInformation"))
        .Update(update => update.Action("ProjectInformation_Update", "ProjectInformation"))
        .Destroy(destroy => destroy.Action("ProjectInformation_Destroy", "ProjectInformation"))
        ).ClientDetailTemplateId("template")
)

