@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        .DataTextField("Name")
        .DataValueField("GlFiscalYearId")
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetFiscalYear", "DataProvider"));
        })
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)