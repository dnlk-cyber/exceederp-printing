@using System.Collections
@using ExceedERP.Helpers.Common
@using ExceedERP.Core.Localization
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.Construction.LineDate 

<form>
    <div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.AwardDate, htmlAttributes: new {@class = "control-label col-md-8"})

            </div>
            <div>

                @Html.Kendo().DatePickerFor(model => model.AwardDate)
                @Html.ValidationMessageFor(model => model.AwardDate, "", new { @class = "text-danger" })



            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.ContractPeriod, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>

                @Html.Kendo().TextBoxFor(model => model.ContractPeriod)
                @Html.ValidationMessageFor(model => model.ContractPeriod, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.ContractSigningDate, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>

               
                
                  @Html.Kendo().DatePickerFor(model => model.ContractSigningDate)
                @Html.ValidationMessageFor(model => model.ContractSigningDate, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
  
   

</div>

<br/>


<div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.SiteHandOverDate, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">
            @Html.Kendo().DatePickerFor(model => model.SiteHandOverDate)
            @Html.ValidationMessageFor(model => model.SiteHandOverDate, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.EstimatedStartDate, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>
                @Html.Kendo().DatePickerFor(model => model.EstimatedStartDate)
                @Html.ValidationMessageFor(model => model.EstimatedStartDate, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.EstimatedEndDate , htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">

            @Html.Kendo().DatePickerFor(model => model.EstimatedEndDate)
            @Html.ValidationMessageFor(model => model.EstimatedEndDate, "", new { @class = "text-danger" })
        </div>
    </div>
 
   


</div>
<br/>
    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.PeriodId, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">
                @(Html.Kendo().DropDownListFor(model => model.PeriodId)
                        //  .Name("EmployeeId")
                                                      .DataValueField("PeriodId")
                                .DataTextField("PeriodName")
                           .OptionLabel("Select Period..")
                            .Filter("contains")
                            .MinLength(2)
                            .HtmlAttributes(new { style = "width:200px" })
                                        .DataSource(source =>
                                                                        {
                                                                            source.Read(read => read.Action("GetPeriod", "LineDate"));


                                                                        })
                                           .ValuePrimitive(true)


                                                                  .Height(400)
                                                                        
                )
                @Html.ValidationMessageFor(model => model.PeriodId, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.CompletionDate, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @Html.Kendo().DatePickerFor(model => model.CompletionDate)
                    @Html.ValidationMessageFor(model => model.CompletionDate, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
   




    </div>

    <br />
