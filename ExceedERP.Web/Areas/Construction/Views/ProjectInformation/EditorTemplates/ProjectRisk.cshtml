@using System.Collections
@using ExceedERP.Helpers.Common
@using ExceedERP.Core.Localization
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.Construction.ProjectConstraintsAndRisk 

<form>
    <div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.Assumptions, htmlAttributes: new {@class = "control-label col-md-8"})

            </div>
            <div>

                @Html.TextAreaFor(model => model.Assumptions)
                @Html.ValidationMessageFor(model => model.Assumptions, "", new { @class = "text-danger" })



            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.Constraints, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>

                @Html.TextAreaFor(model => model.Constraints)
                @Html.ValidationMessageFor(model => model.Constraints, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.RiskDescription, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>
                @Html.TextAreaFor(model => model.Constraints)
                @Html.ValidationMessageFor(model => model.Constraints, "", new { @class = "text-danger" })
                
            </div>
        </div>
    </div>
  
   

</div>

<br/>


<div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.RiskStatus, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">
            @Html.EnumDropDownListFor(model => model.RiskStatus)
            @Html.ValidationMessageFor(model => model.RiskStatus, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.RiskImpact, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>
                @Html.EnumDropDownListFor(model => model.RiskImpact)
                @Html.ValidationMessageFor(model => model.RiskImpact, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.RiskProbablity , htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">

            @Html.EnumDropDownListFor(model => model.RiskProbablity)
            @Html.ValidationMessageFor(model => model.RiskProbablity, "", new { @class = "text-danger" })
        </div>
    </div>
 
   


</div>
<br/>
   

   
    

</form>
