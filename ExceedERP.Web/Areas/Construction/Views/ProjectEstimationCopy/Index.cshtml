                    //.Update(update => update.Action("WorkItemPerProject_Update", "GenericWorkItemPerProject"))
                    //.Destroy(destroy => destroy.Action("WorkItemPerProject_Destroy", "GenericWorkItemPerProject"))
                    ).ClientDetailTemplateId("template")
                )
            </text>
        );
