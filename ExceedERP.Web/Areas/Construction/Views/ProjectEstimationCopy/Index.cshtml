<script>

    function Copy() {

        var grid1 = $("#WorkItemPerProject").data("kendoGrid");
        var grid2 = $("#AreaWorkItemgrid").data("kendoGrid");
        var grid3 = $("#SubContractWorkItemgrid").data("kendoGrid");
        //var grid4 = $("#customWorkItemGrid").data("kendoGrid");


        var projects = $("#ProjectInformationId").data("kendoComboBox");
        //var types = $("#ProjectTypeId").data("kendoComboBox");
        var withTake = $("#WithTakeoff").val();
        try {
            var btn = $("#btnCopyEstimation").data("kendoButton");
            var prog = $("#loadingButton");

            var project = projects.value();
            $.ajax({
                url: '@Url.Action("CheckCopied", "CloneWorkItemPerProject")',
                //contentType: "application/json; charset=utf-8",
                data: { to: project },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    if (r === "True") {

                        if (confirm("This project has some existing work items. If you proceed to copying, the existing data will be removed ........")) {

                            kendo.ui.progress($("#progressIndicatorDiv", true));
                            btn.enable(false);
                            prog.show();
                            $.ajax({
                                url: '@Url.Action("CopyEstimation", "ProjectEstimationCopy", new { area = "Construction" })',
                                //contentType: "application/json; charset=utf-8",
                                data: { projectId: project, type: 0 },
                                type: 'POST',
                                cache: false,
                                success: function (result) {
                                    // r = result;
                                    //window.location.reload();
                                    grid1.dataSource.read();
                                    grid2.dataSource.read();
                                    grid3.dataSource.read();
                                    //grid4.dataSource.read();

                                    prog.hide();
                                    btn.enable(true);
                                }
                            });
                        }
                        else {

                            @*$.ajax({
                                url: '@Url.Action("CopyEstimation", "WorkItemPerProject")',
                                //contentType: "application/json; charset=utf-8",
                                data: { project: project, type: 0, withTake: withTake },
                                type: 'POST',
                                cache: false,
                                success: function (result) {
                                    // r = result;
                                    window.location.reload();
                                }
                            });*@
                        }
                    }
                    else {
                        btn.enable(false);
                        prog.show();

                        $.ajax({
                            url: '@Url.Action("CopyEstimation", "ProjectEstimationCopy", new { area = "Construction" })',
                            //contentType: "application/json; charset=utf-8",
                            data: { projectId: project, type: 0 },
                            type: 'POST',
                            cache: false,
                            success: function (result) {
                                // r = result;
                                //window.location.reload();
                                grid1.dataSource.read();
                                grid2.dataSource.read();
                                grid3.dataSource.read();
                                //grid4.dataSource.read();

                                prog.hide();
                                btn.enable(true);
                            }
                        });
                    }

                }
            });
        }

        catch (e) {
            alert("Please select a Project!!");
        }
        //});
    }

    function filterCategories() {
        return {
            ItemCategoryCode: $("#ItemCategoryCode").val()
        };
    }
    function filterType() {
        return {
            EquipmentIdentityID: $("#EquipmentIdentityID").val()
        };
    }
    function FilterAsset() {
        return {
            EquipmentTypeID: $("#EquipmentTypeID").val()
        };
    }
    function Refresh() {
        window.location.reload();
    }
    function filterWorkItems() {
        return {
            WorkCategoryId: $("#WorkCategoryId").val()
        };
    }
</script>
