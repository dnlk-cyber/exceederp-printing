<script id="template" type="text/kendo-tmpl">
    #if(!IsSubCategory && !ContainsWorkItemAsInput){#
    @(Html.Kendo().TabStrip()
         .Name("tabstrip_#=GenericWorkItemPerProjectId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("Detail").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.WorkItemDetailViewModel>()
                                                        .Name("detail__#=GenericWorkItemPerProjectId#")
                                                        .Columns(columns =>
                                                        {

                                                            columns.Bound(c => c.Attribute).Title(" ").ClientTemplate("\\#=Attribute\\#: \\#=Value\\#");
                                                        })

                                                         .Pageable(pageable => pageable
                                                                .Input(true)
                                                                .Numeric(false)
                                                                .Refresh(true)
                                                                .PageSizes(true)
                                                                .ButtonCount(5))
                                                        .DataSource(dataSource => dataSource
                                                            .Ajax()
                                                            .Events(events =>
                                                            {
                                                                events.Error("error_handler(\"detail__#=GenericWorkItemPerProjectId#\")");
                                                                events.RequestStart("onRequestStart(\"detail__#=GenericWorkItemPerProjectId#\")");
                                                                events.RequestEnd("onRequestEnd(\"detail__#=GenericWorkItemPerProjectId#\")");
                                                            })
                                                            .Model(model =>
                                                            {
                                                                model.Id(p => p.Id);
                                                            })
                                                            .Read(read => read.Action("SpecificWorkItemDetail_Read", "GenericWorkItemPerProject", new { workItemId = "#=GenericWorkItemPerProjectId#" }))
                                                        ).ToClientTemplate()
                    )
                </text>
                  );
              items.Add().Text("Material Cost").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.GenericProjectMaterial>()
                      .Name("ProjectMaterial_#=GenericWorkItemPerProjectId#")
                      .Columns(columns =>
                      {
                          columns.ForeignKey(c => c.ItemCategoryCode, (IEnumerable)ViewData["ItemCategorys"], "ItemCategoryCode", "Name").EditorTemplateName("ItemCategory").Width(200);
                          columns.ForeignKey(c => c.ItemCode, (IEnumerable)ViewData["Items"], "ItemCode", "Name").EditorTemplateName("Item").Width(200);
                          columns.Bound(c => c.Unit).Width(100);//, (IEnumerable)ViewData["Unit"], "LookupId", "Description").EditorTemplateName("Unit").Width(75);
                          columns.Bound(c => c.Quantity).Width(75);
                          columns.Bound(c => c.UnitPrice).Width(75);
                          columns.Bound(c => c.TotalCost).Width(75)
                              .ClientFooterTemplate("Total: \\#=sum\\#")
                              .ClientGroupFooterTemplate("Total: \\#=sum\\#");
                      })
                      .Selectable(selectable =>
                      {
                          selectable.Mode(GridSelectionMode.Single);
                          selectable.Type(GridSelectionType.Row);
                      })
                      //.Scrollable(h => h.Height(500))
                      //.Events(e => e.Change("OnChange"))
                      .DataSource(dataSource => dataSource
                            .Ajax()
                            .Events(events =>
                            {
                                events.Error("error_handler(\"ProjectMaterial_#=GenericWorkItemPerProjectId#\")");
                                events.RequestStart("onRequestStart(\"ProjectMaterial_#=GenericWorkItemPerProjectId#\")");
                                events.RequestEnd("onRequestEnd(\"ProjectMaterial_#=GenericWorkItemPerProjectId#\")");
                            })
                            .Aggregates(aggregates =>
                            {
                                aggregates.Add(p => p.TotalCost).Sum();
                                aggregates.Add(p => p.Quantity).Sum();
                                aggregates.Add(p => p.UnitPrice).Sum();
                            })
                            .Model(model =>
                            {
                                model.Id(p => p.GenericProjectMaterialId);
                                model.Field(p => p.TotalCost).Editable(false);
                                model.Field(p => p.Unit).Editable(false);
                            })
                              .Read(read => read.Action("ProjectMaterial_Read", "GenericProjectMaterial", new { id = "#=GenericWorkItemPerProjectId#" }))
                        //.Create(create => create.Action("ProjectMaterial_Create", "ProjectMaterial", new { idtwo = "#=WorkItemPerProjectId#" }))
                        //.Update(update => update.Action("ProjectMaterial_Update", "ProjectMaterial"))
                        //.Destroy(destroy => destroy.Action("ProjectMaterial_Destroy", "ProjectMaterial"))
                        ).ToClientTemplate()
                    )
                </text>
                );
              items.Add().Text("Labour Cost").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.GenericProjectDirectLabour>()
                      .Name("Labourgrid_#=GenericWorkItemPerProjectId#")
                      .Columns(columns =>
                      {
                          columns.ForeignKey(c => c.ProjectEstimationIndexLabourId, (IEnumerable)ViewData["titles"], "ProjectEstimationIndexLabourId", "Title").Width(150);
                          columns.Bound(c => c.Quantity).Title("No").Width(50);
                          columns.Bound(c => c.UnitFactory).Title("Unit Factor").Width(80);
                          columns.Bound(c => c.IndexedHourlySalary).Title("Indexed Hourly Cost").Width(80);
                          columns.Bound(c => c.TotalCost).Title("Hourly Cost").Width(75)
                              .ClientFooterTemplate("Hourly Cost: \\#=sum\\#")
                              .ClientGroupFooterTemplate("Total: \\#=sum\\#");
                      })
                      //.Editable(editable => editable.Mode(GridEditMode.InLine))
                      //.Events(e => e.Change("OnChange"))
                      .Selectable(selectable =>
                      {
                          selectable.Mode(GridSelectionMode.Single);
                          selectable.Type(GridSelectionType.Row);
                      })
                      .DataSource(dataSource => dataSource
                          .Ajax()
                            .Events(events =>
                            {
                                events.Error("error_handler(\"Labourgrid_#=GenericWorkItemPerProjectId#\")");
                                events.RequestStart("onRequestStart(\"Labourgrid_#=GenericWorkItemPerProjectId#\")");
                                events.RequestEnd("onRequestEnd(\"Labourgrid_#=GenericWorkItemPerProjectId#\")");
                            })
                            .Aggregates(aggregates =>
                            {
                                aggregates.Add(p => p.TotalCost).Sum();
                                aggregates.Add(p => p.UnitFactory).Sum();
                                aggregates.Add(p => p.DailyPay).Sum();
                                aggregates.Add(p => p.Quantity).Sum();
                            })
                          .Model(model =>
                          {
                              model.Id(p => p.GenericProjectDirectLabourId);
                              model.Field(p => p.TotalCost).Editable(false);
                              model.Field(p => p.DailyPay).Editable(false);
                              model.Field(p => p.IndexedHourlySalary).Editable(false);

                          })
                          .Read(read => read.Action("ProjectDirectLabour_Read", "GenericProjectDirectLabour", new { workItemId = "#=GenericWorkItemPerProjectId#" }))
                        //.Create(create => create.Action("ProjectDirectLabour_Create", "ProjectDirectLabour", new { idfour = "#=WorkItemPerProjectId#" }))
                        //.Update(update => update.Action("ProjectDirectLabour_Update", "ProjectDirectLabour"))
                        //.Destroy(destroy => destroy.Action("ProjectDirectLabour_Destroy", "ProjectDirectLabour"))
                        ).ToClientTemplate()
                    )
                </text>
                  );

              items.Add().Text("Equipment Cost").Content(
                @<text>

                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.GenericProjectEquipment>()
                          .Name("Equipmentgrid_#=GenericWorkItemPerProjectId#")
                          .Columns(columns =>
                          {
                              //columns.ForeignKey(c => c.EquipmentIdentityID, (IEnumerable)ViewData["EquipmentIdentity"], "EquipmentIdentityID", "EquipmentCategoryName").EditorTemplateName("EquipmentCategory").Width(150);//
                              //columns.ForeignKey(c => c.EquipmentTypeID, (IEnumerable)ViewData["EquipmentType"], "EquipmentTypeID", "EquipmentTypeName").EditorTemplateName("EquipmentType").Width(150);//,
                              columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["Equipment"], "FleetsID", "EquipmentName").EditorTemplateName("Equipment").Width(150);//,
                              columns.Bound(c => c.Quantity).Title("No").Width(100);
                              columns.Bound(c => c.UnitFactory).Title("U.F.").Width(100);
                              columns.Bound(c => c.RentalCost).Title("Hourly Rental").Width(100);
                              columns.Bound(c => c.TotalCost).Title("Hourly Cost").Width(100)
                                  .ClientFooterTemplate("Hourly Cost : \\#=sum\\#")
                              .ClientGroupFooterTemplate("Total : \\#=sum\\#");
                          })
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                        //.Editable(editable => editable.Mode(GridEditMode.InLine))
                        //.Events(e => e.Change("OnChange"))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Events(events =>
                            {
                                events.Error("error_handler(\"Equipmentgrid_#=GenericWorkItemPerProjectId#\")");
                                events.RequestStart("onRequestStart(\"Equipmentgrid_#=GenericWorkItemPerProjectId#\")");
                                events.RequestEnd("onRequestEnd(\"Equipmentgrid_#=GenericWorkItemPerProjectId#\")");

                            })
                            .Aggregates(aggregates =>
                            {
                                aggregates.Add(p => p.TotalCost).Sum();
                                aggregates.Add(p => p.Quantity).Sum();
                                aggregates.Add(p => p.RentalCost).Sum();
                            })
                            .Model(model =>
                            {
                                model.Id(p => p.GenericProjectEquipmentId);
                                model.Field(p => p.TotalCost).Editable(false);
                                model.Field(p => p.RentalCost).Editable(false);
                            }
                            )
                        .Read(read => read.Action("ProjectEquipment_Read", "GenericProjectEquipment", new { workItemId = "#=GenericWorkItemPerProjectId#" }))
                        //.Create(create => create.Action("ProjectEquipment_Create", "GenericProjectEquipment", new { idsix = "#=WorkItemPerProjectId#" }))
                        //.Update(update => update.Action("ProjectEquipment_Update", "GenericProjectEquipment"))
                        //.Destroy(destroy => destroy.Action("ProjectEquipment_Destroy", "GenericProjectEquipment"))
                        ).ToClientTemplate()
                    )
                </text>
                  );
          }).ToClientTemplate())

    # } else if(!IsSubCategory && ContainsWorkItemAsInput) {#
        @(Html.Kendo().TabStrip()
         .Name("tabstrip_#=GenericWorkItemPerProjectId#")
          .SelectedIndex(0)
          .Items(items =>
          {
