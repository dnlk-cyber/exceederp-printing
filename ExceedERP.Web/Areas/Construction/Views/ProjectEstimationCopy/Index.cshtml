@using ExceedERP.Core.Localization
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Copy Estimation (From Template)</legend>

<div class="toolbar">
    <label class="category-label">Target Project:</label>&nbsp;
    @(Html.Kendo().ComboBox()
        .Name("ProjectInformationId")
        .Text("Select ...")
        //.BindTo((IEnumerable)ViewData["ProjectLisWorkItemPerProjectt"])
        .DataSource(source =>
        {
            source.Read(read =>
            {
                read.Action("GetProjectsListToCopyEstimationTo", "DataProvider");
            });
            //.ServerFiltering(false);
        })
        .Filter("contains")
        .DataTextField("Name")
        .DataValueField("ProjectInformationId")
        .HtmlAttributes(new { style = "width: 200px;" })
        .ValuePrimitive(true)
        .Events(x => x.Change("filterProject"))
    )
   
    &nbsp;&nbsp;
    @(Html.Kendo().Button()
        .Name("btnCopyEstimation")
        .HtmlAttributes(new { type = "button", @class = "k-primary" })
        .Events(e => e.Click("Copy"))
        .Content("Copy")
        .Icon("k-icon k-i-copy")
    )
    @*<div id="progressIndicatorDiv"></div>*@
    <a id="loadingButton" hidden> <i class="fa fa-spinner fa-spin fa-2x fa-fw"></i></a>
    <span class="sr-only">Loading...</span>
    <br />
    <br />
</div>
@(Html.Kendo().TabStrip()
