@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        .Name("AssetNumber")
        .DataTextField("Name")
        .DataValueField("AssetNumber")
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetEquipment", "ProjectEstimationWorkItem").Data("FilterAsset"))
            .ServerFiltering(true);
        })
        .CascadeFrom("EquipmentTypeID")
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)