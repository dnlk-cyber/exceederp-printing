@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Estimation Direct Labour</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectEstimationDirectLabour>()
          .Name("ProjectEstimationDirectLabour")
      .Columns(columns =>
      {
        columns.Bound(c => c.ItemNo);
        columns.Bound(c => c.LabourName);
        columns.Bound(c => c.Quantity);
        columns.Bound(c => c.UnitFactory);
        columns.Bound(c => c.DailyPay);
        columns.Bound(c => c.TotalCost);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
           .Scrollable(h => h.Height(500))
                                                 .Groupable()
                                                          .Sortable(sortable =>
                                                          {
                                                              sortable.SortMode(GridSortMode.SingleColumn);
                                                          })
                                              .Filterable()
                                                 .Pageable(pageable => pageable
                                                                            .Input(true)
                                                                            .Numeric(false)
                                                                            .Refresh(true)
                                                                            .PageSizes(true)
                                                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                      .Events(events => events.Error("error_handler(\"ProjectEstimationDirectLabour\")"))
          .Model(model => model.Id(p => p.ProjectEstimationDirectLabourId))
          .Read(read => read.Action("ProjectEstimationDirectLabour_Read", "ProjectEstimationDirectLabour"))
          .Create(create => create.Action("ProjectEstimationDirectLabour_Create", "ProjectEstimationDirectLabour"))
          .Update(update => update.Action("ProjectEstimationDirectLabour_Update", "ProjectEstimationDirectLabour"))
          .Destroy(destroy => destroy.Action("ProjectEstimationDirectLabour_Destroy", "ProjectEstimationDirectLabour"))
      )
)
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
</script>