@helper RenderCopyWorkItemFromProjectWindowContent() { 
    @(Html.Kendo().TabStrip()
        .Name("copyWorkItemFromProjectPopUpWindow")
        .SelectedIndex(0)
        .Items(tabItems => {
            tabItems.Add().Text("Work Items").Content(
                    @<text>
                       @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.CopyEstimationDataToDurationViewModel>()
                            .Name("workItemsFromProjectPopUpGrid")
                            .Columns(column =>
                            {
                                column.Bound(c => c.IsCopied).Width(10).Title(" ").ClientTemplate(
                                "<input type='checkbox' value='#= Id #' " +
                                    "# if (IsCopied) { #" +
                                        "checked='checked'" +
                                    "# } #" +
                                "/>"
                                );
                                column.Bound(c => c.Id).Hidden(true);
                                column.Bound(c => c.SubProjectTypeName).Hidden(true).ClientGroupHeaderTemplate("#=value#");
                                column.Bound(c => c.BlockName).Hidden(true).ClientGroupHeaderTemplate("#=value#");
                                column.Bound(c => c.StructureType).Hidden(true).ClientGroupHeaderTemplate("#=value#");
                                column.Bound(c => c.WorkCategory).Hidden(true).ClientGroupHeaderTemplate("#=value#");

                                column.Bound(c => c.ItemName).Width(200);
                                column.Bound(c => c.HasSubItems).Title("Has sub-items").Width(50).ClientTemplate(
                                                                        "<input type='checkbox' value='#= Id #' " +
                                                                            "# if (HasSubItems) { #" +
                                                                                "checked='checked'" +
                                                                            "# } #" +
                                                                        "/>"
                                                                    );
                                column.Bound(c => c.TotalQuantityOfWork).Width(90).Title("Qty of Work").ClientTemplate(
                                    "#=kendo.toString(TotalQuantityOfWork, 'N2') # #= UnitOfMeasurement === null ? ' ' : UnitOfMeasurement#"
                                    );
                                column.Bound(c => c.TotalUnitRate).Width(100).Title("Unit Rate").Format("{0:N4}");
                                column.Command(command =>
                                {
                                    command.Custom("CustomCmdSelect").Text("&nbsp;&nbsp;Add").Click("CopyCurrentWorkItemFromProjectEstimationToDurationEstimation").IconClass("fa fa-check");
                                }).Width(100);
                            })
                            .ToolBar(toolbar =>
                            {
                                toolbar.Custom().Text("&nbsp;&nbsp;Copy All").Name("CustomCmdCopyAll").IconClass("fa fa-copy").Url("#").HtmlAttributes(new { @class = " btn btn-primary", onclick = "copyAllWorkItemsFromProjectClicked()" });
                            })
                            //.Scrollable()
                            .Sortable()
                            .Selectable(selectable =>
                            {
                                selectable.Mode(GridSelectionMode.Single);
                                selectable.Type(GridSelectionType.Row);
                            })
                            .Filterable()
                                .Events(ev =>
                                {
                                    ev.DataBound("CopyWorkItemFromProjectGridDataBound");
                                })
                                //.Editable(editable => editable.Mode(GridEditMode.InLine))
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Group(g => {
                                        g.Add(c => c.SubProjectTypeName);
                                        g.Add(c => c.BlockName);
                                        g.Add(c => c.StructureType);
                                        g.Add(c => c.WorkCategory);
                                    })
                                    .Model(model =>
                                    {
                                        model.Id(p => p.Id);
                                        //model.Field(p => p.IsSelected);
                                    })
                                    //.Read(read => read.Action("ReadPredecessors", "Scheduler"))
                                    .Read(read =>
                                    {
                                        read.Action("WorkItemToCopyToDuration_Read", "WorkItemDuration")
                                        .Data("getFilterPreferenceData");
                                    })

                                )
                        ) 
                    </text>
                );
        })
    )
    }