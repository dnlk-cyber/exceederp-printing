<script>
    var selectedProjectId = 0;
    //var projectIdToCopyEstimationTo = 0;
    var currentSelectedProject = 0;
    var subProjectTypeId = 0;
    var blockId = 0;
    var strTypeId = 0;
    var catId = 0;

    $(document).ready(function () {
        //var btn2 = $("#addEstimationToScheduleButton");
        //btn2.attr('disabled', true);

        var url = window.location.href;

        var parameterName = 'p';
        //if (!url) url = window.location.href;
        parameterName = parameterName.replace(/[\[\]]/g, '\\$&');
        var regex = new RegExp('[?&]' + parameterName + '(=([^&#]*)|&|#|$)');
        var results = regex.exec(url);
        if (!results) projectType = null;
        if (!results[2]) projectType = '';
        var stringValue = decodeURIComponent(results[2].replace(/\+/g, ' '));
        selectedProjectId = parseInt(stringValue)
        grid = $("#WorkItemGrid").data("kendoGrid");
        grid.dataSource.read();
    });
    function onDataBound() {
        $(".k-grid-CopyDataToSchedule").find("span").addClass("fa fa-share ");

        $(".k-grid-FetchLatestChanges").find("span").addClass("fa fa-refresh ");

    }
    function getIdOfOpenedProject() {
        return {
            currentProjectId: selectedProjectId
        };
    }
    function fetchLatestInformationFromEstimation(id) {
         var recordStatus = "";
        // primary buttons
        var btn1 = $("#fetchLatestButtn");
        var btn2 = $("#addEstimationToScheduleButton");
        btn1.attr('disabled', true);
        btn2.hide();
        // rotating buttons
        var bt1 = $("#fetchLoadingIcon");
        var bt2 = $("#copyLoadingIcon");
        bt1.show();
        bt2.hide();
        $.ajax({
            type: "POST",
            url: '@Url.Action("UpdateDurationDataFromEstimation", "WorkItemDuration", new { area = "Construction" })',
            data: { targetProjectId: id},
            cache: false,
            success: function (result) {
                // toastr.warnning(result.Message);
                bt1.hide();
                bt2.hide();
                btn1.attr('disabled', false);
                btn2.show();
                alert(result.Message);
                recordStatus = result.Status;
                if (recordStatus === "Ok") {
                    location.reload(true);
                }
            }, //end succ
            error: function (result) {
                bt1.hide();
                bt2.hide();
                alert(result.Message);
            }
        });
    }

    function copyDataFromEstimation(id) {
        projectIdToCopyEstimationTo = id;
        var editorGrid = $("#workItemsFromProjectPopUpGrid").data("kendoGrid");

        var wdw = $("#CopyWorkItemsFromProjectWindow").data("kendoWindow");
        var blockTypeSelector = $("#SubProjectTypeId").data("kendoComboBox");
        blockTypeSelector.dataSource.read();
        editorGrid.dataSource.data([]);
        wdw.open();
        wdw.center();
    }
    function LoadWorkItems(e) {
        var editorGrid = $("#workItemsFromProjectPopUpGrid").data("kendoGrid");
        editorGrid.dataSource.read();

    }
    function getSelectedProjectId() {
        return { projectId: selectedProjectId };
    }
    function getFilterPreferenceData() {
        return {
            projectId: selectedProjectId,
            blkTypeId: subProjectTypeId,
            blockId: blockId,
            configId: strTypeId,
            catId: catId
        };
    }
    function getSelectedSubProjectTypeIdAndProjectId() {
        return {
            subProjectTypeId: subProjectTypeId,
            projectId: selectedProjectId
        };
    }
    function subProjectTypeListChanged(e) {
        //alert(this.value() + " " + projectIdToCopyEstimationTo);
        subProjectTypeId = this.value();

        // refresh the datasource of the dropdown list that depends on this change
