    function addEstimationDataToSchedule(id) {
        var recordStatus = "";
        // primary buttons
        var btn1 = $("#fetchLatestButtn");
        var btn2 = $("#addEstimationToScheduleButton");
        btn1.hide();
        btn2.attr('disabled', true);
        // rotating buttons
        var bt1 = $("#fetchLoadingIcon");
        var bt2 = $("#copyLoadingIcon");
        bt1.hide();
        bt2.show();
        $.ajax({
            type: "POST",
            url: '@Url.Action("CopyEstimationDataToSchedule", "WorkItemDuration", new { area = "Construction" })',
            data: { targetProjectId: id},
            cache: false,
            success: function (result) {
                bt1.hide();
                bt2.hide();
                btn2.attr('disabled', false);
                btn1.show();
                alert(result.Message);
                recordStatus = result.Status;
                if (recordStatus === "Ok") {
                    location.reload(true);
                }
            }, //end succ
            error: function (result) {
                bt1.hide();
                bt2.hide();
                alert(result.Message);
            }
        });
    }
