@using System.Collections
@using ExceedERP.Core.Domain.HRM
@using ExceedERP.Core.Localization

@(Html.Kendo().DropDownListFor(m => m)
                    .OptionLabel(Resources.Select)
                    .DataTextField("TakeOffNo")
                    .DataValueField("TakeOffPerProjectId")
                    //.BindTo((IEnumerable)ViewData["TakeOffs"])
                    .DataSource(dataSource =>
                    {
                        dataSource.Read(read => read.Action("GetProjectTakeOffSheets", "DataProvider", new { currentProjectId = "#=ProjectInformationId#" }));
                        //.ServerFiltering(true);
                    })
                    .ValuePrimitive(true)
                    .Filter("contains")
                    .MinLength(2)

)