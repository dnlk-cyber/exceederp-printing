@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Work BreakDown</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
          .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Name).Width(150);
          columns.Bound(c => c.Code).Width(150);
          columns.Bound(c => c.Category).Width(200);
          columns.Bound(c => c.BranchId).Width(150);
          columns.Bound(c => c.ContractAmount).Width(150);


          columns.Bound(c => c.Client);

         // columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
         // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                  .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ProjectInformation").Window(window => { window.Title("Project Information"); window.Scrollable(false); }))
          .Scrollable(h => h.Height(500))
                             .Groupable()
                                      .Sortable(sortable =>
                                      {
                                          sortable.SortMode(GridSortMode.SingleColumn);
                                      })
                          .Filterable()
                             .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
               .Ajax()
                           .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")"))
          .Model(model => model.Id(p => p.ProjectInformationId))
          .Read(read => read.Action("ProjectInformation_Read", "ProjectInformation"))
          .Create(create => create.Action("ProjectInformation_Create", "ProjectInformation"))
          .Update(update => update.Action("ProjectInformation_Update", "ProjectInformation"))
          .Destroy(destroy => destroy.Action("ProjectInformation_Destroy", "ProjectInformation"))
          ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=ProjectInformationId#")
          .SelectedIndex(0)
          .Items(items =>
          {

              items.Add().Text("Project Work BreakDown").Content(
                @<text>
    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectWorkBreakDown>()
                      .Name("ProjectWorkBreakDown_#=ProjectInformationId#")
      .Columns(columns =>
      {
          columns.Bound(c => c.WBSCode);
          columns.Bound(c => c.Description);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
                                 .Events(events => events.Error("error_handler(\"ProjectWorkBreakDown_#=ProjectInformationId#\")"))
          .Model(model => model.Id(p => p.ProjectWorkBreakDownId))
                  .Read(read => read.Action("ProjectWorkBreakDown_Read", "ProjectWorkBreakDown", new { id = "#=ProjectInformationId#" }))
                  .Create(create => create.Action("ProjectWorkBreakDown_Create", "ProjectWorkBreakDown", new { idTwo = "#=ProjectInformationId#" }))
          .Update(update => update.Action("ProjectWorkBreakDown_Update", "ProjectWorkBreakDown"))
          .Destroy(destroy => destroy.Action("ProjectWorkBreakDown_Destroy", "ProjectWorkBreakDown"))
      ).ToClientTemplate()
    )





                   


                </text>
                  );


          }).ToClientTemplate())
</script>







<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }

    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }



</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>

