@using ExceedERP.Core.Localization
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectTakeOffLine>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.T);
        columns.Bound(c => c.D);
        columns.Bound(c => c.S);
        columns.Bound(c => c.Description);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ProjectTakeOffLineId))
          .Read(read => read.Action("ProjectTakeOffLine_Read", "ProjectTakeOffLine"))
          .Create(create => create.Action("ProjectTakeOffLine_Create", "ProjectTakeOffLine"))
          .Update(update => update.Action("ProjectTakeOffLine_Update", "ProjectTakeOffLine"))
          .Destroy(destroy => destroy.Action("ProjectTakeOffLine_Destroy", "ProjectTakeOffLine"))
      )
)
