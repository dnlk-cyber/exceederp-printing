@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Setting | Labor Rate Index Factor Setting </legend>
@(Html.Kendo().TabStrip()
         .Name("tabstrip_index_factor")
         .SelectedIndex(0)
         .Items(items =>
         {
         items.Add().Text("Index Factor Calculations").Content(
            @<text>
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.LaborRateIndexFactorAttribute>()
                          .Name("attributeGrid")
                          .Columns(columns =>
                          {

                              columns.ForeignKey(c => c.LaborRateIndexFactorAttributeNameId, (IEnumerable)ViewData["AttributeNames"], "LaborRateIndexFactorAttributeNameId", "Name").EditorTemplateName("AttributeNames").Width(200).Title("Description");
                              columns.Bound(c => c.CalculationDescription).Title("Calculation").Width(120);
                              columns.Bound(c => c.NumberOfDays).Title("Number of Days").Width(120);
                              columns.Bound(c => c.Index).Width(100).Title("Index")
                                                                          .ClientFooterTemplate("Total  : #=sum# ");
                              columns.Bound(c => c.ApprovedIndex).Width(100).Title("Approved Index")
                                                                          .ClientFooterTemplate("Total  : #=sum# ");

                              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Resources").Window(window => { window.Title("Resource"); window.Scrollable(false); }))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                        .Scrollable(h => h.Height(700))
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                        .Filterable()
                        .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .PageSize(20)
                              .Events(events => events.Error("grid_error"))
                              .Aggregates(aggregates =>
                              {
                                  aggregates.Add(p => p.Index).Sum();
                                  aggregates.Add(p => p.ApprovedIndex).Sum();
                              })
                              .Model(model =>
                              {
                                  model.Id(res => res.LaborRateIndexFactorAttributeNameId);
                                  model.Field(res => res.Index).Editable(false);
                              })
                              .Read(read => read.Action("Attributes_Read", "LaborRateIndexFactorAttribute"))
                              .Create(create => create.Action("Attribute_Create", "LaborRateIndexFactorAttribute"))
                              .Update(update => update.Action("Attribute_Update", "LaborRateIndexFactorAttribute"))
                              .Destroy(destroy => destroy.Action("Attribute_Destroy", "LaborRateIndexFactorAttribute"))
                          )
                )
            </text>
                 );
             items.Add().Text("I.F. Attributes").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.LaborRateIndexFactorAttributeName>()
                          .Name("attributeNameGrid")
                          .Columns(columns =>
                          {

                              //columns.Bound(c => c.LaborRateIndexFactorAttributeNameId).Title("Id");
                              columns.Bound(c => c.Name);
                              columns.Bound(c => c.Description);

                              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Resources").Window(window => { window.Title("Resource"); window.Scrollable(false); }))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                        .Scrollable(h => h.Height(700))
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                        .Filterable()
                        .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .PageSize(20)
                              .Events(events => events.Error("grid_error"))
                              .Model(model =>
                              {
                                  model.Id(res => res.LaborRateIndexFactorAttributeNameId);
                                  //model.Field(res => res.UnitWeight).Editable(false);
                              })
                              .Read(read => read.Action("AttributeName_Read", "LaborRateIndexFactorAttributeName"))
                              .Create(create => create.Action("AttributeName_Create", "LaborRateIndexFactorAttributeName"))
                              .Update(update => update.Action("AttributeName_Update", "LaborRateIndexFactorAttributeName"))
                              .Destroy(destroy => destroy.Action("AttributeName_Destroy", "LaborRateIndexFactorAttributeName"))
                          )
                    )
                </text>
                 );
         }
         )
)








<script>
      function grid_error(e) {
          if (e.errors) {
              var message = "Errors:\n";
              $.each(e.errors, function (key, value) {
                  if ('errors' in value) {
                      $.each(value.errors, function () {
                          message += this + "\n";
                      });
                  }
              });
              alert(message);
              var grid = $("#attributeGrid").data("kendoGrid");
              grid.cancelChanges();
          }
      }
</script>
