@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Material Utilization</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
          .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Name).Width(300);
          columns.Bound(c => c.Code).Width(150);
          columns.Bound(c => c.Category).Width(200);
          columns.Bound(c => c.BranchId).Width(150);
          columns.Bound(c => c.ContractAmount).Width(150);


          columns.Bound(c => c.Client).Width(150);

          //columns.Command(command =>
          //{
          //   // command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
          //    //command.Destroy();
          //}).Width(180);
      })
      .ToolBar(toolbar =>
      {
          //toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                  .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ProjectInformation").Window(window => { window.Title("Project Information"); window.Scrollable(false); }))
          .Scrollable(h => h.Height(500))
                             .Groupable()
                                      .Sortable(sortable =>
                                      {
                                          sortable.SortMode(GridSortMode.SingleColumn);
                                      })
                          .Filterable()
                             .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
               .Ajax()
                           .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")")
                            //  .Sync("sync_handler")
                              )
          .Model(model => model.Id(p => p.ProjectInformationId))
              .Read(read => read.Action("ProjectInformation_Read", "ProjectBudgetDefination"))
          .Create(create => create.Action("ProjectInformation_Create", "ProjectInformation"))
          .Update(update => update.Action("ProjectInformation_Update", "ProjectInformation"))
          .Destroy(destroy => destroy.Action("ProjectInformation_Destroy", "ProjectInformation"))
          ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=ProjectInformationId#")
          .SelectedIndex(0)
          .Items(items =>
          {

              items.Add().Text("Material Utilization").Content(
                @<text>

                  @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.MaterialUtilization>()
                      .Name("MaterialUtilization_#=ProjectInformationId#")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.ProjectMaterialId, (IEnumerable)ViewData["Materials"], "ProjectMaterialId", "Name").Width(120);
          columns.Bound(c => c.RequestedQuantity).Width( 120);
          columns.Bound(c => c.DeliveredQuantity).Width( 120);
          columns.Bound(c => c.RemainingQuantity).Width( 120);        
          columns.Bound(c => c.MaterialIssuedToSite);         
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                              .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("MaterialUtilization").Window(window => { window.Title("Material Utilization"); window.Scrollable(false); }))
                                      .ClientDetailTemplateId("templateTwo")
      .Scrollable(h=> h.Height( 500))
      .DataSource(dataSource => dataSource
          .Ajax()
                                    .Events(events => events.Error("error_handler(\"MaterialUtilization_#=ProjectInformationId#\")")
                                      .Sync("sync_handler")
                                      )
          .Model(model => model.Id(p => p.MaterialUtilizationId))
                  .Read(read => read.Action("MaterialUtilization_Read", "MaterialUtilization", new { id = "#=ProjectInformationId#" }))
                  .Create(create => create.Action("MaterialUtilization_Create", "MaterialUtilization", new { idTwo = "#=ProjectInformationId#" }))
          .Update(update => update.Action("MaterialUtilization_Update", "MaterialUtilization"))
          .Destroy(destroy => destroy.Action("MaterialUtilization_Destroy", "MaterialUtilization"))
      ).ToClientTemplate()
                )




                </text>
                  );


          }).ToClientTemplate())
</script>

