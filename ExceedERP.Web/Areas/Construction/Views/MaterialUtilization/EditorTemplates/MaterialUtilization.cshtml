@using System.Collections
@using ExceedERP.Helpers.Common
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.Construction.MaterialUtilization 

<form>
    <div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.ProjectMaterialId, htmlAttributes: new {@class = "control-label col-md-8"})

            </div>
            <div>

                @(Html.Kendo().DropDownListFor(model => model.ProjectMaterialId)
                .ValuePrimitive(true)
                                  .OptionLabel("Select..")
                                                                  .DataTextField("Name")
                                                                .DataValueField("ProjectMaterialId")
                                                                .BindTo((IEnumerable)ViewData["Materials"]))
                @Html.ValidationMessageFor(model => model.ProjectMaterialId, "", new { @class = "text-danger" })



            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.RequestedQuantity, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>

                @Html.Kendo().TextBoxFor(model => model.RequestedQuantity)
                @Html.ValidationMessageFor(model => model.RequestedQuantity, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="k-label">
                @Html.LabelFor(model => model.DeliveredQuantity, htmlAttributes: new { @class = "control-label col-md-8" })

            </div>
            <div>

                @Html.Kendo().TextBoxFor(model => model.DeliveredQuantity)
                @Html.ValidationMessageFor(model => model.DeliveredQuantity, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
  
   

</div>

<br/>


<div class="row">
    <div class="col-md-1">

    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.RemainingQuantity, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">
            @Html.Kendo().TextBoxFor(model => model.RemainingQuantity)
            @Html.ValidationMessageFor(model => model.RemainingQuantity, "", new { @class = "text-danger" })
        </div>
    </div>
   
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.MaterialIssuedToSite , htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">

            @Html.Kendo().TextBoxFor(model => model.MaterialIssuedToSite)
            @Html.ValidationMessageFor(model => model.MaterialIssuedToSite, "", new { @class = "text-danger" })
        </div>
    </div>
 
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">
            @Html.TextAreaFor(model => model.Remark)
            @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
        </div>
    </div>


</div>

   

   

    

</form>
