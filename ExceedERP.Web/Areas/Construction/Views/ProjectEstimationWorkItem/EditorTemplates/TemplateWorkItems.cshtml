@using System.Collections
@using ExceedERP.Core.Domain.HRM
@using ExceedERP.Web.Areas.Construction
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        .DataTextField("ItemName")
        .DataValueField("ProjectEstimationWorkItemId")
        //.BindTo((IEnumerable)ViewData["TemplateWorkItems"])
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetTemplateWorkItems", "DataProvider", new { categoryId = "#=WorkCategoryId#" })
            .Data("getSelectedProjectType"));
        })
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)