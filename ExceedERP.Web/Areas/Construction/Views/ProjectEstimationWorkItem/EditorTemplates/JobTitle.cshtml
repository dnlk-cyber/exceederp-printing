@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM
@(Html.Kendo().DropDownListFor(m => m)
    .OptionLabel( Resources.Select)
    .DataTextField("Title")
    .DataValueField("ProjectEstimationIndexLabourId")
    //.BindTo((IEnumerable)ViewData["titles"])
    .DataSource(dataSource =>
    {
        dataSource.Read(read => read.Action("GetProjectJobTitles", "DataProvider"));
    })
    .Filter("contains")
    .MinLength(2)
    .ValuePrimitive(true)
)