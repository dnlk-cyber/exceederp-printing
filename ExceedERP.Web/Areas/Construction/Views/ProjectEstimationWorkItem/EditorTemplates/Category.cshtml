@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM
@(Html.Kendo().DropDownListFor(m => m)
    .OptionLabel(Resources.Select)
    .DataTextField("Name")
    .DataValueField("WorkCategoryId")
    //.BindTo((IEnumerable)ViewData["Categories"])
    .DataSource(dataSource =>
    {
        dataSource.Read(read => read.Action("GetWorkCategories", "DataProvider").Data("getSelectedProjectType"));
    })
    .Filter("contains")
    .MinLength(2)
    .ValuePrimitive(true)
)