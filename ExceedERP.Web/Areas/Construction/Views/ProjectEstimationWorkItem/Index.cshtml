                                    model.Id(p => p.ProjectEstimationAreaWorkItemId);
                                    model.Field(p => p.Area).Editable(false);
                                    model.Field(p => p.OverHeadProfitCost).Editable(false);
                                    model.Field(p => p.MaterialCost).Editable(false);
                                    model.Field(p => p.DirectCost).Editable(false);
                                })
