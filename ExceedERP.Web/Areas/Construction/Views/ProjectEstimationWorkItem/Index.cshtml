                                    .Data("getSelectedProjectType");
                                })
                                .Update(update => update.Action("ProjectEstimationAreaWorkItem_Update", "EstmnPriceRateWorkItem"))
                                .Destroy(destroy => destroy.Action("ProjectEstimationAreaWorkItem_Destroy", "EstmnPriceRateWorkItem"))
                            )
                    )
                </text>
                );
