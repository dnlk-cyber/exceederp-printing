<script>
    var projectType = -1;
    $(document).ready(function () {
        var url = window.location.href;

        var parameterName = 'type';
        //if (!url) url = window.location.href;
        parameterName = parameterName.replace(/[\[\]]/g, '\\$&');
        var regex = new RegExp('[?&]' + parameterName + '(=([^&#]*)|&|#|$)');
        var results = regex.exec(url);
        if (!results) projectType = null;
        if (!results[2]) projectType = '';
        var stringValue = decodeURIComponent(results[2].replace(/\+/g, ' '));
        projectType = parseInt(stringValue)
        //someshit;
        var headerTextValue = "Estimation Template";
        if (projectType === 0) {
            headerTextValue = "Estimation Template | Template for Building Projects"
        }
        else if (projectType === 1) {
            headerTextValue = "Estimation Template | Template for Road Projects"
        }
        else if (projectType === 2) {
            headerTextValue = "Estimation Template | Template for Dam Projects"
        }
        else if (projectType === 3) {
            headerTextValue = "Estimation Template | Template for Irrigation Projects"
        }
        else {
            headerTextValue = "Estimation Template"
        }
        $("#pageHeaderText").html(headerTextValue);

        grid = $("#ProjectEstimationWorkItemgrid").data("kendoGrid");
        grid.dataSource.read();
        grid1 = $("#ProjectEstimationAreaWorkItemgrid").data("kendoGrid");
        grid1.dataSource.read();
        grid2 = $("#SubContractWorkItemgrid").data("kendoGrid");
        grid2.dataSource.read();
        //grid3 = $("#customWorkItemGrid").data("kendoGrid");
        //grid3.dataSource.read();
        grid4 = $("#customWorkItemGrid1").data("kendoGrid");
        grid4.dataSource.read();

        // attach a click handler to the submit button, inject the action property manually and submit the form result
        $("#submitSelectedFilesButton").click(function () {
            var btn = $("#submitSelectedFilesButton");
            var frm = $("#uploadFilesForm");
            frm.attr("action", "/Construction/ProjectEstimationWorkItem/ImportTemplateWorkItemsFromExcel?type=" + projectType);
            btn.submit();
        });
    });
        
    function getSelectedProjectType() {
        return {
            type: projectType
        };
    }
    function sync_handler(e) {
        this.read();
    }
    function filter() {
        var value = this.value(),
          grid = $("#ProjectEstimationWorkItemgrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "ProjectTypeId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }

        $.ajax({
            url: '@Url.Action("SetProjectId", "ProjectEstimationWorkItem")',
            //contentType: "application/json; charset=utf-8",
            data: { value: value },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
            }
        });
    }
</script>

<script>
    function OnChange(e) {
        var grid = e.select();
        var selectedRows = this.select();
        var rowData = this.dataItem(selectedRows[0]);
        var Quantity = rowData.Quantity;
        var UnitPrice = rowData.Quantity;
        $("#TotalCost").val(Quantity * UnitPrice);
        var grid = $('#ProjectEstimationWorkItemgrid').data("kendoGrid");

        grid.dataSource.read();
    }
</script>
<script type="text/javascript">
    function onEdit(e) {


        $.ajax({
            url: '@Url.Action("ReturnValues", "ProjectEstimationWorkItem")',
            //contentType: "application/json; charset=utf-8",
            data: {},
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                var s = r.split(/-/);



                if (e.model.isNew()) {
                    //set the default value for StateID
                    e.model.set("OverheadRate", s[0]);
                    e.model.set("ProfitMargin", s[1]);
                }
            }

        });
        //check if record is new

    }
    function filterCategories() {
        //
        // summary:
        //      send the filtering text along with the parent widget's value
        var dropdownlist = $("#ItemCode").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            ItemCategoryCode: $("#ItemCategoryCode").val(), filterString: filterInput.val()
        };
    }
    function filterType() {
        return {
            EquipmentIdentityID: $("#EquipmentIdentityID").val()
        };
    }
    function FilterAsset() {
        return {
            EquipmentTypeID: $("#EquipmentTypeID").val()
        };
    }
    function actionSave() {
        var grid = $('#ProjectEstimationWorkItemgrid').data("kendoGrid");

        grid.dataSource.read();
    }

    function Refresh() {
        window.location.reload();
    }


    function filterProject() {

        var block = $("#BlockId").data("kendoComboBox");


        var blockId = block.value();
        var value = this.value(),
            grid = $("#ProjectEstimationWorkItemgrid").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "BlockId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }



        var grid2 = $("#ProjectEstimationAreaWorkItemgrid").data("kendoGrid");

        if (value) {
            grid2.dataSource.filter({ field: "BlockId", operator: "eq", value: parseInt(value) });
        } else {
            grid2.dataSource.filter({});
        }



        var grid3 = $("#SubContractWorkItemgrid").data("kendoGrid");

        if (value) {
            grid3.dataSource.filter({ field: "BlockId", operator: "eq", value: parseInt(value) });
        } else {
            grid3.dataSource.filter({});
        }
        $.ajax({
            url: '@Url.Action("SetBlock", "ProjectEstimationWorkItem")',
            //contentType: "application/json; charset=utf-8",
            data: { blockId: blockId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

            }

        });


    }
    function tabReload(tabName) {
        //var combinedName = "#" + tabName;
        var grid = $("#ProjectEstimationWorkItemgrid").data("kendoGrid");
        grid.dataSource.read();
        var tab = $("#tabstrip").data("kendoTabStrip");
        tab.tabGroup.on('click', 'li', function (e) {
            tab.reload($(this));
        });
    }
    function onWorkItemDataBound() {
        $(".k-grid-Refresh").find("span").addClass("fa fa-refresh");
    }


    function showFileBrowseForm() {
        var icHide = $("#hideBrowseWindow");
        icHide.show();
        $("#importQuantityDiv").show();
        var icShow = icShow = $("#showBrowseWindow");
        icShow.hide();
    }
    function hideFileBrowseForm() {
        var icHide = $("#hideBrowseWindow");
        icHide.hide();
        $("#importQuantityDiv").hide();
        var icShow = icShow = $("#showBrowseWindow");
        icShow.show();
    }

</script>

