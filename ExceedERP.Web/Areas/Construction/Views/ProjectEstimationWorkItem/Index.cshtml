    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=ProjectEstimationWorkItemId#")
          .SelectedIndex(0)
          //.Events(e => e.Activate("tabReload(\"tabstrip_#=ProjectEstimationWorkItemId#\")"))
          .Items(items =>
          {
          items.Add().Text("Detail").Content(
    @<text>
        

        @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.WorkItemDetailViewModel>()
                                    .Name("detail__#=ProjectEstimationWorkItemId#")
                                    .Columns(columns =>
                                    {

                                        columns.Bound(c => c.Attribute).Title(" ").ClientTemplate("\\#=Attribute\\#: \\#=Value\\#");
                                    })

                                     //.Selectable(selectable =>
                                     //{
                                     //    selectable.Mode(GridSelectionMode.Single);
                                     //    selectable.Type(GridSelectionType.Row);
                                     //})
                                     .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))
                                    .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Events(events =>
                                        {
                                            events.Error("error_handler(\"detail__#=ProjectEstimationWorkItemId#\")");
                                            events.RequestStart("onRequestStart(\"detail__#=ProjectEstimationWorkItemId#\")");
                                            events.RequestEnd("onRequestEnd(\"detail__#=ProjectEstimationWorkItemId#\")");
                                        })
                                        .Model(model =>
                                        {
                                            model.Id(p => p.Id);
                                            //model.Field(p => p.TotalCost).Editable(false);
                                            //model.Field(p => p.Unit).Editable(false);
                                            //model.Field(p => p.UnitPrice).Editable(false);
                                        })
                                        .Read(read => read.Action("SpecificWorkItemDetail_Read", "ProjectEstimationWorkItem", new { id = "#=ProjectEstimationWorkItemId#" }))
                                    //.Create(create => create.Action("ProjectEstimationMaterial_Create", "ProjectEstimationMaterial", new { idtow = "#=ProjectEstimationWorkItemId#" }))
                                    //.Update(update => update.Action("ProjectEstimationMaterial_Update", "ProjectEstimationMaterial"))
                                    //.Destroy(destroy => destroy.Action("ProjectEstimationMaterial_Destroy", "ProjectEstimationMaterial"))

                                    ).ToClientTemplate()
        )
    </text>
                  );
              items.Add().Text("Material Cost").Content(
    @<text>

        @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectEstimationMaterial>()
                                    .Name("Material_#=ProjectEstimationWorkItemId#")
                                    .Columns(columns =>
                                    {
                                        columns.ForeignKey(c => c.ItemCategoryCode, (IEnumerable)ViewData["ItemCategorys"], "ItemCategoryCode", "Name").EditorTemplateName("ItemCategory").Width(120);
                                        columns.ForeignKey(c => c.ItemCode, (IEnumerable)ViewData["Items"], "ItemCode", "Name").EditorTemplateName("Item").Width(120);
                                        columns.Bound(c => c.Unit).Width(50);//, (IEnumerable)ViewData["Unit"], "Description", "Description").EditorTemplateName("Unit").Width(75);
                                        columns.Bound(c => c.Quantity).Width(50);
                                        columns.Bound(c => c.UnitPrice).Width(50).Format("{0:N4}");

                                        columns.Bound(c => c.TotalCost).Width(100).Format("{0:N4}")
                                            .ClientFooterTemplate("Total: \\#= kendo.toString(sum, 'N4')\\#");
                                        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                                    })
                                    .ToolBar(toolbar =>
                                    {
                                        toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                    })
                                    .Selectable(selectable =>
                                    {
                                        selectable.Mode(GridSelectionMode.Single);
                                        selectable.Type(GridSelectionType.Row);
                                    })
                                    .Editable(editable => editable.Mode(GridEditMode.InLine))
                                    //.Scrollable(h => h.Height(500))
                                    //.Events(e => e.Change("OnChange"))
                                    //.Events(e => e.Save("actionSave"))
                                    //                .Events(e => e.Remove("actionSave"))
                                    .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Events(events =>
                                        {
                                            events.Error("error_handler(\"Material_#=ProjectEstimationWorkItemId#\")");
                                            events.RequestStart("onRequestStart(\"Material_#=ProjectEstimationWorkItemId#\")");
                                            events.RequestEnd("onRequestEnd(\"Material_#=ProjectEstimationWorkItemId#\")");
                                        })

                                        .Aggregates(aggregates =>
                                        {
                                            aggregates.Add(p => p.TotalCost).Sum();
                                            aggregates.Add(p => p.UnitPrice).Sum();
                                            aggregates.Add(p => p.Quantity).Sum();
                                        })
                                        .Model(model =>
                                        {
                                            model.Id(p => p.ProjectEstimationMaterialId);
                                            model.Field(p => p.TotalCost).Editable(false);
                                            model.Field(p => p.Unit).Editable(false);
                                            model.Field(p => p.UnitPrice).Editable(false);
                                        })
                                        .Read(read => read.Action("ProjectEstimationMaterial_Read", "ProjectEstimationMaterial", new { id = "#=ProjectEstimationWorkItemId#" }))
                                        .Create(create => create.Action("ProjectEstimationMaterial_Create", "ProjectEstimationMaterial", new { idtow = "#=ProjectEstimationWorkItemId#" }))
                                        .Update(update => update.Action("ProjectEstimationMaterial_Update", "ProjectEstimationMaterial"))
                                        .Destroy(destroy => destroy.Action("ProjectEstimationMaterial_Destroy", "ProjectEstimationMaterial"))

                                    ).ToClientTemplate()
        )

    </text>
                );
