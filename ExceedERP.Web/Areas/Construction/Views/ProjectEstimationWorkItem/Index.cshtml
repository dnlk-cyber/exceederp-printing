<script id="template" type="text/kendo-tmpl">
    #if(!IsSubCategory){#
    @*<script type="text/javascript">
            function reloadTab_#=Id#(e) {
             $('\#TabStrip_#=Id#').data('kendoTabStrip').reload(e.item);
