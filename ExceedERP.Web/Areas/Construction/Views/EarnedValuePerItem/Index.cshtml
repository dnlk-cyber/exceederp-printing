@using ExceedERP.Core.Localization
@using System.Collections
@using ExceedERP.Core.Domain.Construction
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Earned Value Analysis | Analysis by Item</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
        .Name("ProjectInformationgrid")
        .Columns(columns =>
        {
            columns.Bound(c => c.Name).Width(150);
            //columns.Bound(c => c.Code).Width(150);
            columns.Bound(c => c.ProjectType).Width(150);
            columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").EditorTemplateName("Branch").Width(150);
            columns.Bound(c => c.ContractAmount).Width(150).ClientTemplate(
                "# if (ContractAmount === 0) { #" +
                                            " -----" +
                                            "# } else {#" +
                                            "#: kendo.toString( ContractAmount, 'N2') #" +
                                            "# } #"
                );
            columns.Bound(c => c.Client).Width(150);

        })
        .Scrollable(h => h.Height(700))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        .Filterable()
        .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events =>
            {
                events.Error("error_handler(\"ProjectInformationgrid\")");
                events.RequestStart("onRequestStart(\"ProjectInformationgrid\")");
                events.RequestEnd("onRequestEnd(\"ProjectInformationgrid\")");
            }).Model(model => model.Id(p => p.ProjectInformationId))
            .Read(read => read.Action("ProjectInformation_Read", "EarnedValuePerItem"))
        ).ClientDetailTemplateId("temlate_period")
)
<script id="temlate_period" type="text/kendo-tmpl">

    @(Html.Kendo().TabStrip()
            .Name("tabstrip_#=ProjectInformationId#")
            .SelectedIndex(0)
            .Items(items =>
            {
            
            items.Add().Text("Evaluation Periods").Content(
                @<text>
                    @(Html.Kendo().Grid<EarnedValueManagementPeriod>()
                              .Name("period_#=ProjectInformationId#")
                              .Columns(columns =>
                              {
                                  columns.ForeignKey(c => c.ConstructionPeriodId, (IEnumerable)ViewData["ConstructionPeriods"], "ConstructionPeriodId", "Name").Title("Period").EditorTemplateName("ConsPeriods");
                                  columns.Bound(c => c.Remark);

                                  columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                              })
                              .ToolBar(toolbar =>
                              {
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              })
                              .Pageable(pageable => pageable
                                  .Input(true)
                                  .Numeric(false)
                                  .Refresh(true)
                                  .PageSizes(true)
                                  .ButtonCount(10))
                              .Selectable()
                        .Scrollable(h => h.Height(500))
                              .Selectable(selectable =>
                              {
                                  selectable.Mode(GridSelectionMode.Single);
                                  selectable.Type(GridSelectionType.Row);
                              })
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                              .Filterable()
                              //.Events(ev => ev.DetailExpand("detailExpand"))
                              //.Events(x => x.DataBound("onDataBoundMaster"))

                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .Model(
                                      model =>
                                      {
                                          model.Id(p => p.EarnedValueManagementPeriodId);
                                      })
                                    .Events(ev => ev
                                                      .Error("error_handler(\"period_#=ProjectInformationId#\")")
                                                      .RequestStart("onRequestStart(\"period_#=ProjectInformationId#\")")
                                                      .RequestEnd("onRequestEnd(\"period_#=ProjectInformationId#\")"))

                                    .Read(read => read.Action("Periods_Read", "EarnedValueManagementPeriod", new { id = "#=ProjectInformationId#" }))
                                    .Create(create => create.Action("Period_Create", "EarnedValueManagementPeriod", new { id = "#=ProjectInformationId#" }))
                                    .Update(read => read.Action("Period_Update", "EarnedValueManagementPeriod"))
                                    .Destroy(read => read.Action("Period_Destroy", "EarnedValueManagementPeriod"))

                              ).ClientDetailTemplateId("workitem-records")
                              .ToClientTemplate()
                    )

                </text>
                );
            }).ToClientTemplate()
    )

</script>
<script id="workitem-records" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tab_#=EarnedValueManagementPeriodId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("Earned Values per Item").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.EarnedValuePerItem>()
                        .Name("earnedValue_#=EarnedValueManagementPeriodId#")
                        .Columns(columns =>
                        {
                            columns.ForeignKey(c => c.WorkItemPerProjectId, (IEnumerable)ViewData["ProjectWorkItems"], "WorkItemPerProjectId", "ItemName").Width(150).EditorTemplateName("ProjectWorkItems");
                            columns.Bound(c => c.Unit).Width(50);
                            columns.Group(g => g.Title("Inputs").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold;" })
                                .Columns(detail1 =>
                                {
                                    detail1.Group( igOne => igOne.Title("Quantity").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold;" })
                                        .Columns( innerDetailOne => {
                                            innerDetailOne.Bound(c => c.BudgetedQuantity).Width(60).Format("{0:N2}");
                                            innerDetailOne.Bound(c => c.PlannedQuanity).Width(60).Format("{0:N2}");
                                            innerDetailOne.Bound(c => c.ExecutedQuantity).Width(60).Format("{0:N2}");
                                        })
                                    );
                                    detail1.Group(igTwo => igTwo.Title("Unit Price").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold;" })
                                        .Columns(innerDetailTwo => {
                                            innerDetailTwo.Bound(c => c.EstimatedUnitPrice).Width(60).Format("{0:N2}");
                                            innerDetailTwo.Bound(c => c.ActualUnitPrice).Width(60).Format("{0:N2}");
                                        })
                                    );
                                    detail1.Bound(evp => evp.BAC).Width(60).Format("{0:N2}");
                                    detail1.Bound(evp => evp.BCWS).Width(60).Format("{0:N2}");
                                    detail1.Bound(evp => evp.BCWP).Width(60).Format("{0:N2}");
                                    detail1.Bound(evp => evp.ACWP).Width(60).Format("{0:N2}");
                                })
                                );
                            columns.Group(g => g.Title("Indicators").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold;" })
                                .Columns(detail2 =>
                                {
                                    detail2.Bound(x => x.PCP).Width(60).ClientTemplate("\\#=PCP\\#%");
                                    detail2.Bound(x => x.PCA).Width(60).ClientTemplate("\\#=PCA\\#%");
                                    detail2.Bound(x => x.CV).Width(60).Format("{0:N2}");
                                    detail2.Bound(x => x.CVPercentage).Width(60).Title("CV%").ClientTemplate("\\#=CVPercentage\\#%");
                                    detail2.Bound(x => x.CPI).Width(60);
                                    detail2.Bound(x => x.SV).Width(60).Format("{0:N2}");
                                    detail2.Bound(x => x.SVPercentage).Width(60).Title("SV%").ClientTemplate("\\#=SVPercentage\\#%");
                                    detail2.Bound(x => x.SPI).Width(60);
                                    detail2.Bound(x => x.CR).Width(60);
                                })
                                );
                            columns.Group(g => g.Title("Predictors").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                            .Columns(detail3 =>
                            {
                                detail3.Bound(x => x.TCPI).Width(60);
                                detail3.Bound(x => x.TSPI).Width(60);
                                detail3.Bound(x => x.EAC).Width(60).Format("{0:N2}");
                                detail3.Bound(x => x.VAC).Width(60).Format("{0:N2}");
                                detail3.Bound(x => x.ETC).Width(60).Format("{0:N2}");
                            })
                            );

                            columns.Command(command =>
                            {
                                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                command.Destroy().Text(Resources.ActionButton_Cancel);
                            }).Width(200);
                        })
                        .ToolBar(toolbar =>
                        {
                            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                        })
                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .Scrollable(h => h.Height(400))
                        .Selectable(selectable =>
                        {
                            selectable.Mode(GridSelectionMode.Single);
                            selectable.Type(GridSelectionType.Row);
                        })
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                        //.Filterable()
                        .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
                        // .Events(e => e.Edit("onEdit"))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            //.Group(group =>
                            //{
                            //    group.Add(evpp => evpp.Year);
                            //})
                            .Events(events =>
                            {
                                events.Error("error_handler(\"earnedValue_#=EarnedValueManagementPeriodId#\")");
                                events.RequestStart("onRequestStart(\"earnedValue_#=EarnedValueManagementPeriodId#\")");
                                events.RequestEnd("onRequestEnd(\"earnedValue_#=EarnedValueManagementPeriodId#\")");
                            })
                            .Model(model =>
                            {
                                model.Id(p => p.EarnedValuePerItemId);
                                model.Field(x => x.Unit).Editable(false);
                                model.Field(x => x.BAC).Editable(false);
                                model.Field(x => x.BCWS).Editable(false);
                                model.Field(x => x.BCWP).Editable(false);
                                model.Field(x => x.ACWP).Editable(false);
                                model.Field(x => x.PCP).Editable(false);
                                model.Field(x => x.PCA).Editable(false);
                                model.Field(x => x.CV).Editable(false);
                                model.Field(x => x.CVPercentage).Editable(false);
                                model.Field(x => x.SV).Editable(false);
                                model.Field(x => x.SVPercentage).Editable(false);
                                model.Field(x => x.CPI).Editable(false);
                                model.Field(x => x.SPI).Editable(false);
                                model.Field(x => x.CR).Editable(false);
                                model.Field(x => x.TCPI).Editable(false);
                                model.Field(x => x.TSPI).Editable(false);
                                model.Field(x => x.EAC).Editable(false);
                                model.Field(x => x.VAC).Editable(false);
                                model.Field(x => x.ETC).Editable(false);
                                //model.Field(x => x.SalaryperdayMax).Editable(false);
                                //model.Field(x => x.SalaryperMonthMin).Editable(false);
                                //model.Field(x => x.SalaryperMonthMax).Editable(false);
                            })
                            .Read(read => read.Action("EarnedValuePerItem_Read", "EarnedValuePerItem", new { periodId = "#=EarnedValueManagementPeriodId#" }))
                            .Create(create => create.Action("EarnedValuePerItem_Create", "EarnedValuePerItem", new { periodId = "#=EarnedValueManagementPeriodId#" }))
                            .Update(update => update.Action("EarnedValuePerItem_Update", "EarnedValuePerItem"))
                            .Destroy(destroy => destroy.Action("EarnedValuePerItem_Destroy", "EarnedValuePerItem"))
                        ).ToClientTemplate()
                    )
                </text>
                );
          }).ToClientTemplate())
</script>
