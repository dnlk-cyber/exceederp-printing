@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
                    //.Name("periodsList")
                    .OptionLabel(Resources.Select)
                    .DataTextField("Name")
                    .DataValueField("ConstructionPeriodId")
                    //.BindTo((IEnumerable)ViewData["ConstructionPeriods"])
                    .DataSource(dataSource =>
                    {
                        dataSource.Read(read => read.Action("GetConstructionPeriodsWithinProjectContractTime", "DataProvider", new { projectId = "#=ProjectInformationId#" }));
                    })
                    .ValuePrimitive(true)
                    .Filter("contains")
                    .MinLength(2)

)