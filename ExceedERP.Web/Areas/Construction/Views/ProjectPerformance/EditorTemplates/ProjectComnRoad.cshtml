                <div class="textbox-container">
                    @Html.Kendo().TextBoxFor(model => model.TelephoneComn).HtmlAttributes(new { @class = "custom-input" })
                    @Html.ValidationMessageFor(model => model.TelephoneComn, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <br />
            @*<div class="form-group">

                    <div class="k-label">
                        @Html.LabelFor(model => model.ClaimApprovalStatus, htmlAttributes: new { @class = "control-label col-md-12" })
                    </div>
                    <div>
                        @(Html.Kendo().ComboBoxFor(model => model.ClaimApprovalStatus)
                            .Placeholder(Resources.Select)
                            .DataTextField("Text")
