@using System.Collections
@using ExceedERP.Helpers.Common
@using ExceedERP.Core.Localization
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.Construction.MonthlyProjectCommunication
<form>
    <div class="row">
        <div class=" col-md-1"></div>
        <div class="col-md-2">
            <div class="k-label">
                @Html.LabelFor(model => model.ComnWithinProject, htmlAttributes: new { @class = "control-label col-md-12", @style = "font-weight:bold;text-align:center; font-size:14px" })
            </div>
        </div>
        <div class="col-md-2">
            <div class="k-label">
                @*@Html.LabelFor(model => model.NumberOfComplaints, htmlAttributes: new { @class = "control-label col-md-12", @style = "font-weight:bold;text-align:center; font-size:14px" })*@
                @Html.Label("Good Governance Complaints", htmlAttributes: new { @class = "control-label col-md-12", @style = "font-weight:bold;text-align:center; font-size:14px" })
