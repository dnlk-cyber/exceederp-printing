                    @Html.LabelFor(model => model.CloseDiscussionWithinProject, "close discusions and coopration within project commettee (0.35pts) ", htmlAttributes: new { @class = "control-label col-md-12" })
                </div>
                <div class="textbox-container">
                    @Html.Kendo().TextBoxFor(model => model.CloseDiscussionWithinProject).HtmlAttributes(new { @class = "custom-input" })
                    @Html.ValidationMessageFor(model => model.CloseDiscussionWithinProject, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.NumberOfComplaints, htmlAttributes: new { @class = "control-label col-md-12" })
                </div>
                <div class="textbox-container">
                    @Html.Kendo().NumericTextBoxFor(model => model.NumberOfComplaints).HtmlAttributes(new { @class = "custom-input" })
                    @Html.ValidationMessageFor(model => model.NumberOfComplaints, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <br />
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.WrittenComn, "Written Communication (0.25pts)", htmlAttributes: new { @class = "control-label col-md-12" })
                </div>
                <div class="textbox-container">
                    @Html.Kendo().TextBoxFor(model => model.WrittenComn).HtmlAttributes(new { @class = "custom-input" })
                    @Html.ValidationMessageFor(model => model.WrittenComn, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <br />
            <br />
            <div class="form-group">

                <div class="k-label">
                    @Html.LabelFor(model => model.ComnLevel, htmlAttributes: new { @class = "control-label col-md-12" })
                </div>
                <div class="textbox-container">
                    @(Html.Kendo().ComboBoxFor(model => model.ComnLevel)
                                    .Placeholder(Resources.Select)
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .HtmlAttributes(new { @class = "custom-input" })
                                    .ValuePrimitive(true)
                                    .BindTo(EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.Construction.MonthlyProjectCommunicationLevel))))
                </div>
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class=" col-md-1"></div>
        <div class="col-md-2">
            <br />
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.MobilizationAndDisscusstionWthinWorkers, " Mobilization and close discusions with all workers (0.35pts)", htmlAttributes: new { @class = "control-label col-md-12" })
