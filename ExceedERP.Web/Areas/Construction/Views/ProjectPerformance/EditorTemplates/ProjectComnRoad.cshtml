                </div>
                <div class="textbox-container">
                    @Html.Kendo().TextBoxFor(model => model.GoodGovernanceComplaints).HtmlAttributes(new { @class = "custom-input" })
                    @Html.ValidationMessageFor(model => model.GoodGovernanceComplaints, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <br />
            <div class="form-group">

                <div class="k-label">
