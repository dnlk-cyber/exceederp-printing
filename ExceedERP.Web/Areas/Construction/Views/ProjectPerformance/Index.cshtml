@helper RenderMonthlyProgressTabContent() { 
        @(Html.Kendo().Grid<MonthlyProjectProgress>()
                              .Name("progress_#=PeriodMappingId#")
                              .Columns(columns =>
                              {
                                  //columns.Bound(c => c.PeriodMappingId).Hidden();
                                  columns.Bound(c => c.PlannedAmount).Format("{0:N2}");
                                  columns.Bound(c => c.PlannedAmountTillPreviousMonth).Format("{0:N2}");
                                  columns.Bound(c => c.PlannedToDate).Format("{0:N2}");
                                  columns.Bound(c => c.ExecutedAmount).Format("{0:N2}");
                                  columns.Bound(c => c.ExecutedAmountTillPreviousMonth).Format("{0:N2}");
                                  columns.Bound(c => c.ExecutedAmountToDate).Format("{0:N2}");
                                  columns.Bound(c => c.ScheduleBrokenDownToWeeklyBase).ClientTemplate("\\#= ScheduleBrokenDownToWeeklyBase ? 'Yes' : 'No' \\#");
                                  columns.Bound(c => c.AreFormenAwareOfIt).ClientTemplate("\\#= AreFormenAwareOfIt ? 'Yes' : 'No' \\#");
                                  columns.Bound(c => c.NumberOfEvaluationMeething);
                                  columns.Bound(c => c.CorrectionFactor).Width(70);

                                  columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                              })
                              .ToolBar(toolbar =>
                              {
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              })
                              .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ProjectProgress").Window(window => { window.Title("Project Progress"); window.Scrollable(false); }))
                              .HtmlAttributes(new { style = "height: 550px;" })
                              .Pageable(pageable => pageable
                                  .Input(true)
                                  .Numeric(false)
                                  .Refresh(true)
                                  .PageSizes(true)
                                  .ButtonCount(10))
                              .Selectable()
                              .Scrollable()
                              .Selectable(selectable =>
                              {
                                  selectable.Mode(GridSelectionMode.Single);
                                  selectable.Type(GridSelectionType.Row);
                              })
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                              .Events(events => events.Edit(
                                @<text>
                                    function(e) {
                                    calculateDependetValues(e, "#=PeriodMappingId#")
                                    }
                                </text>
                                ))

                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .Events(ev =>
                                  {
                                      ev.Error("error_handler(\"progress_#=PeriodMappingId#\")");
                                      ev.RequestStart("onRequestStart(\"progress_#=PeriodMappingId#\")");
                                      ev.RequestEnd("onRequestEnd(\"progress_#=PeriodMappingId#\")");
                                  })
                                  .Model(
                                      model =>
                                      {
                                          model.Id(p => p.MonthlyProjectProgressId);
                                          model.Field(p => p.PlannedToDate).Editable(false);
                                          model.Field(p => p.ExecutedAmountToDate).Editable(false);
                                          model.Field(p => p.CorrectionFactor).Editable(false);

                                      })

                                    .Read(read => read.Action("MonthlyProgress_Read", "MonthlyProgress", new { periodIdRead = "#=PeriodMappingId#" }))
                                      .Create(create => create.Action("MonthlyProgress_Create", "MonthlyProgress", new { periodIdCreate = "#=PeriodMappingId#" }))
                                      .Update(read => read.Action("MonthlyProgress_Update", "MonthlyProgress"))
                                      .Destroy(read => read.Action("MonthlyProgress_Destroy", "MonthlyProgress"))

                              )//.ClientDetailTemplateId("template_performance")
                              .ToClientTemplate()
                    )
    }

