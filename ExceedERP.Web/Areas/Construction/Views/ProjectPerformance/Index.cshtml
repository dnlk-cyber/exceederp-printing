                                      info.Bound(x => x.QualityPlanning);
                                      info.Bound(x => x.QualityAssurance);
                                      info.Bound(x => x.QualityControl);
                                      info.Bound(x => x.QualityComplaint);
                                  })
                                  );
                                  columns.Bound(c => c.MaxAllowablePoints);
                                  columns.Bound(c => c.TotalPoints);

                                  columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);

                              })
                              .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ProjectQuality").Window(window => { window.Title("Quality"); window.Scrollable(false); }))
