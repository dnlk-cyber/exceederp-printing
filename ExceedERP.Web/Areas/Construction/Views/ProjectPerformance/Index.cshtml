<script>
    function filterCategories() {
        //
        // summary:
        //      send the filtering text along with the parent widget's value
        var dropdownlist = $("#ItemCode").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            ItemCategoryCode: $("#ItemCategoryCode").val(), filterString: filterInput.val()
        };
    }
    // progress
    function calculateDependetValues(e, periodId) {

        // change planned amount todate
        var plnTextBox = $('#PlannedAmount');
        var plnTilPreTextBox = $('#PlannedAmountTillPreviousMonth');
        plnTextBox.bind('blur', function () {
            var plnThisMonth = $('#PlannedAmount').val();
            var plnTillPrevMonth = $('#PlannedAmountTillPreviousMonth').val();
            $("#PlannedToDate").val(Number(plnThisMonth) + Number(plnTillPrevMonth));
        });
        plnTilPreTextBox.bind('blur', function () {
            var plnThisMonth = $('#PlannedAmount').val();
            var plnTillPrevMonth = $('#PlannedAmountTillPreviousMonth').val();
            $("#PlannedToDate").val(Number(plnThisMonth) + Number(plnTillPrevMonth));
        });

        // fetch values from server.
        $.ajax({
            url: '@Url.Action("GetCalculatedPlannedAmountTillPreviousMonth", "ProjectPerformance", new { area = "Construction" })',
            data: { periodMappingId: periodId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (Number($("#PlannedAmountTillPreviousMonth").val()) == 0) {
