    function GetPlannedToDate() {

        var plnThisMonth = $('#PlannedAmount').data('kendoTextBox').value();
        var plnTillPrevMonth = $('#PlannedAmountTillPreviousMonth').data('kendoTextBox').value();
        $.ajax({
            url: '@Url.Action("GetPlannedToDate", "DataProvider")',
            data: { plannedAmntForTheMonth: plnThisMonth, planndedTillPrevMonth: plnTillPrevMonth },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                $("#PlannedToDate").val(r);
                $("#PlannedToDate").trigger("change");
            }

        });
    }
    function changeDaysTextBox(e) {
        var selectedOption = $("#ApprovalTime").val();
        var currentTextBox = $("#approvalTimeDays");
        var currentLabel = $("#approvalTimeDaysLabel");
        if (selectedOption === "0") {
            //$("#approvalTimeDays").disabled = 'false';
            currentLabel.html("Days");
            currentTextBox.prop('disabled', true);
        } else if (selectedOption === "1") {
            currentLabel.html("days before due date");
            currentTextBox.prop('disabled', false);
        } else if (selectedOption === "2") {
            currentLabel.html("days after due date");
            currentTextBox.prop('disabled', false);
        }
    }
