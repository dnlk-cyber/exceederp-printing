        fromEngineers.bind('blur', function () {
            var sumOfValue = (-1) * (Number(fromClient.val()) + Number(fromEngineers.val()) + Number(fromHeadOffice.val()) + Number(fromQEngineer.val()));
            $("label[for='qComplaintLabel']").text(sumOfValue);
        });
        fromHeadOffice.bind('blur', function () {
            var sumOfValue = (-1) * (Number(fromClient.val()) + Number(fromEngineers.val()) + Number(fromHeadOffice.val()) + Number(fromQEngineer.val()));
            $("label[for='qComplaintLabel']").text(sumOfValue);
        });
        fromQEngineer.bind('blur', function () {
            var sumOfValue = (-1) * (Number(fromClient.val()) + Number(fromEngineers.val()) + Number(fromHeadOffice.val()) + Number(fromQEngineer.val()));
            $("label[for='qComplaintLabel']").text(sumOfValue);
        });
