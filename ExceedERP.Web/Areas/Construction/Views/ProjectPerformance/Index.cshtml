                              .Events(ev => ev.Edit("ChangeQualityValues"))
                              //.Events(x => x.DataBound("onDataBoundMaster"))

                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .Model(
                                      model =>
                                      {
                                          model.Id(p => p.MonthlyProjectQualityId);

                                      })
                                    .Events(ev => ev
