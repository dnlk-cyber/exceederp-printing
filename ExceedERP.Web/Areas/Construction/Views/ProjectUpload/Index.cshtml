@using ExceedERP.Core.Localization
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Information</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
          .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Name).Width( 150);
        columns.Bound(c => c.Code).Width( 150);
        columns.Bound(c => c.Category).Width( 200);
        columns.Bound(c => c.Location).Width( 150);
        columns.Bound(c => c.ContractAmount).Width( 150);
      
    
        columns.Bound(c => c.Client);
      
       // columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
          //  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                  .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ProjectInformation").Window(window => { window.Title("Project Information"); window.Scrollable(false); }))
          .Scrollable(h => h.Height(500))
                             .Groupable()
                                      .Sortable(sortable =>
                                      {
                                          sortable.SortMode(GridSortMode.SingleColumn);
                                      })
                          .Filterable()
                             .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
               .Ajax()
                           .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")"))
          .Model(model => model.Id(p => p.ProjectInformationId))
          .Read(read => read.Action("ProjectInformation_Read", "ProjectInformation"))
          .Create(create => create.Action("ProjectInformation_Create", "ProjectInformation"))
          .Update(update => update.Action("ProjectInformation_Update", "ProjectInformation"))
          .Destroy(destroy => destroy.Action("ProjectInformation_Destroy", "ProjectInformation"))
          ).ClientDetailTemplateId("template")
      )

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                  .Name("tabstrip_#=ProjectInformationId#")
          .SelectedIndex(0)
          .Items(items =>
          {
             
             items.Add().Text("Document").Content(
                @<text>
                   

                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Common.Attachment>()
                  .Name("AttachmentGrid_#=ProjectInformationId#")
          .Columns(columns =>
          {

              columns.Bound(c => c.Description); //.Title("File Name").ClientTemplate((@Html.ActionLink("#=Description#", "DownloadFile", "DownloadDocument", new { filename = "#=Description#" }, null).ToHtmlString()));
              columns.Bound(c => c.FileType).ClientTemplate(Html.ActionLink("DownLoad", "DownLoadFile", new { filename = "#=ProjectInformationId#" }).ToHtmlString()).Title("Download");
              columns.Command(command =>
              {
                 command.Destroy().Text(Resources.ActionButton_Cancel);
                  //    command.Custom("Download").Click("DownloadAttachmnets");

              }).Width(300);

          })
          .Events(e =>
          {
              e.Change("onChange");
              e.Edit("onGridEdit");
          })
                       .ToolBar(toolbar =>
              {
                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
              })
                      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Upload").Window(window =>
                      {
                          window.Scrollable(false);
                          window.Title("Upload Document");
                      }))

              .Scrollable()
              .Selectable()
              .DataSource(dataSource => dataSource
                  .Ajax()
                                           .Events(events => events.Error("error_handler(\"AttachmentGrid_#=ProjectInformationId#\")"))

                  .Model(model => model.Id(p => p.AttachmentId))
                                                                  .Read(read => read.Action("Attachments_Read", "Attachment", new { Area = "Common", attachmentReferenceType = "PROJECT_DOCUMENT", id = "#=ProjectInformationId#", fileOwner = "#=ProjectInformationId#" }))
                                                                 .Create(create => create.Action("Attachments_Create", "Attachment", new { Area = "Common", attachmentReferenceType = "PROJECT_DOCUMENT", id = "#=ProjectInformationId#", fileOwner = "#=ProjectInformationId#" }))
                          .Destroy(destroy => destroy.Action("Attachments_Destroy", "ProjectInformation"))

              ).ToClientTemplate()
                    )
                </text>
                  );
          }).ToClientTemplate())
</script>

<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }

    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }

    function onChange(e) {
        var grid = e.sender;
        var selectedRows = this.select();
        var rowData = this.dataItem(selectedRows[0]);
        var id = rowData.AttachmentID;
        $.ajax({
            url: '@Url.Action("Download", "ProjectInformation")',
            contentType: "application/json; charset=utf-8",
            data: { 'id': id },
            type: 'GET',
            cache: false,
            success: function(result) {
                r = result;
            }

        });
    }

</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>