            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div>
            @Html.LabelFor(model => model.ProjectScope , htmlAttributes: new { @class = "control-label col-md-8" })
        </div>
        <div class="form-group">

            @Html.Kendo().TextBoxFor(model => model.ProjectScope)
            @Html.ValidationMessageFor(model => model.ProjectScope, "", new { @class = "text-danger" })
        </div>
    </div>
 
   


</div>
<br/>
    <div class="row">
        <div class="col-md-1">

        </div>
