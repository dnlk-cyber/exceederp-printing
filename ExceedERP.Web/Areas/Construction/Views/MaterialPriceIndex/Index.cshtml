@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Internal Equipment Rent</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.MaterialPriceIndex>()
                          .Name("MaterialPriceIndexgrid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.ItemCategoryCode, (IEnumerable)ViewData["ItemPriceCatego"], "ItemCategoryCode", "Name").EditorTemplateName("ItemPriceCatego").Width(150);
          columns.ForeignKey(c => c.ItemCode, (IEnumerable)ViewData["ItemPriceIndex"], "ItemCode", "Name").EditorTemplateName("ItemPriceIndex").Width(200);
          columns.Bound(c => c.Uom).Width(75);
          columns.Bound(c => c.OrginalCostGRN).Width(100);
          columns.Bound(c => c.OrginalCost).Width(100);
          columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("Branches").Width(200);
          columns.Bound(c => c.TransportCost).Width(100);
          columns.Bound(c => c.LoadingUnloading).Width(100);
          columns.Bound(c => c.TotalCost).Width(100);
          columns.Bound(c => c.ApprovedCost).Width(150);
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
                                                                                             .Groupable()
                                                                                                      .Sortable(sortable =>
                                                                                                      {
                                                                                                          sortable.SortMode(GridSortMode.SingleColumn);
                                                                                                      })
                                                                                          .Filterable()
                                                                                             .Pageable(pageable => pageable
                                                                                                                        .Input(true)
                                                                                                                        .Numeric(false)
                                                                                                                        .Refresh(true)
                                                                                                                        .PageSizes(true)
                                                                                                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()

                  .Events(events =>
                                                {
                                                    events.Error("error_handler(\"MaterialPriceIndexgrid\")");
                                                    events.RequestStart("onRequestStart(\"MaterialPriceIndexgrid\")");
                                                    events.RequestEnd("onRequestEnd(\"MaterialPriceIndexgrid\")");

                                                })

          .Model(model =>
          {
              model.Id(p => p.MaterialPriceIndexId);
              model.Field(p => p.Uom).Editable(false);
              model.Field(p => p.OrginalCost).Editable(false);
              model.Field(p => p.TotalCost).Editable(false);
              model.Field(p => p.BranchId).Editable(false);
          })
                                          .Read(read => read.Action("MaterialPriceIndex_Read", "MaterialPriceIndex"))
                                      .Create(create => create.Action("MaterialPriceIndex_Create", "MaterialPriceIndex"))
                                      .Update(update => update.Action("MaterialPriceIndex_Update", "MaterialPriceIndex"))
                                      .Destroy(destroy => destroy.Action("MaterialPriceIndex_Destroy", "MaterialPriceIndex"))
      )
)
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
</script>