@using ExceedERP.Core.Localization
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.LineDate>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.AwardDate);
        columns.Bound(c => c.ContractPeriod);
        columns.Bound(c => c.ContractSigningDate);
        columns.Bound(c => c.SiteHandOverDate);
        columns.Bound(c => c.EstimatedStartDate);
        columns.Bound(c => c.EstimatedEndDate);
        columns.Bound(c => c.CompletionDate);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.LineDateId))
          .Read(read => read.Action("LineDate_Read", "LineDate"))
          .Create(create => create.Action("LineDate_Create", "LineDate"))
          .Update(update => update.Action("LineDate_Update", "LineDate"))
          .Destroy(destroy => destroy.Action("LineDate_Destroy", "LineDate"))
      )
)
