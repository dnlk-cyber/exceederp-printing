@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Setting | Project Assignment</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ConstructionProjectUserAssignmentViewModel>()
                          .Name("assignmentGrid")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.UserName).EditorTemplateName("UserSelector").ClientTemplate(
                                  "<strong> #=FullName#</strong> <br /> @<i style=''>#=UserName#</i>"
                                  ).ClientGroupHeaderTemplate(
                                  "# if (aggregates.ProjectInformationId.count > 1) { #" +
                                    "#=value# - (total: #=aggregates.ProjectInformationId.count # projects) " +
                                  "#} else {#" +
                                    "#=value# - (total: #=aggregates.ProjectInformationId.count # project)" +
                                  "#}#");
                              columns.ForeignKey(c => 
                                c.ProjectInformationId, (IEnumerable)ViewData["Projects"], "ProjectInformationId", "Name")
                                .EditorTemplateName("ProjectSelector");
                              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Resources").Window(window => { window.Title("Resource"); window.Scrollable(false); }))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                        .Scrollable(h => h.Height(500))
                        .Groupable()
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                        .Filterable()
                        .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .PageSize(20)
                              .Group(gr => {
                                  gr.Add(f => f.UserName);
                              })
                              .Aggregates(ag => {
                                  ag.Add(f => f.ProjectInformationId).Count();
                              })
                              .Events(events =>
                              {
                                  events.Error("error_handler(\"assignmentGrid\")");
                                  events.RequestStart("onRequestStart(\"assignmentGrid\")");
                                  events.RequestEnd("onRequestEnd(\"assignmentGrid\")");

                              })
                              .Model(model =>
                              {
                                  model.Id(diam => diam.ConstructionProjectUserAssignmentId);
                              })
                              .Read(read => read.Action("Assignments_Read", "ConstructionProjectUserAssignment"))
                              .Create(create => create.Action("Assignment_Create", "ConstructionProjectUserAssignment"))
                              .Update(update => update.Action("Assignment_Update", "ConstructionProjectUserAssignment"))
                              .Destroy(destroy => destroy.Action("Assignment_Destroy", "ConstructionProjectUserAssignment"))
                          )
)
