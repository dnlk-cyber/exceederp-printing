                                  columns.Bound(c => c.TaxAmount).Format("{0:N2}").Width(100);
                                  columns.Bound(c => c.TotalWithVat).Format("{0:N2}").Width(100);
                                  columns.Group(g => g.Title("Deduction").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                    .Columns(info =>
                                    {
                                        info.Bound(x => x.PreviousPayment).Format("{0:N2}").Width(100);
                                        info.Bound(x => x.Retention).Format("{0:N2}").Width(100);
                                        info.Bound(x => x.Penality).Width(100).ClientTemplate(
                                            "\\# if (Penality === 0) { \\#" +
                                            " " +
                                            "\\# } else {\\#" +
                                            "\\#: kendo.toString( Penality, 'N2' )\\#" +
                                            "\\# } \\#"
                                            );
                                        info.Bound(x => x.AdvanceRepayment).Format("{0:N2}").Width(100);
                                        info.Bound(x => x.Correction).Width(100).ClientTemplate(
                                            "\\# if (Correction === 0) { \\#" +
                                            " " +
                                            "\\# } else {\\#" +
                                            "\\#: kendo.toString( Correction, 'N2') \\#" +
                                            "\\# } \\#"
                                            );
                                        info.Bound(x => x.MaterialOnSite).Width(100).ClientTemplate(
                                            "\\# if (MaterialOnSite === 0) { \\#" +
                                            " " +
                                            "\\# } else {\\#" +
                                            "\\#: kendo.toString( MaterialOnSite, 'N2') \\#" +
                                            "\\# } \\#"
                                            );
                                        info.Bound(x => x.OtherDeductions).Width(100).ClientTemplate(
                                            "\\# if (OtherDeductions === 0) { \\#" +
                                            " " +
                                            "\\# } else {\\#" +
                                            "\\#: kendo.toString( OtherDeductions, 'N2') \\#" +
                                            "\\# } \\#"
                                            );
                                    })
                                );

                                  columns.Bound(c => c.NetPayableAmount).Width(120).Format("{0:N2}");

                                  columns.Command(command =>
                                  {
                                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                      command.Destroy().Text(Resources.ActionButton_Cancel);
                                  }).Width(200);
                              })
                              .ToolBar(toolbar =>
                              {
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              })
                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                              .Selectable(selectable =>
                              {
                                  selectable.Mode(GridSelectionMode.Single);
                                  selectable.Type(GridSelectionType.Row);
                              })
                              .Events(ev =>
                              {
                                  ev.DataBound("onDataBoundOfCertificateGrid");
                              })
                              .Scrollable(h => h.Height(500))
                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .Model(model =>
                                  {
                                      model.Id(p => p.ProjectPaymentCertificateId);
                                      model.Field(p => p.Retention).Editable(false);
                                      model.Field(p => p.TaxAmount).Editable(false);
                                      model.Field(p => p.PaymentNumber).Editable(false);
                                      model.Field(p => p.PreviousPayment).Editable(false);
                                      model.Field(p => p.TotalWithVat).Editable(false);
                                      model.Field(p => p.AdvanceRepayment).Editable(false);
                                      model.Field(p => p.NetPayableAmount).Editable(false);
                                      //model.Field(p => p.ValueOfWorkExecutedToDate).Editable(false);
                                  })

                                  .Events(events => events.Error("error_handler(\"paymentCertificate_#=ProjectInformationId#\")"))
                                  .Read(read => read.Action("Paymentcertificate_Read", "ProjectPaymentCertificate", new { projectIdRead = "#=ProjectInformationId#" }))
                                  .Create(create => create.Action("PaymentCertificate_Create", "ProjectPaymentCertificate", new { projectIdCreate = "#=ProjectInformationId#" }))
                                  .Update(update => update.Action("Paymentcertificate_Update", "ProjectPaymentCertificate"))
                                  .Destroy(destroy => destroy.Action("Paymentcertificate_Destroy", "ProjectPaymentCertificate"))
                              ).ClientDetailTemplateId("certificate_detail")
                              .ToClientTemplate()
                            )

                        </text>
                    );
                   
