<script>
    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ProjectPaymentCertificate", new { area = "Construction" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
    function onDataBoundOfCertificateGrid(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        //Selects all edit buttons


        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check
            if (dataItem.IsOnlineApproved === true) {
                //hide buttons using jQuery
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.addClass("highlighted-row");
                //row.find(".k-grid-customAction").text('ይከፈት');
            } else {

                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").show();
            }
        }
    }
    function sync_handler(e) {
        this.read();

    }
    function boqReferenceChanged(e) {
        var billReference = $("#BillReference").val();

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetAmountOfExcutedWorkToDate", "ProjectPaymentCertificate", new { area = "Construction" })',
            data: { reference: billReference },
            cache: false,
            success: function (result) {
                //$("#ValueOfWorkExecutedToDate").prop("disabled", false);
                $("#ValueOfWorkExecutedToDate").val(result);
                //$("#ValueOfWorkExecutedToDate").prop("disabled", true);
                $("#ValueOfWorkExecutedToDate").trigger("change");
            }, //end succ
            error: function (result) {
                //alert(result);
            }
        });

    }

    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }
    function ordinal_suffix_of(i) {
        var j = i % 10,
            k = i % 100;
        if (j == 1 && k != 11) {
            return i + "st";
        }
        if (j == 2 && k != 12) {
            return i + "nd";
        }
        if (j == 3 && k != 13) {
            return i + "rd";
        }
        return i + "th";
    }

</script>
