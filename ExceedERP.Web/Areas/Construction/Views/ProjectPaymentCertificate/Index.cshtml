@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Payment Certificate</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
      .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
          //columns.Bound(c => c.ProjectType).ClientGroupHeaderTemplate(
          // "# if (value === 0) { #" +
          //     " Building " +
          //   "# } else if (value === 1) {#" +
          //     " Road " +
          //   "# } else if (value === 2) {#" +
          //      " Dam " +
          //   "# } else if (value === 3) {#" +
          //     " Irrigation" +
          //   "# } #"
          // ).Hidden(true);
          columns.Bound(c => c.Name).Width(300);
          columns.Bound(c => c.Code);
          columns.Bound(c => c.ContractAmount).ClientTemplate(
              "# if (ContractAmount === 0) { #" +
                                            " -----" +
                                            "# } else {#" +
                                            "#: kendo.toString( ContractAmount, 'N2') #" +
                                            "# } #"
              );
          columns.Bound(c => c.Client);
      })
        .Scrollable(h => h.Height(700))
        //.Groupable()
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        .Filterable()
        .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
      .DataSource(dataSource => dataSource
               .Ajax()
               //.Group(g => {
               //    g.Add(c => c.ProjectType);
               //})
               .PageSize(20)
                .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")"))
                .Model(model => model.Id(p => p.ProjectInformationId))

                .Read(read => read.Action("ProjectInformation_Read", "ProjectPaymentCertificate"))

          ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("tabstrip_#=ProjectInformationId#")
                  .SelectedIndex(0)
                  .Items(items =>
                  {
                      items.Add().Text("Advance Payment").Content(
                        @<text>
                            @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectAdvancePayment>()
                              .Name("advancePayment_#=ProjectInformationId#")
                              .Columns(columns =>
                              {
                                  columns.Bound(c => c.TotalProjectAmount).Format("{0:N2}");
                                  columns.Bound(c => c.AdvancePaymentRate).ClientTemplate("\\#=AdvancePaymentRate\\#%");
                                  columns.Bound(c => c.Amount).Format("{0:N2}");
                                  columns.Bound(c => c.ApprovedAmount).Format("{0:N2}");

                                  columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                              })
                              .ToolBar(toolbar =>
                              {
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              })
                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                              .Selectable(selectable =>
                              {
                                  selectable.Mode(GridSelectionMode.Single);
                                  selectable.Type(GridSelectionType.Row);
                              })
                              .Scrollable(h => h.Height(500))
                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .Model(model =>
                                  {
                                      model.Id(p => p.ProjectAdvancePaymentId);

                                      model.Field(p => p.TotalProjectAmount).Editable(false);
                                      model.Field(p => p.AdvancePaymentRate).Editable(false);
                                      model.Field(p => p.Amount).Editable(false);

                                  })

                                  .Events(events => events.Error("error_handler(\"advancePayment_#=ProjectInformationId#\")"))
                                  .Read(read => read.Action("AdvancePayment_Read", "ProjectAdvancePayment", new { projectIdReadAdvance = "#=ProjectInformationId#" }))
                                  .Create(create => create.Action("AdvancePayment_Create", "ProjectAdvancePayment", new { projectIdCreateAdvance = "#=ProjectInformationId#" }))
                                  .Update(update => update.Action("AdvancePayment_Update", "ProjectAdvancePayment"))
                                  .Destroy(destroy => destroy.Action("AdvancePayment_Destroy", "ProjectAdvancePayment"))
                              ).ToClientTemplate()
                            )

                        </text>
                    );

