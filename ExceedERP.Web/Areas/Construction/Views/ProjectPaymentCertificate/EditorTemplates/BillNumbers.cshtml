@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        .Name("BillReference")
        .DataTextField("BillReference")
        .DataValueField("BillReference")
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetProjectBoQ", "DataProvider", new { projectId = "#=ProjectInformationId#"}));
        })
        .Events(ev => {
            ev.Change("boqReferenceChanged");
        })
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)