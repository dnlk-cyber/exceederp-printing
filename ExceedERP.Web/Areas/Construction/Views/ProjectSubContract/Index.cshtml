@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Contract Management | Sub-contracts</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
    .Name("ProjectInformationgrid")
    .Columns(columns =>
    {
        columns.Bound(c => c.Name).Width(300);
        columns.Bound(c => c.Code).Width(150);
        //columns.Bound(c => c.Category).Width(200);
        //columns.Bound(c => c.BranchId).Width(150);
        columns.Bound(c => c.ContractAmount).Width(150).ClientTemplate(
            "# if (ContractAmount === 0) { #" +
                                            " -----" +
                                            "# } else {#" +
                                            "#: kendo.toString( ContractAmount, 'N2') #" +
                                            "# } #"
            );
        columns.Bound(c => c.Client).Width(150);

    })
    
    .Scrollable(h => h.Height(700))
    .Sortable(sortable =>
    {
        sortable.SortMode(GridSortMode.SingleColumn);
    })
    .Filterable()
    .Selectable(selectable =>
    {
        selectable.Mode(GridSelectionMode.Single);
        selectable.Type(GridSelectionType.Row);
    })
    .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")"))
        .Model(model => model.Id(p => p.ProjectInformationId))

        .Read(read => read.Action("ProjectInformation_Read", "ProjectContract"))
        
        ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=ProjectInformationId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("Sub Contract").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectSubContract>()
                      .Name("ProjectSubContract_#=ProjectInformationId#")
                      .Columns(columns =>
                      {
                          //columns.Bound(c => c.ProjectContractId).Title("Id").Width(80);
                          columns.Bound(c => c.WorkType).Width(130).Title("Work Type");
                          columns.Bound(c => c.SubContractor).Width(100);

                          columns.Bound(c => c.ContractSigningDate).Width(90);
                          columns.Bound(c => c.CommencementDate).Width(90);

                          columns.Bound(c => c.ContractPeriod).Width(90).ClientTemplate("\\#= kendo.toString(ContractPeriod, 'N0')\\# days");
                          columns.Bound(c => c.ApprovedTimeExtension).Width(70).ClientTemplate(
                              "\\# if (ApprovedTimeExtension === null) { \\#" +
                                            " " +
                                            "\\# } else {\\#" +
                                            "\\#= kendo.toString(ApprovedTimeExtension, 'N0')\\# days" +
                                            "\\# } \\#"
                              );
                          columns.Bound(c => c.TotalProjectPeriod).Width(90).ClientTemplate("\\#= kendo.toString(TotalProjectPeriod, 'N0')\\# days");
                          columns.Bound(c => c.ContractTime).Title("Original Completion Time").Width(90);
                          columns.Bound(c => c.RevisedCompletionDate).Width(90);
                          columns.Bound(c => c.TimeElapsedToDate).Width(90);
                          columns.Bound(c => c.ContractAmount).Title("Project Amount").Width(90).Format("{0:N2}");
                          columns.Bound(c => c.ApprovedTimeExtension).Width(70).ClientTemplate(
                              "\\# if (Rebate === null) { \\#" +
                                            " " +
                                            "\\# } else {\\#" +
                                            "\\#= Rebate\\# %" +
                                            "\\# } \\#"
                              );
                          //columns.Bound(c => c.Rebate).Width(90).ClientTemplate("\\#: Rebate \\#%");
                          columns.Bound(c => c.Variation).Width(90).Format("{0:N2}");
                          columns.Bound(c => c.Supplemetary).Width(90).Format("{0:N2}");
                          columns.Bound(c => c.TotalProjectAmount).Width(90).Format("{0:N2}");
                          columns.Bound(c => c.NetGrand).Width(90).Format("{0:N2}");
                          columns.Bound(c => c.ExecutedToDate).Width(90).Format("{0:N2}");

                          columns.Command(command =>
                          {
                              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                              command.Destroy().Text(Resources.ActionButton_Cancel);
                          }).Width(200);
                      })
                      .Events(ev =>
                      {
                          ev.DataBound("subContractGridDatabount");
                      })
                      .ToolBar(toolbar =>
                      {
                          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                      })
                      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ProjectSubContract").Window(window => { window.Title("Project Sub Contract"); window.Scrollable(false); }))
                      .Scrollable(h => h.Height(500))
                      .Selectable(selectable =>
                      {
                          selectable.Mode(GridSelectionMode.Single);
                          selectable.Type(GridSelectionType.Row);
                      })
                      .DataSource(dataSource => dataSource
                            .Ajax()
                            .Events(events => events.Error("error_handler(\"ProjectSubContract_#=ProjectInformationId#\")"))
                            .Model(model => model.Id(p => p.ProjectContractId))
                            .Read(read => read.Action("SubContrat_Read", "ProjectSubContract", new { id = "#=ProjectInformationId#" }))
                            .Create(create => create.Action("SubContrat_Create", "ProjectSubContract", new { idTwo = "#=ProjectInformationId#" }))
                            .Update(update => update.Action("SubContrat_Update", "ProjectSubContract"))
                            .Destroy(destroy => destroy.Action("SubContrat_Destroy", "ProjectSubContract"))
                      ).ClientDetailTemplateId("subcontract_detail")
                      .ToClientTemplate()
                    )
                </text>
                  );
          }).ToClientTemplate())
</script>

