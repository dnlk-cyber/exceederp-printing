@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
                    .OptionLabel(Resources.Select)
                    .DataTextField("Name")
                    .DataValueField("VariationOrderTypeId")
                    //.BindTo((IEnumerable)ViewData["types"])
                    .DataSource(dataSource =>
                    {
                        dataSource.Read(read => read.Action("GetSubContractVariationOrderTypes", "DataProvider"));
                    })
                    .ValuePrimitive(true)
                    .Filter("contains")
                    .MinLength(2)

)