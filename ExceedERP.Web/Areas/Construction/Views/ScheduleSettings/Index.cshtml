@using ExceedERP.Core.Localization
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Schedule Settings</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
    .Name("ProjectInformationgrid")
    .Columns(columns =>
    {
        columns.Bound(c => c.Name).Width(180);
        columns.Bound(c => c.Code).Width(75);
        //columns.Bound(c => c.ProjectType).Width(120);
        columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").EditorTemplateName("Branch").Width(150);
        columns.Bound(c => c.ContractAmount).Width(120).ClientTemplate(
            "# if (ContractAmount === 0) { #" +
                                        " -----" +
                                        "# } else {#" +
                                        "#: kendo.toString( ContractAmount, 'N2') #" +
                                        "# } #"
            );
        columns.Bound(c => c.Client).Width(120);
        columns.Bound(c => c.ProjectType).ClientGroupHeaderTemplate(
          "# if (value === 0) { #" +
              " Building " +
            "# } else if (value === 1) {#" +
              " Road " +
            "# } else if (value === 2) {#" +
               " Dam " +
            "# } else if (value === 3) {#" +
              " Irrigation" +
            "# } #"
          ).Hidden(true);
        columns.Bound(c => c.ProjectStatus).EditorTemplateName("Enum").Width(100);
        //columns.Command(command =>
        //{
        //    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
        //    command.Destroy().Text(Resources.ActionButton_Cancel);
        //}).Width(200);
    })

    .Scrollable(h => h.Height(700))
    .Sortable(sortable =>
    {
        sortable.SortMode(GridSortMode.SingleColumn);
    })
    .Filterable()
    .Selectable()
    .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))

    .DataSource(dataSource => dataSource
        .Ajax()
        .Group(g =>
        {
            g.Add(f => f.ProjectType);
        })
        .PageSize(20)
        .Events(events =>
        {
            events.Error("error_handler(\"ProjectInformationgrid\")");
            events.RequestStart("onRequestStart(\"ProjectInformationgrid\")");
            events.RequestEnd("onRequestEnd(\"ProjectInformationgrid\")");
        })
        .Model(model => model.Id(p => p.ProjectInformationId))
        .Read(read => read.Action("ProjectInformation_Read", "ProjectInformation"))
        //.Create(create => create.Action("ProjectInformation_Create", "ProjectInformation"))
        //.Update(update => update.Action("ProjectInformation_Update", "ProjectInformation"))
        //.Destroy(destroy => destroy.Action("ProjectInformation_Destroy", "ProjectInformation"))
        ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=ProjectInformationId#")
          .SelectedIndex(0)
          .Items(items =>
          {
            
    items.Add().Text("Working Days").Content(
        @<text>
            @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectCalendar>()
                          .Name("ProjectCalandergrid_#=ProjectInformationId#")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Day).EditorTemplateName("Days");
                              columns.Bound(c => c.WorkingHourType);
                              columns.Bound(c => c.FromHour);
                              columns.Bound(c => c.ToHour);
                              columns.Bound(c => c.Selected).ClientTemplate(
                                  "<input type='checkbox' disabled='disabled' name='chkIsActive_\\#=ProjectCalanderId\\#' id='Selected\\#=ProjectCalanderId\\#' \\#= Selected ? \"checked='checked'\" : \"\" \\# />"
                                  );
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Save();
                              //toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InCell))
                          .Scrollable(h => h.Height(500))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Batch(true)
                              .PageSize(20)
                             .Events(events =>
                             {
                                 events.Error("error_handler(\"ProjectCalandergrid_#=ProjectInformationId#\")");
                                 events.RequestStart("onRequestStart(\"ProjectCalandergrid_#=ProjectInformationId#\")");
                                 events.RequestEnd("onRequestEnd(\"ProjectCalandergrid_#=ProjectInformationId#\")");
                             })
                          .Model(model =>
                          {
                              model.Id(p => p.ProjectCalanderId);
                              model.Field(p => p.FromHour).Editable(false);
                              model.Field(p => p.ToHour).Editable(false);
                              model.Field(p => p.Day).Editable(false);
                              model.Field(p => p.WorkingHourType).Editable(false);

                          })
                        .Read(read => read.Action("ProjectCalander_Read", "ProjectCalander", new { idOne = "#=ProjectInformationId#" }))
                        .Create(create => create.Action("Editing_Create", "ProjectCalander", new { idTwo = "#=ProjectInformationId#" }))
                        .Update(update => update.Action("Editing_Create", "ProjectCalander", new { idTwo = "#=ProjectInformationId#" }))
                    //.Create(create => create.Action("ProjectCalander_Create", "ProjectCalander", new { idTwo = "#=ProjectInformationId#" }))
                    //.Update(update => update.Action("ProjectCalander_Update", "ProjectCalander"))
                    //.Destroy(destroy => destroy.Action("ProjectCalander_Destroy", "ProjectCalander"))
                    ).ToClientTemplate()
            )
        </text>
                );
    items.Add().Text("Holidays (non-working days)").Content(
        @<text>
            @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ConstructionHoliday>()
                          .Name("holiday_#=ProjectInformationId#")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Name);
                              columns.Bound(c => c.Date);
                              columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["FiscalYears"], "GlFiscalYearId", "Name").EditorTemplateName("Fiscalyears");
                              columns.Bound(c => c.Remark);

                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(200);

                          })
                          .ToolBar(toolbar =>
                          {
                              //toolbar.Save();
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Scrollable(h => h.Height(500))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Group(g => {
                                  g.Add(f => f.GlFiscalYearId);
                              })
                             .Events(events =>
                             {
                                 events.Error("error_handler(\"holiday_#=ProjectInformationId#\")");
                                 events.RequestStart("onRequestStart(\"holiday_#=ProjectInformationId#\")");
                                 events.RequestEnd("onRequestEnd(\"holiday_#=ProjectInformationId#\")");
                             })
                          .Model(model =>
                          {
                              model.Id(p => p.ConstructionHolidayId);
                              
                          })
                        .Read(read => read.Action("Holidays_Read", "ConstructionHoliday", new { projectId = "#=ProjectInformationId#" }))
                        .Create(create => create.Action("Holiday_Create", "ConstructionHoliday", new { projectId = "#=ProjectInformationId#" }))
                        .Update(update => update.Action("Holiday_Update", "ConstructionHoliday"))
                        .Destroy(destroy => destroy.Action("Holiday_Destroy", "ConstructionHoliday"))
                    ).ToClientTemplate()
            )
        </text>
                );              

          }).ToClientTemplate())
</script>





