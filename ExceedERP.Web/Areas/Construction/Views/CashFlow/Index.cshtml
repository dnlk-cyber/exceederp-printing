@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Cash Flow</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.PerformanceProjectGeneralInformationVM>()
      .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ProjectName);
          //columns.Bound(c => c.ProjectType).ClientGroupHeaderTemplate(
          //  "# if (value === 0) { #" +
          //      " BUILDING " +
          //    "# } else if (value === 1) {#" +
          //      " ROAD " +
          //    "# } else if (value === 2) {#" +
          //       " DAM " +
          //    "# } else if (value === 3) {#" +
          //      " IRRIGATION" +
          //    "# } #"
          //  ).Hidden(true);
          //columns.Bound(c => c.ProjectScope);
          //columns.Bound(c => c.Consultant);
          columns.Bound(c => c.ProjectCode);
      })
      .Scrollable(h => h.Height(700))
      //.Groupable()
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .PageSize(20)
          //.Group(groups =>
          //{
          //    groups.Add(p => p.ProjectType);
          //})
          .Events(events =>
          {
              events.Error("error_handler(\"ProjectInformationgrid\")");
              events.RequestStart("onRequestStart(\"ProjectInformationgrid\")");
              events.RequestEnd("onRequestEnd(\"ProjectInformationgrid\")");

          })

          .Model(model => model.Id(p => p.ProjectInformationId))
          .Read(read => read.Action("ProjectInformation_Read", "ProjectPerformance"))
      ).ClientDetailTemplateId("template_budgetyear")
)


<script id="template_budgetyear" type="text/kendo-tmpl">
    
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=ProjectInformationId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("Project Detail").Content(
                @<text>

                    @(Html.Kendo().PanelBar()
                          .Name("panelbar_#=ProjectInformationId#")
                          .ExpandMode(PanelBarExpandMode.Single)
                          .Items(panelbar =>
                          {
                              panelbar.Add()
                                  .Expanded(true)
                                  .Content(
                                      "<div class='project-details'>" +
                                          "<ul>" +
                                              "<li> <label> Total Original Contract Amount: </label> <strong> #= kendo.toString(ContractAmount, 'N4')# </strong> </li>" +
                                              "<li> <label> Supplementary Agreements : </label> <strong>#= kendo.toString(Supplemetary, 'N4')# </strong> </li>" +
                                              "<li> <label> Variation Works: </label> <strong> #=kendo.toString(Variation, 'N4')# </strong> </li>" +
                                              "<li> <label> Total Contract Price: </label> <strong> #=kendo.toString(TotalProjectAmount, 'N4')# </strong> </li>" +
                                          "</ul>" +
                                      "</div>"
                                  );
                          }).ToClientTemplate()
                    )

                </text>
                      );
              items.Add().Text("Budget Year").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.CashFlowYear>()
                          .Name("years_#=ProjectInformationId#")
                          .Columns(columns =>
                          {

                              columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["FiscalYears"], "GlFiscalYearId", "Name").EditorTemplateName("Fiscalyears");
                              columns.Bound(c => c.Remark);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(200);

                          })
                           .ToolBar(toolbar =>
                           {
                               toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                           })
                          .Scrollable(h => h.Height(450))
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Events(events =>
                              {
                                  events.Error("error_handler(\"years_#=ProjectInformationId#\")");
                                  events.RequestStart("onRequestStart(\"years_#=ProjectInformationId#\")");
                                  events.RequestEnd("onRequestEnd(\"years_#=ProjectInformationId#\")");
                              })

                              .Model(model =>
                              {
                                  model.Id(p => p.CashFlowYearId);
                              }
                              )
                              .Read(read => read.Action("Years_Read", "CashFlowYear", new { id = "#=ProjectInformationId#" }))
                              .Create(create => create.Action("Year_Create", "CashFlowYear", new { id = "#=ProjectInformationId#" }))
                              .Update(update => update.Action("Year_Update", "CashFlowYear"))
                              .Destroy(destroy => destroy.Action("Year_Destroy", "CashFlowYear"))
                          ).ClientDetailTemplateId("template_cashflow")
                          .ToClientTemplate()
                    )
                </text>
                  );
          }).ToClientTemplate())
</script>
