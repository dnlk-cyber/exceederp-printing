@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        .DataTextField("Name")
        .DataValueField("ConstructionPeriodId")
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetPeriodsInCashFlowBudgetYear", "DataProvider", new { budgetYearId = "#=CashFlowYearId#" }));
        })
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)