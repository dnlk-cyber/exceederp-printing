@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend><a href='/Construction/DurationEstimation/' title="Back To All Projects"><i class="fa fa-chevron-circle-left fa-1.5x"></i></a> &nbsp; &nbsp; Duration Estimation / @ViewBag.Project</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.GenericWorkItemPerProjectViewModel>()
                          .Name("WorkItemGrid")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.SubProjectTypeName).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "#=value#"
                                  );
                              columns.Bound(c => c.StructureyType).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "#=value#"
                                  );
                              columns.Bound(c => c.WorkCategory).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "#=value#"
                                  );
                              columns.Bound(c => c.ItemName).Width(300).Title("Item Name");
                              columns.Bound(c => c.UnitOfMeasurement).Width(50).Filterable(false).Title("UoM");
                              columns.Bound(c => c.TotalQuantityOfWork).Width(80).Filterable(false).ClientTemplate(
                                "# if (IsSubCategory) { #" +
                                    "  " +
                                    "# } else {#" +
                                    "# if (TotalQuantityOfWork == 0) { #" +
                                        " " +
                                    " # } else {#" +
                                        "#: kendo.toString( TotalQuantityOfWork, 'N4') #" +
                                    "# }} #"
                                );
                              columns.Bound(c => c.ProductivityOfCrewPerDay).Width(80).Filterable(false).ClientTemplate(
                               "# if (IsSubCategory) { #" +
                                "  " +
                                "# } else {#" +
                                  "# if (ProductivityOfCrewPerDay == 0) { #" +
                                      " " +
                                  " # } else {#" +
                                      "#: kendo.toString( ProductivityOfCrewPerDay, 'N4') #" +
                                "# }} #"
                                 );

                              columns.Bound(c => c.DurationPerCrew).Filterable(false).Width(70).ClientTemplate(
                                  "# if (IsSubCategory) { #" +
                                    "  " +
                                    "# } else {#" +
                                      "# if (DurationPerCrew == 0) { #" +
                                          " " +
                                      " # } else {#" +
                                          "#: kendo.toString( DurationPerCrew, 'N4') #" +
                                    "# }} #"
                                      );
                              columns.Bound(c => c.NumberOfCrew).Filterable(false).Width(70).ClientTemplate(
                                  "# if (IsSubCategory) { #" +
                                    "  " +
                                    "# } else {#" +
                                      "# if (NumberOfCrew == 0) { #" +
                                          " " +
                                      " # } else {#" +
                                          "#: kendo.toString( NumberOfCrew, 'N4') #" +
                                    "# }} #"
                                      );
                              columns.Bound(c => c.EstimatedDuration).Filterable(false).Width(70).ClientTemplate(
                                  "# if (IsSubCategory) { #" +
                                    "  " +
                                    "# } else {#" +
                                      "# if (EstimatedDuration == 0) { #" +
                                          " " +
                                      " # } else {#" +
                                          "#: kendo.toString( EstimatedDuration, 'N4') #" +
                                    "# }} #"
                                      );
                              columns.Bound(c => c.ItemCode).Width(70);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  //command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(200);
                          })
                          .ToolBar(toolbar =>
                          {
                          toolbar.Template(
                                            @<text>
                                                <div class="toolbar row">
                                                    @*<div class="col-md-2">*@
                                                    <a class="k-button k-button-icontext btn btn-primary" id="fetchLatestButtn" onclick='return fetchLatestInformationFromEstimation(@ViewBag.ProjectId)' href='#'><span class="fa fa-refresh"></span>&nbsp;&nbsp;Fetch Latest & Update Durations</a>
                                                    <a id="fetchLoadingIcon" hidden> <i class="fa fa-spinner fa-spin fa-2x fa-fw"></i></a>
                                                     <a class="k-button k-button-icontext btn btn-primary" id="addEstimationToScheduleButton" onclick='return addEstimationDataToSchedule(@ViewBag.ProjectId)' href='#'><span class="fa fa-share"></span>&nbsp;&nbsp;Add Estimation Data to Schedule</a>
                                                    <a id="copyLoadingIcon" hidden> <i class="fa fa-spinner fa-spin fa-2x fa-fw"></i></a>
                                                    @*</div>*@
                                                   
                                                </div>
                                            </text>);
                          })
                          .Filterable()
                          .Scrollable(h => h.Height(700))
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          .Events(ev => {
                              ev.DataBound("onDataBound");
                          })
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          //.Events(e => e.Edit("onEdit"))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .PageSize(50)
                              .Sort(srt => {
                                  srt.Add(f => f.ItemCode);
                              })
                              .Group(g =>
                              {
                                  g.Add(f => f.SubProjectTypeName);
                                  g.Add(f => f.StructureyType);
                                  g.Add(f => f.WorkCategory);
                              })
                              .Events(events =>
                              {
                                  events.Error("error_handler(\"WorkItemGrid\")");
                                  events.RequestStart("onRequestStart(\"WorkItemGrid\")");
                                  events.RequestEnd("onRequestEnd(\"WorkItemGrid\")");
                              })

                              .Model(model =>
                              {
                                  model.Id(p => p.Id);
                                  model.Field(p => p.ItemName).Editable(false);
                                  model.Field(p => p.TotalQuantityOfWork).Editable(false);
                                  model.Field(p => p.UnitOfMeasurement).Editable(false);
                                  model.Field(p => p.DurationPerCrew).Editable(false);
                                  model.Field(p => p.EstimatedDuration).Editable(false);
                                  model.Field(p => p.ItemCode).Editable(false);
                                  model.Field(p => p.OverheadRate).Editable(false);
                                  model.Field(p => p.OverheadRate).Editable(false);
                                  model.Field(p => p.OverheadRate).Editable(false);
                              }
                              )
                              .Read(read => read.Action("WorkItem_Read", "DurationEstimation").Data("getIdOfOpenedProject"))
                          //.Create(create => create.Action("WorkItemPerProject_Create", "ProjectList"))
                          .Update(update => update.Action("WorkItem_Update", "DurationEstimation"))
                          //.Destroy(destroy => destroy.Action("WorkItem_Destroy", "ProjectEstimation"))
                          ).ClientDetailTemplateId("workItem_detail")
                          //.ToClientTemplate()
                          )

