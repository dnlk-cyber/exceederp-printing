<script>
    var selectedProjectId = 0;
    $(document).ready(function () {
        var url = window.location.href;

        var parameterName = 'p';
        //if (!url) url = window.location.href;
        parameterName = parameterName.replace(/[\[\]]/g, '\\$&');
        var regex = new RegExp('[?&]' + parameterName + '(=([^&#]*)|&|#|$)');
        var results = regex.exec(url);
        if (!results) projectType = null;
        if (!results[2]) projectType = '';
        var stringValue = decodeURIComponent(results[2].replace(/\+/g, ' '));
        selectedProjectId = parseInt(stringValue);
        var grid = $("#WorkItemGrid").data("kendoGrid");
        grid.dataSource.read();
    });
    
    function getIdOfOpenedProject() {
        return {
            currentProjectId: selectedProjectId
        };
    }


    function fetchLatestInformationFromEstimation(id) {
         var recordStatus = "";
        // primary buttons
        var btn1 = $("#fetchLatestButtn");
        var btn2 = $("#addEstimationToScheduleButton");
        btn1.attr('disabled', true);
        btn2.hide();
        // rotating buttons
        var bt1 = $("#fetchLoadingIcon");
        var bt2 = $("#copyLoadingIcon");
        bt1.show();
        bt2.hide();
        $.ajax({
            type: "POST",
            url: '@Url.Action("UpdateDurationDataFromEstimation", "DurationEstimation", new { area = "Construction" })',
            data: { targetProjectId: id},
            cache: false,
            success: function (result) {
                // toastr.warnning(result.Message);
                bt1.hide();
                bt2.hide();
                btn1.attr('disabled', false);
                btn2.show();
                alert(result.Message);
                recordStatus = result.Status;
                if (recordStatus === "Ok") {
                    location.reload(true);
                }
            }, //end succ
            error: function (result) {
                bt1.hide();
                bt2.hide();
                alert(result.Message);
            }
        });
    }
    function addEstimationDataToSchedule(id) {
        var recordStatus = "";
        // primary buttons
        var btn1 = $("#fetchLatestButtn");
        var btn2 = $("#addEstimationToScheduleButton");
        btn1.hide();
        btn2.attr('disabled', true);
        // rotating buttons
        var bt1 = $("#fetchLoadingIcon");
        var bt2 = $("#copyLoadingIcon");
        bt1.hide();
        bt2.show();
        $.ajax({
            type: "POST",
            url: '@Url.Action("CopyEstimationDataToSchedule", "DurationEstimation", new { area = "Construction" })',
            data: { targetProjectId: id},
            cache: false,
            success: function (result) {
                bt1.hide();
                bt2.hide();
                btn2.attr('disabled', false);
                btn1.show();
                alert(result.Message);
                recordStatus = result.Status;
                if (recordStatus === "Ok") {
                    location.reload(true);
                }
            }, //end succ
            error: function (result) {
                bt1.hide();
                bt2.hide();
                alert(result.Message);
            }
        });
    }
    function filterCategories() {
        // 
        // summary:
        //      send the filtering text along with the parent widget's value
        var dropdownlist = $("#ItemCode").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            ItemCategoryCode: $("#ItemCategoryCode").val(), filterString: filterInput.val()
        };
    }
    function filterType() {
        return {
            EquipmentIdentityID: $("#EquipmentIdentityID").val()
        };
    }
    function FilterAsset() {
        return {
            EquipmentTypeID: $("#EquipmentTypeID").val()
        };
    }
    function Refresh() {
        window.location.reload();
    }

    function detailedViewClicked(e) {
        e.preventDefault();
        window.location.href = "@Url.Action("Index", "ProjectEstimationDetail")";
    }
    function materialChanged(e) {
        var itmCode = $('#ItemCode').val();
        $.ajax({
            url: '@Url.Action("GetUnitPrice", "ProjectMaterial", new {area = "Construction"})',
            data: { itemCode: itmCode },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#UnitPrice").val(result);
                $("#UnitPrice").trigger("change");
            }

        });
    }
    function laborDropDownListChanged(e) {
        var jobTitleId = $('#ProjectEstimationIndexLabourId').val();
        $.ajax({
            url: '@Url.Action("GetIndexedHourlyPayPerJobTitle", "ProjectDirectLabour", new {area = "Construction"})',
            data: { id: jobTitleId },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#IndexedHourlySalary").val(result);
                $("#IndexedHourlySalary").trigger("change");
            }

        });
    }
    function equipmentDropDownList(e) {
        var fleetId = $('#FleetsID').val();
        $.ajax({
            url: '@Url.Action("GetRentalRate", "ProjectEquipment", new {area = "Construction"})',
            data: { id: fleetId },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#RentalCost").val(result);
                $("#RentalCost").trigger("change");
            }

        });
    }

    function onDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        //Selects all edit buttons
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check
            if (dataItem.IsSubCategory === true) {
                //hide buttons using jQuery
                row.find(".k-grid-edit").hide();
                //row.find(".k-grid-delete").hide();
                row.addClass("subcategory-workitem-datacontainer-row");
                //row.find(".k-grid-customAction").text('ይከፈት');
            } else {

                row.find(".k-grid-edit").show();
                //row.find(".k-grid-delete").show();
            }
        }
    }

</script>
