@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM
@(Html.Kendo().DropDownListFor(m => m)
        .Name("ProjectEstimationIndexLabourId")
        .OptionLabel(Resources.Select)
        .DataTextField("Title")
        .DataValueField("ProjectEstimationIndexLabourId")
        //.BindTo((IEnumerable)ViewData["titles"])
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetProjectJobTitles", "DataProvider"));
        })
        .Events(ev =>
        {
            ev.Change("laborDropDownListChanged");
        })
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)