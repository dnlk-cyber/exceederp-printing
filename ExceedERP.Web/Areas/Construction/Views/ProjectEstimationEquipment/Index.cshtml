@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Estimation Equipment</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectEstimationEquipment>()
          .Name("ProjectEstimationEquipment")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.AssetNumber, (IEnumerable)ViewData["Items"], "ItemCode", "Name").EditorTemplateName("Item").Width(200);
        columns.Bound(c => c.Quantity);
        columns.Bound(c => c.UnitFactory);
        columns.Bound(c => c.RentalCost);
        columns.Bound(c => c.TotalCost);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
                                                     .Groupable()
                                                              .Sortable(sortable =>
                                                              {
                                                                  sortable.SortMode(GridSortMode.SingleColumn);
                                                              })
                                                  .Filterable()
                                                     .Pageable(pageable => pageable
                                                                                .Input(true)
                                                                                .Numeric(false)
                                                                                .Refresh(true)
                                                                                .PageSizes(true)
                                                                                .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                       .Events(events => events.Error("error_handler(\"ProjectEstimationEquipment\")"))
          .Model(model =>
          {
              model.Id(p => p.ProjectEstimationEquipmentId);
              model.Field(p => p.RentalCost).Editable( false);
              model.Field(p => p.TotalCost).Editable(false);
          })
          .Read(read => read.Action("ProjectEstimationEquipment_Read", "ProjectEstimationEquipment"))
          .Create(create => create.Action("ProjectEstimationEquipment_Create", "ProjectEstimationEquipment"))
          .Update(update => update.Action("ProjectEstimationEquipment_Update", "ProjectEstimationEquipment"))
          .Destroy(destroy => destroy.Action("ProjectEstimationEquipment_Destroy", "ProjectEstimationEquipment"))
      )
)
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
</script>