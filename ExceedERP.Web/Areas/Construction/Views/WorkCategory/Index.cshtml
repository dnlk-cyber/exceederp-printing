@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Work Category</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.WorkCategory>()
          .Name("WorkCategory")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.ConfigurationId, (IEnumerable)ViewData["StructureType"], "ConfigurationId", "CurrentValue").EditorTemplateName("StructureTypes").Width(200);
        columns.Bound(c => c.Name);
        columns.Bound(c => c.Description);
        columns.Bound(c => c.Index).Width(100);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
                                                                                             .Groupable()
                                                                                                      .Sortable(sortable =>
                                                                                                      {
                                                                                                          sortable.SortMode(GridSortMode.SingleColumn);
                                                                                                      })
                                                                                          .Filterable()
                                                                                             .Pageable(pageable => pageable
                                                                                                                        .Input(true)
                                                                                                                        .Numeric(false)
                                                                                                                        .Refresh(true)
                                                                                                                        .PageSizes(true)
                                                                                                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
                          .Events(events => events.Error("error_handler(\"WorkCategory\")"))
          .Model(model => model.Id(p => p.WorkCategoryId))
          .Read(read => read.Action("WorkCategory_Read", "WorkCategory"))
          .Create(create => create.Action("WorkCategory_Create", "WorkCategory"))
          .Update(update => update.Action("WorkCategory_Update", "WorkCategory"))
          .Destroy(destroy => destroy.Action("WorkCategory_Destroy", "WorkCategory"))
      )
)
<script>
        function error_handler(e) {
            if (e.errors) {
                var message = "Errors:\n";
                $.each(e.errors, function (key, value) {
                    if ('errors' in value) {
                        $.each(value.errors, function () {
                            message += this + "\n";
                        });
                    }
                });
                alert(message);

            }

        }

        function sync_handler(e) {
            this.read();

        }
    </script>