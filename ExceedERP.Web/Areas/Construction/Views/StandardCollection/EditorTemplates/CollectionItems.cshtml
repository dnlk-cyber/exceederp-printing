@using System.Collections
@using ExceedERP.Helpers.Common
@using ExceedERP.Core.Localization
@using Kendo.Mvc.UI,
@using ExceedERP.Core.Domain.Construction
@model ExceedERP.Core.Domain.Construction.ConsARStandardCollectionDetail
<form>
        <div class="row">
            <div class="col-md-1">

            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.InvoiceNumber, htmlAttributes: new { @class = "control-label col-md-8" })

                    </div>
                    <div>
                        @(Html.Kendo().DropDownListFor(model => model.InvoiceNumber)
                              .Name("InvoiceNumber")
                              .OptionLabel(Resources.Select)
                              .DataTextField("InvoiceNumber")
                              .DataValueField("InvoiceNumber")
                              .DataSource(dataSource =>
                              {
                                  dataSource.Read(read => read.Action("GetInvoiceNumbersForCollection", "DataProvider", new { collectionId = "#=ConsARStandardCollectionId#" }));

                              })
                              .Events(e => e.Change("GetApplyAmountFromInvoice"))
                              .Filter("contains")
                              .MinLength(2)
                              .ValuePrimitive(true)
                              )
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.ApplyAmount, htmlAttributes: new { @class = "control-label col-md-8" })
                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.ApplyAmount)
                        @Html.ValidationMessageFor(model => model.ApplyAmount, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.BalanceDue, htmlAttributes: new { @class = "control-label col-md-8" })

                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.BalanceDue)
                        @Html.ValidationMessageFor(model => model.BalanceDue, "", new { @class = "text-danger" }) </div>
                </div>
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col-md-1">
