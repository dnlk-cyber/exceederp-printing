@using System.Collections
@using ExceedERP.Core.Domain.Construction
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>AR Standard Collections </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
      .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Name).Width(400);
          columns.Bound(c => c.Code);
          columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branchs"], "BranchId", "Name");
          columns.Bound(c => c.ContractAmount).ClientTemplate(
              "# if (ContractAmount === 0) { #" +
              " -----" +
              "# } else {#" +
              "#: kendo.toString( ContractAmount, 'N2') #" +
              "# } #"
              );
          columns.Bound(c => c.Client);
      })

      .Scrollable(h => h.Height(700))
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(10))
      .DataSource(dataSource => dataSource
          .Ajax()
          .PageSize(20)
          .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")"))
          .Model(model => model.Id(p => p.ProjectInformationId))
          .Read(read => read.Action("ProjectInformation_Read", "WorkInProgress"))
      ).ClientDetailTemplateId("template_collection")
)

<script id="template_collection" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tab__#=ProjectInformationId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("AR Standard Collections").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ConsARStandardCollection>()
                          .Name("collection_#=ProjectInformationId#")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.ConsARStandardCollectionId).Title("Receipt ID");
                              columns.Bound(c => c.ReceiptType).EditorTemplateName("ReceiptTypes");
                              columns.Bound(c => c.ClientName);
                              columns.Bound(c => c.ReceiptNumber);
                              columns.Bound(c => c.ReceiptDate);

                              columns.ForeignKey(c => c.PaymentMethodID, (IEnumerable)ViewData["PaymentMethods"], "PaymentMethodID", "Method").Title("Receipt Method").EditorTemplateName("PaymentMethods");
                              columns.Bound(c => c.Reference);
                              columns.Bound(c => c.PrepaymentBalance).Format("{0:N2}").ClientTemplate(
                                  "\\# if(PrepaymentBalance === 0) {\\# " +
                                  " -- "+
                                  "\\#} else {\\#" +
                                  "\\#=kendo.toString(PrepaymentBalance, 'N2')\\#" +
                                  "\\#}\\#"
                                  );
                              columns.Bound(c => c.OutstandingBalance).ClientTemplate(
                                  "\\# if(OutstandingBalance === 0) {\\# " +
                                  " -- "+
                                  "\\#} else {\\#" +
                                  "\\#=kendo.toString(OutstandingBalance, 'N2')\\#" +
                                  "\\#}\\#"
                                  );

                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(200);
                          })

                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Scrollable(h => h.Height(500))
                          .Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          .Events(ev =>
                          {
                              ev.DataBound("onDataBound");
                          })
                          //.Filterable()
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()

                              .Events(events =>
                              {
                                  events.Error("error_handler(\"collection_#=ProjectInformationId#\")");
                                  events.RequestStart("onRequestStart(\"collection_#=ProjectInformationId#\")");
                                  events.RequestEnd("onRequestEnd(\"collection_#=ProjectInformationId#\")");
                              })
                              .Model(model =>
                              {
                                  model.Id(f => f.ConsARStandardCollectionId);
                                  model.Field(f => f.ClientName).Editable(false);
                                  model.Field(f => f.OutstandingBalance).Editable(false);
                                  model.Field(f => f.PrepaymentBalance).Editable(false);
                                  model.Field(f => f.ConsARStandardCollectionId).Editable(false);
                                  //model.Field(f => f.DueDate).Editable(false);
                              })
                              .Read(read => read.Action("StandardCollections_Read", "StandardCollection", new { projectId = "#=ProjectInformationId#" }))
                              .Create(create => create.Action("StandardCollection_Create", "StandardCollection", new { projectIdCreate = "#=ProjectInformationId#" }))
                              .Update(update => update.Action("StandardCollection_Update", "StandardCollection"))
                              .Destroy(destroy => destroy.Action("StandardCollection_Destroy", "StandardCollection"))
                          ).ClientDetailTemplateId("template_collection_detail")
                          .ToClientTemplate()
                    )
                </text>
                  );
              items.Add().Text("Customer Accounts").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ConstructionCustomerAccount>()
                          .Name("accounts_#=ProjectInformationId#")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode");
                              columns.Bound(c => c.Description);
                              columns.Bound(c => c.AccountType).EditorTemplateName("ConstructionAccountTypes");
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(200);
                          })

                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          //.Events(ev =>
                          //{
                          //    ev.DataBound("onDataBoundOfWIPGrid");
                          //})
                          .Scrollable(h => h.Height(500))
                          ////.Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          //.Filterable()
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()

                              .Events(events =>
                              {
                                  events.Error("error_handler(\"accounts_#=ProjectInformationId#\")");
                                  events.RequestStart("onRequestStart(\"accounts_#=ProjectInformationId#\")");
                                  events.RequestEnd("onRequestEnd(\"accounts_#=ProjectInformationId#\")");
                              })
                              .Model(model =>
                              {
                                  model.Id(f => f.ConstructionCustomerAccountId);

                              })

                              .Read(read => read.Action("Accounts_Read", "ConstructionCustomerAccount", new { projectId = "#=ProjectInformationId#" }))
                              .Create(create => create.Action("Account_Create", "ConstructionCustomerAccount", new { projectId = "#=ProjectInformationId#" }))
                              .Update(update => update.Action("Account_Update", "ConstructionCustomerAccount"))
                              .Destroy(destroy => destroy.Action("Account_Destroy", "ConstructionCustomerAccount"))
                          )
                          .ToClientTemplate()
                    )
                </text>
                  );
          }).ToClientTemplate())
</script>
