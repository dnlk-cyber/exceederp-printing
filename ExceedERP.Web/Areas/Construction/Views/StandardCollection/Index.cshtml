                                      ag.Add(d => d.Debit).Sum();
                                  })
                                  //.Group(gr =>
                                  //{
                                  //    gr.Add(d => d.AccountCode);
                                  //})
                                  .Sort(srt => {
                                      srt.Add(f => f.Debit).Descending();
                                  })
                                  .Events(events =>
                                  {
                                      events.Error("error_handler(\"distribtion_#=ConsARStandardCollectionId#\")");
                                      events.RequestStart("onRequestStart(\"distribtion_#=ConsARStandardCollectionId#\")");
                                      events.RequestEnd("onRequestEnd(\"distribtion_#=ConsARStandardCollectionId#\")");
                                  })
                                  .Model(model =>
                                  {
                                      model.Id(f => f.ConsStandardCollectionDistributionId);
                                  })
                                  .Read(read => read.Action("CollectionDistribution_Read", "ConsStandardCollectionDistribution", new { id = "#=ConsARStandardCollectionId#" }))
                              //.Create(create => create.Action("CollectionDistribution_Create", "ConsStandardCollectionDistribution", new { id = "#=ConsARStandardCollectionId#" }))
                              //.Update(update => update.Action("CollectionDistribution_Update", "ConsStandardCollectionDistribution"))
                              //.Destroy(destroy => destroy.Action("CollectionDistribution_Destroy", "ConsStandardCollectionDistribution"))
                              )
                              .ToClientTemplate()
                              )
                    </text>
                      );
              }).ToClientTemplate())
    #}#
</script>
