@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Projects | Project Status </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectStatusEditViewModel>()
                      .Name("ProjectInformationgrid")
                      .Columns(columns =>
                      {
                          columns.Bound(c => c.Type).Hidden(true).ClientGroupHeaderTemplate(
                            "#=value#"
                            );
                          columns.Bound(c => c.ProjectName);
                          columns.Bound(c => c.Code);
                          columns.Bound(c => c.ContractAmount);

                          columns.Bound(c => c.ProjectStatus).EditorTemplateName("ProjectStatusSelector");

                          columns.Command(command =>
                          {
                              command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                          }).Width(200);

                      })

                    .Scrollable(h => h.Height(700))
                    .Sortable(sortable =>
                    {
                        sortable.SortMode(GridSortMode.SingleColumn);
                    })
                    .Filterable()
                    .Selectable(selectable =>
                    {
                        selectable.Mode(GridSelectionMode.Single);
                        selectable.Type(GridSelectionType.Row);
                    })
                    .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
                  .DataSource(dataSource => dataSource
                        .Ajax()
                        .Group(gr =>
                        {
                            gr.Add(f => f.Type);
                        })
                        .PageSize(20)
                        .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")"))
                        .Model(model => {
                            model.Id(p => p.ProjectInformationId);
                            model.Field(f => f.ProjectName).Editable(false);
                            model.Field(f => f.Code).Editable(false);
                            model.Field(f => f.ContractAmount).Editable(false);
                        })
                        .Read(read => read.Action("ProjectStatusInformation_Read", "ProjectStatus"))
                        .Update(update => update.Action("ProjectStatusInformation_Update", "ProjectStatus"))
                      )
)

