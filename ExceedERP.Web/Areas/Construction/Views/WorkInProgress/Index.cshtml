@using System.Collections
@using ExceedERP.Core.Domain.Construction
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Work In Progress</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
      .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Name).Width(400);
          columns.Bound(c => c.Code);
          columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branchs"], "BranchId", "Name");
          columns.Bound(c => c.ContractAmount).ClientTemplate(
                  "# if (ContractAmount === 0) { #" +
                    " -----" +
                  "# } else {#" +
                    "#: kendo.toString( ContractAmount, 'N2') #" +
                  "# } #"
              );
          columns.Bound(c => c.Client);
      })

      .Scrollable(h => h.Height(700))
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(10))
      .DataSource(dataSource => dataSource
          .Ajax()
          .PageSize(20)
          .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")"))
          .Model(model => model.Id(p => p.ProjectInformationId))
          .Read(read => read.Action("ProjectInformation_Read", "WorkInProgress"))
      ).ClientDetailTemplateId("template_workInProgress")
)

<script id="template_workInProgress" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tab__#=ProjectInformationId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("Work In Progress").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.WorkInProgress>()
                          .Name("wip_#=ProjectInformationId#")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.WorkInProgressNumber);
                              columns.Bound(c => c.ClientName);
                              columns.Bound(c => c.Date);
                              columns.Bound(c => c.WorkInProgressStatus);

                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(200);
                          })

                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Events(ev =>
                          {
                              ev.DataBound("onDataBoundOfWIPGrid");
                          })
                          .Scrollable(h => h.Height(500))
                          //.Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          //.Filterable()
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()

                              .Events(events =>
                              {
                                  events.Error("error_handler(\"wip_#=ProjectInformationId#\")");
                                  events.RequestStart("onRequestStart(\"wip_#=ProjectInformationId#\")");
                                  events.RequestEnd("onRequestEnd(\"wip_#=ProjectInformationId#\")");
                              })
                              .Model(model =>
                              {
                                  model.Id(f => f.WorkInProgressId);
                                  model.Field(f => f.WorkInProgressId).Editable(false);
                                  model.Field(f => f.ClientName).Editable(false);
                                  model.Field(f => f.WorkInProgressNumber).Editable(false);
                              })

                              .Read(read => read.Action("WorkInProgress_Read", "WorkInProgress", new { projectId = "#=ProjectInformationId#" }))
                              .Create(create => create.Action("WorkInProgress_Create", "WorkInProgress", new { projectIdCreate = "#=ProjectInformationId#" }))
                              .Update(update => update.Action("WorkInProgress_Update", "WorkInProgress"))
                              .Destroy(destroy => destroy.Action("WorkInProgress_Destroy", "WorkInProgress"))
                          ).ClientDetailTemplateId("template_wip_detail")
                          .ToClientTemplate()
                    )
                </text>
                  );

              items.Add().Text("Customer Accounts").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ConstructionCustomerAccount>()
                          .Name("accounts_#=ProjectInformationId#")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode");
                              columns.Bound(c => c.Description);
                              columns.Bound(c => c.AccountType).EditorTemplateName("ConstructionAccountTypes");
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(200);
                          })

                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          //.Events(ev =>
                          //{
                          //    ev.DataBound("onDataBoundOfWIPGrid");
                          //})
                          .Scrollable(h => h.Height(500))
                          //.Groupable()
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          //.Filterable()
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()

                              .Events(events =>
                              {
                                  events.Error("error_handler(\"accounts_#=ProjectInformationId#\")");
                                  events.RequestStart("onRequestStart(\"accounts_#=ProjectInformationId#\")");
                                  events.RequestEnd("onRequestEnd(\"accounts_#=ProjectInformationId#\")");
                              })
                              .Model(model =>
                              {
                                  model.Id(f => f.ConstructionCustomerAccountId);
                                 
                              })

                              .Read(read => read.Action("Accounts_Read", "ConstructionCustomerAccount", new { projectId = "#=ProjectInformationId#" }))
                              .Create(create => create.Action("Account_Create", "ConstructionCustomerAccount", new { projectId = "#=ProjectInformationId#" }))
                              .Update(update => update.Action("Account_Update", "ConstructionCustomerAccount"))
                              .Destroy(destroy => destroy.Action("Account_Destroy", "ConstructionCustomerAccount"))
                          )
                          .ToClientTemplate()
                    )
                </text>
                  );
          }).ToClientTemplate())
</script>

