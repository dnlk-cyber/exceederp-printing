@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Estimation Unit Factory></legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectEstimationUnitFactory>()
      .Name("ProjectEstimationUnitFactory")
      .Columns(columns =>
      {
          columns.Bound(c => c.ItemNo);
          columns.Bound(c => c.FactoryName);
          columns.Bound(c => c.Description);
          columns.Bound(c => c.Quantity);
          columns.Bound(c => c.UnitRate);
          columns.Bound(c => c.TotalCost);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(h => h.Height(500))
      .Groupable()
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(events => events.Error("error_handler(\"ProjectEstimationUnitFactory\")"))
          .Model(model => model.Id(p => p.ProjectEstimationUnitFactoryId))
          .Read(read => read.Action("ProjectEstimationUnitFactory_Read", "ProjectEstimationUnitFactory"))
          .Create(create => create.Action("ProjectEstimationUnitFactory_Create", "ProjectEstimationUnitFactory"))
          .Update(update => update.Action("ProjectEstimationUnitFactory_Update", "ProjectEstimationUnitFactory"))
          .Destroy(destroy => destroy.Action("ProjectEstimationUnitFactory_Destroy", "ProjectEstimationUnitFactory"))
      ))
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
</script>