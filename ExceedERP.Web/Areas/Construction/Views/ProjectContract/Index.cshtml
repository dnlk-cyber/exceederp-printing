<legend>Contract Management | Main Contracts</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
          .Name("ProjectInformationgrid")
          .Columns(columns =>
          {
              columns.Bound(c => c.Name).Width(350);
              columns.Bound(c => c.Code);
              //columns.Bound(c => c.Category).Width(200);
              //columns.Bound(c => c.BranchId).Width(150);
              columns.Bound(c => c.ContractAmount).ClientTemplate(
              "# if (ContractAmount === 0) { #" +
                                            " -----" +
                                            "# } else {#" +
                                            "#: kendo.toString( ContractAmount, 'N2') #" +
                                            "# } #"
              );
              //  columns.Bound(c => c.ProjectType).ClientGroupHeaderTemplate(
              //"# if (value === 0) { #" +
              //    " Building " +
              //  "# } else if (value === 1) {#" +
              //    " Road " +
              //  "# } else if (value === 2) {#" +
              //     " Dam " +
              //  "# } else if (value === 3) {#" +
              //    " Irrigation" +
              //  "# } #"
              //).Hidden(true);
              columns.Bound(c => c.Client);
          })

        .Scrollable(h => h.Height(700))
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Filterable()
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
            .Ajax()
            //.Group(gr => {
            //    gr.Add(f => f.ProjectType);
            //})
            .PageSize(20)
            .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")"))
            .Model(model => model.Id(p => p.ProjectInformationId))
            .Read(read => read.Action("ProjectInformation_Read", "ProjectContract"))
          ).ClientDetailTemplateId("template")
)

