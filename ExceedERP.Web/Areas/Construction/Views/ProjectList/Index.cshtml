<script>


    function sync_handler(e) {
        this.read();

    }
    function filter() {
        var value = this.value(),
          grid = $("#WorkItemPerProject").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "LookupId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }

        $.ajax({
            url: '@Url.Action("SetProjectTypeId", "WorkItemPerProject")',
            //contentType: "application/json; charset=utf-8",
            data: { value: value },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

            }

        });
    }
    function filterProject() {
        var value = this.value(),
          grid = $("#WorkItemPerProject").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "ProjectInformationId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }

        $.ajax({
            url: '@Url.Action("SetProjectId", "WorkItemPerProject")',
            //contentType: "application/json; charset=utf-8",
            data: { value: value },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

            }

        });
    }
</script>
<script>
    function OnChange(e) {
        var grid = e.select();
        var selectedRows = this.select();
        var rowData = this.dataItem(selectedRows[0]);
        var Quantity = rowData.Quantity;
        var UnitPrice = rowData.Quantity;
        $("#TotalCost").val(Quantity * UnitPrice);
    }
</script>
<script type="text/javascript">
    function onEdit(e) {


        $.ajax({
            url: '@Url.Action("ReturnValues", "WorkItemPerProject")',
            //contentType: "application/json; charset=utf-8",
            data: {},
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                var s = r.split(/-/);



                if (e.model.isNew()) {
                    //set the default value for StateID
                    e.model.set("OverheadRate", s[0]);
                    e.model.set("ProfitMargin", s[1]);
                }
            }

        });
        //check if record is new

    }
</script>
