<script type="text/javascript">
    function filterSourceType() {
        var dropdownlist = $("#Reference").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            sourctType: $("#Source").val(), filterString: filterInput.val()
        };
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ReceivableInvoice", new { area = "Construction" })',
            data: { id: id },
            cache: false,
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
    function workItemDropDownChanged(e) {
        var workItemId = $("#WorkItemPerProjectId").val();

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetAdvanceAmountToBeRepaid", "ReceivableInvoice", new { area = "Construction" })',
            data: { workItemId: workItemId },
            cache: false,
            success: function (result) {
                $("#AdvanceRepayment").val(result);
                $("#AdvanceRepayment").trigger("change");
            }, //end succ
            error: function (result) {
                //alert(result);
            }
        });
    }

    function onInvoiceDataBount(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        //Selects all edit buttons


        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check
            if (dataItem.IsOnlineApproved === true) {
                //hide buttons using jQuery
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                //row.find(".k-grid-customAction").text('ይከፈት');
            } else {

                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").show();
            }
            if (dataItem.ConstructionInvoiceStatus === 2) {
                //answer.hide(true);
                //transfer.hide(true);
                //row.css("background-color", "lightgreen");
                row.addClass("highlighted-row");

            } else {
                //answer.show(true);
                //transfer.show(true);
                //row.css("background-color", "grey");

            }
        }
    }

    function transfer(id) {
       var desc = prompt("Please enter transaction description:");

       $.ajax({
           type: "POST",
           url: '@Url.Action("TransferDistribution", "ReceivableInvoice", new { area = "Construction" })',
           data: {
               id: id,
               description: desc
           },
           success: function (result) {
               // toastr.warnning(result.Message);
               alert(result.Message);
               location.reload(true);
           }, //end succ
           error: function (result) {
               alert(result);
           }
       });
   }
</script>

<style type="text/css">
    .highlighted-row {
        background-color: #aafeaa;
    }

    .highlighted-row.k-alt {
        background-color: #bff1b4;
    }
</style>