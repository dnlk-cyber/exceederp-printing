@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
      .OptionLabel(Resources.Select)
      .Name("Reference")
      .DataTextField("WorkInProgressNumber")
      .DataValueField("WorkInProgressNumber")
      .DataSource(dataSource =>
      {
          dataSource.Read(read => read.Action("GetProjectWorkInProgressNumbers", "DataProvider", new {projectId = "#=ProjectInformationId#"}).Data("filterSourceType"))
          .ServerFiltering(true);
      })
      .Filter("contains")
      .CascadeFrom("Source")
      .MinLength(2)
      .ValuePrimitive(true)
      )