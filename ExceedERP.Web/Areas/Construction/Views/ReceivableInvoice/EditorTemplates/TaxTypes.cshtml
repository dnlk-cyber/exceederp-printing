@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        .Name("GLTaxRateID")
        .DataTextField("TaxName")
        .DataValueField("GLTaxRateID")
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetGLTaxRates", "DataProvider"));
        })
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)