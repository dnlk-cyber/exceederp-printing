<script id="template_boq_content_building" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tab_#=BoQOfExecutedWorkId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("BoQ Content").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.BoQOfExecutedWorkContent>()
                          .Name("contents_#=BoQOfExecutedWorkId#")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.SubProjectTypeName).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "\\#= value \\#  | Total  : \\#= kendo.toString(aggregates.AmountToDatePayment.sum, 'N4')\\# birr"
                                  );
                              columns.Bound(c => c.BlockName).Hidden(true).ClientGroupHeaderTemplate(
                                  "\\#= value \\# | Sub Total  : \\#= kendo.toString(aggregates.AmountToDatePayment.sum, 'N4')\\# birr"
                                  );
                              columns.Bound(c => c.StructureyType).Hidden(true).ClientGroupHeaderTemplate(
                                  "\\#= value \\# | Sub Total  : \\#= kendo.toString(aggregates.AmountToDatePayment.sum, 'N4')\\# birr"
                                  );
                              columns.Bound(c => c.WorkCategory).Hidden(true).ClientGroupHeaderTemplate(
                                  "\\#= value \\# | Total Carried To Summary : \\#= kendo.toString(aggregates.AmountToDatePayment.sum, 'N4')\\# birr"
                                  );
                              columns.Bound(c => c.ItemCode);
                              columns.Bound(c => c.Description).Width(260);
                              columns.ForeignKey(c => c.UnitOfMeasurementId, (IEnumerable)ViewData["uom"], "UnitOfMeasurementId", "Abbreviation").Width(75);

                              columns.Group(g => g.Title("Executed Qty of Work").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                .Columns(info =>
                                {
                                    info.Bound(x => x.ContractQuantity).Format("{0:N2}").Title("Contract");
                                    info.Bound(x => x.QuantityTillPrevPayment).Format("{0:N2}").Title("Prev Pay");
                                    info.Bound(x => x.QuantityThisPayment).Format("{0:N2}").Title("This Pay");
                                    info.Bound(x => x.QuantityToDate).Format("{0:N2}").Title("Tot. Pay");

                                })
                                );

                              columns.Bound(c => c.UnitRate);
                              columns.Group(g => g.Title("Amount").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                .Columns(info =>
                                {
                                    info.Bound(x => x.AmountTillPrevPayment).Format("{0:N2}").Title("Prev Pay");
                                    info.Bound(x => x.AmountThisPayment).Format("{0:N2}").Title("This Pay");
                                    info.Bound(x => x.AmountToDatePayment).Format("{0:N2}").Title("Tot. Pay").Width(120)
                                    .ClientFooterTemplate("Grand Total: \\#= kendo.toString(sum, 'N2')\\#");

                                })
                                );
                          })
                          .Scrollable(h => h.Height(550))
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          //.Events(e => e.Edit("onEdit"))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Sort(srt => srt.Add(f => f.ItemCode))
                              .Aggregates(ag => {
                                  ag.Add(f => f.AmountToDatePayment).Sum();
                              })
                              .PageSize(30)
                              .Events(events =>
                              {
                                  events.Error("error_handler(\"contents_#=BoQOfExecutedWorkId#\")");
                                  events.RequestStart("onRequestStart(\"contents_#=BoQOfExecutedWorkId#\")");
                                  events.RequestEnd("onRequestEnd(\"contents_#=BoQOfExecutedWorkId#\")");
                              })
                              .Group(g =>
                              {
                                  g.Add(f => f.SubProjectTypeName);
                                  g.Add(f => f.BlockName);
                                  g.Add(f => f.StructureyType);
                                  g.Add(f => f.WorkCategory);
                              })
                              .Model(model =>
                              {
                                  model.Id(p => p.BoQOfExecutedWorkContentId);
                                  model.Field(p => p.AmountToDatePayment).Editable(false);
                                  model.Field(p => p.BlockName).Editable(false);
                                  model.Field(p => p.WorkCategory).Editable(false);
                                  model.Field(p => p.StructureyType).Editable(false);
                                  model.Field(p => p.UnitOfMeasurementId).Editable(false);

                              }
                              )
                              .Read(read => read.Action("BoQContents_Read", "BoQOfExecutedWorkContent", new { id = "#=BoQOfExecutedWorkId#" }))
                              .Create(create => create.Action("BoQContent_Create", "BoQOfExecutedWorkContent", new { id = "#=BoQOfExecutedWorkId#" }))
                              .Update(update => update.Action("BoQContent_Update", "BoQOfExecutedWorkContent"))
                              .Destroy(destroy => destroy.Action("BoQContent_Destroy", "BoQOfExecutedWorkContent"))
                          )//.ClientDetailTemplateId("template")
                          .ToClientTemplate()
                    )
                </text>
                  );

              items.Add().Text("Price Adjusment").Content(
                @<text>
                    <strong style="text-align:center">Representative Elements and Current Prices</strong>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.RepresentativeElementCostInBill>()
                          .Name("rep_elements_#=BoQOfExecutedWorkId#")
                          .Columns(columns =>
                          {

                              columns.Bound(c => c.ItemName);
                              columns.Bound(c => c.Unit);
                              columns.Bound(c => c.BasicPrice);
                              columns.Bound(c => c.CurrentPrice);
                              columns.Command(command => {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                              }).Width(100);

                          })
                          .Scrollable(h => h.Height("auto"))
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()

                              .Events(events =>
                              {
                                  events.Error("error_handler(\"rep_elements_#=BoQOfExecutedWorkId#\")");
                                  events.RequestStart("onRequestStart(\"rep_elements_#=BoQOfExecutedWorkId#\")");
                                  events.RequestEnd("onRequestEnd(\"rep_elements_#=BoQOfExecutedWorkId#\")");
                              })

                              .Model(model =>
                              {
                                  model.Id(p => p.RepresentativeElementCostInBillId);
                                  model.Field(p => p.ItemName).Editable(false);
                                  model.Field(p => p.Unit).Editable(false);
                                  model.Field(p => p.BasicPrice).Editable(false);
                              }
                              )
                              .Read(read => read.Action("RepresentativeElements_Read", "RepresentativeElementCostInBill", new { id = "#=BoQOfExecutedWorkId#" }))
                              .Create(create => create.Action("RepresentativeElement_Create", "RepresentativeElementCostInBill", new { id = "#=BoQOfExecutedWorkId#" }))
                              .Update(update => update.Action("RepresentativeElement_Update", "RepresentativeElementCostInBill"))
                              .Destroy(destroy => destroy.Action("RepresentativeElement_Destroy", "RepresentativeElementCostInBill"))
                          ).ToClientTemplate()
                    )
                    <hr />
                    <strong style="text-align:center">Weighting</strong>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.RepresentativeElementWeightViewModel>()
                                            .Name("item_weight_#=BoQOfExecutedWorkId#")
                                            .Columns(columns =>
                                            {
                                                columns.Bound(c => c.Item).Title(" ");
                                                columns.Bound(c => c.Weight).Format("{0:N5}");
                                            })

                                            .Events(ev =>
                                            {
                                                ev.DataBound("weightingGridDataBound");
                                            })
                                            .Scrollable(h => h.Height("auto"))
                                            .Selectable(selectable =>
                                            {
                                                selectable.Mode(GridSelectionMode.Single);
                                                selectable.Type(GridSelectionType.Row);
                                            })
                                            .Pageable(pageable => pageable
                                                                  .Input(true)
                                                                  .Numeric(false)
                                                                  .Refresh(true)
                                                                  .PageSizes(true)
                                                                  .ButtonCount(5)
                                                            )
                                            .DataSource(dataSource => dataSource
                                                .Ajax()
                                                .Model(model =>
                                                {
                                                    model.Id(p => p.Id);
                                                })
                                                .Read(read => read.Action("RepresentativeElementWeightInBills_Read", "PriceAdjustmentWeight", new { boqId = "#=BoQOfExecutedWorkId#" }))
                                            ).ToClientTemplate()
                    )

                <hr />
                <strong style="text-align:center">Formula</strong>
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.PriceAdjustmentFormulaViewModel>()
                                    .Name("formula__#=BoQOfExecutedWorkId#")
                                    .Columns(columns =>
                                    {
                                        columns.Bound(c => c.Type).Title(" ").Width(40);
                                        columns.Bound(c => c.Formula).Width(550);
                                    })

                                    //.Events(ev =>
                                    //{
                                    //    ev.DataBound("weightingGridDataBound");
                                    //})
                                    .Scrollable(h => h.Height("auto"))
                                    .Selectable(selectable =>
                                    {
                                        selectable.Mode(GridSelectionMode.Single);
                                        selectable.Type(GridSelectionType.Row);
                                    })
                                    .Pageable(pageable => pageable
                                                                  .Input(true)
                                                                  .Numeric(false)
                                                                  .Refresh(true)
                                                                  .PageSizes(true)
                                                                  .ButtonCount(5)
                                                            )
                                    .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Model(model =>
                                        {
                                            model.Id(p => p.Type);
                                        })
                                        .Read(read => read.Action("PriceAdjustmentFormula_Read", "PriceAdjustmentWeight", new { boqId = "#=BoQOfExecutedWorkId#" }))
                                    ).ToClientTemplate()
                )
                </text>
                  );
          }).ToClientTemplate())
</script>

