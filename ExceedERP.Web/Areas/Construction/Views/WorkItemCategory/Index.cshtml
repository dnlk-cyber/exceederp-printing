@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend >Work Item Category</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Common.Lookup>()
          .Name("Lookupgrid")
      .Columns(columns =>
      {

          columns.ForeignKey(c => c.Category, (IEnumerable)ViewData["StructureType"], "CurrentValue", "CurrentValue").EditorTemplateName("StructureType").Width(110);
        columns.Bound(c => c.Description);
        columns.Bound(c => c.Index );
        columns.Bound(c => c.Remark);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .Selectable(selectable =>
             {
                 selectable.Mode(GridSelectionMode.Single);
                 selectable.Type(GridSelectionType.Row);
             })
                 .Scrollable(h => h.Height(500))
                     .Groupable()
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                  .Filterable()
                     .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()

                             .Events(events => events.Error("error_handler(\"Lookupgrid\")"))
          .Model(model => model.Id(p => p.LookupId))
                      .Read(read => read.Action("Lookups_Read", "WorkItemCategory"))
                          .Create(create => create.Action("Lookups_Create", "WorkItemCategory"))
                          .Update(update => update.Action("Lookups_Update", "WorkItemCategory"))
                          .Destroy(destroy => destroy.Action("Lookups_Destroy", "WorkItemCategory"))
          ).ClientDetailTemplateId("template")
      )

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                  .Name("tabstrip_#=LookupId#")
          .SelectedIndex(0)
          .Items(items =>
          {
             
              items.Add().Text("Item Categories").Content(
                @<text>

                   @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.MapWorkItemCategory>()
              .Name("grid_#=LookupId#")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.ItemCategoryCode, (IEnumerable)ViewData["Categories"], "ItemCategoryCode", "Name").EditorTemplateName("Category").Width(300);
         
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
                           .Events(events => events.Error("error_handler(\"grid_#=LookupId#\")"))
          .Model(model => model.Id(p => p.MapWorkCategoryId))
          .Read(read => read.Action("MapWorkItemCategory_Read", "MapWorkItemCategory", new {id ="#=LookupId#"}))
                  .Create(create => create.Action("MapWorkItemCategory_Create", "MapWorkItemCategory", new { idd = "#=LookupId#" }))
          .Update(update => update.Action("MapWorkItemCategory_Update", "MapWorkItemCategory"))
          .Destroy(destroy => destroy.Action("MapWorkItemCategory_Destroy", "MapWorkItemCategory"))
      ).ToClientTemplate()
                )
                </text>
                  );
          }).ToClientTemplate())
</script>

<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
</script>