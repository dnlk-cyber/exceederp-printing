@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Setting | General</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Common.HRM.Configuration>()
        .Name("ConfigurationGrid")
        .Columns(columns =>
        {
            // columns.Bound(c => c.Category);
            // columns.Bound(c => c.Reference).EditorTemplateName("Categories").Width(200)
            //  .ClientGroupHeaderTemplate("Setting")
            // .Title("Setting");
            columns.Bound(c => c.Attribute).EditorTemplateName("Attribute").Width(200).Title("Setting");
            columns.Bound(c => c.CurrentValue).Width(200).Title("Value");
            // columns.Bound(c => c.PreviousValue);
            columns.Bound(c => c.Remark).Width(200);
            columns.Command(command =>
            {
                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                command.Destroy().Text(Resources.ActionButton_Cancel);
            }).Width(200);
        })
        .ToolBar(toolbar =>
        {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
        })
        .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Scrollable(h => h.Height(700))
        .Groupable()
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        .Filterable()
        .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))
        .DataSource(dataSource => dataSource
        .Ajax()
         .Events(events =>
                {
                    events.Error("error_handler(\"ConfigurationGrid\")");
                    events.RequestStart("onRequestStart(\"ConfigurationGrid\")");
                    events.RequestEnd("onRequestEnd(\"ConfigurationGrid\")");
                })
        .PageSize(20)
            //.Events(events => events.Error("error_handler(\"ConfigurationGrid\")"))
            .Model(model => model.Id(p => p.ConfigurationId))
            .Read(read => read.Action("Configurations_Read", "Setting"))
            .Create(create => create.Action("Configurations_Create", "Setting", new { Attribute = "#=Attribute#", CurrentValue = "#=CurrentValue#" }))
            .Update(update => update.Action("Configurations_Update", "Setting"))
            .Destroy(destroy => destroy.Action("Configurations_Destroy", "Setting"))
        )
)

<script>
    function filterCategories() {
        return {
            Reference: $("#Reference").val()
        };
    }
</script>
<script>
    function filterAttributes() {
        return {
            Attribute: $("#Attribute").val()
        };
    }


</script>
<script>
    function filterCurrentValue() {
        return {
            Attribute: $("#CurrentValue").val()
        };
    }


</script>
