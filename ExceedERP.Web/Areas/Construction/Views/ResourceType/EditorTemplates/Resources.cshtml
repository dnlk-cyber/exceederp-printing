@using System.Collections
@using ExceedERP.Helpers.Common
@using ExceedERP.Core.Localization
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.Construction.ResourceViewModel

<form>
    <div class="row">
        <div class="col-md-1">
        </div>
       
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>

                    @Html.Kendo().TextBoxFor(model => model.Name)
                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-1">
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Type, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.ResourceTypeId)
                        .OptionLabel("Select ..")
                        .DataTextField("Name")
                        .DataValueField("ResourceTypeId")
                        .ValuePrimitive(true)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetAllResourceTypes", "ResourceType");
                            })
                            .ServerFiltering(false);
                        })
                    )
                </div>
            </div>
        </div>

    </div>

    <br />

    <div class="row">
        <div class="col-md-1">
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.UnitofMeasure, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">
                @Html.Kendo().TextBoxFor(model => model.UnitofMeasure)
                @Html.ValidationMessageFor(model => model.UnitofMeasure, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-1">
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.PrimaryRole, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @Html.Kendo().TextBoxFor(model => model.PrimaryRole)
                    @Html.ValidationMessageFor(model => model.PrimaryRole, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        
    </div>

    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Color, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">
                @*@(Html.Kendo().ColorPickerFor(model => model.Color)
                    .Name("picker")
                    .Value("#ffffff")
                    .Events(events => events.Select("preview"))
                )*@
                @Html.Kendo().TextBoxFor(model => model.Color)
                @Html.ValidationMessageFor(model => model.Color, "", new { @class = "text-danger" })
            </div>
        </div>
        
    </div>
    <br />
    <br />


</form>
