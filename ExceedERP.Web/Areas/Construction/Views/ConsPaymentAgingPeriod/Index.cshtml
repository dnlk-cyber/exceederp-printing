
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Billing(Payment) Aging</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ConsPaymentAgingPeriod>()
                              .Name("agingPeriodGrid")
                              .Columns(columns =>
                              {
                                  //columns.Bound(c => c.TimeUnit);
                                  //columns.Group(gr => {
                                  //    gr.Title("Time Past Due (Age Group)").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " });
                                  //    gr.Columns(cl =>
                                  //    {
                                  //        //cl.Bound(c => c.Min).Title("From").Width(80);
                                  //        //cl.Bound(c => c.Max).Title("To").Width(80);
                                  //        //cl.Bound(c => c.ConcatnatedRateDescription).Title(" ");
                                  //    });
                                  //});
                                  columns.Bound(c => c.ConcatnatedRateDescription).Title("Time Past Due (Age Group)");
                                  columns.Bound(c => c.ProvisionRate);

                                  columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                              })
                              .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("AgingPeriodEditor").Window(window => { window.Title("Payment Aging Setup"); window.Scrollable(false); }))
                              .ToolBar(toolbar =>
                              {
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              })
                              //.Events(ev => {
                              //    ev.DataBound("refreshData");
                              //})
                              .Selectable(selectable =>
                              {
                                  selectable.Mode(GridSelectionMode.Single);
                                  selectable.Type(GridSelectionType.Row);
                              })
                            .Scrollable(h => h.Height(500))
                            //.Groupable()
                            .Sortable(sortable =>
                            {
                                sortable.SortMode(GridSortMode.SingleColumn);
                            })
                            .Filterable()
                            .Pageable(pageable => pageable
                                                    .Input(true)
                                                    .Numeric(false)
                                                    .Refresh(true)
                                                    .PageSizes(true)
                                                    .ButtonCount(5))
                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .Model(model =>
                                  {
                                      model.Id(diam => diam.ConsPaymentAgingPeriodId);
                                      model.Field(b => b.ConcatnatedRateDescription).Editable(false);
                                  })
                                  .Events(events =>
                                  {
                                      events.Error("error_handler(\"agingPeriodGrid\")");
                                      events.RequestStart("onRequestStart(\"agingPeriodGrid\")");
                                      events.RequestEnd("onRequestEnd(\"agingPeriodGrid\")");
                                  })
                                  .Read(read => read.Action("PaymentAging_Read", "ConsPaymentAgingPeriod"))
                                  .Create(create => create.Action("PaymentAging_Create", "ConsPaymentAgingPeriod"))
                                  .Update(update => update.Action("PaymentAging_Update", "ConsPaymentAgingPeriod"))
                                  .Destroy(destroy => destroy.Action("PaymentAging_Destroy", "ConsPaymentAgingPeriod"))
                              )
)
