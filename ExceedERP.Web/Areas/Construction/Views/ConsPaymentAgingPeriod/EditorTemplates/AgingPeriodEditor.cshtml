@using System.Collections
@using ExceedERP.Helpers.Common
@using ExceedERP.Core.Localization
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.Construction.ConsPaymentAgingPeriod
<form>
    <div class="row">
        <div class="col-sm-1">

        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.TimeUnit, "Time Unit", htmlAttributes: new { @class = "control-label col-sm-12" })

                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.TimeUnit)
                                                   //.Placeholder(Resources.Select)
                                                   .DataTextField("Text")
                                                   .DataValueField("Value")
                                                   .ValuePrimitive(true)
                                                   .HtmlAttributes(new { style = "width:280px;"})
                                                   .BindTo(EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.Construction.AgingPeriodTimeUnit)))

                    )
                </div>
            </div>
        </div>
    </div>

    <br />


    <div class="row">
        <div class="col-sm-1">

        </div>
            <div class="col-sm-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.Min, "From", htmlAttributes: new { @class = "control-label col-sm-12" })

                    </div>
                    <div>

                        @Html.Kendo().TextBoxFor(model => model.Min).HtmlAttributes(new { style = "width:120px;" })
                        @Html.ValidationMessageFor(model => model.Min, "", new { @class = "text-danger" })
                    </div>
                </div>

            </div>

            <div class="col-sm-3">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.Max, "To", htmlAttributes: new { @class = "control-label col-sm-12" })

                    </div>
                    <div>
                        @Html.Kendo().TextBoxFor(model => model.Max).HtmlAttributes(new { style = "width:130px;" })
                        @Html.ValidationMessageFor(model => model.Max, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

    </div>
    <br />
    <div class="row">
        <div class="col-sm-1">
        </div>
        
        <div class="col-sm-6">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.ProvisionRate, htmlAttributes: new { @class = "control-label col-sm-12" })

                </div>
                <div>
                    @Html.Kendo().TextBoxFor(model => model.ProvisionRate).HtmlAttributes(new { style ="width:300px;"})
                    @Html.ValidationMessageFor(model => model.ProvisionRate, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        
    </div>
    <br />
</form>




