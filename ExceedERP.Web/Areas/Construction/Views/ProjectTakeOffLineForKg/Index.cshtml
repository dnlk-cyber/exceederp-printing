@using ExceedERP.Core.Localization
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectTakeOffLineForKg>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Description);
        columns.Bound(c => c.Type);
        columns.Bound(c => c.Shape);
        columns.Bound(c => c.Length);
        columns.Bound(c => c.NoOfBars);
        columns.Bound(c => c.NoOfElement);
        columns.Bound(c => c.TotalBar);
        columns.Bound(c => c.TotalLength);
        columns.Bound(c => c.GrandTotal);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ProjectTakeOffLineForKgId))
          .Read(read => read.Action("ProjectTakeOffLineForKg_Read", "ProjectTakeOffLineForKg"))
          .Create(create => create.Action("ProjectTakeOffLineForKg_Create", "ProjectTakeOffLineForKg"))
          .Update(update => update.Action("ProjectTakeOffLineForKg_Update", "ProjectTakeOffLineForKg"))
          .Destroy(destroy => destroy.Action("ProjectTakeOffLineForKg_Destroy", "ProjectTakeOffLineForKg"))
      )
)
