@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM
@(Html.Kendo().DropDownListFor(m => m)
    .OptionLabel(Resources.Select)
    .DataTextField("CurrentValue")
    .DataValueField("ConfigurationId")
    //.BindTo((IEnumerable)ViewData["Types"])
    .DataSource(dataSource =>
    {
        dataSource.Read(read => read.Action("GetAllStructureTypesForMapping", "DataProvider", new { area = "Construction" }));
    })
        
    .Filter("contains")
    .MinLength(2)
    .ValuePrimitive(true)
)