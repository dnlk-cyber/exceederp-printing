
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Tasks from Project Estimation</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.TaskFromEstimation>()
        .Name("TaskGrid")
        .Columns(columns =>
        {
            columns.Bound(c => c.TaskFromEstimationId).Title("Id");
            //columns.Bound(c => c.ResourceTypeId);
            columns.Bound(c => c.Title);
            columns.Bound(c => c.Start).Title("Start");
            columns.Bound(c => c.End).Title("End");
            //columns.Bound(c => c.WorkCategoryId).Title("Category");
            columns.Bound(c => c.Category).Title("Category");
            columns.Bound(c => c.EstimatedTotalCost);

            columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
        })
        //.ToolBar(toolbar =>
        //{
        //    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
        //})
        //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Resources").Window(window => { window.Title("Resource"); window.Scrollable(false); }))
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        .Scrollable(h => h.Height(500))
        .Groupable()
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Filterable()
        .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model => model.Id(t => t.TaskFromEstimationId))
            .Read(read => read.Action("TasksFromEstimation_Read", "Schedule"))
            .Create(create => create.Action("TasksFromEstimation_Read", "Schedule"))
            .Update(update => update.Action("TasksFromEstimation_Read", "Schedule"))
            .Destroy(destroy => destroy.Action("TasksFromEstimation_Read", "Schedule"))
        )
)
