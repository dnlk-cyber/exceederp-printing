
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Setting | Earned Value Management | Abbriviations and Definitions</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.EarnedValueManagementTerm>()
                          .Name("earnedValueManagementTermGrid")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Category).Title("Type").EditorTemplateName("TermCategory").Width(70);
                              columns.Bound(c => c.Term).Width(130);
                              columns.Bound(c => c.Abbreviation).Width(70);
                              columns.Bound(c => c.Definition).Width(220);
                              columns.Bound(c => c.Formula).Width(120);

                              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Resources").Window(window => { window.Title("Resource"); window.Scrollable(false); }))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                        .Scrollable(h => h.Height(700))
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                        .Filterable()
                        .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .PageSize(20)
                              .Model(model =>
                              {
                                  model.Id(res => res.EarnedValueManagementTermId);
                                  model.Field(res => res.Formula).Editable(false);
                              })
                              .Read(read => read.Action("EarnedValueManagementTerms_Read", "EarnedValueManagementTerms"))
                              .Create(create => create.Action("EarnedValueManagementTerm_Create", "EarnedValueManagementTerms"))
                              .Update(update => update.Action("EarnedValueManagementTerm_Update", "EarnedValueManagementTerms"))
                              .Destroy(destroy => destroy.Action("EarnedValueManagementTerm_Destroy", "EarnedValueManagementTerms"))
                          ).ClientDetailTemplateId("template_detail")
)

<script id="template_detail" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("tabstrip_1_#=EarnedValueManagementTermId#")
                  .SelectedIndex(0)
                  .Items(items =>
                  {
                  items.Add().Text("Formula Assignment").Content(
                    @<text>
                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.EarnedValueManagementTermDetail>()
                                .Name("formulaGrid_#=EarnedValueManagementTermId#")
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.OperandOne).EditorTemplateName("OperandOne");
                                    //columns.Bound(c => c.OperandOneHiddenValue);
                                    columns.Bound(c => c.Operator).EditorTemplateName("Operations").Title("Operation");
                                    columns.Bound(c => c.OperandTwo).EditorTemplateName("OperandTwo");
                                    //columns.Bound(c => c.OperandTwoHiddenValue);
                                    columns.Bound(c => c.Formula);
                                    //columns.Bound(c => c.HiddenFormulaValue).Width(200);
                                    columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                                })
                                .ToolBar(toolbar =>
                                {
                                    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                })
                                //.ClientDetailTemplateId("templateOne")
                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .Selectable(selectable =>
                                {
                                    selectable.Mode(GridSelectionMode.Single);
                                    selectable.Type(GridSelectionType.Row);
                                })
                                .Scrollable(h => h.Height(500))
                                .Groupable()
                                .Sortable(sortable =>
                                {
                                    sortable.SortMode(GridSortMode.SingleColumn);
                                })
                                .Filterable()
                                .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Events(events =>
                                    {
                                        events.Error("error_handler(\"formulaGrid_#=EarnedValueManagementTermId#\")");
                                        events.RequestStart("onRequestStart(\"formulaGrid_#=EarnedValueManagementTermId#\")");
                                        events.RequestEnd("onRequestEnd(\"formulaGrid_#=EarnedValueManagementTermId#\")");

                                    })
                                    .Model(model =>
                                    {
                                        model.Id(evd => evd.EarnedValueManagementTermDetailId);
                                        model.Field(evd => evd.Formula).Editable(false);
                                    })

                                    .Read(read => read.Action("EarnedValuetDetail_Read", "EarnedValueManagementTermDetail", new { id = "#=EarnedValueManagementTermId#" }))
                                    .Create(create => create.Action("EarnedValuetDetail_Create", "EarnedValueManagementTermDetail", new { idCreate = "#=EarnedValueManagementTermId#" }))
                                    .Update(update => update.Action("EarnedValuetDetail_Update", "EarnedValueManagementTermDetail"))
                                    .Destroy(destroy => destroy.Action("EarnedValuetDetail_Destroy", "EarnedValueManagementTermDetail"))
                                    ).ClientDetailTemplateId("sub_detail")
                                    .ToClientTemplate()
                        )
                    </text>
                  );
                  }).ToClientTemplate())
</script>

