@using ExceedERP.Core.Domain.Construction
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Kendo.Mvc.UI
<legend>Delay Analysis Using '<strong>Impacted As-Planed</strong>' Technique</legend>
@(Html.Kendo().Gantt<DelayAnalysisTaskViewModel, DelayTaskDependencyViewModel>()
        .Name("tasks_gantt")
        .Columns(columns =>
        {
            columns.Bound(c => c.TaskID).Title("ID").Width(50);
            //columns.Bound(c => c.HasDelay).Width(50);
            columns.Bound("title").Title("Work Item").Width(180).Editable(false);
            //columns.Bound("start").Width(80).Sortable(true).Editable(true);
            //columns.Bound("end").Width(80).Sortable(true).Editable(true);
            columns.Bound("orderId").Title("Order").Width(50);
            columns.Bound(c => c.PlannedDuration).Width(60);
            columns.Bound(c => c.DelayDuration).Width(80).Editable(true);

        })
        .Editable(false)
        .Toolbar(toolbar =>
        {
            toolbar.Add().Name("custom").TemplateId("toolbar_template");
        })
        .Views(views =>
        {
            views.DayView();
            views.WeekView();
            views.MonthView(monthView => monthView.Selected(true));
            views.YearView();
        })
        .ShowWorkHours(false)
        .ShowWorkDays(false)
        .Snap(false)
        .Resizable(true)
        .Navigatable(true)
        .Selectable(true)
        .DataSource(d => d
            .Model(m =>
            {
                m.Id(f => f.TaskID);
            })
            .Read("DelayAnalysisTasks_Read", "DelayAnalysis")
            .Create("DelayAnalysisTasks_Read", "DelayAnalysis")
            .Destroy("DelayAnalysisTasks_Read", "DelayAnalysis")
            .Update("DelayAnalysisTask_Update", "DelayAnalysis")
        )
        .DependenciesDataSource(d => d
            .Model(m =>
            {
                m.Id(f => f.DependencyID);
                m.PredecessorId(f => f.PredecessorID);
                m.SuccessorId(f => f.SuccessorID);
                m.Type(f => f.Type);
            })
            .Read("ReadDependencies", "DelayAnalysis")
            .Create("CreateDependency", "DelayAnalysis")
            .Destroy("DestroyDependency", "DelayAnalysis")
            .Update("UpdateDependency", "DelayAnalysis")
        )
    .Events(evnt =>
    {
        evnt.DataBound("onDataBound");
    })

)

<script id="toolbar_template" type="text/x-kendo-template">

    <text style="margin-left:20px">
        <strong>Filter &nbsp;</strong>
    </text>
    <input id="projectDropdown" />
    <input id="scheduleVersion" disabled="disabled" />
    <input id="delayInfoDropDown" disabled="disabled" />
    @*<input id="pwbDropdown" disabled="disabled" />*@
    &nbsp;&nbsp;&nbsp;
    <button class="k-button k-primary" href="" onclick="return goToDelayInfo()">
        @*<span class="k-icon k-i-plus"></span>*@
        <span>
            Edit Delay Info.
        </span>
    </button>

</script>

<script type="text/javascript">

    $(document).ready(function () {
        var gnt = $("#tasks_gantt").getKendoGantt();
        gnt.dataSource.filter({ field: "ProjectInformationId", operator: "eq", value: parseInt(-1) });

        var projects = $("#projectDropdown").kendoDropDownList({
            optionLabel: "Select project ...",
            filter: "contains",
            dataTextField: "Name",
            dataValueField: "ProjectInformationId",
            dataSource: {
                transport: {
                    read: {
                        url: '/DataProvider/GetAllProjectNames/'
                    }
                }
            },
            change: function () {
                var gantt1 = $("#tasks_gantt").getKendoGantt();
                gantt1.dataSource.filter({
                    logic: "and",
                    filters: [
                        { field: "ProjectInformationId", operator: "eq", value: parseInt(this.value()) },
                        { field: "Version", operator: "eq", value: -1 }
                    ]
                });
                // get the id of the selected project
                //theSelectedProjectId = parseInt(this.value());
            }
        }).data("kendoDropDownList");
        //version drop down
        var versionsList = $("#scheduleVersion").kendoDropDownList({
            autoBind: false,
            cascadeFrom: "projectDropdown",
            optionLabel: "Schedule Version...",
            dataTextField: "VersionTitle",
            dataValueField: "Version",
            dataSource: {
                serverFiltering: true,
                transport: {
                    read: {
                        url: '/DataProvider/GetScheduleVersionsOfProject/',
                        data: function () {
                            return { currentProjectId: projects.value() };
                        }
                    }
                }
            },
            change: function () {
                var chart = $("#tasks_gantt").getKendoGantt();
                //chart.dataSource.filter({ field: "Version", operator: "eq", value: parseInt(this.value()) });
                chart.dataSource.filter({
                    logic: "and",
                    filters: [
                        { field: "ProjectInformationId", operator: "eq", value: parseInt(projects.value()) },
                        { field: "TaskVersion", operator: "eq", value: parseInt(this.value()) }
                    ]
                });
            }
        }).data("kendoDropDownList");

        // chronology of delay
        var workDelay = $("#delayInfoDropDown").kendoDropDownList({
            autoBind: false,
            cascadeFrom: "scheduleVersion",
            optionLabel: " Select Delay ...",
            dataTextField: "Order",
            dataValueField: "WorkDelayId",
            dataSource: {
                serverFiltering: true,
                transport: {
                    read: {
                        url: '/DataProvider/GetAvailableDelaysOfTasks/',
                        data: function () {
                            return { projectId: projects.value(), scheduleVersion: versionsList.value() };
                        }
                    }
                }
            },
            change: function () {
                var gantt1 = $("#tasks_gantt").getKendoGantt();
                
                var delayId = workDelay.value();

                var recordStatus = "";

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("AddDelayToDelayAnalysisTask", "WorkDelay", new { area = "Construction" })',
                    data: { delayId: delayId },
                    success: function (result) {
                        // toastr.warnning(result.Message);
                        //alert(result.Message);
                        recordStatus = result.Status;
                        //location.reload(true);
                        gantt1.dataSource.read();
                    }, //end succ
                    error: function (result) {
                        alert(result);
                    }
                });
            }
        }).data("kendoDropDownList");

    });

    function onDataBound() {
        var gantt = this;

        gantt.element.find(".k-task").each(function (e) {
            var dataItem = gantt.dataSource.getByUid($(this).attr("data-uid"));

            // colorize task per business requirements
            if (dataItem.HasDelay === true) {
                this.style.backgroundColor = "#f99";
            }
                //else if (dataItem.summary === true || dataItem.expanded === true) {
                //    //this.style.backgroundColor = "dodgerblue";
                //}
            else {
                //this.style.backgroundColor = "dodgerblue";

            }
        });
    }

    function goToDelayInfo() {
        window.location.href = "@Url.Action("Index", "WorkDelay")";;
    }
</script>

@*<style type="text/css">
        .k-gantt-actions .k-button {
            visibility: hidden;
        }
    </style>*@