@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Take Off Sheet</legend>
<div>
    <div class="toolbar">
               <label class="category-label">Select Project Name:</label>
        @(Html.Kendo().DropDownListFor(m=> m)

                    .Name("ProjectInformationId")
            .Text("Project Name..")
            .BindTo((IEnumerable)ViewData["ProjectList"])
            .DataTextField("Name")
            .DataValueField("ProjectInformationId")
    .HtmlAttributes(new { style = "width: 300px;" })
    .ValuePrimitive(true)
            .Events(x => x.Change("filterProject"))

        )
           
        <br />
    </div>
</div>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.TakeOffPerProject>()
          .Name("TakeOffPerProject")
      .Columns(columns =>
      {
        columns.Bound(c => c.TakeOffNo);
        columns.ForeignKey(c => c.WorkItemPerProjectId, (IEnumerable)ViewData["WorkItems"], "WorkItemPerProjectId", "ItemName").Width(200);
       // columns.Bound(c => c.ProjectId);
        columns.Bound(c => c.Remark);
        //columns.Bound(c => c.OrgBranchName);
        //columns.Bound(c => c.DateCreated);
        //columns.Bound(c => c.LastModified);
        //columns.Bound(c => c.CreatedBy);
        //columns.Bound(c => c.ModifiedBy);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel);  }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
          .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Scrollable(h => h.Height(500))
                                                                                                 .Groupable()
                                                                                                          .Sortable(sortable =>
                                                                                                          {
                                                                                                              sortable.SortMode(GridSortMode.SingleColumn);
                                                                                                          })
                                                                                              .Filterable()
                                                                                                 .Pageable(pageable => pageable
                                                                                                                            .Input(true)
                                                                                                                            .Numeric(false)
                                                                                                                            .Refresh(true)
                                                                                                                            .PageSizes(true)
                                                                                                                            .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.TakeOffPerProjectId))
          .Read(read => read.Action("TakeOffPerProject_Read", "TakeOffPerProject"))
          .Create(create => create.Action("TakeOffPerProject_Create", "TakeOffPerProject"))
          .Update(update => update.Action("TakeOffPerProject_Update", "TakeOffPerProject"))
          .Destroy(destroy => destroy.Action("TakeOffPerProject_Destroy", "TakeOffPerProject"))
          ).ClientDetailTemplateId("templateTwo")
)
<script id="templateTwo" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=TakeOffPerProjectId#")
          .SelectedIndex(0)
          .Items(items =>
          {

              items.Add().Text("Take Off Sheet One").Content(
                @<text>

                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.TakeOffLinePerProject>()
                              .Name("ProjectTakeOffLine_#=TakeOffPerProjectId#")
      .Columns(columns =>
      {
          columns.Bound(c => c.LookupId).EditorTemplateName("Unit").Width(200);
          columns.Bound(c => c.T).Width(100);
          columns.Group(g => g.Title("D")
            .Columns(info =>
            {
                columns.Bound(c => c.Length).Width(100);
                columns.Bound(c => c.Width).Width(100);
                columns.Bound(c => c.Height).Width(100);
            })
            );

          columns.Bound(c => c.S).Width(100);
          columns.Bound(c => c.Description).Width(200);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })

      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(h => h.Height(500))
               .Groupable()
      .DataSource(dataSource => dataSource
          .Ajax()

      .Events(events => events.Error("error_handler")
                              .Sync("sync_handler"))
          .Model(model =>
          {
              model.Id(p => p.TakeOffLinePerProjectId);
              model.Field(p => p.S).Editable(false);
          })
                                                                  .Read(read => read.Action("TakeOffLinePerProject_Read", "TakeOffLinePerProject", new { lineId = "#=TakeOffPerProjectId#" }))
                                                          .Create(create => create.Action("TakeOffLinePerProject_Create", "TakeOffLinePerProject", new { lineIdTwo = "#=TakeOffPerProjectId#" }))
                                                  .Update(update => update.Action("TakeOffLinePerProject_Update", "TakeOffLinePerProject"))
                                                  .Destroy(destroy => destroy.Action("TakeOffLinePerProject_Destroy", "TakeOffLinePerProject"))
      ).ToClientTemplate()
                    )
                </text>
    );
              items.Add().Text("Take Off Sheet Two").Content(
                @<text>

                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.TakeOffLineForKgPerProject>()
                              .Name("ProjectTakeOffLineForKg_#=TakeOffPerProjectId#")
      .Columns(columns =>
      {
          columns.Bound(c => c.Description).Width(150);
          columns.Bound(c => c.Type).Width(100);
          columns.Bound(c => c.Shape).Width(100);
          columns.ForeignKey(c => c.UnitRateId, (IEnumerable)ViewData["Diameters"], "UnitRateId", "Diameter").Width(100).Title("Diameter").EditorTemplateName("DiameterList");
          columns.Bound(c => c.Length).Width(100);
          columns.Group(g => g.Title("No of bars")
             .Columns(info =>
             {
                 info.Bound(x => x.NoOfBars).Width(100);
                 info.Bound(x => x.NoOfElement).Width(100);
                 // info.Bound(c => c.TotalBar).Width( 100);
             })
             );
          //columns.Bound(c => c.NoOfBars);
          // columns.Bound(c => c.NoOfElement);

          columns.Bound(c => c.TotalLength).Width(120)
           .ClientFooterTemplate("Total Length: \\#=sum\\#")
              .ClientGroupFooterTemplate("Total Length: \\#=sum\\#");
          columns.Bound(c => c.GrandTotal).Width(100)
          .ClientFooterTemplate("Grand Total: \\#=sum\\#")
              .ClientGroupFooterTemplate("Grand Total: \\#=sum\\#");
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
                    .Aggregates(aggregates =>
                                    {
                                        aggregates.Add(p => p.TotalLength).Sum();
                                        aggregates.Add(p => p.GrandTotal).Sum();
                                    })
          .Model(model =>
          {
              model.Id(p => p.TakeOffLineForKgPerProjectId);
              model.Field(p => p.TotalBar).Editable(false);
              model.Field(p => p.TotalLength).Editable(false);
              model.Field(p => p.GrandTotal).Editable(false);
          })
                                          .Read(read => read.Action("TakeOffLineForKgPerProject_Read", "TakeOffLineForKgPerProject", new { idKg = "#=TakeOffPerProjectId#" }))
                                          .Create(create => create.Action("TakeOffLineForKgPerProject_Create", "TakeOffLineForKgPerProject", new { idTwoKg = "#=TakeOffPerProjectId#" }))
                          .Update(update => update.Action("TakeOffLineForKgPerProject_Update", "TakeOffLineForKgPerProject"))
                          .Destroy(destroy => destroy.Action("TakeOffLineForKgPerProject_Destroy", "TakeOffLineForKgPerProject"))
      ).ToClientTemplate()
                    )
                </text>
    );
          }).ToClientTemplate())
</script>




<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }

    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }

    function filterProject() {
        var value = this.value(),
          grid = $("#TakeOffPerProject").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "ProjectInformationId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }

        $.ajax({
            url: '@Url.Action("SetProjectId", "TakeOffPerProject")',
            //contentType: "application/json; charset=utf-8",
            data: { value: value },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

            }

        });
    }
    </script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>