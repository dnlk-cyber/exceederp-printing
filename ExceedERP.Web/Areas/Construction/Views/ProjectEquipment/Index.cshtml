@using ExceedERP.Core.Localization
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectEquipment>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.AssetNumber);
        columns.Bound(c => c.UnitOfMeasurementId);
        columns.Bound(c => c.Quantity);
        columns.Bound(c => c.UnitFactory);
        columns.Bound(c => c.RentalCost);
        columns.Bound(c => c.TotalCost);
        columns.Bound(c => c.EquipmentUnitCost);
        columns.Bound(c => c.EquipmentType);
        columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ProjectEquipmentId))
          .Read(read => read.Action("ProjectEquipment_Read", "ProjectEquipment"))
          .Create(create => create.Action("ProjectEquipment_Create", "ProjectEquipment"))
          .Update(update => update.Action("ProjectEquipment_Update", "ProjectEquipment"))
          .Destroy(destroy => destroy.Action("ProjectEquipment_Destroy", "ProjectEquipment"))
      )
)
