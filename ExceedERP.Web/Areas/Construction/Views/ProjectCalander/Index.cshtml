@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Calendar</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectCalendarViewModel>()
        .Name("ProjectCalandergrid")
        .Columns(columns =>
        {
            columns.Bound(c => c.Day);
            columns.Bound(c => c.FromHour);
            columns.Bound(c => c.ToHour);
            columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
        })
        .ToolBar(toolbar => 
        {
         toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
        })
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Scrollable(h => h.Height(500))
        .Groupable()
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Filterable()
        .Pageable(pageable => pageable
                    .Input(true)
                    .Numeric(false)
                    .Refresh(true)
                    .PageSizes(true)
                    .ButtonCount(5))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("error_handler(\"ProjectCalandergrid\")"))
            .Model(model => model.Id(p => p.ProjectCalanderId))
            .Read(read => read.Action("ProjectCalander_Read", "ProjectCalander"))
            .Create(create => create.Action("ProjectCalander_Create", "ProjectCalander"))
            .Update(update => update.Action("ProjectCalander_Update", "ProjectCalander"))
            .Destroy(destroy => destroy.Action("ProjectCalander_Destroy", "ProjectCalander"))
        )
)
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }
</script>