
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Setting | Method of Work </legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.MethodOfWork>()
                          .Name("methodOfWork")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Name).Width(120);
                              columns.Bound(c => c.Abbreviation).Width(120);
                              //columns.Bound(c => c.ConcatnatedCode);
                              //columns.Bound(c => c.FuelType).Width(120).EditorTemplateName("FuelTypes");
                              //columns.Bound(c => c.Price).Width(120);

                              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Resources").Window(window => { window.Title("Resource"); window.Scrollable(false); }))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                        .Scrollable(h => h.Height(500))
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                        .Filterable()
                        .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Events(events => events.Error("grid_error"))
                              .Model(model =>
                              {
                                  model.Id(res => res.MethodOfWorkId);
                                  //model.Field(res => res.UnitWeight).Editable(false);
                              })
                              .Read(read => read.Action("MethodOfWork_Read", "MethodOfWork"))
                              .Create(create => create.Action("MethodOfWork_Create", "MethodOfWork"))
                              .Update(update => update.Action("MethodOfWork_Update", "MethodOfWork"))
                              .Destroy(destroy => destroy.Action("MethodOfWork_Destroy", "MethodOfWork"))
                          )
)

<script>
      function grid_error(e) {
          if (e.errors) {
              var message = "Errors:\n";
              $.each(e.errors, function (key, value) {
                  if ('errors' in value) {
                      $.each(value.errors, function () {
                          message += this + "\n";
                      });
                  }
              });
              alert(message);
              var grid = $("#methodOfWork").data("kendoGrid");
              grid.cancelChanges();
          }
      }
</script>
