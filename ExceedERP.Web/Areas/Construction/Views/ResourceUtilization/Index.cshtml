                                      events.RequestEnd("onRequestEnd(\"WorkItemPerProject_#=ResourceUtilizationDayId#\")");
                                  })
                                  .Model(model =>
                                  {
                                      model.Id(p => p.Id);
                                      model.Field(p => p.WorkCategory).Editable(false);
                                      model.Field(p => p.WorkItemPerProjectId).Editable(false);

                                      model.Field(p => p.ItemCode).Editable(false);
                                      model.Field(p => p.ItemName).Editable(false);
                                      model.Field(p => p.UoM).Editable(false);
                                      model.Field(p => p.ContractQuantity).Editable(false);
                                      model.Field(p => p.TakeOffQuantity).Editable(false);
                                      model.Field(p => p.UnitPrice).Editable(false);

                                      model.Field(f => f.TodatePlannedQuantity).Editable(false);
                                      model.Field(f => f.TodateActualQuantity).Editable(false);

                                      model.Field(f => f.PreviousActualAmount).Editable(false);
                                      model.Field(f => f.ActualAmount).Editable(false);
                                      model.Field(f => f.TodateActualAmount).Editable(false);
                                  }
                                  )
                                  .Read(read => read.Action("ResourceUtilizationWorkItem_Read", "DetailedWorkProgress", new { dayId = "#=ResourceUtilizationDayId#" }))
                                  //.Create(create => create.Action("ResourceUtilizationWorkItem_Create", "ResourceUtilization", new { dayId = "#=ResourceUtilizationDayId#" }))
                                  .Update(update => update.Action("ResourceUtilizationWorkItem_Update", "DetailedWorkProgress"))
                                  .Destroy(destroy => destroy.Action("ResourceUtilizationWorkItem_Destroy", "DetailedWorkProgress"))
                                ).ClientDetailTemplateId("detailed-workprogress-chile-tmpl")
                                .ToClientTemplate()
                    )
                </text>
                );
                  
          }).ToClientTemplate())
</script>
