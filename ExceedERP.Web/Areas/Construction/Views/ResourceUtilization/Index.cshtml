                                  selectable.Type(GridSelectionType.Row);
                              })
                              .Pageable(pageable => pageable
                                  .Input(true)
                                  .Numeric(false)
                                  .Refresh(true)
                                  .PageSizes(true)
                                  .ButtonCount(5))
                              //.Events(e => e.Edit("onEdit"))
                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  //.PageSize(20)
                                  .Group(g =>
                                  {
                                      g.Add(f => f.SubProjectTypeName);
                                      g.Add(f => f.BlockName);
                                      g.Add(f => f.StructureType);
                                      g.Add(f => f.WorkCategory);

                                  })
                                  .Events(events =>
