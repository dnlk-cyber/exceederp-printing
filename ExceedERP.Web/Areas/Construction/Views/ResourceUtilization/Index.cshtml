@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Resource Utilization</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
        .Name("ProjectInformationgrid")
        .Columns(columns =>
        {
            columns.Bound(c => c.Name).Width(150);
            columns.Bound(c => c.Code).Width(150);
            columns.Bound(c => c.ProjectType).Width(140);
            columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").EditorTemplateName("Branch").Width(150);
            columns.Bound(c => c.ContractAmount).Width(150).ClientTemplate(
                "# if (ContractAmount === 0) { #" +
                                            " -----" +
                                            "# } else {#" +
                                            "#: kendo.toString( ContractAmount, 'N2') #" +
                                            "# } #"
                );
            columns.Bound(c => c.Client).Width(150);
            columns.Command(command =>
            {
                command.Custom("CmdOpenProjectView").Text("&nbsp;&nbsp;Expand").Click("openSpecificProjectView").IconClass("fa fa-xpand");
            }).Width(120);
        })
        .Scrollable(h => h.Height(700))
        //.Groupable()
        .Sortable(sortable =>
        {
            sortable.SortMode(GridSortMode.SingleColumn);
        })
        .Filterable()
        .Events(ev =>
        {
            ev.DataBound("projectsGridDataBound");
        })
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")")
                //  .Sync("sync_handler")
                )
            .Model(model => model.Id(p => p.ProjectInformationId))
            .Read(read => read.Action("ProjectInformation_Read", "ResourceUtilization"))
        //.Create(create => create.Action("ProjectInformation_Create", "ProjectInformation"))
        //.Update(update => update.Action("ProjectInformation_Update", "ProjectInformation"))
        //.Destroy(destroy => destroy.Action("ProjectInformation_Destroy", "ProjectInformation"))
        ).ClientDetailTemplateId("periods-tmpl")
)
<script id="periods-tmpl" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=ProjectInformationId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("Resource Utilization Periods").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ResourceUtilizationPeriod>()
                            .Name("period__#=ProjectInformationId#")
                              .Columns(columns =>
                              {
                                  columns.ForeignKey(c => c.ConstructionPeriodId, (IEnumerable)ViewData["ConstructionPeriods"], "ConstructionPeriodId", "Name").EditorTemplateName("Periods");
                                  columns.Bound(c => c.Description);
                                  columns.Command(command =>
                                  {
                                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                      command.Destroy().Text(Resources.ActionButton_Cancel);
                                  }).Width(200);
                              })
                                .ToolBar(toolbar =>
                                {
                                    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                })
                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                              //.Events(e => e.Change("OnChange"))
                              .Scrollable(h => h.Height(500))
                              //.Groupable()
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                              .Filterable()
                              .Selectable(selectable =>
                              {
                                  selectable.Mode(GridSelectionMode.Single);
                                  selectable.Type(GridSelectionType.Row);
                              })
                              .Pageable(pageable => pageable
                                  .Input(true)
                                  .Numeric(false)
                                  .Refresh(true)
                                  .PageSizes(true)
                                  .ButtonCount(5))
                              //.Events(e => e.Edit("onEdit"))
                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .Events(events =>
                                  {
                                      events.Error("error_handler(\"period__#=ProjectInformationId#\")");
                                      events.RequestStart("onRequestStart(\"period__#=ProjectInformationId#\")");
                                      events.RequestEnd("onRequestEnd(\"period__#=ProjectInformationId#\")");
                                  })
                                  .Model(model =>
                                  {
                                      model.Id(p => p.ResourceUtilizationPeriodId);

                                  }
                                  )
                                  .Read(read => read.Action("Periods_Read", "ResourceUtilizationPeriod", new { projectId = "#=ProjectInformationId#" }))
                                  .Create(create => create.Action("Period_Create", "ResourceUtilizationPeriod", new { projectId = "#=ProjectInformationId#" }))
                                  .Update(update => update.Action("Period_Update", "ResourceUtilizationPeriod"))
                                  .Destroy(destroy => destroy.Action("Period_Destroy", "ResourceUtilizationPeriod"))
                                ).ClientDetailTemplateId("days-tmpl")
                                .ToClientTemplate()
                    )
                </text>
                );
          
          }).ToClientTemplate())
</script>

