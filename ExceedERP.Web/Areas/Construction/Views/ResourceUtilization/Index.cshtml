                                            " -----" +
                                            "\\# } else {\\#" +
                                            "\\#: kendo.toString( TodateActualQuantity, 'N2') \\#" +
                                            "\\# } \\#"
                                        );
                                  columns.Group(g => g.Title("Quantity of Work").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold;" })
