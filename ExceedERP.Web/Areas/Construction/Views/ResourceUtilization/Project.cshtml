<script>
    var selectedProjectId = 0;
    $(document).ready(function () {
        var url = window.location.href;

        var parameterName = 'p';
        //if (!url) url = window.location.href;
        parameterName = parameterName.replace(/[\[\]]/g, '\\$&');
        var regex = new RegExp('[?&]' + parameterName + '(=([^&#]*)|&|#|$)');
        var results = regex.exec(url);
        if (!results) projectType = null;
        if (!results[2]) projectType = '';
        var stringValue = decodeURIComponent(results[2].replace(/\+/g, ' '));
        selectedProjectId = parseInt(stringValue)
        grid = $("#periodsGrid").data("kendoGrid");
        grid.dataSource.read();
    });
    function daysGridDataBound(e) {
        $(".k-grid-CmdOpenDayView").find("span").addClass("fa fa-expand ");
    }
    function getIdOfOpenedProject() {
        return {
            projectId: selectedProjectId
        };
    }
    function openSpecificDayView(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.ResourceUtilizationDayId;
        @*window.location.href = "@Url.Action("Project", "ProjectEstimation", new { area = "Construction", p = id })";*@
        window.location.href = "/Construction/ResourceUtilization/DailyUtl?d=" + id;
    }
    function filterCategories() {
        return {
            ItemCategoryCode: $("#ItemCategoryCode").val()
        };
    }
    function filterType() {
        return {
            EquipmentIdentityID: $("#EquipmentIdentityID").val()
        };
    }
    function FilterAsset() {
        return {
            EquipmentTypeID: $("#EquipmentTypeID").val()
        };
    }
    function Refresh() {
        window.location.reload();
    }

    function OnChange(e) {
        var grid = e.select;
        var selectedRows = this.select();
        var rowData = this.dataItem(selectedRows[0]);
        var Quantity = rowData.Quantity;
        var UnitPrice = rowData.Quantity;
        $("#TotalCost").val(Quantity * UnitPrice);
    }

    function sync_handler(e) {
        this.read();
    }

    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();
    }

    function copyResourcesFromEstimation(id, destId) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("CopyResourceFromEstimationToUtilization", "ResourceUtilization", new { area = "Construction" })',
            data: { id: id, destinationItemId: destId },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                //recordStatus = result.Status;
                //location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }
    function copyWorkItemsFromEstimation(id) {
        var btn = $("#CopyWorkItemsButton");
        var loadingButton = $("#fetchLoadingIcon");
        btn.attr('disabled', true);
        btn.hide();
        loadingButton.show();
        loadingButton.attr('disabled', true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("CopyWorkItemsFromEstimationToResourceUtilization", "DetailedWorkProgress", new { area = "Construction" })',
            data: { dayId: id},
            success: function (result) {
                btn.attr('disabled', false);
                btn.show();
                loadingButton.hide();
                alert(result.Message);
               
            }, //end succ
            error: function (result) {
                btn.attr('disabled', false);
                btn.show();
                loadingButton.hide();
                alert(result);
            }
        });
    }
</script>
