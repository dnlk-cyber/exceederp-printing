@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend><a href='/Construction/ResourceUtilization/' title="Back To All Projects"><i class="fa fa-chevron-circle-left fa-1.5x"></i></a> &nbsp; &nbsp; Resource Utilization / @ViewBag.Project</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ResourceUtilizationPeriod>()
                            .Name("periodsGrid")
                              .Columns(columns =>
                              {
                                  columns.ForeignKey(c => c.ConstructionPeriodId, (IEnumerable)ViewData["ConstructionPeriods"], "ConstructionPeriodId", "Name").EditorTemplateName("PeriodsForExpandedProject");
                                  columns.Bound(c => c.Description);
                                  columns.Command(command =>
                                  {
                                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                      command.Destroy().Text(Resources.ActionButton_Cancel);
                                  }).Width(200);
                              })
                                .ToolBar(toolbar =>
                                {
                                    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                })
                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                              //.Events(e => e.Change("OnChange"))
                              .Scrollable(h => h.Height(700))
                              //.Groupable()
                              .Sortable(sortable =>
                              {
                                  sortable.SortMode(GridSortMode.SingleColumn);
                              })
                              .Filterable()
                              .Selectable(selectable =>
                              {
                                  selectable.Mode(GridSelectionMode.Single);
                                  selectable.Type(GridSelectionType.Row);
                              })
                              .Pageable(pageable => pageable
                                  .Input(true)
                                  .Numeric(false)
                                  .Refresh(true)
                                  .PageSizes(true)
                                  .ButtonCount(5))
                              //.Events(e => e.Edit("onEdit"))
                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .Events(events =>
                                  {
                                      events.Error("error_handler(\"periodsGrid\")");
                                      events.RequestStart("onRequestStart(\"periodsGrid\")");
                                      events.RequestEnd("onRequestEnd(\"periodsGrid\")");
                                  })
                                  .Model(model =>
                                  {
                                      model.Id(p => p.ResourceUtilizationPeriodId);

                                  }
                                  )
                                  .Read(read => read.Action("Periods_Read", "ResourceUtilizationPeriod").Data("getIdOfOpenedProject"))
                                  .Create(create => create.Action("Period_Create", "ResourceUtilizationPeriod").Data("getIdOfOpenedProject"))
                                  .Update(update => update.Action("Period_Update", "ResourceUtilizationPeriod"))
                                  .Destroy(destroy => destroy.Action("Period_Destroy", "ResourceUtilizationPeriod"))
                                ).ClientDetailTemplateId("days-tmpl")
)

<script id="days-tmpl" type="text/kendo-tmpl">

    @(Html.Kendo().TabStrip()
          .Name("tab_#=ResourceUtilizationPeriodId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("Days").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ResourceUtilizationDay>()
                                        .Name("days__#=ResourceUtilizationPeriodId#")
                                          .Columns(columns =>
                                          {
                                              //columns.ForeignKey(c => c.ConstructionPeriodId, (IEnumerable)ViewData["ConstructionPeriods"], "ConstructionPeriodId", "Name").EditorTemplateName("Periods");
                                              columns.Bound(c => c.Name);
                                              columns.Command(command =>
                                              {
                                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                                                  command.Custom("CmdOpenDayView").Text("&nbsp;&nbsp;Expand").Click("openSpecificDayView").IconClass("fa fa-expand");

                                              }).Width(300);
                                          })
                                          //.ToolBar(toolbar =>
                                          //{
                                          //    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                          //})
                                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                                          //.Events(e => e.Change("OnChange"))
                                          .Scrollable(h => h.Height(500))
                                          //.Groupable()
                                          .Sortable(sortable =>
                                          {
                                              sortable.SortMode(GridSortMode.SingleColumn);
                                          })
                                          .Events(ev => {
                                              ev.DataBound("daysGridDataBound");
                                          })
                                          .Filterable()
                                          .Selectable(selectable =>
                                          {
                                              selectable.Mode(GridSelectionMode.Single);
                                              selectable.Type(GridSelectionType.Row);
                                          })
                                          .Pageable(pageable => pageable
                                              .Input(true)
                                              .Numeric(false)
                                              .Refresh(true)
                                              .PageSizes(true)
                                              .ButtonCount(5))
                                          //.Events(e => e.Edit("onEdit"))
                                          .DataSource(dataSource => dataSource
                                              .Ajax()
                                              .Events(events =>
                                              {
                                                  events.Error("error_handler(\"days__#=ResourceUtilizationPeriodId#\")");
                                                  events.RequestStart("onRequestStart(\"days__#=ResourceUtilizationPeriodId#\")");
                                                  events.RequestEnd("onRequestEnd(\"days__#=ResourceUtilizationPeriodId#\")");
                                              })
                                              .Model(model =>
                                              {
                                                  model.Id(p => p.ResourceUtilizationDayId);

                                              }
                                              )
                                              .Read(read => read.Action("Days_Read", "ResourceUtilizationDay", new { dayIdRead = "#=ResourceUtilizationPeriodId#" }))
                                              .Create(create => create.Action("Day_Create", "ResourceUtilizationDay", new { periodIdCreate = "#=ResourceUtilizationPeriodId#" }))
                                              .Update(update => update.Action("Day_Update", "ResourceUtilizationDay"))
                                              .Destroy(destroy => destroy.Action("Day_Destroy", "ResourceUtilizationDay"))
                                            ).ClientDetailTemplateId("detailed-workprogress-tmpl")
                                            .ToClientTemplate()
                    )
                </text>
                );

          }).ToClientTemplate())
</script>


