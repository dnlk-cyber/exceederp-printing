@using System.Collections
@using ExceedERP.Core.Domain.Construction
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Expenses</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
      .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Name).Width(350);
          columns.Bound(c => c.Code);
          //columns.Bound(c => c.Category).Width(200);
          columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branchs"], "BranchId", "Name");
          columns.Bound(c => c.ContractAmount).ClientTemplate(
                          "# if (ContractAmount === 0) { #" +
                                                      " -----" +
                                                      "# } else {#" +
                                                      "#: kendo.toString( ContractAmount, 'N2') #" +
                                                      "# } #"
                          );
          columns.Bound(c => c.Client);
      })

      .Scrollable(h => h.Height(700))
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(10))
      .DataSource(dataSource => dataSource
              .Ajax()
              .PageSize(20)
              .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")"))
              .Model(model => model.Id(p => p.ProjectInformationId))
              .Read(read => read.Action("ProjectInformation_Read", "ProjectExpenses"))
          //.Create(create => create.Action("ProjectInformation_Create", "ProjectInformation"))
          //.Update(update => update.Action("ProjectInformation_Update", "ProjectInformation"))
          //.Destroy(destroy => destroy.Action("ProjectInformation_Destroy", "ProjectInformation"))
          ).ClientDetailTemplateId("template_detail")
)
