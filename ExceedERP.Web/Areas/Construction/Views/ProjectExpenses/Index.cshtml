                                            innercolumn.Group(grp => grp.Title("Previous").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                            .Columns(innerinnercolumn =>
                                            {
                                                innerinnercolumn.Bound(x => x.CostOfConsumedMaterialPrevMonth).Width(60).Format("{0:N2}");
                                            })
