                                            innercolumn.Group(grp => grp.Title("This Month").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                            .Columns(innerinnercolumn =>
                                            {
                                                innerinnercolumn.Bound(x => x.CostOfConsumedMaterialThisMonth).Width(60).Format("{0:N2}");
                                            })
