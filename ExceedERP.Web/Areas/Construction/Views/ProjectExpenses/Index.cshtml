<script id="template_detail" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                  .Name("tabstrip__#=ProjectInformationId#")
                  .SelectedIndex(0)
                  .Items(items =>
                  {
                  items.Add().Text("Total Material Consumption").Content(
                    @<text>
                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectMaterialExpense>()
                                .Name("material_exp_#=ProjectInformationId#")
                                .Columns(columns =>
                                {
                                    columns.ForeignKey(c => c.GLPeriodId, (IEnumerable)ViewData["PeriodList"], "InventoryPeriodId", "Name").EditorTemplateName("GLPeriods").Width(100).Hidden(true);
                                    //.ClientGroupHeaderTemplate("\\#=value\\#");
                                    columns.ForeignKey(c => c.ItemCategoryCode, (IEnumerable)ViewData["ItemCategories"], "ItemCategoryCode", "Name").EditorTemplateName("ItemCategory").Width(150);
                                    columns.ForeignKey(c => c.ItemCode, (IEnumerable)ViewData["InventoryItems"], "ItemCode", "Name").EditorTemplateName("Item").Width(120);
                                    columns.Bound(c => c.Unit).Width(60);
                                    columns.Bound(c => c.UnitPrice).Width(60);
                                    columns.Group(g => g.Title("Quantity of Material").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                    .Columns(outercolumn =>
                                    {
                                        outercolumn.Group(gr => gr.Title("Previous").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                        .Columns(innercolumn =>
                                        {
                                            innercolumn.Bound(x => x.DeliveredQuantityPrevMonth).Width(70).Format("{0:N2}");
                                            innercolumn.Group(grp => grp.Title("Issued").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                            .Columns(innerinnercolumn =>
                                            {
                                                innerinnercolumn.Bound(x => x.ConsumedQuantityPrevMonth).Width(60).Format("{0:N2}");
                                                innerinnercolumn.Bound(x => x.MaterilOnSitePrevMonth).Width(60).Format("{0:N2}");

                                            })
                                           );
                                        })
                                        );
                                        outercolumn.Group(gr => gr.Title("This Month").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                        .Columns(innercolumn =>
                                        {
                                            innercolumn.Bound(x => x.DeliveredQuantity).Width(70).Format("{0:N2}");
                                            innercolumn.Bound(x => x.ConsumedQuantity).Width(60).Format("{0:N2}");
                                            innercolumn.Bound(x => x.TranIn).Width(60).Format("{0:N2}");
                                            innercolumn.Bound(x => x.TranOut).Width(60).Format("{0:N2}");
                                        })
                                        );
                                        outercolumn.Group(gr => gr.Title("To Date").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                        .Columns(innercolumn =>
                                        {
                                            innercolumn.Bound(x => x.DeliveredQuantityToDate).Width(70).Format("{0:N2}");
                                            innercolumn.Group(grp => grp.Title("Issued").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                            .Columns(innerinnercolumn =>
                                            {
                                                innerinnercolumn.Bound(x => x.ConsumedQuantityToDate).Width(60).Format("{0:N2}");
                                                innerinnercolumn.Bound(x => x.ShipedQuantityToDate).Width(60).Format("{0:N2}");
                                                innerinnercolumn.Bound(x => x.StockBalance).Width(60).Format("{0:N2}");
                                            })
                                            );
                                            innercolumn.Bound(x => x.MaterialOnSiteToDate).Width(60).Format("{0:N2}");
                                        })
                                        );
                                    })
