                                            innercolumn.Group(grp => grp.Title("To Date").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                            .Columns(innerinnercolumn =>
                                            {
                                                innerinnercolumn.Bound(x => x.CostOfConsumedMaterialToDate).Width(60).Format("{0:N2}");
                                            })
                                           );
                                        })
                                        );

                                        outercolumn.Bound(x => x.StockAmount).Width(60).Format("{0:N2}");
                                        outercolumn.Bound(x => x.MaterialOnSiteAmount).Width(60).Format("{0:N2}");
                                    })
                                    );
                                    columns.Command(command =>
                                    {
                                        command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                        //command.Destroy().Text(Resources.ActionButton_Cancel);
                                        //command.Custom("CustomCommand").Text("Detail");
                                    }).Width(100);
                                })
                                //.Events(evnt =>
                                //{
                                //    evnt.DataBound("onDataBound");
                                //})
                                .ToolBar(toolbar =>
                                {
                                    //toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                    toolbar.Custom().Name("FetchLatestConsumption").IconClass("fa fa-refresh").Text("&nbsp;&nbsp;Fetch Latest Consumption").Url(Url.Action("PrepareProjectMaterialExpense", "ProjectExpenses", new { area = "Constrution" }));

                                })
                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .Selectable(selectable =>
                                {
                                    selectable.Mode(GridSelectionMode.Single);
                                    selectable.Type(GridSelectionType.Row);
                                })
                                .Scrollable(h => h.Height(500))
                                //.Groupable()
                                //.Events(ev => {
                                //    ev.DataBound("dataBound");
                                //})
                                .Sortable(sortable =>
                                {
                                    sortable.SortMode(GridSortMode.SingleColumn);
                                })
                                //.Filterable()
                                .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Group(group =>
                                    {
                                        group.Add(f => f.GLPeriodId);
                                    })
                                    .Events(events =>
                                    {
                                        events.Error("error_handler(\"material_exp_#=ProjectInformationId#\")");
                                        events.RequestStart("onRequestStart(\"material_exp_#=ProjectInformationId#\")");
                                        events.RequestEnd("onRequestEnd(\"material_exp_#=ProjectInformationId#\")");
                                    })
                                    .Model(model =>
                                    {
                                        model.Id(f => f.ProjectMaterialExpenseId);

                                        model.Field(f => f.Unit).Editable(false);
                                        model.Field(f => f.UnitPrice).Editable(false);
                                        model.Field(f => f.DeliveredQuantity).Editable(false);
                                        model.Field(f => f.ConsumedQuantity).Editable(false);
                                        model.Field(f => f.DeliveredQuantityPrevMonth).Editable(false);
                                        model.Field(f => f.ConsumedQuantityPrevMonth).Editable(false);
                                        model.Field(f => f.DeliveredQuantityToDate).Editable(false);
                                        model.Field(f => f.ConsumedQuantityToDate).Editable(false);
                                        model.Field(f => f.StockBalance).Editable(false);
                                        model.Field(f => f.CostOfConsumedMaterialPrevMonth).Editable(false);
                                        model.Field(f => f.CostOfConsumedMaterialThisMonth).Editable(false);
                                        model.Field(f => f.CostOfConsumedMaterialToDate).Editable(false);
                                        model.Field(f => f.StockAmount).Editable(false);
                                        model.Field(f => f.MaterialOnSiteAmount).Editable(false);

                                    })

                                    .Read(read => read.Action("MaterialExpense_Read", "ProjectMaterialExpense", new { branchId = "#=BranchId#" }))
                                    .Create(create => create.Action("MaterialExpense_Create", "ProjectMaterialExpense", new { projectIdCreate = "#=BranchId#" }))
                                    .Update(update => update.Action("MaterialExpense_Update", "ProjectMaterialExpense"))
                                    .Destroy(destroy => destroy.Action("MaterialExpense_Destroy", "ProjectMaterialExpense"))
                                    )//.ClientDetailTemplateId("schedule_charts")
                                    .ToClientTemplate()
                        )
                    </text>
                  );

