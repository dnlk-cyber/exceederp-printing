@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        .DataTextField("Name")
        .DataValueField("GLPeriodId")
         //.BindTo((IEnumerable)ViewData["GLPeriods"])
         .DataSource(dataSource =>
         {
             dataSource.Read(read => read.Action("GetInventoryPeriods", "DataProvider"));
         })
        .ValuePrimitive(true)
        .Filter("contains")
        .MinLength(2)

)