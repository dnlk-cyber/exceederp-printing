
@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Setting | Variation Order Types</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.VariationOrderType>()
                          .Name("crewGrid")
                          .Columns(columns =>
                          {
                              //columns.Bound(c => c.ProjectCrewId).Title("Id");
                              columns.Bound(c => c.Name);
                              columns.Bound(c => c.Type);
                              columns.Bound(c => c.Description);
                              

                              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Resources").Window(window => { window.Title("Resource"); window.Scrollable(false); }))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                        .Scrollable(h => h.Height(500))
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                        .Filterable()
                        .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Model(model => model.Id(res => res.VariationOrderTypeId))
                              .Read(read => read.Action("VariationOrderType_Read", "VariationOrderType"))
                              .Create(create => create.Action("VariationOrderType_Create", "VariationOrderType"))
                              .Update(update => update.Action("VariationOrderType_Update", "VariationOrderType"))
                              .Destroy(destroy => destroy.Action("VariationOrderType_Destroy", "VariationOrderType"))
                          )
)