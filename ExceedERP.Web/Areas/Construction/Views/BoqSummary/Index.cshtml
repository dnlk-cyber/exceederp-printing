@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>SUMMARY OF BILL OF QUANTITIES</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectEstmnBoqSummary>()
        .Name("ProjectEstmnBoqSummary")
        .Columns(columns =>
        {
            columns.Bound(c => c.SubProjectTypeName).Hidden(true).ClientGroupHeaderTemplate("#= value # (Total : #= kendo.toString(aggregates.TotalPrice.sum, 'N2')# birr)");
            columns.Bound(c => c.StructureyType).Hidden(true).ClientGroupHeaderTemplate("#= value # (Sub Total : #= kendo.toString(aggregates.TotalPrice.sum, 'N2')# birr)");
            columns.Bound(c => c.WorkCategory).Width(160).Format("{0:N2}");
            columns.Bound(c => c.TotalPrice).Width(170).Format("{0:N2}")
            .ClientFooterTemplate(" <div> Grand Total: #= kendo.toString(sum, 'N2')# Birr<hr></div><div>Grand Total With VAT : #= doVatCalculation()# </div>");

            //.ClientGroupFooterTemplate("Sub-total : #=sum#");
            columns.Bound(c => c.Remark).Width(120);
            columns.Command(command =>
            {
                command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                command.Destroy().Text(Resources.ActionButton_Cancel);
            }).Width(200);
        })
        .ToolBar(toolbar =>
        {
            toolbar.Template(
                @<text>
                    <div class="toolbar">
                        <label class="category-label" for="ProjectInformationId">Project:</label>
                        @(Html.Kendo().ComboBox()
                                    .Name("ProjectInformationId")
                                    .Placeholder("Project")
                                    .DataTextField("Name")
                                    //.BindTo((IEnumerable)ViewData["Projects"])
                                    .DataSource(source =>
                                    {
                                        source.Read(read =>
                                        {
                                            read.Action("GetAllProjects", "DataProvider");
                                        })
                                        .ServerFiltering(false);
                                    })
                                    .DataValueField("ProjectInformationId")
                                    .AutoBind(false)
                                    .Events(e => e.Change("ProjectListChanged"))
                                    .HtmlAttributes(new { style = "width: 200px;" })

                        )

                        <label class="category-label" for="SubProjectTypeId">&nbsp; Sub-project/type:</label>

                        @(Html.Kendo().ComboBox()
                                .Name("SubProjectTypeId")
                                .Text("types ..")
                                //.BindTo((IEnumerable)ViewData["Blocks"])
                                .DataSource(d =>
                                {
                                    d.Read(r =>
                                    {
                                        r.Action(
                                            "GetSubProjectTypes", "DataProvider")
                                            .Data("getSelectedProjectId");
                                    })
                                    .ServerFiltering(true);
                                })
                                .Filter("contains")
                                .DataTextField("Name")
                                .DataValueField("SubProjectTypeId")
                                .HtmlAttributes(new { style = "width: 200px;" })
                                .ValuePrimitive(true)
                                .CascadeFrom("ProjectInformationId")
                                .AutoBind(false)
                                .Enable(false)
                                .Events(x => x.Change("subProjectTypeListChanged"))
                        )
                        &nbsp;
                        @(Html.Kendo().Button()
                            .Name("btnSummary")
                            .HtmlAttributes(new { type = "button", @class = "k-primary" })
                            .Events(e => e.Click("Summary"))
                            .Content("Generate Summary"))
                    </div>
                </text>);
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
        })
                    .Editable(editable => editable.Mode(GridEditMode.InLine))
                    .Scrollable(h => h.Height(700))
                    .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                    .Sortable(sortable =>
                    {
                        sortable.SortMode(GridSortMode.SingleColumn);
                    })
                    .Filterable()
                    .Selectable(selectable =>
                        {
                            selectable.Mode(GridSelectionMode.Single);
                            selectable.Type(GridSelectionType.Row);
                        })
                    
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .PageSize(50)
                        .Events(events => events.Error("error_handler(\"ProjectEstmnBoqSummary\")")
                        .Sync("sync_handler"))
                        .Group(groups =>
                        {
                            groups.Add(p => p.SubProjectTypeName);
                            groups.Add(p => p.StructureyType);
                            //groups.Add(p => p.Category);
                        })
                        .Aggregates(agr =>
                        {
                            agr.Add(bqs => bqs.TotalPrice).Sum();
                        })
                        .Model(model => model.Id(p => p.ProjectEstmnBoqSummaryId))
                        .Read(read => read.Action("ProjectEstmnBoqSummary_Read", "BOQSummary"))
                        .Create(create => create.Action("ProjectEstmnBoqSummary_Create", "BOQSummary"))
                        .Update(update => update.Action("ProjectEstmnBoqSummary_Update", "BOQSummary"))
                        .Destroy(destroy => destroy.Action("ProjectEstmnBoqSummary_Destroy", "BOQSummary"))
                    )
)
<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

    function sync_handler(e) {
        this.read();
    }
    function doVatCalculation() {
        var ds = $("#ProjectEstmnBoqSummary").data("kendoGrid").dataSource;
        var aggregates = ds.aggregates();
        var totalAmount = (aggregates.TotalPrice.sum) + (aggregates.TotalPrice.sum * 0.15);
        Math.round(totalAmount, 2);
        //...
        return kendo.toString (totalAmount, 'N2') + " Birr";
    }
</script>
<script>
    function ProjectListChanged(e) {

        var value = this.value(),
            grid = $("#ProjectEstmnBoqSummary").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "ProjectInformationId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
    function getSelectedProjectId() {
        return {
            projectId: $("#ProjectInformationId").val()
        };
    }
    function subProjectTypeListChanged() {

        var value = this.value(),
            grid = $("#ProjectEstmnBoqSummary").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "SubProjectTypeId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>



