@using ExceedERP.Core.Localization
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Project Budget Definition</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
          .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Name).Width( 300);
        columns.Bound(c => c.Code).Width( 150);
        columns.Bound(c => c.Category).Width( 200);
        columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").EditorTemplateName("Branch").Width(150);
        columns.Bound(c => c.ContractAmount).Width( 150);
      
    
        columns.Bound(c => c.Client).Width( 150);
      
        //columns.Command(command =>
        //{
        //    //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); 
        //   //command.Destroy().Text(Resources.ActionButton_Cancel);
        //}).Width(180);
      })
      .ToolBar(toolbar => {
           // toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
                  .Editable(editable => editable.Mode(GridEditMode.InLine ))
          .Scrollable(h => h.Height(500))
                             .Groupable()
                                      .Sortable(sortable =>
                                      {
                                          sortable.SortMode(GridSortMode.SingleColumn);
                                      })
                          .Filterable()
                             .Pageable(pageable => pageable
                                                        .Input(true)
                                                        .Numeric(false)
                                                        .Refresh(true)
                                                        .PageSizes(true)
                                                        .ButtonCount(5))
      .DataSource(dataSource => dataSource
               .Ajax()
                           .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")"))
                              //.Sync("sync_handler"))
          .Model(model => model.Id(p => p.ProjectInformationId))
                  .Read(read => read.Action("ProjectInformation_Read", "ProjectBudgetDefination"))
          .Create(create => create.Action("ProjectInformation_Create", "ProjectInformation"))
          .Update(update => update.Action("ProjectInformation_Update", "ProjectInformation"))
          .Destroy(destroy => destroy.Action("ProjectInformation_Destroy", "ProjectInformation"))
          ).ClientDetailTemplateId("template")
      )

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                  .Name("tabstrip_#=ProjectInformationId#")
          .SelectedIndex(0)
          .Items(items =>
          {

              items.Add().Text("Project Budget").Content(
                @<text>

                   
    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectDefineBudget>()
                  .Name("ProjectDefineBudget_#=ProjectInformationId#")
      .Columns(columns =>
      {
          
          columns.Bound(c => c.BudgetCode);
          columns.Bound(c => c.TotalBudget);
          columns.Bound(c => c.EstimatedAmount);
          columns.Bound(c => c.Description);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
          .Scrollable(h => h.Height(500))
                                     
      .DataSource(dataSource => dataSource
          .Ajax()
                                                         .Events(events => events.Error("error_handler(\"ProjectDefineBudget_#=ProjectInformationId#\")"))
                                     // .Sync("sync_handler"))
          .Model(model => model.Id(p => p.ProjectDefineBudgetId))
                  .Read(read => read.Action("ProjectDefineBudgets_Read", "ProjectBudgetDefination", new { idOne = "#=ProjectInformationId#" }))
                  .Create(create => create.Action("ProjectDefineBudgets_Create", "ProjectBudgetDefination", new { idTwo = "#=ProjectInformationId#" }))
          .Update(update => update.Action("ProjectDefineBudgets_Update", "ProjectBudgetDefination"))
          .Destroy(destroy => destroy.Action("ProjectDefineBudgets_Destroy", "ProjectBudgetDefination"))
      ).ToClientTemplate()
    )
                </text>
    );
              
          }).ToClientTemplate())
</script>

<script>
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function(key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function() {
                        message += this + "\n";
                    });
                }
            });
            alert(message);

        }

    }

    function sync_handler(e) {
        this.read();

    }

    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }

    function onChange(e) {
        var grid = e.sender;
        var selectedRows = this.select();
        var rowData = this.dataItem(selectedRows[0]);
        var id = rowData.AttachmentID;
        $.ajax({
            url: '@Url.Action("Download", "ProjectInformation")',
            contentType: "application/json; charset=utf-8",
            data: { 'id': id },
            type: 'GET',
            cache: false,
            success: function(result) {
                r = result;
            }

        });
    }

</script>

<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>