@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
.OptionLabel( Resources.Select)
                         .DataTextField("Name")
                                    .DataValueField("AssetNumber")
                                   .BindTo((IEnumerable)ViewData["Equipment"])
                                   .Filter("contains")
          .MinLength(2)
                         .ValuePrimitive(true)
)