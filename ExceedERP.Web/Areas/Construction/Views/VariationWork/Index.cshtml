<script>
    var currentSelectedProject = 0;
    function sync_handler(e) {
        this.read();
    }
    //$(document).ready(function () {
    //    var btn = ("#loadingButton");
    //    btn.hide();
    //});
    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }
    function syncEstimationData(id) {
        var recordStatus = "";

        var btn = $("#syncButton");
        btn.hide();
        var bt = $("#loadingButton");
        bt.show();
        $.ajax({
            type: "POST",
            url: '@Url.Action("SyncVariationAndSupplementaryWorksToAllBlocks", "ProjectEstimationSplit", new { area = "Construction" })',
            data: { projectId: id },
            cache: false,
            success: function (result) {
                // toastr.warnning(result.Message);
                bt.hide();
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                bt.hide();
                alert(result);
            }
        });
    }
    function filterCategories() {
        //
        // summary:
        //      send the filtering text along with the parent widget's value
        var dropdownlist = $("#ItemCode").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            ItemCategoryCode: $("#ItemCategoryCode").val(), filterString: filterInput.val()
        };
    }
    function filterType() {
        return {
            EquipmentIdentityID: $("#EquipmentIdentityID").val()
        };
    }
    function FilterAsset() {
        return {
            EquipmentTypeID: $("#EquipmentTypeID").val()
        };
    }
    function Refresh() {
        window.location.reload();
    }

    function onStructureTypeMapping(e) {
        var strTypeDropDownList = $("#structureTypesDropdownList").data("kendoDropDownList");
        var selectedValue = $("#structureTypesDropdownList").val();
        alert(selectedValue);
    }

</script>

<script>
    function OnChange(e) {
        var grid = e.select;
        var selectedRows = this.select();
        var rowData = this.dataItem(selectedRows[0]);
        var Quantity = rowData.Quantity;
        var UnitPrice = rowData.Quantity;
        $("#TotalCost").val(Quantity * UnitPrice);
    }
</script>

<script type="text/javascript">

    var str = 0;
    //var blMapping = 0;
    var subProjTypeMapping = 0;

    function collapseViewClicked(e) {
        e.preventDefault();
        window.location.href = "@Url.Action("Index", "ProjectEstimation")";
    }
    function materialChanged(e) {
        var itmCode = $('#ItemCode').val();
        $.ajax({
            url: '@Url.Action("GetUnitPrice", "ProjectMaterial", new {area = "Construction"})',
            data: { itemCode: itmCode },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#UnitPrice").val(result);
                $("#UnitPrice").trigger("change");
            }

        });
    }
    function laborDropDownListChanged(e) {
        var jobTitleId = $('#ProjectEstimationIndexLabourId').val();
        $.ajax({
            url: '@Url.Action("GetIndexedHourlyPayPerJobTitle", "ProjectDirectLabour", new {area = "Construction"})',
            data: { id: jobTitleId },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#IndexedHourlySalary").val(result);
                $("#IndexedHourlySalary").trigger("change");
            }

        });
    }
    function equipmentDropDownList(e) {
        var fleetId = $('#FleetsID').val();
        $.ajax({
            url: '@Url.Action("GetRentalRate", "ProjectEquipment", new {area = "Construction"})',
            data: { id: fleetId },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#RentalCost").val(result);
                $("#RentalCost").trigger("change");
            }

        });
    }
    function grid_error(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
            //var grid = $("#fuelCostGrid").data("kendoGrid");
            this.cancelChanges();
        }
    }
    function projectsGridDataBound(e) {
        $(".k-grid-CmdOpenProjectView").find("span").addClass("fa fa-expand ");
    }

    function CopyWorkItems(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));

        str = dataItem.ConfigurationId;
        subProjTypeMapping = dataItem.SubProjectStructureTypeMappingId;

        var editorGrid = $("#workItemsPopUpGrid").data("kendoGrid");
        var wdw = $("#CopyTemplateWorkItemsWindow").data("kendoWindow");
        wdw.open();
        wdw.center();
        editorGrid.dataSource.read();
    }
    function openSpecificProjectView(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.ProjectInformationId;
        currentSelectedProject = id;
        @*window.location.href = "@Url.Action("Project", "ProjectEstimation", new { area = "Construction", p = id })";*@
        window.location.href = "/Construction/ProjectEstimationDetail/Project?p=" + id;
    }
    //function getIdOfOpenedProject() {
    //    return {
    //        currentProjectId: projectId
    //    };
    //}
    function getCurrentStructureData() {

        return {
            strId: str,
            subProjTypeMappingId: subProjTypeMapping
        };
    }
    function closeImportWorkItemEditor() {
        var wdw = $("#CopyTemplateWorkItemsWindow").data("kendoWindow");
        wdw.close();
    }
    function CopyCurrentWorkItem(e) {
        var grid = $("#workItemsPopUpGrid").data("kendoGrid");

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.Id;
        $.ajax({
            url: '@Url.Action("CopyCurrentTemplateWorkItem", "VariationWork", new { area = "Construction" })',
            //contentType: "application/json; charset=utf-8",
            data: { workItemId: id, subProjTypeMappingId: subProjTypeMapping },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                grid.dataSource.read();
            }

        });
    }
    function structureTypeDataBound() {
        $(".k-grid-CmdCopyWorkItem").find("span").addClass("k-icon k-i-plus");

    }
    function CopyWorkItemDataBound() {
        $(".k-grid-CustomCmdSelect").find("span").addClass("k-icon k-i-plus");


        var grid = this;
        var gridRows = grid.tbody.find("tr");

        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            if (dataItem.IsCopied === true) {
                row.find(".k-grid-CustomCmdSelect").hide();
                row.addClass("highlighted-row");
            } else if (dataItem.IsCopiedAsVariationWork === true) {
                row.find(".k-grid-CustomCmdSelect").hide();
                row.addClass("variation-work-row");
            } else if (dataItem.IsCopiedAsSupplementaryWork) {
                row.find(".k-grid-CustomCmdSelect").hide();
                row.addClass("supplemetary-work-row");
            }
            else {

                row.find(".k-grid-CustomCmdSelect").show();
            }
        }
    }
</script>

