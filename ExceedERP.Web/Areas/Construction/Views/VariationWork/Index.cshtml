@(Html.Kendo().Window()
    .Name("CopyTemplateWorkItemsWindow")
    .Title("Copy Work Items")
    .Content(@<text>
        @*<div style="height: 100%;">*@
        <div style="overflow: auto; height: calc(100% - 55px)">
            @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.CopyTemplateWorkItemViewModel>()
        .Name("workItemsPopUpGrid")
        .Columns(column =>
        {
            column.Bound(c => c.IsCopied).Width(10).Filterable(false).Title(" ").ClientTemplate(
            "<input type='checkbox' value='#= Id #' " +
                "# if (IsCopied || IsCopiedAsVariationWork || IsCopiedAsSupplementaryWork) { #" +
                    "checked='checked'" +
                "# } #" +
            "/>"
            );
            //column.Bound(c => c.Id);
            column.Bound(c => c.Category).Width(80).Title(" ");
            column.Bound(c => c.ItemName).Width(200);
            column.Bound(c => c.TotalQuantityOfWork).Width(90).Title("Qty of Work").ClientTemplate(
                "#=kendo.toString(TotalQuantityOfWork, 'N2') # #= UnitOfMeasurement === null ? ' ' : UnitOfMeasurement#"
                );
            column.Bound(c => c.TotalUnitRate).Width(100).Title("Unit Rate").Format("{0:N4}");
            column.Command(command =>
            {
                command.Custom("CustomCmdSelect").Text("&nbsp;&nbsp;Add").Click("CopyCurrentWorkItem").IconClass("fa fa-plus");
            }).Width(100);
        })
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        .Filterable()
            .Events(ev =>
            {
                ev.DataBound("CopyWorkItemDataBound");
            })
            .Editable(editable => editable.Mode(GridEditMode.InLine))
            .DataSource(dataSource => dataSource
                .Ajax()
                .Model(model =>
                {
                    model.Id(p => p.Id);
                    //model.Field(p => p.IsSelected);
                })
                //.Read(read => read.Action("ReadPredecessors", "Scheduler"))
                .Read(read =>
                {
                    read.Action("TemplateWorkItemToCopyToVariation_Read", "ProjectEstimationWorkItem")
                    .Data("getCurrentStructureData");
                })

            )
            )

        </div>
        <div style="width: 100%; height: 40px; border-top: solid #C5C5C5 1px">
            <div style="float: right; margin: 10px">
                @*<a class="k-primary k-button k-gantt-update" href="#" onclick="saveDependencyChanges()">Save</a>*@
                <a class="k-primary k-button k-gantt-cancel" href="#" onclick="closeImportWorkItemEditor()">Close</a>
            </div>
        </div>

    </text>)
    .Draggable()
    .Resizable()
    .Width(800)
    .Height(350)
    .Modal(true)
    .Visible(false)
)


