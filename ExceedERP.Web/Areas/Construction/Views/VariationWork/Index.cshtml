<script id="template_workitem" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_wi_#=SubProjectStructureTypeMappingId#")
        .SelectedIndex(0)
        .Items(items =>
        {

            items.Add().Text("Varation Works").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.GenericWorkItemPerProject>()
                          .Name("variation_#=SubProjectStructureTypeMappingId#")
                          .Columns(columns =>
                          {
                              columns.ForeignKey(c => c.WorkCategoryId, (IEnumerable)ViewData["Categories"], "WorkCategoryId", "Name").EditorTemplateName("Category").Width(120);
                              //columns.ForeignKey(c => c.ProjectEstimationWorkItemId, (IEnumerable)ViewData["WorkItems"], "ProjectEstimationWorkItemId", "ItemName").EditorTemplateName("WorkItems").Width(150);
                              columns.Bound(c => c.ItemName).Width(150);
                              columns.ForeignKey(c => c.UnitOfMeasurementId, (IEnumerable)ViewData["uom"], "UnitOfMeasurementId", "Abbreviation").EditorTemplateName("Unit").Width(75);
                              columns.Bound(c => c.TotalQuantityOfWork).Width(100).ClientTemplate(
                                        "\\# if (IsSubCategory) { \\#" +
                                            " -----" +
                                            "\\# } else {\\#" +
                                            "\\#: kendo.toString( TotalQuantityOfWork, 'N4') \\#" +
                                            "\\# } \\#"
                                        );
                              columns.Bound(c => c.LabourHourlyOutPut).Width(100).ClientTemplate(
                                   "\\# if (IsSubCategory) { \\#" +
                                          " -----" +
                                          "\\# } else {\\#" +
                                          "\\#: kendo.toString( LabourHourlyOutPut, 'N2') \\#" +
                                          "\\# } \\#"
                                      );

                              columns.Bound(c => c.TotalUnitCost).Width(100).ClientTemplate(
                                  "\\# if (IsSubCategory) { \\#" +
                                          " -----" +
                                          "\\# } else {\\#" +
                                          "\\#: kendo.toString( TotalUnitCost, 'N4') \\#" +
                                          "\\# } \\#"
                                      );
                              columns.Bound(c => c.ItemCode).Width(100);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(200);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Scrollable(h => h.Height(550))
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Sort(srt =>
                              {
                                  srt.Add(f => f.ItemCode);
                              })
                              .Events(events =>
                              {
                                  events.Error("error_handler(\"variation_#=SubProjectStructureTypeMappingId#\")");
                                  events.RequestStart("onRequestStart(\"variation_#=SubProjectStructureTypeMappingId#\")");
                                  events.RequestEnd("onRequestEnd(\"variation_#=SubProjectStructureTypeMappingId#\")");

                              })
                              .Model(model =>
                              {
                                  model.Id(p => p.GenericWorkItemPerProjectId);
                                  model.Field(p => p.TotalUnitCost).Editable(false);
                                  model.Field(p => p.LabourHourlyOutPut).Editable(false);
                                  model.Field(p => p.ProfitMargin).Editable(false);
                                  model.Field(p => p.OverheadRate).Editable(false);
                                  model.Field(p => p.WorkCategoryId).Editable(false);
                                  model.Field(p => p.UnitOfMeasurementId).Editable(false);
                              }
                              )
                              .Read(read => read.Action("VariationGenericWorkItemPerStructure", "GenericWorkItemPerProject", new { strId = "#=ConfigurationId#", subProjectMappingId = "#=SubProjectStructureTypeMappingId#" }))
                            //.Create(create => create.Action("WorkItemPerProject_Create", "GenericWorkItemPerProject", new { idTwo2 = "#=ConfigurationId#" }))
                            .Update(update => update.Action("GenericWorkItemPerProject_Update", "GenericWorkItemPerProject"))
                            .Destroy(destroy => destroy.Action("GenericWorkItemPerProject_Destroy", "GenericWorkItemPerProject"))
                            ).ClientDetailTemplateId("variation-workItem_detail")
                            .ToClientTemplate()
                    )
                </text>
            );

            items.Add().Text("Existing Work Items").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.GenericWorkItemPerProject>()
                          .Name("WorkItemPerProject_#=SubProjectStructureTypeMappingId#")
                          .Columns(columns =>
                          {
                              columns.ForeignKey(c => c.WorkCategoryId, (IEnumerable)ViewData["Categories"], "WorkCategoryId", "Name").EditorTemplateName("Category").Width(120);
                              //columns.ForeignKey(c => c.ProjectEstimationWorkItemId, (IEnumerable)ViewData["WorkItems"], "ProjectEstimationWorkItemId", "ItemName").EditorTemplateName("WorkItems").Width(150);
                              columns.Bound(c => c.ItemName).Width(150);
                              columns.ForeignKey(c => c.UnitOfMeasurementId, (IEnumerable)ViewData["uom"], "UnitOfMeasurementId", "Abbreviation").EditorTemplateName("Unit").Width(75);
                              columns.Bound(c => c.TotalQuantityOfWork).Width(100).ClientTemplate(
                                        "\\# if (IsSubCategory) { \\#" +
