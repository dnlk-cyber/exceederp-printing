@using ExceedERP.Core.Domain.Construction
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Kendo.Mvc.UI
<legend>Setting | Construction Periods</legend>
@(Html.Kendo().Grid<ConstructionPeriod>()
      .Name("grid")
      .Columns(columns =>
      {
          //columns.Bound(c => c.ConstructionPeriodId).Hidden();
          columns.Bound(c => c.Name);
          columns.Bound(c => c.DateFrom);
          columns.Bound(c => c.DateTo);
          columns.Bound(c => c.Status).EditorTemplateName("PeriodStatus");
          
          columns.Command(command =>
          {
              //command.Edit();
              command.Custom("Close").Click("ClosePeriods");
              command.Custom("Open").Click("OpenPeriod");
          }).Width(180);
      })
      //.ToolBar(toolbar =>
      //               {
      //                   toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      //               })
      .HtmlAttributes(new { style = "height: 700px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(10))
      .Selectable()
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      //.Groupable()
       .Events(events => events.DataBound("dataBound"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .PageSize(20)
          .Model(
              model =>
              {
                  model.Id(p => p.ConstructionPeriodId);
                  model.Field(p => p.Status).Editable(false);
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);

              })
              .Events(ev => ev
                                .Error("error_handler(\"grid\")")
                                .RequestStart("onRequestStart(\"grid\")")
                                .RequestEnd("onRequestEnd(\"grid\")"))

            .Read(read => read.Action("ConstructionPeriods_Read", "ConstructionPeriod"))
            .Create(create => create.Action("ConstructionPeriod_Create", "ConstructionPeriod"))
            .Update(read => read.Action("ConstructionPeriods_Read", "ConstructionPeriod"))
            .Destroy(read => read.Action("ConstructionPeriods_Read", "ConstructionPeriod"))

      ).ClientDetailTemplateId("template_detail")
)

<script id="template_detail" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_str_#=ConstructionPeriodId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Sub-Periods/Time Ranges").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ConstructionSubPeriod>()
                            .Name("subPeriods__#=ConstructionPeriodId#")
                            .Columns(columns =>
                            {
                                columns.Bound(c => c.Name);
                                columns.Bound(c => c.DateFrom);
                                columns.Bound(c => c.DateTo);

                                columns.Command(command =>
                                {
                                    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                    command.Destroy().Text(Resources.ActionButton_Cancel);
                                }).Width(180);
                            })
                            .ToolBar(toolbar =>
                            {
                                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                            })
                            .Editable(editable => editable.Mode(GridEditMode.InLine))
                            .Scrollable(h => h.Height("auto"))
                            .Sortable(sortable =>
                            {
                                sortable.SortMode(GridSortMode.SingleColumn);
                            })
                            //.Groupable()
                            .Selectable(selectable =>
                            {
                                selectable.Mode(GridSelectionMode.Single);
                                selectable.Type(GridSelectionType.Row);
                            })
                            .Filterable()
                            .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
                            //.Events(e => e.DataBound("structureTypeDataBound"))
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Events(events =>
                                {
                                    events.Error("error_handler(\"subPeriods__#=ConstructionPeriodId#\")");
                                    events.RequestStart("onRequestStart(\"subPeriods__#=ConstructionPeriodId#\")");
                                    events.RequestEnd("onRequestEnd(\"subPeriods__#=ConstructionPeriodId#\")");
                                })
                                .Model(model =>
                                {
                                    model.Id(p => p.ConstructionSubPeriodId);
                                })
                                .Read(read => read.Action("SubPeriods_Read", "ConstructionSubPeriod", new { id = "#=ConstructionPeriodId#" }))
                                .Create(create => create.Action("SubPeriod_Create", "ConstructionSubPeriod", new { id = "#=ConstructionPeriodId#" }))
                                .Update(update => update.Action("SubPeriod_Update", "ConstructionSubPeriod"))
                                .Destroy(destroy => destroy.Action("SubPeriod_Destroy", "ConstructionSubPeriod"))

                                ).ToClientTemplate()
                    )
                </text>
            );

            
        }).ToClientTemplate())
</script>

<script>


    function ClosePeriods(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.ConstructionPeriodId;
        var grd = $('#grid').data('kendoGrid');
        @*$.ajax({
            type: "GET",
            data: id,
            url: '@Url.Action("ClosePeriod", "ConstructionPeriod")/' + id
        });*@
        $.ajax({
                url: '@Url.Action("ClosePeriod", "ConstructionPeriod", new { area = "Construction" })',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    grd.dataSource.read();
                }
            });
        //grd.dataSource.read();
        //$('#grid').data('kendoGrid').refresh();
        //location.reload();
    };

    function OpenPeriod(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.ConstructionPeriodId;
        var grd = $('#grid').data('kendoGrid');
        grd.dataSource.read();
        $.ajax({
                url: '@Url.Action("OpenPeriod", "ConstructionPeriod", new { area = "Construction" })',
                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    grd.dataSource.read();
                }
            });
    };
</script>

