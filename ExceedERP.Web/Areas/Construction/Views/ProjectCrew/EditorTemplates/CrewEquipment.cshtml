@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
                    .OptionLabel(Resources.Select)
                    .DataTextField("Name")
                    .DataValueField("Name")
                    .BindTo((IEnumerable)ViewData["Equipments"])
                    .ValuePrimitive(true)
                    .Filter("contains")
                    .MinLength(2)

)