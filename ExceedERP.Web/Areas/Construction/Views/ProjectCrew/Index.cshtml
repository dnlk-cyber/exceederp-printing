
@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Crew Setting</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectCrew>()
                          .Name("crewGrid")
                          .Columns(columns =>
                          {
                              //columns.Bound(c => c.ProjectCrewId).Title("Id");
                              columns.Bound(c => c.CrewCode).Title("Code");
                              columns.Bound(c => c.CrewLeader).Title("Leader");
                              columns.ForeignKey(c => c.WorkCategoryId, (IEnumerable)ViewData["WorkTypes"], "WorkCategoryId", "Name").EditorTemplateName("CrewWorkCategories").Width(150).Title("Work Type");
                              columns.Bound(c => c.AmountofWorkDone).Title("Productivity per Day");
                              columns.Bound(c => c.TotalCrewCost).Title("Total Cost");

                              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Resources").Window(window => { window.Title("Resource"); window.Scrollable(false); }))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                        .Scrollable(h => h.Height(500))
                        .Groupable()
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                        .Filterable()
                        .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Model(model => model.Id(res => res.ProjectCrewId))
                              .Read(read => read.Action("ProjectCrew_Read", "ProjectCrew"))
                              .Create(create => create.Action("ProjectCrew_Create", "ProjectCrew"))
                              .Update(update => update.Action("ProjectCrew_Update", "ProjectCrew"))
                              .Destroy(destroy => destroy.Action("ProjectCrew_Destroy", "ProjectCrew"))
                          )
                          .ClientDetailTemplateId("crew_combination")
)


<script id="crew_combination" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("hr_tabstrip")
        .SelectedIndex(0)
        .Items(items => {
            items.Add().Text("Human Resource").Content(
                    @<text>
                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.CrewHumanResource>()
                          .Name("hr_#=ProjectCrewId#")
                          .Columns(columns =>
                          {
                              //columns.Bound(c => c.CrewHumanResourceId).Title("Id");
                              //columns.Bound(c => c.Name).Title("Name");
                              columns.Bound(c => c.JobTitle).Title("Job").Width(200).EditorTemplateName("CrewJobs");
                              columns.Bound(c => c.Quantity).Title("Quantity").Width(200);
                              //columns.Bound(c => c.AmountofWorkDone).Title("Amount of Work");
                              //columns.Bound(c => c.TotalCrewCost).Title("Total Cost");

                              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                        //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Resources").Window(window => { window.Title("Resource"); window.Scrollable(false); }))
                        //.Selectable(selectable =>
                        //{
                        //    selectable.Mode(GridSelectionMode.Single);
                        //    selectable.Type(GridSelectionType.Row);
                        //})
                        .Scrollable(h => h.Height(500))
                        .Groupable()
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                        .Filterable()
                        .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Model(model => model.Id(res => res.CrewHumanResourceId))
                              .Read(read => read.Action("CrewHumanResource_Read", "CrewHumanResource"))
                              .Create(create => create.Action("CrewHumanResource_Create", "CrewHumanResource", new { crewId = "#=ProjectCrewId#" }))
                              .Update(update => update.Action("CrewHumanResource_Update", "CrewHumanResource"))
                              .Destroy(destroy => destroy.Action("CrewHumanResource_Destroy", "CrewHumanResource"))
                          ).ToClientTemplate()
                        )

                    </text>
                );
           
            items.Add().Text("Equipment").Content(
                    @<text>
                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.CrewEquipment>()
                          .Name("equipment_#=ProjectCrewId#")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Name).Title("Equipment").Width(200).EditorTemplateName("CrewEquipment");
                              columns.Bound(c => c.Quantity).Title("Quantity").Width(200);
                              

                              columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                        //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Resources").Window(window => { window.Title("Resource"); window.Scrollable(false); }))
                        //.Selectable(selectable =>
                        //{
                        //    selectable.Mode(GridSelectionMode.Single);
                        //    selectable.Type(GridSelectionType.Row);
                        //})
                        .Scrollable(h => h.Height(500))
                        .Groupable()
                        .Sortable(sortable =>
                        {
                            sortable.SortMode(GridSortMode.SingleColumn);
                        })
                        .Filterable()
                        .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Model(model => model.Id(res => res.CrewEquipmentId))
                              .Read(read => read.Action("CrewEquipment_Read", "CrewEquipment"))
                              .Create(create => create.Action("CrewEquipment_Create", "CrewEquipment", new { cId = "#=ProjectCrewId#" }))
                              .Update(update => update.Action("CrewEquipment_Update", "CrewEquipment"))
                              .Destroy(destroy => destroy.Action("CrewEquipment_Destroy", "CrewEquipment"))
                          ).ToClientTemplate()
                        )
                    </text>
                );
        items.Add().Text("Materials").Content(
            @<text>

            </text>
                );
        })
        .ToClientTemplate()
)
</script>




