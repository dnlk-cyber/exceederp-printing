@using ExceedERP.Core.Localization
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Take Off Sheet</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
      .Name("ProjectInformationgrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Name).Width(350);
          columns.Bound(c => c.ProjectType).ClientGroupHeaderTemplate(
            "# if (value === 0) { #" +
                " BUILDING " +
              "# } else if (value === 1) {#" +
                " ROAD " +
              "# } else if (value === 2) {#" +
                 " DAM " +
              "# } else if (value === 3) {#" +
                " IRRIGATION" +
              "# } #"
            ).Hidden(true);
          columns.Bound(c => c.ProjectScope);
          columns.Bound(c => c.Consultant);
          columns.Bound(c => c.Client);
      })
      .Scrollable(h => h.Height(700))
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .DataSource(dataSource => dataSource
          .Ajax()
          .PageSize(20)
          .Group(groups =>
          {
              groups.Add(p => p.ProjectType);
          })
          .Events(events =>
          {
              events.Error("error_handler(\"ProjectInformationgrid\")");
              events.RequestStart("onRequestStart(\"ProjectInformationgrid\")");
              events.RequestEnd("onRequestEnd(\"ProjectInformationgrid\")");

          })

          .Model(model => model.Id(p => p.ProjectInformationId))
          .Read(read => read.Action("ProjectInformation_Read", "ProjectEstimationDetail"))

      ).ClientDetailTemplateId("template_workitem")
)

<script id="template_workitem" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=ProjectInformationId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("Work Items").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.GenericWorkItemPerProjectViewModel>()
                          .Name("workItems_#=ProjectInformationId#")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.SubProjectTypeName).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "\\#=value\\#"
                                  );
                              columns.Bound(c => c.StructureyType).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "\\#=value\\#"
                                  );
                              columns.Bound(c => c.WorkCategory).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "\\#=value\\#"
                                  );
                              columns.Bound(c => c.ItemName).Width(200).Title("Item Name");
                              columns.Bound(c => c.UnitOfMeasurement).Width(60).Title("UoM");
                              columns.Bound(c => c.TotalQuantityOfWork).Width(100).ClientTemplate(
                                        "\\# if (IsSubCategory) { \\#" +
                                            " -----" +
                                            "\\# } else {\\#" +
                                            "\\#: kendo.toString( TotalQuantityOfWork, 'N4') \\#" +
                                            "\\# } \\#"
                                        );
                              columns.Bound(c => c.LabourHourlyOutPut).Width(100).ClientTemplate(
                                   "\\# if (IsSubCategory) { \\#" +
                                          " -----" +
                                          "\\# } else {\\#" +
                                          "\\#: kendo.toString( LabourHourlyOutPut, 'N2') \\#" +
                                          "\\# } \\#"
                                      );
                              columns.Bound(c => c.OverheadRate).Width(100).ClientTemplate(
                                 "\\# if (IsSubCategory) { \\#" +
                                          " -----" +
                                          "\\# } else {\\#" +
                                          "\\#: OverheadRate \\#%" +
                                          "\\# } \\#"
                                      );
                              columns.Bound(c => c.ProfitMargin).Width(100).ClientTemplate(
                                  "\\# if (IsSubCategory) { \\#" +
                                          " -----" +
                                          "\\# } else {\\#" +
                                          "\\#: ProfitMargin \\#%" +
                                          "\\# } \\#"
                                      );
                              columns.Bound(c => c.TotalUnitCost).Width(100).ClientTemplate(
                                  "\\# if (IsSubCategory) { \\#" +
                                          " -----" +
                                          "\\# } else {\\#" +
                                          "\\#: kendo.toString( TotalUnitCost, 'N4') \\#" +
                                          "\\# } \\#"
                                      );
                              columns.Bound(c => c.ItemCode).Width(100);

                          })
                          .Scrollable(h => h.Height(500))
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          //.Events(e => e.Edit("onEdit"))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .PageSize(30)
                              .Sort(srt => {
                                  srt.Add(f => f.ItemCode);
                              })
                              .Events(events =>
                              {
                                  events.Error("error_handler(\"workItems_#=ProjectInformationId#\")");
                                  events.RequestStart("onRequestStart(\"workItems_#=ProjectInformationId#\")");
                                  events.RequestEnd("onRequestEnd(\"workItems_#=ProjectInformationId#\")");
                              })
                              .Group(g =>
                              {
                                  g.Add(f => f.SubProjectTypeName);
                                  g.Add(f => f.StructureyType);
                                  g.Add(f => f.WorkCategory);
                              })
                              .Model(model =>
                              {
                                  model.Id(p => p.Id);
                                  model.Field(p => p.TotalUnitCost).Editable(false);
                                  model.Field(p => p.SubProjectTypeName).Editable(false);
                                  model.Field(p => p.WorkCategory).Editable(false);
                                  model.Field(p => p.StructureyType).Editable(false);
                                  model.Field(p => p.UnitOfMeasurement).Editable(false);
                                  model.Field(p => p.ProfitMargin).Editable(false);
                                  model.Field(p => p.OverheadRate).Editable(false);
                              }
                              )
                              .Read(read => read.Action("WorkItem_Read", "ProjectEstimation", new { currentProjectId = "#=ProjectInformationId#" }))
                          ).ClientDetailTemplateId("template")
                          .ToClientTemplate()
                    )
                </text>
                  );
          }).ToClientTemplate())
</script>



