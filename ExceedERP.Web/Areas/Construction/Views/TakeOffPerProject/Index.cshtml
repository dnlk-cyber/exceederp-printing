<script>
    function sync_handler(e) {
        this.read();
    }
    function filterProject() {
        var value = this.value(),
          grid = $("#WorkItemPerProject").data("kendoGrid");

        if (value) {
            grid.dataSource.filter({ field: "ProjectInformationId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }

        $.ajax({
            url: '@Url.Action("SetProjectId", "WorkItemPerProject")',
            //contentType: "application/json; charset=utf-8",
            data: { value: value },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

            }

        });
    }
</script>

