<script type="text/javascript">
    function onEdit(e) {
        $.ajax({
            url: '@Url.Action("ReturnValues", "WorkItemPerProject")',
            //contentType: "application/json; charset=utf-8",
            data: {},
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                var s = r.split(/-/);
                if (e.model.isNew()) {
                    //set the default value for StateID
                    e.model.set("OverheadRate", s[0]);
                    e.model.set("ProfitMargin", s[1]);
                }
            }

        });
        //check if record is new

    }
</script>

