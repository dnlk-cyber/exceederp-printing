@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Unit Weight</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.UnitRate>()
          .Name("UnitRate")
      .Columns(columns =>
      {
          columns.Bound(c => c.UnitRateId).Title("Id");
          columns.Bound(c => c.Diameter);
          columns.Bound(c => c.UnitWeight);
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
      })
      .ToolBar(toolbar => {
          toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(h=> h.Height( 500))
      .DataSource(dataSource => dataSource
          .Ajax()

                .Events(events =>
                {
                    events.Error("error_handler(\"UnitRate\")");
                    events.RequestStart("onRequestStart(\"UnitRate\")");
                    events.RequestEnd("onRequestEnd(\"UnitRate\")");

                })

          .Model(model => model.Id(p => p.UnitRateId))
          .Read(read => read.Action("UnitRate_Read", "UnitRate"))
          .Create(create => create.Action("UnitRate_Create", "UnitRate"))
          .Update(update => update.Action("UnitRate_Update", "UnitRate"))
          .Destroy(destroy => destroy.Action("UnitRate_Destroy", "UnitRate"))
      )
)

<script>


    function sync_handler(e) {
        this.read();

    }
</Script>