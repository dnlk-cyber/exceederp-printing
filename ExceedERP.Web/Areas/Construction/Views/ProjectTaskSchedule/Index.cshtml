<script id="template_task" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_#=ProjectInformationId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Work Items / Tasks").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.TaskViewModel>()
                          .Name("task_#=ProjectInformationId#")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Version).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "Schedule Version: Ver. \\#=value\\#"
                                  );
                              columns.Bound(c => c.SubProjectTypeName).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "\\#=value\\#"
                                  );
                              columns.Bound(c => c.BlockName).Hidden(true).ClientGroupHeaderTemplate(
                                  "\\#=value\\#"
                                  );
                              columns.Bound(c => c.StructureyType).Hidden(true).ClientGroupHeaderTemplate(
                                  "\\#=value\\#"
                                  );
                              columns.Bound(c => c.WorkCategory).Hidden(true).ClientGroupHeaderTemplate(
                                  "\\#=value\\#"
                                  );
                              //columns.Bound(c => c.TaskID).Title("ID").Width(100);
                              columns.Bound(c => c.ProjectSpecificId).Width(100);
                              //columns.Bound(c => c.TaskCode).Title("Code").Width(100);
                              //columns.ForeignKey(c => c.WorkItemDurationId, (IEnumerable)ViewData["WorkItemDurations"], "WorkItemDurationId", "WorkDescription").EditorTemplateName("WorkItems").Width(120).Title("Work Item");
                              columns.Bound("Title").Title("Title/Description").Width(220);
                              columns.Bound(c => c.TotalQuantityOfWork).Title("Qty of Work").Width(100);
                              columns.Bound(c => c.Start).Width(100).Sortable(true);
                              columns.Bound(c => c.ActualDuration).Title("Duration").Width(90);
                              columns.Bound(c => c.End).Width(100).Sortable(true);
                              columns.Bound(c => c.OrderId).Title("Order").Width(100);
                              columns.ForeignKey(c => c.ParentID, (IEnumerable)ViewData["tasks"], "TaskID", "Title").EditorTemplateName("TaskParent").Width(120).Title("Parent");
                              //columns.ForeignKey(c => c.ParentID, (IEnumerable)ViewData["tasks"], "TaskID", "Title").Width(120).Title("Parent");
                              //columns.Bound(c => c.ParentID).Title("Parent Id").Width(90);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(200);
                          })

                          .Scrollable(s => s.Enabled(true).Height(600))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          //.Events(evnt => {
                          //    evnt.DataBound("TaskGridDataBound");
                          //})
                          //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ProjectTasks").Window(window => { window.Title("Work Item / Task"); window.Scrollable(false); }))
                          //.Events(events =>
                          //{
                          //    events.Edit("editTaskPerwbs");
                          //})
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .Sort(srt => {
                                  srt.Add(f => f.OrderId);
                              })
                              .PageSize(100)
                              .Group(g =>
                              {
                                  g.Add(f => f.Version);
                                  g.Add(f => f.SubProjectTypeName);
                                  g.Add(f => f.BlockName);
                                  g.Add(f => f.StructureyType);
                                  g.Add(f => f.WorkCategory);

                              })
                               .Model(model =>
                               {
                                   model.Id(t => t.TaskID);
                                   model.Field(t => t.TaskID).Editable(false);
                                   model.Field(t => t.ProjectSpecificId).Editable(false);
                                   model.Field(f => f.End).Editable(false);
                                   model.Field(f => f.ParentID).Editable(false);
                                   model.Field(f => f.TotalQuantityOfWork).Editable(false);
                               })
                              //.Events(events => {
                              //    events.Ed
                              //})
                              .Read(read => read.Action("ReadTasksPerProject", "Scheduler", new { projectId = "#=ProjectInformationId#" }))
                              .Create(create => create.Action("CreateTaskPerProjectBd", "Scheduler", new { pwbIdCreate = "#=ProjectInformationId#" }))
                              .Update(update => update.Action("UpdateTask", "Scheduler"))
                              .Destroy(destroy => destroy.Action("DestroyTask", "Scheduler"))
                          ).ClientDetailTemplateId("template_dependecy")
                          .ToClientTemplate()
                    )
                </text>
                );

            items.Add().Text("Work Items (Tasks) | Exportable Content ").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.TaskViewModel>()
                          .Name("task_ex_#=ProjectInformationId#")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Version).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "Schedule Version: Ver. \\#=value\\#"
                                  );
                              columns.Bound(c => c.SubProjectTypeName).Hidden(true)
                              .ClientGroupHeaderTemplate(
                                  "\\#=value\\#"
                                  );
                              columns.Bound(c => c.BlockName).Hidden(true).ClientGroupHeaderTemplate(
                                  "\\#=value\\#"
                                  );
                              columns.Bound(c => c.StructureyType).Hidden(true).ClientGroupHeaderTemplate(
                                  "\\#=value\\#"
                                  );
                              columns.Bound(c => c.WorkCategory).Hidden(true).ClientGroupHeaderTemplate(
                                  "\\#=value\\#"
                                  );
                              //columns.Bound(c => c.TaskID).Width(100).Title("Id").Locked(true);
                              columns.Bound(c => c.ProjectSpecificId).Width(100);
                              columns.Bound(c => c.Title).Width(220).Locked(true);
                              columns.Bound(c => c.TotalQuantityOfWork).Title("Qty of Work").Width(100);
                              columns.Bound(c => c.Start).Width(100).Sortable(true);
                              columns.Bound(c => c.ActualDuration).Title("Duration").Width(90);
                              columns.Bound(c => c.End).Width(90);
                              columns.Group(g => g.Title("Planned Costs").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                                             .Columns(info =>
                                                             {
                                                                 info.Bound(x => x.BudgetCost).Width(80).Format("{0:N2}");
                                                                 info.Bound(x => x.MaterialCost).Width(80).Format("{0:N2}");
                                                                 info.Bound(x => x.LabourCost).Width(80).Format("{0:N2}");
                                                                 info.Bound(x => x.EquipmentCost).Width(80).Format("{0:N2}");
                                                                 info.Bound(x => x.DirectCost).Width(80).Title("Total Direct Cost").Format("{0:N2}");
                                                                 //info.Bound(x => x.Profi).Width(80).Format("{0:N2}");
                                                                 //info.Bound(x => x.MaterialCost).Width(80).Format("{0:N2}");
                                                             })
                                                             );
                              columns.Bound(c => c.OrderId).Title("Order").Width(80);
                              columns.Bound(c => c.ParentID).Title("Parent").Width(80);
                              columns.Bound(c => c.PercentComplete).Title("% Complete").Width(80).Format("{0:P2}");
                              columns.Bound(c => c.Predecessors).Width(80);
                              columns.Group(g => g.Title("Actual Qty of Work & Actual Costs").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold; " })
                                                            .Columns(info =>
                                                            {
                                                                info.Bound(x => x.ExecutedQuantityTillPrevVersion).Width(80).Format("{0:N2}");
                                                                info.Bound(x => x.ExecutedQuantityThisVersion).Width(80).Format("{0:N2}");
                                                                info.Bound(x => x.ExecutedQuantityToDate).Width(80).Format("{0:N2}");
                                                                info.Bound(x => x.ExecutedAmountTillPrevVersion).Width(80).Format("{0:N2}");
                                                                info.Bound(x => x.ExecutedAmountThisVersion).Width(80).Title("Total Direct Cost").Format("{0:N2}");
                                                                info.Bound(x => x.ExecutedAmountToDate).Width(80).Format("{0:N2}");
                                                            })
                                                            );

                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Excel();
                          })
                           .Excel(excel => excel
                            .FileName("Schedule Export.xlsx")
                            //.Filterable(true)
                            .AllPages(true)
                            .ProxyURL(Url.Action("Excel_Export_Save", "ProjectTaskSchedule"))
                        )
                        .Sortable()
                          .Scrollable(s => s.Enabled(true).Height(400))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))

                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .PageSize(100)
                               .Group(g =>
                               {
                                   g.Add(f => f.Version);
                                   g.Add(f => f.SubProjectTypeName);
                                   g.Add(f => f.BlockName);
                                   g.Add(f => f.StructureyType);
                                   g.Add(f => f.WorkCategory);
                               })
                               .Model(model =>
                               {
                                   model.Id(t => t.TaskID);
                               })

                              .Read(read => read.Action("ReadAllTasksForExport", "Scheduler", new { projectId = "#=ProjectInformationId#" }))
                              .Create(create => create.Action("CreateTaskPerProjectBd", "Scheduler", new { pwbIdCreate = "#=ProjectInformationId#" }))
                              .Update(update => update.Action("UpdateTask", "Scheduler"))
                              .Destroy(destroy => destroy.Action("DestroyTask", "Scheduler"))
                          )//.ClientDetailTemplateId("template_dependecy")
                          .ToClientTemplate()
                    )
                </text>
                );

        }).ToClientTemplate()
    )
</script>

<script id="template_dependecy" type="text/kendo-tmpl">
