                               columns.Bound(c => c.UnitofMeasure);
                               columns.Bound(c => c.PrimaryRole);
                               columns.Bound(c => c.Color);
                           })
                           .Scrollable()
                           .Selectable(selectable =>
                           {
                               selectable.Mode(GridSelectionMode.Single);
                               selectable.Type(GridSelectionType.Row);
                           })
                           .DataSource(dataSource => dataSource
                               .Ajax()
                               .Model(model =>
                               {
                                   model.Id(r => r.ID);
                               })
                               .Read(read => read.Action("ReadTaskResources", "Scheduler", new { tskId = "#=TaskID#" }))
                      ).ToClientTemplate()
                    )
                </text>
                );*@
    items.Add().Text("Cost Break Down").Content(
        @<text>
            @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.TaskDetail>()
                                        .Name("scheduledCostsBreakDownGrid_#=TaskID#")
                                        .Columns(column =>
                                        {
                                            column.ForeignKey(c => c.ConstructionPeriodId, (IEnumerable)ViewData["Periods"], "ConstructionPeriodId", "Name").Width(100).EditorTemplateName("Periods");
                                            //column.Bound(c => c.ConstructionPeriodId);
                                            column.Bound(c => c.PlannedQuantityOfWork).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");

                                            column.Bound(c => c.PlannedMaterialCost).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");
                                            column.Bound(c => c.PlannedEquipmentCost).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");
                                            column.Bound(c => c.PlannedLaborCost).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");
                                            column.Bound(c => c.PlannedDirectCost).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");
                                            //column.Bound(c => c.PlannedProfitCost).Format("{0:N2}");
                                            //column.Bound(c => c.PlannedOverHeadCost).Format("{0:N2}");
                                            column.Bound(c => c.TotalCost).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");

                                            column.Command(command =>
                                            {
                                                command.Edit().UpdateText("Save").CancelText("Cancel").Text("Edit");
                                                //command.Destroy().Text("Delete");
                                            });
                                        })
                                        //.Pageable()
                                        //.Scrollable()
                                        //.Events(ev =>
                                        //{
                                        //    ev.DataBound("taskDetailDataBound");
                                        //})
                                        .Selectable(selectable =>
                                        {
                                            selectable.Mode(GridSelectionMode.Single);
                                            selectable.Type(GridSelectionType.Row);
                                        })
                                        //.Filterable()
                                        .Scrollable(s => s.Enabled(true).Height(300))
                                        .Pageable(pageable => pageable
                                              .Input(true)
                                              .Numeric(false)
                                              .Refresh(true)
                                              .PageSizes(true)
                                              .ButtonCount(5))
                                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                                        .DataSource(dataSource => dataSource
                                            .Ajax()
                                            .Aggregates(ag =>
                                            {
                                                ag.Add(c => c.PlannedQuantityOfWork).Sum();
