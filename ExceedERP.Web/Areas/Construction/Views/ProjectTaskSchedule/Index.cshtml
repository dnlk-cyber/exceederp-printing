                              .Ajax()
                               .Events(events =>
                                    {
                                        events.Error("error_handler(\"successors_#=TaskID#\")");
                                        events.RequestStart("onRequestStart(\"successors_#=TaskID#\")");
                                        events.RequestEnd("onRequestEnd(\"successors_#=TaskID#\")");

                                    })
                               .Model(model =>
