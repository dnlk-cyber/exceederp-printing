        items.Add().Text("Successors").Content(
            @<text>
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.DependencyViewModel>()
                          .Name("successors_#=TaskID#")
                          .Columns(columns =>
                          {
                              columns.ForeignKey(c => c.SuccessorID, (IEnumerable)ViewData["AllTasks"], "ID", "Title").EditorTemplateName("Predecessors");
                              columns.Bound(c => c.SuccessorTaskname);
                              //columns.Bound(c => c.SuccessorID).Title("Successor");
                              columns.Bound(c => c.Type).Title("Dependency Type");
                              columns.Bound(c => c.LagTime);

                          })
