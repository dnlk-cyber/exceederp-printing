<script type="text/javascript">
    var selectedProject = 0;
    var selectedWBS = 0;
    function wbsRowExpanded(projId) {
        selectedProject = projId;
    }
    function ImportWorkItems(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));

        var projId = dataItem.ProjectInformationId;
        var wbsId = dataItem.ProjectWorkBreakDownId;

        selectedProject = projId;
        selectedWBS = wbsId;
        var editorGrid = $("#workItems").data("kendoGrid");
        var wdw = $("#ImportWorkItemsWindow").data("kendoWindow");
        wdw.open();
        wdw.center();
        editorGrid.dataSource.read();
        //return false;
    }
    function getExpandedProjectId() {
        //var uid = '#=uid#';
        //var selector = kendo.format("tr[data-uid='{0}']", uid);
        //var currentGridElement = $(selector).closest("[data-role=grid]");
        //var parentRow = currentGridElement.closest(".k-detail-row").prev();
        //var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        //var parentModel = parentGrid.dataItem(parentRow);
        //return {
        //    parentModelId: parentModel.id
        //};
        return {
            currentProjectId: selectedProject,
            workBreakDownStructureId: selectedWBS
        };
    }
    function TaskGridDataBound(e) {
        e.preventDefault();
        $(".import-wokitems").click(function () {
            //alert("Import Clicked !");
            var editorGrid = $("#workItems").data("kendoGrid");
            var wdw = $("#ImportWorkItemsWindow").data("kendoWindow");
            wdw.open();
            wdw.center();
            editorGrid.dataSource.read();
            return false;
        });

    }
    function editTaskPerwbs() {
        var h = $("#taskParentList").data("kendoDropDownList");
    }
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

    function sync_handler(e) {
        this.read();
    }

    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();
    }

    function timelineViewClicked(e) {
        e.preventDefault();
        window.location.href = "@Url.Action("Index", "Scheduler")";
    }

    //
    // for passing the current model's property to the popup window
    function passCurrentTask(e, currentId) {
        if (e.model.isNew()) {
            //e.container.find("input:SuccessorID").val(currentId);
            e.model.set("SuccessorID", currentId);
        }
    }

    //function importWorkItemClicked() {
    //    //alert("custom toolbar");

    //    var editorGrid = $("#workItems").data("kendoGrid");
    //    var wdw = $("#ImportWorkItemsWindow").data("kendoWindow");
    //    wdw.open();
    //    wdw.center();
    //    editorGrid.dataSource.read();
    //}
    function ImportCurrentWorkItem(e) {
        var grid = $("#workItems").data("kendoGrid");

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.Id;
        $.ajax({
            url: '@Url.Action("ImportWorkItemToSchedule", "ProjectWorkBreakDown")',
            //contentType: "application/json; charset=utf-8",
            data: { currentWBSId: selectedWBS, workkItemId: id },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                grid.dataSource.read();
            }

        });
    }
    function WorkItemDropDownListChange() {
        var id = $("#WorkItemDurationId").val();

        $.ajax({
            url: '@Url.Action("GetTaskTitleFromWorkItem", "DataProvider", new {area = "Construction"})',
            data: { workItemDurationId: id },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#Title").val(result);
                $("#Title").trigger("change");
            }

        });
    }
    function closeImportWorkItemEditor() {
        var wdw = $("#ImportWorkItemsWindow").data("kendoWindow");
        wdw.close();
    }
    function wbsDataBound() {
        $(".k-grid-CmdImportWorkItem").find("span").addClass("k-icon k-i-plus");

    }
    function ImportWorkItemDataBound() {
        $(".k-grid-CustomCmdSelect").find("span").addClass("k-icon k-i-plus");


        var grid = this;
        var gridRows = grid.tbody.find("tr");

        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            if (dataItem.IsImported === true) {
                //row.find(".k-grid-edit").hide();
                //row.find(".k-grid-delete").hide();
                row.find(".k-grid-CustomCmdSelect").hide();
                row.addClass("highlighted-row");
            } else {

                //row.find(".k-grid-edit").show();
                //row.find(".k-grid-delete").show();
                row.find(".k-grid-CustomCmdSelect").show();
            }
        }
    }

</script>

