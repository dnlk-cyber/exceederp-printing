                                      "<li> <label> Direct Cost:</label> #= kendo.toString( DirectCost, 'N4')# </li>" +
                                      "<li> <label> Total Cost (planned) :</label> #= kendo.toString(BudgetCost, 'N4')# </li>" +
                                      "<li> <label> Qty Prev Ver :</label> #= kendo.toString(ExecutedQuantityTillPrevVersion, 'N4')# </li>" +
                                      "<li> <label> Qty This Ver. :</label> #= kendo.toString(ExecutedQuantityThisVersion, 'N4')# </li>" +
                                      "<li> <label> Qty Todate  :</label> #= kendo.toString(ExecutedQuantityToDate, 'N4')# </li>" +
                                      "<li> <label> Amnt. Prev Ver. :</label> #= kendo.toString(ExecutedAmountTillPrevVersion, 'N4')# </li>" +
