@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Schedule | Detail</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectInformation>()
    .Name("ProjectInformationgrid")
    .Columns(columns =>
    {
        columns.Bound(c => c.Name);
        columns.Bound(c => c.Code);
        columns.Bound(c => c.ContractAmount).ClientTemplate(
                        "# if (ContractAmount === 0) { #" +
                                                    " -----" +
                                                    "# } else {#" +
                                                    "#: kendo.toString( ContractAmount, 'N2') #" +
                                                    "# } #"
                        );
        columns.Bound(c => c.Client);
    })
    .ToolBar(toolbar =>
    {
    toolbar.Template(@<text>
        <div class="toolbar row">
            <div class="pull-right" style="margin-right:30px;">
                <a href='/Construction/Scheduler/' title="Go to Gantt charts"><i class="fa fa-align-left fa-2x"></i></a>
                @*@Html.Kendo().Button().Name("goTimelineView").Content("Timeline View").Events(events => events.Click("timelineViewClicked")).Icon("k-icon k-i-plus").HtmlAttributes(new { @class = "btn btn-primary" })*@
            </div>
        </div>
    </text>);
    })
    .Scrollable(h => h.Height(700))
    .Sortable(sortable =>
    {
        sortable.SortMode(GridSortMode.SingleColumn);
    })
    .Filterable()
    .Selectable(selectable =>
    {
        selectable.Mode(GridSelectionMode.Single);
        selectable.Type(GridSelectionType.Row);
    })
    .Pageable(pageable => pageable
                    .Input(true)
                    .Numeric(false)
                    .Refresh(true)
                    .PageSizes(true)
                    .ButtonCount(5))
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("error_handler(\"ProjectInformationgrid\")"))
        .Model(model => model.Id(p => p.ProjectInformationId))
        .Read(read => read.Action("ProjectInformation_Read", "ProjectTaskSchedule"))
    ).ClientDetailTemplateId("template_task")
)

