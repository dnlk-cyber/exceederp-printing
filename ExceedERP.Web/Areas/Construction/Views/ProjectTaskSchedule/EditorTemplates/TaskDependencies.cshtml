@using System.Collections
@using ExceedERP.Helpers.Common
@using ExceedERP.Core.Localization
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.Construction.DependencyViewModel

<form>
    <div class="row">
        <div class="col-md-1">
        </div>

        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.predecessorTaskname, htmlAttributes: new { @class = "control-label col-md-8" })

                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.PredecessorID)
                        .OptionLabel("Select ..")
                        .DataTextField("Title")
                        .DataValueField("TaskID")
                        .ValuePrimitive(true)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetAllCandidatePredecessors", "Scheduler", new { crntTaskId = Model.SuccessorID});
                            })
                            .ServerFiltering(false);
                        })
                    )
                </div>
            </div>
        </div>

    </div>

    <br />

    <div class="row">
        <div class="col-md-1">
        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Type, htmlAttributes: new { @class = "control-label col-md-8" })
            </div>
            <div class="form-group">
                @(Html.Kendo().DropDownListFor(model => model.Type)

                  .OptionLabel(Resources.Select)
                                  .DataTextField("Text")
                                  .DataValueField("Value")
                                           .ValuePrimitive(true)
                                                          .BindTo(EnumExtension.EnumToSelectList(typeof(Kendo.Mvc.UI.DependencyType))))
            </div>
        </div>
        <div class="col-md-1">
        </div>

    </div>

    <br />
    <br />


</form>
