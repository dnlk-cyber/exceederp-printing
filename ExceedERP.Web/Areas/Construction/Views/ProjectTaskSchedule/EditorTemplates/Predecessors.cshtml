@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
                        .OptionLabel(Resources.Select)
                        .DataTextField("Title")
                        .DataValueField("ID")
                        //.BindTo((IEnumerable)ViewData["tasks"])
                        .DataSource(dataSource =>
                        {
                            dataSource.Read(read => read.Action("GetTasksPossibleForBeingPrecessor", "DataProvider", new { taskId = "#=TaskID#" }));
                        })
                        .ValuePrimitive(true)
                        .Filter("contains")
                        .MinLength(2)
)