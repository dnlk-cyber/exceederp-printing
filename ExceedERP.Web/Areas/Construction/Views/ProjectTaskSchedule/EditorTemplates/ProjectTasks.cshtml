@using System.Collections
@using ExceedERP.Core.Localization
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.Construction.TaskViewModel
<form>
    <div class="row">
        <div class="col-md-1">
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.TaskCode, htmlAttributes: new { @class = "control-label col-md-12" })

                </div>
                <div>
                    @Html.Kendo().TextBoxFor(model => model.TaskCode)
                    @Html.ValidationMessageFor(model => model.TaskCode, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-12" })

                </div>
                <div>
                    @Html.Kendo().TextBoxFor(model => model.Title)
                    @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.WorkItemDurationId, htmlAttributes: new { @class = "control-label col-md-12" })

                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.WorkItemDurationId)
                        .Name("WorkItemDurationId")
                        .OptionLabel(Resources.Select)
                        .DataTextField("WorkDescription")
                        .DataValueField("WorkItemDurationId")
                        //.BindTo((IEnumerable)ViewData["tasks"])
                        .DataSource(dataSource =>
                        {
                            dataSource.Read(read => read.Action("GetWorkItemsUnderCurrentProject", "DataProvider", new { wbsId = Model.ProjectWorkBreakDownId }))
                            .ServerFiltering(false);
                        })
                        .ValuePrimitive(true)
                        .Filter("contains")
                        .MinLength(2)
                    )
                                        
                    @Html.ValidationMessageFor(model => model.WorkItemDurationId, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div class="form-group">
