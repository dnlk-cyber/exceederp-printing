                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.PercentComplete, htmlAttributes: new { @class = "control-label col-md-12" })

                </div>
                <div>
                    @Html.Kendo().NumericTextBoxFor(model => model.PercentComplete)
                    @Html.ValidationMessageFor(model => model.PercentComplete, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        
    </div>
    <br />
    <div class="row">
        <div class="col-md-1">
        </div>

        <div class="col-md-3">
            <div class="form-group">
