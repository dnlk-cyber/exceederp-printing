                    @Html.LabelFor(model => model.OrderId, htmlAttributes: new { @class = "control-label col-md-12" })

                </div>
                <div>
                    @Html.Kendo().NumericTextBoxFor(model => model.OrderId).Enable(false)
                    @Html.ValidationMessageFor(model => model.OrderId, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.ParentID, htmlAttributes: new { @class = "control-label col-md-12" })

                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.ParentID)
                        .Name("taskParentList")
                        .OptionLabel(Resources.Select)
                        .DataTextField("Title")
                        .DataValueField("TaskID")
                        .BindTo((IEnumerable)ViewData["tasks"])
                        .ValuePrimitive(true)
                        .Filter("contains")
                        .MinLength(2)

                    )
                </div>
            </div>
        </div>
