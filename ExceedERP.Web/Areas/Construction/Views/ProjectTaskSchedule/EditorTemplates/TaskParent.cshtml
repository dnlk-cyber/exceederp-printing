@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
                    .Name("taskParentList")
                    .OptionLabel(Resources.Select)
                    .DataTextField("Title")
                    .DataValueField("ID")
                    //.BindTo((IEnumerable)ViewData["tasks"])
                    .DataSource(dataSource =>
                    {
                        dataSource.Read(read => read.Action("GetTasksUnderProject", "DataProvider", new { currentProjectId = "#=ProjectInformationId#" }));
                    })
                    .ValuePrimitive(true)
                    .Filter("contains")
                    .MinLength(2)

)