@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
    .OptionLabel(Resources.Select)
    .Name("ConstructionSubPeriodId")
    .DataTextField("Name")
    .DataValueField("ConstructionSubPeriodId")
    .DataSource(dataSource =>
    {
        dataSource.Read(read => read.Action("GetConstructionSubPeriods", "DataProvider", new { id = "#=ConstructionPeriodId#" }));
        //.ServerFiltering(true);
    })
    .Filter("contains")
    .MinLength(2)
    .ValuePrimitive(true)
)