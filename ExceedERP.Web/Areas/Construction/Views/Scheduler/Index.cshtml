                                read.Action("TaskDetail_Read", "TaskDetail")
                                .Data("getCurrentTaskId");
                            })
                            .Create(create =>
                            {
                                create.Action("TaskDetail_Create", "TaskDetail")
                                .Data("getCurrentTaskId");
                            })
                            .Update(update =>
                            {
                                update.Action("TaskDetail_Update", "TaskDetail");
                            })
                            .Destroy(destroy => destroy.Action("TaskDetail_Destroy", "TaskDetail"))
                        )
                        .ClientDetailTemplateId("template_sub_detail")
            )
    }



