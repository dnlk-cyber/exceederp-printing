@using ExceedERP.Core.Domain.Construction
@using Kendo.Mvc.UI
@using System.Collections
@using ExceedERP.Core.Localization

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend id="headerText">Schedule | Chart  </legend>
@(Html.Kendo().Gantt<TaskViewModel, DependencyViewModel>()
        .Name("tasks_gantt")
        .Columns(columns =>
        {
            //columns.Bound(c => c.TaskID).Title("ID").Width(50);
            columns.Bound(c => c.ProjectSpecificId).Width(50);
            columns.Bound("title").Title("Task Name").Width(150).Editable(true).Title("Name");
            columns.Bound("start").Width(80).Sortable(true).Editable(true);
            columns.Bound("end").Width(80).Sortable(true).Editable(true);
            //columns.Bound(c => c.ProjectInformationId).Title("Project Id").Width(100);
            //columns.Bound(c => c.ProjectWorkBreakDownId).Title("PWB ID").Width(80);
            columns.Bound(c => c.BudgetCost).Width(80).Title("Budgeted Cost").Format("{0:N2}");
            columns.Bound(c => c.TotalQuantityOfWork).Title("QTY of Work").Width(90);
            columns.Bound("orderId").Title("Order").Width(80).Editable(true);
            columns.Bound("percentComplete").Title("Schedule % Complete").Width(80);
            columns.Resources("resources").Editable(true).Title("Resources").Width(100);

            columns.Bound(c => c.EstimatedDuration).Title("Estimated Duration (days)").Width(90);
            columns.Bound(c => c.ActualDuration).Title("Actual Duration (days)").Width(90);
            //columns.Bound(c => c.RemainingDuration).Title("Remaining (days)").Width(90);
            columns.Bound(c => c.Predecessors).Title("Predecessors").Width(100);

        })
        .Toolbar(toolbar =>
        {
            toolbar.Add().Name("custom").TemplateId("toolbar_template");
        })
        .Views(views =>
        {
            views.DayView();
            views.WeekView();
            views.MonthView(monthView => monthView.Selected(true));
            views.YearView();
        })
        //.Height(700)
        .ShowWorkHours(false)
        .ShowWorkDays(false)
        .Snap(false)
        .Resizable(true)
        .Editable(false)
        .Editable(edit =>
        {
            edit.TemplateId("editor_template");
        })
        .Navigatable(true)
        .Selectable(true)
        .Pdf(pdf => pdf
            .FileName("Schedule Export.pdf")
            .ProxyURL(Url.Action("Pdf_Export_Save", "Scheduler"))
        )
        .DataSource(d => d
            .Model(m =>
            {
                m.Id(f => f.TaskID);
                m.ParentId(f => f.ParentID);
                m.OrderId(f => f.OrderId);
                m.Field(f => f.Expanded).DefaultValue(true);
                m.Field(f => f.Summary);
                m.Field(f => f.Predecessors);
                m.Field(f => f.PercentComplete);
                //m.Field(f => f.ProjectWorkBreakDown);
                //m.Field(f => f.ProjectWorkBreakDownId);
                //m.Field(f => f.WorkItemDuration);
                //m.Field(f => f.WorkItemDurationId);
                //m.Field(f => f.Title).Editable(false);
            })
            .PageSize(100)
            //.Read("ReadTasks", "Scheduler")
            .Read(read => {
                read.Action("ReadFilteredTasks", "Scheduler").Data("changeSelectedProjectAndVersion");
            })
            //.Create("CreateTask", "Scheduler")
            .Create(create =>
            {
                create.Action("CreateTask", "Scheduler")
                .Data("getSelectedTaskData");
            })
            .Destroy("DestroyTask", "Scheduler")
            .Update("UpdateTask", "Scheduler")
        )
        .DependenciesDataSource(d => d
            .Model(m =>
            {
                m.Id(f => f.DependencyID);
                m.PredecessorId(f => f.PredecessorID);
                m.SuccessorId(f => f.SuccessorID);
                m.Type(f => f.Type);
            })
            .Read("ReadDependencies", "Scheduler")
            .Create("CreateDependency", "Scheduler")
            .Destroy("DestroyDependency", "Scheduler")
            .Update("UpdateDependency", "Scheduler")
        )
    .Messages(msg =>
    {
        msg.Actions(action =>
        {
            action.Append("Add New Task");
            action.AddChild("Add Sub-task");
            action.InsertAfter("Add Below the Selected Task");
            action.InsertBefore("Add Above the Selected Task");
        });
        msg.Editor(editor => {
            editor.EditorTitle("Work Item");
        });
    })
    .Resources(r => r
        .Field("resources")
        .DataColorField("Color")
        .DataTextField("Name")
        .DataSource(d => d
            .Custom()
            .Schema(s => s
                .Model(m => m.Id("ID"))
                .Data("Data")
            )
            .Transport(t =>
            {
                t.Read("ReadResources", "Scheduler");
            })
        )
    )
    .Assignments<ResourceAssignmentViewModel>(a => a
        .DataTaskIdField("TaskID")
        .DataResourceIdField("ResourceID")
        .DataValueField("Units")
        .DataSource(d => d
            .Model(m =>
            {
                m.Id(f => f.ID);
            })
            .Read("ReadAssignments", "Scheduler")
            .Create("CreateAssignment", "Scheduler")
            .Destroy("DestroyAssignment", "Scheduler")
            .Update("UpdateAssignment", "Scheduler")
        )
    )
    .Events(evnt =>
    {
        evnt.Edit("editTask");
        evnt.Save("saveTaskChanges");
        evnt.DataBound("ganttDataBound");
        //evnt.DataBinding("gantDataBinging");

    })
)
