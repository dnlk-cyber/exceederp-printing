                            column.Bound(c => c.PlannedProfitCost).Format("{0:N4}").ClientFooterTemplate("#=kendo.toString(sum, 'N4')#");
                            column.Bound(c => c.PlannedOverHeadCost).Format("{0:N4}").ClientFooterTemplate("#=kendo.toString(sum, 'N4')#");
                            column.Bound(c => c.TotalCost).Format("{0:N4}").ClientFooterTemplate("#=kendo.toString(sum, 'N4')#");

