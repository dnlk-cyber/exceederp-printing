@helper renderPredecessorEditorWindowGrid() { 
        @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.PredecssorViewModel>()
            .Name("predecessorEditor")
            .Columns(column =>
            {
                column.Bound(c => c.IsSelected).Width(40).Title("").HtmlAttributes(new { style = "text-align:center; vertical-align:middle;" })
                .ClientTemplate(
                "<input type='checkbox' style='' value='#=Id#' class='templateCheckBox' name='predecessorCheckBox'" +
                    "# if (IsSelected) { #" +
                        "checked='checked'" +
                    "# } #" +
                "/>")
                .Editable(
                    @<text>
                        function(e){ return false; }
                    </text>
                    )
                ;
                //column.Bound(c => c.Id);
                column.Bound(c => c.ProjectSpecificId).Width(60);
                column.Bound(c => c.Name).Title("Description");
                column.Bound(c => c.Type).Filterable(false).EditorTemplateName("TaskDependecyType").Width(100);
                column.Bound(c => c.LagTime).Width(80);

                //column.Command(command =>
                //{
                //    command.Edit().Text(" ").CancelText(" ").UpdateText(" ");
                //    //command.Custom("CmdEditPredecessor").Text(" ").Click("editPredecessor").IconClass("fa fa-edit");
                //}).Width("100px");
            })
            .ToolBar(toolBar => {
                toolBar.Save();
            })
            .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
            //.HtmlAttributes(new { style = "height:0px;"})
            .Scrollable()
            .Selectable(selectable =>
            {
                selectable.Mode(GridSelectionMode.Single);
                selectable.Type(GridSelectionType.Row);
            })
            .Filterable()
            .Events(ev => {
                ev.DataBound("predecessorEditorDataBound");
                //ev.Edit("onPredecessorEdit");
                //ev.Change("onPredecessorModelChange");
            })
            .Editable(editable => editable.Mode(GridEditMode.InCell))
            .DataSource(dataSource => dataSource
                .Ajax()
                .Batch(true)
                .Model(model =>
                {
                    model.Id(p => p.Id);
                    model.Field(p => p.Id).Editable(false);
                    model.Field(p => p.ProjectSpecificId).Editable(false);
                    model.Field(f => f.Name).Editable(false);
                    //model.Field(f => f.IsSelected).DefaultValue(true);
                })
                //.Read(read => read.Action("ReadPredecessors", "Scheduler"))
                .Read(read =>
                {
                    read.Action("ReadPredecessors", "Scheduler")
                    .Data("getCurrentTaskId");
                })
                .Create(create => create.Action("ReadPredecessors", "Scheduler"))
                //.Create(create => {
                //    create.Action("CreateTaskPredecessor", "Scheduler")
                //    .Data("getTargetTaskId");
                //})
                //.Update(update => update.Action("ReadPredecessors", "Scheduler"))
                .Update(update =>
                {
                    update.Action("CreateTaskPredecessor", "Scheduler")
                    .Data("getTargetTaskId");
                })
                .Destroy(destroy => destroy.Action("ReadPredecessors", "Scheduler"))
            )
            )
    }
