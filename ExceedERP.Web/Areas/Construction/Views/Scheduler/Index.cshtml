<script id="template_sub_detail" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_str_#=TaskDetailId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Detail").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.TaskDetailBreakDown>()
                            .Name("subPeriods__#=TaskDetailId#")
                            .Columns(column =>
                            {
                                column.ForeignKey(c => c.ConstructionSubPeriodId, (IEnumerable)ViewData["SubPeriods"], "ConstructionSubPeriodId", "Name").Width(100).EditorTemplateName("SubPeriods");
                                //column.Bound(c => c.ConstructionPeriodId);
                                column.Bound(c => c.PlannedQuantityOfWork).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");

                                column.Bound(c => c.PlannedMaterialCost).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");
                                column.Bound(c => c.PlannedEquipmentCost).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");
                                column.Bound(c => c.PlannedLaborCost).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");
                                column.Bound(c => c.PlannedDirectCost).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");
                                column.Bound(c => c.PlannedProfitCost).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");
                                column.Bound(c => c.PlannedOverHeadCost).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");
                                column.Bound(c => c.TotalCost).Format("{0:N4}").ClientFooterTemplate("\\#=kendo.toString(sum, 'N4')\\#");

                                column.Command(command =>
                                {
                                    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                    command.Destroy().Text(Resources.ActionButton_Cancel);
                                }).Width(180);
                            })
                            .ToolBar(toolbar =>
                            {
                                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                            })
                            .Editable(editable => editable.Mode(GridEditMode.InLine))
                            .Scrollable(h => h.Height("auto"))
                            .Sortable(sortable =>
                            {
                                sortable.SortMode(GridSortMode.SingleColumn);
                            })
                            //.Groupable()
                            .Selectable(selectable =>
                            {
                                selectable.Mode(GridSelectionMode.Single);
                                selectable.Type(GridSelectionType.Row);
                            })
                            //.Filterable()
                            .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
                            //.Events(e => e.DataBound("structureTypeDataBound"))
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Aggregates(ag =>
                                {
                                    ag.Add(c => c.PlannedQuantityOfWork).Sum();
                                    ag.Add(c => c.PlannedMaterialCost).Sum();
                                    ag.Add(c => c.PlannedLaborCost).Sum();
                                    ag.Add(c => c.PlannedEquipmentCost).Sum();
                                    ag.Add(c => c.PlannedDirectCost).Sum();
                                    ag.Add(c => c.PlannedProfitCost).Sum();
                                    ag.Add(c => c.PlannedOverHeadCost).Sum();
                                    ag.Add(c => c.TotalCost).Sum();
                                })
                                .Events(events =>
                                {
                                    events.Error("error_handler(\"subPeriods__#=TaskDetailId#\")");
                                    events.RequestStart("onRequestStart(\"subPeriods__#=TaskDetailId#\")");
                                    events.RequestEnd("onRequestEnd(\"subPeriods__#=TaskDetailId#\")");
                                })
                                .Model(model =>
                                {
                                    model.Id(p => p.TaskDetailBreakDownId);

                                    model.Field(p => p.PlannedMaterialCost).Editable(false);
                                    model.Field(p => p.PlannedLaborCost).Editable(false);
                                    model.Field(p => p.PlannedEquipmentCost).Editable(false);
                                    model.Field(p => p.PlannedProfitCost).Editable(false);
                                    model.Field(p => p.PlannedOverHeadCost).Editable(false);
                                    model.Field(p => p.PlannedDirectCost).Editable(false);
                                    model.Field(p => p.TotalCost).Editable(false);
                                })
                                .Read(read => read.Action("Detail_Read", "TaskDetailBreakDown", new { id = "#=TaskDetailId#" }))
                                .Create(create => create.Action("Detail_Create", "TaskDetailBreakDown", new { id = "#=TaskDetailId#" }))
                                .Update(update => update.Action("Detail_Update", "TaskDetailBreakDown"))
                                .Destroy(destroy => destroy.Action("Detail_Destroy", "TaskDetailBreakDown"))

                                ).ToClientTemplate()
                    )
                </text>
            );


        }).ToClientTemplate())
</script>

