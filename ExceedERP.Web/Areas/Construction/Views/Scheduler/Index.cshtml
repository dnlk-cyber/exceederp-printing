<script>
    //
    //  Summary
    //      functions for dependency editor window
    function openDependencyEditor() {
        var editorGrid = $("#predecessorEditor").data("kendoGrid");
        var wdw = $("#myWindow").data("kendoWindow");
        wdw.open();
        wdw.center();
        editorGrid.dataSource.read();
    }
    function closeDependencyEditor() {
        var window = $("#myWindow").data("kendoWindow");
        //var gnt = $("#tasks_gantt").getKendoGantt();
        //gnt.dataSource.read();
        //gnt.dependencies.read();
        window.close();
    }
    function saveDependencyChanges() {
        var window = $("#myWindow").data("kendoWindow");
        var gnt = $("#tasks_gantt").getKendoGantt();
        gnt.dataSource.read();
        gnt.dependencies.read();
        window.close();
    }
    function onDependecyEditorWindowClose() {
        var gnt = $("#tasks_gantt").getKendoGantt();
        gnt.dataSource.read();
        gnt.dependencies.read();
    }
    //
    //saveDependencyChanges

    //
    //  Summary:
    //      functions for schedule break down window
    function openScheduleBreakDownEditor() {
        var editorGrid = $("#scheduledCostsBreakDownEditor").data("kendoGrid");
        var wdw = $("#scheduleBreakDownWindow").data("kendoWindow");
        wdw.open();
        wdw.center();
        editorGrid.dataSource.read();
    }

    function closeScheduleBreakDownEditor() {
        var window = $("#scheduleBreakDownWindow").data("kendoWindow");
        window.close();
    }
    function saveScheduleBreakDownChanges() {
        var window = $("#scheduleBreakDownWindow").data("kendoWindow");
        window.close();
    }
    function openTaskBreakDownEditor() {
        var editorGrid = $("#subActivitiesGrid").data("kendoGrid");
        var wdw = $("#activityBreakDownWindow").data("kendoWindow");
        wdw.open();
        wdw.center();
        editorGrid.dataSource.read();
    }
    function closeTaskBreakDownEditor() {
        var window = $("#activityBreakDownWindow").data("kendoWindow");
        window.close();
        var gnt = $("#tasks_gantt").getKendoGantt();
        gnt.dataSource.read();
        gnt.dependencies.read();
    }
