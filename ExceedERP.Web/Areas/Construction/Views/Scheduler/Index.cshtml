    function updateCustomPagerComponents() {
        var gant = $("#tasks_gantt").data("kendoGantt");
        var ttlPages = gant.dataSource.totalPages();
        var ttlItems = gant.dataSource.total();
        //var crntPage = gant.dataSource.page();
        var initialItems = pageSize * (pageNumber - 1) + 1;
        var itemsBeingDesplayed = (pageNumber * pageSize);
        if (itemsBeingDesplayed > ttlItems) {
            itemsBeingDesplayed = ttlItems;
        }
        if (ttlItems > 0) {
            var displayText = initialItems + " - " + itemsBeingDesplayed + " of " + ttlItems + " items";

            $("#gant-page-total-items-count").html(displayText);

        }
        $("#gant-page-total-pages-display").html(ttlPages);
        $("#gant-page-current-page-display").val(pageNumber > ttlPages ? "" : pageNumber);
        //alert(gant.dataSource.totalPages());
    }
