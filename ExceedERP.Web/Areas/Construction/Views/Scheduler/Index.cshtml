                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Aggregates(ag => {
                                ag.Add(c => c.PlannedQuantityOfWork).Sum();
                                ag.Add(c => c.PlannedMaterialCost).Sum();
                                ag.Add(c => c.PlannedLaborCost).Sum();
                                ag.Add(c => c.PlannedEquipmentCost).Sum();
                                ag.Add(c => c.PlannedDirectCost).Sum();
                                ag.Add(c => c.PlannedProfitCost).Sum();
                                ag.Add(c => c.PlannedOverHeadCost).Sum();
                                ag.Add(c => c.TotalCost).Sum();
                            })
                            .Model(model =>
                            {
                                model.Id(p => p.TaskDetailId);
                                model.Field(p => p.PlannedMaterialCost).Editable(false);
                                model.Field(p => p.PlannedLaborCost).Editable(false);
                                model.Field(p => p.PlannedEquipmentCost).Editable(false);
                                model.Field(p => p.PlannedProfitCost).Editable(false);
                                model.Field(p => p.PlannedOverHeadCost).Editable(false);
                                model.Field(p => p.PlannedDirectCost).Editable(false);
                                model.Field(p => p.TotalCost).Editable(false);
                            })
                            .Read(read =>
