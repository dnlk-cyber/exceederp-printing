<script type="text/javascript">
    var theSelectedProjectId = 0;
    var currentScheduleVersion = 0;

    var blockTypeId = 0;
    var blockId = 0;
    var strTypeId = 0;
    var workCategoryId = 0;
    var pageNumber = 1;
    var pageSize = 100;
    $(document).ready(function () {

        //  summary:
        //      change the page number in the gantt chart pager by user manual imput
        $("#gant-page-current-page-display").keypress(function(evnt){
            var keyCode = (evnt.keyCode ? event.keyCode : event.which);
            if (keyCode == '13') {
                var newPage = parseInt($("#gant-page-current-page-display").val());
                if (pageNumber != newPage) {
                    pageNumber = newPage;
                    refreshGanttChart();
                }
        }
        });
        // summary:
        //      create a page size selector for custom gantt-pagger
        $("#pageSizeSelectorDropDownList").kendoDropDownList({
            change: function () {
                var gant = $("#tasks_gantt").getKendoGantt();
                var ttlItems = gant.dataSource.total();

                //alert("page Size changed!");
                var selectedValue = parseInt(this.value());
                if (selectedValue > ttlItems) {
                    selectedValue = ttlItems;
                }
                if (selectedValue == -1) {
                    selectedValue = ttlItems;
                }
                pageSize = selectedValue;
                gant.dataSource.pageSize(pageSize);
                pageNumber = 1;
                refreshGanttChart();
            }
        });

        //  summary:
        //      handle the change event of the checkbox used in editor template
        $("#predecessorEditor .k-grid-content").on("change", "input.templateCheckBox", function (e) {
            var grid = $("#predecessorEditor").data("kendoGrid"),
                dataItem = grid.dataItem($(e.target).closest("tr"));
            $(e.target).closest("td").prepend("<span class='k-dirty'></span>");
            dataItem.IsSelected = this.checked;
            dataItem.dirty = true;
        });
        var gnt = $("#tasks_gantt").getKendoGantt();
        //gnt.dataSource.filter({ field: "ProjectInformationId", operator: "eq", value: parseInt(-1) });

        // projects drop down list
        var projects = $("#projectDropdown").kendoDropDownList({
            optionLabel: "Select project ...",
            filter: "contains",
            dataTextField: "Name",
            dataValueField: "ProjectInformationId",
            dataSource: {
                //serverFiltering: true,
                transport: {
                    read: {
                        url: '/Construction/DataProvider/GetAllProjectsAllowedForCurrentUser/'
                    }
                }
            },
            change: function () {
                var gantt1 = $("#tasks_gantt").getKendoGantt();
                //gantt1.dataSource.filter({ field: "ProjectInformationId", operator: "eq", value: parseInt(this.value()) });
                //gantt1.dataSource.filter({ field: "Version", operator: "eq", value: -1 });
                //gantt1.dataSource.filter({
                //    logic: "and",
                //    filters: [
                //      { field: "ProjectInformationId", operator: "eq", value: parseInt(this.value()) },
                //      { field: "Version", operator: "eq", value: -1 }
                //    ]
                //});
                var textToBeAdded = "Schedule | Chart | " + this.text();
                $("#headerText").html(textToBeAdded);

                // get the id of the selected project
                theSelectedProjectId = parseInt(this.value());
                currentScheduleVersion = 0;
                blockTypeId = 0;
                blockId = 0;
                strTypeId = 0;
                workCategoryId = 0;
                pageNumber = 1;
                pageSize = 100;
                resetGanttData();
            }

        }).data("kendoDropDownList");

        //version drop down
