<script type="text/javascript">
    function onProjectSelect(e) {
        if (e.item) {
            var dataItem = this.dataItem(e.item);
            selectedProjectId = dataItem.ProjectInformationId;
            var dm = $("#taskDiagram").getKendoDiagram();
            dm.dataSource.filter({ field: "ProjectInformationId", operator: "eq", value: parseInt(selectedProjectId) });

        } else {
            alert("Error");
        }
    }

    function onWbsSelect(e) {
        if (e.item) {
            var dataItem = this.dataItem(e.item);
            selectedWbsId = dataItem.ProjectWorkBreakDownId;
            var dm = $("#taskDiagram").getKendoDiagram();
            dm.dataSource.filter({ field: "ProjectWorkBreakDownId", operator: "eq", value: parseInt(selectedWbsId) });
        } else {
            alert("Error");
        }

    }
    function filterWorkBreakdowns() {
        return {
            idThree: $("#projectInformationList").val()
        };
    }
</script>