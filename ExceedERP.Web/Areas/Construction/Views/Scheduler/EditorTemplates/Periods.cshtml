@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
    .OptionLabel(Resources.Select)
    .Name("ConstructionPeriodId")
    .DataTextField("Name")
    .DataValueField("ConstructionPeriodId")
    .DataSource(dataSource =>
    {
        dataSource.Read(read => read.Action("GetPeriodsWithinTimeRange", "DataProvider")
        .Data("getCurrentTaskId"));
        //.ServerFiltering(true);
    })
    .Filter("contains")
    .MinLength(2)
    .ValuePrimitive(true)
)