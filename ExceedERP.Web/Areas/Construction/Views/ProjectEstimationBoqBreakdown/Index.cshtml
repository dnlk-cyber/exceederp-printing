@using System.Collections
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Estimated Project Priced BOQ</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectEstimationBoqBreakdown>()
        .Name("ProjectEstimationBoqBreakdown")
        .Columns(columns =>
        {
            columns.Bound(c => c.SubProjectTypeName).Hidden(true)
                                          .ClientGroupHeaderTemplate(
                                              "#=value# (Total : #= kendo.toString(aggregates.TotalCost.sum, 'N2')# birr)"
                                              );
            columns.Bound(c => c.StructureyType).Hidden(true)
            .ClientGroupHeaderTemplate(
                "#=value# (Sub Total : #= kendo.toString(aggregates.TotalCost.sum, 'N2')# birr)"
                );
            columns.Bound(c => c.WorkCategory).Hidden(true)
            .ClientGroupHeaderTemplate(
                "#=value# (Sub Total : #= kendo.toString(aggregates.TotalCost.sum, 'N2')# birr)"
                );
            //columns.Bound(c => c.Type).Hidden(true).ClientGroupHeaderTemplate("#= value # (Sub Total : #= kendo.toString(aggregates.TotalCost.sum, 'N2')# birr)");
            //columns.Bound(c => c.Category).Hidden(true).ClientGroupHeaderTemplate("#= value # (Sub Total : #= kendo.toString(aggregates.TotalCost.sum, 'N2')# birr)");
            columns.Bound(c => c.BillNumber).Width(80);
            columns.Bound(c => c.Description).Width(300);
            columns.ForeignKey(c => c.UnitOfMeasurementId, (IEnumerable)ViewData["uom"], "UnitOfMeasurementId", "Abbreviation").EditorTemplateName("Unit").Width(60);
            columns.Bound(c => c.Quantity).Width(100).Format("{0:N2}");
            columns.Bound(c => c.UnitRate).Width(100).Format("{0:N2}");
            columns.Bound(c => c.TotalCost).Width(120).Format("{0:N2}")
                .ClientFooterTemplate("Project Total: #= kendo.toString(sum, 'N2') #");
            //.ClientGroupFooterTemplate("Sub-total : #= kendo.toString(sum, 'N2')#");
            columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
        })
        .ToolBar(toolbar =>
        {
        toolbar.Template(@<text><div>
            <div class="toolbar">
                @*@item.CreateButton( )*@
                <label class="category-label" for="ProjectInformationId">Select a Project:</label>
                @(Html.Kendo().DropDownListFor(m => m)

                                        .Name("ProjectInformationId")
                                        .OptionLabel("Select ...")
                                        .Filter("contains")
                                        //.BindTo((IEnumerable) ViewData["ProjectList"])
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetAllProjects", "DataProvider");
                                            });
                                        })
                                        .DataTextField("Name")
                                        .DataValueField("ProjectInformationId")
                                        .HtmlAttributes(new { style = "width: 300px;" })
                                        .ValuePrimitive(true)
                                        .Events(x => x.Change("filter"))

                )

                @*&nbsp;&nbsp; <label class="selected-project-label" id="selectedProjectLabel"> Here goes ..</label>*@

                <br />
                <br />
            </div>
        </div></text>);
            toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
        })
        .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Scrollable(h => h.Height(500))
        .Selectable(selectable =>
        {
            selectable.Mode(GridSelectionMode.Single);
            selectable.Type(GridSelectionType.Row);
        })
        .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Sort(srt =>
            {
                srt.Add(f => f.BillNumber);
            })
            .PageSize(50)
            .Events(events =>
            {
                events.Error("error_handler(\"ProjectEstimationBoqBreakdown\")");
                events.RequestStart("onRequestStart(\"ProjectEstimationBoqBreakdown\")");
                events.RequestEnd("onRequestEnd(\"ProjectEstimationBoqBreakdown\")");
            })
            .Group(g =>
            {
                g.Add(f => f.SubProjectTypeName);
                g.Add(f => f.StructureyType);
                g.Add(f => f.WorkCategory);
            })
            .Aggregates(aggregates =>
            {
                aggregates.Add(p => p.TotalCost).Sum();
            })
            .Model(model => model.Id(p => p.ProjectEstimationBoqBreakdownId))
            .Read(read => read.Action("ProjectEstimationBoqBreakdown_Read", "ProjectEstimationBoqBreakdown"))
            .Create(create => create.Action("ProjectEstimationBoqBreakdown_Create", "ProjectEstimationBoqBreakdown"))
            .Update(update => update.Action("ProjectEstimationBoqBreakdown_Update", "ProjectEstimationBoqBreakdown"))
            .Destroy(destroy => destroy.Action("ProjectEstimationBoqBreakdown_Destroy", "ProjectEstimationBoqBreakdown"))
        ).ClientDetailTemplateId("templateTwo")
)

<script id="templateTwo" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabstrip_#=ProjectEstimationBoqBreakdownId#")
            .SelectedIndex(0)
            .Items(items =>
            {
                items.Add().Text("Detail").Content(
                    @<text>
                        @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.ProjectEstimationBoqDetail>()
                        .Name("ProjectEstimationBoqDetail_#=ProjectEstimationBoqBreakdownId#")
                        .Columns(columns =>
                        {
                            columns.Bound(c => c.BillNumber);
                            columns.Bound(c => c.Description);
                            columns.ForeignKey(c => c.UnitOfMeasurementId, (IEnumerable)ViewData["uom"], "UnitOfMeasurementId", "Abbreviation").Width(90);
                            columns.Bound(c => c.Quntity).Format("{0:N2}");
                            columns.Bound(c => c.UnitRate).Format("{0:N2}");
                            columns.Bound(c => c.TotalCost).Format("{0:N2}")
                                .ClientFooterTemplate("Total: \\#= kendo.toString(sum, 'N2') \\#");
                            columns.Command(command => { command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit); command.Destroy().Text(Resources.ActionButton_Cancel); }).Width(200);
                        })
                        //.ToolBar(toolbar =>
                        //{
                        //    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                        //})
                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .Scrollable()
                        .Selectable(selectable =>
                        {
                            selectable.Mode(GridSelectionMode.Single);
                            selectable.Type(GridSelectionType.Row);
                        })
                        .DataSource(dataSource => dataSource
                        .Ajax()
                        .Aggregates(ag =>
                        {
                            ag.Add(f => f.TotalCost).Sum();
                        })
                        .Events(events =>
                        {
                            events.Error("error_handler(\"ProjectEstimationBoqDetail_#=ProjectEstimationBoqBreakdownId#\")");
                            events.RequestStart("onRequestStart(\"ProjectEstimationBoqDetail_#=ProjectEstimationBoqBreakdownId#\")");
                            events.RequestEnd("onRequestEnd(\"ProjectEstimationBoqDetail_#=ProjectEstimationBoqBreakdownId#\")");

                        })
                        .Model(model =>
                        {
                            model.Id(p => p.ProjectEstmnBoqDetailId);
                            model.Field(p => p.TotalCost);
                        })
                        .Read(read => read.Action("ProjectEstimationBoqDetail_Read", "ProjectEstimationBoqDetail", new { id = "#=ProjectEstimationBoqBreakdownId#" }))
                        .Create(create => create.Action("ProjectEstimationBoqDetail_Create", "ProjectEstimationBoqDetail", new { id = "#=ProjectEstimationBoqBreakdownId#" }))
                        .Update(update => update.Action("ProjectEstimationBoqDetail_Update", "ProjectEstimationBoqDetail"))
                        .Destroy(destroy => destroy.Action("ProjectEstimationBoqDetail_Destroy", "ProjectEstimationBoqDetail"))
                    ).ToClientTemplate()
                        )
                    </text>
            );
            }).ToClientTemplate())
</script>


