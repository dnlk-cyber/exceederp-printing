    function sync_handler(e) {
        this.read();

    }
    function onGridEdit(e) {
        e.container.find(".k-button.k-grid-update").hide();
        e.container.find(".k-button.k-grid-cancel").hide();

    }

    function sync_handler(e) {
        this.read();

    }

    function filter() {
        var value = this.value();
        var textToBeAdded = this.text();
        $("#selectedProjectLabel").html(textToBeAdded);
        $.ajax({
            url: '@Url.Action("SetProjectId", "ProjectEstimationBoqBreakdown")',
            //contentType: "application/json; charset=utf-8",
            data: { value: value },
            type: 'GET',
            cache: false,
            success: function (result) {
                r = result;
                var grid = $("#ProjectEstimationBoqBreakdown").data("kendoGrid");
                grid.dataSource.read();
                //window.location.reload();
            }

        });
        //this.value(value);
        var grid = $("#ProjectEstimationBoqBreakdown").data("kendoGrid");
        grid.dataSource.read();
        var value = this.value();


        if (value) {
            grid.dataSource.filter({ field: "ProjectInformationId", operator: "eq", value: parseInt(value) });
        } else {
            grid.dataSource.filter({});
        }

    }
    function Types() {
        var values = $("#ProjectTypeId").data("kendoDropDownList");
        var value = values.value();
        $.ajax({
            url: '@Url.Action("SetProjectType", "ProjectEstimationBoqBreakdown")',
            //contentType: "application/json; charset=utf-8",
            data: { value: value },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                // this.read();
            }

        });
    }
</script>

