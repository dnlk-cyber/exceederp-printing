<script>
    function Copy() {
        var projects = $("#ProjectInformationIdTwo").data("kendoComboBox");
        var projectsTwo = $("#ProjectInformationId").data("kendoComboBox");
        var destinationProjectType = "";
        var btn = $("#btnSave").data("kendoButton");
        var loadingButton = $("#loadingButton");
        //btn.enable(false);
        var popupMessage = "";
        try {
            var from = projects.value();
            var to = projectsTwo.value();

            $.ajax({
                url: '@Url.Action("GetTaregtProjectType", "CloneWorkItemPerProject")',
                //contentType: "application/json; charset=utf-8",
                data: { targetProjectId: to },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    if (r === "building") {
                        popupMessage = "It seems that the destination project has no block types defined. Do you want to copy the blocks, too?";
                    } else if (r === "road") {
                        popupMessage = "It seems that the destination project has no Roads or Road Segments defined. Do you want to copy the Roads and Road Segments, too?"
                    } else {
                        popupMessage = "Copy the entire Data?"
                    }
                }
            });

            $.ajax({
                url: '@Url.Action("CheckCopied", "CloneWorkItemPerProject")',
                //contentType: "application/json; charset=utf-8",
                data: { to: to },
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    if (r === "True")
                    {
                        // the destination project has pre-existingn data ..
                        if (confirm("This destination project has some existing data. If you proceed, the data will be lost!!!. Are you sure want to continue the operation?"))
                        {
                            btn.enable(false);
                            loadingButton.show();
                            // check if the destination has no blocks defined
                            $.ajax({
                                url: '@Url.Action("TargetProjectHasNoSubProjectTypes", "CloneWorkItemPerProject")',
                                //contentType: "application/json; charset=utf-8",
                                data: { to: to },
                                type: 'POST',
                                cache: false,
                                success: function (result) {
                                    if (result === "True") {
                                        if (confirm(popupMessage)) {
                                            $.ajax({
                                                url: '@Url.Action("CloneEstimationWithSubProjectTypes", "CloneWorkItemPerProject")',
                                                //contentType: "application/json; charset=utf-8",
                                                data: { from: from, to: to },
                                                type: 'POST',
                                                cache: false,
                                                success: function (result) {
                                                    // r = result;
                                                    window.location.reload();
                                                }
                                            });
                                        }
                                    }
                                    else {
                                        $.ajax({
                                            url: '@Url.Action("CloneEstimation", "CloneWorkItemPerProject")',
                                            //contentType: "application/json; charset=utf-8",
                                            data: { from: from, to: to },
                                            type: 'POST',
                                            cache: false,
                                            success: function (result) {
                                                // r = result;
                                                window.location.reload();
                                            }
                                        });
                                    }
                                }
                            });
                        }
                    } else {

                        // here, the destination project has no pre-existing data

                        // check if the destination has no blocks defined
                        $.ajax({
                            url: '@Url.Action("TargetProjectHasNoSubProjectTypes", "CloneWorkItemPerProject")',
                            //contentType: "application/json; charset=utf-8",
                            data: { to: to },
                            type: 'POST',
                            cache: false,
                            success: function (result) {
                                btn.enable(false);
                                loadingButton.show();
                                if (result === "True") {
                                    if (confirm(popupMessage)) {
                                        $.ajax({
                                            url: '@Url.Action("CloneEstimationWithSubProjectTypes", "CloneWorkItemPerProject")',
                                            //contentType: "application/json; charset=utf-8",
                                            data: { from: from, to: to },
                                            type: 'POST',
                                            cache: false,
                                            success: function (result) {
                                                // r = result;
                                                window.location.reload();
                                            }
                                        });
                                    }
                                }
                                else {
                                    $.ajax({
                                        url: '@Url.Action("CloneEstimation", "CloneWorkItemPerProject")',
                                        //contentType: "application/json; charset=utf-8",
                                        data: { from: from, to: to },
                                        type: 'POST',
                                        cache: false,
                                        success: function (result) {
                                            // r = result;
                                            window.location.reload();
                                        }
                                    });
                                }
                            }
                        });
                    }
                }
            });

        } catch (e) {
            alert("Please select the Source and Destination Projects!!");
        }
        //});
    }
