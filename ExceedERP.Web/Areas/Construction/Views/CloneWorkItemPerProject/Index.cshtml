<script id="template" type="text/kendo-tmpl">
    #if(!IsSubCategory && !ContainsWorkItemAsInput){#
    @(Html.Kendo().TabStrip()
            .Name("tabstrip_#=GenericWorkItemPerProjectId#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("Detail").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.WorkItemDetailViewModel>()
                        .Name("detail__#=GenericWorkItemPerProjectId#")
                        .Columns(columns =>
                        {

                            columns.Bound(c => c.Attribute).Title(" ").ClientTemplate("\\#=Attribute\\#: \\#=Value\\#");
                        })

                            .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Events(events =>
                            {
                                events.Error("error_handler(\"detail__#=GenericWorkItemPerProjectId#\")");
                                events.RequestStart("onRequestStart(\"detail__#=GenericWorkItemPerProjectId#\")");
                                events.RequestEnd("onRequestEnd(\"detail__#=GenericWorkItemPerProjectId#\")");
                            })
                            .Model(model =>
                            {
                                model.Id(p => p.Id);
                            })
                            .Read(read => read.Action("SpecificWorkItemDetail_Read", "GenericWorkItemPerProject", new { workItemId = "#=GenericWorkItemPerProjectId#" }))
                        ).ToClientTemplate()
                    )
                </text>

                  );
              items.Add().Text("Material Cost").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.GenericProjectMaterial>()
                      .Name("ProjectMaterial_#=GenericWorkItemPerProjectId#")
                      .Columns(columns =>
                      {
                          columns.ForeignKey(c => c.ItemCategoryCode, (IEnumerable)ViewData["ItemCategorys"], "ItemCategoryCode", "Name").EditorTemplateName("ItemCategory").Width(200);
                          columns.ForeignKey(c => c.ItemCode, (IEnumerable)ViewData["Items"], "ItemCode", "Name").EditorTemplateName("Item").Width(200);
                          columns.Bound(c => c.Unit).Width(75);
                          columns.Bound(c => c.Quantity).Width(75);
                          columns.Bound(c => c.UnitPrice).Width(75);
                          columns.Bound(c => c.TotalCost).Width(75)
                               .ClientFooterTemplate("Total: \\#=sum\\#")
                              .ClientGroupFooterTemplate("Total: \\#=sum\\#");
                      })
                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .Events(e => e.Change("OnChange"))
                        .Selectable(selectable =>
                        {
                            selectable.Mode(GridSelectionMode.Single);
                            selectable.Type(GridSelectionType.Row);
                        })
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Events(events =>
                            {
                                events.Error("error_handler(\"ProjectMaterial_#=GenericWorkItemPerProjectId#\")");
                                events.RequestStart("onRequestStart(\"ProjectMaterial_#=GenericWorkItemPerProjectId#\")");
                                events.RequestEnd("onRequestEnd(\"ProjectMaterial_#=GenericWorkItemPerProjectId#\")");

                            })
                            .Aggregates(aggregates =>
                            {
                                aggregates.Add(p => p.TotalCost).Sum();
                                aggregates.Add(p => p.Quantity).Sum();
                                aggregates.Add(p => p.UnitPrice).Sum();
                            })
                            .Model(model =>
                            {
                                model.Id(p => p.GenericProjectMaterialId);
                                model.Field(p => p.TotalCost).Editable(false);
                                model.Field(p => p.Unit).Editable(false);
                            })
