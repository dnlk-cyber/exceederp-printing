                                events.RequestStart("onRequestStart(\"Labourgrid_#=GenericWorkItemPerProjectId#\")");
                                events.RequestEnd("onRequestEnd(\"Labourgrid_#=GenericWorkItemPerProjectId#\")");

                            })
                            .Aggregates(aggregates =>
                            {
                                aggregates.Add(p => p.TotalCost).Sum();
                                aggregates.Add(p => p.UnitFactory).Sum();
                                aggregates.Add(p => p.DailyPay).Sum();
                                aggregates.Add(p => p.Quantity).Sum();
                            })
                          .Model(model =>
                          {
                              model.Id(p => p.GenericProjectDirectLabourId);
                              model.Field(p => p.TotalCost).Editable(false);
                              model.Field(p => p.DailyPay).Editable(false);

                          })
                          .Read(read => read.Action("ProjectDirectLabour_Read", "GenericProjectDirectLabour", new { workItemId = "#=GenericWorkItemPerProjectId#" }))
                        //.Create(create => create.Action("ProjectDirectLabour_Create", "ProjectDirectLabour", new { idfour = "#=WorkItemPerProjectId#" }))
                        //.Update(update => update.Action("ProjectDirectLabour_Update", "ProjectDirectLabour"))
                        //.Destroy(destroy => destroy.Action("ProjectDirectLabour_Destroy", "ProjectDirectLabour"))
                        ).ToClientTemplate()
                    )
                </text>
                  );

              items.Add().Text("Equipment Cost").Content(
                @<text>

                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Construction.GenericProjectEquipment>()
                        .Name("Equipmentgrid_#=GenericWorkItemPerProjectId#")
                          .Columns(columns =>
                          {
                              //columns.ForeignKey(c => c.EquipmentIdentityID, (IEnumerable)ViewData["EquipmentIdentity"], "EquipmentIdentityID", "EquipmentCategoryName").EditorTemplateName("EquipmentCategory").Width(150);//
                              //columns.ForeignKey(c => c.EquipmentTypeID, (IEnumerable)ViewData["EquipmentType"], "EquipmentTypeID", "EquipmentTypeName").EditorTemplateName("EquipmentType").Width(150);//,
                              columns.ForeignKey(c => c.FleetsID, (IEnumerable)ViewData["Equipment"], "FleetsID", "EquipmentName").EditorTemplateName("Equipment").Width(150);//,
                              columns.Bound(c => c.Quantity).Title("No").Width(100);
