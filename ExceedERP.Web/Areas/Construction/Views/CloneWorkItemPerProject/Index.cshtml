@using ExceedERP.Core.Localization
@using System.Collections
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Clone Project Estimation</legend>
<br />
<div>
    <div class="toolbar">
        @*  @item.CreateButton()*@
        <label class="category-label">To :</label>
        @(Html.Kendo().ComboBox()
                    .Name("ProjectInformationId")
                    .Text("Project Name..")
                    //.BindTo((IEnumerable)ViewData["ProjectList"])
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetProjectsListToCopyEstimationTo", "DataProvider");
                        });
                //.ServerFiltering(false);
            })
                    .Filter("contains")
                    .DataTextField("Name")
                    .DataValueField("ProjectInformationId")
                    .HtmlAttributes(new { style = "width: 200px;" })
                    .ValuePrimitive(true)
                    .Events(x => x.Change("filterProject"))

        )
        <label class="category-label">From :</label>
        @(Html.Kendo().ComboBox()
                    .Name("ProjectInformationIdTwo")
                    .Text("Project Name..")
                    .DataSource(d =>
                    {
                        d.Read(r =>
                        {
                            r.Action(
                                "GetApprovedProjects", "DataProvider");
                            r.Data("InfoId");
                        })
                        .ServerFiltering(true);
                    })
                    .Filter("contains")
                    .DataTextField("Name")
                    .DataValueField("ProjectInformationIdTwo")
                    .HtmlAttributes(new { style = "width: 200px;" })
                    .ValuePrimitive(true)
                    .CascadeFrom("ProjectInformationId")
                    .Events(x => x.Change("CheckValue"))
        )

        @(Html.Kendo().Button()
                        .Name("btnSave")
                        .HtmlAttributes(new { type = "button", @class = "k-primary" })
                        .Events(e => e.Click("Copy"))
                        .Content("Clone")
                        .Enable(false)
                        .Icon("k-icon k-i-copy")
        )

        <a id="loadingButton" hidden> <i class="fa fa-spinner fa-spin fa-2x fa-fw"></i></a>
        <br />
        <br />
    </div>
</div>

