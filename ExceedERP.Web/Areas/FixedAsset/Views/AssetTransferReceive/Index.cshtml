                                  .RequestStart("onRequestStart(\"AssetTransferReceiveValidation_#=AssetTransferReceiveId#\")")
                                  .RequestEnd("onRequestEnd(\"AssetTransferReceiveValidation_#=AssetTransferReceiveId#\")"))

                              .Model(model => model.Id(p => p.AssetTransferReceiveValidationId))
                              .Read(read => read.Action("AssetTransferReceiveValidations_Read", "AssetTransferReceiveValidation", new { id = "#=AssetTransferReceiveId#" }))
                              .Create(create => create.Action("AssetTransferReceiveValidations_Create", "AssetTransferReceiveValidation", new { id = "#=AssetTransferReceiveId#" }))
                              .Update(update => update.Action("AssetTransferReceiveValidations_Update", "AssetTransferReceiveValidation"))
                              .Destroy(destroy => destroy.Action("AssetTransferReceiveValidations_Destroy", "AssetTransferReceiveValidation"))
                          ).ToClientTemplate())

        </text>
    );


}).ToClientTemplate())


</script>





<script>

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "AssetTransferReceive", new { area = "FixedAsset" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "AssetTransferReceive", new { area = "FixedAsset" })',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }


    function filterAssetsForTransfer() {

        return {
            subCategoryCode: $("#FixedAssetSubCategoryId").data("kendoDropDownList").value(),
            text: $("#AssetRegistrationId").data("kendoDropDownList").filterInput.val()
        };
    }

    function filterSubCategory() {

        return {
            categoryCode: $("#FixedAssetCategoryId").data("kendoDropDownList").value(),
            text: $("#FixedAssetSubCategoryId").data("kendoDropDownList").filterInput.val()
        };
    }



    function onSelectDriverType(e) {

        var grid = $("#grid").data("kendoGrid");
        var type = $("#DriverType").data("kendoDropDownList");
        var typeValue = type.value();

        if (typeValue === "1") {
            $("#supplierDiv").show();
            $("#employeeDiv").hide();
        } else if (typeValue === "0") {
            $("#supplierDiv").hide();
            $("#employeeDiv").show();
        }
    }

    

</script>