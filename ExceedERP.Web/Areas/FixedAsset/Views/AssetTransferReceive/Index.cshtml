@using System.Collections
@using ExceedERP.Core.Domain.FixedAsset.Transfers

<legend>Asset Transfer Receive</legend>
@(Html.Kendo().Grid<AssetTransferReceive>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.AssetTransferReceiveId).Title("#").Width(120).ClientTemplate("#=appendZeros(AssetTransferReceiveId)#");
          columns.Bound(c => c.AssetTransferId).Title("Transfer Send. No.").Width(120);
          columns.Bound(c => c.ReceiveDate).Width(130);
          columns.Bound(c => c.Remark).Width(90);
          columns.Bound(c => c.Status).Width(90);

          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("FixedAssetTransferReceive").Window(w => w.Title("Asset Transfer Receive")))
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Groupable()
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable(height => height.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("AssetTransferReceiveId").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.AssetTransferReceiveId);
              model.Field(p => p.Status).Editable(false);

          })
          .Read(read => read.Action("AssetTransferReceives_Read", "AssetTransferReceive"))
          .Create(create => create.Action("AssetTransferReceives_Create", "AssetTransferReceive"))
          .Update(update => update.Action("AssetTransferReceives_Update", "AssetTransferReceive"))
          .Destroy(destroy => destroy.Action("AssetTransferReceives_Destroy", "AssetTransferReceive"))
      )
      .ClientDetailTemplateId("Itemtransfertemplate"))

<script id="Itemtransfertemplate" type="text/Kendo-tmpl">
