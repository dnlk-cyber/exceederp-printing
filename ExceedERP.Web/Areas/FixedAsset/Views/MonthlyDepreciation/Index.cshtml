@using System.Collections
@using ExceedERP.Core.Domain.FixedAsset.Depreciation
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Monthly Depreciation</legend>

@(Html.Kendo().Grid<MonthlyDepreciation>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.MonthlyDepreciationId).Title("#").Width(50).ClientTemplate("#=appendZeros(MonthlyDepreciationId)#");
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").Width(200);
          columns.ForeignKey(p => p.GlFiscalYearId, (IEnumerable)ViewData["Years"], "GlFiscalYearId", "Name").Width(150);
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["Periods"], "GLPeriodId", "Name").Width(150);
          columns.Bound(c => c.Status).Width(130);

      })
      .ToolBar(toolbar =>
      {
          toolbar.Template(@<text>

                               @(Html.Kendo().DropDownList()
                                     .OptionLabel("Select Branch")
                                     .Name("branchSelector")
                                     .AutoBind(false)
                                     .DataValueField("Code")
                                     .DataTextField("Name")
                                     .HtmlAttributes(new { style = "width: 200px;" })
                                     .DataSource(dataSource =>
                                     {
                                         dataSource.Read(read => read.Action("GetBranches", "GlobalDataProvider", new { area = "Common" }))
                                             .ServerFiltering(false);
                                     }))

                               @(Html.Kendo().DropDownList()
                                     .OptionLabel("Select Year")
                                     .Name("yearSelector")
                                     .AutoBind(false)
                                     .DataValueField("GlFiscalYearId")
                                     .DataTextField("Name")
                                     .HtmlAttributes(new { style = "width: 200px;" })
                                     .DataSource(dataSource =>
                                     {
                                         dataSource.Read(read => read.Action("GetOpenYears", "GlobalDataProvider", new { area = "Common" }))
                                             .ServerFiltering(false);
                                     }))




                               @(Html.Kendo().DropDownList()
                                     .Name("periodSelector")
                                     .AutoBind(false)
                                     .DataValueField("GLPeriodId")
                                     .DataTextField("Name")
                                     .HtmlAttributes(new { style = "width: 200px;" })
                                     .DataSource(dataSource =>
                                     {
                                         dataSource.Read(read => read.Action("GetPeriods", "GlobalDataProvider", new { area = "Common" }).Data("getFiscalYear"))
                                             .ServerFiltering(true);
                                     })
                                     .CascadeFrom("yearSelector"))



                               @Html.Kendo().Button().Name("AnnualDepreciation").HtmlAttributes(new { type = "button", @class = "k-primary" }).Content("Run Depreciation").Events(ev => ev.Click("RunDepreciation"))
                               @*@Html.Kendo().Button().Name("Reverse").HtmlAttributes(new { type = "button", @class = "k-primary" }).Content("Reverse").Events(ev => ev.Click("reverseClicked"))
                    @Html.Kendo().Button().Name("Close").HtmlAttributes(new { type = "button", @class = "k-primary" }).Content("Close").Events(ev => ev.Click("closeClicked"))*@


                            </text>);



      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Sortable()
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      
      .Scrollable(h => h.Height(500))
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("MonthlyDepreciationId").Descending())
          .Model(model =>
          {
              model.Id(p => p.MonthlyDepreciationId);

          })

          .Read(read => read.Action("MonthlyDepreciations_Read", "MonthlyDepreciation"))
      ).ClientDetailTemplateId("itemstemplate"))

