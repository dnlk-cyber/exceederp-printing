<script>


    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendforApproval", "MonthlyDepreciation", new { area = "FixedAsset" })',
            data: { id: id },
            success: function (result) {
                //toastr.success(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");

        $.ajax({
            type: "POST",
            url: '@Url.Action("TransferDistribution", "MonthlyDepreciation", new { area = "FixedAsset" })',
            data: {
                id: id,
                description: desc
            },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }




    var selectedYear;
    var selectedBranch;
    var selectedPeriod;

    function RunDepreciation(e) {

        var year = $("#yearSelector").data("kendoDropDownList").value();
        var branch = $("#branchSelector").data("kendoDropDownList").value();
        var period = $("#periodSelector").data("kendoDropDownList").value();
        selectedYear = year;
        selectedPeriod = period;
        selectedBranch = branch;
        $('#loading-image').show();
        $.ajax({
            type: "GET",
            url: '@Url.Action("RunDepreciation", "MonthlyDepreciation")',
            contentType: "application/json; charset=utf-8",
            data: { fiscalyearid: year ,periodid:selectedPeriod, branchid:selectedBranch},
            dataType: "json",
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                $('#loading-image').hide();
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }

        });
    }


    function reverseClicked(e) {
        var year = $("#yearSelector").data("kendoDropDownList").value();
        var branch = $("#branchSelector").data("kendoDropDownList").value();
        var period = $("#periodSelector").data("kendoDropDownList").value();
        selectedYear = year;
        selectedPeriod = period;
        selectedBranch = branch;

        $.ajax({
            type: "GET",
            url: '@Url.Action("ReverseDepreciation", "AnnualDepreciation")',
            contentType: "application/json; charset=utf-8",
            data: { year: year, period: period, branch: branch },
            dataType: "json"

        });
    }
    function closeClicked(e) {
        var year = $("#yearSelector").data("kendoDropDownList").value();
        var branch = $("#branchSelector").data("kendoDropDownList").value();
        var period = $("#periodSelector").data("kendoDropDownList").value();
        selectedYear = year;
        selectedPeriod = period;
        selectedBranch = branch;

        $.ajax({
            type: "GET",
            url: '@Url.Action("CloseDepreciation", "AnnualDepreciation")',
            contentType: "application/json; charset=utf-8",
            data: { year: year, period: period, branch: branch },
            dataType: "json"

        });
    }
    function getFiscalYear(){
        return { year: $("#yearSelector").data("kendoDropDownList").value() }
    }

    function checkForEvaluation(e) {
        var year = $("#yearSelector").data("kendoDropDownList").value();
        var branch = $("#branchSelector").data("kendoDropDownList").value();
        var period = $("#periodSelector").data("kendoDropDownList").value();
        selectedYear = year;
        selectedPeriod = period;
        selectedBranch = branch;
        var depreciationBtn = $("#Depreciation").data("kendoButton");
        var reverseBtn = $("#Reverse").data("kendoButton");
        var closeBtn = $("#Close").data("kendoButton");

        $.ajax({
            type: "GET",

            dataType: 'json',
            contentType: "application/json;charset=utf-8",
            url: "/AnnualDepreciation/GetAnnualDepreciationState",
            data:  { year:selectedYear  , period: selectedPeriod , branch: selectedBranch },

            success: function (result) {
                debugger;

                if (result === "onEdit") {
                    depreciationBtn.enable(false);
                    reverseBtn.enable(true);
                    closeBtn.enable(true);
                }
                if (result === "Reversed") {
                    depreciationBtn.enable(true);
                    reverseBtn.enable(false);
                    closeBtn.enable(false);

                }
                if (result === "depreciation") {
                    depreciationBtn.enable(true);
                    reverseBtn.enable(false);
                    closeBtn.enable(false);

                }
                if (result === "previous") {
                    depreciationBtn.enable(false);
                    reverseBtn.enable(false);
                    closeBtn.enable(false);
                }

            },
            error: function (response) {
                debugger;
                alert('Unkown Error');
            }
        });
    }
</script>
