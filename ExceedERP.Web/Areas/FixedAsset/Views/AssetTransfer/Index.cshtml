                        # } #

                    </text>
                            );
    //Items Tab
                        items.Add().Text("Items").Content(
                            @<text>
                                @(Html.Kendo().Grid<AssetTransferItem>()
                                      .Name("AssetTransferItem_#=AssetTransferId#")
                                      .Columns(columns =>
                                      {
                                          columns.ForeignKey(p => p.FixedAssetCategoryId, (IEnumerable)ViewData["Category"], "FixedAssetCategoryID", "CategoryName").Title("Category").EditorTemplateName("CategorySelector").Width(150);
                                          columns.ForeignKey(p => p.FixedAssetSubCategoryId, (IEnumerable)ViewData["SubCategory"], "FixedAssetSubCategoryID", "SubCategoryName").Title("Sub Category").EditorTemplateName("SubCategorySelector").Width(150);
                                          columns.ForeignKey(p => p.AssetRegistrationId, (IEnumerable)ViewData["FixedAsset"], "AssetRegistrationId", "Name").Title("Item").EditorTemplateName("AssetSelector").Width(130);
                                          columns.Bound(c => c.TagNo).Width(90);
                                          columns.Bound(c => c.Size).Width(90);
                                          columns.Bound(c => c.SerialNo).Width(90);
                                          columns.Bound(c => c.ModelNo).Width(90);
                                          columns.Bound(c => c.Unit).Width(90);
                                          columns.Bound(c => c.SerialNo).Width(90);
                                          columns.Bound(c => c.Quantity).Width(90);
                                          columns.Bound(c => c.UnitPrice).Format("{0:n}").Width(80);
                                          columns.Bound(c => c.Total).Format("{0:n}").Width(80);
                                          columns.Bound(c => c.Remark).Width(100);

                                          columns.Command(command =>
                                          {
                                              command.Edit();
                                              command.Destroy();
                                          });
                                      })
                                      .ToolBar(toolbar =>
                                      {
                                          toolbar.Create();
                                      })
                                      .Events(x => x.DataBound("onDataBoundLines"))
                                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                                      .Scrollable()
                                      .DataSource(dataSource => dataSource
                                          .Ajax()
                                          .Events(ev => ev
                                              .Error("error_handler(\"AssetTransferItem_#=AssetTransferId#\")")
                                              .RequestStart("onRequestStart(\"AssetTransferItem_#=AssetTransferId#\")")
                                              .RequestEnd("onRequestEnd(\"AssetTransferItem_#=AssetTransferId#\")"))
                                          .Model(model =>
                                          {
                                              model.Id(p => p.AssetTransferItemId);
                                              model.Field(p => p.SerialNo).Editable(false);
                                              model.Field(p => p.TagNo).Editable(false);
                                              model.Field(p => p.ModelNo).Editable(false);
                                              model.Field(p => p.Size).Editable(false);
                                              model.Field(p => p.Unit).Editable(false);
                                              model.Field(p => p.UnitPrice).Editable(false);
                                              model.Field(p => p.Total).Editable(false);
                                              model.Field(p => p.SerialNo).Editable(false);
                                              model.Field(p => p.Name).Editable(false);
                                              model.Field(p => p.GrnNo).Editable(false);
                                              model.Field(p => p.ItemName).Editable(false);

                                              model.Field(p => p.DateCreated).Editable(false);
                                              model.Field(p => p.CreatedBy).Editable(false);
                                              model.Field(p => p.LastModified).Editable(false);
                                              model.Field(p => p.ModifiedBy).Editable(false);

