                                          .Read(read => read.Action("AssetTransferItems_Read", "AssetTransferItem", new { id = "#=AssetTransferId#" }))
                                          .Create(create => create.Action("AssetTransferItems_Create", "AssetTransferItem", new { id = "#=AssetTransferId#" }))
                                          .Update(update => update.Action("AssetTransferItems_Update", "AssetTransferItem", new { id = "#=AssetTransferId#" }))
                                          .Destroy(destroy => destroy.Action("AssetTransferItems_Destroy", "AssetTransferItem"))
                                      ).ToClientTemplate())

                            </text>
                                    );



    //Validation Tab
                                items.Add().Text("Validation").Content(
                                @<text>
                                    @(Html.Kendo().Grid<AssetTransferValidation>()
                                          .Name("AssetTransferValidation_#=AssetTransferId#")
                                          .Columns(columns =>
                                          {
                                              columns.Bound(c => c.Status).Width(170).EditorTemplateName("ApprovalStatus");
                                              columns.Bound(c => c.Remark).Width(170);
                                              columns.Command(command =>
                                              {
                                                  command.Edit();
                                                  //command.Destroy();
                                              });
                                          })
                                          .ToolBar(toolbar =>
                                          {
                                              toolbar.Create();
                                          })
                                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                                          .Scrollable()
                                          .Events(x => x.DataBound("onDataBoundFisrtValidation"))
                                          .DataSource(dataSource => dataSource
                                              .Ajax()
                                              .Events(ev => ev
                                                  .Error("error_handler(\"AssetTransferValidation_#=AssetTransferId#\")")
                                                  .RequestStart("onRequestStart(\"AssetTransferValidation_#=AssetTransferId#\")")
                                                  .RequestEnd("onRequestEnd(\"AssetTransferValidation_#=AssetTransferId#\")"))

                                              .Model(model => model.Id(p => p.AssetTransferValidationId))
                                              .Read(read => read.Action("AssetTransferValidations_Read", "AssetTransferValidation", new { id = "#=AssetTransferId#" }))
                                              .Create(create => create.Action("AssetTransferValidations_Create", "AssetTransferValidation", new { id = "#=AssetTransferId#" }))
                                              .Update(update => update.Action("AssetTransferValidations_Update", "AssetTransferValidation"))
                                              .Destroy(destroy => destroy.Action("AssetTransferValidations_Destroy", "AssetTransferValidation"))
                                          ).ToClientTemplate())

                                </text>
                                              );


                                  }).ToClientTemplate())


</script>





<script>

    var masterRow;
    var masterGrid;
    var masterDataItem;
    var custodianBeforeTransfer;
    var fromStoreCode;
    var expandedRow;
    var isapproved;
    var issecondapproved;
    var isSendForApproval;
    var isOnlineTransferred;

    function detailExpandAssetTransfer(e) {
        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);

        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;

        custodianBeforeTransfer = masterDataItem.CustodianBeforeTransfer;
        fromStoreCode = masterDataItem.FromStoreCode;

        // Only one open at a time
        if (expandedRow != null && expandedRow[0] != e.masterRow[0]) {
            masterGrid.collapseRow(expandedRow);
        }
        expandedRow = e.masterRow;

    }

    function filterEmployees() {
        return {
            text: $("#DeliveredBy").data("kendoDropDownList").filterInput.val(),
        }
    }

    function filterRecipients() {
        return {
            text: $("#RecipientEmployee").data("kendoDropDownList").filterInput.val(),
        }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "AssetTransfer", new { area = "FixedAsset" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "AssetTransfer", new { area = "FixedAsset" })',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }


    function filterAssetsForTransfer() {

        return {

            subCategoryCode: $("#FixedAssetSubCategoryId").data("kendoDropDownList").value(),

            custodianBeforeTransfer: custodianBeforeTransfer,

            fromStoreCode: fromStoreCode, 

            text: $("#AssetRegistrationId").data("kendoDropDownList").filterInput.val()

        };
    }

    function filterSubCategory() {

        return {
            categoryCode: $("#FixedAssetCategoryId").data("kendoDropDownList").value(),
            text: $("#FixedAssetSubCategoryId").data("kendoDropDownList").filterInput.val()
        };
    }



    function onSelectDriverType(e) {

        var grid = $("#grid").data("kendoGrid");
        var type = $("#DriverType").data("kendoDropDownList");
        var typeValue = type.value();

        if (typeValue === "1") {
            $("#supplierDiv").show();
            $("#employeeDiv").hide();
        } else if (typeValue === "0") {
            $("#supplierDiv").hide();
            $("#employeeDiv").show();
        }
    }

    function onSelectRecipientType(e) {

        var grid = $("#grid").data("kendoGrid");
        var type = $("#RecipientType").data("kendoDropDownList");
        var typeValue = type.value();

        if (typeValue === "1") {
            $("#supplierRecipientDiv").show();
            $("#employeeRecipientDiv").hide();
        } else if (typeValue === "0") {
            $("#supplierRecipientDiv").hide();
            $("#employeeRecipientDiv").show();
        }
    }

    //added
    function onSelectTransferType() {
        var type = $("#Type").data("kendoDropDownList").value();
        if (type == 1) {
            $(".personperson").show();
            $(".all").show();
            $(".storestore").hide();

        }
        else if (type == 2) {
            $(".storestore").show();
            $(".all").show();
            $(".personperson").hide();

        } else {
            $(".storestore").hide();
            $(".personperson").hide();
            $(".all").hide();
        }
        

    }
    function onSelectDelivererType() {
        var type = $("#DriverType").data("kendoDropDownList").value();
        if (type == 1) {
            $(".internalDel").show();
            $(".all").show();
            $(".externalSup").hide();


        }
        else if (type == 2) {
            $(".externalSup").show();
            $(".all").show();
            $(".internalDel").hide();

        } else {
            $(".internalDel").hide();
            $(".externalSup").hide();
            $(".all").hide();

        }


    }

</script>