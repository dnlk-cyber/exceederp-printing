@using System.Collections
@using ExceedERP.Core.Domain.FixedAsset.Transfers

<legend>Asset Transfer</legend>
@(Html.Kendo().Grid<AssetTransfer>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.AssetTransferId).Title("#").Width(120).ClientTemplate("#=appendZeros(AssetTransferId)#");
          columns.Bound(c => c.RequestNumber).Title("Req. No.").Width(120);
          columns.Bound(c => c.TransferDate).Width(130);
          columns.Bound(c => c.TransferDesc).Width(170);
          columns.ForeignKey(p => p.CustodianBeforeTransfer, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Width(170).EditorTemplateName("EmployeeSelector");
          columns.ForeignKey(p => p.TransferTo, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Width(120).EditorTemplateName("EmployeeSelector");
          columns.ForeignKey(p => p.FromStoreCode, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Width(150).EditorTemplateName("StoreReadOnly");
          columns.ForeignKey(p => p.ToStoreCode, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Width(150).EditorTemplateName("StoreReadOnly");
          //columns.Bound(c => c.ConfirmReceive).Width(90).Title("Confirm Receive").ClientTemplate("<input type='checkbox' disabled = 'true'  value='#=ConfirmReceive #' " + " # if (ConfirmReceive) { #" + "checked='checked'" + "# } #" + " />").Width(100);
          columns.Bound(c => c.Remark).Width(90);
          columns.Bound(c => c.Status).Width(90);

          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("FixedAssetTransfer").Window(w => w.Title("Asset Transfer")))
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()

      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable(height => height.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .Events(e => e.DetailExpand("detailExpandAssetTransfer"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("AssetTransferId").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.AssetTransferId);
              model.Field(p => p.Status).Editable(false);
              model.Field(p => p.ConfirmReceive).Editable(false);

          })
          .Read(read => read.Action("AssetTransfers_Read", "AssetTransfer"))
          .Create(create => create.Action("AssetTransfers_Create", "AssetTransfer"))
          .Update(update => update.Action("AssetTransfers_Update", "AssetTransfer"))
          .Destroy(destroy => destroy.Action("AssetTransfers_Destroy", "AssetTransfer"))
      )
      .ClientDetailTemplateId("Itemtransfertemplate"))

@* Tabs *@
<script id="Itemtransfertemplate" type="text/Kendo-tmpl">
