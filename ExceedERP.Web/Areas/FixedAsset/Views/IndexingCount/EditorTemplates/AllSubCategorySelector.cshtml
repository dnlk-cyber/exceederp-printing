@(Html.Kendo().DropDownListFor(m => m)
                  .ValuePrimitive(true)
                  .OptionLabel("Select Sub Category...")
                      .DataTextField("Name")
                                  .DataValueField("SubCategoryCode")
                              .Filter("contains")
                               .DataSource(dataSource =>
                              {
                                  dataSource.Read(read => read.Action("GetAllSubCategory", "FixedAssetDataProvider", new { area = "FixedAsset" }))
                                            .ServerFiltering(false);
                              })
                                     
                                   
)
@Html.ValidationMessageFor(m => m)
