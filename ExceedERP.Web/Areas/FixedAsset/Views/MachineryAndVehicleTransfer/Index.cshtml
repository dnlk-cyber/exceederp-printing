@using System.Collections
@using ExceedERP.Core.Domain.FixedAsset.Transfers

<legend>Machinery And Vehicle Transfer</legend>
@(Html.Kendo().Grid<MachineryAndVehicleTransfer>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.RequestNumber).Title("#").Width(120).ClientTemplate("#=appendZeros(MachineryAndVehicleTransferId)#");
          columns.Bound(c => c.RequestNumber).Title("Req. No.").Width(90);
          columns.ForeignKey(p => p.FixedAssetCategoryID, (IEnumerable)ViewData["Category"], "FixedAssetCategoryID", "CategoryName").Title("Category").EditorTemplateName("FixedAssetCategorySelector").Width(120);
          columns.ForeignKey(p => p.FixedAssetSubCategoryID, (IEnumerable)ViewData["SubCategory"], "FixedAssetSubCategoryID", "SubCategoryName").Title("Sub Category").EditorTemplateName("FixedAssetSubCategorySelector").Width(120);
          columns.ForeignKey(p => p.AssetRegistrationId, (IEnumerable)ViewData["FixedAsset"], "AssetRegistrationId", "Name").Title("Item").EditorTemplateName("FixedAssetIssueSelector").Width(120);
          columns.Bound(c => c.TransferDate).Width(90);
          columns.Bound(c => c.UsageDays).Width(90);
          columns.Bound(c => c.TransferDesc).Width(120);
          columns.ForeignKey(p => p.CustodianBeforeTransfer, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Width(110).EditorTemplateName("EmployeeSelector");
          columns.Bound(c => c.LocationBeforeTransfer).Width(110);
          columns.ForeignKey(p => p.TransferTo, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Width(110).EditorTemplateName("EmployeeSelector");
          columns.ForeignKey(p => p.FromStoreCode, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Width(110).EditorTemplateName("StoreReadOnly");
          columns.ForeignKey(p => p.ToStoreCode, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Width(110).EditorTemplateName("StoreReadOnly");
          columns.Bound(c => c.TransferReason).Width(110);
          columns.Bound(c => c.TransferBy).Width(110);
          columns.Bound(c => c.DriverName).Width(110);
          columns.Bound(c => c.TransferPlateNo).Width(90);
          //columns.Bound(c => c.Manufacturer).Hidden();
          //columns.Bound(c => c.ModelNo).Hidden();
          //columns.Bound(c => c.ChassisNo).Hidden();
          //columns.Bound(c => c.SerialNo).Hidden();
          //columns.Bound(c => c.PlateNo).Hidden();
          //columns.Bound(c => c.EngineNo).Hidden();
          //columns.Bound(c => c.TagNo).Hidden();
          //columns.Bound(c => c.BarCodeNo).Hidden();
          //columns.Bound(c => c.KmHourReading).Hidden();
          //columns.Bound(c => c.FuelVolume).Hidden();
          //columns.Bound(c => c.HydraulicOilVolume).Hidden();
          //columns.Bound(c => c.BatteryAmpere).Hidden();
          //columns.Bound(c => c.BatteryStatus).Hidden();
          //columns.Bound(c => c.BatteryQuantity).Hidden();

          columns.Bound(c => c.Remark).Width(80);
          columns.Bound(c => c.Status).Width(80);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(120);
      })
      .ToolBar(toolbar => {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("FixedAssetMachineTransfer").Window(w => w.Title("Machinery and Vehicle Transfer")))
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Groupable()
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable(height => height.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("MachineryAndVehicleTransferId").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.MachineryAndVehicleTransferId);
              model.Field(p => p.Status).Editable(false);

          })
          .Read(read => read.Action("MachineryAndVehicleTransfers_Read", "MachineryAndVehicleTransfer"))
          .Create(create => create.Action("MachineryAndVehicleTransfers_Create", "MachineryAndVehicleTransfer"))
          .Update(update => update.Action("MachineryAndVehicleTransfers_Update", "MachineryAndVehicleTransfer"))
          .Destroy(destroy => destroy.Action("MachineryAndVehicleTransfers_Destroy", "MachineryAndVehicleTransfer"))
      )
      .ClientDetailTemplateId("Itemtransfertemplate"))

