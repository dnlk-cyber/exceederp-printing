@using System.Collections
@using ExceedERP.Core.Domain.FixedAsset.Requisitions
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Self Service - PPE Store Requisition</legend>

@(Html.Kendo().Grid<FixedAssetRequisition>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.FixedAssetRequisitionId).Title("Request No.").Width(120).ClientTemplate("#=appendZeros(FixedAssetRequisitionId)#");
          columns.Bound(c => c.Reference).Title("Reference").Width(120);
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["fixedassetPeriods"], "GLPeriodId", "Name").Width(120).Title("Period").EditorTemplateName("FixedAssetPeriodSelector");
          columns.Bound(c => c.RequestDate).Width(150);
          columns.ForeignKey(p => p.StoreCode, (IEnumerable)ViewData["storesInCompany"], "StoreCode", "Name").Title("Store").Width(160).EditorTemplateName("StoresSelector");
          columns.Bound(c => c.IsTransfer).EditorTemplateName("IsTransferRequest").ClientTemplate("<input type='checkbox' disabled = 'true'  value='#=IsTransfer #' " + " # if (IsTransfer) { #" + "checked='checked'" + "# } #" + " />").Width(110);
          columns.ForeignKey(p => p.ToStoreCode, (IEnumerable)ViewData["storesInCompany"], "StoreCode", "Name").Title("To Store").Width(160).EditorTemplateName("StoresSelector");
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(150);
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(150).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(150).EditorTemplateName("EmployeeSelector");
          columns.Bound(c => c.PlateNo).Width(120);
          columns.Bound(c => c.Remark).Width(120);
          columns.Bound(c => c.Status).Width(100);
          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          }).Width(180);

      }).Filterable()
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .ToolBar(toolbar =>
      {

          toolbar.Template(@<text>
                               <div class="toolbar row">
                                   <div class="col-md-1">
                                       <a class="k-button k-button-icontext k-grid-add" href='#'>Add New</a>
                                   </div>
                                   @*<div class="col-md-2 pull-right">
                                @(Html.Kendo().Upload()
                                            .Name("file")
                                            .Async(a => a.Save("StoreRequistion_Import", "FixedAssetRequisition"))
                                            .Events(e => e.Complete("onUploadSuccess").Upload("checkFileType"))
                                            .ShowFileList(false)
                                )
                            </div>*@

                               </div>

                            </text>);
      })
      .Events(ev => ev.Edit("onMasterEdit"))
            
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      
      .Events(ev => ev.DetailExpand("detailExpandFixedAssetRequisition"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMasterFixedAssetRequisition"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .ServerOperation(true)
          .Sort(sort => sort.Add("FixedAssetRequisitionId").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .PageSize(20)
          .Model(model =>
          {
              model.Id(p => p.FixedAssetRequisitionId);
              model.Field(p => p.FixedAssetRequisitionId).Editable(false);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.OrgStructureId).Editable(false);
              //model.Field(p => p.EmployeeId).Editable(false);
              model.Field(p => p.Status).Editable(false);
              model.Field(p => p.NextApprover).Editable(false);
              // model.Field(p => p.RequestDate).Editable(false);
          })
          .Read(read => read.Action("FixedAssetRequisitions_Read", "FixedAssetRequisitionSelfCare"))
          .Create(create => create.Action("FixedAssetRequisitions_Create", "FixedAssetRequisitionSelfCare"))
          .Update(update => update.Action("FixedAssetRequisitions_Update", "FixedAssetRequisitionSelfCare"))
          .Destroy(destroy => destroy.Action("FixedAssetRequisitions_Destroy", "FixedAssetRequisitionSelfCare"))

      ).Resizable(resize => resize.Columns(true))
      .ClientDetailTemplateId("FixedAssetRequisitions"))

