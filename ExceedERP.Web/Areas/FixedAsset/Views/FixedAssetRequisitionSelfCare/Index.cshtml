<script>

    function filterSubCategoryNames() {

        return {
            subCategoryCode: $("#FixedAssetSubCategoryID").data("kendoDropDownList").value(),
            text: $("#FixedAssetNameID").data("kendoDropDownList").filterInput.val()
        };
    }

    var supplierTextBox;
    var popup;
    var slectedUser;
    function SelectApprover(e) {

        supplierTextBox = $(e).prev('input').attr('id');
        popup = window.open('/Common/GlobalDataProvider/GetFixedAssetSecondApproverSelector', 'WindowPopup', 'top=100, left=400, width=300, height=220,resizable=no,');
        popup.focus();
        return false;
    }

    function setChoice(user) {
        slectedUser = user;
        $("#" + supplierTextBox).val(slectedUser).trigger("change");
    }


  

    function test() {
        var recordStatus = "";
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetStatus", "FixedAssetRequisition")',
            data: { id: codeid },
            success: function(result) {
                toastr.error(result.Message);
                recordStatus = result.Status;

            }, //end succ
            error: function(result) {
                alert(result);
            }
        });

        @*if (recordStatus !== "False") {
            toastr.success("Updating.");
            $.ajax({
                type: "GET",
                url: '@Url.Action("Variation", "PropertyCount")',
                contentType: "application/json; charset=utf-8",
                data: { id: codeid },
                dataType: "json"
            });
        }*@
        

    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "FixedAssetRequisition", new { area = "FixedAsset" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function sendForSecondApproval(id) {
        var recordStatus = "";
        var user = $("#NextApprover").val();
        if (user.length === 0)
            alert("Please select approver");
        else {
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForSecondApproval", "FixedAssetRequisition", new { area = "FixedAsset" })',
            data: {
                id: id,
                user: user
            },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
            });
        }
    }

    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "FixedAssetRequisition", new { area = "FixedAsset" })',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }


    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    var masid;
    var isapproved;
    var issecondapproved;
    var isSendForApproval;
    var ismiddleapproved;
    var ismiddleSendForApproval;
    var isOnlineTransferred;
    var nextApprover;

    function detailExpandFixedAssetRequisition(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        //codeid = masterDataItem.StoreRequisitionID;
        masid = masterDataItem.FixedAssetRequisitionId;
        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        ismiddleapproved = masterDataItem.IsMiddleOnlineApproved;
        ismiddleSendForApproval = masterDataItem.IsMiddleSendForApproval;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;
        nextApprover = masterDataItem.NextApprover;
       

    }
    function onDataBoundMasterFixedAssetRequisition(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved || gridData[i].IsSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }
        
        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]); 
            var dataItem = e.sender.dataItem(row);

            if (!dataItem.IsSendForApproval) {
                row.css("background-color", "lightskyblue");
            }
            if (dataItem.IsSendForApproval && !dataItem.IsOnlineApproved) {
                row.css("background-color", "lightgreen");
            }

            if (dataItem.IsOnlineApproved && !dataItem.IsMiddleSendForApproval) {
                row.css("background-color", "orange");
                row.css("color", "black");
            }

            if (dataItem.IsMiddleSendForApproval && !dataItem.IsMiddleOnlineApproved) {
                row.css("background-color", "cyan");
            }
            if (dataItem.IsMiddleOnlineApproved && !dataItem.IsSecondSendForApproval) {
                row.css("background-color", "lightgray");
            }
        }


    }
    function onSave() {
       $("#grid").data("kendoGrid").dataSource.read();
        $("#FixedAssetRequisitionSecondValidation_" + masid).data("kendoGrid").dataSource.read();
        $("#FixedAssetRequisitionValidation_" + masid).data("kendoGrid").dataSource.read();
        location.reload();

    }
    function onDataBoundLinesFixedAssetRequisition(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionItem_" + codeid;
        if (isapproved || isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundFisrtValidationFixedAssetRequisition(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionValidation_" + codeid;

        if (isapproved || !isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }
    function onDataBoundSecondValidationFixedAssetRequisition(e) {
        var detailGrid = "#" + e.sender.element[0].id;

        if (ismiddleapproved || !ismiddleSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        var currentuser =@Html.Raw(Json.Encode(ViewBag.User));
       
        if (currentuser !== nextApprover)
        {
            $(".k-grid-add", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }

