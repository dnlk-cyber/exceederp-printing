@(Html.Kendo().DropDownListFor(m => m)
      .ValuePrimitive(true)
      .OptionLabel("Select Category...")
      .DataTextField("Name")
      .DataValueField("FixedAssetCategoryID")
      .Filter("contains")
      .DataSource(dataSource =>
      {
          dataSource.Read(read => read.Action("GetCategory", "FixedAssetDataProvider", new { area = "FixedAsset" }))
              .ServerFiltering(false);
      })
      )
@Html.ValidationMessageFor(m => m)
