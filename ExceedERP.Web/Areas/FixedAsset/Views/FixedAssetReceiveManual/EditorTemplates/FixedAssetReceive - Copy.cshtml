@using ExceedERP.Core.Domain.FleetManagement.FleetRegistration
@model ExceedERP.Core.Domain.FixedAsset.Receives.FixedAssetReceiveItem

<div class="form">
<div class="row fullrow">
@(Html.Kendo().TabStrip()
      .Name("tabstrip")
      .SelectedIndex(0)
      .Animation(false)
      .Items(items =>
      {

          items.Add()
              .Text("Basic Information")
              .Content(@<text>
                           <div class="col-md-3 ro1">
                               
                               <div class="form-group">
                                   @Html.LabelFor(model => model.CategoryCode, htmlAttributes: new { @class = "control-label col-md-6" })
                                   <div class="col-md-6">
                                       @(Html.Kendo().DropDownListFor(model => model.CategoryCode)
                                .ValuePrimitive(true)
                                .OptionLabel("Select category...")
                                .DataTextField("Name")
                                .DataValueField("CategoryCode")
                                .DataSource(dataSource =>
                                    {
                                        dataSource.Read(read => read.Action("GetCategory", "FixedAssetDataProvider", new { area = "FixedAsset" }))
                                        .ServerFiltering(true);
                                    })
                                     )
                                       @Html.ValidationMessageFor(model => model.CategoryCode, "", new { @class = "text-danger" })
                                   </div>
                               </div>
                               <div class="row"></div>

                               <div class="form-group">
                                   @Html.LabelFor(model => model.Name, htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.Name)
                                       @Html.ValidationMessageFor(model => model.Name, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                           
                               <div class = "row"></div>
                              
                               <div class="form-group">
                                   @Html.LabelFor(model => model.Quantity, htmlAttributes: new { @class = "control-label col-md-6" })
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.Quantity)
                                       @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger" })
                                   </div>
                               </div>
                               <div class="row"></div>
                               
                               <div class="form-group">
                                   @Html.LabelFor(model => model.UnitPrice, htmlAttributes: new { @class = "control-label col-md-6" })
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.UnitPrice)
                                       @Html.ValidationMessageFor(model => model.UnitPrice, "", new { @class = "text-danger" })
                                   </div>
                               </div>
                               <div class="row"></div>
                               
                               <div class="form-group">
                                   @Html.LabelFor(model => model.GLTaxRateID, htmlAttributes: new { @class = "control-label col-md-6" })
                                   <div class="col-md-6">
                                       @(Html.Kendo().DropDownListFor(model => model.GLTaxRateID)
                                .ValuePrimitive(true)
                                .OptionLabel("Select category...")
                                .DataTextField("Name")
                                        .DataValueField("GLTaxRateID")
                                   
                                    .DataSource(dataSource =>
                                    {
                                        dataSource.Read(read => read.Action("GetTax", "DataProvider", new { area = "Inventory" }))
                                        .ServerFiltering(false);
                                    })
                                       )
                                       @Html.ValidationMessageFor(model => model.GLTaxRateID, "", new { @class = "text-danger" })
                                   </div>
                               </div>
                               <div class="row"></div>
                           </div>

                           <div class="col-md-3 ro1">
                                
                               <div class="form-group">
                                   @Html.LabelFor(model => model.SubCategoryCode, htmlAttributes: new { @class = "control-label col-md-6" })
                                   <div class="col-md-6">
                                       @(Html.Kendo().DropDownListFor(model => model.SubCategoryCode)
                                             .ValuePrimitive(true)
                                             .OptionLabel("Select Sub Category...")
                                             .DataTextField("Name")
                                             .DataValueField("SubCategoryCode")
                                             .DataSource(dataSource =>
                                             {
                                                 dataSource.Read(read => read.Action("GetSubCategory", "FixedAssetDataProvider", new { area = "FixedAsset" }).Data("filterSubCategories"))
                                                     .ServerFiltering(true);
                                             })
                                             .CascadeFrom("CategoryCode")
                                             )
                                       @Html.ValidationMessageFor(model => model.SubCategoryCode, "", new { @class = "text-danger" })
                                   </div>
                               </div>

                               <div class="row"></div>

                              
                              

                           </div>

                           <div class="col-md-3 ro1"></div>

                        </text>);

          items.Add()
              .Text("Value")
              .Content(@<text>

                           <div class="col-md-3 ro1">
                              
                               <div class="form-group">
                                   <br/>
                                   <br/>
                                   @Html.LabelFor(model => model.IsMachinery, htmlAttributes: new { @class = "control-label col-md-6" })
                                   <div class="col-md-6">
                                       @Html.Kendo().CheckBoxFor(model => model.IsMachinery).HtmlAttributes(new { @class = "chb" })
                                       @Html.ValidationMessageFor(model => model.IsMachinery, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>
                           </div>

                            <div class="col-md-3 ro1">


                                <div class="form-group">
                                    <br />
                                    <br />
                                    @Html.LabelFor(model => model.IsBuilding, htmlAttributes: new { @class = "control-label col-md-6" })
                                    <div class="col-md-6">

                                        @Html.Kendo().CheckBoxFor(model => model.IsBuilding).HtmlAttributes(new {@class = "chb"})
                                        @Html.ValidationMessageFor(model => model.IsBuilding, "", new {@class = "text-danger"})
                                    </div>
                                </div>
                                <div class="row"></div>
                            </div>
                          
                        </text>);

          items.Add()
              .Text("Machinary Info")
              .Content(@<text>

                           <div class="col-md-3 ro1">
                             

                               <div class="form-group">
                                   @Html.LabelFor(model => model.SerialNo, htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.SerialNo)
                                       @Html.ValidationMessageFor(model => model.SerialNo, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>

                               <div class="form-group">
                                   @Html.LabelFor(model => model.PlateNo, htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.PlateNo)
                                       @Html.ValidationMessageFor(model => model.PlateNo, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>

                             
                           </div>

                           <div class="col-md-3 ro1">

                              
                               <div class="form-group">
                                   @Html.LabelFor(model => model.BatchNo, htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.BatchNo)
                                       @Html.ValidationMessageFor(model => model.BatchNo, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>

                               <div class="form-group">
                                   @Html.LabelFor(model => model.SerialNo, htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.SerialNo)
                                       @Html.ValidationMessageFor(model => model.SerialNo, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>
                               
                               <div class="form-group">
                                   @Html.LabelFor(model => model.ChassisNo, htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.ChassisNo)
                                       @Html.ValidationMessageFor(model => model.ChassisNo, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>

                               <div class="form-group">
                                   @Html.LabelFor(model => model.EngineNo, htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.EngineNo)
                                       @Html.ValidationMessageFor(model => model.EngineNo, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>

                               <div class="form-group">
                                   @Html.LabelFor(model => model.Supplier, htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.Supplier)
                                       @Html.ValidationMessageFor(model => model.Supplier, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>
                           </div>

                           <div class="col-md-3 ro1">
                               <div class="form-group">
                                   @Html.LabelFor(model => model.ManufacturDate, htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.ManufacturDate)
                                       @Html.ValidationMessageFor(model => model.ManufacturDate, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>

                               <div class="form-group">
                                   @Html.LabelFor(model => model.Manufacturer, htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.Manufacturer)
                                       @Html.ValidationMessageFor(model => model.Manufacturer, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>

                             
                           </div>

                        </text>);

          items.Add()
              .Text("Building Information")
              .Content(@<text>

                           <div class="col-md-3 ro1">
                               <div class="form-group">
                                   @Html.LabelFor(model => model.Location, htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.Location)
                                       @Html.ValidationMessageFor(model => model.Location, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>

                               <div class="form-group">
                                   @Html.LabelFor(model => model.Contractor, htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().TextBoxFor(model => model.Contractor)
                                       @Html.ValidationMessageFor(model => model.Contractor, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>
                           </div>

                           <div class="col-md-3 ro1">
                               <div class="form-group">
                                   @Html.LabelFor(model => model.ConstructionStartDate, "Const. Start Date", htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().DateTimePickerFor(model => model.ConstructionStartDate)
                                       @Html.ValidationMessageFor(model => model.ConstructionStartDate, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>
                           </div>

                           <div class="col-md-3 ro1">
                               <div class="form-group">
                                   @Html.LabelFor(model => model.ConstructionEndDate, "Const. End Date", htmlAttributes: new {@class = "control-label col-md-6"})
                                   <div class="col-md-6">
                                       @Html.Kendo().DateTimePickerFor(model => model.ConstructionEndDate)
                                       @Html.ValidationMessageFor(model => model.ConstructionEndDate, "", new {@class = "text-danger"})
                                   </div>
                               </div>
                               <div class="row"></div>
                           </div>
                        </text>);
      })
      )
</div>
</div>


