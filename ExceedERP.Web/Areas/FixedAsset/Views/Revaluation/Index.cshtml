
@(Html.Kendo().Grid<ExceedERP.Core.Domain.FixedAsset.FixedAsset.Revaluation>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.AddedValue);
        columns.Bound(c => c.Description);
        columns.Bound(c => c.OrgBranchName);
        columns.Bound(c => c.DateCreated);
        columns.Bound(c => c.LastModified);
        columns.Bound(c => c.CreatedBy);
        columns.Bound(c => c.ModifiedBy);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
            toolbar.Excel();
           // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Pageable()
      .Filterable()
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.RevaluationID))
          .Read(read => read.Action("Revaluations_Read", "Revaluation").Data("sendForgery"))
          .Create(create => create.Action("Revaluations_Create", "Revaluation").Data("sendForgery"))
          .Update(update => update.Action("Revaluations_Update", "Revaluation").Data("sendForgery"))
          .Destroy(destroy => destroy.Action("Revaluations_Destroy", "Revaluation").Data("sendForgery"))
      )
)
