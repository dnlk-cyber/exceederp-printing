@using ExceedERP.Core.Domain.HRM
@(Html.Kendo().DropDownListFor(m => m)
.Name( "Values")
.OptionLabel( "Select Values..")
    .ValuePrimitive(true)
        .DataTextField("Text")
            .DataValueField("Text")
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetCascadeCurrentValue", " FixedAssetSetting")
                            .Data("filterAttributes");
                    })
                    .ServerFiltering(true);
                })
            .AutoBind( false)
                    .CascadeFrom("Attribute")
)
@Html.ValidationMessageFor(m => m)