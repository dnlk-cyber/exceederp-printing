<script>

    var supplierTextBox;
    var popup;
    var slectedUser;
    function SelectApprover(e) {

        supplierTextBox = $(e).prev('input').attr('id');
        popup = window.open('/Common/GlobalDataProvider/GetFixedAssetSecondApproverSelector', 'WindowPopup', 'top=100, left=400, width=300, height=220,resizable=no,');
        popup.focus();
        return false;
    }

    function setChoice(user) {
        slectedUser = user;
        $("#" + supplierTextBox).val(slectedUser).trigger("change");
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "PurchaseRequisition", new { area = "FixedAsset" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function sendForSecondApproval(id) {
        var recordStatus = "";
        var user = $("#NextApprover").val();
        if (user.length === 0)
            alert("Please select approver");
        else {
            $.ajax({
                type: "POST",
                url: '@Url.Action("SendForSecondApproval", "PurchaseRequisitionService", new { area = "Procurement" })',
                data: {
                    id: id,
                    user: user
                },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }


    function onItemEdit(e) {

        if (e.model.isNew() === false) {
            $("#ItemCategoryCode").attr("readonly", true);
            $("#ItemCode").attr("readonly", true);
            $("#PartNo").attr("readonly", true);
           // $("#Quantity").attr("readonly", true);

            //var dropdownlistCat = $("#ItemCategoryCode").data("kendoDropDownList");
            //dropdownlistCat.enable(false);

           
        }
    }


    function filterAssetNames() {

        return {
            subCategoryCode: $("#ItmCode").data("kendoDropDownList").value(),
            text: $("#Name").data("kendoDropDownList").filterInput.val()
        };
    }

    function filterSubCategory() {

        return {
            categoryCode: $("#CatCode").data("kendoDropDownList").value(),
            text: $("#ItmCode").data("kendoDropDownList").filterInput.val()
        };
    }


    function onSelectedPeriod() {
        var periodName = $("#GLPeriodId").data("kendoDropDownList").value();
        var min = "";
        var max = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPeriodDateRangeById", "FixedAssetDataProvider", new { area = "FixedAsset" })',
            data: { id: periodName },
            success: function (result) {
                min = result.Min;
                max = result.Max;
                //update
                var datepicker = $("#RequestDate").data("kendoDatePicker");
                datepicker.setOptions({
                    format: "yyyy-MM-dd",
                    min:min,
                    max:max,
                    value: new Date(),
                    change: onDOBChange
                });
            }, //end succ
            error: function (result) {
                alert(result);
            }

        });

    }

    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    var isapproved;
    var issecondapproved;
    var isSendForApproval;
    var ismiddleapproved;
    var ismiddleSendForApproval;
    var isOnlineTransferred;
    var nextApprover;

    function detailExpandFixedRequisition(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        //codeid = masterDataItem.StoreRequisitionID;
        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        ismiddleapproved = masterDataItem.IsMiddleOnlineApproved;
        ismiddleSendForApproval = masterDataItem.IsMiddleSendForApproval;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;
        nextApprover = masterDataItem.NextApprover;

    }
    function onDataBoundMasterFixedRequisition() {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved || gridData[i].IsSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var data = this.dataSource.data();
        $.each(data, function (i, row) {
            if (row.get("IsOnlineApproved") === "true") {
                var element1 = $('tr[data-uid="' + row.uid + '"] ');
                element1.addClass("approved-row");
            }

            if (row.get("IsSecondOnlineApproved") === "true") {
                var element2 = $('tr[data-uid="' + row.uid + '"] ');
                element2.addClass("secondapproved-row");
            }

            if (row.get("IsVoid") === "true") {
                var element3 = $('tr[data-uid="' + row.uid + '"] ');
                element3.addClass("void-row");
            }
        });
    }
    function onDataBoundLinesFixedRequisition(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionItem_" + codeid;
        if (isapproved || isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundFisrtValidationFixedRequisition(e) {

        var detailGrid = "#" + e.sender.element[0].id;

        if (isapproved || !isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }
    function onDataBoundSecondValidationFixedRequisition(e) {
        var detailGrid = "#" + e.sender.element[0].id;

        if (ismiddleapproved || !ismiddleSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        var currentuser =@Html.Raw(Json.Encode(ViewBag.User));
       
        if (currentuser !== nextApprover)
        {
            $(".k-grid-add", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }






    function OnIndexCall(elem) {

        var a = codeid;
        $(elem).attr('href', $(elem).attr('href') + '?id=' + a);


    }
    function autocompleteValue(e) {
        var DataItem = this.dataItem(e.item.index());
        var code = DataItem.code;
        $("#ProcurementOfficer").val(code);


    }
</script>
