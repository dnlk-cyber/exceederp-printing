@(Html.Kendo().DropDownListFor(m => m)
      .ValuePrimitive(true)
      .OptionLabel("Select Name...")
      .DataTextField("Name")
      .DataValueField("Name")
      .Filter("contains")
      .DataSource(dataSource =>
      {
          dataSource.Read(read => read.Action("GetSubCategoryName", "FixedAssetDataProvider", new { area = "FixedAsset" }).Data("filterAssetNames"))
              .ServerFiltering(true);
      })
      .CascadeFrom("ItmCode")
                                   
      )
@Html.ValidationMessageFor(m => m)
