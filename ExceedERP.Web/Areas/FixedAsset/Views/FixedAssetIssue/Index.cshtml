@using System.Collections
@using ExceedERP.Core.Domain.FixedAsset.Issues


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Fixed Asset Issue</legend>

@(Html.Kendo().Grid<FixedAssetIssue>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.FixedAssetIssueID).Title("Issue No.").Width(120).ClientTemplate("#=appendZeros(FixedAssetIssueID)#");
          columns.Bound(c => c.FixedAssetRequisitionId).Title("SR No.").EditorTemplateName("FixedAssetRequisitionSelector").Width(160);
          columns.Bound(c => c.StoreCode).Width(130).EditorTemplateName("StoreReadOnly");
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["fixedassetPeriods"], "GLPeriodId", "Name").Width(120).Title("Period").EditorTemplateName("FixedAssetPeriodSelector");
          columns.Bound(c => c.IssueDate).Title("Issue Date").Width(130);
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(160);
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(160).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(150).EditorTemplateName("EmployeeSelector");
          columns.ForeignKey(p => p.RecipientId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Recipient").Width(150).EditorTemplateName("EmployeeSelector");
          columns.Bound(c => c.GatePass).Width(90);
          columns.Bound(c => c.Reference).Width(90);
          columns.Bound(c => c.Remark).Width(90);
          columns.Bound(c => c.Status).Width(100);
          columns.Command(command =>
          {

              command.Edit();
              command.Destroy();


          }).Width(280);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("FixedAssetIssue").Window(w => w.Title("Fixed Asset Issue")))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Groupable()
      .Groupable().Events(ev => ev.DetailExpand("detailExpandFixedIssue"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("FixedAssetIssueID").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.FixedAssetIssueID);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.OrgStructureId).Editable(false);
              model.Field(p => p.Status).Editable(false);
              //model.Field(p => p.EmployeeId).Editable(false);
              model.Field(p => p.FixedAssetIssueID).Editable(false);
          })
          .Read(read => read.Action("FixedAssetIssues_Read", "FixedAssetIssue"))
          .Create(create => create.Action("FixedAssetIssues_Create", "FixedAssetIssue"))
          .Update(update => update.Action("FixedAssetIssues_Update", "FixedAssetIssue"))
          .Destroy(destroy => destroy.Action("FixedAssetIssues_Destroy", "FixedAssetIssue"))
      ).Resizable(x => x.Columns(true))
      .ClientDetailTemplateId("issuetemplate"))

