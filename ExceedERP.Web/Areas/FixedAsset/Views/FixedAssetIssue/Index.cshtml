        recordStatus = masterDataItem.Status;
        storeCode = masterDataItem.StoreCode;

        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;

        //validationGrid = "#FixedAssetIssueValidation_" + codeid;
        //if (recordStatus !== "WaitingApproval") {

        //    $(".k-grid-add", validationGrid).hide();

        //}
    }

    function onItemEdit(e) {
       

    }

    function onSelectedPeriod() {
        var periodId = $("#GLPeriodId").data("kendoDropDownList").value();
        var min = "";
        var max = "";
        if (periodId) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("GetPeriodDateRangeById", "FixedAssetDataProvider", new {area = "FixedAsset"})',
                data: { id: periodId },
                success: function (result) {
                    min = result.Min;
                    max = result.Max;
                    //update
                    var datepicker = $("#IssueDate").data("kendoDatePicker");
                    datepicker.setOptions({
                        format: "yyyy-MM-dd",
                        min:min,
                        max:max,
                        value: new Date(),
                        change: onDOBChange
                    });
                }, //end succ
                error: function (result) {
                    alert(result);
                }

            });
        }


    }

    function onSelectFixedAssetId() {

        var id = $("#AssetRegistrationId").data("kendoDropDownList").value();

       // alert(id);

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetAssetDetails", "FixedAssetDataProvider", new { area = "FixedAsset" })',
            data: { id: id },
            success: function (result) {
                $("#TagNo").val(result.Tag).trigger("change");
                $("#Size").val(result.Size).trigger("change"); 
                $("#SerialNo").val(result.SerialNo).trigger("change");
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function filterAssetsForIssue() {
       
        return {
            subCategoryCode: $("#FixedAssetSubCategoryId").val(),
            storeCode: storeCode,
            text: $("#AssetRegistrationId").data("kendoDropDownList").filterInput.val()
        };
    }

    function OnIndexCall(elem) {

        var a = codeid;
        $(elem).attr('href', $(elem).attr('href') + '?id=' + a);

    }

    var from = "GR";
    function checkboxClicked(e) {

        var isChecked = e.checked;
        var tabStrip = $("#tabstrip").kendoTabStrip({ select: onSelect }).data("kendoTabStrip");

        function onSelect(e) {
            console.log("Selected: " + tabStrip.select().index());
        }

        tabStrip.select("li:first");
        tabStrip.select(1);

        if (isChecked) {

            tabStrip.select("li:first");
            tabStrip.select(1);

        }
        else {
            tabStrip.select(0);

        }

    };

    function itemTransfered(e) {
        var itemGrid = "#FixedAssetIssueDistribution_" + codeid;
        var grid = $(itemGrid).data("kendoGrid");

        if (istransfered) {

            $(".k-grid-delete", itemGrid).hide();
            $(".k-grid-edit", itemGrid).hide();
        }

    }

    var itemCode;

    function onDataBound(e) {
        var itemGrid = "#FixedAssetIssueItem_" + codeid;
        var grid = $(itemGrid).data("kendoGrid");

        if (isapproved) {

            $(".k-grid-delete", itemGrid).hide();
            $(".k-grid-edit", itemGrid).hide();
        }
    }

    function checkboxClicked(e) {
        var isChecked = e.checked;
        var dropdown = $("#FixedAssetSelector").data("kendoDropDownList");
        if (isChecked) {
            from = "SR";
            dropdown.dataSource.read();
        } else {
            from = "GR";
            dropdown.dataSource.read();
        }
    }
