@using System.Collections
@(Html.Kendo().DropDownListFor(m => m)
    .ValuePrimitive(true)
    .OptionLabel("Select Asset...")
    .DataTextField("Name")
    .DataValueField("AssetRegistrationId")
    .Filter("contains")
    .DataSource(dataSource =>
    {
        dataSource.Read(read => read.Action("GetFixedAssetForIssueItem", "FixedAssetDataProvider", new { area = "FixedAsset" })
        .Data("filterAssetsForIssue"))
        .ServerFiltering(true);
    })
    .CascadeFrom("FixedAssetSubCategoryId")
                                   
)
@Html.ValidationMessageFor(m => m)
