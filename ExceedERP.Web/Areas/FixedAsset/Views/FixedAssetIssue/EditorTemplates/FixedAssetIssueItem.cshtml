@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Inventory
@using ExceedERP.Helpers.Common
@model ExceedERP.Core.Domain.FixedAsset.Issues.FixedAssetIssueItem

@Html.HiddenFor(model => model.FixedAssetIssueItemID)

<div class="form">
    <div class="row fullrow">
        <div class="col-md-1 ro1">
            </div>
            <div class="col-md-3 ro1">



                <div class="form-group">
                    @Html.LabelFor(model => model.FixedAssetCategoryId, htmlAttributes: new { @class = "control-label col-md-8" })
                    <div class="col-md-6">
                        @Html.Kendo().TextBoxFor(model => model.FixedAssetCategoryId).HtmlAttributes(new { disabled = "disabled" })
                        @Html.ValidationMessageFor(model => model.FixedAssetCategoryId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row"></div>

                <div class="form-group">
                    @Html.LabelFor(model => model.FixedAssetSubCategoryId, htmlAttributes: new { @class = "control-label col-md-8" })
                    <div class="col-md-6">
                        @Html.Kendo().TextBoxFor(model => model.FixedAssetSubCategoryId).HtmlAttributes(new { disabled = "disabled" })
                        @Html.ValidationMessageFor(model => model.FixedAssetSubCategoryId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row"></div>

                <div class="form-group">
                    @Html.LabelFor(model => model.ItemName, htmlAttributes: new { @class = "control-label col-md-8" })
                    <div class="col-md-6">
                        @Html.Kendo().TextBoxFor(model => model.ItemName).HtmlAttributes(new { disabled = "disabled" })
                        @Html.ValidationMessageFor(model => model.ItemName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row"></div>

                <div class="form-group">
                    @Html.LabelFor(model => model.AssetRegistrationId, htmlAttributes: new { @class = "control-label col-md-8" })
                    <div class="col-md-6">
                        @(Html.Kendo().DropDownListFor(model => model.AssetRegistrationId)
                              .ValuePrimitive(true)
                              .AutoBind(false)
                              .OptionLabel("Select Asset...")
                              .DataTextField("Name")
                              .DataValueField("AssetRegistrationId")
                              .Filter("contains")
                              .DataSource(dataSource =>
                              {
                                  dataSource.Read(read => read.Action("GetFixedAssetForIssueItem", "FixedAssetDataProvider", new { area = "FixedAsset" }).Data("filterAssetsForIssue"))
                                      .ServerFiltering(true);
                              })
                              .CascadeFrom("FixedAssetSubCategoryId")
                              .Events(e =>
                              {
                                  e.Change("onSelectFixedAssetId");
                              })
                        )
                        @Html.ValidationMessageFor(model => model.AssetRegistrationId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row"></div>

            </div>
