@using ExceedERP.Core.Domain.FixedAsset.Setting
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Fixed Asset Category</legend>
@(Html.Kendo().Grid<FixedAssetCategory>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.CategoryCode).Width(200);
          columns.Bound(c => c.CategoryName).Width(200);
          columns.ForeignKey(p => p.FixedAssetGroupID, (System.Collections.IEnumerable)ViewData["fixedAssetGroupsa"], "FixedAssetGroupID", "Name").Title("Asset Group").Width(170);
          columns.Bound(c => c.Abbreviation).Width(200);
          //columns.Bound(c => c.FixedAssetClass).Width(200);
       
          columns.Command(command =>
          {
              command.Edit(); 
              //command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("FixedAssetCategoryID").Descending())
          .Events(ev => ev
              .Error("error_handler_one")
              .Sync("sync_handler"))
          .Model(model => model.Id(p => p.FixedAssetCategoryID))
          .Read(read => read.Action("FixedAssetCategories_Read", "FixedAssetCategory"))
          .Create(create => create.Action("FixedAssetCategories_Create", "FixedAssetCategory"))
          .Update(update => update.Action("FixedAssetCategories_Update", "FixedAssetCategory"))
          .Destroy(destroy => destroy.Action("FixedAssetCategories_Destroy", "FixedAssetCategory"))
      ))
