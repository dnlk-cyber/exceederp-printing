@using System.Collections
@using ExceedERP.Core.Domain.FixedAsset.Requisitions
@using ExceedERP.Core.Domain.Inventory
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Asset Requisition Review </legend>

@(Html.Kendo().Grid<FixedAssetRequisition>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.FixedAssetRequisitionId).Title("Request No.").Width(120).ClientTemplate("#=appendZeros(FixedAssetRequisitionId)#");
          columns.Bound(c => c.Reference).Title("Reference").Width(120);
          columns.Bound(c => c.RequestDate).Width(130);
          columns.ForeignKey(p => p.StoreCode, (IEnumerable)ViewData["storesInCompany"], "StoreCode", "Name").Title("Store").Width(160).EditorTemplateName("StoresSelector");
          columns.Bound(c => c.IsTransfer).EditorTemplateName("IsTransferRequest").ClientTemplate("<input type='checkbox' disabled = 'true'  value='#=IsTransfer #' " + " # if (IsTransfer) { #" + "checked='checked'" + "# } #" + " />").Width(110);
          columns.ForeignKey(p => p.ToStoreCode, (IEnumerable)ViewData["storesInCompany"], "StoreCode", "Name").Title("To Store").Width(160).EditorTemplateName("StoresSelector");
          columns.Bound(c => c.Remark).Width(120);
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(150);
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(130).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(130).EditorTemplateName("EmployeeSelector");
          columns.Bound(c => c.PlateNo).Width(80);
          columns.Bound(c => c.Status).Width(80);
          columns.Command(command =>
          {
              //command.Edit();
              //command.Destroy();
          }).Width(150);

      }).Filterable()
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .ToolBar(toolbar =>
      {


      })
      .Events(ev => ev.Edit("onMasterEdit"))

      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Groupable()
      .Groupable().Events(ev => ev.DetailExpand("detailExpandProperty"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMasterProperty"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("FixedAssetRequisitionId").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .PageSize(20)
          .Model(model =>
          {
              model.Id(p => p.FixedAssetRequisitionId);
              model.Field(p => p.FixedAssetRequisitionId).Editable(false);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.OrgStructureId).Editable(false);
              model.Field(p => p.EmployeeId).Editable(false);
              model.Field(p => p.Status).Editable(false);
              model.Field(p => p.RequestDate).Editable(false);
          })
          .Read(read => read.Action("FixedAssetRequisitionPropertyReviews_Read", "FixedAssetRequisitionPropertyReview"))
          .Create(create => create.Action("FixedAssetRequisitionPropertyReviews_Create", "FixedAssetRequisitionPropertyReview"))
          .Update(update => update.Action("FixedAssetRequisitionPropertyReviews_Update", "FixedAssetRequisitionPropertyReview"))
          .Destroy(destroy => destroy.Action("FixedAssetRequisitionPropertyReviews_Destroy", "FixedAssetRequisitionPropertyReview"))

      ).Resizable(resize => resize.Columns(true))
      .ClientDetailTemplateId("FixedAssetrequisitions"))

<script id="FixedAssetrequisitions" type="text/Kendo-tmpl">
    @(Html.Kendo().TabStrip().Name("tabStrip_#=FixedAssetRequisitionId#").SelectedIndex(0).Items(items =>
              {
                  items.Add().Text("Detail").Content(

