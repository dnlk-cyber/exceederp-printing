                        <br />
                        # } #

                        # if (IsSecondOnlineApproved)
                        {#
                        <a href='@Url.Action("FixedAssetRequistionPrint", "FixedAssetPrint")/#=FixedAssetRequisitionId#' title="Print"><i class="fa fa-print fa-2x"></i></a>
                        <br />
                        # } #
                        <div>
                            <hr>
                            <dl class="dl-horizontal">

                                <dt>
                                    Request Date
                                </dt>
                                <dd>
                                    #=kendo.toString(kendo.parseDate(RequestDate), 'dd/MM/yyyy') #
                                </dd>
                                <dt>
                                    Status
                                </dt>
                                <dd>
                                    #= Status #
                                </dd>
                                <dt>
                                    Is Transfer
                                </dt>
                                <dd>
                                    #= IsTransfer #
                                </dd>
                                <dt>
                                    Receiver Store
                                </dt>
                                <dd>
                                    #= ToStoreCode #
                                </dd>
                                <dt>
                                    CreatedOn
                                </dt>
                                <dd>
                                    #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                </dd>
                                <dt>
                                    CreatedBy
                                </dt>
                                <dd>
                                    #= CreatedBy #
                                </dd>
                                <dt>
                                    Modified By
                                </dt>
                                <dd>
                                    #= ModifiedBy #s
                                </dd>
                                <dt>
                                    Modified Date
                                </dt>
                                <dd>
                                    #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #
                                </dd>
                            </dl>
                        </div>
                    </text>
                            );

                        items.Add().Text("Items").Content(
                        @<text>
                            @(Html.Kendo().Grid<FixedAssetRequisitionItem>()
                                  .Name("FixedAssetRequisitionItem_#=FixedAssetRequisitionId#")
                                  .Columns(columns =>
                                  {
                                      columns.ForeignKey(p => p.FixedAssetCategoryID, (IEnumerable)ViewData["Category"], "FixedAssetCategoryID", "CategoryName").Title("Category").EditorTemplateName("FixedAssetCategorySelector").Width(180);
                                      columns.ForeignKey(p => p.FixedAssetSubCategoryID, (IEnumerable)ViewData["SubCategory"], "FixedAssetSubCategoryID", "SubCategoryName").Title("Sub Category").EditorTemplateName("FixedAssetSubCategorySelector").Width(180);
                                      columns.Bound(c => c.Name).Width(110).EditorTemplateName("FixedAssetSubCategoryNameSelector");
                                      columns.Bound(c => c.UoM).Width(100).EditorTemplateName("UoMSelector");
                                      columns.Bound(c => c.RequestedQuantity).Width(110);
                                      columns.Bound(c => c.ApprovedQuantity).Width(110);
                                      columns.Bound(c => c.IssuedQuantity).Width(110);
                                      columns.Bound(c => c.PurchaseQuantity).Width(110);
                                      columns.Bound(c => c.GeneratePurchaseReq).Width(100).ClientTemplate(
                                          "<input type='checkbox' disabled = 'true' value='\\#= GeneratePurchaseReq \\#' " +
                                          "\\# if (GeneratePurchaseReq) { \\#" +
                                          "checked='checked'" +
                                          "\\# } \\#" +
                                          "/>"
                                          );

                                      columns.Bound(c => c.CreatedBy).Hidden();
                                      columns.Bound(c => c.DateCreated).Hidden();
                                      columns.Bound(c => c.ModifiedBy).Hidden();
                                      columns.Bound(c => c.LastModified).Hidden();
                                      columns.Command(command =>
                                      {
                                          command.Edit();
                                          //command.Destroy();
                                      });

                                  })
                                  .ToolBar(toolbar =>
                                  {
                                      //toolbar.Create();
                                  }).Events(ev => ev.Edit("onItemEdit"))
                                  .Editable(editable => editable.Mode(GridEditMode.InLine))
                                  .Scrollable()
                                  .Events(x => x.DataBound("onDataBoundPropertyLines"))
                                  .DataSource(dataSource => dataSource
                                      .Ajax()
                                      .Events(ev => ev
                                          .Error("error_handler(\"FixedAssetRequisitionItem_#=FixedAssetRequisitionId#\")")
                                          .RequestStart("onRequestStart(\"FixedAssetRequisitionItem_#=FixedAssetRequisitionId#\")")
                                          .RequestEnd("onRequestEnd(\"FixedAssetRequisitionItem_#=FixedAssetRequisitionId#\")"))
                                      .Model(model =>
                                      {
                                          model.Id(p => p.FixedAssetRequisitionItemId);

                                          model.Field(p => p.FixedAssetCategoryID).Editable(false);
                                          model.Field(p => p.FixedAssetSubCategoryID).Editable(false);
                                          model.Field(p => p.Name).Editable(false);
                                          model.Field(p => p.RequestedQuantity).Editable(false);
                                          model.Field(p => p.ApprovedQuantity).Editable(false);
                                          model.Field(p => p.CreatedBy).Editable(false);
                                          model.Field(p => p.DateCreated).Editable(false);
                                          model.Field(p => p.ModifiedBy).Editable(false);
                                          model.Field(p => p.LastModified).Editable(false);

                                      })
                                      .Read(read => read.Action("FixedAssetRequsitionItemPropertyReviews_Read", "FixedAssetRequsitionItemPropertyReview", new { id = "#=FixedAssetRequisitionId#" }))
                                      .Create(create => create.Action("FixedAssetRequsitionItemPropertyReviews_Create", "FixedAssetRequsitionItemPropertyReview", new { id = "#=FixedAssetRequisitionId#" }))
                                      .Update(update => update.Action("FixedAssetRequsitionItemPropertyReviews_Update", "FixedAssetRequsitionItemPropertyReview"))
                                      .Destroy(destroy => destroy.Action("FixedAssetRequsitionItemPropertyReviews_Destroy", "FixedAssetRequsitionItemPropertyReview"))
                                  ).ToClientTemplate())
                        </text>
                                  );

                              items.Add().Text("Validation").Content(@<text>
                                @(Html.Kendo().Grid<StoreRequisitionPropertyValidation>()
                                      .Name("FixedAssetRequisitionPropertyValidation_#=FixedAssetRequisitionId#")
                                      .Columns(columns =>
                                      {
                                          columns.Bound(c => c.Status).Width(170).EditorTemplateName("ValidationStatus");
                                          columns.Bound(c => c.Remark).Width(170);
                                          columns.Command(command =>
                                          {
                                              command.Edit();
                                              //command.Destroy();
                                          });
                                      })
                                      .ToolBar(toolbar =>
                                      {
                                          toolbar.Create();
                                      })
                                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                                      .Scrollable()
                                      .Events(x => x.DataBound("onDataBoundPropertyValidation"))
                                      .DataSource(dataSource => dataSource
                                          .Ajax()
                                          .Events(ev => ev
                                              .Error("error_handler(\"FixedAssetRequisitionPropertyValidation_#=FixedAssetRequisitionId#\")")
                                              .RequestStart("onRequestStart(\"FixedAssetRequisitionPropertyValidation_#=FixedAssetRequisitionId#\")")
                                              .RequestEnd("onRequestEnd(\"FixedAssetRequisitionPropertyValidation_#=FixedAssetRequisitionId#\")"))
                                          .Model(model =>
                                          {
                                              model.Id(p => p.StoreRequisitionPropertyValidationID);
                                              model.Field(p => p.Approver).Editable(false);
                                          })
                                          .Read(read => read.Action("FixedAssetRequisitionPropertyValidations_Read", "FixedAssetRequisitionPropertyValidation", new { id = "#=FixedAssetRequisitionId#" }))
                                          .Create(create => create.Action("FixedAssetRequisitionPropertyValidations_Create", "FixedAssetRequisitionPropertyValidation", new { id = "#=FixedAssetRequisitionId#" }))
                                          .Update(update => update.Action("FixedAssetRequisitionPropertyValidations_Update", "FixedAssetRequisitionPropertyValidation"))
                                          .Destroy(destroy => destroy.Action("FixedAssetRequisitionPropertyValidations_Destroy", "FixedAssetRequisitionPropertyValidation"))
                                      ).ToClientTemplate())
                            </text>);

                                }).ToClientTemplate())




</script>





<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }

   div.k-edit-form-container div.editor-field textarea, input.k-textbox {
            width: auto;
            max-width: none;
        }
    

    div.k-content {
        height: auto;
    }
</style>




<script>

   
    var storeCode;
    //var codeid;
    //var isapproved;

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "FixedAssetRequisitionPropertyReview", new { area = "FixedAsset" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function onItemEdit(e) {
        var masterRow = this.wrapper.closest("tr.k-detail-row").prev(".k-master-row");
        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        storeCode = masterDataItem.StoreCode;
        codeid = masterDataItem.FixedAssetRequisitionId;

        if (e.model.isNew() === true) {
            $("#ApprovedQuantity").attr("readonly", true);
            $("#IssuedQuantity").attr("readonly", true);
        }

       

      }



    function getItems() {

        return {
            StoreCode: storeCode
        }

    }
    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    var isapproved;
    var issecondapproved;

    function detailExpandProperty(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.FixedAssetRequisitionId;
        isapproved = masterDataItem.IsOnlineApproved;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;

    }
    function onDataBoundMasterProperty(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
            var deleteButton = $(currenRow).find(".k-grid-delete");
            deleteButton.hide();
            if (gridData[i].IsSecondOnlineApproved) {
                var editButton = $(currenRow).find(".k-grid-edit");
                editButton.hide();
            }
        }

        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsSecondSendForApproval && !dataItem.IsSecondOnlineApproved) {
                row.css("background-color", "lightgreen");
            }
            if (dataItem.IsOnlineApproved && !dataItem.IsSecondSendForApproval) {
                row.css("background-color", "lightskyblue");
            }
        }

        //changing colors
        //var rows = e.sender.tbody.children();
        //for (var j = 0; j < rows.length; j++) {
        //    var row = $(rows[j]); 
        //    var dataItem = e.sender.dataItem(row);

        //    if (dataItem.IsSendForApproval && !dataItem.IsOnlineApproved) {
        //        row.css("background-color", "lightpink");
        //    }

        //    if (dataItem.IsOnlineApproved && !dataItem.IsMiddleSendForApproval) {
        //        row.css("background-color", "lightblue");
        //    }

        //    if (dataItem.IsMiddleSendForApproval && !dataItem.IsMiddleOnlineApproved) {
        //        row.css("background-color", "lightgreen");
        //    }
        //    if (dataItem.IsMiddleOnlineApproved && !dataItem.IsSecondSendForApproval) {
        //        row.css("background-color", "lightskyblue");
        //    }
        //}

    }
    function onDataBoundPropertyLines(e) {
       
        var detailGrid = "#" + e.sender.element[0].id;
        $(".k-grid-add", detailGrid).hide();
        $(".k-grid-delete", detailGrid).hide();
        if (issecondapproved) {
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundPropertyValidation(e) {
        var detailGrid = "#" + e.sender.element[0].id;
        $(".k-grid-delete", detailGrid).hide();
        if (issecondapproved) {
            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }

    function OnIndexCall(elem) {

        var a = codeid;
        $(elem).attr('href', $(elem).attr('href') + '?id=' + a);


    }

  

</script>
