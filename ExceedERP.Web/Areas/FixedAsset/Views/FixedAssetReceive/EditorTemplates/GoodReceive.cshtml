@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Inventory
@using ExceedERP.Helpers.Common
@model ExceedERP.Core.Domain.FixedAsset.Receives.FixedAssetReceive

@Html.HiddenFor(model => model.FixedAssetReceiveId)

<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1">
           
            <div class="form-group">
                @Html.LabelFor(model => model.StoreCode, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.StoreCode)
                          .ValuePrimitive(true)
                          .OptionLabel("Select Store...")
                          .DataTextField("Name")
                          .DataValueField("StoreCode")
                          .Filter("contains")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetStoreByKeeper", "DataProvider", new { area = "Inventory" }))
                                  .ServerFiltering(false);
                          })
                          )
                    @Html.ValidationMessageFor(model => model.StoreCode, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

          
            <div class="form-group">
                @Html.LabelFor(model => model.ReceiveTypeId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.ReceiveTypeId)
                          .ValuePrimitive(true)
                          .OptionLabel("Select Type...")
                          .DataTextField("Name")
                          .DataValueField("ReceiveTypeId")
                          .Filter("contains")
                          .Events(e =>
                          {
                              e.Change("onSelectType");
                          })
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetAutoReceiveTypes", "DataProvider", new { area = "Inventory" }))
                                  .ServerFiltering(true);
                          })
                          )
                    @Html.ValidationMessageFor(model => model.ReceiveTypeId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            
            <div class="form-group" id="autoRefDiv" style="display: none">
                @Html.LabelFor(model => model.ReceiveRef, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.ReceiveRef)
                          .ValuePrimitive(true)
                          .OptionLabel("Select Ref...")
                          .DataTextField("Name")
                          .DataValueField("referenceId")
                          .Filter("contains")
                          .Events(e =>
                          {
                              e.Change("onSelectReferenceID");
                          })
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetReceiveFixedAssetRefernences", "DataProvider", new { area = "Inventory" }).Data("filterTypes"))
                                  .ServerFiltering(true);
                          })
                          .CascadeFrom("ReceiveTypeId")
                    )
                    @Html.ValidationMessageFor(model => model.ReceiveRef, "", new { @class = "text-danger" })
                </div>
            </div>
            
            <div class="form-group" id="manualRefDiv" style="display: none">
                @Html.LabelFor(model => model.Reference, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Reference)
                    @Html.ValidationMessageFor(model => model.Reference, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            
          

        </div>
        <div class="col-md-3 ro1">
            
             
            <div class="form-group">
                @Html.LabelFor(model => model.GLPeriodId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.GLPeriodId)
                          .ValuePrimitive(true)
                          .OptionLabel("Select Period...")
                          .DataTextField("Name")
                          .DataValueField("GLPeriodId")
                          .Filter("contains")
                          .Events(e =>
                          {
                              e.Change("onSelectedPeriod");
                          })
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetOpenFixedAssetPeriods", "FixedAssetDataProvider", new { area = "FixedAsset" }))
                                  .ServerFiltering(false);
                          })
                          )
                    @Html.ValidationMessageFor(model => model.GLPeriodId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.ReceiveDate, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().DatePickerFor(model => model.ReceiveDate)
                    @Html.ValidationMessageFor(model => model.ReceiveDate, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            
            <div class="form-group" id="supplierIDDiv" style="display: none">
                @Html.LabelFor(model => model.SupplierId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.SupplierId).HtmlAttributes(new {@disabled="disabled"})
                    @Html.ValidationMessageFor(model => model.SupplierId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group" id="supplierNameDiv" style="display: none">
                @Html.LabelFor(model => model.SupplierName, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.SupplierName)@*.HtmlAttributes(new {@disabled="disabled"})*@
                    @Html.ValidationMessageFor(model => model.SupplierName, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

        </div>

        <div class="col-md-3 ro1">

            <div class="form-group">
                @Html.LabelFor(model => model.SupplierInvoiceNo, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.SupplierInvoiceNo)
                    @Html.ValidationMessageFor(model => model.SupplierInvoiceNo, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Remark)
                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>



        </div>
    </div>
</div>
