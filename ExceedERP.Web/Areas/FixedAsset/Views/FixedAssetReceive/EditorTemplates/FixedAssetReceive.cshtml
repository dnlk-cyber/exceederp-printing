
@model ExceedERP.Core.Domain.FixedAsset.Receives.FixedAssetReceiveItem

<div class="form">
    <div class="row fullrow">
        
        <div class="col-md-3 ro1">

            <div class="form-group">
                @Html.LabelFor(model => model.FixedAssetCategoryID, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.FixedAssetCategoryID)
                                .ValuePrimitive(true)
                                .OptionLabel("Select category...")
                                .DataTextField("Name")
                                        .DataValueField("FixedAssetCategoryID")
                                         .Filter("contains")
                                .DataSource(dataSource =>
                                    {
                                        dataSource.Read(read => read.Action("GetCategory", "FixedAssetDataProvider", new { area = "FixedAsset" }))
                                        .ServerFiltering(false);
                                    })
                    )
                    @Html.ValidationMessageFor(model => model.FixedAssetCategoryID, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            
            <div class="form-group">
