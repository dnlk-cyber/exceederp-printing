    function goodrecivetypeselector(e) {
       
        var reciveId = $("#ReceiveTypeId").data("kendoDropDownList").value();
        
        var dataRecive;
        $.ajax({
            type: "GET",

            dataType: 'json',
          
            
             
            contentType: "application/json;charset=utf-8",
            url: "/DataProvider/GetGroodReciveType",
            data: { id: reciveId },
            success: function (result) {
                debugger;
                dataRecive = result;
                dataparamt = result;
                if (result === "Other") {
                    $(".typeselector").hide();
                    $(".supplierSelector").hide();
