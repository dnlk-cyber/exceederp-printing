<script>

    function isGroup(obj) {
        if ($(obj).is(":checked")) {
            $("#groupQtyDiv").show();

        } else {
            $("#groupQtyDiv").hide();

        }

    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "FixedAssetReceive", new { area = "FixedAsset" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "FixedAssetReceive", new {area = "FixedAsset"})',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function onSelectedPeriod() {
        var periodId = $("#GLPeriodId").data("kendoDropDownList").value();
        var min = "";
        var max = "";
        if (periodId) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("GetPeriodDateRangeById", "FixedAssetDataProvider", new {area = "FixedAsset"})',
                data: { id: periodId },
                success: function (result) {
                    min = result.Min;
                    max = result.Max;
                    //update
                    var datepicker = $("#ReceiveDate").data("kendoDatePicker");
                    datepicker.setOptions({
                        format: "yyyy-MM-dd",
                        min:min,
                        max:max,
                        value: new Date(),
                        change: onDOBChange
                    });
                }, //end succ
                error: function (result) {
                    alert(result);
                }

            });
        }


    }



    function onSelectType(e) {
        var type = $("#ReceiveTypeId").data("kendoDropDownList").value();


        $.ajax({
            type: "POST",
            url: '@Url.Action("CheckReceiveType", "DataProvider", new { area = "Inventory" })',
            data: { type: type },
            success: function (result) {
                if (result.Type === "Manual") {
                    // alert("manual");
                    $("#supplierNameDiv").show();
                    $("#manualRefDiv").show();


                    $("#supplierIDDiv").hide();
                    $("#autoRefDiv").hide();

                } else {
                    //alert("auto");
                    $("#supplierIDDiv").show();
                    $("#autoRefDiv").show();

                    $("#supplierNameDiv").hide();
                    $("#manualRefDiv").hide();
                }
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function onSelectReferenceID(e) {
        var id =  $("#ReceiveRef").data("kendoDropDownList").value();
        var  type=$("#ReceiveTypeId").data("kendoDropDownList").value();

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetReceiveSuppliers", "DataProvider", new { area = "Inventory" })',
            data: { id: id,type:type },
            success: function (result) {
                if (result.length > 0) {
                    for (var i = 0; i < result.length; i++) {
                        $("#SupplierName").val(result[i].SupplierId).trigger("change");
                    }
                }
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });

      
    }


    function filterTypes() {
        return {
            id: $("#ReceiveTypeId").data("kendoDropDownList").value(),
            text: $("#ReceiveRef").data("kendoDropDownList").filterInput.val()
        }
    }

    function filterSuppliers() {
        return {
            id: $("#ReceiveRef").data("kendoDropDownList").value(),
            type: $("#ReceiveTypeId").data("kendoDropDownList").value()
        }
    }











