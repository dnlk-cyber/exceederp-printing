@using System.Collections
@using ExceedERP.Core.Domain.FixedAsset.Receives

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<legend>Fixed Asset Receive</legend>
@(Html.Kendo().Grid<FixedAssetReceive>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.FixedAssetReceiveId).Title("Receive No.").Width(120).ClientTemplate("#=appendZeros(FixedAssetReceiveId)#");
          columns.ForeignKey(p => p.ReceiveTypeId, (IEnumerable)ViewData["ReeceiveType"], "ReceiveTypeId", "Name").EditorTemplateName("ReceiveTypeSelector").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(p => p.ReceiveRef).EditorTemplateName("ReceiveReferenceSelector").Width(150);
          columns.ForeignKey(p => p.StoreCode, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Width(150).EditorTemplateName("StoreSelectorByKeeper").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(p => p.SupplierName).EditorTemplateName("ReceiveSupplierSelector").Width(150);
          columns.Bound(c => c.SupplierInvoiceNo).Title("Supplier Invoice").Width(150);
          columns.ForeignKey(p => p.GLPeriodId, (IEnumerable)ViewData["fixedassetPeriods"], "GLPeriodId", "Name").Width(120).Title("Period").EditorTemplateName("FixedAssetPeriodSelector").Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.ReceiveDate).Title("Receive Date").Width(150);
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.Remark).Width(150);
          columns.Bound(c => c.Status).Width(150);
          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })

      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("GoodReceive").Window(w => w.Title("Fixed Asset Receive")))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()

      .Events(ev => ev.DetailExpand("detailExpand"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster").Edit("onMasterEdit"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("FixedAssetReceiveId").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.FixedAssetReceiveId);
              model.Field(p => p.FixedAssetReceiveId).Editable(false);
              model.Field(p => p.Status).Editable(false);
              //model.Field(p => p.ReceiveDate).Editable(false);
              model.Field(p => p.BranchId).Editable(false);

              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);
              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.LastModified).Editable(false);

          })
          .Read(read => read.Action("FixedAssetReceives_Read", "FixedAssetReceive"))
          .Create(create => create.Action("FixedAssetReceives_Create", "FixedAssetReceive"))
          .Update(update => update.Action("FixedAssetReceives_Update", "FixedAssetReceive"))
          .Destroy(destroy => destroy.Action("FixedAssetReceives_Destroy", "FixedAssetReceive"))
      )
      .ClientDetailTemplateId("templates"))

