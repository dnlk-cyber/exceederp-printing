@using ExceedERP.Core.Domain.FixedAsset.Registrations

@(Html.Kendo().Grid<DisposalItem>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.BookValue);
          columns.Bound(c => c.SalesPrice);
          columns.Bound(c => c.GlTaxRateId);
          columns.Bound(c => c.TaxAmount);
          columns.Bound(c => c.Total);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.DisposalItemId))
          .Read(read => read.Action("DisposalItems_Read", "AssetDisposalItem"))
          .Create(create => create.Action("DisposalItems_Create", "AssetDisposalItem"))
          .Update(update => update.Action("DisposalItems_Update", "AssetDisposalItem"))
          .Destroy(destroy => destroy.Action("DisposalItems_Destroy", "AssetDisposalItem"))
      ))
