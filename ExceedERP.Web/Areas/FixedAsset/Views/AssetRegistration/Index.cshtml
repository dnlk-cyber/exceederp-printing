@using System.Collections
@using ExceedERP.Core.Domain.FixedAsset.Depreciation
@using ExceedERP.Core.Domain.FixedAsset.Registrations

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Asset Registration</legend>
@(Html.Kendo().Grid<AssetRegistration>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.ForeignKey(p => p.FixedAssetCategoryID, (IEnumerable)ViewData["fixedAssetCategories"], "FixedAssetCategoryID", "CategoryName").Title("Category").EditorTemplateName("FixedAssetCategorySelector").Width(130).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(p => p.FixedAssetSubCategoryID, (IEnumerable)ViewData["fixedAssetSubCategories"], "FixedAssetSubCategoryID", "SubCategoryName").Title("Sub Category").EditorTemplateName("FixedAssetSubCategorySelector").Width(130).Filterable(ftb => ftb.Multi(true).Search(true));
          //columns.ForeignKey(p => p.FixedAssetNameID, (IEnumerable)ViewData["fixedAssetSubCategoryNames"], "FixedAssetSubCategoryNameId", "Name").Title("Asset Name").EditorTemplateName("FixedAssetSubCategorySelector").Width(130);
          columns.Bound(c => c.Name).Title("Name").Width(150);
          columns.ForeignKey(p => p.FixedAssetConditionId, (IEnumerable)ViewData["conditions"], "FixedAssetConditionId", "Name").Title("Condition").Width(130).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.GRN).Width(90);
          columns.Bound(c => c.GRNDate).Width(90);
          columns.Bound(c => c.Tag).Width(90);
          columns.Bound(c => c.Unit).Width(70);
          columns.Bound(c => c.Size).Width(90);
          columns.Bound(c => c.ModelNo).Width(90);
          columns.Bound(c => c.SerialNo).Width(90);
          columns.Bound(c => c.ChassisNo).Width(90);
          columns.Bound(c => c.EngineNo).Width(90);
          columns.Bound(c => c.PlateNo).Width(90);
          columns.Bound(c => c.Supplier).Width(90);
          columns.Bound(c => c.Manufacturer).Width(120);
          columns.Bound(c => c.ManufacturDate).Width(95).Title("Manuf. Date");
          //columns.Bound(c => c.IsGroup).Width(90).Title("Is Group?").ClientTemplate(
          //    "<input type='checkbox' disabled = 'true' value='#= IsGroup #' " +
          //    "# if (IsGroup) { #" +
          //    "checked='checked'" +
          //    "# } #" +
          //    "/>"
          //    );
          //columns.Bound(c => c.GroupCode).Width(95);
          columns.Bound(c => c.Quanity).Width(95);
          columns.Bound(p => p.PurchasePrice).Width(90);
          columns.Bound(p => p.OriginalValue).Width(90);
          columns.Bound(p => p.BookValue).Width(90);
          columns.ForeignKey(p => p.StoreCode, (IEnumerable) ViewData["Stores"], "StoreCode", "Name").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
          if (GlobalHelper.IsMultipleBusinessUnit())
          {
              columns.ForeignKey(p => p.BusinessUnitId, (IEnumerable)ViewData["BusinessUnits"], "BusinessUnitId", "Name").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
          }
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(120).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable) ViewData["personEmployees"], "Code", "Name").Title("Employee").Filterable(f => f.Multi(true).Search(true)).Width(190);
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(160).Filterable(ftb => ftb.Multi(true).Search(true));
          columns.Bound(c => c.Remark).Width(90);
          columns.Bound(c => c.Status).Width(80);
          columns.Bound(c => c.DateCreated).Width(100);
          columns.Command(command =>
          {
              command.Edit();
              //command.Destroy();
              command.Custom("Disable").Click("ChangeStatus");
          }).Width(180);
      })
      //.ToolBar(toolbar => {
      //                    toolbar.Create();
      //                    //toolbar.Excel();
      //                   //toolbar.Excel();
      //})
      .ToolBar(toolbar =>
      {

      toolbar.Template(@<text>
                               <div class="toolbar row">
                                   <div class="col-md-3">
                                       <a class="k-button k-button-icontext k-grid-add" href='\#'><span class="k-icon k-i-add"></span> Add new record</a>
                                       <button class="k-button k-button-icontext k-grid-excel" href='\#'> <span class="k-icon k-i-excel"></span>Export to Excel</button>
                                   </div>

                                   <div class="">
                                       @*<label><i>Search Asset:</i></label>*@
                                       @(Html.Kendo().DropDownList()
                                             .ValuePrimitive(true)
                                             .OptionLabel("Select Category...")
                                             .Name("CategoryCodeSelector")
                                             .DataTextField("Name")
                                             .DataValueField("FixedAssetCategoryID")
                                             .Filter("contains")
                                             .HtmlAttributes(new { style = "width: 150px;" })
                                             .DataSource(dataSource =>
                                             {
                                                 dataSource.Read(read => read.Action("GetCategory", "FixedAssetDataProvider", new { area = "FixedAsset" }))
                                                     .ServerFiltering(false);
                                             }))

                                       @(Html.Kendo().DropDownList()
                                             .ValuePrimitive(true)
                                             .OptionLabel("Select Sub Category...")
                                             .Name("SubCategoryCodeSelector")
                                             .DataTextField("Name")
                                             .DataValueField("FixedAssetSubCategoryID")
                                             .Filter("contains")
                                             .HtmlAttributes(new { style = "width: 150px;" })
                                             .DataSource(dataSource =>
                                             {
                                                 dataSource.Read(read => read.Action("GetSubCategory", "FixedAssetDataProvider", new { area = "FixedAsset" }).Data("filterSubCategories"))
                                                     .ServerFiltering(true);
                                             })
                                             .CascadeFrom("CategoryCodeSelector")
                                             .Events(e =>
                                             {
                                                 e.Select("onSelectSubCategoryCode");
                                             }))

                                       @(Html.Kendo().TextBox()
                                             .Name("txtSearch")
                                             .HtmlAttributes(new { placeholder = "name,tag,serial" }))
                                       
                                       @(Html.Kendo().Button()
                                             .Name("btnSearch")
                                             .HtmlAttributes(new { type = "search", @class = "k-primary" })
                                             .Events(e => e.Click("searchAsset"))
                                             .Content("Search"))

                                   </div>
                                 
                               </div>

                            </text>);
      })
      .Excel(excel => excel
          .FileName("Asset List.xlsx")
          .Filterable(true)
          .AllPages(true)
      )
      .Editable(editable => editable.Mode(GridEditMode.PopUp)
      .TemplateName("Registration")
      .Window(w => w.Title("Asset Registration")
      .Events(ev=>ev.Open("onOpenPopUp"))))


      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable(h => h.Height(500))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      
      .ClientDetailTemplateId("template")
      .DataSource(dataSource => dataSource
          .Ajax()
          .PageSize(20)
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(
              model =>
              {
                  model.Id(p => p.AssetRegistrationId);
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
              })
          .Read(read => read.Action("Registrations_Read", "AssetRegistration").Data("passSearchData"))
          .Create(create => create.Action("Registrations_Create", "AssetRegistration"))
          .Update(update => update.Action("Registrations_Update", "AssetRegistration"))
          .Destroy(destroy => destroy.Action("Registrations_Destroy", "AssetRegistration"))
      ))

