@using System.Collections
@using ExceedERP.Core.Domain.FixedAsset.Transfers

<legend>Machinery And Vehicle Transfer Receive</legend>
@(Html.Kendo().Grid<MachineryAndVehicleTransferReceive>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.MachineryAndVehicleTransferReceiveId).Title("#").Width(120).ClientTemplate("#=appendZeros(MachineryAndVehicleTransferReceiveId)#");
          columns.Bound(c => c.MachineryAndVehicleTransferId).Title("Transfer Send. No.").Width(120);
          columns.Bound(c => c.ReceiveDate).Width(130);
          columns.Bound(c => c.Remark).Width(130);
          columns.Bound(c => c.Status).Width(130);

          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(120);
      })
      .ToolBar(toolbar => {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("TransferReceive").Window(w => w.Title("Machinery and Vehicle Transfer")))
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Groupable()
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable(height => height.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("MachineryAndVehicleTransferReceiveId").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.MachineryAndVehicleTransferReceiveId);
              model.Field(p => p.Status).Editable(false);

          })
          .Read(read => read.Action("MachineryAndVehicleTransferReceives_Read", "MachineryAndVehicleTransferReceive"))
          .Create(create => create.Action("MachineryAndVehicleTransferReceives_Create", "MachineryAndVehicleTransferReceive"))
          .Update(update => update.Action("MachineryAndVehicleTransferReceives_Update", "MachineryAndVehicleTransferReceive"))
          .Destroy(destroy => destroy.Action("MachineryAndVehicleTransferReceives_Destroy", "MachineryAndVehicleTransferReceive"))
      )
      .ClientDetailTemplateId("Itemtransfertemplate"))

