@using System.Collections
@using ExceedERP.Core.Domain.FixedAsset.Returns


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Fixed Asset Return</legend>

@(Html.Kendo().Grid<FixedAssetReturn>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.FixedAssetReturnId).Title("#").Width(120).ClientTemplate("#=appendZeros(FixedAssetReturnId)#");
          columns.ForeignKey(p => p.StoreCode, (IEnumerable)ViewData["stores"], "StoreCode", "Name").Width(150).EditorTemplateName("StoreSelectorByKeeper");
          columns.Bound(c => c.ReturnDate).Title("Return Date").Width(130);
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(160);
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Employee").Width(150).EditorTemplateName("EmployeeSelector");
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(160).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.Bound(c => c.Reference).Width(90);
          columns.Bound(c => c.Remark).Width(90);
          columns.Bound(c => c.Status).Width(100);
          columns.Command(command =>
          {

              command.Edit();
              command.Destroy();


          }).Width(280);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Groupable()
      .Groupable().Events(ev => ev.DetailExpand("detailExpandFixedIssue"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("FixedAssetReturnId").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.FixedAssetReturnId);
              //model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.OrgStructureId).Editable(false);
              model.Field(p => p.Status).Editable(false);
              //model.Field(p => p.IssueDate).Editable(false);
              model.Field(p => p.FixedAssetReturnId).Editable(false);
          })
          .Read(read => read.Action("FixedAssetReturns_Read", "FixedAssetReturn"))
          .Create(create => create.Action("FixedAssetReturns_Create", "FixedAssetReturn"))
          .Update(update => update.Action("FixedAssetReturns_Update", "FixedAssetReturn"))
          .Destroy(destroy => destroy.Action("FixedAssetReturns_Destroy", "FixedAssetReturn"))
      ).Resizable(x => x.Columns(true))
      .ClientDetailTemplateId("template"))

<script id="template" type="text/Kendo-tmpl">
    @(Html.Kendo().TabStrip().Name("tabStrip_#=FixedAssetReturnId#").SelectedIndex(0).Items(items =>
              {
                  items.Add().Text("Detail").Content(
                    @<text>

                        # if (!IsOnlineApproved&&!IsSendForApproval)
                        {#
                        <a onclick='return sendForApproval("#=FixedAssetReturnId#")' href=' \#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                        <br />
                        # } #

                        # if (IsOnlineApproved)
                        {#
                        <a href='@Url.Action("FixedAssetReturn", "FixedAssetPrint")/#=FixedAssetReturnId#' title="Print"><i class="fa fa-print fa-2x"></i></a>
                        <br />
                        # } #
                        <div>
                            <hr>
                            <dl class="dl-horizontal">

                                <dt>
                                    Issue No.
                                </dt>
                                <dd>
                                    #= FixedAssetReturnId #
                                </dd>
                                <dt>
                                    Store
                                </dt>
                                <dd>
                                    #= StoreCode #
                                </dd>

                                <dt>
                                    Work Unit
                                </dt>
                                <dd>
                                    #= OrgStructureId #
                                </dd>
                                <dt>
                                    Project
                                </dt>
                                <dd>
                                    #= BranchId #
                                </dd>

                                <dt>
                                    Return Date
                                </dt>
                                <dd>

                                    #=kendo.toString(kendo.parseDate(ReturnDate), 'dd/MM/yyyy') #

                                </dd>
                                <dt>
                                    Status
                                </dt>
                                <dd>
                                    #= Status #
                                </dd>
                                <dt>
                                    CreatedOn
                                </dt>
                                <dd>
                                    #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                </dd>
                                <dt>
                                    CreatedBy
                                </dt>
                                <dd>
                                    #= CreatedBy #
                                </dd>
                                <dt>
                                    Modified By
                                </dt>
                                <dd>
                                    #= ModifiedBy #
                                </dd>
                                <dt>
                                    Modified Date
                                </dt>
                                <dd>
                                    #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #
                                </dd>
                            </dl>
                        </div>

                        <hr />
                        # if (IsOnlineApproved&&!IsVoid&&!IsOnlineTransferred)
                        {#
                        @if (HttpContext.Current.User.IsInRole("FixedAsset_Void"))
                                    {
                            <a onclick='return voidRecord("#=FixedAssetReturnId#")' href='\#' title='Void Record'><i class='fa  fa-bolt fa-2x' style='color:red'></i></a>
                                    }
                        /**/
                        # } #

                    </text>
                            );

                        items.Add().Text("Item").Content(
                        @<text>

                            @(Html.Kendo().Grid<FixedAssetReturnItem>()
                                          .Name("FixedAssetReturnItem_#=FixedAssetReturnId#")
                                          .Columns(columns =>
                                          {
                                                  columns.ForeignKey(p => p.FixedAssetCategoryId, (IEnumerable)ViewData["Category"], "FixedAssetCategoryID", "CategoryName").Title("Category").EditorTemplateName("FixedAssetCategorySelector").Width(130);
                                                  columns.ForeignKey(p => p.FixedAssetSubCategoryId, (IEnumerable)ViewData["SubCategory"], "FixedAssetSubCategoryID", "SubCategoryName").Title("Sub Category").EditorTemplateName("FixedAssetSubCategorySelector").Width(130);
                                                  columns.ForeignKey(p => p.AssetRegistrationId, (IEnumerable)ViewData["FixedAsset"], "AssetRegistrationId", "Name").Title("Item").EditorTemplateName("FixedAssetReturnSelector").Width(130);
                                                  columns.Bound(c => c.IsGroup).Width(80).Title("Is Group").ClientTemplate("<input type='checkbox' disabled = 'true' \\#= IsGroup ? checked='checked' :'' \\# />");
                                                  columns.Bound(c => c.ItemName).Width(90);
                                                  columns.Bound(c => c.TagNo).Width(90);
                                                  columns.Bound(c => c.Quantity).Format("{0:n}").Width(90);
                                                  columns.Bound(c => c.UnitPrice).Format("{0:n}").Width(80);
                                                  columns.Bound(c => c.Total).Format("{0:n}").Width(80);
                                                  columns.Bound(c => c.Remark).Width(110);
                                                  columns.Command(command =>
                                                  {
                                                      command.Edit();
                                                      command.Destroy();
                                                  }).Width(380);
                                              })
                                          .ToolBar(toolbar =>
                                          {
                                                  toolbar.Create();
                                              })
                                          .Events(ev => ev.Edit("onItemEdit"))
                                          .Events(x => x.DataBound("onDataBoundLines"))
                                          .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("FixedAssetReturnItem").Window(w => w.Title("Fixed Asset Return Item")))
                                          .Scrollable()
                                          .Selectable()
                                          .DataSource(dataSource => dataSource
                                              .Ajax()
                                              .Events(ev => ev
                                                  .Error("error_handler(\"FixedAssetReturnItem_#=FixedAssetReturnId#\")")
                                                  .RequestStart("onRequestStart(\"FixedAssetReturnItem_#=FixedAssetReturnId#\")")
                                                  .RequestEnd("onRequestEnd(\"FixedAssetReturnItem_#=FixedAssetReturnId#\")"))
                                              .Model(model =>
                                              {
                                                      model.Id(p => p.FixedAssetReturnItemId);
                                                      model.Field(p => p.FixedAssetReturnItemId).Editable(false);

                                                      model.Field(p => p.UnitPrice).Editable(false);
                                                      model.Field(p => p.Total).Editable(false);
                                                      model.Field(p => p.TagNo).Editable(false);
                                                      model.Field(p => p.ItemName).Editable(false);

                                                      model.Field(p => p.CreatedBy).Editable(false);
                                                      model.Field(p => p.DateCreated).Editable(false);
                                                      model.Field(p => p.ModifiedBy).Editable(false);
                                                      model.Field(p => p.LastModified).Editable(false);

                                                  })
                                              .Read(read => read.Action("FixedAssetReturnItems_Read", "FixedAssetReturnItem", new { id = "#=FixedAssetReturnId#" }))
                                              .Create(create => create.Action("FixedAssetReturnItems_Create", "FixedAssetReturnItem", new { id = "#=FixedAssetReturnId#" }))
                                              .Update(update => update.Action("FixedAssetReturnItems_Update", "FixedAssetReturnItem", new { id = "#=FixedAssetReturnId#" }))
                                              .Destroy(destroy => destroy.Action("FixedAssetReturnItems_Destroy", "FixedAssetReturnItem"))
                                          ).ToClientTemplate())

                        </text>
                                  );

                              items.Add().Text("Validation").Content(
                                @<text>
                                    @(Html.Kendo().Grid<FixedAssetReturnValidation>()
                                                  .Name("FixedAssetReturnValidation_#=FixedAssetReturnId#")
                                                  .Columns(columns =>
                                                  {
                                                              columns.Bound(c => c.Status).Width(170).EditorTemplateName("ValidationStatus");
                                                              columns.Bound(c => c.Remark).Width(170);
                                                              columns.Command(command =>
                                                              {
                                                                  command.Edit();
                                                      //command.Destroy();
                                                  });
                                                          })
                                                  .ToolBar(toolbar =>
                                                  {
                                                              toolbar.Create();
                                                          })
                                                  .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                  .Scrollable()
                                                  .Events(x => x.DataBound("onDataBoundFisrtValidation"))
                                                  .DataSource(dataSource => dataSource
                                                      .Ajax()
                                                      .Events(ev => ev
                                                          .Error("error_handler(\"FixedAssetReturnValidation_#=FixedAssetReturnId#\")")
                                                          .RequestStart("onRequestStart(\"FixedAssetReturnValidation_#=FixedAssetReturnId#\")")
                                                          .RequestEnd("onRequestEnd(\"FixedAssetReturnValidation_#=FixedAssetReturnId#\")"))
                                                      .Model(model =>
                                                      {
                                                                  model.Id(p => p.FixedAssetReturnValidationId);
                                                              }
                                                      )
                                                      .Read(read => read.Action("FixedAssetReturnValidations_Read", "FixedAssetReturnValidation", new { id = "#=FixedAssetReturnId#" }))
                                                      .Create(create => create.Action("FixedAssetReturnValidations_Create", "FixedAssetReturnValidation", new { id = "#=FixedAssetReturnId#" }))
                                                      .Update(update => update.Action("FixedAssetReturnValidations_Update", "FixedAssetReturnValidation"))
                                                      .Destroy(destroy => destroy.Action("FixedAssetReturnValidations_Destroy", "FixedAssetReturnValidation"))
                                                  ).ToClientTemplate())


                                </text>

                                          );

                                  }).ToClientTemplate()

    )



</script>







<script type="text/javascript">

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "FixedAssetReturn", new { area = "FixedAsset" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "FixedAssetReturn", new {area = "FixedAsset"})',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }


    $("#file").closest(".k-upload").find("span").text("Import");


    var masterDataItem;
    var masterRow;
    var masterGrid;
    var codeid;
    var isapproved;
  
    var recordStatus;
    var validationGrid;
    var storeCode;

    
  
    var issecondapproved;
    var isSendForApproval;
    var isOnlineTransferred;

    function detailExpandFixedIssue(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.FixedAssetReturnId;
       
      
        recordStatus = masterDataItem.Status;
        storeCode = masterDataItem.StoreCode;

        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;

        //validationGrid = "#FixedAssetIssueValidation_" + codeid;
        //if (recordStatus !== "WaitingApproval") {

        //    $(".k-grid-add", validationGrid).hide();

        //}
    }

    function filterAssetsForReturn() {
       
        return {
            subCategoryCode: $("#FixedAssetSubCategoryId").val(),
            text: $("#AssetRegistrationId").data("kendoDropDownList").filterInput.val()
        };
    }

    function filterSubCategory() {

        return {
            categoryCode: $("#FixedAssetCategoryId").data("kendoDropDownList").value(),
            text: $("#FixedAssetSubCategoryId").data("kendoDropDownList").filterInput.val()
        };
    }

    function onSelectFixedAssetId() {

        var id = $("#AssetRegistrationId").data("kendoDropDownList").value();

        // alert(id);

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetAssetDetails", "FixedAssetDataProvider", new { area = "FixedAsset" })',
            data: { id: id },
            success: function (result) {
                $("#TagNo").val(result.Tag).trigger("change");
                $("#ItemName").val(result.Name).trigger("change");
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function OnIndexCall(elem) {

        var a = codeid;
        $(elem).attr('href', $(elem).attr('href') + '?id=' + a);

    }

    var from = "GR";
    function checkboxClicked(e) {

        var isChecked = e.checked;
        var tabStrip = $("#tabstrip").kendoTabStrip({ select: onSelect }).data("kendoTabStrip");

        function onSelect(e) {
            console.log("Selected: " + tabStrip.select().index());
        }

        tabStrip.select("li:first");
        tabStrip.select(1);

        if (isChecked) {

            tabStrip.select("li:first");
            tabStrip.select(1);

        }
        else {
            tabStrip.select(0);

        }

    };

    function itemTransfered(e) {
        var itemGrid = "#FixedAssetIssueDistribution_" + codeid;
        var grid = $(itemGrid).data("kendoGrid");

        if (istransfered) {

            $(".k-grid-delete", itemGrid).hide();
            $(".k-grid-edit", itemGrid).hide();
        }

    }

    var itemCode;
    function onItemEdit(e) {
        //e.preventDefault();

        //var itemGrid = "#FixedAssetReturnItem_" + codeid;
        //var grid = $(itemGrid).data("kendoGrid");

        //var selectedItem = grid.dataItem(grid.select());

        //itemCode = selectedItem.AssetRegistrationId;

    }
    function onDataBound(e) {
        var itemGrid = "#FixedAssetReturnItem_" + codeid;
        var grid = $(itemGrid).data("kendoGrid");

        if (isapproved) {

            $(".k-grid-delete", itemGrid).hide();
            $(".k-grid-edit", itemGrid).hide();
        }
    }

    function checkboxClicked(e) {
        var isChecked = e.checked;
        var dropdown = $("#FixedAssetSelector").data("kendoDropDownList");
        if (isChecked) {
            from = "SR";
            dropdown.dataSource.read();
        } else {
            from = "GR";
            dropdown.dataSource.read();
        }
    }
    //function fixedAssetItemCode() {
    //    return {
    //        itemcode: itemCode,
    //        from: from
    //    }
    //}

    function onUploadSuccess(e) {

    }

    function checkFileType(e) {
        var files = e.files;

        $.each(files, function () {

            if (this.extension.toLowerCase() === ".xls" || this.extension.toLowerCase() === ".xlsx" || this.extension.toLowerCase() === ".xlsm") {

            } else {
                alert("Only .xls, .xlsx, .xlsm files can be uploaded!");
                e.preventDefault();
            }

        });
    }

    function downloadTemplateClicked(e) {
        $.ajax(
            {
                type: "GET",

                url: '@Url.Action("DownloadTemplate", "Issue")',
                dataType: "json"

            });
        }
        $(document).ready(function () {
            $("#file").closest(".k-upload").find("span").text("Import");
        });


</script>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.Message");
        };
    </script>
