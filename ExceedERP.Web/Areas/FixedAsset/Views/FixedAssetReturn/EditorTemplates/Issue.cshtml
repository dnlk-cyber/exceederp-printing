
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.Inventory.Issue
<form >

    <div class="row">
        <div class="col-md-1">

        </div>
    
        <div class="col-md-3">

            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.StoreRequisitionID)

                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.StoreRequisitionID)
                          .AutoBind(false)
                          .OptionLabel("Select Requisition...")
                          .DataTextField("StoreRequisitionID")
                          .DataValueField("StoreRequisitionID")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetStoreRequisitionId", "DataProvider"))
                                  .ServerFiltering(true);
                          }))
                    @Html.ValidationMessageFor(model => model.StoreRequisitionID)
                </div>
            </div>

        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.IssueDate)
            </div>
            <div class="form-group">
                @Html.Kendo().DateTimePickerFor(model => model.IssueDate)
                @Html.ValidationMessageFor(model => model.IssueDate)
            </div>
        </div>
      
        </div>
        
 
    <br />
    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Reference)


            </div>
            <div class="form-group">
                @Html.Kendo().TextBoxFor(model => model.Reference)
                @Html.ValidationMessageFor(model => model.Reference)
            </div>
        </div>
        @*<div class="col-md-3">
            <div>
                @Html.LabelFor(model => model.Status)
            </div>
            <div class="form-group">

                @Html.Kendo().TextBoxFor(model => model.Status)
                @Html.ValidationMessageFor(model => model.Status)
            </div>
        </div>*@

    </div>

</form>
