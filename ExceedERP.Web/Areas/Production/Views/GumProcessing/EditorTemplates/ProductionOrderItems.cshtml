@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
    .OptionLabel(Resources.Select)
            .DataTextField("ProductionCode")
            .DataValueField("GumProductionOrderItemId")
            .DataSource(dataSource =>
            {
                dataSource.Read(read => read.Action("GetGumProductionOrderItems", "ProductionDataProvider", new { area = "Production"}));
            })
            .Filter("contains")
            .MinLength(2)
            .ValuePrimitive(true)
)