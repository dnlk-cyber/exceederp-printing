@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
    .OptionLabel(Resources.Select)
            .DataTextField("Name")
            .DataValueField("ProductionActivityId")
            .DataSource(dataSource =>
            {
                dataSource.Read(read => read.Action("GetProductionActivities", "ProductionDataProvider", new {area = "Production" }));
            })
            .Filter("contains")
            .MinLength(2)
            .ValuePrimitive(true)
)