@using System.Collections
@using ExceedERP.Core.Localization
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>  Production Order </legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Production.ProductionOrder>()
                          .Name("productionOrderGrid")
                          .Columns(columns =>
                          {
                              //columns.Bound(c => c.ProductionProjectId).Hidden(true);
                              //columns.ForeignKey(c => c.PlotId, (IEnumerable)ViewData["FarmingPlots"], "PlotId", "PlotCode").EditorTemplateName("FarmingPlots");
                              columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("Branches");
                              columns.ForeignKey(c => c.ProductionSiteId, (IEnumerable)ViewData["ProductionSites"], "ProductionSiteId", "Name").EditorTemplateName("ProductionSites");
                              columns.Bound(c => c.ProductionType).EditorTemplateName("ProductionTypes");
                              //columns.Bound(c => c.DateFrom);
                              //columns.Bound(c => c.DateTo);
                              //columns.Bound(c => c.ProductionCode);
                              //columns.ForeignKey(c => c.CropId, (IEnumerable)ViewData["CropTypes"], "CropId", "Name").EditorTemplateName("CropNames");
                              //columns.Bound(c => c.SeedType).EditorTemplateName("SeedTypes");
                              //columns.Bound(c => c.Generation).EditorTemplateName("SeedGenerations");
                              columns.Bound(c => c.Description);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(200);

                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Scrollable(h => h.Height(500))
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          .Filterable()
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()

                              .Events(events =>
                              {
                                  events.Error("error_handler(\"productionOrderGrid\")");
                                  events.RequestStart("onRequestStart(\"productionOrderGrid\")");
                                  events.RequestEnd("onRequestEnd(\"productionOrderGrid\")");
                              })
                              .Model(model =>
                              {
                                  model.Id(f => f.ProductionOrderId);
                              })

                              .Read(read => read.Action("ProductionOrders_Read", "ProductionOrder"))
                              .Create(create => create.Action("ProductionOrder_Create", "ProductionOrder"))
                              .Update(update => update.Action("ProductionOrder_Update", "ProductionOrder"))
                              .Destroy(destroy => destroy.Action("ProductionOrder_Destroy", "ProductionOrder"))
                          ).ClientDetailTemplateId("template_productionOrder_detail")
)


