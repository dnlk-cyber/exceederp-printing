@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
                .OptionLabel(Resources.Select)
                .Name("BranchId")
                .DataTextField("Name")
                .DataValueField("BranchId")
                .DataSource(dataSource =>
                {
                    dataSource.Read(read => read.Action("GetAllBranches", "ProductionDataProvider", new { area = "Production" }));
                })
                .Filter("contains")
                .MinLength(2)
                .ValuePrimitive(true)
)