@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        .Name("GumProductionOrderItemId")
        .DataTextField("ProductionCode")
        .DataValueField("GumProductionOrderItemId")
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetGumProductionItems", "ProductionDataProvider", new { area = "Production"}));
        })
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)