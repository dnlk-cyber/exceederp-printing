@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
    .OptionLabel(Resources.Select)
            .DataTextField("PlotCode")
            .DataValueField("PlotId")
            .DataSource(dataSource =>
            {
                dataSource.Read(read => read.Action("GetFarmingPlots", "ProductionDataProvider", new {branchId = "#=BranchId#" , area = "Production" }));
            })
            .Filter("contains")
            .MinLength(2)
            .ValuePrimitive(true)
)