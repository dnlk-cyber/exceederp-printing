                                    columns.ForeignKey(c => c.ItemCode, (IEnumerable)ViewData["Items"], "ItemCode", "Name").EditorTemplateName("Item").Width(200);
                                    columns.Bound(c => c.Unit).Width(100);//, (IEnumerable)ViewData["Unit"], "LookupId", "Description").EditorTemplateName("Unit").Width(75);
                                    columns.Bound(c => c.Quantity).Width(75);
                                    columns.Bound(c => c.UnitPrice).Width(75).Format("{0:N2}");
                                    columns.Bound(c => c.TotalCost).Width(75)
                                        .ClientFooterTemplate("Total: \\#= kendo.toString(sum, 'N2')\\#")
                                        .ClientGroupFooterTemplate("Total: \\#= kendo.toString(sum, 'N2')\\#");
                                    columns.ForeignKey(c => c.ProductionPeriodId, (IEnumerable)ViewData["ProductionPeriods"], "ProductionPeriodId", "Name").Width(100).EditorTemplateName("ProductionPeriods");
                                    columns.Bound(c => c.DateOfInformation).Width(100);
                                    columns.Bound(c => c.Reference).Width(100);
                                    columns.Command(command =>
                                    {
                                        command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                        command.Destroy().Text(Resources.ActionButton_Cancel);
                                    }).Width(200);
                                })
                                .ToolBar(toolbar =>
                                {
                                    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                                })
                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .Scrollable(h => h.Height(500))
                                .Sortable(sortable =>
                                {
                                    sortable.SortMode(GridSortMode.SingleColumn);
                                })
                                .Selectable(selectable =>
                                {
                                    selectable.Mode(GridSelectionMode.Single);
                                    selectable.Type(GridSelectionType.Row);
                                })
                                .Filterable()
                                .Pageable(pageable => pageable
                                    .Input(true)
                                    .Numeric(false)
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Aggregates(ag =>
                                    {
                                        ag.Add(f => f.TotalCost).Sum();
                                    })
                                    .Events(events =>
                                    {
                                        events.Error("error_handler(\"material_#=SeedProcessingOrderItemId#\")");
                                        events.RequestStart("onRequestStart(\"material_#=SeedProcessingOrderItemId#\")");
                                        events.RequestEnd("onRequestEnd(\"material_#=SeedProcessingOrderItemId#\")");
                                    })
                                    .Model(model =>
                                    {
                                        model.Id(p => p.ProcessingInputMaterialId);
                                        model.Field(f => f.TotalCost).Editable(false);
                                        model.Field(f => f.Unit).Editable(false);
                                    })
                                    .Read(read => read.Action("Materials_Read", "ProcessingInputMaterial", new { itemId = "#=SeedProcessingOrderItemId#", productionType = ProductType.Seed }))
                                    .Create(create => create.Action("Material_Create", "ProcessingInputMaterial", new { itemId = "#=SeedProcessingOrderItemId#", productionType = ProductType.Seed }))
                                    .Update(update => update.Action("Material_Update", "ProcessingInputMaterial", new { productionType = ProductType.Seed }))
                                    .Destroy(destroy => destroy.Action("Material_Destroy", "ProcessingInputMaterial", new { productionType = ProductType.Seed }))
                                    )
                                    .ToClientTemplate()
                        )
                    </text>
                );
            }).ToClientTemplate())
</script>

<script>
    function filterCategories() {
        //
        // summary:
        //      send the filtering text along with the parent widget's value
        var dropdownlist = $("#ItemCode").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            ItemCategoryCode: $("#ItemCategoryCode").val(), filterString: filterInput.val()
        };
    }
    function periodChanged(e) {
        var drp = this;
        var id = drp.value();
        var dateOfInformation = $("#DateOfInformation").data("kendoDatePicker");
        
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPeriodRanges", "ProductionDataProvider", new { area = "Production" })',
            data: { periodId: id},
            success: function (result) {
                if (result) {
                    var ranges = result.split('_');
                    var start = ranges[0];
                    var end = ranges[1];
                    var startDate = new Date(start);
                    var endDate = new Date(end);
                    if (dateOfInformation) {
                        dateOfInformation.min(startDate);
                        dateOfInformation.max(endDate);
                        dateOfInformation.value(startDate);
                        dateOfInformation.trigger("change");
                    } 
                }
            }, 
            error: function (result) {
            }
        });
    }
    function materialChanged(e) {
        var itmCode = $('#ItemCode').val();
        $.ajax({
            url: '@Url.Action("GetInventoryMaterialUnitPrice", "ProductionOrderInputs", new {area = "Production"})',
            data: { itemCode: itmCode },
            type: 'POST',
            cache: false,
            success: function (result) {
                $("#UnitPrice").val(result);
                $("#UnitPrice").trigger("change");
            }

        });
    }
</script>

