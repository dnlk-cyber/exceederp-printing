<script id="template_seedProcessingActivities" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tab_str_#=SeedProcessingOrderItemId#")
            .SelectedIndex(0)
            .Items(items =>
            {
            items.Add().Text("Detail").Content(
                @<text>
                    @(Html.Kendo().PanelBar()
                              .Name("panelbar_#=SeedProcessingOrderItemId#")
                              .ExpandMode(PanelBarExpandMode.Single)
                              .Items(panelbar =>
                              {
                                  panelbar.Add()
                                      .Expanded(true)
                                      .Content(
                                         "<div class='item-details'>" +
                                            "<u><h4> Production Costs</h4></u>" +
                                            "<ul>" +
                                                 "<li> <label> <b>(A)</b> Total Production Cost </label> #= kendo.toString(TotalProductionCost, 'N2')# </li>" +
                                                 "<li> <label> <b>(B)</b> Total Raw Quantity :</label> #= kendo.toString(RawQuantity, 'N2')# #=UnitOfOutPutProduced# </li>" +
                                            //"<li> <label>Total  Cost : <b>(D + E) = </b> </label><b> #= kendo.toString(TotalCost, 'N2')# </b></li>" +
                                            "</ul>" +
                                            //"<hr />" +
                                            "<u><h4> Processing Costs</h4></u>" +
                                            "<ul>" +
                                                 //"<li> <label> <strong> Status </label> #= Status# </strong></li>" +
                                                 "<li> <label> <b>(A)</b> Material Cost </label> #= kendo.toString(MaterialCost, 'N2')# </li>" +
                                                 "<li> <label> <b>(B)</b> Labor Cost :</label> #= kendo.toString(LaborCost, 'N2')# </li>" +
                                                 "<li> <label> <b>(C)</b> Machinery Cost:</label> #= kendo.toString(EquipmentCost, 'N2')# </li>" +
                                                 "<li> <label> <b>(D)</b> Direct Cost: <b>(A + B + C) = </b> </label> #= kendo.toString(DirectCost, 'N2')# </li>" +
                                                 "<li> <label> <b>(E)</b> Over head Cost:</label> #= kendo.toString(OverheadCost, 'N2')# </li>" +
                                                 //"<li> <label> Profit Cost:</label> #= kendo.toString(ProfitCost, 'N2')# </li>" +
                                                 "<li> <label>Total  Cost : <b>(D + E) = </b> </label><b> #= kendo.toString(TotalCost, 'N2')# </b></li>" +
                                            "</ul>" +
                                        "</div>"

                                );
                              }).ToClientTemplate()
                    )
                </text>
                );
            items.Add().Text("Activities").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Production.ProcessingOrderActivity>()
                                .Name("activities_#=SeedProcessingOrderItemId#")
                                .Columns(columns =>
                                {
                                    columns.ForeignKey(c => c.ProductionActivityId, (IEnumerable)ViewData["Activities"], "ProductionActivityId", "Name").EditorTemplateName("SeedProcessingActivities");
                                    columns.Bound(c => c.OperationType);
                                    columns.Bound(c => c.Quantity);
                                    columns.Bound(c => c.LaborCost);
                                    columns.Bound(c => c.EquipmentCost);
                                    columns.Bound(c => c.TotalCost);
                                    columns.ForeignKey(c => c.ProductionPeriodId, (IEnumerable)ViewData["ProductionPeriods"], "ProductionPeriodId", "Name").EditorTemplateName("ProductionPeriods");
                                    columns.Bound(c => c.DateOfInformation);

                                    columns.Command(command =>
                                    {
