@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
    .OptionLabel(Resources.Select)
            .DataTextField("Name")
            .DataValueField("ProcessingPlantId")
            .DataSource(dataSource =>
            {
                dataSource.Read(read => read.Action("GetProcessingPlants", "ProductionDataProvider", new {type = 0, area = "Production"}));
            })
            .Filter("contains")
            .MinLength(2)
            .ValuePrimitive(true)
)