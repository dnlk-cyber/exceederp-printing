@using ExceedERP.Core.Domain.Production
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Kendo.Mvc.UI
<legend>Setting | Production Periods</legend>
@(Html.Kendo().Grid<ProductionPeriod>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ProductionPeriodId).Hidden();
          columns.Bound(c => c.Name);
          columns.Bound(c => c.DateFrom);
          columns.Bound(c => c.DateTo);
          columns.Bound(c => c.Status).EditorTemplateName("PeriodStatus");
          columns.Bound(c => c.OrgBranchName).Hidden(true);
          columns.Bound(c => c.DateCreated).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.LastModified).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.CreatedBy).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Hidden(true);
          columns.Command(command =>
          {
              //command.Edit();
              command.Custom("Close").Click("ClosePeriods");
              command.Custom("Open").Click("OpenPeriod");
          }).Width(180);
      })
      //.ToolBar(toolbar =>
      //               {
      //                   toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
      //               })
      .HtmlAttributes(new { style = "height: 700px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(10))
      .Selectable()
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      //.Events(ev => ev.DetailExpand("detailExpand"))
      //.Events(x => x.DataBound("onDataBoundMaster"))

      .DataSource(dataSource => dataSource
          .Ajax()
          .PageSize(20)
          .Model(
              model =>
              {
                  model.Id(p => p.ProductionPeriodId);
                  model.Field(p => p.Status).Editable(false);
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);

              })
              .Events(ev => ev
                                .Error("error_handler(\"grid\")")
                                .RequestStart("onRequestStart(\"grid\")")
                                .RequestEnd("onRequestEnd(\"grid\")"))

            .Read(read => read.Action("Periods_Read", "ProductionPeriod"))
            .Create(create => create.Action("Period_Create", "ProductionPeriod"))
            .Update(read => read.Action("Periods_Read", "ProductionPeriod"))
            .Destroy(read => read.Action("Periods_Read", "ProductionPeriod"))

      )
            //.Events(events => events.DataBound("onDataBoundLines"))
            .Events(events => events.DataBound("dataBound"))

)



<script>


    function ClosePeriods(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.ProductionPeriodId;
        $.ajax({

            type: "GET",
            data: id,
            url: '@Url.Action("ClosePeriod", "ProductionPeriod")/' + id

        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();
        location.reload();
    };

    function OpenPeriod(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var id = dataItem.ProductionPeriodId;
        console.log(dataItem);
        $.ajax({

            type: "GET",
            data: id, //I obtained the id properly
            url: '@Url.Action("OpenPeriod", "ProductionPeriod")/' + id

        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();
        location.reload();
    };
</script>

