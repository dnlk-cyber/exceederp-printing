@using System.Collections
@using ExceedERP.Core.Localization
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>  Cost by Month, Crop and Generation </legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Production.ProductionProject>()
                          .Name("projectsGrid")
                          .Columns(columns =>
                          {
                              //columns.Bound(c => c.ProductionProjectId).Hidden(true);
                              columns.Bound(c => c.Name);
                              columns.Bound(c => c.Location);

                              //columns.Command(command =>
                              //{
                              //    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                              //    command.Destroy().Text(Resources.ActionButton_Cancel);
                              //}).Width(200);

                          })
                          //.ToolBar(toolbar =>
                          //{
                          //    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          //})
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Scrollable(h => h.Height(500))
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                          .Filterable()
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()

                              .Events(events =>
                              {
                                  events.Error("error_handler(\"projectsGrid\")");
                                  events.RequestStart("onRequestStart(\"projectsGrid\")");
                                  events.RequestEnd("onRequestEnd(\"projectsGrid\")");
                              })
                              .Model(model =>
                              {
                                  model.Id(f => f.ProductionProjectId);
                              })

                              .Read(read => read.Action("Project_Read", "Project"))
                              .Create(create => create.Action("Project_Create", "Project"))
                              .Update(update => update.Action("Project_Update", "Project"))
                              .Destroy(destroy => destroy.Action("Project_Destroy", "Project"))
                          ).ClientDetailTemplateId("template_cost_tracking")
)

<script id="template_cost_tracking" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_str_#=ProjectId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Periods").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Production.CostTrackingPeriod>()
                            .Name("periods__#=ProjectId#")
                            .Columns(columns =>
                            {
                                columns.ForeignKey(c => c.ProductionPeriodId, (IEnumerable)ViewData["ProductionPeriods"], "ProductionPeriodId", "Name");
                                columns.Bound(c => c.Remark);                                

                                columns.Command(command =>
                                {
                                    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                    command.Destroy().Text(Resources.ActionButton_Cancel);
                                }).Width(200);
                            })
                            .ToolBar(toolbar =>
                            {
                                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                            })
                            .Editable(editable => editable.Mode(GridEditMode.InLine))
                            .Scrollable(h => h.Height(500))
                            .Sortable(sortable =>
                            {
                                sortable.SortMode(GridSortMode.SingleColumn);
                            })
                            .Groupable()
                            .Selectable(selectable =>
                            {
                                selectable.Mode(GridSelectionMode.Single);
                                selectable.Type(GridSelectionType.Row);
                            })
                            .Filterable()
                            .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
                            //.Events(e => e.Edit("onEdit"))
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Events(events =>
                                {
                                    events.Error("error_handler(\"periods__#=ProjectId#\")");
                                    events.RequestStart("onRequestStart(\"periods__#=ProjectId#\")");
                                    events.RequestEnd("onRequestEnd(\"periods__#=ProjectId#\")");
                                })
                                .Model(model =>
                                {
                                    model.Id(p => p.CostTrackingPeriodId);

                                })
                                .Read(read => read.Action("Periods_Read", "CostTrackingPeriod", new { id = "#=ProjectId#" }))
                                .Create(create => create.Action("Period_Create", "CostTrackingPeriod", new { id = "#=ProjectId#" }))
                                .Update(update => update.Action("Period_Update", "CostTrackingPeriod"))
                                .Destroy(destroy => destroy.Action("Period_Destroy", "CostTrackingPeriod"))
                                ).ClientDetailTemplateId("template_monthly_cost")
                                .ToClientTemplate()
                    )
                </text>
            );
        }).ToClientTemplate())
</script>

<script id="template_monthly_cost" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tab_str_#=CostTrackingPeriodId#")
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Cost by Month").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Production.ProjectCostByMonth>()
                            .Name("cost__#=CostTrackingPeriodId#")
                            .Columns(columns =>
                            {
                                columns.ForeignKey(c => c.CropId, (IEnumerable)ViewData["Crops"], "CropId", "Name");
                                columns.Bound(c => c.Type);
                                columns.Bound(c => c.Generation);
                                columns.Bound(c => c.MaterialCost);
                                columns.Bound(c => c.LaborCost);
                                columns.Bound(c => c.EquipmentCost);
                                columns.Bound(c => c.TotalCost);

                                columns.Command(command =>
                                {
                                    command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                    command.Destroy().Text(Resources.ActionButton_Cancel);
                                }).Width(200);
                            })
                            .ToolBar(toolbar =>
                            {
                                toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                            })
                            .Editable(editable => editable.Mode(GridEditMode.InLine))
                            .Scrollable(h => h.Height(500))
                            .Sortable(sortable =>
                            {
                                sortable.SortMode(GridSortMode.SingleColumn);
                            })
                            .Groupable()
                            .Selectable(selectable =>
                            {
                                selectable.Mode(GridSelectionMode.Single);
                                selectable.Type(GridSelectionType.Row);
                            })
                            .Filterable()
                            .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
                            //.Events(e => e.Edit("onEdit"))
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Events(events =>
                                {
                                    events.Error("error_handler(\"cost__#=CostTrackingPeriodId#\")");
                                    events.RequestStart("onRequestStart(\"cost__#=CostTrackingPeriodId#\")");
                                    events.RequestEnd("onRequestEnd(\"cost__#=CostTrackingPeriodId#\")");
                                })
                                .Model(model =>
                                {
                                    model.Id(p => p.ProjectCostByMonthId);
                                    model.Field(f => f.TotalCost).Editable(false);

                                })
                                .Read(read => read.Action("CostByMonth_Read", "ProjectCostByMonth", new { periodId = "#=CostTrackingPeriodId#" }))
                                .Create(create => create.Action("CostByMonth_Create", "ProjectCostByMonth", new { periodId = "#=CostTrackingPeriodId#" }))
                                .Update(update => update.Action("CostByMonth_Update", "ProjectCostByMonth"))
                                .Destroy(destroy => destroy.Action("CostByMonth_Destroy", "ProjectCostByMonth"))
                                ).ClientDetailTemplateId("template_monthly_cost_detail")
                                .ToClientTemplate()
                    )
                </text>
            );
        }).ToClientTemplate())
</script>

