<legend>Issues</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Production.ProductionIssue>()
                          .Name("issuesGrid")
                          .Columns(columns =>
                          {
                              columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("Branches");
                              columns.ForeignKey(c => c.StoreCode, (IEnumerable)ViewData["InventoryStores"], "StoreCode", "Name").EditorTemplateName("InventoryStoreSelector");
                              columns.ForeignKey(c => c.ProcessingPlantId, (IEnumerable)ViewData["ProcessingPlants"], "ProcessingPlantId", "Name").EditorTemplateName("ProcessingPlants");
                              columns.ForeignKey(c => c.ProductionPeriodId, (IEnumerable)ViewData["ProductionPeriods"], "ProductionPeriodId", "Name").EditorTemplateName("ProductionPeriodSelector");
                              columns.Bound(c => c.IssueDate);
                              columns.Bound(c => c.Reference);
                              //columns.Bound(c => c.Remark);

                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(200);

                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Scrollable(h => h.Height(500))
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                           .Events(ev =>
                          {
                              ev.DataBound("onDataBound");
                          })
                          .Filterable()
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()

                              .Events(events =>
                              {
                                  events.Error("error_handler(\"issuesGrid\")");
                                  events.RequestStart("onRequestStart(\"issuesGrid\")");
                                  events.RequestEnd("onRequestEnd(\"issuesGrid\")");
                              })
                              .Model(model =>
                              {
                                  model.Id(f => f.ProductionIssueId);
                              })

                              .Read(read => read.Action("Issues_Read", "ProductionIssue"))
                              .Create(create => create.Action("Issue_Create", "ProductionIssue"))
                              .Update(update => update.Action("Issue_Update", "ProductionIssue"))
                              .Destroy(destroy => destroy.Action("Issue_Destroy", "ProductionIssue"))

                          ).ClientDetailTemplateId("issue_items")
)
