@using System.Collections
    @using ExceedERP.Core.Localization
    @(Html.Kendo().DropDownListFor(m => m)
    .OptionLabel( Resources.Select)
            .DataTextField("Value")
            .DataValueField("ProductionSettingId")
            .DataSource(dataSource =>
            {
                dataSource.Read(read => read.Action("GetActivityTypes", "ProductionDataProvider", new { area = "Production"}));
            })
            .Filter("contains")
            .MinLength(2)
            .ValuePrimitive(true)
    )