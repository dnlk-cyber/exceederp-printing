@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel(Resources.Select)
        .Name("GumProcessingOrderItemId")
        .DataTextField("ProcessingCode")
        .DataValueField("GumProcessingOrderItemId")
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetGumProcessingItems", "ProductionDataProvider", new { area = "Production"}));
        })
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)