@using System.Collections
@using ExceedERP.Core.Localization
@(Html.Kendo().DropDownListFor(m => m)
        .OptionLabel( Resources.Select)
        .Name("StoreCode")
        .DataTextField("Name")
        .DataValueField("StoreCode")
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("GetInventoryStores", "ProductionDataProvider", new { area = "Production"}));
        })
        .Filter("contains")
        .MinLength(2)
        .ValuePrimitive(true)
)