<legend>Finished Goods | Store Receive </legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.Production.ProductionFinishedGoodsStoreReceive>()
                          .Name("finishedStoreReceiveGrid")
                          .Columns(columns =>
                          {
                              columns.ForeignKey(c => c.StoreCode, (IEnumerable)ViewData["InventoryStores"], "StoreCode", "Name").EditorTemplateName("InventoryStoreSelector");
                              columns.ForeignKey(c => c.ProductionPeriodId, (IEnumerable)ViewData["ProductionPeriods"], "ProductionPeriodId", "Name").EditorTemplateName("ProductionPeriodSelector");
                              columns.Bound(c => c.ReceiveDate);
                              columns.Bound(c => c.ProductType);
                              //columns.Bound(c => c.Remark);

                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                  command.Destroy().Text(Resources.ActionButton_Cancel);
                              }).Width(200);

                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                          })
                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Selectable(selectable =>
                          {
                              selectable.Mode(GridSelectionMode.Single);
                              selectable.Type(GridSelectionType.Row);
                          })
                          .Scrollable(h => h.Height(500))
                          .Sortable(sortable =>
                          {
                              sortable.SortMode(GridSortMode.SingleColumn);
                          })
                           .Events(ev =>
                          {
                              ev.DataBound("onDataBound");
                          })
                          .Filterable()
                          .Pageable(pageable => pageable
                              .Input(true)
                              .Numeric(false)
                              .Refresh(true)
                              .PageSizes(true)
                              .ButtonCount(5))
                          .DataSource(dataSource => dataSource
                              .Ajax()

                              .Events(events =>
                              {
                                  events.Error("error_handler(\"finishedStoreReceiveGrid\")");
                                  events.RequestStart("onRequestStart(\"finishedStoreReceiveGrid\")");
                                  events.RequestEnd("onRequestEnd(\"finishedStoreReceiveGrid\")");
                              })
                              .Model(model =>
                              {
                                  model.Id(f => f.ProductionFinishedGoodsStoreReceiveId);
                              })

                              .Read(read => read.Action("StoreReceives_Read", "ProductionFinishedGoodsStoreReceive"))
                              .Create(create => create.Action("StoreReceive_Create", "ProductionFinishedGoodsStoreReceive"))
                              .Update(update => update.Action("StoreReceive_Update", "ProductionFinishedGoodsStoreReceive"))
                              .Destroy(destroy => destroy.Action("StoreReceive_Destroy", "ProductionFinishedGoodsStoreReceive"))

                          ).ClientDetailTemplateId("template_receive_items")
)
