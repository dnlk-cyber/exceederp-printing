@model  ExceedERP.Core.Domain.CRM.Variety
<legend>Variety</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.Variety>()
              .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.VarietyID).Title(" ID ").Width(80);
          columns.Bound(c => c.ProductName).Title("Product").EditorTemplateName("GetProducts").Width(120);
          columns.Bound(c => c.VarietyName).Width(100);
          columns.Bound(c => c.Class).Width(100);

          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();

          }).Width(180);


      })
      .Selectable()
     .HtmlAttributes(new { style = "height: 520px;" })
                                  .Pageable(pageable => pageable
                                                    .Input(true)
                                                    .Numeric(false)
                                                    .Refresh(true)
                                                    .PageSizes(true)
                                                    .ButtonCount(5))

                                        .Scrollable()
                                        .Sortable()
                                        .Filterable()
                                        .Groupable()
                                        .Scrollable(h => h.Height(500))

      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Events(ev =>
          {

          })
      .Editable(editable =>
      {
          editable.Mode(GridEditMode.InLine);
          editable.DisplayDeleteConfirmation("Are You Sure Variety  ");
      }
      )
      .DataSource(dataSource => dataSource
              .Ajax() 
                      .Sort(x => x.Add(s => s.VarietyID).Descending())
          .Model(model =>
          {
              model.Id(p => p.VarietyID);
              model.Field(v => v.VarietyID).Editable(false);

          }
              ).Events(ev => ev
                                                                        .Error("error_handler(\"grid\")")
                                                                     .RequestStart("onRequestStart(\"grid\")")
                                                                   .RequestEnd("onRequestEnd(\"grid\")"))

                      .Read(read => read.Action("Varietys_Read", "Variety"))
          .Create(create => create.Action("Varietys_Create", "Variety"))
          .Update(update => update.Action("Varietys_Update", "Variety"))
                  .Destroy(distroy => distroy.Action("Varietys_Destroy", "Variety"))
      )

)


<style type="text/css">
    div.k-edit-form-container {
        width: 700px;
    }
</style>
