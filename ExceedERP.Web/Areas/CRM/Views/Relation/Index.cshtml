<legend>Relation</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.Relation>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Refereing);
        columns.Bound(c => c.Reference);
        columns.Bound(c => c.Remark);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
              .Model(model => model.Id(p => p.RelationId)).Events(ev => ev
                                                                                .Error("error_handler(\"grid\")")
                                                                                .RequestStart("onRequestStart(\"grid\")")
                                                                                .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("Relations_Read", "Relation"))
          .Create(create => create.Action("Relations_Create", "Relation"))
          .Update(update => update.Action("Relations_Update", "Relation"))
          .Destroy(destroy => destroy.Action("Relations_Destroy", "Relation"))
      )
)
