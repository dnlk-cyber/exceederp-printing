@using Kendo.Mvc.UI
@model ExceedERP.Web.Areas.CRM.Models.LineItemViewModel
 
<form id="lineForm" method="post" onsubmit=" return ValidateInput();" onformchange="return ClearValMsg();">

    <div class="row col-md-12">

        <div class="col-md-2" style="padding-left:110px;">
            <div class="form-group">
                <div class="k-label">
                    @Html.HiddenFor(model => model.LineItemID)  
                    <input type="hidden" name="VoucherDefinitionId" id="VoucherDefinitionId" />
                    <input type="hidden" name="Voucher" id="Voucher" />
                    @Html.LabelFor(model => model.StoreID)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.StoreID).Name("StoreID")
                      .AutoBind(true)
                      .OptionLabel("Select ")
                      .DataTextField("Name")
                                              .DataValueField("StoreCode")
                      .DataSource(datasource =>
                          {
                              datasource.Read(read => read.Action("GetStoreList", "CRMDataProvider"))
                                  .ServerFiltering(true);
                          }).Events(e=> e.Select("ClearValMsg"))

                    )
                    <div class="   alert-dismissable   alert-warning" id="StoreVal" ></div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.ThingID)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.ThingID).Name("ThingID")
                              .AutoBind(true)
                      .OptionLabel("Select ")
                      .DataTextField("Name")
                                              .DataValueField("ProductID")
                      .DataSource(d =>
                          {
                              d.Read(r =>
                                  {
                                      r.Action("GetThingListByStore", "CRMDataProvider").Data("filterThing");
                                  })
                                  .ServerFiltering(true);
                          })
                      .Enable(false)
                      .AutoBind(false)
                      .CascadeFrom("StoreID")
                                      .Events(e => e.Change("GetStockBalance").Select("ClearValMsg"))
                    )
                    <div class="   alert-dismissable   alert-warning" id="ProductVal"></div>

                </div>
            </div>
        </div>

        <div class="col-md-2" style="padding-left:15px;">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Variety)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.Variety).Name("Variety")
                      .AutoBind(true)
                              .OptionLabel("Select")
                              .DataTextField("Name")
                              .DataValueField("Name")
                      .DataSource(d =>
                          {
                              d.Read(r =>
                                  {
                                      r.Action("VarietyByInventoryDDBind", "Variety").Data("filterVariety");
                                  })
                                  .ServerFiltering(true);
                          })
                      .Enable(false)

                              .CascadeFrom("ThingID")
                      .Events(e => e.Change("GetStockBalance"))
                    )
                     
                </div>
            </div>
        </div>

        <div class="col-md-2" style="padding-left:15px;">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Class)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.Class).Name("Class")
                      .AutoBind(true)
                      .OptionLabel("Select")
                      .DataTextField("Name")
                      .DataValueField("Name")
                       .DataSource(d =>
                          {
                              d.Read(r =>
                                  {
                                      r.Action("ClassDDBind", "Variety");
                                  })
                                  .ServerFiltering(true);
                          })
                      .Enable(false)

                              .CascadeFrom("ThingID")
                      .Events(e => e.Change("GetStockBalance"))
                    )



                </div>
            </div>
        </div>



    </div>

    <div class="row">
        <div class="col-md-1">
        </div>

        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.StockBalanceReserved)
                </div>
                <div>

                    @(Html.Kendo().TextBoxFor(model => model.StockBalanceReserved)
                      .Enable(false))
                    @Html.ValidationMessageFor(model => model.StockBalanceReserved)
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.StockBalance)
                </div>
                <div>

                    @(Html.Kendo().TextBoxFor(model => model.StockBalance)
                      .Enable(false)
                    )
                    @Html.ValidationMessageFor(model => model.StockBalance)
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.CalculatedCost)
                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.CalculatedCost)
                      .Enable(false))
                    @Html.ValidationMessageFor(model => model.CalculatedCost)
                </div>
            </div>
        </div>



        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.PriceTag)
                </div>
                <div>

                    @(Html.Kendo().DropDownListFor(model => model.PriceTag)
                              .OptionLabel("Select")
                      .DataTextField("Text")
                              .DataValueField("Text")
                      .BindTo(ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.CRM.Price_Types)))
                      .ValuePrimitive(true).Events( e=>e.Select("ClearValMsg"))
                    )
                    <div class="   alert-dismissable   alert-warning " id="PriceTagVal"></div>

                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-1">
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.PriceTagDetail)
                </div>
                <div>

                    @(Html.Kendo().DropDownListFor(model => model.PriceTagDetail)
                      .AutoBind(true)
                      .OptionLabel("Select")
                      .DataTextField("Description")
                              .DataValueField("Description")
                      .Name("PriceTagDetail")
                      .DataSource(datasource =>
                          {
                              datasource.Read(read =>
                                  {
                                      read.Action("GetPriceTagDetailListVoucher", "CRMDataProvider")
                                          .Data("GetPriceTagDetailParameter");

                                  })
                                  .ServerFiltering(true);
                          })
                      .CascadeFrom("PriceTag")
                              .Events(e => e.Change("UpdatePriceChange").Select("ClearValMsg"))
                    )
                    <div class="   alert-dismissable   alert-warning" id="PriceTagDetailVal"></div>

                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.UnitAmount)
                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.UnitAmount).Enable(false)
                              .Name("UnitAmount").HtmlAttributes(new { @onchange = "GetTaxValue" })
                    )
                   
                    @Html.ValidationMessageFor(model => model.UnitAmount)
                </div>
            </div>
        </div>


        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Quantity)
                </div>
                <div>
                    @Html.Kendo().NumericTextBoxFor(model => model.Quantity).Min(0).Events(x => x.Change("GetTaxValue"))
                    <div class="   alert-dismissable   alert-warning" id="QuantityVal"></div>
                    @Html.ValidationMessageFor(model => model.Quantity)
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Tax)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.Tax)
                      .AutoBind(true)
                      .OptionLabel("Select")
                              .DataTextField("TaxName")
                                      .DataValueField("GLTaxRateID")
                      .DataSource(datasource =>
                          {
                              datasource.Read(read => read.Action("GetTaxList", "CRMDataProvider"))
                                  .ServerFiltering(true);
                          })
                              .Events(e => e.Change("GetTaxValue").Select("ClearValMsg"))
                    )

                    <div class="   alert-dismissable  alert-warning" id="TaxVal"></div>

                </div>
            </div>
        </div>

        @*   <div class="col-md-2">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.InsuranceCost)
                    </div>
                    <div>
                        @Html.Kendo().NumericTextBoxFor(model => model.InsuranceCost).Min(0).Events(x => x.Change("GetTaxValue"))
                        @Html.ValidationMessageFor(model => model.InsuranceCost)
                    </div>
                </div>
            </div>
        *@
    </div>
    <div class="row">
        <div class="col-md-1">
        </div>
        @*  <div class="col-md-2">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.FreightCost)
                    </div>
                    <div>
                        @Html.Kendo().NumericTextBoxFor(model => model.FreightCost).Min(0)
                        @Html.ValidationMessageFor(model => model.FreightCost)
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.OtherCost)
                    </div>
                    <div>
                        @Html.Kendo().NumericTextBoxFor(model => model.OtherCost).Min(0).Events(x => x.Change("GetTaxValue"))
                        @Html.ValidationMessageFor(model => model.OtherCost)
                    </div>
                </div>
            </div>
        *@
        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.TaxAmount)
                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.TaxAmount).Name("TaxAmount")
                      .Enable(false))
                    @Html.ValidationMessageFor(model => model.TaxAmount)
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.TotalAmount)
                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.TotalAmount).Name("TotalAmount")
                      .Enable(false))
                    @Html.ValidationMessageFor(model => model.TotalAmount)
                </div>
            </div>
        </div>

    </div>



    <div class="row">
        <div class="col-md-3 ">
        </div>
        <div class="  form-box text-center">
            <h4>  Other Cost</h4>
            <hr />

        </div>
        <div style="padding-left:30px;">
            <button id="generate" class="k-button  k-primary  " onclick=' return AddCostItem(this);'>Add </button>
        </div>
        </div>
    <div class="row">
        <div class="col-md-3">
        </div>
        <div id="CostItem"></div>
    </div>
    <div class="form-bottom pull-right " style="padding-right:20px;">
        <input type="submit" value="Create" id="linesave" class="k-button k-button-icontext k-primary " />
    </div>
</form>

