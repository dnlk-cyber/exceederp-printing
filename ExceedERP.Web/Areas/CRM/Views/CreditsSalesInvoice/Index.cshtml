<script id="lineItemTemplate" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                    .Name("tabstripLineItem_#=LineItemID#")
            .SelectedIndex(0)
            .Items(items =>
                        {

                /*****************************************************SerialCodes*******************************************/
                            items.Add().Text("SerialCodes").Content(
                                @<text>
                                    @*<legend>Serial Codes</legend>*@
                                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.SerialCode>()

                            .Name("SerialCode_#=LineItemID#")
                              .Columns(columns =>
                              {
                                          columns.Bound(c => c.SerialDefinition).EditorTemplateName("SerialDefinitionList");
                                          columns.Bound(c => c.Number);
                                          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
                                      })
                                       .Events(e => e.Edit("GetThingId"))
                              .ToolBar(toolbar =>
                              {
                                          toolbar.Create();
                                      })
                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                              .Scrollable()
                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .Model(model => model.Id(p => p.SerialCodeID))
                                          .Events(ev => ev
                                                                                                                          .Error("error_handler(\"SerialCode_#=LineItemID#\")")
                                                                                                                        .RequestStart("onRequestStart(\"SerialCode_#=LineItemID#\")")
                                                                                                                             .RequestEnd("onRequestEnd(\"SerialCode_#=LineItemID#\")"))

                                          .Read(read => read.Action("SerialCodes_Read", "SerialCode", new { lineitemID = "#=LineItemID#" }))
                                          .Create(create => create.Action("SerialCodes_Create", "SerialCode", new { lineitemID = "#=LineItemID#" }))
                                  .Update(update => update.Action("SerialCodes_Update", "SerialCode"))
                                  .Destroy(destroy => destroy.Action("SerialCodes_Destroy", "SerialCode"))
                              ).ToClientTemplate()

                                    )
                                </text>
                    );
                        /***********************************************************************************************************/
                        /***********************************************LifeSpan*******************************************/
                                    items.Add().Text("LifeSpan").Content(
                                        @<text>
                                            @*<legend>Life Span</legend>*@
                                            @(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.LifeSpan>()

                                                       .Name("LifeSpan_#=LineItemID#")
                                               .Columns(columns =>
                                                {
                                                            columns.Bound(c => c.ProductionDate).Format("{0:yyyy-MM-dd}");
                                                            columns.Bound(c => c.ExpiryDate).Format("{0:yyyy-MM-dd}");
                                                            columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
                                                        })
                                                .ToolBar(toolbar =>
                                                {
                                                            toolbar.Create();
                                                        })
                                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                .Scrollable()
                                                .DataSource(dataSource => dataSource
