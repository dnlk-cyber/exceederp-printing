    function invoiceCustomerSelectorChanged(e) {
        var selector = $("#ReferencedSalesOrderIds").data("kendoMultiSelect");
        if (selector) {
            selector.dataSource.read();
        }
    }
    function salesInvoiceSelectorChanged(e) {
        var ddl = $("#Source").data("kendoDropDownList");
        //if (ddl.value() == 0) {
        //    $("#referenceSelectorContainer").hide();
        //}
        //else {
        //    $("#referenceSelectorContainer").show();
        //}
        $("#ReferencedSalesOrderIds").data("kendoMultiSelect").dataSource.read();
    }
    function referenceSelectorChange(e) {
        var multiDrDwnLsit = this;
        referencedSalesOrderIds = "";
        var selectedValues = multiDrDwnLsit.value();
        //var otherValue = $("#ReferencedSalesOrderIds").data("kendoMultiSelect").value();

        if (selectedValues.length > 0) {
            if (selectedValues.length > 1) {
                for (i = 0; i < selectedValues.length - 1; i++) {
                    referencedSalesOrderIds += selectedValues[i] + ",";
                }
                referencedSalesOrderIds += selectedValues[selectedValues.length - 1];
            } else {
                referencedSalesOrderIds = referencedSalesOrderIds + selectedValues[0];
            }
        }
        console.log(selectedValues);

        $("#CRMPeriodId").data("kendoDropDownList").dataSource.read();

        // update branch based on the selected refrences
        updateBranchSelector(referencedSalesOrderIds);
    }
    function getSelectedReferences() {
        return {
            //ddd: $("#ReferencedSalesOrderIds").data("kendoMultiSelect").value()
            concatnatedOrderIds: referencedSalesOrderIds
        };
    }
    function updateBranchSelector(oId)
    {
        $.ajax({
            url: '@Url.Action("GetReferedSalesOrderBranchId", "CRMDataProvider", new { area = "CRM"})',
            data: { orderIds: oId },
            type: 'POST',
            cache: false,
            success: function (result) {
                if (result) {
                    var branchId = result;
                    var bdl = $("#BranchId").data("kendoDropDownList");
                    bdl.value(branchId);
                    bdl.trigger("change");
                }
            }
        });
    }
    function onPeriodChange(e) {
        var drp = this;
        var id = drp.value();
        var voucherDate = $("#Date").data("kendoDatePicker");
        
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPeriodRangesWithinSalesOrderDates", "CRMDataProvider", new { area = "CRM" })',
            data: { periodId: id, concatnatedOrderIds: referencedSalesOrderIds},
            success: function (result) {
                if (result) {
                    var ranges = result.split('_');
                    var start = ranges[0];
                    var end = ranges[1];
                    var startDate = new Date(start);
                    var endDate = new Date(end);
                    if (voucherDate) {
                        voucherDate.min(startDate);
                        voucherDate.max(endDate);
                        voucherDate.value(startDate);
                        voucherDate.trigger("change");
                    } 
                }
            }, 
            error: function (result) {
            }
        });

    }

    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "CashSalesInvoice", new {area = "CRM"})',
                data: { id: id },
                success: function (result) {
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                },
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
    function regenerateDistribution(id) {
        $.ajax({
                type: "POST",
                url: '@Url.Action("RegenerateDistribution", "CreditsSalesInvoice", new { area = "CRM" })',
                data: {
                    id: id,
                },
                success: function (result) {
                    alert(result.Message);
                    if (result.Status == "OK") {
                        location.reload(true);
                    }
                }, 
                error: function (result) {
                    alert(result);
                }
            });
    }
    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "CashSalesInvoice", new { area = "CRM" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
    
</script>
