    function GetStockBalance() {

        var storeobj = $("#StoreID").data("kendoDropDownList");
        var stID = storeobj.value();
        var thingobj = $("#ThingID").data("kendoDropDownList");
        var tID = thingobj.value();

        $.ajax({
