<legend>Item</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.Item>()
      .Name("ItemGrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Name);
          columns.ForeignKey(c => c.CategoryID, (System.Collections.IEnumerable)ViewData["ThingCategory"], "ProductCategoryId", "Description").Width(150);
          columns.Bound(c => c.UOM).EditorTemplateName("UOM");
          columns.Bound(c => c.IsActive);
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(s => s.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ItemID))
          .Read(read => read.Action("Things_Read", "Item"))
          .Create(create => create.Action("Things_Create", "Item"))
          .Update(update => update.Action("Things_Update", "Item"))
          .Destroy(destroy => destroy.Action("Things_Destroy", "Item"))
      ).ClientDetailTemplateId("template")
)

