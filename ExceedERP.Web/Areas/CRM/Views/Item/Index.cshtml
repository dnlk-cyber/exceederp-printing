<script>
    var popup;
    var referenceCode;
    function SelectReference() {
        popup = window.open('/CRM/CRMDataProvider/GetReference', 'WindowPopup', 'top=100, left=400, width=300, height=320,resizable=no,');
        popup.focus();
        return false;
    }

    function setReferenceID(referenceID) {
        referenceCode = referenceID;
        $("#Reference").val(referenceCode).trigger("change");
    }
</script>


