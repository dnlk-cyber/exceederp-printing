@model  ExceedERP.Core.Domain.CRM.Product
<legend>Product</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.Product>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.CategoryID, (System.Collections.IEnumerable)ViewData["ProductMainCategories"], "ProductCategoryId", "Description")
          .EditorTemplateName("CategoryEditorTemplates")
          .Width(120)
          .Filterable(f =>
          {
              f.Multi(true);
              f.Search(true);

          });
          columns.ForeignKey(c => c.SubCategoryId, (System.Collections.IEnumerable)ViewData["ProductSubCategories"], "ProductCategoryId", "Description")
          .EditorTemplateName("SubCategoryEditorTemplates")
          .Width(120)
          .Filterable(f =>
          {
              f.Multi(true);
              f.Search(true);

          });

          //   columns.ForeignKey(c => c.ItemCategoryCode, (System.Collections.IEnumerable)ViewData["ItemCategory"], "Code", "Description").EditorTemplateName("ItemCategory").Title("Item Category").Width(150);
          columns.ForeignKey(c => c.ItemCode, (System.Collections.IEnumerable)ViewData["Item"], "Code", "Description")
          .EditorTemplateName("InventoryItemEditorTemplate")
          .Width(150).Filterable(false);
         
          columns.Bound(c => c.ItemCode).Title("Code").Width(100);
          columns.Bound(c => c.Name).Width(120);

          columns.Bound(c => c.UOM)/*.EditorTemplateName("UOM")*/.Width(60);
          columns.Bound(c => c.Price).Format("{0:N2}").Width(80);
          columns.Bound(c => c.IsActive).Width(70).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsActive #' " + " # if (IsActive) { #" + "checked='checked'" + "# } #" + " />").Title("Is Active");

          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
          toolbar.Excel();
      })
      .Events(ev => {
          ev.DetailExpand("onDetailExpand");
          ev.DataBound("mainGridDataBound");
          ev.Edit("onProductEdit");
          ev.Cancel("onCancel");
      })
      .Excel(e =>
      {
          e.AllPages(true);
          e.FileName("CRM Products Export " + DateTime.Now.ToString("yyyyMMddHHmmss"));
      })
      .Editable(editable => {
          editable.Mode(GridEditMode.PopUp);
          editable.TemplateName("ProductEditor");
          editable.Window(window =>
          {
              window.Title("Product");
          });
      })
      .HtmlAttributes(new { style = "height: 700px;" })
      .Groupable()
      .Pageable(pageable => pageable
                      .Input(true)
                      .Numeric(false)
                      .Refresh(true)
                      .PageSizes(true)
                      .ButtonCount(5))
      .Scrollable()
      .Sortable()
      .Filterable()
      //.Groupable()
      .Scrollable(h => h.Height(700))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model =>
          {
              model.Id(p => p.ProductID);
              model.Field(f => f.IsActive).DefaultValue(true);
          })
          .Events(ev => ev
                .Error("errorHandler(\"grid\")")
                .RequestStart("onRequestStart(\"grid\")")
                .RequestEnd("onRequestEnd(\"grid\")")
                )
        .Read(read => read.Action("Products_Read", "Product"))
        .Create(create => create.Action("Products_Create", "Product"))
        .Update(update => update.Action("Products_Update", "Product"))
        .Destroy(destroy => destroy.Action("Products_Destroy", "Product"))
    ).ClientDetailTemplateId("template")
)


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
          .Name("tabstrip_#=ProductID#")
          .SelectedIndex(0)
          .Items(items =>
          {
              items.Add().Text("Account Map").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.AccountMap>()
                      .Name("AccountMapGrid_#=ProductID#")
                      .Columns(columns =>
                      {
                          columns.Bound(c => c.ControlAccountID).EditorTemplateName("AccountRequirementDefinition").Width(120);
                          columns.Bound(c => c.AccountID).EditorTemplateName("AccountCode");//, (System.Collections.IEnumerable)ViewData["ListOfAccounts"], "AccountsID", "Description").EditorTemplateName("ListOfAccount").Width(100);
                          columns.Command(command =>
                          {
                              command.Edit();
                              command.Destroy();
                          }).Width(180);
                      })
                      .ToolBar(toolbar =>
                      {
                          toolbar.Create();
                      })
                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                      .Scrollable()
                      .DataSource(dataSource => dataSource
                          .Ajax() 
                          .Model(model =>
                          {
                              model.Id(p => p.AccountMapID);
                              model.Field(f => f.AccountMapID).Editable(true);
                          }
                                  ).Events(ev => ev
                                                                                            .Error("error_handler(\"AccountMapGrid_#=ProductID#\")")
                                                                                            .RequestStart("onRequestStart(\"AccountMapGrid_#=ProductID#\")")
                                                                                            .RequestEnd("onRequestEnd(\"AccountMapGrid_#=ProductID#\")"))
                          .Read(read => read.Action("AccountMaps_Read", "AccountMap", new { accountMapReferenceType = "Product", id = "#=ProductID#" }))
                          .Create(create => create.Action("AccountMaps_Create", "AccountMap", new { accountMapReferenceType = "Product", id = "#=ProductID#" }))
                          .Update(update => update.Action("AccountMaps_Update", "AccountMap"))
                          .Destroy(destroy => destroy.Action("AccountMaps_Destroy", "AccountMap"))
                      ).ToClientTemplate()
                    )
                </text>
                  );

              items.Add().Text("Price").Content(
                @<text>
                    @(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.Price>()
                      .Name("PriceGrid_#=ProductID#")
                      .Columns(columns =>
                      {
                          columns.Bound(c => c.Variety).EditorTemplateName("GetVarietyByProduct").Width(120);
                          columns.Bound(c => c.Class).EditorTemplateName("GetClassByProduct").Width(120);
                          columns.Bound(c => c.ReferenceType).Width(120);
                        
                          //columns.Bound(c => c.Reference).Width(100);
                          columns.Bound(c => c.Value).Width(100);

                          columns.Bound(c => c.Priority).Width(100);
                          columns.Command(command =>
                          {
                              command.Edit();
                              command.Destroy();
                          }).Width(180);
                      })
                      .ToolBar(toolbar =>
                      {
                          toolbar.Create();
                      })
                      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("PriceEditorTemplate").Window(w =>
                      {
                          w.Title("Price");
                          w.Scrollable(false);
                      }))
                      .Scrollable()
                      .DataSource(dataSource => dataSource
                          .Ajax() 
                          .Model(model => model.Id(p => p.PriceID))
                                  .Events(ev => ev
                                        .Error("error_handler(\"PriceGrid_#=ProductID#\")")
                                        .RequestStart("onRequestStart(\"PriceGrid_#=ProductID#\")")
                                        .RequestEnd("onRequestEnd(\"PriceGrid_#=ProductID#\")"))
                        .Read(read => read.Action("Prices_Read", "Price", new { thingID = "#=ProductID#", priceThingType = "Product" }))
                        .Create(create => create.Action("Prices_Create", "Price", new { thingID = "#=ProductID#", priceThingType = "Product" }))
                          .Update(update => update.Action("Prices_Update", "Price"))
                          .Destroy(destroy => destroy.Action("Prices_Destroy", "Price"))
                      ).ToClientTemplate()
                    )
                </text>
                  );
          }).ToClientTemplate())
</script>



<script>
    var masterDataItem;
    var masterRow;
    var masterGrid;
    var codeid;
    function detailExpand(e) {

        masterRow = e.masterRow;

        masterGrid = $("#grid").data("kendoGrid");

        masterDataItem = masterGrid.dataItem(masterRow);


        //  var masterDataItem = masterGrid.dataItem();
        codeid = masterDataItem.ProductID;
    }

    function errorHandler(gridName) {
        return function (args) {
            if (args.errors) {

                var grid = $("#" + gridName).data("kendoGrid");
                grid.cancelChanges();
                grid.one("dataBinding", function (e) {
                    e.preventDefault(); // cancel grid rebind if error occurs

                    for (var error in args.errors) {
                        alert(args.errors[error].errors[0]);
                        //showMessage(grid.editable.element, error, args.errors[error].errors);
                    }
                });
            }

        }
    }
    function mainGridDataBound(e) {
        var grid = this;
        
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);

            if (dataItem.HasTransaction == true) {

                //$(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
    }
    //
    // select category and sub-category searching text
    function getSelectedCategoryIdForSubCategorySelection() {
        var ddl = $("#SubCategoryId").data("kendoDropDownList");
        return {
            categoryId: $("#CategoryID").val(),  filterText: ddl.filterInput.val()
        };
    }
    //
    // select category, sub-category and product searching text
    function getSelectedCategoryId() {
        var ddl = $("#ItemCode").data("kendoDropDownList");
        return {
            categoryId: $("#CategoryID").val(), subcategoryId: $("#SubCategoryId").val(), filterText: ddl.filterInput.val()
        };
    }
    function categorySelectorChange() {
        var ddl = $("#ItemCode").data("kendoDropDownList");
        if (ddl) {
            ddl.dataSource.read()
        }
    }
    //function filterItem() {
    //    return {
    //        Category: $("#CategoryID").val()
    //    };
    //}
    function filterItemCode() {
        return {
            Code: $("#ItemCode").val()
        };
    }
</script>

