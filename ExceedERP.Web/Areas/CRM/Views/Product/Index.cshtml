<script>
    var ThingID;
    //var productId;
    function onDetailExpand(e) {
        var masterRow = e.masterRow;
        //var masterGrid = $("#grid").data("kendoGrid");
        var masterGrid = $("#grid").data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);
        ThingID = masterDataItem.ItemCode;
        productId = masterDataItem.ProductID;

    }
    function getdata() {
      
        return { id: ThingID }
    }

    function filterVariety() {
       
 
        return { ThingID: ThingID }
    }
    function filterclass() {
        return { inventoryItemCode: ThingID }
    }
    //function filterReference() {
    //    return {
    //        priceTag: $("#ReferenceType").data("kendoDropDownList").value()
    //    };
    //}


    function onInventoryItemChange(e) {
        var itemCode = this.value();
        $.ajax({
            url: '@Url.Action("GetInventoryItemName", "CRMDataProvider")',
            data: { code: itemCode },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                $("#Name").val(r);
                $("#Name").trigger("change");
            }
        });
        $.ajax({
            url: '@Url.Action("GetInventoryItemUOM", "CRMDataProvider")',
            data: { code: itemCode },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                //var ddl = $("#UOM").data("kendoDropDownList");
                $("#UOM").val(result);
                $("#UOM").trigger("change");
            }
        });
        $.ajax({
            url: '@Url.Action("GetInventoryItemPrice", "CRMDataProvider")',
            data: { code: itemCode },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                //var ddl = $("#UOM").data("kendoDropDownList");
                $("#Price").val(result);
                $("#Price").trigger("change");
            }
        });
    }
    function onProductEdit(e) {
        $("#Name").attr("disabled", true); 
        $("#UOM").attr("disabled", true); 
    }
    function onCancel(e) {
        this.dataSource.read();
    }
</script>
