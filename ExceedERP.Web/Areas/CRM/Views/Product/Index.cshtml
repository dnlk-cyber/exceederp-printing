<legend>Product</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.Product>()
          .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Name).Width(120);
          columns.ForeignKey(c => c.CategoryID, (System.Collections.IEnumerable)ViewData["ThingCategory"], "Code", "Description").EditorTemplateName("ThingCategory").Width(120);
  
       //   columns.ForeignKey(c => c.ItemCategoryCode, (System.Collections.IEnumerable)ViewData["ItemCategory"], "Code", "Description").EditorTemplateName("ItemCategory").Title("Item Category").Width(150);
          columns.ForeignKey(c => c.ItemCode, (System.Collections.IEnumerable)ViewData["Item"], "Code", "Description").EditorTemplateName("ItemCode").Width(150);

          columns.Bound(c => c.UOM).EditorTemplateName("UOM").Width(120);
          columns.Bound(c => c.IsActive).Width(100).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsActive #' " + " # if (IsActive) { #" + "checked='checked'" + "# } #" + " />").Title("Is Active");
       
          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          }).Width(180);
      })
              .ToolBar(toolbar =>
                          {
                              toolbar.Create();
                          })
            .Events(ev => ev.DetailExpand("onDetailExpand"))
      .Editable(editable => editable.Mode(GridEditMode.InLine))
         .HtmlAttributes(new { style = "height: 520px;" })
                          .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

                                .Scrollable()
                                .Sortable()
                                .Filterable()
                                .Groupable()
                                .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax() 
          .Model(model => model.Id(p => p.ProductID))
              .Read(read => read.Action("Products_Read", "Product")).Events(ev => ev
                                                                            .Error("error_handler(\"grid\")")
                                                                            .RequestStart("onRequestStart(\"grid\")")
                                                                            .RequestEnd("onRequestEnd(\"grid\")"))
                                                 .Create(create => create.Action("Products_Create", "Product"))
                                      .Update(update => update.Action("Products_Update", "Product"))
                                      .Destroy(destroy => destroy.Action("Products_Destroy", "Product"))
          ).ClientDetailTemplateId("template")
)


