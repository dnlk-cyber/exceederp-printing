@using System.Collections.Generic
<legend>Customer </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.OrganizationCustomer>()
          .Name("OrganizationCustomerGrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.TradeName).Width(100);
          columns.Bound(c => c.BrandName).Width(100);
          columns.Bound(c => c.CustomerType).EditorTemplateName("CustomerTypeEditor").Title("Location").Width(100);
          columns.Bound(c => c.BusinessType).EditorTemplateName("BusinessType").Width(120);
          columns.Bound(c => c.EsclationLevel).Title("Esclation").Width(100);
          columns.ForeignKey(c => c.Category, (System.Collections.IEnumerable)ViewData["OrganizationCategory"], "OrganizationCategoryID", "Description").EditorTemplateName("OrganizationCategory").Width(100);
          columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsActive #' " + " # if (IsActive) { #" + "checked='checked'" + "# } #" + " />").Title("Is Active").Width(100);
          columns.Bound(c => c.IsCredit).Width(105).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsCredit #' " + " # if (IsCredit) { #" + "checked='checked'" + "# } #" + " />").Title("Is Credit").Width(100);



          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Events(ev => {
          ev.DataBound("mainGridDataBound");
      })
      .HtmlAttributes(new { style = "height: 700px;" })
        .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))

            .Scrollable()
            .Sortable()
            .Filterable()
            //.Groupable()
            .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
               .Sort(sort =>
               {
                   sort.Add(p => p.OrganizationCustomerID).Descending();
               })
              .Model(model => model.Id(p => p.OrganizationCustomerID))
              .Events(ev => ev
              .Error("error_handler(\"OrganizationCustomerGrid\")")
              .RequestStart("onRequestStart(\"OrganizationCustomerGrid\")")
              .RequestEnd("onRequestEnd(\"OrganizationCustomerGrid\")"))

          .Read(read => read.Action("OrganizationCustomers_Read", "OrganizationCustomer"))
          .Create(create => create.Action("OrganizationCustomers_Create", "OrganizationCustomer"))
          .Update(update => update.Action("OrganizationCustomers_Update", "OrganizationCustomer"))
          .Destroy(destroy => destroy.Action("OrganizationCustomers_Destroy", "OrganizationCustomer"))
          ).ClientDetailTemplateId("template")
)


