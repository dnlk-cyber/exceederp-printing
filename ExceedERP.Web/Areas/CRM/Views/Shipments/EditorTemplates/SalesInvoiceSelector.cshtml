@(Html.Kendo().DropDownListFor(m => m)
                .ValuePrimitive(true)
                .OptionLabel("Select...")
                .DataTextField("InvoiceNumberDisplay")
                .DataValueField("CashSalesInvoiceID")
                .Filter("contains")
                .DataSource(dataSource =>
                {
                    dataSource.Read(read => read.Action("GetSalesInvoiceNumbers", "CRMDataProvider", new { area = "CRM" }))
                    .ServerFiltering(false);
                })

)
@Html.ValidationMessageFor(m => m)