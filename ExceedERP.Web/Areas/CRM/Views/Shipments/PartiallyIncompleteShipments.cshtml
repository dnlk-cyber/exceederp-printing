<script type="text/javascript">
    var showTransferableOnly = false;
    function onCheckBoxClick(checked) {
        showTransferableOnly = checked;
        $("#grid").data("kendoGrid").dataSource.read();
    }
    function getTransferableVisiblity() {
        return {
            showTransferableOnly: showTransferableOnly
        };
    }
    function sendMissingShipment(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendMissingRecordToBincard", "Shipments", new { area = "CRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                if (result.Status == "OK") {
                    location.reload(true);
                }
            },
            error: function (result) {
                alert(result);
            }
        });
    }
    function sendMissingLineItem(itemId) {
         $.ajax({
            type: "POST",
             url: '@Url.Action("SendMissingLineItemToBincard", "Shipments", new { area = "CRM" })',
             data: { itemId: itemId },
            success: function (result) {
                alert(result.Message);
                if (result.Status == "OK") {
                    var grid = $("#grid").data("kendoGrid");
                    grid.dataSource.read();
                    //location.reload(true);
                }
            },
            error: function (result) {
                alert(result);
            }
        });
    }
    function sendForApproval(id) {
        var recordStatus = "";
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "SalesShipment", new { area = "CRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }
    function mainGridDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");

        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check
            if (dataItem.IsOnlineApproved === true) {
                //hide buttons using jQuery
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                //row.find(".k-grid-customAction").text('ይከፈት');
                row.addClass("k-state-Approved");
            } else if (dataItem.IsSendForApproval) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
            }
            else if (dataItem.Status == "Rejected") {
                row.addClass("k-state-Rejected");
            }
            else {

                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").show();
            }
            //if (dataItem.ConstructionInvoiceStatus === 2) {
            //    //answer.hide(true);
            //    //transfer.hide(true);
            //    //row.css("background-color", "lightgreen");
            //    row.addClass("highlighted-row");

            //}
            //else {
            //    //answer.show(true);
            //    //transfer.show(true);
            //    //row.css("background-color", "grey");

            //}
        }
    }

    function filterShipmentInvoiceNumber() {
        var ddl = $("#CashSalesInvoiceID").data("kendoDropDownList");
        var filterInput = ddl.filterInput;
        return { shipmentSource: $("#Source").val(), customerId: $("#OrganizationCustomerId").val(), filterString: filterInput.val() }
    }
    function filterShipmentSalesOrder() {

        var ddl = $("#SalesOrderVoucherID").data("kendoDropDownList");
        var filterInput = ddl.filterInput;
        return { shipmentSource: $("#Source").val(), customerId: $("#OrganizationCustomerId").val(), filterString: filterInput.val() }
    }

    function shipmentSourceChange(e) {
        var v = $("#Source").val();
        if (v == 0) {
            $("#salesOrderSelectionContainer").hide();
            $("#invoiceNumberSelectionContainer").show();
        }
        else if (v == 1) {
            $("#salesOrderSelectionContainer").show();
            $("#invoiceNumberSelectionContainer").hide();
        }
        else {
            $("#salesOrderSelectionContainer").hide();
            $("#invoiceNumberSelectionContainer").hide();
        }
    }
    function referencedInvoiceSelectorChange(e) {
        var ddl = $("#CRMPeriodId").data("kendoDropDownList");
        if (ddl) {
            ddl.dataSource.read();
        }

        var shipmentSource= $("#Source").val();
        var invoiceId = $("#CashSalesInvoiceID").val();
        var salesOrderId = $("#SalesOrderVoucherID").val();

        updateBranchSelector(shipmentSource, invoiceId, salesOrderId);
        updateStoreSelector(shipmentSource, invoiceId, salesOrderId);
    }
    function referencedSalesOrderSelectorChange(e) {
        var ddl = $("#CRMPeriodId").data("kendoDropDownList");
        if (ddl) {
            ddl.dataSource.read();
        }

        var shipmentSource = $("#Source").val();
        var invoiceId = $("#CashSalesInvoiceID").val();
        var salesOrderId = $("#SalesOrderVoucherID").val();

        updateBranchSelector(shipmentSource, invoiceId, salesOrderId);
        updateStoreSelector(shipmentSource, invoiceId, salesOrderId);
    }
    function getShipmentSourceAndRefrencedIds() {
        return {
            shipmentSource: $("#Source").val(),
            invoiceId: $("#CashSalesInvoiceID").val(),
            salesOrderId: $("#SalesOrderVoucherID").val()
        }
    }
    function updateBranchSelector(src, invId, ordId){
        $.ajax({
            url: '@Url.Action("GetBranchOfShipmentReference", "CRMDataProvider", new { area = "CRM"})',
            data: { shipmentSource: src, invoiceId: invId, salesOrderId: ordId },
            type: 'POST',
            cache: false,
            success: function (result) {
                if (result) {
                    var branchId = result;
                    var bdl = $("#BranchId").data("kendoDropDownList");
                    bdl.value(branchId);
                    bdl.trigger("change");
                }
            }
        });
    }
    function updateStoreSelector(src, invId, ordId){
        $.ajax({
            url: '@Url.Action("GetStoreOfShipmentReference", "CRMDataProvider", new { area = "CRM"})',
            data: { shipmentSource: src, invoiceId: invId, salesOrderId: ordId },
            type: 'POST',
            cache: false,
