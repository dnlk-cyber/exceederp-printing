                    //innerCols.ForeignKey(c => c.SalesOrderVoucherID , (System.Collections.IEnumerable)ViewData["SalesOrderVouchers"], "SalesOrderVoucherID", "SalesOrderVoucherID");
                })
                        );
                        columns.ForeignKey(c => c.OrganizationCustomerId, (System.Collections.IEnumerable)ViewData["OrganizationCustomers"], "OrganizationCustomerID", "TradeName").Title("Customer").EditorTemplateName("CashOrgCustomerEditor");
                        columns.ForeignKey(c => c.BranchId, (System.Collections.IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector");
                        columns.ForeignKey(c => c.CRMPeriodId, (System.Collections.IEnumerable)ViewData["CRMPeriods"], "CRMPeriodId", "Name").EditorTemplateName("OpenCRMPeriodsSelector");
            //columns.ForeignKey(c => c.CashSalesInvoiceID, (System.Collections.IEnumerable)ViewData["SalesInvoices"], "CashSalesInvoiceID", "InvoiceNumberDisplay").EditorTemplateName("SalesInvoiceSelector");
            columns.Bound(c => c.ShipmentDate);
                        columns.Bound(c => c.MethodOfShipment);
