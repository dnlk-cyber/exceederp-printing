            //columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}");
            columns.Bound(c => c.CreatedBy);
                        columns.Bound(c => c.Status);
                        columns.Bound(c => c.Remark);

                    })
                    .ToolBar(toolbar =>
                      {
                          toolbar.Template(@<text>
                            <div class="toolbar">
                                <i>Branch:</i>
                                @(Html.Kendo().DropDownListFor(m => m)
                                                      .Filter(FilterType.Contains)
                                                    .Name("BranchId")
                                                    .ValuePrimitive(true)
                                                    .OptionLabel("Select Branch...")
                                                    .DataTextField("Name")
                                                    .DataValueField("BranchId")
                                                    .Filter("contains")
                                                    .DataSource(dataSource =>
                                                    {
                                                                              dataSource.Read(read => read.Action("GetBranches", "CRMDataProvider", new { area = "CRM" }))
                                                                                  .ServerFiltering(false);
                                                                          })
                                )
                                <i>Store:</i>&nbsp;
                                @(Html.Kendo().DropDownListFor(model => model)
                                                            .Name("StoreID")
                                                            .Filter(FilterType.Contains)
                                                            .ValuePrimitive(true)
                                                            .OptionLabel("Select Store...")
                                                            .DataTextField("Description")
                                                            .CascadeFrom("BranchId")
                                                            .DataValueField("SalesStoreId")
                                                            .Filter("contains")
                                                            .Enable(false)
                                                            .DataSource(dataSource =>
                                                            {
                                                                                      dataSource.Read(read => read.Action("GetStoreInBranch", "CRMDataProvider", new { area = "CRM" }).Data("getSelectedBranch"))
                                                                          .ServerFiltering(true);
                                                                                  })
                                )
                                &nbsp;&nbsp;
                                @(Html.Kendo().Button()
                                                      .Name("btnPost")
                                                      .HtmlAttributes(new { type = "search", @class = "k-primary" })
                                                      .Events(e => e.Click("refreshGrid"))
                                                      .Icon("refresh")
                                                      .Content("Refresh"))

                            </div>
                        </text>);
                            })
                          .Events(ev =>
                          {
                              ev.DataBound("mainGridDataBound");
                          })
                          .HtmlAttributes(new { style = "height: 700px;" })
                          .Pageable(pageable => pageable
                                          .Input(true)
                                          .Numeric(false)
                                          .Refresh(true)
                                          .PageSizes(true)
                                          .ButtonCount(5))

                              .Scrollable()
                              .Sortable()
                              .Filterable()
                              .Scrollable(h => h.Height(500))
                          // .ClientDetailTemplateId("template")
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .Sort(s =>
                          {
                              s.Add(f => f.SalesShipmentId).Descending();
                          })
                          .Model(model =>
                          {
                              model.Id(p => p.SalesShipmentId);
                              model.Field(v => v.DateCreated).Editable(false);
                              model.Field(f => f.CreatedBy).Editable(false);
                              model.Field(v => v.Status).Editable(false);
                          })
                          .Events(ev => ev
                              .Error("error_handler(\"grid\")")
                              .RequestStart("onRequestStart(\"grid\")")
                              .RequestEnd("onRequestEnd(\"grid\")"))

                          .Read(read => read.Action("PartiallyIncompleteShipments_Read", "SalesShipment").Data("getSelectedBranchAndStore"))
                          ).ClientDetailTemplateId("template")
)
