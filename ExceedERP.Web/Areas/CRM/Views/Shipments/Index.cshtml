     function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "SalesShipment", new {area = "CRM"})',
                data: { id: id },
                success: function (result) {
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                },
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
      function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "SalesShipment", new { area = "CRM" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
    function regenerateDistribution(id) {
        $.ajax({
                type: "POST",
                url: '@Url.Action("RegenerateDistribution", "SalesShipment", new { area = "CRM" })',
                data: {
                    id: id,
                },
                success: function (result) {
                    alert(result.Message);
                    if (result.Status == "OK") {
                        location.reload(true);
                    }
                },
                error: function (result) {
                    alert(result);
                }
            });
    }
    function SwitchCustomer() {
        var OrganizationCustomer = $("#OrganizationCustomerId").data("kendoDropDownList").value();
        if (OrganizationCustomer == 0) {
            $("#NewCustomerArea").show();
        }
        else {
            $("#NewCustomerArea").hide();

            $("#CashSalesInvoiceID").data("kendoDropDownList").dataSource.read();
            $("#SalesOrderVoucherID").data("kendoDropDownList").dataSource.read();
        }

    }
    function onAdditionalData() {
        return {
            text: $("#NewCustomer").val()
        };
    }
    function onPeriodChange(e) {
        var drp = this;
        var id = drp.value();
        var voucherDate = $("#ShipmentDate").data("kendoDatePicker");
        var src = $("#Source").val();
        var invId = $("#CashSalesInvoiceID").val();
        var ordId = $("#SalesOrderVoucherID").val();
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPeriodRangesWithinShipmentReferencesDates", "CRMDataProvider", new { area = "CRM" })',
            data: { periodId: id, source: src, invoiceId: invId, orderId: ordId },
            success: function (result) {
                if (result) {
                    var ranges = result.split('_');
                    var start = ranges[0];
                    var end = ranges[1];
                    var startDate = new Date(start);
                    var endDate = new Date(end);
                    if (voucherDate) {
                        voucherDate.min(startDate);
                        voucherDate.max(endDate);
                        voucherDate.value(startDate);
                        voucherDate.trigger("change");
                    }
                }
            },
            error: function (result) {
            }
        });

    }
    function getSelectedBranch() {
        return {
            branchId: $("#BranchId").data("kendoDropDownList").value()
        };
    }
