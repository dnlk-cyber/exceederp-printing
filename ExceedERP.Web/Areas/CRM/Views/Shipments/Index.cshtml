@using ExceedERP.Core.Domain.CRM;
<legend>Shipments</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.SalesShipment>()
            .Name("grid")
            .Columns(columns =>
            {
                columns.Bound(c => c.SalesShipmentId).Title("#").Width(50);
                columns.Bound(c => c.Source).Width(80);
                columns.Group(g => g.Title("References").HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold;" })
                    .Columns(innerCols =>
                    {
                        innerCols.Bound(c => c.CashSalesInvoiceID).Width(70);
                        innerCols.Bound(c => c.FsInvoiceNumber).Width(70);
                        innerCols.Bound(c => c.SalesOrderVoucherID).Width(70);
                        innerCols.Bound(c => c.JobOrderNumber).Title("JO #").Width(70);
                        innerCols.Bound(c => c.StoreRequisitionNumber).Title("SRQ #").Width(70);
                        //innerCols.ForeignKey(c => c.CashSalesInvoiceID, (System.Collections.IEnumerable)ViewData["SalesInvoices"], "CashSalesInvoiceID", "InvoiceNumberDisplay").EditorTemplateName("SalesInvoiceSelector");
                        //innerCols.ForeignKey(c => c.SalesOrderVoucherID , (System.Collections.IEnumerable)ViewData["SalesOrderVouchers"], "SalesOrderVoucherID", "SalesOrderVoucherID");
                    })
                    );
                columns.ForeignKey(c => c.OrganizationCustomerId, (System.Collections.IEnumerable)ViewData["OrganizationCustomers"], "OrganizationCustomerID", "TradeName").Title("Customer").EditorTemplateName("CashOrgCustomerEditor").Width(90);
                columns.Bound(c => c.PlateNo).Width(90);
                columns.ForeignKey(c => c.BranchId, (System.Collections.IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(90);
                columns.ForeignKey(c => c.StoreID, (System.Collections.IEnumerable)ViewData["SalesStore"], "SalesStoreId", "Description").Width(90);
                columns.ForeignKey(c => c.CRMPeriodId, (System.Collections.IEnumerable)ViewData["CRMPeriods"], "CRMPeriodId", "Name").EditorTemplateName("OpenCRMPeriodsSelector").Width(90);
                //columns.ForeignKey(c => c.CashSalesInvoiceID, (System.Collections.IEnumerable)ViewData["SalesInvoices"], "CashSalesInvoiceID", "InvoiceNumberDisplay").EditorTemplateName("SalesInvoiceSelector");
                columns.Bound(c => c.ShipmentDate).Width(90);
                columns.Bound(c => c.MethodOfShipment).Width(90);
                columns.Bound(c => c.PlateNo).Width(90);

                //columns.Bound(c => c.DateCreated).Format("{0:yyyy-MM-dd}");
                columns.Bound(c => c.CreatedBy).Width(90);
                columns.Bound(c => c.Status).Width(90);
                columns.Bound(c => c.Remark).Width(100);
                columns.Command(command =>
                {
                    command.Edit().Text(" ");
                    command.Destroy().Text(" ");
                }).Width(100);
            })
            .ToolBar(toolbar =>
            {
            toolbar.Template(@<text>
                    <div class="toolbar">
                        <button class="k-button k-button-icontext k-grid-add btn btn-primary" href='#'>
                            <span class="k-icon k-i-add"></span>
                            Add new Record
                        </button>
                        &nbsp;
                    <button class="k-button k-button-icontext k-grid-excel" href='#'>
                        <span class="k-icon k-i-excel"></span>
                        Export to Excel
                    </button>
                        &nbsp;
                        @(Html.Kendo().CheckBox()
                                    .Name("showTransferableOnly")
                                    .HtmlAttributes(new { @onClick = "onCheckBoxClick(this.checked)" })
                                    .Label("Show Transferable Only"))
                    </div>
                    
                </text>);
            })
            .Events(ev =>
            {
                ev.DataBound("mainGridDataBound");
                ev.Edit("onShipmentEdit");
            })
            .Excel(ex =>
            {
                ex.AllPages(true);
            })
            .Editable(editable =>
            {
                editable.Mode(GridEditMode.PopUp);
                editable.TemplateName("ShipmentEditor");
                editable.Window(w =>
                {
                    w.Title("Shipment");
                    w.Scrollable(false);
                });
            })
            .HtmlAttributes(new { style = "height: 700px;" })
            .Pageable(pageable => pageable
                            .Input(true)
                            .Numeric(false)
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))

                .Scrollable()
                .Sortable()
                .Filterable()
                .Scrollable(h => h.Height(500))
            // .ClientDetailTemplateId("template")
            .DataSource(dataSource => dataSource
            .Ajax()
            .Sort(s =>
            {
                s.Add(f => f.SalesShipmentId).Descending();
            })
            .Model(model =>
            {
                model.Id(p => p.SalesShipmentId);
                model.Field(v => v.DateCreated).Editable(false);
                model.Field(f => f.CreatedBy).Editable(false);
                model.Field(v => v.Status).Editable(false);
            })
            .Events(ev => ev
                .Error("error_handler(\"grid\")")
                .RequestStart("onRequestStart(\"grid\")")
                .RequestEnd("onRequestEnd(\"grid\")"))

            .Read(read => read.Action("Shipments_Read", "SalesShipment").Data("getTransferableVisiblity"))
            .Create(create => create.Action("Shipment_Create", "SalesShipment", new { voucherDefinitionID = "2" }))
            .Update(update => update.Action("Shipment_Update", "SalesShipment"))
            .Destroy(destroy => destroy.Action("Shipment_Destroy", "SalesShipment"))
            ).ClientDetailTemplateId("template")
)



