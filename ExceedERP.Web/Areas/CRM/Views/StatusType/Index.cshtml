<legend>Status</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.StatusType>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.StatusTypeId);
          columns.Bound(c => c.Name);
          columns.Bound(c => c.ColorHolder).EditorTemplateName("ColorPicker").HtmlAttributes(new { style = "background-color:#:Color#;" });//.ClientTemplate("<div style='background-color:#=Color#;'> </div>");
          columns.Bound(c => c.Description);
          columns.Bound(c => c.Status).EditorTemplateName("FinalizeStatus");
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
        .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .HtmlAttributes(new { style = "height: 520px;" })
                                          .Pageable(pageable => pageable
                                                            .Input(true)
                                                            .Numeric(false)
                                                            .Refresh(true)
                                                            .PageSizes(true)
                                                            .ButtonCount(5))

                                                .Scrollable()
                                                .Sortable()
                                                .Filterable()
                                                .Groupable()
                                                .Scrollable(h => h.Height(500)).DataSource(dataSource => dataSource
              .Ajax().Model(model =>
                      {
                          model.Id(p => p.StatusTypeId);
                          model.Field(p => p.Color).DefaultValue("#ffffff");
                          model.Field(p => p.StatusTypeId).Editable(false);
    }) 
                    .Events(ev => ev
                                                                .Error("error_handler(\"grid\")")
                                                                .RequestStart("onRequestStart(\"grid\")")
                                                                .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("StatusTypes_Read", "StatusType"))
          .Create(create => create.Action("StatusTypes_Create", "StatusType"))
          .Update(update => update.Action("StatusTypes_Update", "StatusType"))
          .Destroy(destroy => destroy.Action("StatusTypes_Destroy", "StatusType"))
      )
)


<script>
    function preview(e) {
        $("#background").css("background-color", e.value);
    }
</script>