<script type="text/javascript">
    function getSelectedBranchId(e) {
        var dropdownlist = $("#BranchId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            branchId: $("#BranchId").val(), filterString: filterInput.val()
        };
    }
    function getCustomerFilterString(e) {
        var dropdownlist = $("#QueueCustomerId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            filterString: filterInput.val()
        };
    }
    function getSelectedCustomer(e) {
        var dropdownlist = $("#QueueId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            customerId: $("#QueueCustomerId").val(), filterString: filterInput.val()
        };
    }
    function toggleCustomerDetailRow(e) {
        var v = $("#QueueCustomerId").data("kendoDropDownList").value();
        if (v) {
            $("#customerDetailRow").show();
        }
        else {
            $("#customerDetailRow").hide();
        }
    }
    function sendForApproval(id) {
        var recordStatus = "";
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "QueueStatus", new { area = "CRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, 
            error: function (result) {
                alert(result);
            }
        });
    }
    function customerDataBound(e) {
        toggleCustomerDetailRow(e);
    }
    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approved") {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                $(this).addClass("k-state-Approved");
            }
            if (dataItem.Status == "WaitingApproval") {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            if (dataItem.Status == "Rejected") {
                $(this).addClass("k-state-Rejected");
            }

        });
    }
    function customerSelectorChange(e) {
        toggleCustomerDetailRow(e);

        var drp = this;
        var id = drp.value();
        
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetConcatnatedQueueCustomerData", "CRMDataProvider", new { area = "CRM" })',
            data: { id: id},
            success: function (result) {
                if (result) {
                    var values = result.split('_');
                    var tinNo = values[0];
                    var phoneNo = values[1];
                    var investmentType = values[2];

                    $("#TinNumber").val(tinNo);
                    $("#Phone").val(phoneNo);
                    $("#InvestmentType").val(investmentType);
                }
            }, 
            error: function (result) {
            }
        });

    }
    function queueSelectorChange(e) {

        var drp = this;
        var id = drp.value();
        
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetConcatnatedQueueData", "CRMDataProvider", new { area = "CRM" })',
            data: { id: id},
            success: function (result) {
                if (result) {
                    var values = result.split('_');
                    var approvedQ = values[0];
                    var remainingQ = values[1]
                    var branchId = values[2];
                    var locationId = values[3];
                    var store = "";
                    if (values.length == 5) {
                        store = values[4];
                    }

                    //$("#ApprovedQuantity").value(Number(approvedQ));
                    var apQtBox = $("#ApprovedQuantity").data("kendoNumericTextBox");
                    apQtBox.value(approvedQ);
                    apQtBox.trigger("change");

                    var remQtBox = $("#RemainingQuantity").data("kendoNumericTextBox");
                    remQtBox.value(remainingQ);
                    remQtBox.trigger("change");

                    var bdl = $("#BranchId").data("kendoDropDownList"); 
                    bdl.value(branchId);
                    bdl.trigger("change");

                    var ldl = $("#LocationMapId").data("kendoDropDownList");
                    //ldl.dataSource.read();

                    ldl.value(locationId);
                    ldl.trigger("change");

                    $("#Store").val(store);
                }
            }, 
            error: function (result) {
            }
        });

    }
    function shippedQuantityChanged(e) {
        var shipedQtyEditor = this;
        var previousShiped = 0;
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPreviouslyShippedQueue", "CRMDataProvider", new { area = "CRM" })',
            data: { id: $("#QueueId").val()},
            success: function (result) {
                if (result) {
                    previousShiped = Number(result);


                    var approved = $("#ApprovedQuantity").val();
                    var shipped = $("#ShippedQuantity").val()
                    var totalShipped = previousShiped + Number(shipped);
                    var maximumAvailableForShipping = Number(approved) - previousShiped;

                    var remainingQtEditor = $("#RemainingQuantity").data("kendoNumericTextBox");
                    var rem = Number(approved) - totalShipped;
                    if (rem < 0) {
                        rem = 0;

                        shipedQtyEditor.value(maximumAvailableForShipping);
                        shipedQtyEditor.trigger("change");
                    }
                    remainingQtEditor.value(rem);
                    remainingQtEditor.trigger("change");
                }
            }, 
            error: function (result) {
            }
        });
        //var approved = $("#ApprovedQuantity").val();
        //var shipped = $("#ShippedQuantity").val()
        //var totalShipped = previousShiped + Number(shipped);

        //var remainingQtEditor = $("#RemainingQuantity").data("kendoNumericTextBox");
        //var rem = Number(approved) - totalShipped;
        //if (rem < 0) {
        //    rem = 0;
        //}
        //remainingQtEditor.value(rem);
        //remainingQtEditor.trigger("change");
    }
</script>

