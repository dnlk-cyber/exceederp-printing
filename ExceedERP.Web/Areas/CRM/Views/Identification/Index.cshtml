<legend>Identification</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.Identification>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Reference);
        columns.Bound(c => c.Description);
        columns.Bound(c => c.IDNumber);
        columns.Bound(c => c.Type);
        columns.Bound(c => c.IssueDate);
        columns.Bound(c => c.ExpiryDate);
        columns.Bound(c => c.Issuer);
        columns.Bound(c => c.Remark);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
        .HtmlAttributes(new { style = "height: 520px;" })
                                                  .Pageable(pageable => pageable
                                                                    .Input(true)
                                                                    .Numeric(false)
                                                                    .Refresh(true)
                                                                    .PageSizes(true)
                                                                    .ButtonCount(5))

                                                        .Scrollable()
                                                        .Sortable()
                                                        .Filterable()
                                                        .Groupable()
                                                        .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.IdentificationID))
          .Read(read => read.Action("Identifications_Read", "Identification"))
          .Create(create => create.Action("Identifications_Create", "Identification"))
          .Update(update => update.Action("Identifications_Update", "Identification"))
          .Destroy(destroy => destroy.Action("Identifications_Destroy", "Identification"))
      )
)
