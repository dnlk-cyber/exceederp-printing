@using ExceedERP.Core.Domain.CRM
<legend>Sales Return</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.SalesReturn>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.SalesReturnId).Width(50).Title("#");

          columns.ForeignKey(c => c.BranchId, (System.Collections.IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector");
          columns.ForeignKey(c => c.CustomerId, (System.Collections.IEnumerable)ViewData["Customers"], "OrganizationCustomerID", "TradeName").EditorTemplateName("CustomerEditorTemplate");
          columns.Bound(c => c.CustomerTin);
          columns.ForeignKey(c => c.CRMPeriodId, (System.Collections.IEnumerable)ViewData["CRMPeriods"], "CRMPeriodId", "Name").EditorTemplateName("OpenCRMPeriodsSelector");
          columns.Bound(c => c.Date);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.Reason);
          columns.Bound(c => c.TotalAmount).Format("{0:N2}");
          columns.Bound(c => c.Status);

          columns.Command(command =>
          {
              command.Edit(); command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar => {
          toolbar.Create();
          toolbar.Excel();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Events(e =>
      {
          e.DataBound("mainGridDataBound");
          e.DetailExpand("onMainGridExpand");
      })
      .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))
      .Navigatable()
      .Selectable(selectable => {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable => {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Scrollable(s => s.Height(700))

      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model =>
          {
              model.Id(p => p.SalesReturnId);
              model.Field(f => f.Status).Editable(false);
              model.Field(f => f.SalesReturnId).Editable(false);
              model.Field(f => f.TotalAmount).Editable(false);
              model.Field(f => f.BusinessUnitId).Editable(false);
          })
          .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("SalesReturn_Read", "SalesReturn"))
          .Create(create => create.Action("SalesReturn_Create", "SalesReturn"))
          .Update(update => update.Action("SalesReturn_Update", "SalesReturn"))
          .Destroy(destroy => destroy.Action("SalesReturn_Destroy", "SalesReturn"))
      ).ClientDetailTemplateId("sales_return_line_items")
)
<script type="text/kendo-templ" id="sales_return_line_items">
    @(Html.Kendo().TabStrip()
    .Name("tab_#=SalesReturnId#")
    .SelectedIndex(0)
    .Items(items => {
        items.Add().Text("Detail").Content(@<text>
                    <div>
                        # if (!IsSendForApproval)
                        {#
                        <a onclick='return sendForApproval("#=SalesReturnId#")' href='\#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                        # }#
                    </div>

                    # if (IsOnlineApproved &&!IsOnlineTransferred)
                    {#
                        @if (HttpContext.Current.User.IsInRole(CRMRoles.CRMVoid))
                        {
                            <a onclick='return voidRecord("#=SalesReturnId#")' href='\#' title='Void Record'><i class='fa  fa-bolt fa-2x' style='color:red'></i></a>
                        }
                    # } #
                    @(Html.Kendo().PanelBar()
                    .Name("panelbar_#=SalesReturnId#")
                    .ExpandMode(PanelBarExpandMode.Multiple)
                    .Items(panelbar =>
                    {
                        panelbar.Add()
                            .Expanded(true)
                            .Text("Detail")
                            .Content(
                                "<div>" +
                                "<ul>" +
                                "<li> <label> Status: </label> <strong> #=Status != null ? Status: ' '# </strong> </li>" +
                                "<li> <label> Created by: </label> <strong> #=CreatedBy != null ? CreatedBy: ' '# </strong> </li>" +
                                "<li> <label> Created on: </label> #= kendo.toString(DateCreated, 'dd/MM/yyyy H:mm:ss')# </li>" +
                                "<li> <label> Modified by :</label> #= ModifiedBy != null ? ModifiedBy: ''# </li>" +
                                "<li> <label> Last Modified :</label> #= LastModified != null ? kendo.toString(LastModified, 'dd/MM/yyyy H:mm:ss') : ' '# </li>" +
                                "<li> <label> Remark: </label> <strong> #=Remark != null ? Remark : ' '# </strong> </li>" +
                                "</ul>" +
                                "</div>"
                            );
                                            
                    }).ToClientTemplate()
                )                                
        </text>);
        items.Add().Text("Line Items").Content(@<text>
            #if(IsOnlineApproved){#
                @LineItemHelper()
            #}else {#
                @LineItemHelperWithCrud()
            #}#
        </text>);
        
        items.Add().Text("Validation").Content(@<text>
            #if(IsSendForApproval && !IsOnlineApproved){#
                @ValidationHelperWithCrud()
            #}else {#
                @ValidationHelper()
            #}#
        </text>);
    }).ToClientTemplate()
    )
</script>
<script>
    function mainGridDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            if (dataItem.IsOnlineApproved === true) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.addClass("k-state-approved");
            } else if (dataItem.IsSendForApproval) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.addClass("k-state-waiting-approval");
            }
            else if (dataItem.Status == "Rejected") {
                row.addClass("k-state-Rejected");
            }
            else {

                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").show();
            }
        }
    }
    var globalCustomerId = 0;
    var expandedRow;
    function onMainGridExpand(e) {
        var masterRow = e.masterRow;
        var masterGrid = this;

        // Only one open at a time
        if (expandedRow != null && expandedRow[0] != e.masterRow[0]) {
            masterGrid.collapseRow(expandedRow);
        }
        expandedRow = e.masterRow;

        var masterDataItem = masterGrid.dataItem(masterRow);
        globalCustomerId = masterDataItem.CustomerId;
    }
    function getSalesReturnHeaderInfo() {
        return {
            customerId: globalCustomerId,
            paymentType: $("#PaymentType").val()
        };
    }
    function getInvoiceReference() {
        return {
            invoiceNumber: $("#SalesReference").val()
        };
    }
    function getSalesAndShipmentReference() {
        return {
            invoiceNumber: $("#SalesReference").val(),
            shipmentId: $("#ShipmentReference").val()
        }
    }
    function onPaymentTypeChange(e) {
        $("#SalesReference").data("kendoDropDownList").dataSource.read();
    }
    function onSalesReferenceChange(e) {
        $("#ShipmentReference").data("kendoDropDownList").dataSource.read();
        $("#ProductId").data("kendoDropDownList").dataSource.read();
    }
    function onProductChange(e) {
        $("#ProductId").data("kendoDropDownList").dataSource.read();
    }
    
    function sendForApproval(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "SalesReturn", new { area = "CRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                if (result.Status == "OK") {
                    location.reload(true);
                }
            }, 
            error: function (result) {
                alert(result);
            }
        });
    }
    function voidRecord(id) {
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "SalesReturn", new {area = "CRM"})',
                data: { id: id },
                success: function (result) {
                    alert(result.Message);
                    location.reload(true);
                },
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
    function onPeriodChange(e) {
        var drp = this;
        var id = drp.value();
        var voucherDate = $("#Date").data("kendoDatePicker");
        var refOrderId = $("#References").val();

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPeriodRangesWithinSalesSingleSalesOrderDates", "CRMDataProvider", new { area = "CRM" })',
            data: { periodId: id, orderId: refOrderId },
            success: function (result) {
                if (result) {
                    var ranges = result.split('_');
                    var start = ranges[0];
                    var end = ranges[1];
                    var startDate = new Date(start);
                    var endDate = new Date(end);
                    if (voucherDate) {
                        voucherDate.min(startDate);
                        voucherDate.max(endDate);
                        voucherDate.value(startDate);
                        voucherDate.trigger("change");
                    } 
                }
            }, 
            error: function (result) {
            }
        });

    }
    function onCustomerChange(e) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetCustomerTin", "CRMDataProvider", new { area = "CRM" })',
            data: { id: this.value() },
            success: function (result) {
                $("#CustomerTin").val(result);
                $("#CustomerTin").trigger("change");
            }
        });
    }
    
    function getSelectedBranch() {
        return {
            branchId: $("#BranchId").data("kendoDropDownList").value()
        };
    }

    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "SalesReturn", new { area = "CRM" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
    function regenerateDistribution(id) {
        $.ajax({
                type: "POST",
                url: '@Url.Action("RegenerateDistribution", "SalesReturn", new { area = "CRM" })',
                data: {
                    id: id,
                },
                success: function (result) {
                    alert(result.Message);
                    if (result.Status == "OK") {
                        location.reload(true);
                    }
                }, 
                error: function (result) {
                    alert(result);
                }
            });
    }
</script>

