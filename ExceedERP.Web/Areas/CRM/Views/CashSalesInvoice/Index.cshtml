<script>
    function ClearValMsg() {
        $("#StoreVal").text("");
        $("#ProductVal").text("");
        $("#TaxVal").text("");
        $("#PriceTagVal").text("");
        $("#PriceTagDetailVal").text("");
        $("#QuantityVal").text("");
        return false;
    }
    function ValidateInput() {
        var ValidationCount = 0;
        var StoreObject = $("#StoreID").data("kendoDropDownList");
        var StoreId = StoreObject.value();
        if (StoreId == "" || StoreId == null) {
            $("#StoreVal").text("Required");
            ValidationCount = ValidationCount + 1;


        }
        var ProductObject = $("#ThingID").data("kendoDropDownList");
        var ProductId = ProductObject.value();
        if (ProductId == "" || ProductId == null) {
            $("#ProductVal").text("Required");
            ValidationCount = ValidationCount + 1;

        }
        var TaxObject = $("#Tax").data("kendoDropDownList");
        var TaxId = TaxObject.value();
        if (TaxId == "" || TaxId == null) {
            $("#TaxVal").text("Required");
            ValidationCount = ValidationCount + 1;

        }

        var PriceTagObject = $("#PriceTag").data("kendoDropDownList");
        var PriceTagId = PriceTagObject.value();
        if (PriceTagId == "" || PriceTagId == null) {
            $("#PriceTagVal").text("Required");
            ValidationCount = ValidationCount + 1;

        }
        //var PriceTagDetailObject = $("#PriceTagDetail").data("kendoDropDownList");
        //var PriceTagDetailId = PriceTagDetailObject.value();
        //if (PriceTagDetailId == "" || PriceTagDetailId == null) {
        //    $("#PriceTagDetailVal").text("Required");
        //    ValidationCount = ValidationCount + 1;

        //}

        var AmountId = $("#Quantity").val();
        if (AmountId == "0" || AmountId == "" || AmountId == null) {
            $("#QuantityVal").text("Amount Can't Be 0 ");
            ValidationCount = ValidationCount + 1;
        }
        var AmountId = $("#Quantity").val();
        var StockBaalance = $("#StockBalance").val();
        if (parseFloat(AmountId) > parseFloat(StockBaalance)) {
            alert("Quantity Greater Than Stock Balance");
            ValidationCount = ValidationCount + 1;
        }
        if (ValidationCount > 0) {
            return false;
        }

    }

    function filterSourceType() {
        var dropdownlist = $("#References").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            source: $("#Source").val(), filterString: filterInput.val()
        };
    }
    function filterSourceTypeAndCustomerId() {
        var dropdownlist = $("#References").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            source: $("#Source").val(), customerId: $("#OrganizationCustomerId").val(), filterString: filterInput.val()
        };
    }
    //
    // refresh CRM Period Selector when referenced Sales Order Id changes
    function referenceSelectorChanged(e) {
        var ddl = $("#CRMPeriodId").data("kendoDropDownList");
        ddl.dataSource.read();

        var refDdl = this;
        var refId = refDdl.value();
        updateBranchSelector(refId);
    }
    function getReferencedOrderId(){
        return {
            orderId: $("#References").val()
        };
    }
    function updateBranchSelector(orderId)
    {
        $.ajax({
            url: '@Url.Action("GetReferedSingleSalesOrderBranchId", "CRMDataProvider", new { area = "CRM"})',
            data: { orderId: orderId },
            type: 'POST',
            cache: false,
            success: function (result) {
                if (result) {
                    var branchId = result;
                    var bdl = $("#BranchId").data("kendoDropDownList");
                    bdl.value(branchId);
                    bdl.trigger("change");
                }
            }
        });
    }
    function onPeriodChange(e) {
        var drp = this;
        var id = drp.value();
        var voucherDate = $("#Date").data("kendoDatePicker");
        var refOrderId = $("#References").val();

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPeriodRangesWithinSalesSingleSalesOrderDates", "CRMDataProvider", new { area = "CRM" })',
            data: { periodId: id, orderId: refOrderId },
            success: function (result) {
                if (result) {
                    var ranges = result.split('_');
                    var start = ranges[0];
                    var end = ranges[1];
                    var startDate = new Date(start);
                    var endDate = new Date(end);
                    if (voucherDate) {
                        voucherDate.min(startDate);
                        voucherDate.max(endDate);
                        voucherDate.value(startDate);
                        voucherDate.trigger("change");
                    } 
                }
            }, 
            error: function (result) {
            }
        });

    }
    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "CashSalesInvoice", new {area = "CRM"})',
                data: { id: id },
                success: function (result) {
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                },
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
    function regenerateDistribution(id) {
        $.ajax({
                type: "POST",
                url: '@Url.Action("RegenerateDistribution", "CashSalesInvoice", new { area = "CRM" })',
                data: {
                    id: id,
                },
                success: function (result) {
                    alert(result.Message);
                    if (result.Status == "OK") {
                        location.reload(true);
                    }
                }, 
                error: function (result) {
                    alert(result);
                }
            });
    }
    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "CashSalesInvoice", new { area = "CRM" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function onAdditionalData() {
        return {
            text: $("#NewCustomer").val()
        };
    }
</script>
