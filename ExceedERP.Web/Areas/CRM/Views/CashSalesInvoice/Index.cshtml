    function PartialonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);

            if (dataItem.IsPaymentProcessed == true) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();

            }

        });
    }

    function onDataBound(e) {
        var grid = this;
        var LineitemGrid = $("#LineItems").data("kendoGrid");

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);

            if (dataItem.LastObjectState == "Waiting Administrative Approval" ||
                dataItem.LastObjectState == "WaitingApproval" ||
                dataItem.LastObjectState == "Waiting Approval")
            {
                //$(this).find(".reject").remove();
                //$(this).find(".k-grid-PrintToPos").remove();
                $(this).find(".k-grid-edit").remove();
                //$(this).find(".k-grid-Pay").remove();
                $(this).find(".k-grid-delete").remove();
                //$(this).find(".k-grid-Reject").remove();
                $(this).addClass("k-state-waiting-approval");
            }
            //if (dataItem.IsReceiptPrinted == true) {
            //    $(this).find(".k-grid-PrintToPos").remove();
            //}
            if (dataItem.LastObjectState == "Forwarded" ||
                dataItem.LastObjectState == "Approved" ||
                dataItem.LastObjectState == "Hold" ||
                dataItem.LastObjectState == "Printed" ||
                dataItem.LastObjectState == "PaymentReceived" ||
                dataItem.LastObjectState == "Product_Issued")
            {
                $(this).find(".reject").remove();
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-Pay").remove();
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-Reject").remove();
            }
            if (dataItem.LastObjectState == "Forwarded" ||
                dataItem.LastObjectState == "PaymentReceived" ||
                dataItem.LastObjectState == "Approved" ||
                dataItem.LastObjectState == "Product_Issued")
            {
                $(this).addClass("k-state-approved");
            }
            if (dataItem.LastObjectState == "Hold") {
                $(this).addClass("k-state-hold");
            }
            if (dataItem.LastObjectState == "Printed") {
                $(this).addClass("k-state-printed");
            }
            if (dataItem.LastObjectState == "Rejected") {
                $(this).addClass("k-state-Rejected");
            }
            if (dataItem.IsSendForApproval == false) {
                $(this).find(".reject").remove();
                $(this).find(".k-grid-Pay").remove();
                $(this).find(".k-grid-Reject").remove();
                //$(this).find(".k-grid-PrintToPos").remove();

            }
            //if (dataItem.References == "Manual") {

            //    $(this).find(".k-grid-Reject").remove();
            //}
        });
