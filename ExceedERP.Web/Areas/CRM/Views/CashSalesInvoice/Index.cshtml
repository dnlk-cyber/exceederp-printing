@model ExceedERP.Core.Domain.CRM.CashSalesInvoice
@using ExceedERP.Web.Areas.CRM.Models;
@using ExceedERP.Core.Domain.CRM;

<style>
    .k-grid table tr.k-state-Issued {
        background: #99e6ff;
        color: #040000;
    }
    .k-grid table tr.k-state-waiting-approval {
        background: #ffffcc;
    }
    .k-grid table tr.k-state-approved {
        background: #99e6ff;
        color: #040000;
    }
    .k-grid table tr.k-state-Rejected {
        background: #fcabab;
        color: #040000;
    }
    .k-grid table tr.k-state-hold {
        background: #99c2ff;
        color: #040000;
    }
    .k-grid table tr.k-state-printed {
        background: #b7ff9e;
        color: #040000;
    }

    fieldset.scheduler-border {
        border: 1px ridge #e6e6e6 !important;
        /*border: 1px ridge #e88686 !important;*/
        padding: 0 1.4em 1.4em 1.4em !important;
        margin: 0 0 1.5em 0 !important;
        -webkit-box-shadow: 0px 0px 0px 0px #000;
        box-shadow: 0.5px 0.5px 0px 0px #ccc;
    }

    legend.scheduler-border {
        font-size: 1.2em !important;
        font-weight: bold !important;
        text-align: left !important;
        /*padding: 0 10px;*/ /* To give a bit of padding on the left and right */
        border-bottom: none;
    }
</style>

<legend>Cash Sales Invoice</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.CashSalesInvoice>()
          .Name("CashSalesInvoice")
          .Columns(columns =>
          {
              columns.Bound(c => c.CashSalesInvoiceID).Title("#").Width(50);
              columns.Bound(c => c.JobOrderNumber).Title("JO #").Width(80);
              columns.Bound(c => c.Source).Width(100);
              columns.Bound(c => c.References).Width(80);
              columns.Bound(c => c.FsInvoiceNo).Width(80);
              columns.Bound(c => c.ReceiptReference).Width(100);
              columns.ForeignKey(c => c.OrganizationCustomerId, (System.Collections.IEnumerable)ViewData["OrganizationCustomers"], "OrganizationCustomerID", "TradeName").Title("Customer").EditorTemplateName("CashOrgCustomerEditor").Width(100);
              columns.Bound(c => c.PlateNo).Width(80);
              columns.ForeignKey(c => c.BranchId, (System.Collections.IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(100);
              columns.ForeignKey(c => c.StoreID, (System.Collections.IEnumerable)ViewData["SalesStore"], "SalesStoreId", "Description").Width(100);
              columns.ForeignKey(c => c.CRMPeriodId, (System.Collections.IEnumerable)ViewData["CRMPeriods"], "CRMPeriodId", "Name").EditorTemplateName("OpenCRMPeriodsSelector").Width(100);
              columns.Bound(c => c.Date).Width(100);
              //columns.Bound(c => c.PaymentMethod).Title("Payment Method").EditorTemplateName("PaymentMethodType").Width(120);
              columns.ForeignKey(c => c.RecieveMethod, (System.Collections.IEnumerable)ViewData["PaymentMethod"], "PaymentMethodID", "Method").Title("Recieve Method").EditorTemplateName("RecieveMethodType").Width(120);
              columns.ForeignKey(c => c.PaymentTermsID, (System.Collections.IEnumerable)ViewData["PaymentTerms"], "PaymentTermsID", "PaymentTermsDays").EditorTemplateName("PaymentTermsSelector").Width(100);
              columns.Bound(c => c.GrandTotal).Format("{0:N4}").Width(100);
              columns.Bound(c => c.LastObjectState).Width(100);
              columns.Bound(c => c.CreatedBy).Width(100);
              columns.Bound(c => c.Remark).Width(100);
              columns.Bound(c => c.ShipmentGenerationMethod).Width(100);
              columns.Bound(c => c.CustomerTINNumber).Width(100);
              columns.Command(command =>
              {
                  command.Edit();
                  //command.Custom("Reject").Click("RejectPopUp").HtmlAttributes("class='btn-danger'");
                  //command.Custom("Pay").Click("PaymentPopUp").HtmlAttributes("class='btn-success'");
                  //command.Custom("PrintToPos").Text("&nbsp;&nbsp;Print to POS").IconClass("fa fa-print").Click("printToPosClick").HtmlAttributes("class='btn btn-primary'");
                  command.Destroy();

              }).Width(200);

          })
          .ToolBar(toolbar =>
          {
          toolbar.Template(@<text>
                    <div class="toolbar">

                        <button class="k-button k-button-icontext k-grid-add btn btn-primary" href='#'>
                            <span class="k-icon k-i-add"></span>
                            Add new Record
                        </button> 
                        &nbsp;
                        <button class="k-button k-button-icontext k-grid-excel" href='#'>
                            <span class="k-icon k-i-excel"></span>
                            Export to Excel
                        </button>
                        &nbsp;
                        @(Html.Kendo().CheckBox()
                            .Name("showTransferableOnly")
                            .HtmlAttributes(new { @onClick="onCheckBoxClick(this.checked)", @style="vertical-align:center;"})
                            .Label("Show Transferable Only"))

                    </div>
                </text>);
          })
                    .Events(ev =>
                    {
                        //ev.DetailExpand("onDetailExpand");
                        ev.DataBound("onDataBound");

                    })
                .Editable(editable =>
                {
                    editable.Mode(GridEditMode.PopUp);
                    editable.TemplateName("CashSaleEditor");
                    editable.Window(w => w.Title("Cash Sale Invoice"));
                    //editable.DisplayDeleteConfirmation("Are You Sure To Approve Invoice");
                })
                .Excel(ex =>
                {
                    ex.AllPages(true);
                })
                .HtmlAttributes(new { style = "height: 700px;" })
                    .Pageable(pageable => pageable
                                        .Input(true)
                                        .Numeric(false)
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))

                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Scrollable(h => h.Height(500))
                .Events(ev => ev.DetailExpand("onDetailExpandUser"))
                .DataSource(dataSource => dataSource
                .Ajax()
                .Events(ev => ev
                            .Error("error_handler(\"CashSalesInvoice\")")
                            .RequestStart("onRequestStart(\"CashSalesInvoice\")")
                            .RequestEnd("onRequestEnd(\"CashSalesInvoice\")"))
                .Sort(x => x.Add(s => s.CashSalesInvoiceID).Descending())
                .Model(model =>
                {
                    model.Id(p => p.CashSalesInvoiceID);
                    model.Field(p => p.GrandTotal).Editable(false);

                    model.Field(p => p.CashSalesInvoiceID).Editable(false);
                    //model.Field(p => p.References).Editable(false);
                    //model.Field(v => v.Status).Editable(false);
                    //model.Field(v => v.Remark).Editable(false);
                })
                .Read(read => read.Action("CashSalesInvoices_Read", "CashSalesInvoice").Data("getTransferableVisiblity"))
                .Create(create => create.Action("CashSalesInvoices_Create", "CashSalesInvoice"))
                .Update(update => update.Action("CashSalesInvoices_Update", "CashSalesInvoice"))
                .Destroy(destroy => destroy.Action("CashSalesInvoice_Destroy", "CashSalesInvoice"))

                ).ClientDetailTemplateId("template")
)

