<script>

    var detailsTemplate = kendo.template($("#Rejectemplate").html());
    var Paymentemplate = kendo.template($("#Paymentemplate").html());
    function RejectPopUp(e) {
        e.preventDefault();

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var wnd = $("#Details").data("kendoWindow");

        wnd.content(detailsTemplate(dataItem));
        wnd.center().open();
    }
    function PaymentPopUp(e) {
        e.preventDefault();

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var wnd = $("#SelectPaymentMethod").data("kendoWindow");

        wnd.content(Paymentemplate(dataItem));
        wnd.center().open();
    }

    function PrintPOS(e, InvoiceId) {
        $.ajax({
            url: '@Url.Action("PrintPos", "CashSalesInvoice")',
            data: { InvoiceId: InvoiceId },
            type: 'POST',
            cache: false,
            success: function (result) {

                alert(result.Message);
            }

        });

    }
    function PrintPartialPOS(e, InvoiceId, PartialItemId) {
        $.ajax({
            url: '@Url.Action("PrintPartialPos", "CashSalesInvoice")',
            data: { InvoiceId: InvoiceId, PartialId: PartialItemId },
            type: 'POST',
            cache: false,
            success: function (result) {

                alert(result.Message);
            }

        });

    }
    function filterPayment() {
        return {
            customerId: $("#OrganizationCustomerId").val()
        };
    }
    function filterThing() {
        return {
            StoreID: $("#StoreID").val()
        };
    }


    function filterVariety() {
        return {
            ThingID: $("#ThingID").val()
        };
    }
    function filterclass() {
        return {
            ProductName: $("#ThingID").val()
        };
    }
    function SwitchCustomer() {
        var OrganizationCustomer = $("#OrganizationCustomerId").data("kendoDropDownList").value();
        if (OrganizationCustomer == 0) {
            $("#NewCustomerArea").show();
        }
        else {
            $("#NewCustomerArea").hide();
        }

    }
    function GetStockBalance() {

        var storeobj = $("#StoreID").data("kendoDropDownList");
        var stID = storeobj.value();
        var thingobj = $("#ThingID").data("kendoDropDownList");
        var tID = thingobj.value();

        $.ajax({
            url: '@Url.Action("GetStockBalance", "CRMDataProvider")',
            data: { storeID: stID, productID: tID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                $("#UnitAmount").val('0.0');
                $("#TaxAmount").val('0.0');
                $("#TotalAmount").val('0.0');
                if (r != 0) {
                    var s = r.split(/_/);
                    $("#StockBalance").val(s[0]);
                    $("#CalculatedCost").val(s[1]);
                    $("#StockBalanceReserved").val(s[2]);
                } else {
                    $("#StockBalance").val('0.0');
                    $("#CalculatedCost").val('0.0');
                    $("#StockBalanceReserved").val('0.0');
                }
            }

        });
    }
    function GetPriceParameter() {
        var id = masterDataItem.ThingID;
        return {
            productID: id
        };
    }


    function UpdatePriceChange() {

        var priceTagDetail = $("#PriceTagDetail").data("kendoDropDownList");
        var priceTag = $("#PriceTag").data("kendoDropDownList");
        var product = $("#ThingID").data("kendoDropDownList");
        //var priceCode = priceObject.value();

        $.ajax({
            url: '@Url.Action("GetPriceValue", "CRMDataProvider")',

            data: { priceTagID: priceTag.value(), priceTagDetailID: priceTagDetail.value(), productID: product.value() },
            type: 'POST',
            cache: false,
            success: function (result) {
                if (result == "") {
                    result = 0;
                }
                else {
                    $("#UnitAmount").val(parseFloat(result));
                }

            }, error: function () {
                $("#UnitAmount").val("0");
            }

        });

    }

    function GetPriceTagDetailParameter() {
        var pt = $("#PriceTag").data("kendoDropDownList");
        return {
            priceTag: pt.value()
        };
    }


    function GetTaxValue() {

        var taxObject = $("#Tax").data("kendoDropDownList");
        var taxID = taxObject.value();
        var unitAmountValue = $("#UnitAmount").val();
        var quantityValue = $("#Quantity").val();
        var InsuranceCost = $("#InsuranceCost").val();
        var FreightCost = $("#FreightCost").val();
        var OtherCost = $("#OtherCost").val();
        var GrowthValue = parseInt(quantityValue);// + parseInt(InsuranceCost) + parseInt(FreightCost) + parseInt(OtherCost);


        $.ajax({
            url: '@Url.Action("GetTaxValue", "CRMDataProvider")',
            data: { taxID: taxID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                var calculatedTax = (r / 100) * parseInt(quantityValue) * unitAmountValue;
                var calculatedTotalAmount = (quantityValue * unitAmountValue) + calculatedTax ;
                calculatedTax = parseFloat(Math.round(calculatedTax)).toFixed(2);
                calculatedTotalAmount = parseFloat(Math.round(calculatedTotalAmount)).toFixed(2);
                $("#TaxAmount").val(calculatedTax);
                $("#TotalAmount").val(calculatedTotalAmount);
            }

        });
    }



</script>
<script>
    var id;
    var masterId;
    var gridName;
    var thingId;


    function BindNonTransaction() {



        $.ajax({
            url: '@Url.Action("GetInvoiceDetail", "CRMDataProvider")',
            data: { InvoiceID: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                //    console.error(r);
                if (r != 0) {
                    var s = r.split(/_/);
                    $("#Consignee").val(s[0]);
                    $("#ReceiveMethod").val(s[1]);

                } else {
                    $("#Consignee").val('Not Defined');
                    $("#ReceiveMethod").val('Not Defined');

                }
            }

        });
    }
    function PartialonDataBound(e) {
        var grid = this;

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);

            if (dataItem.IsPaymentProcessed == true) {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();

            }

        });
    }

    function onDataBound(e) {
        var grid = this;
        var LineitemGrid = $("#LineItems").data("kendoGrid");

        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);

            if (dataItem.LastObjectState == "Forwarded" || dataItem.LastObjectState == "PaymentReceived" || dataItem.LastObjectState == "Product_Issued") {
                $(this).find(".reject").remove();
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-Pay").remove();
                // $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-Reject").remove();
                $(this).addClass("k-state-Issued");
            }


            if (dataItem.IsSendForApproval == false) {
                $(this).find(".reject").remove();
                $(this).find(".k-grid-Pay").remove();
                $(this).find(".k-grid-Reject").remove();
            }
            if (dataItem.References == "Manual") {

                $(this).find(".k-grid-Reject").remove();
            }
        });
    }
    function onDetailExpand(e) {
        var masterRow = e.masterRow;
        //var masterGrid = $("#grid").data("kendoGrid");
        var masterGrid = $("#CashSalesInvoice").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        masterId = masterDataItem.CashSalesInvoiceID;

        gridName = "#LineItems_" + masterId;


    }
    function GetThingId(e) {
        var masterRow = this.wrapper.closest("tr.k-detail-row").prev(".k-master-row");
        var masterGrid = $(gridName).data("kendoGrid");
        var masterDataItem = masterGrid.dataItem(masterRow);
        id = masterDataItem.ThingID;
    }
    function GetThingIdValue() {
        return { thingId: id }
    }
    function DisplayReferenceInformation() {
        var salesOrderVoucherObject = $("#SalesOrderVoucherReference").data("kendoComboBox");
        var salesOrderVoucherID = salesOrderVoucherObject.value();
        $.ajax({
            url: '@Url.Action("PopulateSalseOrderVoucherForReference", "CashSalesInvoice")',
            data: { salesOrderVoucherID: salesOrderVoucherID },
            type: 'POST',
            cache: false,
            success: function (result) {
                if (result != "") {

                    alert(result);
                }
            }

