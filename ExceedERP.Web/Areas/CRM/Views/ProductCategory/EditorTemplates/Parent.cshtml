@(Html.Kendo().DropDownListFor(m => m)
                  .AutoBind(false)
                  .OptionLabel("Select")
                  .DataTextField("Description")
                  .DataValueField("Code")
                  .AutoBind(true)
                  .Filter(FilterType.Contains)
                  .ValuePrimitive(true)
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetThingCategory", "CRMDataProvider"))
                                .ServerFiltering(false);
                  })

)
