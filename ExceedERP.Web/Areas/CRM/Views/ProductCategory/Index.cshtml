<legend>Product Category</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.ProductCategory>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.InventoryCategoryCode, (System.Collections.IEnumerable)ViewData["ItemCategorys"], "ItemCategoryCode", "Name").EditorTemplateName("InventoryItemCategorySelector").Width(150);
          columns.Bound(c => c.Description).Width(120);
          columns.ForeignKey(c => c.Parent, (System.Collections.IEnumerable)ViewData["CategoryList"], "ProductCategoryId", "Description").EditorTemplateName("Parent").Width(100);

          columns.Bound(c => c.SalesAccountCode).EditorTemplateName("AccountCode").Width(220);
          columns.Bound(c => c.InventoryAccountCode).EditorTemplateName("AccountCode").Width(220);
          columns.Bound(c => c.UnEarnedAccountCode).EditorTemplateName("AccountCode").Width(220);
          columns.Bound(c => c.IsActive).ClientTemplate("<input type='checkbox'  disabled='true' value='#=IsActive #' " + " # if (IsActive) { #" + "checked='checked'" + "# } #" + " />").Title("Is Active").Width(100);
          columns.Bound(c => c.Remark).Width(150);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(200);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Events(ev => {
          ev.DataBound("mainGridDataBound");
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
             .HtmlAttributes(new { style = "height: 700px;" })
                              .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))

                                    .Scrollable()
                                    .Sortable()
                                    .Filterable()
                                    .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
              .Model(model => model.Id(p => p.ProductCategoryId))
              .Events(ev => ev
                                                                    .Error("error_handler(\"grid\")")
                                                                 .RequestStart("onRequestStart(\"grid\")")
                                                               .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("ProductCategories_Read", "ProductCategory"))
          .Create(create => create.Action("ProductCategories_Create", "ProductCategory"))
          .Update(update => update.Action("ProductCategories_Update", "ProductCategory"))
          .Destroy(destroy => destroy.Action("ProductCategories_Destroy", "ProductCategory"))



                              )
)

 <script type="text/javascript">
     function mainGridDataBound(e){
    var grid = this;
       
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);

            if (dataItem.HasTransaction == true) {

                //$(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
        });
     }
     function onInventoryCategoryChange(e) {
         var ddl = this;
         var concatName = ddl.text();
         var nameOnly = concatName.replace(ddl.value(), "");
         var inptTxt = $("#Description").val();
         if (!inptTxt && ddl.value()) {
             $("#Description").val(nameOnly.trim());
             $("#Description").trigger("change");
         }
     }
 </script>