        {
           msg.Select("<i class = \"fa fa-upload\"></i> Upload Documents");
        })
        .ShowFileList(false)
        .Async(s => s.Save("ContractDocument_Upload", "VoucherContractDocument", new { voucher = "#=SalesOrderVoucherID#", type = VoucherType.SalesOrder })
        )
        //.Events(e => e.Complete("contractAttachementSuccess"))
        .Events(events => events.Complete(
                            @<text>
                                function(e) {
