<script>
    function ClearValMsg() {
        $("#StoreVal").text("");
        $("#ProductVal").text("");
        $("#TaxVal").text("");
        $("#PriceTagVal").text("");
        $("#PriceTagDetailVal").text("");
        $("#QuantityVal").text("");
        return false;
    }
    function ValidateInput() {
        var ValidationCount = 0;
        var StoreObject = $("#StoreID").data("kendoDropDownList");
        var StoreId = StoreObject.value();
        if (StoreId == "" || StoreId == null) {
            $("#StoreVal").text("Required");
            ValidationCount = ValidationCount + 1;

        }
        var ProductObject = $("#ThingID").data("kendoDropDownList");
        var ProductId = ProductObject.value();
        if (ProductId == "" || ProductId == null) {
            $("#ProductVal").text("Required");
            ValidationCount = ValidationCount + 1;

        }
        var TaxObject = $("#Tax").data("kendoDropDownList");
        var TaxId = TaxObject.value();
        if (TaxId == "" || TaxId == null) {
            $("#TaxVal").text("Required");
            ValidationCount = ValidationCount + 1;

        }

        var PriceTagObject = $("#PriceTag").data("kendoDropDownList");
        var PriceTagId = PriceTagObject.value();
        if (PriceTagId == "" || PriceTagId == null) {
            $("#PriceTagVal").text("Required");
            ValidationCount = ValidationCount + 1;

        }
        //var PriceTagDetailObject = $("#PriceTagDetail").data("kendoDropDownList");
        //var PriceTagDetailId = PriceTagDetailObject.value();
        //if (PriceTagDetailId == "" || PriceTagDetailId == null) {
        //    $("#PriceTagDetailVal").text("Required");
        //    ValidationCount = ValidationCount + 1;

        //}
        var AmountId = $("#Quantity").val();
        var StockBaalance = $("#StockBalance").val();
        if (parseFloat(AmountId) > parseFloat(StockBaalance)) {
            alert("Quantity Greater Than Stock Balance");
            ValidationCount = ValidationCount + 1;
        }
        var AmountId = $("#Quantity").val();
        if (AmountId == "0" || AmountId == "" || AmountId == null) {
            $("#QuantityVal").text("Quantity Can't Be 0 ");
            ValidationCount = ValidationCount + 1;
        }
        if (ValidationCount > 0) {
            return false;
        }

    }

    function filterSourceType() {
        var dropdownlist = $("#References").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            source: $("#Source").val(), filterString: filterInput.val()
        };
    }
    function filterSourceTypeAndCustomerId() {
        var dropdownlist = $("#References").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            source: $("#Source").val(), customerId: $("#OrganizationCustomerId").val(), filterString: filterInput.val()
        };
    }
    function onContractDocumentEdit(e) {
        //e.container.find(".k-button.k-grid-update").hide();
        //e.container.find(".k-button.k-grid-cancel").hide();
    }
    function onPeriodChange(e) {
        var drp = this;
        var id = drp.value();
        var voucherDate = $("#Date").data("kendoDatePicker");
        var referencedQuoteId = $("#References").val();
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPeriodRangesWithinSalesQuoteDates", "CRMDataProvider", new { area = "CRM" })',
            data: { periodId: id, quoteId: referencedQuoteId },
            success: function (result) {
                if (result) {
                    var ranges = result.split('_');
                    var start = ranges[0];
                    var end = ranges[1];
                    var startDate = new Date(start);
                    var endDate = new Date(end);
                    if (voucherDate) {
                        voucherDate.min(startDate);
                        voucherDate.max(endDate);
                        voucherDate.value(startDate);
                        voucherDate.trigger("change");
                    } 
                }
            }, 
            error: function (result) {
            }
        });

    }
    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "SalesOrderVoucher", new {area = "CRM"})',
                data: { id: id },
                success: function (result) {
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                },
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
</script>


@helper ContractFileUploadWithCrud()
{
    @(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.VoucherContractDocument>()
    .Name("contract_document_#=SalesOrderVoucherID#")
    .Columns(columns =>
    {
        columns.Bound(c => c.FileName).ClientTemplate("<a href='/CRM/VoucherContractDocument/DownloadContractDocument?documentId=\\#=VoucherContractDocumentId\\#'>\\#=FileName\\#</a>");
        columns.Command(command => {command.Destroy(); }).Width(100);
    })
    .ToolBar(t => t.Template(
        @<text>
            @DocumentUploadToolBarHelper()
        </text>
        ))
        //.Editable(editable => editable.Mode(GridEditMode.InLine))
        //.HtmlAttributes(new { style = "height: 350px;" })
        .Scrollable()
        .DataSource(dataSource => dataSource
            .Ajax()
            .Sort(x => x.Add(s => s.DateCreated).Descending())
            .Events(ev => ev
                .Error("error_handler(\"contract_document_#=SalesOrderVoucherID#\")")
                .RequestStart("onRequestStart(\"contract_document_#=SalesOrderVoucherID#\")")
                .RequestEnd("onRequestEnd(\"contract_document_#=SalesOrderVoucherID#\")"))
            .Model(model =>
            {
                model.Id(p => p.VoucherContractDocumentId);
                model.Field(p => p.LastModified).Editable(false);
                model.Field(p => p.ModifiedBy).Editable(false);
                model.Field(p => p.DateCreated).Editable(false);
                model.Field(p => p.CreatedBy).Editable(false);
            })
            .Read(read => read.Action("LineItems_Read", "VoucherContractDocument", new { voucher = "#=SalesOrderVoucherID#", type = VoucherType.SalesOrder }))
            //.Create(create => create.Action("LineItem_Create", "VoucherContractDocument", new { voucher = "#=SalesOrderVoucherID#", type = VoucherType.SalesOrder }))
            //.Update(update => update.Action("Attachments_Update", "CustomerContractAttachment"))
            .Destroy(destroy => destroy.Action("LineItem_Destroy", "VoucherContractDocument"))
        )
        .ToClientTemplate())}

