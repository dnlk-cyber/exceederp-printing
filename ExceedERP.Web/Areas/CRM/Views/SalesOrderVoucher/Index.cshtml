@using ExceedERP.Core.Domain.CRM
@model ExceedERP.Core.Domain.CRM.SalesOrderVoucher

<style>
    .k-grid table tr.k-state-Issued {
        background: #b7ff9e;
        color: #040000;
    }
    .k-grid table tr.k-state-waiting-approval {
        background: #ffffcc;
    }
    .k-grid table tr.k-state-Rejected {
        background: #fcabab;
        color: #040000;
    }
    fieldset.scheduler-border {
        border: 1px ridge #e6e6e6 !important;
        /*border: 1px ridge #e88686 !important;*/
        padding: 0 1.4em 1.4em 1.4em !important;
        margin: 0 0 1.5em 0 !important;
        -webkit-box-shadow: 0px 0px 0px 0px #000;
        box-shadow: 0.5px 0.5px 0px 0px #ccc;
    }

    legend.scheduler-border {
        font-size: 1.2em !important;
        font-weight: bold !important;
        text-align: left !important;
        /*padding: 0 10px;*/ /* To give a bit of padding on the left and right */
        border-bottom: none;
    }
</style>

<legend>Sales Order Voucher</legend>

@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.SalesOrderVoucher>()
    .Name("SalesOrderVoucher")
    .Columns(columns =>
    {
        columns.Bound(c => c.SalesOrderVoucherID).Title("#").Width(80);
        columns.Bound(c => c.JobOrderNumber).Title("JO #").Width(80);
        columns.Bound(c => c.Source).Width(100).EditorTemplateName("SalesOrderSourceSelector");
        columns.Bound(c => c.References).Title("Ref Sales Quote").Width(100).EditorTemplateName("SalesQuoteReferenceSelector");

        columns.ForeignKey(c => c.OrganizationCustomerId, (System.Collections.IEnumerable)ViewData["OrganizationCustomers"], "OrganizationCustomerID", "TradeName").Title("Customer").EditorTemplateName("OrgCustomerEditor").Width(100);
        columns.Bound(c => c.PlateNo).Width(80);
        columns.Bound(c => c.PaymentMethod).Title("Payment Method").EditorTemplateName("PaymentMethodType").Width(120);
        columns.ForeignKey(c => c.BranchId, (System.Collections.IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(100);
        columns.ForeignKey(c => c.StoreID, (System.Collections.IEnumerable)ViewData["SalesStore"], "SalesStoreId", "Description").Width(100);
        columns.ForeignKey(c => c.CRMPeriodId, (System.Collections.IEnumerable)ViewData["CRMPeriods"], "CRMPeriodId", "Name").EditorTemplateName("OpenCRMPeriodsSelector").Width(100);

        columns.Bound(c => c.Date).Width(100);
        columns.Bound(c => c.GrandTotal).Format("{0:N4}").Width(100);
        columns.Bound(c => c.CreatedBy).Width(80);
        columns.Bound(c => c.Status).Width(80);
        columns.Bound(c => c.Remark).Width(100);
        columns.Command(command =>
        {
            command.Edit();
            //command.Custom("Reject").Click("RejectPopUp");
            command.Destroy();

        }).Width(200);
    })
    .HtmlAttributes(new { style = "height: 700px;" })

    .Pageable(pageable => pageable
                    .Input(true)
                    .Numeric(false)
                    .Refresh(true)
                    .PageSizes(true)
                    .ButtonCount(5))

    .Sortable()
    .Filterable()
    .Scrollable(s => s.Height(500))
    .ToolBar(toolbar => {
        toolbar.Create();
        toolbar.Excel();
    })
    @*.ToolBar(toolbar =>
    {

    toolbar.Template(@<text>
            <form>
                <div>
                    <div class="toolbar">
                        <a class="k-button k-button-icontext k-grid-add k-primary" href='#'>Add new Record</a>
                    </div>
                </div>

            </form>
        </text>);
    })*@

    .Events(ev =>
    {
        ev.DetailExpand("onDetailExpandUser");
        ev.DataBound("onDataBound");

    })

    .Editable(editable =>
    {
        editable.Mode(GridEditMode.PopUp);
        editable.Window(w =>
        {
            w.Title("Sales Order Voucher");
            w.Scrollable(false);
            w.Resizable();
        });
        editable.TemplateName("SalesOrderVoucherEditor");
        })

    .DataSource(dataSource => dataSource
        .Ajax()
        .Sort(x => x.Add(s => s.SalesOrderVoucherID).Descending())
        .Model(model =>
        {
            model.Id(p => p.SalesOrderVoucherID);
            model.Field(v => v.SalesOrderVoucherID).Editable(false);

            model.Field(p => p.GrandTotal).Editable(false);
            //model.Field(p => p.References).Editable(false);
            model.Field(v => v.Status).Editable(false);
            //model.Field(v => v.Remark).Editable(false);
        }
        ).Events(ev => ev
                .Error("error_handler(\"SalesOrderVoucher\")")
                .RequestStart("onRequestStart(\"SalesOrderVoucher\")")
                .RequestEnd("onRequestEnd(\"SalesOrderVoucher\")"))

        .Read(read => read.Action("SalesOrderVouchers_Read", "SalesOrderVoucher"))
        .Create(create => create.Action("SalesOrderVouchers_Create", "SalesOrderVoucher"))
        .Update(update => update.Action("SalesOrderVouchers_Update", "SalesOrderVoucher"))
        .Destroy(distroy => distroy.Action("SalesOrderVouchers_Destroy", "SalesOrderVoucher"))

    ).ClientDetailTemplateId("template")
)



