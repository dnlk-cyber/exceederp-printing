    function GetTaxValue() {

        var taxObject = $("#Tax").data("kendoDropDownList");
        var taxID = taxObject.value();
        var unitAmountValue = $("#UnitAmount").val();
        var quantityValue = $("#Quantity").val();
        var InsuranceCost = $("#InsuranceCost").val();
        var FreightCost = $("#FreightCost").val();
        var OtherCost = $("#OtherCost").val();
        var GrowthValue = parseInt(quantityValue);
        var discount = $("#Discount").val();

        $.ajax({
            url: '@Url.Action("GetTaxValue", "CRMDataProvider")',
            data: { taxID: taxID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

                var calculatedTax = (r / 100) * quantityValue * unitAmountValue;
                var calculatedTotalAmount = (quantityValue * unitAmountValue) + calculatedTax - discount;
                calculatedTax = calculatedTax.toFixed(4);
                calculatedTotalAmount = calculatedTotalAmount.toFixed(4);

                $("#CalculatedCost").val(quantityValue * unitAmountValue);
                $("#CalculatedCost").trigger("change");

                $("#TaxAmount").val(calculatedTax);
                $("#TaxAmount").trigger("change");

                $("#TotalAmount").val(calculatedTotalAmount);
                $("#TotalAmount").trigger("change");
            }


        });
    }


