    /*.k-edit-form-container-small{
        width:600px;
    }*/
</style>

<script>

    var detailsTemplate = kendo.template($("#Rejectemplate").html());
    function RejectPopUp(e) {
        e.preventDefault();

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var wnd = $("#Details").data("kendoWindow");

        wnd.content(detailsTemplate(dataItem));
        wnd.center().open();
    }
    function filterThing() {
        var dropdownlist = $("#ThingID").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            StoreID: $("#StoreID").val(), filterString: filterInput.val()
        };
    }
     function sendForApproval(id) {
        var recordStatus = "";
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "SalesOrderVoucher", new { area = "CRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            },
            error: function (result) {
                alert(result);
            }
        });
    }
    function SwitchCustomer() {
        var OrganizationCustomer = $("#OrganizationCustomerId").data("kendoDropDownList").value();
        if (OrganizationCustomer == 0) {
            $("#NewCustomerArea").show();
        }
        else {
            $("#NewCustomerArea").hide();
        }

        var dropdownlist = $("#References").data("kendoDropDownList");
        if (dropdownlist) {
            dropdownlist.dataSource.read();
        }

    }
    function getSelectedQuoteId() {
        return {
            quoteId: $("#References").val()
        };
    }
    function filterPayment() {
        return {
            customerId: $("#OrganizationCustomerId").val()
        };
    }
    //
    // refresh CRM Period Selector when referenced Quote-Id changes
    function referenceSelectorChanged(e) {
        
        var ddl = $("#CRMPeriodId").data("kendoDropDownList");
        ddl.dataSource.read();

        var refDdl = this;
        var refId = refDdl.value();
        updateBranchSelector(refId);
    }

    function updateBranchSelector(qId)
    {
        $.ajax({
            url: '@Url.Action("GetReferedSalesQuoteBranchId", "CRMDataProvider", new { area = "CRM"})',
            data: { quoteId: qId },
            type: 'POST',
            cache: false,
            success: function (result) {
                if (result) {
                    var branchId = result;
                    var bdl = $("#BranchId").data("kendoDropDownList");
                    bdl.value(branchId);
                    bdl.trigger("change");
                }
            }
        });
    }
</script>
<script>

    function DisplayReferenceInformation() {
        var SalesQuoteVoucherObject = $("#SalesOrderVoucherReference").data("kendoComboBox");
        var salesQuoteVoucherID = SalesQuoteVoucherObject.value();
        $.ajax({
            url: '@Url.Action("PopulateSalseQuoteVoucherForReference", "SalesOrderVoucher")',
            data: { salesQuoteVoucherID: salesQuoteVoucherID },
            type: 'POST',
            cache: false,
            success: function (result) {
                if (result != "") {

                    alert(result);
                }
            }

        });
    }

    function onAdditionalData() {
        return {
            text: $("#NewCustomer").val()
        };
    }
</script>

<script>

    var id;
    var masterId;
    var gridName;
    var thingId;
    var thingsid;
    var masterDataItem;
    var selectedStoreID;

    function onDataBound(e) {
        var grid = this;

        var Checkgrid = $("#SalesOrderVoucher").data("kendoGrid");
        var gridData = Checkgrid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            //get the item uid
            var currentUid = gridData[i].uid;
            //if the record fits the custom condition
            if (gridData[i].LastObjectState == "Rejected") {
                //find the row based on the uid and the custom class
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                $(currenRow).addClass("k-state-Rejected");
            }
            else if (gridData[i].LastObjectState == "WaitingApproval") {
                //find the row based on the uid and the custom class
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                $(currenRow).addClass("k-state-waiting-approval");
            }
            else if (gridData[i].LastObjectState == "Forwarded" || gridData[i].LastObjectState == "Approved") {
                //find the row based on the uid and the custom class
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                $(currenRow).addClass("k-state-Issued");
            }
        }
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            //  dataItem.css("background-color", "red");
            if (dataItem.LastObjectState == "Forwarded" || dataItem.LastObjectState == "WaitingApproval" || dataItem.LastObjectState == "Approved") {
                $(this).find(".reject").remove();
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                $(this).find(".k-grid-Reject").remove();
                //$(this).addClass("k-state-Issued");
            }
            if (dataItem.References == "Manual" || dataItem.References == "No_Reference") {

                $(this).find(".k-grid-Reject").remove();
            }
            if (dataItem.References != "Manual") {


            }
        });
    }



