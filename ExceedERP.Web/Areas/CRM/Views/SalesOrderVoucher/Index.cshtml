<script>
    function GetStockBalance() {

        var storeobj = $("#StoreID").data("kendoDropDownList");
        var stID = storeobj.value();
        var thingobj = $("#ThingID").data("kendoDropDownList");

        var tID = thingobj.value();
        var varityobj = $("#Variety").data("kendoDropDownList");
        var vid = varityobj.value();
        var classobj = $("#Class").data("kendoDropDownList");
        var cid = classobj.value();
        //   var stID = selectedStoreID = $("#Store").data("kendoDropDownList");
        $.ajax({
            url: '@Url.Action("GetStockBalance", "CRMDataProvider")',
            data: { storeID: stID, productID: tID, VarietyID: vid, Class: cid },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                $("#UnitAmount").val('0.0');
                $("#TaxAmount").val('0.0');
                $("#TotalAmount").val('0.0');
                if (r != 0) {
                    var s = r.split(/_/);
                    $("#StockBalance").val(s[0]);
                    $("#CalculatedCost").val(s[1]);
                    $("#StockBalanceReserved").val(s[2]);
                } else {
                    $("#StockBalance").val('0.0');
                    $("#CalculatedCost").val('0.0');
                    $("#StockBalanceReserved").val('0.0');
                }
            }

        });
    }


</script>

<script>

    function GetPriceParameter() {
        var id = masterDataItem.ThingID;
        return {
            productID: id
        };
    }
    function UpdatePriceChange() {

        var priceTagDetail = $("#PriceTagDetail").data("kendoDropDownList");
        var ptdID = priceTagDetail.value();
        var priceTag = $("#PriceTag").data("kendoDropDownList");
        var ptID = priceTag.value();
        var product = $("#ThingID").data("kendoDropDownList");
        var pID = product.value();
        var Varietyobj = $("#Variety").data("kendoDropDownList");
        var vID = Varietyobj.value();
        var Classobj = $("#Class").data("kendoDropDownList");
        var cID = Classobj.value();

        $.ajax({
            url: '@Url.Action("GetPriceValue", "CRMDataProvider")',

            data: { priceTagID: ptID, priceTagDetailID: ptdID, productID: product.value(), VarietyID: vID, ClassID: cID },
            type: 'POST',
            cache: false,
            success: function (result) {
                if (result == "") {
                    result = 0;
                }
                else {
                    $("#UnitAmount").val(parseFloat(result));
                }

            }, error: function () {
                $("#UnitAmount").val("0");
            }

        });

    }


    function GetPriceTagDetailParameter() {
        var pt = $("#PriceTag").data("kendoDropDownList");
        return {
            priceTag: pt.value()
        };
    }


    function GetTaxValue() {

        var taxObject = $("#Tax").data("kendoDropDownList");
        var taxID = taxObject.value();
        var unitAmountValue = $("#UnitAmount").val();
        var quantityValue = $("#Quantity").val();
        var InsuranceCost = $("#InsuranceCost").val();
        var FreightCost = $("#FreightCost").val();
        var OtherCost = $("#OtherCost").val();
        var GrowthValue = parseInt(quantityValue);

        $.ajax({
            url: '@Url.Action("GetTaxValue", "CRMDataProvider")',
            data: { taxID: taxID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

                var calculatedTax = (r / 100) * parseInt(quantityValue) * unitAmountValue;
                var calculatedTotalAmount = (quantityValue * unitAmountValue) + calculatedTax ;
                calculatedTax = parseFloat(Math.round(calculatedTax)).toFixed(2);
                calculatedTotalAmount = parseFloat(Math.round(calculatedTotalAmount)).toFixed(2);

                $("#TaxAmount").val(calculatedTax);
                $("#TotalAmount").val(calculatedTotalAmount);
            }


        });
    }


    function GetAdditionalCost() {

        var taxObject = $("#Tax").data("kendoDropDownList");
        var taxID = taxObject.value();
        var unitAmountValue = $("#UnitAmount").val();
        var quantityValue = $("#Quantity").val();
        var InsuranceCost = $("#InsuranceCost").val();
        var FreightCost = $("#FreightCost").val();
        var OtherCost = $("#OtherCost").val();
        var GrowthValue = parseInt(quantityValue);

        $.ajax({
            url: '@Url.Action("GetAddiotonalCost", "CRMDataProvider")',
            data: { taxID: taxID },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

                var html = "";


                html += "<div class='col-sm-6 form-group'>Type : <select name=AdditionalCostItem[" + index + "][Id] data-bind='value:AdditionalCostItem[" + index + "][Id]' value=" + r + " ><option value='1'>Fright Cost </option></select></div>  <div class='col-sm-3'> Value: <input type='number' name=AdditionalCostItem[" + index + "][Name] data-bind='value:AdditionalCostItem[" + index + "][Name]' min='0' value=" + r + "  /> </div>";


                $("#content").append(html);

                kendo.init("#content");
                index++;
            }


        });
    }

    function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#SalesOrderVoucher").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

        masterId = masterDataItem.SalesOrderVoucherID;
        var linegridName = "#LineItems_" + masterId;
        var vouchertermGridName = "VoucherTerms_" + masterId;
        var VoucherExtensionGridName = "VoucherExtension_" + masterId;
        $.ajax({
            url: '@Url.Action("GetStatus", "SalesOrderVoucher")',

            data: { Id: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

                if (r == "Forwarded" || r == "Approved") {
                    $(linegridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", linegridName).hide();
                    $(".k-grid-edit", linegridName).hide();
                    $(".k-grid-delete", linegridName).hide();

                    $(vouchertermGridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", vouchertermGridName).hide();
                    $(".k-grid-edit", vouchertermGridName).hide();
                    $(".k-grid-delete", vouchertermGridName).hide();

                    $(VoucherExtensionGridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", VoucherExtensionGridName).hide();
                    $(".k-grid-edit", VoucherExtensionGridName).hide();
                    $(".k-grid-delete", VoucherExtensionGridName).hide();
                }

                else {
                    $(linegridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", linegridName).show();
                }

            }

        });

    }

    var index = 0;
    var PopUpMode = "";
    function AddCostItemInit(e) {

        if (e.model.isNew()) {
            $('#lineForm').attr('action', '@Url.Action("LineItems_Create", "LineItem")');
            $('#linesave').val("Create");
        }
        else {
            $('#lineForm').attr('action', '@Url.Action("LineItems_Update", "LineItem")');
            $('#linesave').val("Update");
        }
        $('#Voucher').val(masterId);
        $('#VoucherDefinitionId').val('1');
        var html = "";
        var optionId = "option" + index;

        $('.k-edit-buttons').css('display', 'none');

        $.ajax({
            url: "@Url.Action("GetLineAdditionalCost", "CRMDataProvider")",
            type: 'GET',
        traditional: true,
        data: { Id: $("#LineItemID").val() },
        success: function (data) {



            $.each(data, function (index, optiondata) {
                html += "  <div class='col-sm-12 form-row form-control ' id='otherline" + index + "' style='padding:5px;'> <div class='col-sm-6 form-row'> <div class='col-sm-3'> </div> <select class='col-sm-5' name=AdditionalCostItem[" + index + "][Id] id='" + optionId + "' data-bind='value:AdditionalCostItem[" + index + "][Id]' ><option selected value='" + optiondata.AdditionalCostId + "'>" + optiondata.Name + "</option></select></div>  <div class='col-sm-3'> Value: <input type='number' name=AdditionalCostItem[" + index + "][Name] data-bind='value:AdditionalCostItem[" + index + "][Name]' min='0' value= '" + optiondata.Value + "' /> <button id='remove" + index + "' class='k-button k-primary btn-danger ' onclick=' return RemoveCostItem(otherline" + index + ");'>Remove  </button> </div> </div>";

            });
            $("#CostItem").append(html);

            kendo.init("#CostItem");
            index++;
        }

    });

    return false;
    };
    function RemoveCostItem(e) {

        $('#' + e.id).remove();
    }
    var ItemIndex = 0;
    function AddCostItem() {


        var html = "";

        var optionId = "optionAdded" + ItemIndex;
        var ItemId = "ItemAdded" + ItemIndex;
        $('.k-edit-buttons').css('display', 'none');
        $('.form-bottom').css('display', 'block');
        html += "  <div class='col-sm-12 form-row form-control' id='" + ItemId + "' style='padding:5px;'> <div class='col-sm-6 form-row'> <div class='col-sm-3'> </div> <select class='col-sm-5' name=AdditionalCostItem[" + ItemIndex + "][Id] id='" + optionId + "' data-bind='value:AdditionalCostItem[" + ItemIndex + "][Id]' ><option selected disabled > Select Cost Type </option></select></div>  <div class='col-sm-4'> Value: <input type='number' name=AdditionalCostItem[" + ItemIndex + "][Name] data-bind='value:AdditionalCostItem[" + ItemIndex + "][Name]' min='0' value= '0' />  <button id='" + generate + "' class='k-button k-primary btn-danger ' onclick=' return RemoveCostItem('"+ItemId+"');'>Remove  </button></div> </div>";
        $.ajax({
            url: "@Url.Action("GetAdditionalCost", "CRMDataProvider")",
            type: 'GET',
        traditional: true,
        success: function (data) {



            $.each(data, function (index, optiondata) {

                $("#" + optionId).append("<option value='" + optiondata.AdditionalCostId + "'>" + optiondata.Name + "</option>");
            });

        }

    });
    $("#CostItem").append(html);

    kendo.init("#CostItem");
    ItemIndex++;
    return false;
    };


</script>
<script>
    function ClearValMsg() {
        $("#StoreVal").text("");
        $("#ProductVal").text("");
        $("#TaxVal").text("");
        $("#PriceTagVal").text("");
        $("#PriceTagDetailVal").text("");
        $("#QuantityVal").text("");
        return false;
    }
    function ValidateInput() {
        var ValidationCount = 0;
        var StoreObject = $("#StoreID").data("kendoDropDownList");
        var StoreId = StoreObject.value();
        if (StoreId == "" || StoreId == null) {
            $("#StoreVal").text("Required");
            ValidationCount = ValidationCount + 1;

        }
        var ProductObject = $("#ThingID").data("kendoDropDownList");
        var ProductId = ProductObject.value();
        if (ProductId == "" || ProductId == null) {
            $("#ProductVal").text("Required");
            ValidationCount = ValidationCount + 1;

        }
        var TaxObject = $("#Tax").data("kendoDropDownList");
        var TaxId = TaxObject.value();
        if (TaxId == "" || TaxId == null) {
            $("#TaxVal").text("Required");
            ValidationCount = ValidationCount + 1;

        }

        var PriceTagObject = $("#PriceTag").data("kendoDropDownList");
        var PriceTagId = PriceTagObject.value();
        if (PriceTagId == "" || PriceTagId == null) {
            $("#PriceTagVal").text("Required");
            ValidationCount = ValidationCount + 1;

        }
        var PriceTagDetailObject = $("#PriceTagDetail").data("kendoDropDownList");
        var PriceTagDetailId = PriceTagDetailObject.value();
        if (PriceTagDetailId == "" || PriceTagDetailId == null) {
            $("#PriceTagDetailVal").text("Required");
            ValidationCount = ValidationCount + 1;

        }
        var AmountId = $("#Quantity").val();
        var StockBaalance = $("#StockBalance").val();
        if (parseFloat(AmountId) > parseFloat(StockBaalance)) {
            alert("Quantity Greater Than Stock Balance");
            ValidationCount = ValidationCount + 1;
        }
        var AmountId = $("#Quantity").val();
        if (AmountId == "0" || AmountId == "" || AmountId == null) {
            $("#QuantityVal").text("Amount Can't Be 0 ");
            ValidationCount = ValidationCount + 1;
        }
        if (ValidationCount > 0) {
            return false;
        }

    }
</script>