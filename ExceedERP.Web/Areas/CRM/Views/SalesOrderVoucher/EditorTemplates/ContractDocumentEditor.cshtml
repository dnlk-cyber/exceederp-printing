@using (Html.BeginForm("LineItem_Create", "VoucherContractDocument", FormMethod.Post,
    new { enctype = "multipart/form-data", voucher = 1, type = VoucherType.SalesOrder }))
{

    @Html.AntiForgeryToken()
    <fieldset>
        <div class="editor-field">
            @Html.TextBox("files", "", new { type = "file" })
        </div>
        <br />
        <div class="editor-field">
            @*@Html.TextBox("txtValue", null, new { placeholder = Resources.Common_Attachment_FileName })*@
            @Html.TextBox("Remark", null, new { placeholder = "Description or Note" })
        </div>
        <br />
        <div class="editor-field">
            <input type="submit" value="@Resources.HR_ActionButton_Upload" />
        </div>
    </fieldset>
}





