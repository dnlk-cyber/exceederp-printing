<script>
    function sendForApproval(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "AnnualSalesPlan", new { area = "CRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                if (result.Status == "OK") {
                    location.reload(true);
                }
            }, 
            error: function (result) {
                alert(result);
            }
        });
    }
    function voidSalesPlan(id) {
        var conf = confirm("Sales Plan will be in edit mode after void. Are you sure you want to void this record ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("VoidSalesPlan", "AnnualSalesPlan", new {area = "CRM"})',
                data: { id: id },
                success: function (result) {
                    alert(result.Message);
                    location.reload(true);
                },
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
    function mainGridDataBound(e) {
        var grid = this;
        $(".btnSeparateWindow").on("click", function (e) {
            var selectedItem = $(this).closest("tr");
            var dataItem = grid.dataItem(selectedItem);
            var id = dataItem.AnnualSalesPlanId;
            var cat = dataItem.CategoryId;
            var subCat = dataItem.SubCategoryId == null ? "none" : dataItem.SubCategoryId;
            window.open(`/CRM/AnnualSalesPlan/Plan?pi=${id}&cat=${cat}&subcat=${subCat}`, "_blank");
            
        });

        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            if (dataItem.IsOnlineApproved === true) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.addClass("k-state-Approved");
            } else if (dataItem.IsSendForApproval) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
            } else if (dataItem.IsVoid) {
                row.addClass("k-state-Void");
            }
            
            else if (dataItem.Status == "Rejected") {
                row.addClass("k-state-Rejected");
            }
            else {

                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").show();
            }
        }
    }
    //function subcategoryChanged(e) {
    //    alert(this.value());
    //}
    function getSelectedCategory(){
        return { categoryId: $("#CategoryId").val() };
    }
</script>

<style>
    .k-grid table tr.k-state-Approved {
        background: #b7ff9e;
        color: #040000;
    }

    .k-grid table tr.k-state-Rejected {
        background: #fcabab;
        color: #040000;
    }
    .k-grid table tr.k-state-Void {
        background: #f0c2e0;
        color: #040000;
    }
</style>