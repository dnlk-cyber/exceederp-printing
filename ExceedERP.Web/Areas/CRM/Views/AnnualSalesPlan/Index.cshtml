<legend>Annual Sales Plan</legend>
@using System.Collections
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.AnnualSalesPlan>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Template(e => { }).Width(50).ClientTemplate("<button class='btnSeparateWindow' title='Open In Separate Window'><span class ='fa fa-external-link text-danger'></span></button>").Title(" ");

          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["Years"], "GlFiscalYearId", "Name").Width(100);
          columns.ForeignKey(c => c.CategoryId, (IEnumerable)ViewData["Categories"], "ProductCategoryId", "Description").Width(100);
          columns.ForeignKey(c => c.SubCategoryId, (IEnumerable)ViewData["Categories"], "ProductCategoryId", "Description").Width(100);
          columns.Bound(c => c.AveragePrice).Format("{0:N2}").Width(100);
          columns.Bound(c => c.Profit).ClientTemplate("#=Profit#%").Width(80);
          columns.Group(group =>
          {
              group.HeaderHtmlAttributes(new { style = "font-weight:bold; text-align:center"});
              group.Title("Annual");
              group.Columns(innerColumns =>
              {
                  innerColumns.Bound(c => c.TotalAnnualPlanQuantity).Format("{0:N2}").Width(120);
                  innerColumns.Bound(c => c.TotalAnnualPlanValue).Format("{0:N2}").Width(150);
              });
          });
          columns.Group(group =>
          {
              group.HeaderHtmlAttributes(new { style = "font-weight:bold; text-align:center" });
              group.Title("Monthly");
              group.Columns(innerColumns =>
              {
                  innerColumns.Bound(c => c.TotalMonthlyPlanQuantity).Format("{0:N2}").Width(120);
                  innerColumns.Bound(c => c.TotalMonthlyPlanValue).Format("{0:N2}").Width(150);
              });
          });
          columns.Group(group =>
          {
              group.HeaderHtmlAttributes(new { style = "font-weight:bold; text-align:center" });
              group.Title("Weekly");
              group.Columns(innerColumns =>
              {
                  innerColumns.Bound(c => c.TotalWeeklyPlanQuantity).Format("{0:N2}").Width(100);
                  innerColumns.Bound(c => c.TotalWeeklyPlanValue).Format("{0:N2}").Width(120);
              });
          });
          columns.Group(group =>
          {
              group.HeaderHtmlAttributes(new { style = "font-weight:bold; text-align:center" });
              group.Title("Daily");
              group.Columns(innerColumns =>
              {
                  innerColumns.Bound(c => c.TotalDailyPlanQuantity).Format("{0:N2}").Width(100);
                  innerColumns.Bound(c => c.TotalDailyPlanValue).Format("{0:N2}").Width(120);
              });
          });

          columns.Bound(c => c.Status).Width(100);
          columns.Bound(c => c.Remark).Width(100);

          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
          toolbar.Create();
      })
      .Events(ev => {
          ev.DataBound("mainGridDataBound");
      })
      .Editable(editable =>
      {
          editable.Mode(GridEditMode.PopUp);
          editable.TemplateName("AnnualPlanEditorTemplate");
          editable.Window(window =>
          {
              window.Title("Annual Plan");
          });
      })
      .Pageable()
      .Navigatable()
      .Sortable(sortable => {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      //.Filterable()
      .Scrollable(s=> s.Height(650))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model =>
          {
              model.Id(p => p.AnnualSalesPlanId);

              model.Field(f => f.TotalAnnualPlanValue).Editable(false);
              model.Field(f => f.TotalMonthlyPlanQuantity).Editable(false);
              model.Field(f => f.TotalMonthlyPlanQuantity).Editable(false);
              model.Field(f => f.TotalWeeklyPlanQuantity).Editable(false);
              model.Field(f => f.TotalWeeklyPlanValue).Editable(false);
              model.Field(f => f.TotalDailyPlanQuantity).Editable(false);
              model.Field(f => f.TotalDailyPlanValue).Editable(false);
          })
          .Events(ev =>
          {
              ev.Error("error_handler(\"grid\")");
              ev.RequestStart("onRequestStart(\"grid\")");
              ev.RequestEnd("onRequestEnd(\"grid\")");
          })
          .Read(read => read.Action("AnnualSalesPlans_Read", "AnnualSalesPlan"))
          .Create(create => create.Action("AnnualSalesPlans_Create", "AnnualSalesPlan"))
          .Update(update => update.Action("AnnualSalesPlans_Update", "AnnualSalesPlan"))
          .Destroy(destroy => destroy.Action("AnnualSalesPlans_Destroy", "AnnualSalesPlan"))
      ).ClientDetailTemplateId("plan_detail")
)

