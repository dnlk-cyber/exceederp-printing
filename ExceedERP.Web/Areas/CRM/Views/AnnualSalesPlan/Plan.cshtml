<legend><b>@ViewBag.Category @{ if (ViewBag.SubCategory != "") { <text>|</text>  @ViewBag.SubCategory; }}</b> Sales Plan for Budget Year <b>@ViewBag.FiscalYear</b>  </legend>
@using System.Collections

@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.BranchAnnualSalesPlan>()
                            .Name("grid")
                            .Columns(columns =>
                            {
                                columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").ClientFooterTemplate("Total").EditorTemplateName("BranchEditorTemplate");
                                columns.Bound(c => c.Ratio).ClientTemplate(" #=Ratio #%").ClientFooterTemplate(" #=sum #%");
                                columns.Bound(c => c.Quantity).Format("{0:N2}").ClientFooterTemplate(" #=kendo.toString(sum, 'N2') #");

                                columns.Bound(c => c.Value).Format("{0:N2}").ClientFooterTemplate(" #=kendo.toString(sum, 'N2') #");
                                columns.Bound(c => c.Remark);

                                if (!ViewBag.IsReadonly)
                                {
                                    columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
                                }
                            })

                            .ToolBar(toolbar =>
                            {
                                if (!ViewBag.IsReadonly)
                                {
                                    toolbar.Create();
                                }
                            })
                            .Editable(editable => editable.Mode(GridEditMode.InLine))
                            .Pageable()
                            //.Navigatable()
                            .Sortable(sortable =>
                            {
                                sortable.SortMode(GridSortMode.SingleColumn);
                            })
                            .Filterable()
                            .Scrollable(s => s.Height(700))
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                 .Model(model =>
                                 {
                                     model.Id(p => p.BranchAnnualSalesPlanId);

                                     model.Field(f => f.Quantity).Editable(false);
                                     model.Field(f => f.Value).Editable(false);
                                 })
                                 .Aggregates(ag =>
                                 {
                                     ag.Add(f => f.Quantity).Sum();
                                     ag.Add(f => f.Ratio).Sum();
                                     ag.Add(f => f.Value).Sum();
                                 })
                                 .Events(ev =>
                                 {
                                     ev.Error("error_handler(\"grid\")");
                                     ev.RequestStart("onRequestStart(\"grid\")");
                                     ev.RequestEnd("onRequestEnd(\"grid\")");
                                 })
                                .Read(read => read.Action("BranchAnnualSalesPlans_Read", "BranchAnnualSalesPlan").Data("getSelectedPlanId"))
                                .Create(create => create.Action("BranchAnnualSalesPlans_Create", "BranchAnnualSalesPlan").Data("getSelectedPlanId"))
                                .Update(update => update.Action("BranchAnnualSalesPlans_Update", "BranchAnnualSalesPlan"))
                                .Destroy(destroy => destroy.Action("BranchAnnualSalesPlans_Destroy", "BranchAnnualSalesPlan"))
                            ).ClientDetailTemplateId("store_anual_plan")
                        )

