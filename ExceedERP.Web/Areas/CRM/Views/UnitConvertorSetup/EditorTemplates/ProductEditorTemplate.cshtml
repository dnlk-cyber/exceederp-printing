
@(Html.Kendo().DropDownListFor(m => m)
                  .OptionLabel("Select Product")
                  .Filter(FilterType.Contains)
                  .DataTextField("Name")
                  .DataValueField("ProductId")
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetAllProducts", "DataProvider"));
                  })
                  .ValuePrimitive(true)

)
