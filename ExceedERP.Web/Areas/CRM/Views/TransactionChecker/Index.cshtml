@*@{
    ViewBag.Title = "CRM Transactions";
}
<div class="content-wrapper">
    <div class="content">
        <div class="box">
            <div class="box-header with-border">
                <h4>
                    <i class="fa fa-money"></i>
                    Bank Reconciliation
                </h4>

            </div>
            <div class="box-body">
                <div class="row">
                    <div class="col-sm-4 col-xs-12">
                        <button id="invoiceReconciliationButton" class="btn btn-primary btn-block large-block-button" onclick="sendSalesInvoiceToBanckReconcilation()"> Send Missing Invoices</button>
                    </div>
                    <div class="col-sm-4 col-xs-12">
                        <button id="depositReconciliationButton" class="btn btn-primary btn-block large-block-button" onclick="sendDepositToBanckReconcilation()"> Send Missing Deposits</button>
                    </div>
                    <div class="col-sm-4 col-xs-12">
                        <button id="creditSettlementReconciliationButton" class="btn btn-primary btn-block large-block-button" onclick="sendCreditSettlementToBanckReconcilation()"> Send Missing Credit Settlements</button>
                    </div>
                </div>

                
            </div>
        </div>
        <div class="box box-default">
            <div class="box-header with-border">
                <h4>
                    <i class="fa fa-gear"></i>
                    CRM Settings
                </h4>
            </div>
            <div class="box-body">
                <div class="row">
                </div>
            </div>
        </div>
         <div class="box">
            <div class="box-header with-border">
                <h4>
                    <i class="fa fa-money"></i>
                    Shipments
                </h4>
            </div>
            <div class="box-body">
                <div class="row">
                </div>
            </div>
        </div>

    </div>
</div>
<script type="text/javascript">
    function sendSalesInvoiceToBanckReconcilation() {
        $("#invoiceReconciliationButton").attr('disabled', true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendMissingInvoicesToBankReconciliation", "TransactionChecker", new { area = "CRM" })',
            //data: { id: id },
            success: function (result) {
                alert(result.Message);
                $("#invoiceReconciliationButton").attr('disabled', false);
            }, 
            error: function (result) {
                alert(result);
                $("#invoiceReconciliationButton").attr('disabled', false);
            }
        });
    }
     function sendDepositToBanckReconcilation() {
         $("#depositReconciliationButton").attr('disabled', true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendMissingDepositToBankReconciliation", "TransactionChecker", new { area = "CRM" })',
            //data: { id: id },
            success: function (result) {
                alert(result.Message);
                $("#depositReconciliationButton").attr('disabled', false);
            }, 
            error: function (result) {
                alert(result);
                $("#depositReconciliationButton").attr('disabled', false);
            }
        });
    }
     function sendCreditSettlementToBanckReconcilation() {
         $("#creditSettlementReconciliationButton").attr('disabled', true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendMissingCreditSettlementToBankReconciliation", "TransactionChecker", new { area = "CRM" })',
            //data: { id: id },
            success: function (result) {
                alert(result.Message);
                $("#creditSettlementReconciliationButton").attr('disabled', false);
            }, 
            error: function (result) {
                alert(result);
                $("#creditSettlementReconciliationButton").attr('disabled', false);
            }
        });
    }
</script>

<style>
    .large-block-button {
        line-height: 40px;
        border-radius: 20px;
        margin:5px;
    }
</style>*@
