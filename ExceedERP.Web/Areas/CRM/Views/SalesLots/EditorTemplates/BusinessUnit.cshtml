
  @(Html.Kendo().DropDownListFor(model => model)
                                    .ValuePrimitive(true)
                                    .OptionLabel("Select Business Unit...")
                                    .DataTextField("Name")
                                    .DataValueField("Id")
                                    .Filter("contains")

                                    .DataSource(dataSource =>
                                    {
                                        dataSource.Read(read => read.Action("GetBusinessUnits", "TenderDataProvider", new { area = "CRM" }).Data("sendForgery"))
                                        .ServerFiltering(false);
                                    })
                )
