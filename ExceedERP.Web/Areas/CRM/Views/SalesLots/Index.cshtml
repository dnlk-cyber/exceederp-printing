<script>


    var masterDataItem;
    var masterRow;
    var masterGrid;
    var salesLotId;
    var isOnlineapproved;
    var isSendForApproval;
    var expandedLotRow
    function detailExpandMasterDepartment(e) {
        e.preventDefault();
        var masterGrid = e.sender;
        var masterDataItem = masterGrid.dataItem(e.masterRow);
        salesLotId = masterDataItem.SalesLotId;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineapproved = masterDataItem.IsOnlineApproved;
        if (isSendForApproval) {

            var ParticipantgridName = "#SalesLotParticpant" + salesLotId;
            var purchaseHide = "#SalesLotPurchase_grid" + salesLotId;
            var winnerHide = "#WinnerPerItem_grid_" + salesLotId;
            var ItemHide = "#SalesLotItem_grid_" + salesLotId;

            $(ParticipantgridName).find(".k-grid-toolbar").hide(); //hide toolbar
            $(purchaseHide).find(".k-grid-toolbar").hide(); //hide toolbar
            $(winnerHide).find(".k-grid-toolbar").hide(); //hide toolbar
            $(ItemHide).find(".k-grid-toolbar").hide(); //hide toolbar
            // $(".k-grid-top", linegridName).hide();

        }
        if (isOnlineapproved) {
            var ValidationHide = "#winnerValidation_grid_" + salesLotId;
            $(ValidationHide).find(".k-grid-toolbar").hide(); //hide toolbar
        }
        // Only one open at a time
        if (expandedLotRow != null && expandedLotRow[0] != e.masterRow[0]) {
            masterGrid.collapseRow(expandedLotRow);
        }
        expandedLotRow = e.masterRow;

    }
    function filterStores() {
        return {
            id: $("#BranchId").data("kendoDropDownList").value(),
            text: $("#StoreCode").data("kendoDropDownList").filterInput.val()
        }
    }
    function onDataBoundLineDepartment(e) {
        var detailGrid = "#" + e.sender.element[0].id;
        if (isOnlineapproved || isSendForApproval) {
            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataTenderSetting(e) {
        var detailGrid = "#grid" + e.sender.element[0].id;
        if (IsOnlineapproved) {
            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundValidation(e) {
        var detailGrid = "#" + e.sender.element[0].id;
        if (isOnlineapproved) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }


    function onDataBoundMasterSalesLot(e) {
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsSendForApproval) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-top").hide();
            }
            if (dataItem.IsOnlineApproved) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find(".k-grid-top").hide();
            }

        }
    }
    function onDataBoundMasterSaletender(e) {
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            //alert(IsOnlineApproved);
            if (dataItem.IsSendForApproval) {

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                // row.find(".k-grid-top").remove();
            }
            if (dataItem.IsOnlineApproved) {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                // row.find(".k-grid-top").remove();
            }

        }
    }

</script>