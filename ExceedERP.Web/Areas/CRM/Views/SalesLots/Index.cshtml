@helper salesLotPurchase()
{

    @(Html.Kendo().Grid<SalesLotPurchase>()
                                                .Name("SalesLotPurchase_grid#=SalesLotId#")
                                                .Columns(columns =>
                                                {
                                                    columns.Bound(c => c.PurchaseDate).Width(150);
                                                    columns.Bound(c => c.ReceiptNotRequired).Width(150).Title("Reciept Required?").ClientTemplate(
                                                                "<input type='checkbox' disabled = 'true' value='\\#= ReceiptNotRequired \\#' " +
                                                                "\\# if (ReceiptNotRequired) { \\#" +
                                                                "checked='checked'" +
                                                                "\\# } \\#" +
                                                                "/>"
                                                                );
                                                    columns.Bound(c => c.ReceiptNo).Width(150);
                                                    columns.Bound(c => c.CustomerName).Title("Customer Name").Width(150);
                                                    columns.Bound(c => c.TinNumber).Width(90);
                                                    columns.Bound(c => c.Representative).Width(150);
                                                    columns.Bound(c => c.Address).Width(150);
                                                    columns.Bound(c => c.Telephone).Width(150);
                                                    columns.Bound(c => c.Remark).Width(150);
                                                    columns.Command(command =>
                                                    {
                                                        command.Edit().UpdateText("Save").CancelText("Cancel").Text("Edit");
                                                        command.Destroy().Text("Delete");
                                                    }).Title("Action").Width(200);



                                                })
                                                .ToolBar(toolbar =>
                                                {
                                                    toolbar.Create();


                                                })
                                                .Events(x => x.DataBound("onDataBoundLineDepartment"))
                                                .Editable(editable => editable.Mode(GridEditMode.InLine)
                                                // .TemplateName("salesPurchaseTemplate")
                                                // .Window(window =>
                                                //{
                                                //    window.Title("sales Purchase Form").Height(500).Width(500);

                                                //})
                                                )
                                                .Pageable()
                                                .Filterable()
                                                .Scrollable(s => s.Height(550))
                                                .DataSource(dataSource => dataSource
                                                .Ajax()
                                                .Model(model =>
                                                {
                                                    model.Id(p => p.SalesLotPurchaseId);
                                                    model.Field(x => x.SalesLotPurchaseId).Editable(false);

                                                })
                                                .Events(ev => ev
                                                .Error("error_handler(\"SalesLotPurchase_grid#=SalesLotId#\")")
                                                .RequestStart("onRequestStart(\"SalesLotPurchase_grid#=SalesLotId#\")")
                                                .RequestEnd("onRequestEnd(\"SalesLotPurchase_grid#=SalesLotId#\")"))
                                                .Read(read => read.Action("SalesLotPurchases_Read", "SalesLotPurchases", new { id = "#=SalesLotId#" }).Data("sendForgery"))
                                                .Create(create => create.Action("SalesLotPurchases_Create", "SalesLotPurchases", new { id = "#=SalesLotId#" }).Data("sendForgery"))
                                                .Update(update => update.Action("SalesLotPurchases_Update", "SalesLotPurchases", new { id = "#=SalesLotId#" }).Data("sendForgery"))
                                                .Destroy(destroy => destroy.Action("SalesLotPurchases_Destroy", "SalesLotPurchases", new { id = "#=SalesLotId#" }).Data("sendForgery"))
                                                .Sort(sort => sort.Add("SalesLotPurchaseId").Descending())

                                                ).ToClientTemplate()
    )
}
