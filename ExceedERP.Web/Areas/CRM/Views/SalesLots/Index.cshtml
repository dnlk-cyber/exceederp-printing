@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.CRM.TenderManagement
@{
    ViewBag.Title = "Sale Lots";
    //Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Sales lots</legend>
@(Html.Kendo().Grid<SalesLot>()
                                                .Name("grid")
                                                .Columns(columns =>
                                                {
                                                    columns.Bound(c => c.SalesLotId).Visible(false);
                                                    columns.Bound(c => c.LotName);
                                                    columns.Bound(c => c.BidParticpatePlace).Title("Bid Participation Place");
                                                    columns.ForeignKey(c => c.SaleTenderId, (IEnumerable)ViewData["tender"], "Value", "Text").Title("Tender Name").Width(200).EditorTemplateName("Tender");
                                                    columns.ForeignKey(c => c.BusinessUnitiId, (IEnumerable)ViewData["businessunit"], "Code", "Name").EditorTemplateName("BusinessUnitSelector").Title("Business Unit").Width(200);
                                                    columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["branch"], "Code", "Name").EditorTemplateName("BranchSelector").Title("Branch Name").Width(200);
                                                    columns.ForeignKey(c => c.StoreCode, (IEnumerable)ViewData["stores"], "StoreCode", "Name").EditorTemplateName("StoreCodeSelector").Title("Store").Width(200);

                                                    columns.Bound(c => c.Description);/*.ClientTemplate("<input type='checkbox' disabled = 'true' \\#= Description ? checked='checked' :'' \\# />");*/
                                                    columns.Command(command =>
                                                    {
                                                        command.Edit();
                                                        command.Destroy().Text(Resources.ActionButton_Cancel);
                                                    }).Width(200);


                                                })
                                                .ToolBar(toolbar =>
                                                {
                                                    toolbar.Create().Text(Resources.ActionButton_AddNewRecord);

                                                })
                                                .Events(ev => ev.DetailExpand("detailExpandMasterDepartment"))
                                                .Events(x => x.DataBound("onDataBoundMasterSalesLot"))
                                                .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                 .Scrollable(s => s.Height(900))
                                                .DataSource(dataSource => dataSource
                                                    .Ajax()
                                                    .Events(events =>

                                                        events.Error("error_handler(\"grid\")")
                                                           .RequestStart("onRequestStart(\"grid\")")
                                                           .RequestEnd("onRequestEnd(\"grid\")"))



                                                .Model(model => model.Id(p => p.SalesLotId))
                                                .Read(read => read.Action("SalesLots_Read", "SalesLots").Data("sendForgery"))
                                                .Create(create => create.Action("SalesLots_Create", "SalesLots").Data("sendForgery"))
                                                .Update(update => update.Action("SalesLots_Update", "SalesLots").Data("sendForgery"))
                                                .Destroy(destroy => destroy.Action("SalesLots_Destroy", "SalesLots").Data("sendForgery"))
                                                .Sort(sort=>sort.Add("SalesLotId").Descending())
    ).ClientDetailTemplateId("sales_slot_item")
)


