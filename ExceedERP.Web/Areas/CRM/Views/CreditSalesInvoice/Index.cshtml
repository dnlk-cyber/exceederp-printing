<legend>Credit Sales Invoice</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.CreditSalesInvoice>()
              .Name("CreditSalesInvoice")
      .Columns(columns =>
      {
          columns.Bound(c => c.Consignee);
          columns.Bound(c => c.Date);
          columns.Bound(c => c.GrandTotal);
          columns.Bound(c => c.Period);
          columns.Bound(c => c.PaymentMethod);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable(s => s.Height(500))
      .Events(ev => ev.DetailExpand("onDetailExpand"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.CreditSalesInvoiceID))
          .Read(read => read.Action("CreditSalesInvoices_Read", "CreditSalesInvoice"))
          .Create(create => create.Action("CreditSalesInvoices_Create", "CreditSalesInvoice"))
          .Update(update => update.Action("CreditSalesInvoices_Update", "CreditSalesInvoice"))
          .Destroy(destroy => destroy.Action("CreditSalesInvoices_Destroy", "CreditSalesInvoice"))
          ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
