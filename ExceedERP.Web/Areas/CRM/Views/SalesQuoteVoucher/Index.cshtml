                        model.Field(v => v.TaxAmount).Editable(false);
                        model.Field(v => v.CalculatedCost).Editable(false);
                    })
                    .Events(ev => ev
                        .Error("error_handler(\"LineItems_#=SalesQuoteVoucherID#\")")
                        .RequestStart("onRequestStart(\"LineItems_#=SalesQuoteVoucherID#\")")
                        .RequestEnd("onRequestEnd(\"LineItems_#=SalesQuoteVoucherID#\")")
                        )
                    .Read(read => read.Action("LineItems_Read", "LineItem", new { voucherID = "#=SalesQuoteVoucherID#", voucherDefinitionID = "0" }))
                    .Create(create => create.Action("LineItems_Create", "LineItem", new { voucherID = "#=SalesQuoteVoucherID#", voucherDefinitionIDCreate = "0" }))
                    .Update(update => update.Action("LineItems_Update", "LineItem", new { voucherID = "#=SalesQuoteVoucherID#", voucherDefinitionID = "0" }))
                    .Destroy(destroy => destroy.Action("LineItems_Destroy", "LineItem")))
                .ToClientTemplate()

