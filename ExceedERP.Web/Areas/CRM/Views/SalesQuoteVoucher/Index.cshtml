                    columns.Bound(c => c.UnitAmount).Title("Price").Format("{0:N4}").Width(80);
                    columns.Bound(c => c.Quantity).Title("QTY").Format("{0:N4}").Width(80);
                    columns.Bound(c => c.UOM).Width(60).Title("UoM");
                    columns.Bound(c => c.CalculatedCost).Title("Sub Total").Format("{0:N4}").Width(80);
                    columns.ForeignKey(c => c.Tax, (System.Collections.IEnumerable)ViewData["Tax"], "GLTaxRateID", "TaxName").Title("Tax Type").Width(80);
                    columns.Bound(c => c.TaxAmount).Format("{0:N4}").Width(80);
                    columns.Bound(c => c.Discount).Format("{0:N4}").Width(80);
                    columns.Bound(c => c.TotalAmount).Title("Total").Format("{0:N4}").Width(80);
