@using ExceedERP.Core.Domain.CRM
@model  ExceedERP.Core.Domain.CRM.SalesQuoteVoucherView
<style>
    .k-grid table tr.k-state-Issued {
        background: #b7ff9e;
        color: #040000;
    }
    .k-grid table tr.k-state-first-approved {
        background: #99e6ff;
        color: #040000;
    }
    .k-grid table tr.k-state-second-approved {
        background: #99c2ff;
        color: #040000;
    }
    .k-grid table tr.k-state-waiting-approval {
        background: #ffffcc;
        color: #040000;
    }
    .k-grid table tr.k-state-Rejected {
        background: #fcabab;
        color: #040000;
    }
    fieldset.scheduler-border {
        border: 1px ridge #e6e6e6 !important;
        /*border: 1px ridge #e88686 !important;*/
        padding: 0 1.4em 1.4em 1.4em !important;
        margin: 0 0 1.5em 0 !important;
        -webkit-box-shadow: 0px 0px 0px 0px #000;
        box-shadow: 0.5px 0.5px 0px 0px #ccc;
    }

    legend.scheduler-border {
        font-size: 1.2em !important;
        font-weight: bold !important;
        text-align: left !important;
        /*padding: 0 10px;*/ /* To give a bit of padding on the left and right */
        border-bottom: none;
    }
</style>

<legend>Sales Quote Voucher</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.SalesQuoteVoucherView>()
          .Name("SalesQuoteVoucher")
          .Columns(columns =>
          {
              columns.Bound(c => c.SalesQuoteVoucherID).Title(" # ").Width(80);
              columns.Bound(c => c.JobOrderNumber).Title("JO # ").Width(80);
              columns.ForeignKey(c => c.OrganizationCustomerId, (System.Collections.IEnumerable)ViewData["OrganizationCustomers"], "OrganizationCustomerID", "TradeName").Title("Customer").EditorTemplateName("OrgCustomerEditor").Width(100);
              columns.Bound(c => c.PlateNo).Width(80);
              columns.ForeignKey(c => c.BranchId, (System.Collections.IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(100);
              columns.ForeignKey(c => c.StoreID, (System.Collections.IEnumerable)ViewData["SalesStore"], "SalesStoreId", "Description").Width(100);
              columns.ForeignKey(c => c.CRMPeriodId, (System.Collections.IEnumerable)ViewData["CRMPeriods"], "CRMPeriodId", "Name").EditorTemplateName("OpenCRMPeriodsSelector").Width(100);
              columns.Bound(c => c.Date).Width(100).EditorTemplateName("Date");
              columns.Bound(c => c.PaymentMethod).Title("Payment Method").EditorTemplateName("PaymentMethodType").Width(100);
              columns.ForeignKey(c => c.QuotationTermId, (System.Collections.IEnumerable)ViewData["QuotationTerms"], "QuotationTermId", "QuotationInDays").EditorTemplateName("QuotationTermEditor").Width(100);
              columns.ForeignKey(c => c.BankAccountId, (System.Collections.IEnumerable)ViewData["BankAccounts"], "BankAccountId", "AccountName").Width(100)/*.EditorTemplateName("CompanyBankAccountEditorTemplate")*/;
              columns.Bound(c => c.DueDate).Width(100).EditorTemplateName("Date");
              columns.Bound(c => c.GrandTotal).Format("{0:N4}").Width(100);
              columns.Bound(c => c.CreatedBy).Width(80);
              columns.Bound(c => c.Status).Width(80);
              columns.Bound(c => c.Remark).Width(100);

              columns.Command(command =>
              {
                  command.Edit();
                  //command.Destroy();
              }).Width(200);
          })
          .Selectable()
          .Scrollable(s => s.Height(500))
          .ToolBar(toolbar =>
          {
              //toolbar.Create();
              //toolbar.Excel();
              toolbar.Template(@<text>
                    <div class="toolbar">

                        <button class="k-button k-button-icontext k-grid-add btn btn-primary" href='#'>
                            <span class="k-icon k-i-add"></span>
                            Add new Record
                        </button> 
                        &nbsp;
                        <button class="k-button k-button-icontext k-grid-excel" href='#'>
                            <span class="k-icon k-i-excel"></span>
                            Export to Excel
                        </button>
                        &nbsp;
                        @(Html.Kendo().Button()
                            .Content("Generate from Job Order")
                            .Name("GenerateFromJobOrder")
                            .Icon("copy")
                            .Events(e =>
                            {
                                e.Click("onGenerateSalesQuoteFromJobOrderClick");
                            })
                            //.HtmlAttributes(new { @onClick="onCheckBoxClick(this.checked)", @style="vertical-align:center;"})
                            )

                    </div>
                </text>);
          })
          .Events(ev =>
          {
              ev.DetailExpand("onDetailExpandUser");
              ev.DataBound("onDataBound");

          })
          .Editable(editable =>
          {
              editable.Mode(GridEditMode.PopUp);
              editable.TemplateName("SaleQuoteEditor");
              editable.Window(w =>
              {
                  w.Scrollable(false);
                  w.Title("Sales Quote Voucher");
              });
              //editable.DisplayDeleteConfirmation("Are You Sure To Forward Quote Voucher");
          }
              )
              .HtmlAttributes(new { style = "height: 700px;" })
                .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))

                .Scrollable()
                .Sortable()
                .Filterable()
                .Scrollable(h => h.Height(500))
          .DataSource(dataSource => dataSource
                  .Ajax()
                  .Sort(x => x.Add(s => s.SalesQuoteVoucherID).Descending())
              .Model(model =>
              {
                  model.Id(p => p.SalesQuoteVoucherID);
                  model.Field(v => v.SalesQuoteVoucherID).Editable(false);
                  model.Field(v => v.GrandTotal).Editable(false);
                  model.Field(v => v.AdditionalCharge).Editable(false);
                  model.Field(v => v.Discount).Editable(false);
                  model.Field(v => v.Status).Editable(false);
                  model.Field(f => f.DueDate).Editable(false);
                  model.Field(f => f.CreatedBy).Editable(false);

                  model.Field(v => v.SubTotal).Editable(false);
              }
                  ).Events(ev => ev
                            .Error("error_handler(\"SalesQuoteVoucher\")")
                            .RequestStart("onRequestStart(\"SalesQuoteVoucher\")")
                            .RequestEnd("onRequestEnd(\"SalesQuoteVoucher\")"))

                .Read(read => read.Action("Vouchers_Read", "SalesQuoteVoucher"))
                .Create(create => create.Action("Vouchers_Create", "SalesQuoteVoucher"))
                .Update(update => update.Action("Vouchers_Update", "SalesQuoteVoucher"))
                .Destroy(distroy => distroy.Action("Vouchers_Delete", "SalesQuoteVoucher"))
          ).ClientDetailTemplateId("template")
)


