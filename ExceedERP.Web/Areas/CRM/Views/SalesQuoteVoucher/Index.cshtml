<script>
    var id;
    var masterId;
    var gridName;
    var thingId;
    var thingsid;
    var masterDataItem;
    var selectedStoreID;


    function onDataBound(e) {
        var grid = this;


        var Checkgrid = $("#SalesQuoteVoucher").data("kendoGrid");
        var gridData = Checkgrid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            //get the item uid
            var currentUid = gridData[i].uid;
            //if the record fits the custom condition
            if (gridData[i].LastObjectState == "Rejected") {
                //find the row based on the uid and the custom class
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                $(currenRow).addClass("k-state-Rejected");
            }
        }
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);

            if (dataItem.LastObjectState == "Forwarded") {

                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                $(this).addClass("k-state-Issued");
            }
        });
    }
    function onDetailExpand(e) {
        var masterRow = e.masterRow;
        //var masterGrid = $("#grid").data("kendoGrid");
        var masterGrid = $("#SalesQuoteVoucher").data("kendoGrid");
        var masterDataItem2 = masterGrid.dataItem(masterRow);
        masterId = masterDataItem2.SalesQuoteVoucherID;
        gridName = "#LineItems_" + masterId;
    }
    function GetThingId(e) {
        var masterRow = this.wrapper.closest("tr.k-detail-row").prev(".k-master-row");
        var masterGridd = $(gridName).data("kendoGrid");
        var rDataItem = masterGridd.dataItem(masterRow);
        thingsid = rDataItem.ThingID;
        selectedStoreID = rDataItem.StoreID;
    }
    function GetThingIdValue() {
        return { thingId: id }
    }

</script>
