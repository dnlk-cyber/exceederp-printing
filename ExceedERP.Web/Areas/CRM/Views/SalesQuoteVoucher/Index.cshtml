<script>
    var headerStoreId = 0;
    var id;
    var masterId;
    var gridName;
    var thingId;
    var thingsid;
    var masterDataItem;
    var selectedStoreID;

     function sendForFirstApproval(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForFirstApproval", "SalesQuoteVoucher", new { area = "CRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                location.reload(true);
            }, 
            error: function (result) {
                alert(result);
            }
        });
    }
    function sendForSecondApproval(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForSecondApproval", "SalesQuoteVoucher", new { area = "CRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                location.reload(true);
            }, 
            error: function (result) {
                alert(result);
            }
        });
    }
    function sendForApproval(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "SalesQuoteVoucher", new { area = "CRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                location.reload(true);
            }, 
            error: function (result) {
                alert(result);
            }
        });
    }
    function onDataBound(e) {
        var grid = this;
        var Checkgrid = $("#SalesQuoteVoucher").data("kendoGrid");
        var gridData = Checkgrid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].LastObjectState == "Rejected") {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                $(currenRow).addClass("k-state-Rejected");
            }
            else if (gridData[i].LastObjectState == "WaitingApproval" || gridData[i].LastObjectState == "Waiting Approval" ||
                gridData[i].LastObjectState == "Waiting CRM Approval" || gridData[i].LastObjectState == "Waiting Maintenance Approval") {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                $(currenRow).addClass("k-state-waiting-approval");
            }
            else if (gridData[i].LastObjectState == "Forwarded" || gridData[i].LastObjectState == "Approved" || gridData[i].LastObjectState == "Finance Approved") {
