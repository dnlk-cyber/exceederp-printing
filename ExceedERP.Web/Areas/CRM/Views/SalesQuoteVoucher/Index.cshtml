    .Name("generate_sales_quote_from_job_order")
    .Title("Generate SQ from JO")
    .Content(@<text>
        @(Html.Kendo().DropDownList()
            .Name("generate_sq_from_jo_ddl")
            .Filter(FilterType.Contains)
            .ValuePrimitive(true)
            .OptionLabel("Select JO...")
            .DataTextField("JobOrderNumber")
            .DataValueField("JobOrderNumber")
            .HtmlAttributes(new { style="width:100%;"})
            .DataSource(dataSource =>
            {
                dataSource.Read(read => read.Action("GetMaintenanceJobOrdersToGenerateSQ", "CRMDataProvider", new { area = "CRM" }))
                .ServerFiltering(false);
            })
            .Events(e =>
            {
                e.Change("onMaintenanceJOChange");
            })
        )
        <hr />
        @(Html.Kendo().Button()
            .Name("generate_sq_from_jo_confirm_btn")
            .Content("Generate SQ")
            .Enable(false)
            .Events(e =>
            {
                e.Click("onGenerateSalesQuoteFromJobOrderConfirm");
            })
            .HtmlAttributes(new { style="width:100%;", @class = "btn btn-primary"})
        )
    </text>)
    .Draggable()
    //.Resizable(false)
    .Width(250)
    .Height(150)
    .Modal(true)
    .Visible(false)

    .Events(e =>
    {
        e.Close("onGenerateSQFromJOOpen");
        e.Open("onGenerateSQFromJOClose");
    })
)

