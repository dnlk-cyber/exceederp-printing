<script>
    @helper SalesQuoteLineItemHelperCrud()
    {
        @(Html.Kendo().Grid<ExceedERP.Web.Areas.CRM.Models.LineItemViewModel>()
                .Name("LineItems_#=SalesQuoteVoucherID#")
