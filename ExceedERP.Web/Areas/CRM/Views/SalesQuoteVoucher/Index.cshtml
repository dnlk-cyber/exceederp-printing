<legend>Sales Quote Voucher</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.SalesQuoteVoucherView>()
              .Name("SalesQuoteVoucher")
          .Columns(columns =>
          {
              columns.Bound(c => c.SalesQuoteVoucherID).Title(" # ").Width(80);
              columns.ForeignKey(c => c.OrganizationCustomerId, (System.Collections.IEnumerable)ViewData["OrganizationCustomers"], "OrganizationCustomerID", "TradeName").Title("Customer").EditorTemplateName("OrgCustomerEditor").Width(100);

              columns.Bound(c => c.Date).Width(100).EditorTemplateName("Date");
              columns.Bound(c => c.PaymentMethod).Title("Payment Method").EditorTemplateName("PaymentMethodType").Width(100);
              columns.Bound(c => c.GrandTotal).Format("{0:N0}").Width(100);
              columns.Bound(c => c.Status).Width(80);

              columns.Command(command =>
              {
                  command.Edit();

                  command.Destroy().Text("Forward");

              }).Width(180);


          })
          .Selectable()
          .Scrollable(s => s.Height(500))
          .ToolBar(toolbar =>
          {
              toolbar.Create();
          })
          .Events(ev =>
              {
                  ev.DetailExpand("onDetailExpand");
                  ev.DataBound("onDataBound");

              })
          .Editable(editable =>
          {
              editable.Mode(GridEditMode.InLine);
              editable.DisplayDeleteConfirmation("Are You Sure To Forward Quote Voucher");
          }
              ).HtmlAttributes(new { style = "height: 520px;" })
                              .Pageable(pageable => pageable
                                                .Input(true)
                                                .Numeric(false)
                                                .Refresh(true)
                                                .PageSizes(true)
                                                .ButtonCount(5))

                                    .Scrollable()
                                    .Sortable()
                                    .Filterable()
                                     .Scrollable(h => h.Height(500))
             .Events(ev => ev.DetailExpand("onDetailExpandUser"))
          .DataSource(dataSource => dataSource
                  .Ajax()
                      .Sort(x => x.Add(s => s.SalesQuoteVoucherID).Descending())
              .Model(model =>
              {
                  model.Id(p => p.SalesQuoteVoucherID);
                  model.Field(v => v.SalesQuoteVoucherID).Editable(false);
                  model.Field(v => v.GrandTotal).Editable(false);
                  model.Field(v => v.AdditionalCharge).Editable(false);
                  model.Field(v => v.Discount).Editable(false);
                  model.Field(v => v.Status).Editable(false);

                  model.Field(v => v.SubTotal).Editable(false);
              }
                  ).Events(ev => ev
                                                                    .Error("error_handler(\"SalesQuoteVoucher\")")
                                                                 .RequestStart("onRequestStart(\"SalesQuoteVoucher\")")
                                                               .RequestEnd("onRequestEnd(\"SalesQuoteVoucher\")"))


                          .Read(read => read.Action("Vouchers_Read", "SalesQuoteVoucher"))
              .Create(create => create.Action("Vouchers_Create", "SalesQuoteVoucher"))
              .Update(update => update.Action("Vouchers_Update", "SalesQuoteVoucher"))
                  .Destroy(distroy => distroy.Action("ForwardSalseQuoteVoucher", "SalesQuoteVoucher"))
          ).ClientDetailTemplateId("template")
)


