@model ExceedERP.Core.Domain.CRM.CreditSettlement
@using ExceedERP.Web.Areas.CRM.Models;

<legend>  Credit Settlement  </legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.CreditSettlement>()
        .Name("grid")
        .Columns(columns =>
        {
            columns.Bound(c => c.CreditSettlementId).Title("#").Width(50);
            columns.ForeignKey(c => c.Customer, (System.Collections.IEnumerable)ViewData["OrganizationCustomer"], "OrganizationCustomerID", "TradeName").Title("Customer").EditorTemplateName("OrgCreditSettlementEditor").Width(120);
            columns.ForeignKey(c => c.BranchId, (System.Collections.IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(100);
            columns.ForeignKey(c => c.CRMPeriodId, (System.Collections.IEnumerable)ViewData["CRMPeriods"], "CRMPeriodId", "Name").EditorTemplateName("OpenCRMPeriodsSelector").Width(100);
            columns.Bound(c => c.Date).Width(80);
            columns.ForeignKey(c => c.RecieveMethod, (System.Collections.IEnumerable)ViewData["PaymentMethod"], "PaymentMethodID", "Method").Title("Recieve Method").EditorTemplateName("GetReceiveMethod").Width(120);
            columns.Bound(c => c.ReceiptNumber).Width(80);
            columns.Bound(c => c.GrandTotal).Format("{0:N4}").Width(100);
            columns.Bound(c => c.SettlementAmount).Format("{0:N4}").Width(100);
            columns.Bound(c => c.Remaining).Format("{0:N4}").Width(100);
            columns.Bound(c => c.CreatedBy).Width(100);
            columns.Bound(c => c.Status).Width(100);
            columns.Bound(c => c.Remark).Width(100);
            columns.Command(command =>
            {
                command.Edit();
                command.Destroy();

            }).Width(180);

        })
        .ToolBar(toolbar =>
        {
            toolbar.Create();
            toolbar.Excel();
        })

        .Events(ev =>
        {
            ev.DetailExpand("onDetailExpand");
            ev.DataBound("onDataBound");
        })
        .Editable(editable =>
        {
            editable.Mode(GridEditMode.InLine);
            editable.DisplayDeleteConfirmation("Are You Sure To Approve Invoice");
        })
        .HtmlAttributes(new { style = "height: 700px;" })
        .Pageable(pageable => pageable
                                            .Input(true)
                                            .Numeric(false)
                                            .Refresh(true)
                                            .PageSizes(true)
                                            .ButtonCount(5))

        .Scrollable()
        .Sortable()
        .Filterable()
        //.Groupable()
        .Scrollable(h => h.Height(700))

        .DataSource(dataSource => dataSource
            .Ajax().Sort(x => x.Add(s => s.CreditSettlementId).Descending())
            .Model(model =>
            {
                model.Id(p => p.CreditSettlementId);
                model.Field(p => p.CreditSettlementId).Editable(false);
                model.Field(p => p.GrandTotal).Editable(false);
                model.Field(p => p.Status).Editable(false);
                model.Field(p => p.SettlementAmount).Editable(false);
                model.Field(f => f.Remaining).Editable(false);
                model.Field(f => f.CreatedBy).Editable(false);

            })
            .Events(ev => ev
                    .Error("error_handler(\"grid\")")
                    .RequestStart("onRequestStart(\"grid\")")
                    .RequestEnd("onRequestEnd(\"grid\")"))
            .Read(read => read.Action("CreditSettlements_Read", "CreditSettlement"))
            .Create(create => create.Action("CreditSettlements_Create", "CreditSettlement"))
            .Update(update => update.Action("CreditSettlements_Update", "CreditSettlement"))
            .Destroy(destroy => destroy.Action("CreditSettlements_Destroy", "CreditSettlement"))
        ).ClientDetailTemplateId("template")
)



