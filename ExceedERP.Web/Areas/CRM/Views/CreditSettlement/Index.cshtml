<script>
    var masterId;
    var customer;
    var receiveMethod;
    function filterCustomerInvoice() {
        return {
            Customer: customer
        };
    }

    function filterInvoice() {
        return {
            Voucher: $('#InvoiceId').val()
        };
    }
    function onDataBound(e) {
        var grid = this;
        grid.tbody.find("tr[role='row']").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem.Status == "Approved") {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
                $(this).addClass("k-state-Approved");
            }
            else if (dataItem.Status == "WaitingApproval") {
                $(this).find(".k-grid-edit").remove();
                $(this).find(".k-grid-delete").remove();
            }
            else if (dataItem.Status == "Rejected") {
                $(this).addClass("k-state-Rejected");
            }
           
        });
    }

    function onPeriodChange(e) {
        var drp = this;
        var id = drp.value();
        var voucherDate = $("#Date").data("kendoDatePicker");
        
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPeriodRanges", "CRMDataProvider", new { area = "CRM" })',
            data: { periodId: id},
            success: function (result) {
                if (result) {
                    var ranges = result.split('_');
                    var start = ranges[0];
                    var end = ranges[1];
                    var startDate = new Date(start);
                    var endDate = new Date(end);
                    if (voucherDate) {
                        voucherDate.min(startDate);
                        voucherDate.max(endDate);
                        voucherDate.value(startDate);
                        voucherDate.trigger("change");
                    } 
                }
            }, 
            error: function (result) {
            }
        });

    }
    function onDetailExpand(e) {
        var masterRow = e.masterRow;

        var masterGrid = $("#grid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);
        customer = masterDataItem.Customer;
        masterId = masterDataItem.CreditSettlementId;
        receiveMethod = masterDataItem.RecieveMethod;
        console.log("master " + masterId + " -- Custromer" + customer + receiveMethod);
       // gridName = "#LineItems_" + masterId;
    }

    function UpdateInvoiceChange() {

       var invoice = $("#InvoiceId").data("kendoDropDownList");

        $.ajax({
            url: '@Url.Action("GetCustomerInvoiceBalanceDDBind", "CashSalesInvoice")',

            data: { Voucher: invoice.value() },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                $("#CurrentAmmount").val(r.Name);
                $("#CurrentAmmount").trigger("change");

                var setlAmnt = $("#SettelmentAmount").val();
                if (setlAmnt == 0) {
                    $("#SettelmentAmount").val(r.Name);
                    $("#SettelmentAmount").trigger("change");
                }
            }
        });

    }
    function BindNonTransaction() {

        $("#Consignee").val(customer);
        $("#ReceiveMethod").val(receiveMethod);
    }
    function sendForApproval(id) {
        var recordStatus = "";
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "CreditSettlement", new { area = "CRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, 
            error: function (result) {
                alert(result);
            }
        });
    }
    function transferToGl(id) {
        var desc = prompt("Please enter transaction description:");
        if (desc != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferDistribution", "CreditSettlement", new { area = "CRM" })',
                data: {
                    id: id,
                    description: desc
                },
                success: function (result) {
                    alert(result.Message);
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
    function regenerateDistribution(id) {
        $.ajax({
                type: "POST",
                url: '@Url.Action("RegenerateDistribution", "CreditSettlement", new { area = "CRM" })',
                data: {
                    id: id,
                },
                success: function (result) {
                    alert(result.Message);
                    if (result.Status == "OK") {
                        location.reload(true);
                    }
                }, 
                error: function (result) {
                    alert(result);
                }
            });
    }
</script>

