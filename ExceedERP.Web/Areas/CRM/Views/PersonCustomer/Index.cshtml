<legend>Person Customer</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.Person_Customer>()
      .Name("PersonCustomerGrid")
      .Columns(columns =>
      {
          columns.Bound(c => c.FirstName).Width(150);
          columns.Bound(c => c.MiddleName).Width(150);
          columns.Bound(c => c.LastName).Width(150);
          columns.Bound(c => c.DateOfBirth).Width(150);
          columns.ForeignKey(c => c.Nationality, (System.Collections.IEnumerable)ViewData["NationalityList"], "CountryID", "Nationality").Width(150);
          columns.ForeignKey(c => c.CategoryID, (System.Collections.IEnumerable)ViewData["CategoryList"], "PersonCategoryID", "Description").Width(150);
          columns.Bound(c => c.Gender);
          columns.Bound(c => c.IsActive);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);

      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();

      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("PersonCustomer").Window(window => { window.Title("Maintain Customer Information"); window.Scrollable(false); }))
      .Navigatable()
      .Scrollable(s => s.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.Person_CustomerID))
          .Read(read => read.Action("People_Read", "PersonCustomer"))
          .Create(create => create.Action("People_Create", "PersonCustomer"))
          .Update(update => update.Action("People_Update", "PersonCustomer"))
          .Destroy(destroy => destroy.Action("People_Destroy", "PersonCustomer"))
          ).ClientDetailTemplateId("template")
)


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabstrip_#=Person_CustomerID#")
    .SelectedIndex(0)
    .Items(items =>
     {
         items.Add().Text("Detail").Content(
            @<text>
                <legend>Detail</legend>
                @(Html.Kendo().PanelBar()
                          .Name("panelbar")
                          .ExpandMode(PanelBarExpandMode.Single)
                          .Items(panelbar =>
                          {
                              panelbar.Add().Text("Detail")
                                  .Expanded(true)
                                  .Content(
                                      "<div class='goodreceive-details'>" +
                                      "<ul>" +
                                      "<li><label>Gender:</label>#= Gender #</li>" +
                                       "<li><label>Date Of Birth:</label>#= DateOfBirth #</li>" +
                                      "<li><label>Title:</label>#= Title#</li>" +
                                       "<li><label>Remark:</label>#= Remark #</li>" +
                                      "</ul>" +
                                      "</div>"
                                  );
                             

                          }
                          ).ToClientTemplate()

                )

            </text>

     );

         //*************************************************************************************************
         //*********************************Identifications*************************************************//

         items.Add().Text("Identifications").Content(
            @<text>
                <legend>Identifications</legend>
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.Identification>()
                        .Name("Identification_#=Person_CustomerID#")
                .Columns(columns =>
                {
                    columns.Bound(c => c.IDNumber);
                    columns.Bound(c => c.Description);
                    columns.Bound(c => c.Type).EditorTemplateName("IdentificationType");
                    columns.Bound(c => c.IssueDate);
                    columns.Bound(c => c.ExpiryDate);
                    columns.Bound(c => c.Issuer);
                    columns.Bound(c => c.Remark);
                    columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
                })
                .ToolBar(toolbar =>
                {
                    toolbar.Create();
                })
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Scrollable()
                .DataSource(dataSource => dataSource
                .Ajax()
                .Model(model => model.Id(i => i.IdentificationID))
                                        .Read(read => read.Action("Identifications_Read", "Identification", new { id = "#=Person_CustomerID#", identificationReferenceType = "PersonCustomer" }))
                                                .Create(create => create.Action("Identifications_Create", "Identification", new { id = "#=Person_CustomerID#", identificationReferenceType = "PersonCustomer" }))
                .Update(update => update.Action("Identifications_Update", "Identification"))
                .Destroy(destroy => destroy.Action("Identifications_Destroy", "Identification"))
    ).ToClientTemplate()
                )

            </text>


     );

   //*************************************************************************************************
   //*********************************BankInformation*************************************************//
         items.Add().Text("BankAccountDetails").Content(
