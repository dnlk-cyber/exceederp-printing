                 .Model(model => model.Id(p => p.BankReferenceID))
                                                                         .Read(read => read.Action("BankReferences_Read", "BankReference", new { id = "#=Person_CustomerID#", bankReferenceType = "PersonCustomer" }))
                                                                                         .Create(create => create.Action("BankReferences_Create", "BankReference", new { id = "#=Person_CustomerID#", bankReferenceType = "PersonCustomer" }))
                                 .Update(update => update.Action("BankReferences_Update", "BankReference"))
                                 .Destroy(destroy => destroy.Action("BankReferences_Destroy", "BankReference"))
             ).ToClientTemplate()
                )

            </text>
            );

         //*****************************************************************************************************//
         //*********************************Industry Involvement*************************************************//
         items.Add().Text("Industry Involvement").Content(
            @<text>
                <legend>Industry Involvement</legend>
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.IndustryInvolved>()
              .Name("IndustryInvolvementGrid_#=Person_CustomerID#")
      .Columns(columns =>
      {
          columns.Bound(c => c.Index);
          columns.Bound(c => c.Industry).EditorTemplateName("IndustryType");
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.IndustryInvolvedID))
                                          .Read(read => read.Action("IndustryInvolveds_Read", "IndustryInvolved", new { referenceIndustryInvolvment = "#=Person_CustomerID#", industryInvolvedReferenceType = "Person_Customer" }))
                                                  .Create(create => create.Action("IndustryInvolveds_Create", "IndustryInvolved", new { referenceIndustryInvolvment = "#=Person_CustomerID#", industryInvolvedReferenceType = "Person_Customer" }))
                  .Update(update => update.Action("IndustryInvolveds_Update", "IndustryInvolved"))
          .Destroy(destroy => destroy.Action("IndustryInvolveds_Destroy", "IndustryInvolved"))
     ).ToClientTemplate()
                )

