                                          .Read(read => read.Action("Beginnings_Read", "Beginning", new { id = "#=Person_CustomerID#", beginningReferenceType = "Person_Customer" }))
                          .Create(create => create.Action("Beginnings_Create", "Beginning", new { id = "#=Person_CustomerID#", beginningReferenceType = "Person_Customer" }))
          .Update(update => update.Action("Beginnings_Update", "Beginning"))
          .Destroy(destroy => destroy.Action("Beginnings_Destroy", "Beginning"))
     ).ToClientTemplate()
                )
            </text>
    );
         //*****************************************************************************************************//

         //*********************************Addresse***********************************************************//
         items.Add().Text("Address").Content(
            @<text>
                <legend>Address</legend>
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.Address>()
      .Name("AddresseGrid_#=Person_CustomerID#")
      .Columns(columns =>
      {
          columns.Bound(c => c.Category).EditorTemplateName("AddressType");
          columns.Bound(c => c.Value);
          columns.Bound(c => c.Remark);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.AddressID))
                                          .Read(read => read.Action("Addresses_Read", "Addresse", new { id = "#=Person_CustomerID#", addressReferenceType = "Person_Customer" }))
                                          .Create(create => create.Action("Addresses_Create", "Addresse", new { id = "#=Person_CustomerID#", addressReferenceType = "Person_Customer" }))
          .Update(update => update.Action("Addresses_Update", "Addresse"))
          .Destroy(destroy => destroy.Action("Addresses_Destroy", "Addresse"))
       ).ToClientTemplate()
                )
            </text>
    );
         //*****************************************************************************************************//
         //*********************************Attachment***********************************************************//
         items.Add().Text("Attachment").Content(
            @<text>
                <legend>Attachment</legend>
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.Attachment>()
              .Name("AttachmentGrid#=Person_CustomerID#")
      .Columns(columns =>
      {
          columns.Bound(c => c.Description);
          columns.Bound(c => c.URL);
          columns.Bound(c => c.BinaryFile);
          columns.Bound(c => c.FileType);
          columns.Bound(c => c.Index);
          columns.Bound(c => c.Remark);
          columns.Command(command => {command.Custom("Download").Click("DownloadAttachmnets"); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
      })
               .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("Upload").Window(window =>
                  {
                      window.Scrollable(false);
                      window.Title("Upload File");
                      
                  }))
      .Scrollable()
      .Events(e => e.Edit("onGridEdit"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.AttachmentID))
                                                          .Read(read => read.Action("Attachments_Read", "Attachment", new { attachmentReferenceType = "PHOTO", id = "#=Person_CustomerID#" }))
                                                                  .Create(create => create.Action("Attachments_Create", "Attachment", new { attachmentReferenceType = "PHOTO", id = "#=Person_CustomerID#" }))
          .Update(update => update.Action("Attachments_Update", "Attachment"))
          .Destroy(destroy => destroy.Action("Attachments_Destroy", "Attachment"))
       ).ToClientTemplate()
