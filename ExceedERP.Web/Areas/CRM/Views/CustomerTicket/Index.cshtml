@model ExceedERP.Core.Domain.CRM.CustomerTicket

<legend>Customer Ticket</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.CustomerTicket>()
          .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.CustomerTicketID).Width(50).Title("#");
          columns.ForeignKey(c => c.CustomerID, (System.Collections.IEnumerable)ViewData["CustomerList"], "CustomerID", "CustomerName").Width(150);
          columns.Bound(c => c.Description).Width(120);
          columns.Bound(c => c.Priority).HtmlAttributes(new { style = "background-color:#:PriorityColor#;" });
          columns.Bound(c => c.StatusType).HtmlAttributes(new { style = "background-color:#:StatusColor#;" });
          columns.Bound(c => c.TicketGroup);
            columns.Bound(c => c.Source);
        
          columns.Bound(c => c.Status);

          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();

      })   .Events(ev =>
                                              {

                                                  ev.DataBound("onDataBound");

                                              })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("CustomerTicketEditor").Window(window =>
          {
              window.Title("Open Customer Ticket");
              window.Scrollable(false);

          }))
           .HtmlAttributes(new { style = "height: 520px;" })
                                                  .Pageable(pageable => pageable
                                                                    .Input(true)
                                                                    .Numeric(false)
                                                                    .Refresh(true)
                                                                    .PageSizes(true)
                                                                    .ButtonCount(5))

                                                        .Scrollable()
                                                        .Sortable()
                                                        .Filterable()
                                                        .Groupable()
                                                        .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
             //  .Group(x => x.Add(p => p.Status))
              .Model(model => { model.Id(p => p.CustomerTicketID);
              model.Field(p => p.Status).Editable(false);
              })
              .Events(ev => ev
                                                                        .Error("error_handler(\"grid\")")
                                                                        .RequestStart("onRequestStart(\"grid\")")
                                                                        .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("CustomerTickets_Read", "CustomerTicket"))
          .Create(create => create.Action("CustomerTickets_Create", "CustomerTicket"))
          .Update(update => update.Action("CustomerTickets_Update", "CustomerTicket"))
          .Destroy(destroy => destroy.Action("CustomerTickets_Destroy", "CustomerTicket"))
        ).ClientDetailTemplateId("template")
)







<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
                                                    .Name("tabstrip_#=CustomerTicketID#")
    .SelectedIndex(0)
    .Items(items =>
     {
         items.Add().Text("  Detail  ").Content(
            @<text>
                <legend>  Detail </legend>
                <div class="demo-section k-header export-app">
                    <div class="demo-section content-wrapper">

                        <form>



                            <div class="row">
                                <div class="col-md-1">
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <div class="label">
                                            Created By
                                        </div>
                                        <div>
                                            #=CreatedBy#

                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <div class="label">
                                            @Html.LabelFor(model => model.DateCreated)
                                        </div>
                                        <div>
                                            #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #

                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-2">
                                    <div class="form-group">
                                        <div class="label">
                                            @Html.LabelFor(model => model.ModifiedBy)
                                        </div>
                                        <div>

                                            #=ModifiedBy#

                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-2">
                                    <div class="form-group">
                                        <div class="label">
                                            @Html.LabelFor(model => model.LastModified)
                                        </div>
                                        <div>
                                            #=kendo.toString(kendo.parseDate(LastModified), 'dd/MM/yyyy') #

                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-1">
                                </div>


                                <div class="col-md-2">
                                    <div class="form-group">
                                        <div class="label">
                                            @Html.LabelFor(model => model.EscalationLevel)
                                        </div>
                                        <div>
                                            #=EscalationLevel#
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-2">
                                    <div class="form-group">
                                        <div class="label">
                                            @Html.LabelFor(model => model.DueDate)
                                        </div>
                                        <div>
                                            #=kendo.toString(kendo.parseDate(DueDate), 'dd/MM/yyyy') #
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <div class="label">
                                            @Html.LabelFor(model => model.Remark)
                                        </div>
                                        <div>
                                            #=Remark#
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </text>
   );
         items.Add().Text("  Status  ").Content(
            @<text>
                <legend> Status   </legend>
                @(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.TicketStatusLog>()
                  .Name("Statusgrid_#=CustomerTicketID#")
      .Columns(columns =>
      {
          columns.ForeignKey(c => c.User, (System.Collections.IEnumerable)ViewData["SysUsers"], "CustomerID", "CustomerName").Width(100);
          columns.Bound(c => c.Remark).Width(200);
      })
    .Events(ev =>
                                              {

                                                  ev.DataBound("onDataBound");

                                              }).Editable(editable => editable.Mode(GridEditMode.InLine))


      //    }))

                                                        .Scrollable(h => h.Height(500))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model =>
              {
                  model.Id(p => p.TicketStatusLogId);
                  model.Field(p => p.TicketStatusLogId).Editable(false);

              })
              .Events(ev => ev
                                                                                        .Error("error_handler(\"Statusgrid_#=CustomerTicketID#\")")
                                                                                        .RequestStart("onRequestStart(\"Statusgrid_#=CustomerTicketID#\")")
                                                                                        .RequestEnd("onRequestEnd(\"Statusgrid_#=CustomerTicketID#\")"))
                                  .Read(read => read.Action("TicketStatus_Read", "AssignTicket", new { Id = "#=CustomerTicketID#" }))
               ).ToClientTemplate()
                )

            </text>
            );
     }).ToClientTemplate())
</script>
    <style type="text/css">
        div.k-edit-form-container {
            width: 700px;
        }
    </style>
    <script>
        function onDataBound(e) {
            var grid = this;


            var Checkgrid = $("#grid").data("kendoGrid");
            var gridData = Checkgrid.dataSource.view();

            grid.tbody.find("tr[role='row']").each(function () {
                var dataItem = grid.dataItem(this);

                if (dataItem.Status != "0") {

                    $(this).find(".k-grid-edit").remove();
                    $(this).find(".k-grid-delete").remove();
                    $(this).find(".k-grid-update").remove();

                }
            });
        }
    </script>
