<legend>Queue Registration</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.Queue>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.QueueNumber).Width(80);
          columns.ForeignKey(c => c.QueueTypeId, (System.Collections.IEnumerable)ViewData["QueueTypes"], "QueueTypeId", "QueueName").Width(100);

          columns.Bound(c => c.CustomerName).Width(100);
          columns.Bound(c => c.TinNumber).Width(100);
          columns.Bound(c => c.Phone).Width(100);
          columns.Bound(c => c.InvestmentType).Width(100);
          columns.Bound(c => c.InvestmentAmount).Width(100);
          columns.Bound(c => c.Grade).Width(100);
          columns.Bound(c => c.TotalRequestedAmount).Width(100);
          columns.Bound(c => c.WeeklyRequest).Width(100);
          columns.Bound(c => c.ApprovedQuantity).Width(100);
          columns.ForeignKey(c => c.BranchId, (System.Collections.IEnumerable)ViewData["Branches"], "BranchId", "Name").Width(100);
          columns.ForeignKey(c => c.LocationMapId, (System.Collections.IEnumerable)ViewData["LocationMaps"], "LocationMapId", "LocationName").Width(100);
          columns.Bound(c => c.Store).Width(100);

          columns.Bound(c => c.QueueDate).Width(100);
          columns.Bound(c => c.QueueStatus).Width(100);
          columns.Bound(c => c.AdvancePayment).Width(100);
          columns.Bound(c => c.Remark).Width(100);
          columns.Bound(c => c.Status).Width(100).Title("Aproval Status");
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(200);
      })
      .ToolBar(toolbar => {
          toolbar.Create();
          toolbar.Excel();
          toolbar.Pdf();
      })
      .Editable(editable => {
          editable.Mode(GridEditMode.PopUp);
          editable.TemplateName("QueueEditor");
          editable.Window(w => {
              w.Title("Queue");
              w.Scrollable(false);

          });
      })
      .Pageable()
      .Navigatable()
      .Sortable(sortable => {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Events(ev => {
          ev.DataBound("onDataBound");
      })
      .Filterable()
      .Scrollable(s => s.Height(700))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(ev => ev
                            .Error("error_handler(\"grid\")")
                            .RequestStart("onRequestStart(\"grid\")")
                            .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model => model.Id(p => p.QueueId))
          .Read(read => read.Action("Queue_Read", "Queue"))
          .Create(create => create.Action("Queue_Create", "Queue"))
          .Update(update => update.Action("Queue_Update", "Queue"))
          .Destroy(destroy => destroy.Action("Queue_Destroy", "Queue"))
      )
      .ClientDetailTemplateId("template")
)

