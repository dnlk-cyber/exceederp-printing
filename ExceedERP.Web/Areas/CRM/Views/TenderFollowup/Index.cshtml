    function swithReasonEditors() {
        var selectedValue = $("#Status").data("kendoDropDownList").value();
        if (selectedValue == "@TenderFollowupStatus.NonParticipating") {
            $("#reason_of_not_participating_container").show();
            $("#reason_of_losing_container").hide();
        }
        else if (selectedValue == "@TenderFollowupStatus.LostFinancialEvaluation" || selectedValue == "@TenderFollowupStatus.LostTechnicalEvaluation" || selectedValue == "@TenderFollowupStatus.LostNonTechnicalEvaluation") {
            $("#reason_of_losing_container").show();
            $("#reason_of_not_participating_container").hide();
        }
        else {
            $("#reason_of_losing_container").hide();
            $("#reason_of_not_participating_container").hide();
        }
    }
    function onExternalProductCheckBoxClick(checked) {
        if (checked) {
            $("#externalCategoryContainer").show();
            $("#externalProductContainer").show();
            $("#internalCategoryContainer").hide();
            $("#internalProductContainer").hide();
        } else {
            $("#externalCategoryContainer").hide();
            $("#externalProductContainer").hide();
            $("#internalCategoryContainer").show();
            $("#internalProductContainer").show();
        }
    }
    function onCategoryBound(e) {
        var isEx = $("#IsExternalProduct").is(':checked');
        if (isEx) {
            $("#externalCategoryContainer").show();
            $("#externalProductContainer").show();
            $("#internalCategoryContainer").hide();
            $("#internalProductContainer").hide();
        }
        else {
            $("#externalCategoryContainer").hide();
            $("#externalProductContainer").hide();
            $("#internalCategoryContainer").show();
            $("#internalProductContainer").show();
        }
    }
</script>
