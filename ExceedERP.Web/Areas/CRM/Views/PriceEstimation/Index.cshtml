@using ExceedERP.Core.Domain.CRM
<legend>Price Estimation</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.PriceEstimationQuoteVoucher>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.Bound(c => c.PriceEstimationQuoteVoucherId).Title("#").ClientTemplate("#=appendZeros(PriceEstimationQuoteVoucherId)#");
              columns.ForeignKey(c => c.OrganizationCustomerId, (System.Collections.IEnumerable)ViewData["OrganizationCustomers"], "OrganizationCustomerID", "TradeName").Title("Customer").EditorTemplateName("OrgCustomerEditor");
              columns.Bound(c => c.PlateNo).EditorTemplateName("EquipmentEditorTemplate");
              columns.ForeignKey(c => c.BankAccountId, (System.Collections.IEnumerable)ViewData["BankAccounts"], "BankAccountId", "AccountName").EditorTemplateName("CompanyBankAccountEditorTemplate");
              columns.Bound(c => c.Date).EditorTemplateName("Date");
              columns.Bound(c => c.GrandTotal).Format("{0:N2}");
              columns.Bound(c => c.Status);
              columns.Bound(c => c.CreatedBy);

              columns.Command(command =>
              {
                  command.Edit();
                  command.Destroy();
              }).Width(180);
          })
          .Selectable()
          .Scrollable(s => s.Height(500))
          .ToolBar(toolbar =>
          {
              toolbar.Create();
              toolbar.Excel();
          })
          .Events(ev =>
          {
              ev.DataBound("mainGridDataBound");
          })
          //.Editable(editable =>
          //{
          //    editable.Mode(GridEditMode.PopUp);
          //    editable.TemplateName("SaleQuoteEditor");
          //    editable.Window(w =>
          //    {
          //        w.Scrollable(false);
          //        w.Title("Sales Quote Voucher");
          //    });
          //})
          .HtmlAttributes(new { style = "height: 700px;" })
          .Pageable(pageable => pageable
                                .Input(true)
                                .Numeric(false)
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))

        .Scrollable()
        .Sortable()
        .Filterable()
        .Scrollable(h => h.Height(500))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Sort(x => x.Add(s => s.PriceEstimationQuoteVoucherId).Descending())
            .Model(model =>
            {
                model.Id(p => p.PriceEstimationQuoteVoucherId);


                model.Field(v => v.GrandTotal).Editable(false);
                model.Field(v => v.PriceEstimationQuoteVoucherId).Editable(false);
                model.Field(v => v.Status).Editable(false);
                model.Field(v => v.CreatedBy).Editable(false);
            })

            .Events(ev => ev
                        .Error("error_handler(\"grid\")")
                        .RequestStart("onRequestStart(\"grid\")")
                        .RequestEnd("onRequestEnd(\"grid\")"))

            .Read(read => read.Action("Vouchers_Read", "PriceEstimationQuoteVoucher"))
            .Create(create => create.Action("Vouchers_Create", "PriceEstimationQuoteVoucher"))
            .Update(update => update.Action("Vouchers_Update", "PriceEstimationQuoteVoucher"))
            .Destroy(distroy => distroy.Action("Vouchers_Delete", "PriceEstimationQuoteVoucher"))
          ).ClientDetailTemplateId("template")
)

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_#=PriceEstimationQuoteVoucherId#")
        .SelectedIndex(0)
        .Items(items =>
        {
        items.Add().Text("Detail").Content(
            @<text>
                #if (!IsMiddleOnlineApproved && !IsMiddleSendForApproval){#
                    <a onclick='return sendForFirstApproval("#=PriceEstimationQuoteVoucherId#")' href='\#' title="Send for 1st Approval"><i class="fa fa-share-square fa-2x text-info"></i></a>
                #}#
                #if (!IsOnlineApproved&&!IsSendForApproval && IsMiddleOnlineApproved){#
                    <a onclick='return sendForApproval("#=PriceEstimationQuoteVoucherId#")' href='\#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                #}#
                <a href='@Url.Action("PriceEstimation", "Print")/#=PriceEstimationQuoteVoucherId#' title="Print"><i class="fa fa-print fa-2x"></i></a>
                &nbsp;
                # if (IsOnlineApproved&&!IsVoid&&!IsOnlineTransferred)
                {#
                    @if (HttpContext.Current.User.IsInRole(CRMRoles.CRMVoid))
                    {
                        <a onclick='return voidRecord("#=PriceEstimationQuoteVoucherId#")' href='\#' title='Void Record'><i class='fa  fa-bolt fa-2x' style='color:red'></i></a>
                    }
                # } #
                @(Html.Kendo().PanelBar()
                        .Name("panelbar_#=PriceEstimationQuoteVoucherId#")
                        .ExpandMode(PanelBarExpandMode.Multiple)
                        .Items(panelbar =>
                        {
                                    panelbar.Add()
                                        .Expanded(true)
                                        .Text("Voucher Detail")
                                        .Content(
                                            "<div>" +
                                            "<ul>" +
                                            "<li> <label> Created by: </label> <strong> #=CreatedBy != null ? CreatedBy: ' '# </strong> </li>" +
                                            "<li> <label> Created on: </label> #= kendo.toString(DateCreated, 'dd/MM/yyyy H:mm:ss')# </li>" +
                                            "<li> <label> Modified by :</label> #= ModifiedBy != null ? ModifiedBy: ''# </li>" +
                                            "<li> <label> Last Modified :</label> #= LastModified != null ? kendo.toString(LastModified, 'dd/MM/yyyy H:mm:ss') : ' '# </li>" +
                                            "</ul>" +
                                            "</div>"
                                        );
                                }).ToClientTemplate()
                    )
                </text>
            );
        items.Add().Text("Line Items").Content(
                    @<text>
                         #if(!IsOnlineApproved && !IsSendForApproval){#
                            @LineItemHelperWithCrud()
                        #}else{#
                            @LineItemHelper()
                        #}#
                    </text>
                    );
    items.Add().Text("Services").Content(@<text>
            #if(!IsOnlineApproved && !IsSendForApproval){#
                    @ServiceLineItemHelperWithCrud()
                #}else{#
                    @ServiceLineItemHelper()
                #}#
        </text>);
        if (User.IsInRole(CRMRoles.PriceEstimationFirstApprover))
        {
            items.Add().Text("First Validation").Content(
            @<text>
                #if(IsMiddleSendForApproval && !IsMiddleOnlineApproved && !IsOnlineApproved && !IsSendForApproval){#
                    @FirstValidationHelperWithCrud()
                #}else{#
                    @FirstValidationHelper()
                #}#
            </text>);
        }
        
        if (User.IsInRole(CRMRoles.PriceEstimationApprover))
        {
            items.Add().Text("Final Validation").Content(
            @<text>
                #if(!IsOnlineApproved && IsSendForApproval){#
                    @ValidationHelperWithCrud()
                #}else{#
                    @ValidationHelper()
                #}#
            </text>);
        }
        }).ToClientTemplate()
    ) 
</script>

<script type="text/javascript">
    function getSelectedCategoryId() {
        var dropdownlist = $("#ProductId").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            categoryId: $("#CategoryId").val(), filterText: filterInput.val()
        };
    }
    function getSelectedServiceCategoryCode() {
        //var dropdownlist = $("#ProductId").data("kendoDropDownList");
        //var filterInput = dropdownlist.filterInput;
        return {
            categoryCode: $("#CategoryCode").val()
        };
    }

    function filterSubCategories() {
        return {
            subCategoryCode: $("#SubCategoryCode").val()
        };

    }
    function filterServices() {
        var categoryCode = $("#SubCategoryCode").val();
        var serviceGroup = $("#ServiceGroup").val();
        return {
            subCategoryCode: categoryCode,
            serviceGroup: serviceGroup
        };

    }
    function getSelectedCustomerId() {
        var dropdownlist = $("#PlateNo").data("kendoDropDownList");
        var filterInput = dropdownlist.filterInput;
        return {
            customerId: $("#OrganizationCustomerId").val(), filterText: filterInput.val()
        };
    }
    function mainGridDataBound(e) {
        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            if (dataItem.Status === "WaitingApproval" || dataItem.Status === "Waiting Approval" || dataItem.Status === "Waiting CRM Approval" || dataItem.Status === "Waiting Maintenance Approval") {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.addClass("k-state-waiting-approval");
            } else if (dataItem.Status === "Approved" || dataItem.Status === "Finance Approved") {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.addClass("k-state-Approved");
            } else if (dataItem.Status === "CRM Approved") {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.addClass("k-state-first-approved");
            } else if (dataItem.Status === "Maintenance Approved") {
                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.addClass("k-state-second-approved");
            }
            else if (dataItem.Status == "Rejected") {
                row.addClass("k-state-Rejected");
            }
            else {
                row.find(".k-grid-edit").show();
                row.find(".k-grid-delete").show();
            }
        }
    }
</script>
<script type="text/javascript">
    function sendForFirstApproval(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForFirstApproval", "PriceEstimationQuoteVoucher", new { area = "CRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                location.reload(true);
            }, 
            error: function (result) {
                alert(result);
            }
        });
    }
    function sendForSecondApproval(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForSecondApproval", "PriceEstimationQuoteVoucher", new { area = "CRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                location.reload(true);
            }, 
            error: function (result) {
                alert(result);
            }
        });
    }
    function sendForApproval(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "PriceEstimationQuoteVoucher", new { area = "CRM" })',
            data: { id: id },
            success: function (result) {
                alert(result.Message);
                location.reload(true);
            }, 
            error: function (result) {
                alert(result);
            }
        });
    }
    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "PriceEstimationQuoteVoucher", new {area = "CRM"})',
                data: { id: id },
                success: function (result) {
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                },
                error: function (result) {
                    alert(result);
                }
            });
        }
    }
</script>
