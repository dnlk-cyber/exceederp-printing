
@(Html.Kendo().Grid<ExceedERP.Core.Domain.CRM.Price>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.Thing);
     //   columns.Bound(c => c.PriceType);
        columns.Bound(c => c.Variety);
        columns.Bound(c => c.ReferenceType);
        columns.Bound(c => c.Reference);
        columns.Bound(c => c.Value);
        columns.Bound(c => c.IsDefault);
        columns.Bound(c => c.Priority);
        columns.Bound(c => c.Remark);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.PriceID))
          .Read(read => read.Action("Prices_Read", "Price"))
          .Create(create => create.Action("Prices_Create", "Price"))
          .Update(update => update.Action("Prices_Update", "Price"))
          .Destroy(destroy => destroy.Action("Prices_Destroy", "Price"))
      )
)
