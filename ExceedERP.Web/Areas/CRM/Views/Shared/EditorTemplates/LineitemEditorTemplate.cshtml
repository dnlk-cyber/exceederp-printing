                                                      .AutoBind(true)
                                                      .OptionLabel("Select")
                                                      .DataTextField("TaxName")
                                                      .Filter(FilterType.Contains)
                                                      .DataValueField("GLTaxRateID")
                                                      .DataSource(datasource =>
                                                      {
                                                          datasource.Read(read => read.Action("GetTaxList", "CRMDataProvider"))
                                                              .ServerFiltering(true);
                                                      })
                                                              .Events(e => e.Change("GetTaxValue")/*.Select("ClearValMsg")*/)
                    )

                    <div class="   alert-dismissable  alert-warning" id="TaxVal"></div>

                </div>
            </div>
        </div>

