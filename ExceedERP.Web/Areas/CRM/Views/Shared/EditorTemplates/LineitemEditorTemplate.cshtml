                                          read.Action("GetPriceTagDetailListVoucher", "CRMDataProvider")
                                              .Data("GetPriceTagDetailParameter");
                                      })
                                      .ServerFiltering(true);
                              })
                          .CascadeFrom("PriceTag")
                          .Events(e => e.Change("UpdatePriceChange").Select("ClearValMsg"))
                        )
                        <div class="   alert-dismissable   alert-warning" id="PriceTagDetailVal"></div>

                    </div>
                </div>
            </div>*@
        <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.UnitAmount)
                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.UnitAmount).Enable(true)
                                      .Name("UnitAmount").HtmlAttributes(new { @onchange = "GetTaxValue()", style = "font-weight:bold;font-family: sans-serif;" })
                    )

                    @Html.ValidationMessageFor(model => model.UnitAmount)
                </div>
            </div>
        </div>


        <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Quantity, htmlAttributes: new { style = "float:left;" })
                    <div style="float:left;"> [<label id="quantityLabel"></label>]</div>
                    <div style="float:right;" hidden id="otherUnitContainer">
                        <a href="\\#" onclick='return showConvertorTool()'><i class="fa fa-angle-double-down fa-1x"></i> Other Unit</a>
                    </div>
                </div>
                <div>
                    @(Html.Kendo().NumericTextBoxFor(model => model.Quantity)
                                                        .Decimals(4)
                                                        //.HtmlAttributes(new { style = "width:60%;" })
                                                        .Min(0)
                                                        .Events(x => x.Change("GetTaxValue")))
                    @*@Html.ValidationMessageFor(model => model.Quantity)*@
                    @*<div  style="width:30%; float:right">
                            @Html.Label("UoM")
                        </div>*@
                </div>

                <div class="alert-dismissable alert-warning" id="QuantityVal"></div>

            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.CalculatedCost)
                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.CalculatedCost)
                                      .Enable(false).HtmlAttributes(new { style = "font-weight:bold;font-family: sans-serif;" }))
                    @Html.ValidationMessageFor(model => model.CalculatedCost)
                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Discount)
                </div>
                <div>
                    @(Html.Kendo().NumericTextBoxFor(model => model.TaxAmount)
                                        .Name("Discount")
                                        .Decimals(4)
                                        .Events(ev =>
                                        {
                                            ev.Change("GetTaxValue");
                                        })
                                        .HtmlAttributes(new { @onchange = "GetTaxValue", style = "font-weight:bold;font-family: sans-serif;" }))
                    @Html.ValidationMessageFor(model => model.Discount)
                </div>
            </div>
        </div>
        
    </div>
    <div class="row">
        <div class="col-sm-1">
        </div>
        @*  <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.FreightCost)
                </div>
