                    @Html.ValidationMessageFor(model => model.TotalAmount)
                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.WithholdingType)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.WithholdingType)
                                      .AutoBind(true)
                                      .Filter(FilterType.Contains)
                                      .OptionLabel("Select")
                                              .DataTextField("TaxName")
                                                                      .DataValueField("GLTaxRateID")
                                      .DataSource(datasource =>
                                          {
                                              datasource.Read(read => read.Action("GetWithholdingTaxList", "CRMDataProvider"))
                                                  .ServerFiltering(true);
