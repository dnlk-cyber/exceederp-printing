@using Kendo.Mvc.UI
@model ExceedERP.Web.Areas.CRM.Models.LineItemViewModel
 
@*<form id="lineForm" method="post" onsubmit=" return ValidateInput();" onformchange="return ClearValMsg();">*@
<form method="post">
    <div class="row">
        <div class="col-sm-1">

        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.HiddenFor(model => model.LineItemID)
                    <input type="hidden" name="VoucherDefinitionId" id="VoucherDefinitionId" />
                    <input type="hidden" name="Voucher" id="Voucher" />
                    @Html.LabelFor(model => model.StoreID)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.StoreID)
                        .Name("StoreID")
                              .AutoBind(true)
                              .Filter(FilterType.Contains)
                              .OptionLabel("Select ")
                              .DataTextField("Name")
                              .DataValueField("StoreCode")
                              .DataSource(datasource =>
                              {
                                  datasource.Read(read => read.Action("GetStoreList", "CRMDataProvider").Data("getHeaderStoreId"))
                                      .ServerFiltering(true);
                              })//.Events(e => e.Select("ClearValMsg"))
                    )
                    <div class="   alert-dismissable   alert-warning" id="StoreVal"></div>
                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.ThingID)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.ThingID)
                        .Name("ThingID")
                        .Filter(FilterType.Contains)
                        .AutoBind(true)
                        .OptionLabel("Select ")
                        .DataTextField("Name")
                        .DataValueField("ProductID")
                        .DataSource(d =>
                        {
                            d.Read(r =>
                            {
                                r.Action("GetThingListByStore", "CRMDataProvider").Data("filterThing");
                            })
                                .ServerFiltering(true);
                        })
                        .Enable(false)
                        .AutoBind(false)
                        .CascadeFrom("StoreID")
                        .Events(e => e.Change("GetStockBalance")/*.Select("ClearValMsg")*/)
                    )
                    <div class="   alert-dismissable   alert-warning" id="ProductVal"></div>
                </div>
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Variety)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.Variety)
                        .Name("Variety")
                              .AutoBind(true)
                              .Filter(FilterType.Contains)
                              .OptionLabel("Select")
                              .DataTextField("Name")
                              .DataValueField("Name")
                              .DataSource(d =>
                                  {
                                      d.Read(r =>
                                          {
                                              r.Action("VarietyByInventoryDDBind", "Variety").Data("filterVariety");
                                          })
                                          .ServerFiltering(true);
                                  })
                              .Enable(false)

                                      .CascadeFrom("ThingID")
                              .Events(e => e.Change("GetStockBalance"))
                    )

                </div>
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.Class)
                </div>
                <div>
                    @(Html.Kendo().DropDownListFor(model => model.Class)
                        .Name("Class")
                              .AutoBind(true)
                              .Filter(FilterType.Contains)
                              .OptionLabel("Select")
                              .DataTextField("Name")
                              .DataValueField("Name")
                               .DataSource(d =>
                                  {
                                      d.Read(r =>
                                          {
                                              r.Action("ClassDDBind", "Variety");
                                          })
                                          .ServerFiltering(true);
                                  })
                              .Enable(false)
                              .CascadeFrom("ThingID")
                              .Events(e => e.Change("GetStockBalance"))
                    )
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-1 hidden-xs">
        </div>

        <div class="col-sm-2 col-xs-12">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.StockBalanceReserved)
                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.StockBalanceReserved)
                              .Enable(false).HtmlAttributes(new { style = "font-weight:bold;font-family: sans-serif;" }))
                    @Html.ValidationMessageFor(model => model.StockBalanceReserved)
                </div>
            </div>
        </div>

        <div class="col-sm-2">
            <br />
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.StockBalance)
                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.StockBalance)
                              .Enable(false).HtmlAttributes(new { style = "font-weight:bold;font-family: sans-serif;" })
                    )
                    @Html.ValidationMessageFor(model => model.StockBalance)
                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.ActualRemainingBalance)
                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.ActualRemainingBalance)
                              .Enable(false).HtmlAttributes(new { style = "font-weight:bold;font-family: sans-serif;" }))
                    @Html.ValidationMessageFor(model => model.ActualRemainingBalance)
                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <br />
            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.PriceTag)
                </div>
                <div>

                    @(Html.Kendo().DropDownListFor(model => model.PriceTag)
                                .OptionLabel("Select")
                                .Filter(FilterType.Contains)
                                .DataTextField("Text")
                                .DataValueField("Text")
                                //.BindTo(ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.CRM.Price_Types)))
                                .DataSource(datasource =>
                                {
                                    datasource.Read(read =>
                                    {
                                        read.Action("GetAssiggnedPriceTags", "CRMDataProvider")
                                            .Data("getSelectedProduct");
                                    })
                                        .ServerFiltering(true);
                                })
                              .CascadeFrom("ThingID")

                                .ValuePrimitive(true)
                              .Events(e => e.Change("UpdatePriceChange")/*.Select("ClearValMsg")*/)
                    )
                    <div class="   alert-dismissable   alert-warning " id="PriceTagVal"></div>

                </div>
            </div>
        </div>
    </div>
    <div class="row" id="unitConversionFormContainer" hidden>
        <div class="col-sm-1">
        </div>
        <div class="col-sm-9">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Unit Converter</legend>
                
                <div class="row">
                    <div class="col-sm-2">
                        <div class="form-group">
                            <div class="k-label">
                                @Html.LabelFor(model => model.OtherUoM)
                            </div>
                            <div>
                                @(Html.Kendo().DropDownListFor(model => model.OtherUoM)
                                                    .ValuePrimitive(true)
                                                    .HtmlAttributes(new { style="width:120px;"})
                                                    .OptionLabel("Select UoM")
                                                    .DataTextField("UoMName")
                                                    .DataValueField("UoMName")
                                                    .CascadeFrom("ThingID")
                                                    .Filter("contains")
                                                    .DataSource(dataSource =>
                                                    {
                                                        dataSource.Read(read => read.Action("GetPossibleConvertableUoMOfProduct", "CRMDataProvider").Data("getSelectedProduct")).ServerFiltering(true);
                                                    })
                                                    .Events(ev =>
                                                    {
                                                        ev.Change("onOtherUoMChange");
                                                    })
                                )

                            </div>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group">
                            <div class="k-label">
                                @Html.LabelFor(model => model.MultiplcationFactor)
                            </div>
                            <div>
                                @(Html.Kendo().TextBoxFor(model => model.MultiplcationFactor)
                                                    .HtmlAttributes(new { style = "width:120px;" })
                                                    .Enable(false))
                            </div>

                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group">
                            <div class="k-label">
                                @Html.LabelFor(model => model.QuantityInOtherUoM)
                            </div>
                            <div>
                                @(Html.Kendo().NumericTextBoxFor(model => model.QuantityInOtherUoM)
                                            .HtmlAttributes(new { style = "width:120px;" })
                                            .Decimals(4)
                                            .Events(e => 
                                            {
                                                e.Change("onQuantityInOtherUnitChange");
                                            })
                                            )
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group">
                            <div class="k-label">
                                @Html.LabelFor(model => model.Result)
                            </div>
                            <div>
                                @(Html.Kendo().TextBoxFor(model => model.Result)
                                    .HtmlAttributes(new { style = "width:120px;" })
                                    .Enable(false))
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-1">
        </div>
        @*<div class="col-sm-2">
                <div class="form-group">
                    <div class="k-label">
                        @Html.LabelFor(model => model.PriceTagDetail)
                    </div>
                    <div>
                        @(Html.Kendo().DropDownListFor(model => model.PriceTagDetail)
