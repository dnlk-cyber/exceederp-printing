            <div class="form-group">
                <div class="k-label">
                    @Html.LabelFor(model => model.TaxAmount)
                </div>
                <div>
                    @(Html.Kendo().TextBoxFor(model => model.TaxAmount).Name("TaxAmount")
                                                      .Enable(false).HtmlAttributes(new { style = "font-weight:bold;font-family: sans-serif;" }))
                    @Html.ValidationMessageFor(model => model.TaxAmount)
