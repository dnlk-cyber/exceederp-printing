
@(Html.Kendo().DropDownListFor(model => model)
    .HtmlAttributes(new { @class = "form-control" })
    .OptionLabel("Select")
    .DataTextField("Name")
    .DataValueField("ItemCode")
    .DataSource(d =>
    {
        d.Read(r =>
        {
            r.Action("GetItemByCategory", "CRMDataProvider").Data("filterItem");
        })
        .ServerFiltering(true);
    })
    .ValuePrimitive(true)
    .Enable(true)
    .AutoBind(true)

)