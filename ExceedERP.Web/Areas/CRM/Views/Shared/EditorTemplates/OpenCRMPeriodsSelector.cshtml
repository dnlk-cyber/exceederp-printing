@(Html.Kendo().DropDownListFor(m => m)
    .ValuePrimitive(true)
    .OptionLabel("Select Period...")
    .DataTextField("Name")
    .DataValueField("CRMPeriodId")
    .Filter("contains")
    .DataSource(dataSource =>
    {
        dataSource.Read(read => read.Action("GetOpenCRMPeriods", "CRMDataProvider", new { area = "CRM" }))
        .ServerFiltering(false);
    })
    .Events(ev => {
        ev.Change("onPeriodChange");
    })
)
@Html.ValidationMessageFor(m => m)