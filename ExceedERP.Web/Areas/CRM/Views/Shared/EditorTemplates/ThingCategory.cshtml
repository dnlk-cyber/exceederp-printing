@(Html.Kendo().DropDownListFor(m => m)
                  .AutoBind(false)
                  .OptionLabel("Select")
                  .DataTextField("Description")
                  .DataValueField("Code")
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetThingCategory", "CRMDataProvider"))
                                .ServerFiltering(true);
                  })

)
@Html.ValidationMessageFor(m => m)
