                                @*@item.CustomCommandToolBarButton("PDF", "<span class='k-icon k-i-pdf'></span>" + Resources.ActionButton_ExportPDF, "Pdf_Export_Save", "JobTitleMapping", "", new { @class = "k-button k-button-icontext k-grid-pdf  btn btn-primary btn-xs pull-right" });*@

                            </div>

                        </text>);
                            })

                                               .Excel(excel => excel
                                                  .FileName(Resources.Navigator_Company_JobTitleMapping + ".xlsx")
                                                     .Filterable(true)
                                                       .AllPages(true)
                                                                   //  .ProxyURL(Url.Action("Excel_Export_Save", "JobTitleMapping"))
                                                                   )
                                                            .Pdf(pdf => pdf
                                                               .AllPages()
                                                              .FileName(Resources.Navigator_Company_JobTitleMapping + ".pdf")
                                                                             // .ProxyURL(Url.Action("Pdf_Export_Save", "JobTitleMapping"))
                                                                             )
                                       .Editable(editable => editable.Mode(GridEditMode.InLine))//.TemplateName("JobTitleMapping").Window(window => { window.Title(Resources.Navigator_Company_JobTitleMapping); window.Scrollable(false); }))
