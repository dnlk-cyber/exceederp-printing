                                                              .Create(create => create.Action("LaboratoryDrugRequestItem_Create", "LaboratoryDrugRequestItem", new { idTwo = "#=LaboratoryDrugRequestId#" }))
                                                      .Update(update => update.Action("LaboratoryDrugRequestItem_Update", "LaboratoryDrugRequestItem"))
                                                      .Destroy(destroy => destroy.Action("LaboratoryDrugRequestItem_Destroy", "LaboratoryDrugRequestItem"))
                                                  ).ToClientTemplate()
                        )


                    </text>
            );

                            }).ToClientTemplate())
</script>
