@using System.Collections
@using ExceedERP.Core
@using ExceedERP.Core.Localization
@{


    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Import Excel</legend>
@(Html.Kendo().Grid<ImportExcel>()
                      .Name("DrugUnitgrid")
                  .Columns(columns =>
                  {

                      columns.Bound(c => c.Name);
                      columns.Bound(c => c.Age).Width(150);
                      columns.Command(command =>
                      {
                          command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                          command.Destroy().Text(Resources.ActionButton_Cancel);
                      }).Width(250);
                  })
                      .ToolBar(toolbar =>
                  {

                      toolbar.Template(@<text>

                       
                            @item.CreateButton()

    <form method="post" action='@Url.Action("ImportQuantitiesFromExcel")'>
        <div class="demo-section k-content">
            @(Html.Kendo().Upload()
                                            .Name("file")
                                            .Messages(msg =>
                                            {
                                                   msg.Select("Browse  Excel file ....");
                                                      })
            )
            <p style="padding-top: 1em; text-align: right">
                <input type="submit" value="Submit" class="k-button k-primary" />
            </p>
        </div>
    </form>


                    </text>);
                        })
                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                          .Scrollable(h => h.Height(500))


                                           .Groupable()
                                                    .Sortable(sortable =>
                                                    {
                                                        sortable.SortMode(GridSortMode.SingleColumn);
                                                    })
                                        .Filterable()
                                           .Pageable(pageable => pageable
                                                                      .Input(true)
                                                                      .Numeric(false)
                                                                      .Refresh(true)
                                                                      .PageSizes(true)
                                                                      .ButtonCount(5))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                                   .Events(events =>
                                   {
                                       events.Error("error_handler(\"DrugUnitgrid\")");
                                       events.RequestStart("onRequestStart(\"DrugUnitgrid\")");
                                       events.RequestEnd("onRequestEnd(\"DrugUnitgrid\")");
                                   }
                                )

                                .Model(model =>
                                {
                                    model.Id(p => p.ImportExcelId);
                                })
                            .Read(read => read.Action("DrugUnit_Read", "ImportExcel"))
                            .Create(create => create.Action("DrugUnit_Create", "ImportExcel"))
                            .Update(update => update.Action("DrugUnit_Update", "ImportExcel"))
                            .Destroy(destroy => destroy.Action("DrugUnit_Destroy", "ImportExcel"))
                        )
)
<script>

    function sync_handler(e) {
        this.read();
</script>



