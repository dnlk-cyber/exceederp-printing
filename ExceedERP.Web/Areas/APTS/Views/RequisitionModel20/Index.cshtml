                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;


                   // $("#OrgStructureId").val(r).trigger("change");;


                }



            });

        }
    }
</script>

<script>
    function GetBalance() {
        $("#BegStock").val(0);
        var DrugListId = $("#DrugListsId").data("kendoDropDownList");
        var drugList = DrugListId.value();

        if (drugList.length !== 0)
        {

        $.ajax({
            url: '@Url.Action("GetBalance", "RequisitionModel20")',

            data: { drugList: drugList},
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;

                var s = r.split(/-/);

                $("#BegStock").val(s[0]).trigger("change");
                $("#ReceivedQty").val(s[1]).trigger("change");
                //$("#Loss").val(s[2]).trigger("change");
                //$("#EndStock").val(s[3]).trigger("change");


                //$("#NoOfShouldBeStaff").val(r);
        }



        });

    }
    }

</script>

