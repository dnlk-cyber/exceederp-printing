@using System.Collections
@using ExceedERP.Core.Localization
@using ExceedERP.Helpers.Common
@using ExceedERP.Web.Areas.APTS
@using Kendo.Mvc.UI
@model ExceedERP.Core.Domain.APTS.RequisitionModel20

<div class="form">

    <div class="row fullrow">
        <div class="col-md-3 ro1">


            <div class="form-group">
                @Html.LabelFor(model => model.DrugListsId, htmlAttributes: new { @class = "control-label col-md-8" })

                @(Html.Kendo().DropDownListFor(model => model.DrugListsId)
                  .OptionLabel(Resources.Select)
                           .Filter("contains")
                           .MinLength(2)
                  .DataTextField("Description")
                  .DataValueField("DrugListsId")
                                  .DataSource(source =>
                                  {

                                      source.Read(read => read.Action("GetDrugLists", "RequisitionModel20"));


                                  })
                  // .BindTo((IEnumerable)ViewData["organization"])
                  .ValuePrimitive(true)

                )
                @Html.ValidationMessageFor(model => model.DrugListsId, "", new { @class = "text-danger" })
            </div>

