                                                              columns.ForeignKey(c => c.DrugUnitId, (IEnumerable)ViewData["UnitsList"], "DrugUnitId", "UoMName").EditorTemplateName("DrugUnits").Width(150).Title("Unit");
                                                              columns.Bound(c => c.BegStock).Title("Beg stok").Width(150);
                                                              columns.Bound(c => c.ReceivedQty).Width(100);
                                                              columns.Bound(c => c.Loss).Width(100);
                                                              columns.Bound(c => c.EndStock).Title("End Stock").Width(150);
                                                              columns.Bound(c => c.QtyRequested).Width(100);
                                                              columns.Bound(c => c.QtyApproved).Width(100);
