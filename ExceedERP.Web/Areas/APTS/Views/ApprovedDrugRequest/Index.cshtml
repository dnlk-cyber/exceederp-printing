<script>

    function sync_handler(e) {
        this.read();
</script>

<script>
        function SendForApproval(e) {

        var row = $(e.target).closest("tr");
            var grid = $("#DrugRequestgrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
            var id = dataItem.DrugRequestId;


        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("SendForApproval", "ApprovedDrugRequest")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    alert("successfully sent for approval");
                    $('#loading-image').hide();
                    //window.location.reload();
                    grid.dataSource.read();
                }
            });

        }
    }
</script>



<script>
        function Close(e) {


        var row = $(e.target).closest("tr");
            var grid = $("#DrugRequestgrid").data("kendoGrid");
        var dataItem = grid.dataItem(row);
            var id = dataItem.DrugRequestId;


        if (id.length !== 0 )
        {
            $('#loading-image').show();

            $.ajax({
                url: '@Url.Action("Close", "ApprovedDrugRequest")',

                data: { id: id},
                type: 'POST',
                cache: false,
                success: function (result) {
                    r = result;
                    //alert("successfully closed ");
                    if (r == "true") {
                        alert("The request is successfully closed");
                        $('#loading-image').hide();
                        grid.dataSource.read();
                    }
                    else {
                        alert("not closed");
                    }
                }



            });

        }
    }
</script>



<script>

    function onDataBound(e) {
        var rows = e.sender.tbody.children();

        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsSendForApproval === true) {
                row.find("#send").hide();                
            }
            if (dataItem.IsClosed === true) {
                row.find("#close").hide();

            }
            if (dataItem.IsSendForApproval === true && dataItem.IsConfirmed === false && dataItem.IsClosed === false) {

                row.css("background-color", "orange");
            }
            else if (dataItem.IsSendForApproval === true && dataItem.IsConfirmed === true && dataItem.IsClosed === true) {

                row.css("background-color", "darkgrey");

            }
            else if (dataItem.IsSendForApproval === true && dataItem.IsConfirmed === true && dataItem.IsClosed === false) {

                row.css("background-color", "lightgreen");

            }
            //var grid = $("#DrugRequestgrid").data("kendoGrid");
            //grid.refresh();
        }

    }

</script>