@using System.Collections
@using ExceedERP.Core.Domain.APTS
@using ExceedERP.Core.Localization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Approved Drug Requestes </legend>
@(Html.Kendo().Grid<DrugRequest>()
                  .Name("DrugRequestgrid")
              .Columns(columns =>
              {

                  columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "AmharicName").EditorTemplateName("Branch").Width(150).Title("Branch");
                  columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["FiscalYear"], "GlFiscalYearId", "Name").EditorTemplateName("Year").Width(120).Title("Year");

                  columns.Bound(c => c.RequestDateAm).EditorTemplateName("Calander").Width(120).Title("Request Date");
                  columns.Bound(c => c.IsSendForApproval).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsSendForApproval ? checked='checked' :'' # >").Width(120).Title("Is Sent?");
                  columns.Bound(c => c.IsConfirmed).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsConfirmed ? checked='checked' :'' # >").Width(120).Title("Is Signed?");
                  columns.Bound(c => c.IsClosed).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsClosed ? checked='checked' :'' # >").Width(120).Title("Is Closed?");

                  columns.Bound(c => c.Remark).Width(80);


                  columns.Command(command =>
                  {
                      //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);

                      command.Custom("l").IconClass("fa fa-send fa-2x").Text("&nbsp;").Click("SendForApproval").HtmlAttributes(new { @class = "btn btn-warning", @title = "Send for Approval", @id="send"});
                      command.Custom("ll").IconClass("fa fa-close fa-2x").Text("&nbsp;").Click("Close").HtmlAttributes(new { @class = "btn btn-danger", @title = "Close The Reqeust", @id = "close" });
                      //command.Custom("").Text("Complated").Click("completed");
                      //command.Destroy().Text(Resources.ActionButton_Cancel);
                  }).Width(300);
              })
              .ToolBar(toolbar =>
              {
                  //toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
              })
              .Editable(editable => editable.Mode(GridEditMode.InLine))//.TemplateName("Model22"))
                .Scrollable(h => h.Height(500))


                                 .Groupable()
                                          .Sortable(sortable =>
                                          {
                                              sortable.SortMode(GridSortMode.SingleColumn);
                                          })
                              .Filterable()
                               .Events(e =>
                               {
                                   e.DataBound("onDataBound");
                               })
                                 .Pageable(pageable => pageable
                                                            .Input(true)
                                                            .Numeric(false)
                                                            .Refresh(true)
                                                            .PageSizes(true)
                                                            .ButtonCount(5))
              .DataSource(dataSource => dataSource
                  .Ajax()
                    .Sort(sort => sort.Add("DateCreated").Descending())
                         .Events(events =>
                         {
                             events.Error("error_handler(\"DrugRequestgrid\")");
                             events.RequestStart("onRequestStart(\"DrugRequestgrid\")");
                             events.RequestEnd("onRequestEnd(\"DrugRequestgrid\")");
                         }
                      )

                      .Model(model =>
                      {
                          model.Id(p => p.DrugRequestId);
                          model.Field(p=>p.IsSendForApproval).Editable(false);
                          model.Field(p => p.IsConfirmed).Editable(false);
                          model.Field(p => p.IsClosed).Editable(false);

                      })
                  .Read(read => read.Action("ApprovedDrugRequest_Read", "ApprovedDrugRequest"))
              //.Create(create => create.Action("Model22AndRequisitions_Create", "Model22AndRequisitions"))
              .Update(update => update.Action("ApprovedDrugRequest_Update", "ApprovedDrugRequest"))
              //.Destroy(destroy => destroy.Action("Model22AndRequisitions_Destroy", "Model22AndRequisitions"))
              ).ClientDetailTemplateId("template")
)
<script id="template" type="text/kendo-tmpl">
