@using System.Collections
@using ExceedERP.Core.Domain.APTS
@using ExceedERP.Core.Localization
@using ExceedERP.Core.Domain.HRM.SelfCare
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Drug Requests</legend>
@(Html.Kendo().Grid<DrugRequest>()
                              .Name("DrugRequestgrid")
                          .Columns(columns =>
                          {

                              columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "AmharicName").EditorTemplateName("Branch").Width(150).Title("Branch");
                              columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["FiscalYear"], "GlFiscalYearId", "Name").EditorTemplateName("Year").Width(120).Title("Year");
                              columns.ForeignKey(c => c.StoreCode, (IEnumerable)ViewData["Stores"], "StoreCode", "Name").EditorTemplateName("StoresFromInventory").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100).Title("Store Code");

                              columns.Bound(c => c.RequestDateAm).EditorTemplateName("Calander").Width(120).Title("Request Date");
                              columns.Bound(c => c.IsConfirmed).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsConfirmed ? checked='checked' :'' # >").Width(80).Title("Is Signed?");
                              columns.Bound(c => c.IsClosed).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsClosed ? checked='checked' :'' # >").Width(80).Title("Is Closed?");

                              columns.Bound(c => c.Remark).Width(80);
                              columns.Command(command =>
                              {
                                  command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                      // command.Destroy().Text(Resources.ActionButton_Cancel);
                  }).Width(130);
                          })
                          .ToolBar(toolbar =>
                          {
                              toolbar.Template(@<text>
                                <div class="toolbar">



                                </div>

                            </text>);
                                })

                                                         .Excel(excel => excel
                                                            .FileName(Resources.Navigator_Company_JobTitleMapping + ".xlsx")
                                                               .Filterable(true)
                                                                 .AllPages(true)

                                                                             )
                                                                      .Pdf(pdf => pdf
                                                                         .AllPages()
                                                                        .FileName(Resources.Navigator_Company_JobTitleMapping + ".pdf")

                                                                                       )
                                                 .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                  .Events(events => events.DetailExpand("onDetailExpandUser"))
                                                  .Events(e =>
                                                  {
                                                      e.DataBound("onDataBound");
                                                      e.Save("GetDate");
                                                      e.Edit("GetDate");
                                                  })
                                                 .Scrollable(h => h.Height(500))
                                                .Groupable()
                                                            .Sortable(sortable =>
                                                            {
                                                                sortable.SortMode(GridSortMode.SingleColumn);
                                                            })
                                                           .Filterable()

                                                     .Pageable(pageable => pageable
                                                                      .Input(true)
                                                                        .Numeric(false)
                                                                         .Refresh(true)
                                                                       .PageSizes(true)
                                                                    .ButtonCount(5))
                                                        .DataSource(dataSource => dataSource
                                                            .Ajax()
                                                            .Sort(sort => sort.Add("DateCreated").Descending())
                                                                 .Events(events =>
                                                                 {

                                                                     events.Error("error_handler(\"DrugRequestgrid\")");
                                                                     events.RequestStart("onRequestStart(\"DrugRequestgrid\")");

                                                                     events.RequestEnd("onRequestEnd(\"DrugRequestgrid\")");
                                                                 })


                                                            .Model(model =>
                                                            {
                                                                model.Id(p => p.DrugRequestId);
                                                                model.Field(p => p.IsSendForApproval).Editable(false);
                                                                model.Field(p => p.IsConfirmed).Editable(false);
                                                                model.Field(p => p.IsClosed).Editable(false);
                                                                model.Field(p => p.BranchId).Editable(false);
                                                                model.Field(p => p.GlFiscalYearId).Editable(false);
                                                                model.Field(p => p.RequestDateAm).Editable(false);

                                                            })
                                                            .Read(read => read.Action("DrutRequestStatus_Read", "DrutRequestStatus"))
                                                            .Create(create => create.Action("DrutRequestStatus_Create", "DrutRequestStatus"))
                                                            .Update(update => update.Action("DrutRequestStatus_Update", "DrutRequestStatus"))
                                                            .Destroy(destroy => destroy.Action("DrutRequestStatus_Destroy", "DrutRequestStatus"))
                                                            ).ClientDetailTemplateId("template")
)
