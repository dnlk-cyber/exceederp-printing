<script>

    function GetDate() {

        $("#RequestDateAm").trigger("change");

    }
</script>

<script>

      function onDetailExpandUser(e) {
        var masterRow = e.masterRow;

          var masterGrid = $("#DrugRequestgrid").data("kendoGrid");

        var masterDataItem = masterGrid.dataItem(masterRow);

          masterId = masterDataItem.DrugRequestId;
        var gridName = "#RequestesStatusgrid_" + masterId;
        $.ajax({
            url: '@Url.Action("CheckStatus", "DrugRequest")',

            data: { masterId: masterId },
            type: 'POST',
            cache: false,
            success: function (result) {
                r = result;
                if (r == "true") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                }
                else if (r == "approved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else if (r == "Dapproved") {
                    $(gridName).find(".k-toolbar").hide(); //hide toolbar
                    $(".k-grid-top", gridName).hide();
                    $(".k-grid-edit", gridName).hide();
                    $(".k-grid-delete", gridName).hide();
                }
                else {
                    $(gridName).find(".k-toolbar").show(); //hide toolbar
                    $(".k-grid-top", gridName).show();
                }

            }

        });

    }

</script>

<script>

    function filterStore() {
        return {
            BranchId: $("#BranchId").val()
        };
    }


</script>

<script>
    function onDataBound(e) {

        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);

            if (dataItem.IsOnlineApproved === true) {

                row.find(".k-grid-edit").hide();
                //row.find(".k-grid-delete").hide();

                row.css("background-color", "lightgreen");
            }
            if (dataItem.IsClosed === true) {
                row.css("background-color", "gray");
            }
        }
    }
</script>

<script>
    function onDataBoundDetailSecondTab(e) {

            var rows = e.sender.tbody.children();

            for (var j = 0; j < rows.length; j++) {
                var row = $(rows[j]);
                var dataItem = e.sender.dataItem(row);
                if (dataItem.IsOnlineApproved === true) {
                    
                    row.find(".k-grid-edit").hide();
                    row.find(".k-grid-delete").hide();
                }

            }
        }
    </script>