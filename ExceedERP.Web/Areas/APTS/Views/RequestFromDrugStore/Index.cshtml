<legend>Request To Be Confirmed </legend>
@(Html.Kendo().Grid<DrugRequest>()
                          .Name("DrugRequestgrid")
                      .Columns(columns =>
                      {
                          columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "AmharicName").EditorTemplateName("Branch").Width(150).Filterable(ftb => ftb.Multi(true).Search(true)).Title("Branch");
                          columns.ForeignKey(c => c.GlFiscalYearId, (IEnumerable)ViewData["FiscalYear"], "GlFiscalYearId", "Name").EditorTemplateName("Year").Filterable(ftb => ftb.Multi(true).Search(true)).Width(120).Title("Year");

                          columns.Bound(c => c.RequestDateAm).EditorTemplateName("Calander").Width(120).Title("Request Date");
                          columns.Bound(c => c.IsSendForApproval).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsSendForApproval ? checked='checked' :'' # >").Width(120).Title("Is Sent?");
                          columns.Bound(c => c.IsConfirmed).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsConfirmed ? checked='checked' :'' # >").Width(120).Title("Is Signed?");
                          columns.Bound(c => c.IsClosed).ClientTemplate("<input type='checkbox' disabled = 'true' #=IsClosed ? checked='checked' :'' # >").Width(120).Title("Is Closed?");
                          columns.Bound(c => c.Remark).Width(80);


                          columns.Command(command =>
                          {
                  //command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);

                  command.Custom("l").IconClass("fa fa-check fa-2x").Text("&nbsp;").Click("Confirmation").HtmlAttributes(new { @class = "btn btn-success", @title = "Sign to confrim drug request", @id = "confirm" });
                          }).Width(300);
                      })
                      .ToolBar(toolbar =>
                      {
              //toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
          })
                      .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .Scrollable(h => h.Height(500))


                                         .Groupable()
                                                  .Sortable(sortable =>
                                                  {
                                                      sortable.SortMode(GridSortMode.SingleColumn);
                                                  })
                                      .Filterable()
                                       .Events(e =>
                                       {
                                           e.DataBound("onDataBound");
                                       })
                                         .Pageable(pageable => pageable
                                                                    .Input(true)
                                                                    .Numeric(false)
                                                                    .Refresh(true)
                                                                    .PageSizes(true)
                                                                    .ButtonCount(5))
                      .DataSource(dataSource => dataSource
                          .Ajax()
                            .Sort(sort => sort.Add("DateCreated").Descending())
                                 .Events(events =>
                                 {
                                     events.Error("error_handler(\"DrugRequestgrid\")");
                                     events.RequestStart("onRequestStart(\"DrugRequestgrid\")");
                                     events.RequestEnd("onRequestEnd(\"DrugRequestgrid\")");
                                 }
                              )

                              .Model(model =>
                              {
                                  model.Id(p => p.DrugRequestId);

                              })
                          .Read(read => read.Action("RequestFromDrugStore_Read", "RequestFromDrugStore"))
