<script>

    function onDataBound(e) {
        

        var grid = this;
        var gridRows = grid.tbody.find("tr");
        for (var i = 0; i < gridRows.length; i++) {
            var row = $(gridRows[i]);
            var dataItem = grid.dataItem(row);
            //perform your custom check
            if (dataItem.IsDone === true && dataItem.IsAllDeducted === true) {

                row.find(".k-grid-edit").hide();
                row.find(".k-grid-delete").hide();
                row.find("#done").hide();
                // row.find(".k-grid-Done").hide();.IconClass("fa fa-check")
                //row.find(".k-grid-Done").text('ይከፈት');
                // row.find(".k-grid-Done").text("");
            } else {

                row.css("background-color", "yellow");
            }
        }
    }

</script>
<script>
        function onDataBoundDetail(e) {
            var rows = e.sender.tbody.children();

            for (var j = 0; j < rows.length; j++) {
                var row = $(rows[j]);
                var dataItem = e.sender.dataItem(row);
                if (dataItem.IsUpdated === false) {

                    row.css("background-color", "yellow");

                }
                else {
                    row.css("background-color", "gray");
                    row.find(".k-grid-edit").hide();
                    row.find(".k-grid-delete").hide();
                }

            }
        }
</script>