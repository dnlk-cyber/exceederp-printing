              })
              .Editable(editable => editable.Mode(GridEditMode.InLine))
                 .Events(events => events.DetailExpand("onDetailExpandUser"))
                
                .Scrollable(h => h.Height(500))


                                 .Groupable()
                                          .Sortable(sortable =>
                                          {
                                              sortable.SortMode(GridSortMode.SingleColumn);
                                          })
                              .Filterable()
                               .Events(x =>
                               {
                                   x.Edit("GetDate");
                                   x.Save("GetDate");
                               })
                                 .Pageable(pageable => pageable
                                                            .Input(true)
                                                            .Numeric(false)
                                                            .Refresh(true)
                                                            .PageSizes(true)
                                                            .ButtonCount(5))
              .DataSource(dataSource => dataSource
                  .Ajax()
                        .Sort(sort => sort.Add("ReceivingDate").Descending())
                         .Events(events =>
                         {
                             events.Error("error_handler(\"DrugReceivalModel19grid\")");
                             events.RequestStart("onRequestStart(\"DrugReceivalModel19grid\")");
                             events.RequestEnd("onRequestEnd(\"DrugReceivalModel19grid\")");
                         }
                      )

                      .Model(model =>
                      {
                          model.Id(p => p.DrugReceivalModel19Id);
                      })
                  .Read(read => read.Action("DrugReceivalModel19_Read", "DrugReceivalModel19"))
                  .Create(create => create.Action("DrugReceivalModel19_Create", "DrugReceivalModel19"))
                  .Update(update => update.Action("DrugReceivalModel19_Update", "DrugReceivalModel19"))
                  .Destroy(destroy => destroy.Action("DrugReceivalModel19_Destroy", "DrugReceivalModel19"))
              ).ClientDetailTemplateId("templates")
)

