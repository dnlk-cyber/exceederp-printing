<legend>Drug Receival Form</legend>
@(Html.Kendo().Grid<DrugReceivalModel19>()
                  .Name("DrugReceivalModel19grid")
              .Columns(columns =>
              {
                  //columns.ForeignKey(c => c.DrugListsId, (IEnumerable)ViewData["druglists"], "DrugListsId", "InternalDrugCode").Width(200).Title("Internal Code");
                  columns.Bound(c => c.DrugReceivalModel19Id).Visible(false);
                  columns.ForeignKey(c => c.DrugStoreId, (IEnumerable)ViewData["Store"], "DrugStoreId", "NameWithCode").EditorTemplateName("DrugStores").Width(200).Title("Store Code");

                  columns.Bound(c => c.ReceivingDateAmh).EditorTemplateName("Calander").Width(150).Title("Receive Date");
                  //columns.Bound(c => c.Remark).Width(200);
                  columns.Command(command =>
                  {
                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
