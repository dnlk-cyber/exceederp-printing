                                         .Events(events =>
                                         {
                                             events.Error("error_handler(\"DrugInnerTransfergrid\")");
                                             events.RequestStart("onRequestStart(\"DrugInnerTransfergrid\")");
                                             events.RequestEnd("onRequestEnd(\"DrugInnerTransfergrid\")");
