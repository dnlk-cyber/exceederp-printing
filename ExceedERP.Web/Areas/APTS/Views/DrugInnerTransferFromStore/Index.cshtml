<script>
    var DrugStoreTransferId = 0;

    function AddTransferDrugs(e) {
        try {

            var row = $(e.target).closest("tr");
            var grid = $("#DrugInnerTransfergrid").data("kendoGrid");
            var dataItem = grid.dataItem(row);
            DrugStoreTransferId = dataItem.DrugStoreTransferId;

            var popGrid = $("#TransferDrugGrid").data("kendoGrid");
            popGrid.dataSource.read();

            var wnd = $("#TransferToStoreWindow").data("kendoWindow");

            var windowOptions = wnd.options;

            wnd.wrapper.css({
                left: 256,
                top: 130
            });

            wnd.open();

            wnd.wrapper.css({
                width: 900,
                height: 400
            });


        } catch (ex) {
            alert("Please select the row!!");
        }
    }

    ///////////////////////////////
    function filterData() {
        storeTransferId = DrugStoreTransferId;
        return {

            storeTransferId: DrugStoreTransferId
        };
    }

</script>

<script>
    function SendData() {
       var conf = confirm("Are you sure you want to Transfer this drugs ?");
        if (conf === true) {
            var grid = $("#TransferedItem").data("kendoGrid");
            if (DrugListsId.length !== 0 && DrugUnitId.length !== 0) {

                $.ajax({
                    url: '@Url.Action("TransferDrugToOtherStore", "DrugTransferTemporaryItems")',

                    data: { DrugStoreTransferId: DrugStoreTransferId },
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        r = result;
                        alert(r.Message);
                        //$('#loading-image').hide();
                        grid.dataSource.read();
                    }
                });

            }
        }
    }
</script>


