<legend>Drug Inner Transfer From Store</legend>
@(Html.Kendo().Grid<DrugStoreTransfer>()
                                  .Name("DrugInnerTransfergrid")
                              .Columns(columns =>
                              {
                                  columns.ForeignKey(c => c.BranchId, (IEnumerable)ViewData["Branch"], "BranchId", "Name").EditorTemplateName("Branch").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200).Title("Branch");
                                  columns.ForeignKey(c => c.FromDrugStoreId, (IEnumerable)ViewData["DrugStores"], "DrugStoreId", "NameWithCode").EditorTemplateName("DrugStores").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200).Title("From Store");
                                  columns.ForeignKey(c => c.ToDrugStoreId, (IEnumerable)ViewData["DrugStores"], "DrugStoreId", "NameWithCode").EditorTemplateName("DrugStores").Filterable(ftb => ftb.Multi(true).Search(true)).Width(200).Title("To Store");

                                  columns.Command(command =>
                                  {
                                      command.Edit().UpdateText(Resources.ActionButton_Update).CancelText(Resources.ActionButton_CancelUpdate).Text(Resources.ActionButton_Edit);
                                      command.Destroy().Text(Resources.ActionButton_Cancel);
                                      command.Custom("tras").Text("&nbsp;").IconClass("fa fa-plus fa-2x").HtmlAttributes(new { @class = "btn btn-success", @title = "Add Drugs To Transfer", @id = "transfertostorid" }).Click("AddTransferDrugs");
                                  }).Width(250);
                              })
                              .ToolBar(toolbar =>
                              {
                                  toolbar.Create().Text(Resources.ActionButton_AddNewRecord);
                              })
                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                                .Scrollable(h => h.Height(500))


                                                 .Groupable()
                                                          .Sortable(sortable =>
                                                          {
                                                              sortable.SortMode(GridSortMode.SingleColumn);
                                                          })
