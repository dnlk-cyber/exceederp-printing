                                      )

                                      .Model(model =>
                                      {
                                          model.Id(p => p.DrugStoreTransferId);
                                      })
                                  .Read(read => read.Action("DrugInnerTransferFromStore_Read", "DrugInnerTransferFromStore"))
                                  .Create(create => create.Action("DrugInnerTransferFromStore_Create", "DrugInnerTransferFromStore"))
                                  .Update(update => update.Action("DrugInnerTransferFromStore_Update", "DrugInnerTransferFromStore"))
                                  .Destroy(destroy => destroy.Action("DrugInnerTransferFromStore_Destroy", "DrugInnerTransferFromStore"))
                              ).ClientDetailTemplateId("template")
)
