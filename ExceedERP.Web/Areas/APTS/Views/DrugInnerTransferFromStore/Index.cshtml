<script>
    function onDataBoundPopUpWindow(e) {

        var rows = e.sender.tbody.children();
        var gridName = $("#TransferDrugGrid").data("kendoGrid");
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.HaveNoBalance === true) {
                row.css("background-color", "yellow");
            }           

        }
    }

</script>
