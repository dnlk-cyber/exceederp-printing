
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Procurement.Supplier.SupplierRemoveBlackList>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Description);
          columns.Bound(c => c.DateBlackListed);
          columns.Bound(c => c.ClearedOn);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.Status);
          columns.Bound(c => c.IsOnlineApproved);
          columns.Bound(c => c.OnlineApprovedBy);
          columns.Bound(c => c.OnlineApprovedTime);
          columns.Bound(c => c.isVoid);
          columns.Bound(c => c.VoidBy);
          columns.Bound(c => c.VoidTime);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.SupplierRemoveBlackListId))
          .Read(read => read.Action("SupplierRemoveBlackLists_Read", "SupplierRemoveBlackList"))
          .Create(create => create.Action("SupplierRemoveBlackLists_Create", "SupplierRemoveBlackList"))
          .Update(update => update.Action("SupplierRemoveBlackLists_Update", "SupplierRemoveBlackList"))
          .Destroy(destroy => destroy.Action("SupplierRemoveBlackLists_Destroy", "SupplierRemoveBlackList"))
      ))
