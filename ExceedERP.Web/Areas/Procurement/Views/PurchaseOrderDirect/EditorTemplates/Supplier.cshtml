@using Kendo.Mvc.UI

@(Html.Kendo().DropDownListFor(m => m)
                  .AutoBind(false)
                  .OptionLabel("...Select Supplier...")
                  .DataTextField("Name")
                  .DataValueField("ProcurementSupplierID")
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetSuppliers", "Supplier"))
                                .ServerFiltering(true);
                  }) 
)
@Html.ValidationMessageFor(m => m)
