@helper PurchasePaymentFileUpload()
{
    @(Html.Kendo().Grid<ExceedERP.Core.Domain.Procurement.PaymentRequest.PurchasePaymentAttachment>()
                  .Name("Purchasedocument_#=PurchasePaymentId#")
                  .Columns(columns =>
                  {
                      columns.Bound(c => c.FileName).ClientTemplate("<a href='/PurchasePaymentDocument/FileDwonload?id=\\#=PurchasePaymentAttachmentId \\#'>\\#=FileName \\#</a>").Width(200);
                      columns.Command(command => { command.Edit(); command.Destroy(); }).Width(580);
                  })
                  .ToolBar(t => t.Template(
                    @<text>
                        @(Html.Kendo().Upload()
                                      .Name("PurchasePaymentDocuments")
                                      .Async(a => a.Save("PurchasePaymentAttachments_Create", "PurchasePaymentDocument", new { id = "#=PurchasePaymentId #" }))
                                      .Events(e => e.Complete("PurchasePaymentAttachementSuccess"))
                                      .ShowFileList(false)
                                      .ToClientTemplate())
                    </text>
                                ))

                            .Editable(editable => editable.Mode(GridEditMode.InLine))
                            .HtmlAttributes(new { style = "height: 350px;" })
                            .Scrollable()
                            .Events(x => x.DataBound("onDataBoundFisrtValidation"))
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Events(ev => ev
                                    .Error("error_handler(\"Purchasedocument_#=PurchasePaymentId#\")")
                                    .RequestStart("onRequestStart(\"Purchasedocument_#=PurchasePaymentId#\")")
                                    .RequestEnd("onRequestEnd(\"Purchasedocument_#=PurchasePaymentId#\")"))
                                .Model(model => model.Id(p => p.PurchasePaymentAttachmentId))
                                .Read(read => read.Action("PurchasePaymentAttachments_Read", "PurchasePaymentDocument", new { id = "#= PurchasePaymentId #" }))
                                .Create(create => create.Action("PurchasePaymentAttachments_Create", "PurchasePaymentDocument", new { id = "#=PurchasePaymentId #" }))
                                .Update(update => update.Action("PurchasePaymentAttachments_Update", "PurchasePaymentDocument"))
                                .Destroy(destroy => destroy.Action("PurchasePaymentAttachments_Destroy", "PurchasePaymentDocument"))
                            ).ToClientTemplate())
}


<script>


    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "PurchasePayment", new { area = "Procurement" })',
            data: { id: id },
            success: function(result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function(result) {
                alert(result);
            }
        });
    }

   

   

    


    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    var isapproved;
    var issecondapproved;
    var isSendForApproval;
    var isOnlineTransferred;
    var nextApprover;

    function detailExpandMasterNew(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.PurchasePaymentId;
        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;
        nextApprover = masterDataItem.ForwardedTo;

    }
    function onDataBoundMasterNew(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved || gridData[i].IsSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsSendForApproval && !dataItem.IsOnlineApproved) {
                row.css("background-color", "lightgreen");
            }
            if (!dataItem.IsSendForApproval && !dataItem.IsOnlineApproved) {
                row.css("background-color", "lightskyblue");
            }

            if (dataItem.IsBudgetApproved) {
                row.css("background-color", "gold");
            }

            if (dataItem.Paid) {
                row.css("background-color", "honeydew");
            }

            if (dataItem.IsVoid) {
                row.css("background-color", "slategray");
                row.css("color", "black");
            }
        }


    }
    function onDataBoundLineNew(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionItem_" + codeid;
        if (isapproved || isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundValidationNew(e) {
        var currentUser=@Html.Raw(Json.Encode(User.Identity.Name));


        var detailGrid = "#" + e.sender.element[0].id;

        if (isapproved || !isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        if (nextApprover !== currentUser) {
            $(".k-grid-add", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }
    

 
    

    function filterInventoryItems() {

        return {
            itemCategoryCode: $("#ItemCategoryCode").data("kendoDropDownList").value()
        };
    }

    function filterSuppliers() {
        return { id: $("#PurchaseOrderID").data("kendoDropDownList").value() }
    }


    function isNewSupplier(obj) {

        if ($(obj).is(":checked")) {
            $("#supplierNameDiv").show();

        } else {
            $("#supplierNameDiv").hide();
        }

    }






    function PurchaseAttachementSuccess(e) {
        var gridname = "#Purchasedocument_" + codeid;
        $(gridname).data("kendoGrid").dataSource.read();
    }


    function PurchasePaymentAttachementSuccess(e) {
        //var gridname = "#Purchasedocument_" + codeid;
        //$(gridname).data("kendoGrid").dataSource.read();
    }



    function getPurchaseId() {
        //alert(codeid);
        return {
            id: codeid,
            type:$("#ItemType").data("kendoDropDownList").value()
        }

    }

    function getPoOrContractId() {
        //alert(codeid);
        return {           
            type: $("#Type").data("kendoDropDownList").value(),
            text: $("#PoOrContractNumber").data("kendoDropDownList").filterInput.val()
        }

    }

   


    function onSelectSourPoOrContract(e) {
        //alert("change");
        var type = $("#Type").data("kendoDropDownList").value();
        var paymenttype = $("#PaymentType").data("kendoDropDownList").value();
        var id = $("#PoOrContractNumber").data("kendoDropDownList").value();

        // alert(id);
        //begin
        $.ajax({
            url: '/Procurement/ProcurementDataProvider/GetPoContractData',
            type: 'GET',
            data: { id: id, type: type, paymenttype: paymenttype},
            success: function (result) {
                $("#PaymentAmount").val(result.PaymentAmount).trigger("change");
                $("#NetPayable").val(result.PaymentAmount).trigger("change");
                $("#SupplierId").val(result.SupplierId).trigger("change");
                $("#SupplierName").val(result.SupplierName).trigger("change");

            }, //end succ
            error: function (result) {
                alert(result);
            }
        }); //end post
        //end
    }
    

    

    function applyPenalty(obj) {

        if ($(obj).is(":checked")) {
            var amount = $("#PaymentAmount").val();
            var penalty = $("#PenalityAmount").val();
            var net = amount - penalty;
            $("#NetPayable").val(net).trigger("change");        

        } else {
            var amount = $("#PaymentAmount").val();          
            $("#NetPayable").val(amount).trigger("change");
        }

    }
    //not used
    function serviceChargeChange(servicechargeObj) {      

        var serviceChargePercent = servicechargeObj.value;
        var type = $("#Type").data("kendoDropDownList").value();
        var paymenttype = $("#PaymentType").data("kendoDropDownList").value();
        var id = $("#PoOrContractNumber").data("kendoDropDownList").value();

        $.ajax({
            url: '/Procurement/ProcurementDataProvider/GetPoDataWithServiceCharge',
            type: 'GET',
            data: { id: id, type: type, paymenttype: paymenttype, serviceCharge: serviceChargePercent },
            success: function (result) {
                $("#PaymentAmount").val(result.PaymentAmount).trigger("change");              
                $("#NetPayable").val(result.PaymentAmount).trigger("change");
                $("#SupplierId").val(result.SupplierId).trigger("change");
                $("#SupplierName").val(result.SupplierName).trigger("change");

            }, //end succ
            error: function (result) {
                alert(result);
            }
        }); //end post
//end

    }

    
</script>



