@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Inventory
@using ExceedERP.Helpers.Common
@model ExceedERP.Core.Domain.Procurement.PaymentRequest.PurchasePayment

@Html.HiddenFor(model => model.PurchasePaymentId)

<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1">


            <div class="form-group">
                @Html.LabelFor(model => model.PaymentType, "Payment Type", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">

                    @(Html.Kendo().DropDownListFor(model => model.PaymentType)
                                    .ValuePrimitive(true)
                                    .OptionLabel("Select Type...")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .BindTo(EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.Procurement.Settings.PaymentType)))
                    )

                    @Html.ValidationMessageFor(model => model.PaymentType, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.Type, "Source Type", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.Type)
                                                          .ValuePrimitive(true)
                                                          .OptionLabel("Select Source ...")
                                                          .DataTextField("Name")
                                                          .DataValueField("Code")
                                                          .Filter("contains")
                                                          .DataSource(dataSource =>
                                                          {
                                                              dataSource.Read(read => read.Action("GetPurchaseTypes", "FinanceDataProvider", new { area = "Finance" }))
                                                                  .ServerFiltering(false);
                                                          })
                    )
                    @Html.ValidationMessageFor(model => model.Type, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.PoOrContractNumber, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.PoOrContractNumber)

                                                                    .OptionLabel("Select...")
                                                                    .Filter("contains")
                                                                    .DataTextField("Name")
                                                                    .DataValueField("Code")
                                                                    .CascadeFrom("Type")
                                                                    //.HtmlAttributes(new { style = "width:200px" })
                                                                    .DataSource(dataSource =>
                                                                    {
                                                                        dataSource.Read(read => read.Action("GetPOorContractForPaymentRequests", "FinanceDataProvider", new { area = "Finance" }).Data("getPoOrContractId"))
                                                                            .ServerFiltering(true);
                                                                    })
                                                    .Events(e =>
                                                    {
                                                        e.Change("onSelectSourPoOrContract");
                                                    })
                    )
                    @Html.ValidationMessageFor(model => model.PoOrContractNumber, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.SupplierId, "Supplier ID", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.SupplierId).HtmlAttributes(new { @disabled = "disabled" })
                    @Html.ValidationMessageFor(model => model.SupplierId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.SupplierName, "Supplier Name", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.SupplierName).HtmlAttributes(new { @disabled = "disabled" })
                    @Html.ValidationMessageFor(model => model.SupplierName, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            @Html.LabelFor(model => model.SupplierInvoice, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-6">
                @Html.Kendo().TextBoxFor(model => model.SupplierInvoice)
                @Html.ValidationMessageFor(model => model.SupplierInvoice, "", new { @class = "text-danger" })
            </div>

            <div class="row"></div>

            @*<br />

        <div class="col-md-6">
            @Html.Kendo().CheckBoxFor(model => model.WithOutGRN).HtmlAttributes(new { @class = "control-label col-md-8" })
            @Html.ValidationMessageFor(model => model.WithOutGRN, "", new { @class = "text-danger" })
        </div>
        <div class="row"></div>*@

        </div>

        <div class="col-md-3 ro1">


            <div class="form-group">
                @Html.LabelFor(model => model.Date, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().DatePickerFor(model => model.Date)
                    @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>


            @Html.LabelFor(model => model.PurposeOfPayment, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-6">
                @Html.Kendo().TextBoxFor(model => model.PurposeOfPayment)
                @Html.ValidationMessageFor(model => model.PurposeOfPayment, "", new { @class = "text-danger" })
            </div>

            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.ProcurementOfficer, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.ProcurementOfficer)
                                .ValuePrimitive(true)
                                .OptionLabel("Select Purchaser ...")
                                .DataTextField("Name")
                                .DataValueField("Code")
                                .Filter("contains")
                                .DataSource(dataSource =>
                                {
                                    dataSource.Read(read => read.Action("GetPurchasers", "ProcurementDataProvider", new { area = "Procurement" }))
                                    .ServerFiltering(false);
                                })
                    )
                    @Html.ValidationMessageFor(model => model.ProcurementOfficer, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.ForBranchId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.ForBranchId)
                       .ValuePrimitive(true)
                       .OptionLabel("Select Branch...")
                       .DataTextField("Name")
                       .DataValueField("Code")
                       .Filter("contains")
                       .DataSource(dataSource =>
                       {
                           dataSource.Read(read => read.Action("GetAllBranches", "GlobalDataProvider", new { area = "Common" }))
                               .ServerFiltering(false);
                       })
                     )
                    @Html.ValidationMessageFor(model => model.ForBranchId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            @Html.LabelFor(model => model.PaymentAmount, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-6">
                @Html.Kendo().TextBoxFor(model => model.PaymentAmount)@*.HtmlAttributes(new { @disabled = "disabled" })*@
                @Html.ValidationMessageFor(model => model.PaymentAmount, "", new { @class = "text-danger" })
            </div>

            <div class="row"></div>


        </div>

        <div class="col-md-3 ro1">          

            @Html.LabelFor(model => model.PenalityAmount, htmlAttributes: new { @class = "control-label col-md-8" })
        <div class="col-md-6">
            @Html.Kendo().TextBoxFor(model => model.PenalityAmount)
            @Html.ValidationMessageFor(model => model.PenalityAmount, "", new { @class = "text-danger" })
        </div>

        <div class="row"></div>

         <br />
        <div class="col-md-8">
            @Html.Kendo().CheckBoxFor(model => model.ApplyPenality).HtmlAttributes(new { onchange = "applyPenalty(this)" })
            @Html.ValidationMessageFor(model => model.ApplyPenality, "", new { @class = "text-danger" })
        </div>

            @Html.LabelFor(model => model.ServiceCharge, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-6">
                @Html.Kendo().TextBoxFor(model => model.ServiceCharge)@*.HtmlAttributes(new { onchange = "serviceChargeChange(this)" })*@
                @Html.ValidationMessageFor(model => model.ServiceCharge, "", new { @class = "text-danger" })
            </div>

            <div class="row"></div>

            @Html.LabelFor(model => model.OtherPayment, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-6">
                @Html.Kendo().TextBoxFor(model => model.OtherPayment)
                @Html.ValidationMessageFor(model => model.OtherPayment, "", new { @class = "text-danger" })
            </div>

            <div class="row"></div>

            @Html.LabelFor(model => model.NetPayable, htmlAttributes: new { @class = "control-label col-md-8" })
            <div class="col-md-6">
                @Html.Kendo().TextBoxFor(model => model.NetPayable)@*.HtmlAttributes(new { @disabled = "disabled" })*@
                @Html.ValidationMessageFor(model => model.NetPayable, "", new { @class = "text-danger" })
            </div>

            <div class="row"></div>           

            <div class="form-group">
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Remark)
                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row">

            </div>

        </div>


        </div>
</div>
