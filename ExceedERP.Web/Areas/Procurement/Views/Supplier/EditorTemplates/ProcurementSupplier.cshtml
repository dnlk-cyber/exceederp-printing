@model ExceedERP.Core.Domain.Procurement.Supplier.ProcurementSupplier

<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1">

            <div class="form-group">
                @Html.LabelFor(model => model.Category, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @*@Html.Kendo().TextBoxFor(model => model.ItemCategory)*@
                    @(Html.Kendo().DropDownListFor(model => model.Category)
                        .ValuePrimitive(true)
                        .OptionLabel("Select category...")
                        .DataTextField("Category")
                        .DataValueField("Category")
                        .DataSource(dataSource =>
                            {
                                dataSource.Read(read => read.Action("GetSupplierCategories", "Supplier"));
                            })
                    )
                    @Html.ValidationMessageFor(model => model.Category, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Name)
                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                </div>
            </div>
           
            <div class="row"></div>
            
            <div class="form-group">
                @Html.LabelFor(model => model.SupplierId, htmlAttributes: new { @class = "control-label col-md-6" })
