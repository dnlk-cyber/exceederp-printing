                @Html.LabelFor(model => model.AccountCode, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    <div class="popupwrapper">
                        @Html.Kendo().TextBoxFor(model => model.AccountCode).HtmlAttributes(new {disabled = "disabled"}) <img src="~/Content/Images/search.png" onclick="SelectAccCode(this)"/>
                    </div>

                </div>
            </div>
            <div class="row"></div>

        </div>

        <div class="col-md-3 ro1">
            <div class="form-group">
