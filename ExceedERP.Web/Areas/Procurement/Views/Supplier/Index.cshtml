@using ExceedERP.Core.Domain.Procurement.Supplier
<legend>Suppliers</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Procurement.Supplier.ProcurementSupplier>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Category).Width(200);
          columns.Bound(c => c.SupplierId).Width(100);
          columns.Bound(c => c.Name).Width(200);
          columns.Bound(c => c.AccountCode).EditorTemplateName("AccountCode").Width(120);
          columns.Bound(c => c.TradeLicense).Width(130);
          columns.Bound(c => c.TIN).Width(100);
          columns.Bound(c => c.Telephone).Title("Phone").Width(90);
          columns.Bound(c => c.IsForShortList).Title("Short List ?").Width(100).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= IsForShortList#' " +
              "# if (IsForShortList) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.IsActive).Title("Is Active ?").Width(100).ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= IsActive#' " +
              "# if (IsActive) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );


          //columns.Bound(c => c.Remark).Width(120);
          //columns.Bound(c => c.Rank).Width(150);
          columns.Bound(c => c.OrgBranchName).Width(200).Hidden(true);
          columns.Bound(c => c.DateCreated).Width(200).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.LastModified).Width(200).Format("{0:dd/MM/yyyy}").Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(200).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(200).Hidden(true);

          columns.Command(command =>
          {
              command.Edit();// command.Destroy();
              command.Custom("Short List").Click("Shortlist");
          }).Width(300);
      })
      .HtmlAttributes(new { style = "height: 550px;" })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
          // toolbar.Excel();
          //toolbar.Pdf();
          // toolbar.Custom().Name("BlackList").Action("index", "ProcurementSupplier", new { id = bool.TrueString }).HtmlAttributes(new { @onclick = "reloadblacklist()", @class = "btn .btn-primary" });
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ProcurementSupplier").Window(w => w.Title("Procurement Supplier")).Window(w => w.HtmlAttributes(new { @style = "width:1000px;" })))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()

      .ClientDetailTemplateId("templates")
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ProcurementSupplierID").Descending())
          .PageSize(20)
          .Model(
              model =>
              {
                  model.Id(p => p.ProcurementSupplierID);
                  model.Field(p => p.TCode).Editable(false);
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.Rank).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
              })
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("ProcurementSuppliers_Read", "Supplier", new { id = bool.FalseString }))
          .Create(create => create.Action("ProcurementSuppliers_Create", "Supplier"))
          .Update(update => update.Action("ProcurementSuppliers_Update", "Supplier"))
          .Destroy(destroy => destroy.Action("ProcurementSuppliers_Destroy", "Supplier"))
      ))


