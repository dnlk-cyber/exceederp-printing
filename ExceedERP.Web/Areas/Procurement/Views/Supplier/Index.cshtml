    function onGridDataSourceRequestEnd(e) {
        if (e.type === "update") {
            this.read();
        }

        if (e.type === "create") {
            this.read();
        }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ContractManagement", new { area = "Procurement" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
