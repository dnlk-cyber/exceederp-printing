@using ExceedERP.Core.Domain.Procurement.ForeignPurchase
@using System.Collections
<legend>Foreign Purchase Follow Up</legend>
@(Html.Kendo().Grid<ForeignPurchase>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.TenderRef).Title("Tender Ref.").Width(130);
          columns.Bound(c => c.PurchaseRef).Title("Purchase Ref.").Width(130);
          columns.Bound(c => c.Supplier).Width(130);
          columns.Bound(c => c.ItemDesc).Width(150);
          columns.Bound(c => c.FOBMethod).Width(150);
          columns.Bound(c => c.ProcurementMethod).Width(130);
          columns.Bound(c => c.ApprovalDate).Width(130);
          columns.Bound(c => c.OpenigDate).Width(130);
          columns.Bound(c => c.TechnicalDocSendDate).Width(150);
          columns.Bound(c => c.FinancialOpenigDate).Width(150);
          columns.Bound(c => c.MinuteApprovedDate).Width(130);
          columns.Bound(c => c.AwardDate).Width(120);
          columns.Bound(c => c.ContractDate).Width(120);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Events(ev => ev.DetailExpand("detailExpandPurchase"))
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ForeignPurchase").Window(w => w.Title("Foreign Purchase")))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Sortable()
      .Filterable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(
              model =>
              {
                  model.Id(p => p.ForeignPurchaseId);
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
                  model.Field(p => p.Status).Editable(false);
              })
          .Read(read => read.Action("ForeignPurchases_Read", "ForeignPurchase"))
          .Create(create => create.Action("ForeignPurchases_Create", "ForeignPurchase"))
          .Update(update => update.Action("ForeignPurchases_Update", "ForeignPurchase"))
          .Destroy(destroy => destroy.Action("ForeignPurchases_Destroy", "ForeignPurchase"))
      )
      .ClientDetailTemplateId("foreignpurchasetemplate"))

