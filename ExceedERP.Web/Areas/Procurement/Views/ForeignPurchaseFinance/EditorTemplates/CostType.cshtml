@using Kendo.Mvc.UI

@(Html.Kendo().DropDownListFor(m => m)
      .AutoBind(false)
      .ValuePrimitive(true)
      .Filter(FilterType.Contains)
      .OptionLabel("Select Cost")
      .DataTextField("Name")
          .DataValueField("Name")
      .DataSource(dataSource =>
      {
          dataSource.Read(read => read.Action("GetForeignPurchaseCostTypes", "ProcurementDataProvider"))
              .ServerFiltering(true);
      }))
@Html.ValidationMessageFor(m => m)
