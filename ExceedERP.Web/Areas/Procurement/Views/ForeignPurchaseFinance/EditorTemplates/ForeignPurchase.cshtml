                               <div class="form-group">
                                   @Html.LabelFor(model => model.PaymentMethod, htmlAttributes: new { @class = "control-label col-md-8" })
                                   <div class="col-md-6">
                                       @(Html.Kendo().DropDownListFor(model => model.PaymentMethod)
                                             .DataTextField("Text")
                                             .DataValueField("Value")
                                             .ValuePrimitive(true)
                                                     .BindTo(EnumExtension.EnumToSelectList(typeof(ExceedERP.Core.Domain.Procurement.ForeignPurchase.ForeignPaymentMethod)))

                                             )
                                       @Html.ValidationMessageFor(model => model.PaymentMethod, "", new { @class = "text-danger" })
                                   </div>
                               </div>
                               <div class="row"></div>
                               
                               <div class="form-group">
                                   @Html.LabelFor(model => model.ForeignCurrencyProcessId, htmlAttributes: new { @class = "control-label col-md-8" })
                                   <div class="col-md-6">
                                       @(Html.Kendo().DropDownListFor(model => model.ForeignCurrencyProcessId)
                                             .ValuePrimitive(true)
                                             .OptionLabel("Payment Process")
                                             .DataTextField("Description")
                                             .DataValueField("ForeignCurrencyProcessId")
                                             .Filter("contains")
                                             .DataSource(dataSource =>
                                             {
                                                 dataSource.Read(read => read.Action("GetForeignCurrencyProcess", "ProcurementDataProvider", new { area = "Procurement" }))
                                                     .ServerFiltering(false);
                                             })
                                             )
                                       @Html.ValidationMessageFor(model => model.ForeignCurrencyProcessId, "", new { @class = "text-danger" })
                                   </div>
                               </div>
                               <div class="row"></div>

                               <div class="form-group">
                                   @Html.LabelFor(model => model.PaymentOpenDate, htmlAttributes:  new { @class = "control-label col-md-8" })
                                   <div class="col-md-6">
                                       @Html.Kendo().DatePickerFor(model => model.PaymentOpenDate).HtmlAttributes(new { @class = "chb" })
                                       @Html.ValidationMessageFor(model => model.PaymentOpenDate, "", new { @class = "text-danger" })
                                   </div>
                               </div>
                               <div class="row"></div>
                               
                               <div class="form-group">
                                   @Html.LabelFor(model => model.PaymentExtensionDate, htmlAttributes: new { @class = "control-label col-md-12" })
                                   <div class="col-md-6">
                                       @Html.Kendo().DatePickerFor(model => model.PaymentExtensionDate)
                                       @Html.ValidationMessageFor(model => model.PaymentExtensionDate, "", new { @class = "text-danger" })
                                   </div>
                               </div>
                               <div class="row"></div>

                               <div class="form-group">
                                   
                                   @Html.LabelFor(model => model.DocReceivedFromBankDate, htmlAttributes:  new { @class = "control-label col-md-12" })
                                   <div class="col-md-6">
                                       
                                       @Html.Kendo().DatePickerFor(model => model.DocReceivedFromBankDate).HtmlAttributes(new { @class = "chb" })
                                       @Html.ValidationMessageFor(model => model.DocReceivedFromBankDate, "", new { @class = "text-danger" })
                                   </div>
                               </div>
                               <div class="row"></div>

                           </div>

