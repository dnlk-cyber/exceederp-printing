                                   </div>
                               </div>
                               <div class="row"></div>
                               
                               <div class="form-group">
                                  
                                   @Html.LabelFor(model => model.UnitPrice, htmlAttributes: new { @class = "control-label col-md-8" })
                                   <div class="col-md-6">

                                       @Html.Kendo().TextBoxFor(model => model.UnitPrice).HtmlAttributes(new { @class = "chb" })
                                       @Html.ValidationMessageFor(model => model.UnitPrice, "", new { @class = "text-danger" })
                                   </div>
                               </div>
                               <div class="row"></div>
                               
                               <div class="form-group">
                                  
                                   @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })
                                   <div class="col-md-6">

                                       @Html.Kendo().TextBoxFor(model => model.Remark).HtmlAttributes(new { @class = "chb" })
                                       @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                                   </div>
                               </div>
                               <div class="row"></div>

                           </div>
                        </text>);

          
      })
      )
</div>
</div>


