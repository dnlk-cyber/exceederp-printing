<script>

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "PurchaseOrder", new { area = "Procurement" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "PurchaseOrder", new {area = "Procurement"})',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function transferToPayment(id) {
        var desc = "";//prompt("Please enter transaction description:");

        $.ajax({
            type: "POST",
            url: '@Url.Action("TransferToPayment", "PurchaseOrder", new { area = "Procurement" })',
            data: {
                id: id,
                description: desc
            },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function transferToFollowUp(id) {
        var desc = "";//prompt("Please enter transaction description:");

        $.ajax({
            type: "POST",
            url: '@Url.Action("TransferToForeignFollowup", "PurchaseOrder", new { area = "Procurement" })',
            data: {
                id: id,
                description: desc
            },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function onMasterEdit(e) {
        if (e.model.isNew() === false) {
            $("#StoreRequisitionID").kendoDropDownList({
                enable: false
            });
            $("#ProformaPurchaseID").kendoDropDownList({
                enable: false
            });

        }
    }
   

    function filterSuppliers() {
        return { id: $("#ProformaPurchaseID").data("kendoDropDownList").value() }
    }
    function onItemEdit(e) {
       

    }

    function isNewSupplier(obj) {
        
        if ($(obj).is(":checked")) {
            $("#supplierNameDiv").show();

        } else {
            $("#supplierNameDiv").hide();
        }

    }

    

    var supplierTextBox;
    var popup;
    var supplier;
    function SelectSupplier(e) {

        supplierTextBox = $(e).prev('input').attr('id');
        popup = window.open('/Procurement/ProcurementDataProvider/SupplierShortListSelector', 'WindowPopup', 'top=100, left=400, width=300, height=220,resizable=no,');
        popup.focus();
        return false;
    }


    function setChoice(supplierName) {
        supplier = supplierName;
        $("#" + supplierTextBox).val(supplier).trigger("change");
    }


    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    var isapproved;
    var issecondapproved;
    var isSendForApproval;
    var isOnlineTransferred;
    var nextApprover;

    function detailExpandMasterNew(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.PurchaseOrderID;
        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;
        nextApprover = masterDataItem.ForwardedTo;

    }
    function onDataBoundMasterNew(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved || gridData[i].IsSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsSendForApproval && !dataItem.IsOnlineApproved) {
                row.css("background-color", "lightgreen");
            }
            if (!dataItem.IsSendForApproval && !dataItem.IsOnlineApproved) {
                row.css("background-color", "lightskyblue");
            }

            if (dataItem.IsVoid) {
                row.css("background-color", "slategray");
                row.css("color", "black");
            }
        }

      
    }
    function onDataBoundLineNew(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionItem_" + codeid;
        if (isapproved || isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundValidationNew(e) {
        var currentUser=@Html.Raw(Json.Encode(User.Identity.Name));
       

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionValidation_" + codeid;

        if (isapproved || !isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        if (nextApprover !== currentUser) {
            $(".k-grid-add", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }
    function onDataBoundDistributionNew(e) {

        var detailGrid = "#" + e.sender.element[0].id;

        if (isOnlineTransferred) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }


    }

    function getPo() {
        return {
            id: codeid,
            text: $("#PurchaseRequisitionAssignmentId").data("kendoDropDownList").filterInput.val()
        }

    }

</script>



