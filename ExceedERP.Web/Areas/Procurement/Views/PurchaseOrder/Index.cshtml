@using System.Collections
@using ExceedERP.Web.Areas.Procurement.Models
<legend>Purchase Order</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Procurement.PurchaseOrder.PurchaseOrder>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(p => p.PurchaseOrderID).Title("PO No.").Width(90);
          //columns.Bound(p => p.PurchaseRequisitionID).Title("Purchase Req.").Width(100);
          columns.ForeignKey(p => p.ProformaPurchaseID, (IEnumerable)ViewData["proformaPurchases"], "ProformaPurchaseID", "Remark").Title("Proforma No.").EditorTemplateName("ProformaSelector").Filterable(ftb => ftb.Multi(true).Search(true)).Width(100);
          columns.ForeignKey(p => p.ProcurementOfficer, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Purchaser").Width(120).EditorTemplateName("EmployeeSelector");
          columns.Bound(c => c.SupplierId).Width(100).EditorTemplateName("SupplierSelector");
          columns.Bound(c => c.IsNewSupplier).Width(120).ClientTemplate("<input type='checkbox' disabled = 'true' #= IsNewSupplier ? checked='checked' :'' # />");
          columns.Bound(c => c.SupplierName).Width(120);
          //columns.Bound(c => c.POType).EditorTemplateName("POTypeSelector").Width(150);  
          columns.Bound(c => c.OrderDate).Width(130);
          columns.Bound(c => c.DeliveryDate).Width(130);
          columns.Bound(c => c.DeliveryPlace).Width(130);

          columns.Bound(c => c.Remark).Width(120);
          columns.Bound(c => c.PurchaseStatus).Width(130);
          columns.Bound(c => c.Status).Width(120);

          columns.Command(command =>
          {
              command.Edit();
              //command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar => {
          //toolbar.Create();
          // toolbar.Excel();
          // toolbar.Excel();
      })
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("PurchaseOrder").Window(w => w.Title("Purchase Order")))

      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()

      .Events(ev => ev.Edit("onMasterEdit"))
      .Events(ev => ev.DetailExpand("detailExpandMasterNew"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMasterNew"))

      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("PurchaseOrderID").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(
              model =>
              {
                  model.Id(p => p.PurchaseOrderID);
                  model.Field(p => p.ProcurementOfficer).Editable(false);
                  model.Field(p => p.PurchaseOrderID).Editable(false);
                  model.Field(p => p.PurchaseRequisitionID).Editable(false);
                  model.Field(p => p.CurrentApprovalStep).Editable(false);
                  model.Field(p => p.SupplierName).Editable(false);
                  model.Field(p => p.SupplierId).Editable(false);
                  model.Field(p => p.IsNewSupplier).Editable(false);
                  model.Field(p => p.ProcurementMethod).Editable(false);
                  model.Field(p => p.ProformaPurchaseID).Editable(false);
                  model.Field(p => p.IsTransferredToPayment).Editable(false);
                  model.Field(p => p.IsPaid).Editable(false);
                  model.Field(p => p.BranchId).Editable(false);
                  model.Field(p => p.BusinessUnitId).Editable(false);
                  model.Field(p => p.IsFullfilled).Editable(false);
                  model.Field(p => p.Status).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
              })

          .Read(read => read.Action("PurchaseOrders_Read", "PurchaseOrder"))
          .Create(create => create.Action("PurchaseOrders_Create", "PurchaseOrder"))
          .Update(update => update.Action("PurchaseOrders_Update", "PurchaseOrder"))
          .Destroy(destroy => destroy.Action("PurchaseOrders_Destroy", "PurchaseOrder"))
      )
      .ClientDetailTemplateId("templates"))


