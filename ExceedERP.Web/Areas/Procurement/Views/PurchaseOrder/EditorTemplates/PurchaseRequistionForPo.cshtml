@(Html.Kendo().DropDownListFor(m => m)
                  .AutoBind(false)
                  .ValuePrimitive(true)
                  .Filter(FilterType.StartsWith)
                  .OptionLabel("...Select Requisition...")
                  .DataTextField("Description")
                  .DataValueField("PurchaseRequisitionAssignmentId")
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetPurchaseRequisitonForPo", "ProcurementDataProvider", new { area = "Procurement" }).Data("getPo"))
                                .ServerFiltering(true);
                  })
)
@Html.ValidationMessageFor(m => m)
