@using System.Collections
<legend>Procurement Plan</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Procurement.Plan.ProcurementPlan>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ProcurementPlanId).Title("#").Width(120).ClientTemplate("#=appendZeros(ProcurementPlanId)#");
          columns.ForeignKey(p => p.GlFiscalYearId, (IEnumerable)ViewData["Periods"], "GlFiscalYearId", "Name").Title("Fiscal Year").EditorTemplateName("GLYears").Width(120);
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(150);
          columns.Bound(c => c.Name).Width(150);
          columns.Bound(c => c.Remark).Width(90);
          columns.Bound(c => c.Status).Width(80);
        
        
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(380);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
                              //toolbar.Excel();
                              //toolbar.Pdf();
      })
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      
      .ClientDetailTemplateId("templates")
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ProcurementPlanId").Descending())
          .PageSize(20)
          .Model(
              model =>
              {
                  model.Id(p => p.ProcurementPlanId);
                  model.Field(p => p.ProcurementPlanId).Editable(false);
                  model.Field(p => p.Status).Editable(false);
                  //model.Field(p => p.GLPeriodId).Editable(false);
                  //model.Field(p => p.BranchId).Editable(false);
                
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
              })
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("Plans_Read", "ProcurementPlan"))
          .Create(create => create.Action("Plans_Create", "ProcurementPlan"))
          .Update(update => update.Action("Plans_Update", "ProcurementPlan"))
          .Destroy(destroy => destroy.Action("Plans_Destroy", "ProcurementPlan"))
      ))

<script id="templates" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabStrip#=ProcurementPlanId#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
                items.Add().Text("Detail").Content(
                    @<text>
                         # if (!IsOnlineApproved&&!IsSendForApproval)
                        {#
                          <a onclick='return sendForApproval("#=ProcurementPlanId#")' href=' \#' title="Send for Approval"><i class="fa fa-share-square fa-2x"></i></a>
                        <br />
                        # } #

                        # if (IsOnlineApproved)
                        {#
                        <a href='@Url.Action("ProcurementPlanPrint", "ProcurementPrint")/#=ProcurementPlanId#' title="Print"><i class="fa fa-print fa-2x"></i></a>
                        <br />
                        # } #

                        <div>
                            <hr>
                            <dl class="dl-horizontal">

                                <dt>
                                    Plan NO.
                                </dt>
                                <dd>
                                    #= ProcurementPlanId #
                                </dd>
                                <dt>
                                    Name
                                </dt>
                                <dd>
                                    #= Name #

                                </dd>
                                <dt>
                                    Status
                                </dt>
                                <dd>
                                    #= Status #

                                </dd>
                                <dt>
                                    Remark
                                </dt>
                                <dd>
                                    #= Remark #

                                </dd>
                                <dt>
                                    Created On
                                </dt>
                                <dd>
                                    #=kendo.toString(kendo.parseDate(DateCreated), 'dd/MM/yyyy') #


                                </dd>
                                <dt>
                                    Created By
                                </dt>
                                <dd>
                                    #=CreatedBy #

                                </dd>
                            </dl>

                        </div>

                    </text>
                  );

                items.Add().Text("Items").Content(@<text>

                   @(Html.Kendo().Grid<ExceedERP.Core.Domain.Procurement.Plan.ProcurementPlanItem>()
                         .Name("PlanItem#=ProcurementPlanId#")
                         .Columns(columns =>
                         {
                             columns.Bound(c => c.ItemType).Hidden();
                             columns.Bound(c => c.Type).Width(90).EditorTemplateName("ItemTypeSelector").Editable("IsitemEditable");
                             columns.ForeignKey(p => p.CatCode, (IEnumerable)ViewData["Category"], "CatCode", "Name").Title("Category").EditorTemplateName("GenericItemCategorySelector").Width(170).Editable("IsitemEditable");
                             columns.ForeignKey(p => p.ItmCode, (IEnumerable)ViewData["Items"], "ItmCode", "Name").Title("Item").EditorTemplateName("GenericItemSelector").Width(170).Editable("IsitemEditable");
                             columns.Bound(c => c.Name).Width(90).EditorTemplateName("GenericItemNameSelector").Editable("IsitemEditable");
                             columns.Bound(c => c.BudgetSource).EditorTemplateName("BudgetSources").Width(100);
                             columns.Bound(c => c.ProcurementCategory).EditorTemplateName("ProcurementCategorys").Width(120);
                             columns.Bound(c => c.ProcurementMethod).Width(120);
                             columns.Bound(c => c.UnitPrice).Width(90);
                             columns.Bound(c => c.Period1).Width(70);
                             columns.Bound(c => c.Period2).Width(70);
                             columns.Bound(c => c.Period3).Width(70);
                             columns.Bound(c => c.Period4).Width(70);
                             columns.Bound(c => c.Period5).Width(70);
                             columns.Bound(c => c.Period6).Width(70);
                             columns.Bound(c => c.Period7).Width(70);
                             columns.Bound(c => c.Period8).Width(70);
                             columns.Bound(c => c.Period9).Width(70);
                             columns.Bound(c => c.Period10).Width(70);
                             columns.Bound(c => c.Period11).Width(70);
                             columns.Bound(c => c.Period12).Width(70);
                             columns.Bound(c => c.Quantity).Title("Total QTY").Width(80);
                             columns.Bound(c => c.TotalPrice).Width(80).Title("Total Price").Format("{0:n}").ClientFooterTemplate("\\#=kendo.toString(sum, 'n')\\# ");
                             columns.Bound(c => c.Remark).Width(120);
                             columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
                         })
                         .ToolBar(toolbar =>
                         {
                             toolbar.Create();
                             //toolbar.Excel();
                             //toolbar.Pdf();
                         })
                         .Editable(editable => editable.Mode(GridEditMode.InLine))
                         .Events(x => x.DataBound("onDataBoundLines"))
                         .Pageable()
                         .Sortable(sortable =>
                         {
                             sortable.SortMode(GridSortMode.SingleColumn);
                             sortable.AllowUnsort(false);
                         })

                         .Scrollable()
                         .DataSource(dataSource => dataSource
                             .Ajax()
                             .Aggregates(aggregates =>
                             {
                                 aggregates.Add(p => p.TotalPrice).Sum();
                             })
                             .Model(
                                 model =>
                                 {
                                     model.Id(p => p.ProcurementPlanId);
                                     model.Field(p => p.ItemType).Editable(false);
                                     model.Field(p => p.Quantity).Editable(false);
                                     model.Field(p => p.TotalPrice).Editable(false);
                                     model.Field(p => p.OrgBranchName).Editable(false);
                                     model.Field(p => p.CreatedBy).Editable(false);
                                     model.Field(p => p.ModifiedBy).Editable(false);
                                     model.Field(p => p.LastModified).Editable(false);
                                     model.Field(p => p.DateCreated).Editable(false);
                                 })
                             .Events(ev => ev
                                 .Error("error_handler(\"PlanItem#=ProcurementPlanId#\")")
                                 .RequestStart("onRequestStart(\"PlanItem#=ProcurementPlanId#\")")
                                 .RequestEnd("onRequestEnd(\"PlanItem#=ProcurementPlanId#\")"))
                             .Read(read => read.Action("PlanItems_Read", "ProcurementPlanItem", new { id = "#=ProcurementPlanId#" }))
                             .Create(create => create.Action("PlanItems_Create", "ProcurementPlanItem", new { id = "#=ProcurementPlanId#" }))
                             .Update(update => update.Action("PlanItems_Update", "ProcurementPlanItem"))
                             .Destroy(destroy => destroy.Action("PlanItems_Destroy", "ProcurementPlanItem"))
                         )
                         .ToClientTemplate())
                </text>
                );

                items.Add().Text("Validation").Content(@<text>
                  @(Html.Kendo().Grid<ExceedERP.Core.Domain.Procurement.Plan.ProcurementPlanValidation>()
                        .Name("planvalidation#=ProcurementPlanId#")
                        .Columns(columns =>
                        {
                            columns.Bound(c => c.Status).Width(170).EditorTemplateName("ApprovalStatus");
                            columns.Bound(c => c.Remark).Width(170);
                            columns.Bound(c => c.DateCreated).Width(200).Title("Time").Format("{0:dd/MM/yyyy}");
                            columns.Bound(c => c.LastModified).Hidden(true);
                            columns.Bound(c => c.CreatedBy).Width(200).Title("User");
                            columns.Bound(c => c.ModifiedBy).Hidden(true);
                          
                            columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
                        })
                        .ToolBar(toolbar =>
                        {
                            toolbar.Create();
                         
                        })
                        .Editable(editable => editable.Mode(GridEditMode.InLine))
                        .Events(x => x.DataBound("onDataBoundFisrtValidation"))
                        .Pageable()
                        .Filterable()
                        .Scrollable()
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Model(
                                model =>
                                {
                                    model.Id(p => p.ProcurementPlanValidationId);
                                
                                })
                            .Events(ev => ev
                                .Error("error_handler(\"planvalidation#=ProcurementPlanId#\")")
                                .RequestStart("onRequestStart(\"planvalidation#=ProcurementPlanId#\")")
                                .RequestEnd("onRequestEnd(\"planvalidation#=ProcurementPlanId#\")"))
                            .Read(read => read.Action("PlanValidations_Read", "ProcurementPlanValidation", new { id = "#=ProcurementPlanId#" }))
                            .Create(create => create.Action("PlanValidations_Create", "ProcurementPlanValidation", new { id = "#=ProcurementPlanId#" }))
                            .Update(update => update.Action("PlanValidations_Update", "ProcurementPlanValidation"))
                            .Destroy(destroy => destroy.Action("PlanValidations_Destroy", "ProcurementPlanValidation"))
                        )
                        .ToClientTemplate())
                </text>
                );
            })
            
            .ToClientTemplate()
    )
</script>


<script>
 
</script>

