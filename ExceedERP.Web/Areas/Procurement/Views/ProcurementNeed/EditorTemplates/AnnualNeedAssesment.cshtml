@model ExceedERP.Core.Domain.Procurement.Need.AnnualNeedAssesment

@Html.HiddenFor(model => model.AnnualNeedAssesmentID)
  
<div class = "form">
    <div class = "row">
         
        <div class="form-group col-md-offset-1">
            <div class="col-md-6" style="margin-bottom: 5px">
                @Html.LabelFor(model => model.GLPeriodId, htmlAttributes: new { @class = "control-label col-md-3" })


                @Html.Kendo().DropDownListFor(x => x.GLPeriodId).DataValueField("Glper").DataTextField("Name").ValuePrimitive(true).DataSource(datasource => datasource.Read(read => read.Action("GetPeriods", "ProcurementNeed")).ServerFiltering(true))
                @Html.ValidationMessageFor(model => model.Branch, "", new { @class = "text-danger" })
            </div>
        </div>  
    </div>
    <div class = "row">
        <div class="form-group col-md-offset-1">
            <div class="col-md-6" style="margin-bottom: 5px">
                @Html.LabelFor(model => model.RequestingDepartment, htmlAttributes: new { @class = "control-label col-md-3" })


                @Html.Kendo().DropDownListFor(x => x.RequestingDepartment).DataValueField("code").DataTextField("Name").ValuePrimitive(true).DataSource(datasource => datasource.Read(read => read.Action("GetCostCenter", "ProcurementNeed")).ServerFiltering(true))
                @Html.ValidationMessageFor(model => model.RequestingDepartment, "", new { @class = "text-danger" })
            </div>
        </div> 
    </div>
    <div class = "row">
        <div class="form-group col-md-offset-1" >
            <div class="col-md-6" style="margin-bottom: 5px">
                @Html.LabelFor(model => model.Branch, htmlAttributes: new { @class = "control-label col-md-3" })
                @Html.Kendo().TextBoxFor(model => model.Branch)
                @Html.ValidationMessageFor(model => model.Branch, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class = "row">
        <div class="form-group col-md-offset-1">
            <div class = "col-md-6">
                @Html.LabelFor(model => model.RequestingName, htmlAttributes: new { @class = "control-label col-md-3" })

                
                @Html.Kendo().TextBoxFor(model => model.RequestingName)
                @Html.ValidationMessageFor(model => model.RequestingName, "", new {@class = "text-danger"})
            </div>
        </div>  
    </div>
    <div class = "row">
        <div class="form-group col-md-offset-1">
            <div class = "col-md-6">
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-3" })

                
                @Html.Kendo().TextBoxFor(model => model.Remark)
                @Html.ValidationMessageFor(model => model.Remark, "", new {@class = "text-danger"})
            </div>
        </div>  
    </div>
</div>