@using System.Collections
<legend>Annual Need Assessment</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Procurement.Need.AnnualNeedAssesment>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.ForeignKey(p => p.GlFiscalYearId, (IEnumerable)ViewData["Periods"], "GlFiscalYearId", "Name").Title("Fiscal Year").EditorTemplateName("GLYears").Width(120);
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(150);
          if (GlobalHelper.IsMultipleBusinessUnit())
          {
              columns.ForeignKey(p => p.BusinessUnitId, (IEnumerable)ViewData["BusinessUnits"], "BusinessUnitId", "Name").EditorTemplateName("BusinessUnitSelector").Width(150);
          }
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(180).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(150).EditorTemplateName("EmployeeSelector");
          columns.Bound(c => c.Remark).Width(100);
          columns.Bound(c => c.Status).Width(100);

          columns.Command(command =>
          {
              command.Edit();
              command.Destroy();
          }).Width(180);
      })
      .ToolBar(toolbar =>
      {
          toolbar.Create();
          // toolbar.Excel();
          //toolbar.Pdf();
      })
      .Events(ev => ev.DetailExpand("detailExpand"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMaster"))

      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()

      .ClientDetailTemplateId("template")
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("AnnualNeedAssesmentID").Descending())
          .PageSize(20)
          .Model(
              model =>
              {
                  model.Id(p => p.AnnualNeedAssesmentID);

                  model.Field(p => p.Status).Editable(false);
                  //model.Field(p => p.BranchId).Editable(false);
                  //model.Field(p => p.BusinessUnitId).Editable(false);
                  //model.Field(p => p.GLPeriodId).Editable(false);
                  //model.Field(p => p.OrgStructureId).Editable(false);

                  model.Field(p => p.VoidTime).Editable(false);
                  model.Field(p => p.VoidBy).Editable(false);
                  model.Field(p => p.isVoid).Editable(false);
                  model.Field(p => p.OnlineApprovedTime).Editable(false);
                  model.Field(p => p.OnlineApprovedBy).Editable(false);
                  model.Field(p => p.IsOnlineApproved).Editable(false);
                  model.Field(p => p.Status).Editable(false);
                  model.Field(p => p.IsSendForApproval).Editable(false);


                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);


              })
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Read(read => read.Action("AnnualNeedAssesments_Read", "ProcurementNeed"))
          .Create(create => create.Action("AnnualNeedAssesments_Create", "ProcurementNeed"))
          .Update(update => update.Action("AnnualNeedAssesments_Update", "ProcurementNeed"))
          .Destroy(destroy => destroy.Action("AnnualNeedAssesments_Destroy", "ProcurementNeed"))
      ))


