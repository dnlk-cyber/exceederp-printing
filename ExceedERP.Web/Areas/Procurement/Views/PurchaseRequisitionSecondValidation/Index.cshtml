@using ExceedERP.Core.Domain.Procurement.PR

@(Html.Kendo().Grid<PurchaseRequisitionSecondValidation>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Status);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.PurchaseRequisitionSecondValidationId))
          .Read(read => read.Action("PurchaseRequisitionSecondValidations_Read", "PurchaseRequisitionSecondValidation"))
          .Create(create => create.Action("PurchaseRequisitionSecondValidations_Create", "PurchaseRequisitionSecondValidation"))
          .Update(update => update.Action("PurchaseRequisitionSecondValidations_Update", "PurchaseRequisitionSecondValidation"))
      ))
