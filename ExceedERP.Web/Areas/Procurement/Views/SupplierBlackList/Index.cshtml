
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Procurement.Supplier.SupplierBlackList>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Reason);
          columns.Bound(c => c.DurationDays);
          columns.Bound(c => c.DateBlackListed);
          columns.Bound(c => c.DateBlackListedExpire);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.Status);
          columns.Bound(c => c.IsOnlineApproved);
          columns.Bound(c => c.OnlineApprovedBy);
          columns.Bound(c => c.OnlineApprovedTime);
          columns.Bound(c => c.isVoid);
          columns.Bound(c => c.VoidBy);
          columns.Bound(c => c.VoidTime);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Pageable()
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.SupplierBlackListId))
          .Read(read => read.Action("SupplierBlackLists_Read", "SupplierBlackList"))
          .Create(create => create.Action("SupplierBlackLists_Create", "SupplierBlackList"))
          .Update(update => update.Action("SupplierBlackLists_Update", "SupplierBlackList"))
          .Destroy(destroy => destroy.Action("SupplierBlackLists_Destroy", "SupplierBlackList"))
      ))
