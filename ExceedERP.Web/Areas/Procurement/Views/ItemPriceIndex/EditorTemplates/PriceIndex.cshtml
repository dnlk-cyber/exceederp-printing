@model ExceedERP.Core.Domain.Procurement.ItemPriceIndex

@Html.HiddenFor(c => c.ItemPriceIndexID)
<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1">
            
            <div class="form-group">
                @Html.LabelFor(model => model.GLPeriodId, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.GLPeriodId)
                          .ValuePrimitive(true)
                          .OptionLabel("Select Period...")
                          .DataTextField("Name")
                          .DataValueField("GLPeriodId")
                          .Filter("contains")
                          //.Events(e =>
                          //{
                          //    e.Change("onSelectedPeriod");
                          //})
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetOpenInventoryPeriods", "DataProvider", new { area = "Inventory" }))
                                  .ServerFiltering(false);
                          })
                          )
                    @Html.ValidationMessageFor(model => model.GLPeriodId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.BranchId, htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @*@Html.Kendo().TextBoxFor(model => model.ItemCategory)*@
                    @(Html.Kendo().DropDownListFor(model => model.BranchId)
                          .ValuePrimitive(true)
                          .OptionLabel("Select Project...")
                          .DataTextField("Name")
                          .DataValueField("Code")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetBranches", "GlobalDataProvider", new {area = "Common"}))
                                  .ServerFiltering(false);
                          })
                          )
                    @Html.ValidationMessageFor(model => model.BranchId, "", new {@class = "text-danger"})
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.ItemCategory, htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @*@Html.Kendo().TextBoxFor(model => model.ItemCategory)*@
                    @(Html.Kendo().DropDownListFor(model => model.ItemCategory)
                          .ValuePrimitive(true)
                          .OptionLabel("Select category...")
                          .DataTextField("Name")
                          .DataValueField("ItemCategoryCode")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetItemCategory", "DataProvider", new {area = "Inventory"}))
                                  .ServerFiltering(false);
                          })
                          )
                    @Html.ValidationMessageFor(model => model.ItemCategory, "", new {@class = "text-danger"})
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.ItemCode, htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @*@Html.Kendo().TextBoxFor(model => model.InventoryItem)*@
                    @(Html.Kendo().DropDownListFor(model => model.ItemCode)
                          .ValuePrimitive(true)
                          .AutoBind(false)
                          .HtmlAttributes(new {style = "width:150%;"})
                          .OptionLabel("Select product...")
                          .DataTextField("Name")
                          .DataValueField("ItemCode")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetItemList", "DataProvider", new {area = "Inventory"}).Data("filterItems"))
                                  .ServerFiltering(true);
                          })
                          .CascadeFrom("ItemCategoryCode")
                          )


                    @Html.ValidationMessageFor(model => model.ItemCode, "", new {@class = "text-danger"})
                </div>
            </div>
            <div class="row"></div>
        </div>

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.PriceBeforeVAT, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.PriceBeforeVAT)
                    @Html.ValidationMessageFor(model => model.PriceBeforeVAT, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.SourceOfData, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.SourceOfData)
                    @Html.ValidationMessageFor(model => model.SourceOfData, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
        </div>

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Remark)
                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
        </div>
    </div>
</div>


