          .Read(read => read.Action("SupplierRemoveBlackListValidations_Read", "SupplierRemoveBlackListValidation"))
          .Create(create => create.Action("SupplierRemoveBlackListValidations_Create", "SupplierRemoveBlackListValidation"))
          .Update(update => update.Action("SupplierRemoveBlackListValidations_Update", "SupplierRemoveBlackListValidation"))
