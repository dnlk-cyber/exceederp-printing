<script>

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "Guarantee", new { area = "Procurement" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function release(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("Release", "Guarantee", new { area = "Procurement" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function forfeit(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("Forfeit", "Guarantee", new { area = "Procurement" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function filterGuaranteeModes() {

        return {
            category: $("#ProcurementCategory").data("kendoDropDownList").value(),
            type: $("#GuaranteeType").data("kendoDropDownList").value()
        };
    }

    function onUploadSuccess(e) {
        // Force the rebinding of the Grid on successful upload
        $("#grid").data("kendoGrid").dataSource.read();
    }


    function onDataBoundMasterGuarantee(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved || gridData[i].IsSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsSendForApproval && !dataItem.IsOnlineApproved) {
                row.css("background-color", "lightgreen");
            }
            if (!dataItem.IsSendForApproval && !dataItem.IsOnlineApproved) {
                row.css("background-color", "lightskyblue");
            }

            if (dataItem.IsExpired) {
                row.css("background-color", "lightcoral");
            }

            if (dataItem.IsExpired && dataItem.RenewalStatus===1) {
                row.css("background-color", "coral");
                row.css("color", "whitesmoke");
            }

        }
    }

    var isExpired = false;
    var isSent = false;

    function isExpireCheck(obj) {
        if ($(obj).is(":checked")) {
            isExpired = true;
            $("#grid").data("kendoGrid").dataSource.read();

        } else {
            isExpired = false;
            $("#grid").data("kendoGrid").dataSource.read();

        }

    }

    function isSentCheck(obj) {
        if ($(obj).is(":checked")) {
            isSent = true;
            $("#grid").data("kendoGrid").dataSource.read();

        } else {
            isSent = false;
            $("#grid").data("kendoGrid").dataSource.read();

        }

    }

    function passReadData() {
        return {
            isExpired: isExpired,
            isSent: isSent
        };
    }

</script>
