@model ExceedERP.Core.Domain.Procurement.PurchaseOrder.PurchaseOrder
@Html.HiddenFor(model => model.PurchaseOrderID)


<div class="form">
    <div class="row fullrow">
        
        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.POType, htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.POType)
                    @Html.ValidationMessageFor(model => model.POType, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.Supplier, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Supplier)
                    @Html.ValidationMessageFor(model => model.Supplier, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.ProcurementMethod, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.ProcurementMethod)
                    @Html.ValidationMessageFor(model => model.ProcurementMethod, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
        </div>

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.PRNo, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.PRNo)
                    @Html.ValidationMessageFor(model => model.PRNo, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.OrderDate, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().DatePickerFor(model => model.OrderDate)
                    @Html.ValidationMessageFor(model => model.OrderDate, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
        </div>

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.DueDate, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().DatePickerFor(model => model.DueDate)
                    @Html.ValidationMessageFor(model => model.DueDate, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.Remark, htmlAttributes: new {@class = "control-label col-md-6"})
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Remark)
                    @Html.ValidationMessageFor(model => model.Remark, "", new {@class = "text-danger"})
                </div>
            </div>
            <div class="row"></div>
        </div>
    </div>
</div>


