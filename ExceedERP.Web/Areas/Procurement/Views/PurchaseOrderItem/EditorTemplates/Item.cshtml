@model ExceedERP.Core.Domain.Procurement.PurchaseOrder.PurchaseOrderItem

@Html.HiddenFor(model => model.PurchaseOrderItemID)
<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1">

            <div class="form-group">
                @Html.LabelFor(model => model.ItemCategory, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.ItemCategory)
                    @Html.ValidationMessageFor(model => model.ItemCategory, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.InventoryItem, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.InventoryItem)
                    @Html.ValidationMessageFor(model => model.InventoryItem, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
        </div>

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.Quantity, htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Quantity)
                    @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
