@(Html.Kendo().DropDownListFor(m => m)
                  .AutoBind(false)
                  .ValuePrimitive(true)
                  .Filter(FilterType.StartsWith)
                  .OptionLabel("...Select Requisition...")
                  .DataTextField("PurchaseRequisitionID")
                  .DataValueField("PurchaseRequisitionID")
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetPurchaseRequisiton", "DataProvider", new { area = "Inventory" }))
                                .ServerFiltering(true);
                  })
)
@Html.ValidationMessageFor(m => m)

