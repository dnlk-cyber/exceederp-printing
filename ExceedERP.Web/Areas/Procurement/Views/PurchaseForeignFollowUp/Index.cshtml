@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using ExceedERP.Core.Domain.Procurement.PurchaseOrder
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Foreign Purchase Status </legend>
@(Html.Kendo().Grid<PurchaseFollowUp>()
      .Name("grid")
      .Columns(columns =>
          {
              columns.Bound(c => c.PurchaseFollowUpID).Title("No.").Width(90);
              columns.Bound(c => c.PurchaseRequisitionID).Title("PR No.").EditorTemplateName("StoreRequisitionSelector").Width(90);
              columns.Bound(c => c.ReferenceNo).Title("Reference").Width(140);
              //columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Store Keeper").Width(150).EditorTemplateName("EmployeeSelector");
              //columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(160).EditorTemplateName("WorkUnitCostCenterSelector");
              columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(170);
              columns.ForeignKey(p => p.ProcurementOfficer, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Purchaser").Width(170).EditorTemplateName("EmployeeSelector");
              columns.Bound(c => c.PurchaseCategory).EditorTemplateName("PurchaseCategory").Width(130); 
              columns.Bound(c => c.ProcurementMethod).EditorTemplateName("ProcurementMethod").Width(130);
              columns.Bound(c => c.PurchaseStatus).Width(110);
             
          })
             .Events(ev => ev.DetailExpand("detailExpandPurchase"))
             .Editable(editable => editable.Mode(GridEditMode.InLine))
             .HtmlAttributes(new { style = "height: 550px;" })
            .Pageable(pageable => pageable
                        .Input(true)
                        .Numeric(false)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(20))
            .Scrollable()
            .Sortable()
            .Filterable()
            .Groupable()


               .Events(x => x.DataBound("onDataBoundMasterPurchase"))
      .DataSource(dataSource => dataSource
          .Ajax()
                   .Sort(sort => sort.Add("PurchaseFollowUpID").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
              .Model(model =>
                    {
                        model.Id(p => p.PurchaseFollowUpID);
                        model.Field(p => p.PurchaseFollowUpID).Editable(false);
                        model.Field(p => p.PurchaseRequisitionID).Editable(false);
                        model.Field(p => p.OrgStructureId).Editable(false);
                        model.Field(p => p.EmployeeId).Editable(false);
                        model.Field(p => p.BranchId).Editable(false);
                        model.Field(p => p.ReferenceNo).Editable(false);
                        model.Field(p => p.PurchaseStatus).Editable(false);
                    })
              .Read(read => read.Action("PurchaseFollowUps_Read", "PurchaseForeignFollowUp"))
          ).Resizable(resizable => resizable.Columns(true))
          .ClientDetailTemplateId("purchaserequsitiontemplate")
)

