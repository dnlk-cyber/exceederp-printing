    function prAttachementSuccess(e) {
        var gridname = "#PurchaseRequisitionAttachment_" + codeid;
        $(gridname).data("kendoGrid").dataSource.read();
    }

    var supplierTextBox;
    var popup;
    var slectedUser;
    function SelectApprover(e) {

        supplierTextBox = $(e).prev('input').attr('id');
        popup = window.open('/Common/GlobalDataProvider/GetServiceRequisitionSecondApproverSelector', 'WindowPopup', 'top=100, left=400, width=300, height=220,resizable=no,');
        popup.focus();
        return false;
    }

    function setChoice(user) {
        slectedUser = user;
        $("#" + supplierTextBox).val(slectedUser).trigger("change");
    }


    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendforDepartmentApproval", "ServiceRequisitionSelfCare", new { area = "Procurement" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function sendForSecondApproval(id) {
        var recordStatus = "";
        var user = $("#NextApprover").val();
        if (user.length === 0)
            alert("Please select approver");
        else {
            $.ajax({
                type: "POST",
                url: '@Url.Action("SendForSecondApproval", "ServiceRequisitionSelfCare", new { area = "Procurement" })',
                data: {
                    id: id,
                    user: user
                },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

