@using ExceedERP.Core.Domain.Procurement.Guarantee

@(Html.Kendo().Grid<GuaranteeValidation>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Status);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.GuaranteeValidationId))
          .Read(read => read.Action("GuaranteeValidations_Read", "GuaranteeValidation"))
          .Create(create => create.Action("GuaranteeValidations_Create", "GuaranteeValidation"))
          .Update(update => update.Action("GuaranteeValidations_Update", "GuaranteeValidation"))
          .Destroy(destroy => destroy.Action("GuaranteeValidations_Destroy", "GuaranteeValidation"))
      ))
