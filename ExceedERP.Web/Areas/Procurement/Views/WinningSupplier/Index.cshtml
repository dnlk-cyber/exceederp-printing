@using ExceedERP.Core.Domain.Procurement.Proforma

@(Html.Kendo().Grid<WinningSupplier>()
      .Name("grid")
      .Columns(columns =>
      {
        columns.Bound(c => c.InventoryItem);
        columns.Bound(c => c.Quanity);
        columns.Bound(c => c.UPrice);
        columns.Bound(c => c.TPrice);
        columns.Bound(c => c.Supplier);
        columns.Bound(c => c.DeliveryDate);
        columns.Bound(c => c.GRNNo);
        columns.Bound(c => c.Remark);
        columns.Bound(c => c.OrgBranchName);
        columns.Bound(c => c.DateCreated);
        columns.Bound(c => c.LastModified);
        columns.Bound(c => c.CreatedBy);
        columns.Bound(c => c.ModifiedBy);
        columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
            toolbar.Create();
            toolbar.Excel();
           // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Pageable()
      .Sortable(sortable => {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.WinningSupplierID))
          .Read(read => read.Action("WinningSuppliers_Read", "WinningSupplier"))
          .Create(create => create.Action("WinningSuppliers_Create", "WinningSupplier"))
          .Update(update => update.Action("WinningSuppliers_Update", "WinningSupplier"))
          .Destroy(destroy => destroy.Action("WinningSuppliers_Destroy", "WinningSupplier"))
      )
)
