@using Kendo.Mvc.UI

@(Html.Kendo().DropDownListFor(m => m)
                
                  
                  .OptionLabel("Select GRN/SRN...")
                      .DataTextField("Name")
                      .DataValueField("Code")
                      .Filter("contains")
                     .CascadeFrom("ItemType")
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetPOandContractGrnsForSettlement", "ProcurementDataProvider", new { area = "Procurement" }).Data("getPurchaseId"))
                       .ServerFiltering(true);
                  })
)
@Html.ValidationMessageFor(m => m)