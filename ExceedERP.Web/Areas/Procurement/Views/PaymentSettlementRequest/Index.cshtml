@using System.Collections
@using ExceedERP.Core.Domain.Finance.AP
<legend>Payment Settlement Request</legend>
@(Html.Kendo().Grid<ApPaymentSettlement>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.Bound(c => c.ApPaymentSettlementId).Title("ID").Width(100).ClientTemplate("#=appendZeros(ApPaymentSettlementId)#");
              columns.ForeignKey(p => p.SupplierId, (IEnumerable)ViewData["suppliers"], "Code", "Name").Width(150).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.CollectedByPurchaser).Width(120).Title("By Purchaser ?").ClientTemplate(
               "<input type='checkbox' disabled = 'true' value='#= CollectedByPurchaser #' " +
               "# if (CollectedByPurchaser) { #" +
               "checked='checked'" +
               "# } #" +
               "/>"
               );
              columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["employees"], "Code", "Name").Width(250).Filterable(ftb => ftb.Multi(true).Search(true));
              columns.Bound(c => c.PaymentDate).Width(130).Format("{0:dd/MM/yyyy}");
              columns.Bound(c => c.Reference).Width(160);
              columns.Bound(c => c.Remark).Width(120);
              columns.Bound(c => c.Status).Width(130);
              columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
          })
          .ToolBar(toolbar =>
          {

              toolbar.Template(
                    @<text>

                        <a class="k-button k-button-icontext k-grid-add" href='\#'><span class="k-icon k-i-add"></span> Add new record</a>
                        @*<button class="k-button k-button-icontext k-grid-excel" href='\#'> <span class="k-icon k-i-excel"></span>Export to Excel</button>*@

                        @*@(Html.Kendo().CheckBox()
                                                .Name("checktransfferable")
                                                .Label("Show Transferrable Only")
                                                .HtmlAttributes(new { onchange = "isNotTransferredCheck(this)" })
                        )*@



                    </text>);
          })

               .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ApPaymnetSettlement").Window(w => w.Title("Payment Settlement")))


               .Scrollable(h => h.Height(500))
               .Events(ev => ev.DetailExpand("detailExpandMasterDepartment"))
                 .Events(x => x.DataBound("onDataBoundMasterDepartment"))

               .HtmlAttributes(new { style = "height: 550px;" })
               .Pageable(pageable => pageable
                   .Input(true)
                   .Numeric(false)
                   .Refresh(true)
                   .PageSizes(true)
                   .ButtonCount(5))

               .Scrollable()
               .Sortable()
               .Filterable()
               .Selectable(selectable =>
               {
                   selectable.Mode(GridSelectionMode.Single);
                   selectable.Type(GridSelectionType.Row);
               })
               .Sortable(sortable =>
               {
                   sortable.SortMode(GridSortMode.SingleColumn);
               })


               .DataSource(dataSource => dataSource
                   .Ajax()
                   .Sort(sort => sort.Add("ApPaymentSettlementId").Descending())
                   .Model(
                       model =>
                       {
                           model.Id(p => p.ApPaymentSettlementId);
                           model.Field(p => p.ApPaymentSettlementId).Editable(false);
                           model.Field(p => p.BranchId).Editable(false);
                           model.Field(p => p.BusinessUnitId).Editable(false);
                           model.Field(p => p.CreatedAtBranchId).Editable(false);
                           model.Field(p => p.CreatedAtBusinessUnitId).Editable(false);


                           model.Field(p => p.VoidTime).Editable(false);
                           model.Field(p => p.VoidBy).Editable(false);
                           model.Field(p => p.IsVoid).Editable(false);

                           model.Field(p => p.OnlineApprovedTime).Editable(false);
                           model.Field(p => p.OnlineApprovedBy).Editable(false);
                           model.Field(p => p.IsOnlineApproved).Editable(false);
                           model.Field(p => p.Status).Editable(false);

                           model.Field(p => p.IsSendForApproval).Editable(false);
                           model.Field(p => p.IsOnlineTransferred).Editable(false);
                           model.Field(p => p.IsOnlineTransferredBy).Editable(false);
                           model.Field(p => p.OnlineTransferredTime).Editable(false);

                           model.Field(p => p.OrgBranchName).Editable(false);
                           model.Field(p => p.CreatedBy).Editable(false);
                           model.Field(p => p.ModifiedBy).Editable(false);
                           model.Field(p => p.LastModified).Editable(false);
                           model.Field(p => p.DateCreated).Editable(false);


                       })
                   .Events(ev => ev
                       .Error("error_handler(\"grid\")")
                       .RequestStart("onRequestStart(\"grid\")")
                       .RequestEnd("onRequestEnd(\"grid\")"))
                   .Read(read => read.Action("ApPaymentSettlements_Read", "PaymentSettlementRequest").Data("passReadData"))
                   .Create(create => create.Action("ApPaymentSettlements_Create", "PaymentSettlementRequest"))
                   .Update(update => update.Action("ApPaymentSettlements_Update", "PaymentSettlementRequest"))
                   .Destroy(destroy => destroy.Action("ApPaymentSettlements_Destroy", "PaymentSettlementRequest"))
               )
               .ClientDetailTemplateId("templates"))


