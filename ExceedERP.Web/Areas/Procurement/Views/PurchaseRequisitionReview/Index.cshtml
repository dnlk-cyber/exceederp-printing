@using System.Collections
@using ExceedERP.Core.Domain.Inventory
@using ExceedERP.Core.Domain.Procurement.PR
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<legend>Purchase Requisition Review </legend>
@(Html.Kendo().Grid<PurchaseRequisition>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.PurchaseRequisitionID).Title("PR No.").Width(80);
          columns.Bound(c => c.StoreRequisitionID).Title("SR No.").EditorTemplateName("StoreRequisitionSelector").Width(80);
          columns.Bound(c => c.ReferenceNo).Title("Reference").Width(90);
          columns.ForeignKey(p => p.EmployeeId, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Requester").Width(130).EditorTemplateName("EmployeeSelector");
          columns.ForeignKey(p => p.OrgStructureId, (IEnumerable)ViewData["costCenters"], "Code", "Name").Title("Work Unit").Width(130).EditorTemplateName("WorkUnitCostCenterSelector");
          columns.ForeignKey(p => p.BranchId, (IEnumerable)ViewData["Branches"], "BranchId", "Name").EditorTemplateName("BranchSelector").Width(130);
          columns.ForeignKey(p => p.ProcurementOfficer, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Team Leader").Width(130).EditorTemplateName("PurchaserSelector");
          columns.Bound(c => c.PurchaseCategory).EditorTemplateName("PurchaseCategory").Width(100);
          columns.Bound(c => c.ProcurementMethod).EditorTemplateName("ProcurementMethod").Width(100);
          columns.Bound(c => c.TenderType).EditorTemplateName("TenderType").Width(110);
          columns.Bound(c => c.ModelNo).Width(100);
          columns.Bound(c => c.PlateNo).Width(100);
          columns.Bound(c => c.Remark).Width(100);
          columns.Bound(c => c.Status).Width(110);
          columns.Command(command =>
          {
              command.Edit();
              // command.Destroy();
          }).Width(180);
      })
      .Events(ev => ev.DetailExpand("detailExpandPurchase"))

      //.Editable(editable => editable.Mode(GridEditMode.InLine))
      .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("PurchaseRequisition").Window(w => w.Title("Purchase Requisition Review")))
      .HtmlAttributes(new { style = "height: 650px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(20))
      .Scrollable()
      .Sortable()
      .Filterable()



      .Events(x => x.DataBound("onDataBoundMasterPurchase"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("PurchaseRequisitionID").Descending())
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model =>
          {
              model.Id(p => p.PurchaseRequisitionID);
              model.Field(p => p.PurchaseRequisitionID).Editable(false);
              model.Field(p => p.StoreRequisitionID).Editable(false);
              model.Field(p => p.OrgStructureId).Editable(false);
              model.Field(p => p.EmployeeId).Editable(false);
              model.Field(p => p.BusinessUnitId).Editable(false);
              model.Field(p => p.BranchId).Editable(false);
              model.Field(p => p.ReferenceNo).Editable(false);
              model.Field(p => p.ModelNo).Editable(false);
              model.Field(p => p.Remark).Editable(false);
              model.Field(p => p.Status).Editable(false);
              model.Field(p => p.ItemType).Editable(false);
              model.Field(p => p.IsManual).Editable(false);

              model.Field(p => p.ModifiedBy).Editable(false);
              model.Field(p => p.LastModified).Editable(false);
              model.Field(p => p.CreatedBy).Editable(false);
              model.Field(p => p.DateCreated).Editable(false);

              model.Field(p => p.IsSecondOnlineApproved).Editable(false);
              model.Field(p => p.SecondOnlineApprovedBy).Editable(false);
              model.Field(p => p.SecondOnlineApprovedTime).Editable(false);

              model.Field(p => p.IsDepartmentOnlineApproved).Editable(false);
              model.Field(p => p.DepartmentOnlineApprovedBy).Editable(false);
              model.Field(p => p.DepartmentOnlineApprovedTime).Editable(false);

              model.Field(p => p.IsDepartmentSendForApproval).Editable(false);
              model.Field(p => p.DepartmentSendForApprovalBy).Editable(false);
              model.Field(p => p.DepartmentSendForApprovalTime).Editable(false);

              model.Field(p => p.ForwardedFrom).Editable(false);
              model.Field(p => p.ForwardedTo).Editable(false);
              model.Field(p => p.IsFinalApproval).Editable(false);
              model.Field(p => p.CurrentApprovalStep).Editable(false);

              model.Field(p => p.VoidBy).Editable(false);
              model.Field(p => p.VoidTime).Editable(false);
              model.Field(p => p.IsVoid).Editable(false);
          })
          .Read(read => read.Action("PurchaseRequisitionReviews_Read", "PurchaseRequisitionReview"))
          .Create(create => create.Action("PurchaseRequisitionReviews_Create", "PurchaseRequisitionReview"))
          .Update(create => create.Action("PurchaseRequisitionReviews_Update", "PurchaseRequisitionReview"))
          .Destroy(destroy => destroy.Action("PurchaseRequisitionReviews_Destroy", "PurchaseRequisitionReview"))
      ).Resizable(resizable => resizable.Columns(true))
      .ClientDetailTemplateId("purchaserequsitiontemplate"))

