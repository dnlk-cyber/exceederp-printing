@using System.Collections
@using ExceedERP.Core.Domain.Common
@using ExceedERP.Core.Domain.Finance
@using ExceedERP.Core.Domain.Procurement.Settings
@using ExceedERP.Helpers.Common
@model ExceedERP.Core.Domain.Procurement.PR.PurchaseRequisition

@Html.HiddenFor(model => model.PurchaseRequisitionID)

<div class="form">
    <div class="row fullrow">

        <div class="col-md-3 ro1">
            <div class="form-group">
                @Html.LabelFor(model => model.StoreRequisitionID, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.StoreRequisitionID).HtmlAttributes(new { disabled = "disabled" })
                    @Html.ValidationMessageFor(model => model.StoreRequisitionID, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.ReferenceNo, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.ReferenceNo).HtmlAttributes(new { disabled = "disabled" })
                    @Html.ValidationMessageFor(model => model.ReferenceNo, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            
            <div class="form-group">
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @Html.Kendo().TextBoxFor(model => model.Remark).HtmlAttributes(new { disabled = "disabled" })
                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

        </div>
        <div class="col-md-3 ro1">
            
            <div class="form-group">
                @Html.LabelFor(model => model.ProcurementOfficer, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                        @(Html.Kendo().DropDownListFor(model => model.ProcurementOfficer)
                              .ValuePrimitive(true)
                              .OptionLabel("Select Team leader...")
                              .DataTextField("Name")
                              .DataValueField("Code")
                              .Filter("contains")
                              .DataSource(dataSource =>
                              {
                                  dataSource.Read(read => read.Action("GetPurchasers", "ProcurementDataProvider", new { area = "Procurement" }))
                                      .ServerFiltering(false);
                              })
                              )
                 @Html.ValidationMessageFor(model => model.ProcurementOfficer, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            
            <div class="form-group">
                @Html.LabelFor(model => model.PurchaseCategory, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.PurchaseCategory)
                          .DataTextField("Text")
                          .DataValueField("Value")
                          .ValuePrimitive(true)
                          .BindTo(ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(PurchaseCategory)))
 
                          )
                    @Html.ValidationMessageFor(model => model.PurchaseCategory, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>

            <div class="form-group">
                @Html.LabelFor(model => model.ProcurementMethod, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.ProcurementMethod)
                          .DataTextField("Text")
                          .DataValueField("Value")
                          .ValuePrimitive(true)
                          .BindTo(ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(ProcurementMethod)))
 
                          )
                    @Html.ValidationMessageFor(model => model.ProcurementMethod, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            
            <div class="form-group">
                @Html.LabelFor(model => model.TenderType, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.TenderType)
                          .DataTextField("Text")
                          .DataValueField("Value")
                          .ValuePrimitive(true)
                          .BindTo(ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(TenderType)))

                          )
                    @Html.ValidationMessageFor(model => model.TenderType, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            
           
        </div>

        <div class="col-md-3 ro1">


            <div class="form-group">
                @*@Html.LabelFor(model => model.FromPreviousPurchase, htmlAttributes: new { @class = "control-label col-md-8" })*@
                <div class="col-md-10">
                    @Html.Kendo().CheckBoxFor(model => model.FromPreviousPurchase)
                    @Html.ValidationMessageFor(model => model.FromPreviousPurchase, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
           
            <br/><br/>

            <div class="form-group">
                @Html.LabelFor(model => model.PreviousProcurementMethod, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.PreviousProcurementMethod)
                          .DataTextField("Text")
                          .DataValueField("Value")
                          .ValuePrimitive(true)
                          .BindTo(ExceedERP.Helpers.Common.EnumExtension.EnumToSelectList(typeof(ProcurementMethod)))

                    )
                    @Html.ValidationMessageFor(model => model.PreviousProcurementMethod, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>
            
            

            <div class="form-group">
                @Html.LabelFor(model => model.PreviousPurchaseReference, htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.PreviousPurchaseReference)
                          .ValuePrimitive(true)
                          .OptionLabel("Select Purchase Reference...")
                          .DataTextField("Name")
                          .DataValueField("Code")
                          .Filter("contains")
                          .DataSource(dataSource =>
                          {
                              dataSource.Read(read => read.Action("GetPreviousPurchaseReference", "ProcurementDataProvider", new { area = "Procurement" }).Data("filterMethods"))
                                  .ServerFiltering(true);
                          })
                          .CascadeFrom("PreviousProcurementMethod")
                          )
                    @Html.ValidationMessageFor(model => model.PreviousPurchaseReference, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row"></div>



        </div>
    </div>
</div>
