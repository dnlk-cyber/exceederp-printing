
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Procurement.Contract.ContractRenewal>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.SigningDate);
          columns.Bound(c => c.DaysAdded);
          columns.Bound(c => c.AdditionalPayment);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.ContractRenewalId))
          .Read(read => read.Action("ContractRenewals_Read", "ContractRenewal"))
          .Create(create => create.Action("ContractRenewals_Create", "ContractRenewal"))
          .Update(update => update.Action("ContractRenewals_Update", "ContractRenewal"))
          .Destroy(destroy => destroy.Action("ContractRenewals_Destroy", "ContractRenewal"))
      ))
