@using Kendo.Mvc.UI

@(Html.Kendo().DropDownListFor(m => m)
                  .AutoBind(false)
                  .OptionLabel("...Select Participant...")
                          .DataTextField("Supplier")
                              .DataValueField("Supplier").ValuePrimitive(true)
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetFinancialOfferedSupplier", "FinancialOffer"))
                                .ServerFiltering(true);
                  })
)
@Html.ValidationMessageFor(m => m)