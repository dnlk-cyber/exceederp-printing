@using Kendo.Mvc.UI

@(Html.Kendo().DropDownListFor(m => m)
      .AutoBind(false)
      .ValuePrimitive(true)
      .Filter(FilterType.Contains)
      .OptionLabel("Select Participant")
      .DataTextField("Name")
      .DataValueField("Code")
      .DataSource(dataSource =>
      {
          dataSource.Read(read => read.Action("GetProformaParticipant", "ProcurementDataProvider").Data("getProformaForTechnical"))
              .ServerFiltering(true);
      }))
@Html.ValidationMessageFor(m => m)