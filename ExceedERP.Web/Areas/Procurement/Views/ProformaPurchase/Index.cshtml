        return { itemCode: $("#ItemCode").data("kendoDropDownList").value(), id: codeid }
    }

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ProformaPurchase", new { area = "Procurement" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function sendToChecker(id) {
        var recordStatus = "";
        var user = $("#NextApprover").val();
        if (user.length === 0)
            alert("Please select checker");
        else {
            $.ajax({
                type: "POST",
                url: '@Url.Action("SendToChecker", "ProformaPurchase", new { area = "Procurement" })',
                data: {
                    id: id,
                    user: user
                },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "ProformaPurchase", new {area = "Procurement"})',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

</script>



