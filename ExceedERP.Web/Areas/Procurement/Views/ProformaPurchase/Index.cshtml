@using System.Collections
@using ExceedERP.Core.Domain.Procurement.Proforma
<legend>Proforma</legend>
@(Html.Kendo().Grid<ProformaPurchase>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.Bound(c => c.ProformaPurchaseID).Title("#").Width(70);
              columns.Bound(c => c.StoreRequisitionID).Title("SR. No").EditorTemplateName("PurchaseRequisitionSelector").Width(80);
              columns.Bound(c => c.PurchaseRequisitionID).Title("PR No").EditorTemplateName("PurchaseRequisitionSelector").Width(80);
              columns.ForeignKey(p => p.ProcurementOfficer, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Purchaser").Width(140).EditorTemplateName("EmployeeSelector");
              columns.Bound(c => c.ProformaReference).Title("Reference").Width(120);
              columns.Bound(c => c.Description).Width(150);
              columns.Bound(c => c.FloatDate).Width(120);
              columns.Bound(c => c.ClosingDate).Width(120);
              columns.Bound(c => c.EvaluationDate).Width(120);
              columns.Bound(c => c.PurchaseStatus).Width(110);
              columns.Bound(c => c.EvaluateTotalFinance).Width(130).ClientTemplate("<input type='checkbox' disabled = 'true' #= EvaluateTotalFinance ? checked='checked' :'' # />");
              columns.Bound(c => c.Status).Width(120);

              columns.Command(command =>
              {
                  command.Edit();
      // command.Destroy();
  }).Width(180);

          })
          .ToolBar(toolbar =>
          {
              toolbar.Create();
  // toolbar.Excel();
  //toolbar.Pdf();
})
          .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("ProformaPurchase").Window(w => w.Title("Proforma Purchase")))
          .HtmlAttributes(new { style = "height: 650px;" })
          .Pageable(pageable => pageable
              .Input(true)
              .Numeric(false)
              .Refresh(true)
              .PageSizes(true)
              .ButtonCount(20))
          .Scrollable()
          .Selectable(selectable =>
          {
              selectable.Mode(GridSelectionMode.Single);
              selectable.Type(GridSelectionType.Row);
          })
          .Sortable(sortable =>
          {
              sortable.SortMode(GridSortMode.SingleColumn);
          })
          .Filterable()
          
          .Scrollable(h => h.Height(500))
          .Events(x => x.DataBound("onDataBoundMaster"))
          .Events(ev => ev.DetailExpand("detailExpandProforma"))
          .DataSource(dataSource => dataSource
              .Ajax()
              .Sort(sort => sort.Add("ProformaPurchaseID").Descending())
              .Events(ev => ev
                  .Error("error_handler(\"grid\")")
                  .RequestStart("onRequestStart(\"grid\")")
                  .RequestEnd("onRequestEnd(\"grid\")"))
              .Model(model =>
              {
                  model.Id(p => p.ProformaPurchaseID);
                  model.Field(p => p.BranchId).Editable(false);
                  model.Field(p => p.BusinessUnitId).Editable(false);
                  model.Field(p => p.ProformaPurchaseID).Editable(false);
                  model.Field(p => p.StoreRequisitionID).Editable(false);
                  model.Field(p => p.PurchaseRequisitionID).Editable(false);
                  model.Field(p => p.ProcurementOfficer).Editable(false);
                  model.Field(p => p.Status).Editable(false);

                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
              })
              .Read(read => read.Action("ProformaPurchases_Read", "ProformaPurchase"))
              .Create(create => create.Action("ProformaPurchases_Create", "ProformaPurchase"))
              .Update(update => update.Action("ProformaPurchases_Update", "ProformaPurchase"))
              .Destroy(destroy => destroy.Action("ProformaPurchases_Destroy", "ProformaPurchase"))
          ).ClientDetailTemplateId("proformaTemplate"))

