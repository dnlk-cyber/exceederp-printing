
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Procurement.Supplier.SupplierBlackListValidation>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.Status);
          columns.Bound(c => c.Remark);
          columns.Bound(c => c.OrgBranchName);
          columns.Bound(c => c.DateCreated);
          columns.Bound(c => c.LastModified);
          columns.Bound(c => c.CreatedBy);
          columns.Bound(c => c.ModifiedBy);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .Scrollable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Model(model => model.Id(p => p.SupplierBlackListValidationId))
          .Read(read => read.Action("SupplierBlackListValidations_Read", "SupplierBlackListValidation"))
          .Create(create => create.Action("SupplierBlackListValidations_Create", "SupplierBlackListValidation"))
          .Update(update => update.Action("SupplierBlackListValidations_Update", "SupplierBlackListValidation"))
          .Destroy(destroy => destroy.Action("SupplierBlackListValidations_Destroy", "SupplierBlackListValidation"))
      ))
