@using ExceedERP.Core.Domain.Procurement.Settings
<legend>PO Type</legend>
@(Html.Kendo().Grid<ProcurementPOType>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.POType).Width(120);
          columns.Bound(c => c.AccountCode).Width(120);
          
          columns.Bound(c => c.OrgBranchName).Width(200).Hidden(true);
          columns.Bound(c => c.DateCreated).Width(200).Hidden(true);
          columns.Bound(c => c.LastModified).Width(200).Hidden(true);
          columns.Bound(c => c.CreatedBy).Width(200).Hidden(true);
          columns.Bound(c => c.ModifiedBy).Width(200).Hidden(true);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
                              toolbar.Excel();
                              // toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(5))

      .Scrollable()
      .Sortable()
      .Filterable()
      .Groupable()
      .DataSource(dataSource => dataSource
          .Ajax()
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(model => model.Id(p => p.ProcurementPOTypeID))
          .Events(events => events .Error("error_handler_one"))
          .Read(read => read.Action("ProcurementPOTypes_Read", "ProcurementPoType"))
          .Create(create => create.Action("ProcurementPOTypes_Create", "ProcurementPoType"))
          .Update(update => update.Action("ProcurementPOTypes_Update", "ProcurementPoType"))
          .Destroy(destroy => destroy.Action("ProcurementPOTypes_Destroy", "ProcurementPoType"))
      ))


<script type="text/javascript">
    

    function onGridDataSourceRequestEnd(e) {
        if (e.type == "update") {
            this.read();
        }

        if (e.type == "create") {
            this.read();
        }
    }

</script>