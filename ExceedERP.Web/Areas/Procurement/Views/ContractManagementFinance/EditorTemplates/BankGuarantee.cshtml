@using ExceedERP.Core.Domain.FleetManagement.FleetRegistration
@using ExceedERP.Core.Domain.Procurement
@using ExceedERP.Core.Domain.Procurement.Guarantee
@model ExceedERP.Core.Domain.Procurement.Guarantee.BankGuarantee

@Html.HiddenFor(model => model.BankGuaranteeID)
<div class="form">
    <div class="row fullrow">
    @(Html.Kendo().TabStrip()
    .Name("tabstrip")
    .SelectedIndex(0)
    .Animation(false)
    .Items(items =>
    {

        items.Add()
            .Text("Bank Guarantee")
            .Content(@<text>
                <div class="col-md-3 ro1">
                    <div class="form-group">
                        @Html.LabelFor(model => model.GuaranteeType, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-6">
                            @Html.Kendo().DropDownListFor(m => m.GuaranteeType).DataTextField("Text").DataValueField("Value").BindTo(EnumExtension.EnumToSelectList(typeof(GuaranteeType)))
                            @Html.ValidationMessageFor(model => model.GuaranteeType, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row"></div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.GuaranteeRefNo, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-6">
                            @Html.Kendo().TextBoxFor(model => model.GuaranteeRefNo)
                            @Html.ValidationMessageFor(model => model.GuaranteeRefNo, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row"></div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Amount, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-6">
                            @Html.Kendo().TextBoxFor(model => model.Amount)
                            @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row"></div>
                </div>

                <div class="col-md-3 ro1">

                    <div class="form-group">
                        @Html.LabelFor(model => model.Currency, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-6">
                            @Html.Kendo().TextBoxFor(model => model.Currency)
                            @Html.ValidationMessageFor(model => model.Currency, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row"></div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Date, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-6">
                            @Html.Kendo().DateTimePickerFor(model => model.Date)
                            @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row"></div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.BankBranch, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-6">
                            @Html.Kendo().TextBoxFor(model => model.BankBranch)
                            @Html.ValidationMessageFor(model => model.BankBranch, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row"></div>
                </div>

                <div class="col-md-3 ro1">

                    <div class="form-group">
                        @Html.LabelFor(model => model.BankAddress, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-6">
                            @Html.Kendo().TextBoxFor(model => model.BankAddress)
                            @Html.ValidationMessageFor(model => model.BankAddress, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row"></div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.ValidityPeriod, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-6">
                            @Html.Kendo().TextBoxFor(model => model.ValidityPeriod)
                            @Html.ValidationMessageFor(model => model.ValidityPeriod, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row"></div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.ValidityStatus, htmlAttributes: new { @class = "control-label col-md-6" })
