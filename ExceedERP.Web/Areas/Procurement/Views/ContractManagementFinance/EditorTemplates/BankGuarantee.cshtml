                            @Html.Kendo().DropDownListFor(m => m.ValidityStatus).DataTextField("Text").DataValueField("Value").BindTo(EnumExtension.EnumToSelectList(typeof(ValidityStatus)))
                            @Html.ValidationMessageFor(model => model.ValidityStatus, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row"></div>
                </div>
            </text>);

        items.Add()
            .Text("BankGuarantee")
            .Content(@<text>

                <div class="col-md-3 ro1">
                    <div class="form-group">
                        @Html.LabelFor(model => model.GuaranteePresenterName, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-6">
                            @Html.Kendo().TextBoxFor(model => model.GuaranteePresenterName)
                            @Html.ValidationMessageFor(model => model.GuaranteePresenterName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row"></div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.GuaranteePresenterAddress, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-6">
                            @Html.Kendo().TextBoxFor(model => model.GuaranteePresenterAddress)
                            @Html.ValidationMessageFor(model => model.GuaranteePresenterAddress, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row"></div>
                </div>

                <div class="col-md-3 ro1">

                    <div class="form-group">
                        @Html.LabelFor(model => model.Status, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-6">
                            @Html.Kendo().TextBoxFor(model => model.Status)
                            @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row"></div>
                </div>

                <div class="col-md-3 ro1">

                    <div class="form-group">
                        @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-6">
                            @Html.Kendo().TextBoxFor(model => model.Remark)
                            @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row"></div>
                </div>
            </text>);
    })
        )
    </div>
</div>