@using System.Collections
@using ExceedERP.Core.Domain.Procurement.Contract
@using ExceedERP.Web.Areas.Procurement.Models

<legend>Contract Management</legend>
@(Html.Kendo().Grid<ContractManagement>()
      .Name("grid")
      .Columns(columns =>
      {
          columns.Bound(c => c.ContractManagementID).Title("#").Width(90).ClientTemplate("#=appendZeros(ContractManagementID)#");
          columns.Bound(c => c.SupplierId).Width(100);
          columns.Bound(c => c.IsNewSupplier).Width(100).Title("New Supplier").ClientTemplate(
              "<input type='checkbox' disabled = 'true' value='#= IsNewSupplier #' " +
              "# if (IsNewSupplier) { #" +
              "checked='checked'" +
              "# } #" +
              "/>"
              );
          columns.Bound(c => c.SupplierName).Width(130);
          columns.Bound(c => c.ContractRefNo).Width(130);
          columns.Bound(c => c.TenderRefNo).Width(130);
          columns.Bound(c => c.ProcurementRefNo).Title("Award Ref.").EditorTemplateName("AwardSelector").Width(120);
          columns.Bound(c => c.SigningDate).Width(100).Format("{0:dd/MM/yyyy}");
          columns.Bound(c => c.ContractType).EditorTemplateName("ProcurementCategorys").Width(120);
          columns.Bound(c => c.PurchaseCategory).EditorTemplateName("PurchaseCategory").Width(120);
          columns.Bound(c => c.DeliveryPlace).Width(120);
          columns.Bound(c => c.DeliveryDate).Width(110).Format("{0:dd/MM/yyyy}");
          columns.Bound(c => c.DeliveryType).Width(100).EditorTemplateName("DeliveryType");
          columns.Bound(c => c.ContractAmount).Width(110);
          columns.Bound(c => c.Advance).Width(110);
          columns.Bound(c => c.RetentionPercentage).Width(110);
          columns.Bound(c => c.Remark).Width(80);
          columns.Bound(c => c.Status).Width(100);
          columns.Command(command => { command.Edit(); command.Destroy(); }).Width(180);
      })
      .ToolBar(toolbar => {
                              toolbar.Create();
                              // toolbar.Excel();
                              //toolbar.Pdf();
      })
      .Editable(editable => editable.Mode(GridEditMode.InLine))
      .HtmlAttributes(new { style = "height: 550px;" })
      .Pageable(pageable => pageable
          .Input(true)
          .Numeric(false)
          .Refresh(true)
          .PageSizes(true)
          .ButtonCount(10))
      .Scrollable()
      .Selectable(selectable =>
      {
          selectable.Mode(GridSelectionMode.Single);
          selectable.Type(GridSelectionType.Row);
      })
      .Sortable(sortable =>
      {
          sortable.SortMode(GridSortMode.SingleColumn);
      })
      .Filterable()
      
      .ClientDetailTemplateId("template")
      .Events(ev => ev.DetailExpand("detailExpandMasterNew"))
      .Scrollable(h => h.Height(500))
      .Events(x => x.DataBound("onDataBoundMasterNew"))
      .DataSource(dataSource => dataSource
          .Ajax()
          .Sort(sort => sort.Add("ContractManagementID").Descending())
          .PageSize(20)
          .Events(ev => ev
              .Error("error_handler(\"grid\")")
              .RequestStart("onRequestStart(\"grid\")")
              .RequestEnd("onRequestEnd(\"grid\")"))
          .Model(
              model =>
              {
                  model.Id(p => p.ContractManagementID);
                  model.Field(p => p.OrgBranchName).Editable(false);
                  model.Field(p => p.IsTransferredToPayment).Editable(false);
                  model.Field(p => p.IsTransferredToFollowUp).Editable(false);
                  model.Field(p => p.CreatedBy).Editable(false);
                  model.Field(p => p.ModifiedBy).Editable(false);
                  model.Field(p => p.LastModified).Editable(false);
                  model.Field(p => p.DateCreated).Editable(false);
                  model.Field(p => p.Status).Editable(false);
              })
          .Read(read => read.Action("ContractManagements_Read", "ContractManagement"))
          .Create(create => create.Action("ContractManagements_Create", "ContractManagement"))
          .Update(update => update.Action("ContractManagements_Update", "ContractManagement"))
          .Destroy(destroy => destroy.Action("ContractManagements_Destroy", "ContractManagement"))
      ))


