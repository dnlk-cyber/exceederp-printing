<script>

    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ContractManagement", new { area = "Procurement" })',
            data: { id: id },
            success: function(result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function(result) {
                alert(result);
            }
        });
    }

    function sendForApprovalRenewal(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ContractRenewal", new {area = "Procurement"})',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function sendForApprovalPayment(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "ContractPayment", new {area = "Procurement"})',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    var masterDataItem;
    var masterRow;
    var masterGrid;

    var codeid;
    var isapproved;
    var issecondapproved;
    var isSendForApproval;
    var isOnlineTransferred;
    var nextApprover;

    function detailExpandMasterNew(e) {

        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.ContractManagementID;
        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;
        issecondapproved = masterDataItem.IsSecondOnlineApproved;
        nextApprover = masterDataItem.ForwardedTo;

    }
    function onDataBoundMasterNew() {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved || gridData[i].IsSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

      
    }
    function onDataBoundLineNew(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionItem_" + codeid;
        if (isapproved || isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }
    function onDataBoundValidationNew(e) {
        var currentUser=@Html.Raw(Json.Encode(User.Identity.Name));
       

        var detailGrid = "#" + e.sender.element[0].id;

        if (isapproved || !isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        if (nextApprover !== currentUser) {
            $(".k-grid-add", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }
    function onDataBoundDistributionNew(e) {

        var detailGrid = "#" + e.sender.element[0].id;

        if (isOnlineTransferred) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }


    }


    var masterDataItemRenew;
    var masterRowRenew;
    var masterGridRenew;

    
    var isapprovedRenew;
    var issecondapprovedRenew;
    var isSendForApprovalRenew;
    var isOnlineTransferredRenew;

    function detailExpandRenewal(e) {

        masterRowRenew = e.masterRow;
        var grid = "#" + e.sender.element[0].id;
        masterGridRenew = $(grid).data("kendoGrid");
        masterDataItemRenew = masterGridRenew.dataItem(masterRowRenew);
        isapprovedRenew = masterDataItemRenew.IsOnlineApproved;
        isSendForApprovalRenew = masterDataItemRenew.isSendForApprovalRenew;
        isOnlineTransferredRenew = masterDataItemRenew.isOnlineTransferredRenew;
        issecondapprovedRenew = masterDataItemRenew.IsSecondOnlineApproved;

    }

    function onDataBoundMasterRenewal(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());
        var gridid = "#" + e.sender.element[0].id;
        //approved
        var grid = $(gridid).data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved || gridData[i].isSendForApprovalRenew) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }
       }
    function onDataBoundFisrtValidationRenewal(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionValidation_" + codeid;

        if (isapprovedRenew || !isSendForApprovalRenew) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }

    function filterInventoryItems() {

        return {
            itemCategoryCode: $("#ItemCategoryCode").data("kendoDropDownList").value()
        };
    }


    function transferToPayment(id) {
        var desc = "";//prompt("Please enter transaction description:");

        $.ajax({
            type: "POST",
            url: '@Url.Action("TransferToPayment", "ContractManagement", new { area = "Procurement" })',
            data: {
                id: id,
                description: desc
            },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }


    function transferToFollowUp(id) {
        var desc = "";//prompt("Please enter transaction description:");

        $.ajax({
            type: "POST",
            url: '@Url.Action("TransferToForeignFollowup", "ContractManagement", new { area = "Procurement" })',
            data: {
                id: id,
                description: desc
            },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    

    function contractAttachementSuccess(e) {
        var gridname = "#contractdocument_" + codeid;
        $(gridname).data("kendoGrid").dataSource.read();
    }

    
    function contractPaymentAttachementSuccess(e) {
        //var gridname = "#contractdocument_" + codeid;
        //$(gridname).data("kendoGrid").dataSource.read();
    }
</script>



