@using Kendo.Mvc.UI

@(Html.Kendo().DropDownListFor(m => m)
      .AutoBind(false)
      .ValuePrimitive(true)
      .Filter(FilterType.Contains)
      .OptionLabel("Item")
      .DataTextField("Name")
      .DataValueField("Code")
      .DataSource(dataSource =>
      {
          dataSource.Read(read => read.Action("GetLotItemsByLotId", "Tender").Data("getLotId"))
              .ServerFiltering(true);
      }))
@Html.ValidationMessageFor(m => m)
