@using Kendo.Mvc.UI

@(Html.Kendo().DropDownListFor(m => m)
                      .AutoBind(false)
                      .ValuePrimitive(true)
                      .Filter(FilterType.Contains)
                  .OptionLabel("...Select Participant...")
                          .DataTextField("Supplier")
                          .DataValueField("SupplierValue")
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetBidPurchase", "BidPurchase").Data("getLotId"))
                                .ServerFiltering(true);
                  })
)
@Html.ValidationMessageFor(m => m)