@using Kendo.Mvc.UI

@(Html.Kendo().DropDownListFor(m => m)
      .AutoBind(false)
      .ValuePrimitive(true)
      .Filter(FilterType.Contains)
      .OptionLabel("Supplier")
      .DataTextField("Supplier")
      .DataValueField("SupplierCode")
      .DataSource(dataSource =>
      {
          dataSource.Read(read => read.Action("GetBidParticipant", "BidParticipant").Data("getLotId"))
              .ServerFiltering(true);
      }))
@Html.ValidationMessageFor(m => m)