
@using Kendo.Mvc.UI

@(Html.Kendo().DropDownListFor(m => m)
                  .AutoBind(false)
                  .OptionLabel("...Select Criteria...")
                              .DataTextField("CriteriaName")
                              .DataValueField("CriteriaName")
                  .DataSource(dataSource =>
                  {
                      dataSource.Read(read => read.Action("GetCriteria", "TenderEvaluationCriteria").Data("getLotId"))
                                .ServerFiltering(true);
                  })
)
@Html.ValidationMessageFor(m => m)