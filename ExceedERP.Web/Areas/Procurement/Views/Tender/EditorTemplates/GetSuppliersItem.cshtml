@using Kendo.Mvc.UI

@(Html.Kendo().DropDownListFor(m => m)
      .AutoBind(false)
      .ValuePrimitive(true)
      .Filter(FilterType.Contains)
      .OptionLabel("...Select Participant...")
      .DataTextField("Name")
      .DataValueField("supplierId")
      .DataSource(dataSource =>
      {
          dataSource.Read(read => read.Action("GetItemParticipants", "TenderParticipantItems").Data("getItemCode"))
              .ServerFiltering(true);
      }).CascadeFrom("ItemCode"))
@Html.ValidationMessageFor(m => m)
