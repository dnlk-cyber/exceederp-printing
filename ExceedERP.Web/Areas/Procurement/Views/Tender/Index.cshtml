@using System.Collections
@using System.Globalization
@using ExceedERP.Core.Domain.Procurement.Tender
@using ExceedERP.Core.Domain.Procurement.Tender.Lot
@using ExceedERP.Web.Areas.Procurement.Models

<legend>Tender</legend>
@(Html.Kendo().Grid<ExceedERP.Core.Domain.Procurement.Tender.Tender>()
                                              .Name("grid")
                                              .Columns(columns =>
                                              {
                                                  columns.Bound(c => c.TenderID).Title("#").Width(120).ClientTemplate("#=appendZeros(TenderID)#");
                                                  columns.Bound(c => c.TenderReference).Width(130);
                                                  columns.Bound(c => c.Description).Width(150);
                                                  columns.Bound(c => c.ProcurementCategory).Width(130).EditorTemplateName("ProcurementCategorys");
                                                  columns.Bound(c => c.TenderType).Width(130).EditorTemplateName("TenderType");
                                                  columns.Bound(c => c.PurchaseCategory).Width(130).EditorTemplateName("PurchaseCategory");
                                                  columns.Bound(c => c.FloatDate).Width(140);
                                                  columns.Bound(c => c.ClosingDate).Width(140);
                                                  columns.Bound(c => c.OpenigDate).Width(140);
                                                  //columns.Bound(c => c.TechnicalOpenigDate).Width(140);
                                                  columns.Bound(c => c.FinancialOpenigDate).Width(140);
                                                  columns.ForeignKey(p => p.ProcurementOfficer, (IEnumerable)ViewData["personEmployees"], "Code", "Name").Title("Purchaser").Width(130).EditorTemplateName("PurchaserSelector");
                                                  columns.Bound(c => c.IsCancelled).Width(85).Title("Cancelled ?").ClientTemplate(
                                                      "<input type='checkbox' disabled = 'true' value='#= IsCancelled #' " +
                                                      "# if (IsCancelled) { #" +
                                                      "checked='checked'" +
                                                      "# } #" +
                                                      "/>"
                                                      );
                                                  columns.Bound(c => c.PurchaseStatus).Width(130);
                                                  columns.Bound(c => c.Status).Width(90);


                                                  columns.Command(command => { command.Edit(); /*command.Destroy();*/ }).Width(180);
                                              })
                                              .ToolBar(toolbar =>
                                              {
                                                  toolbar.Create();
                                                  toolbar.Custom().Name("Templates").Action("Index", "TenderTemplate").HtmlAttributes(new { @class = "btn btn-primary" });
                                              })

                                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                                              .HtmlAttributes(new { style = "height: 700px;" })
                                              .Pageable(pageable => pageable
                                                  .Input(true)
                                                  .Numeric(false)
                                                  .Refresh(true)
                                                  .PageSizes(true)
                                                  .ButtonCount(20))
                                              .Scrollable()
                                              .Selectable(selectable =>
                                              {
                                                  selectable.Mode(GridSelectionMode.Single);
                                                  selectable.Type(GridSelectionType.Row);
                                              })
                                              .Sortable(sortable =>
                                              {
                                                  sortable.SortMode(GridSortMode.SingleColumn);
                                              })
                                              .Filterable()
                                              .Sortable(sortable =>
                                              {
                                                  sortable.SortMode(GridSortMode.SingleColumn);
                                              })
                                              .Filterable()
                                              .Events(ev => ev.DetailExpand("detailExpand")
                                                  .DataBound("onDataBoundTender"))
                                              .Scrollable(height => height.Height(500))
                                              .ClientDetailTemplateId("tenderdetail")
                                              .DataSource(dataSource => dataSource
                                                  .Ajax()
                                                  .Sort(sort => sort.Add("TenderID").Descending())
                                                  .Model(model =>
                                                  {
                                                      model.Id(p => p.TenderID);
                                                      model.Field(p => p.BranchId).Editable(false);
                                                      model.Field(p => p.BusinessUnitId).Editable(false);
                                                      model.Field(p => p.ProcurementOfficer).Editable(false);
                                                      model.Field(p => p.Status).Editable(false);
                                                      model.Field(p => p.IsCancelled).Editable(false);
                                                  })
                                                  .Events(ev => ev
                                                      .Error("error_handler(\"grid\")")
                                                      .RequestStart("onRequestStart(\"grid\")")
                                                      .RequestEnd("onRequestEnd(\"grid\")"))
                                                  .Read(read => read.Action("Tenders_Read", "Tender"))
                                                  .Create(create => create.Action("Tenders_Create", "Tender"))
                                                  .Update(update => update.Action("Tenders_Update", "Tender"))
                                                  .Destroy(destroy => destroy.Action("Tenders_Destroy", "Tender"))
                                              ))

