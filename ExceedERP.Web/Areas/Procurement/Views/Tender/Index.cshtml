<script>


    function sendToContract(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendToContract", "Tender", new { area = "Procurement" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function sendAwardToPo(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("TransferAwardToPO", "Tender", new { area = "Procurement" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }



    function sendForApproval(id) {
        var recordStatus = "";

        $.ajax({
            type: "POST",
            url: '@Url.Action("SendForApproval", "Tender", new { area = "Procurement" })',
            data: { id: id },
            success: function (result) {
                // toastr.warnning(result.Message);
                alert(result.Message);
                recordStatus = result.Status;
                location.reload(true);
            }, //end succ
            error: function (result) {
                alert(result);
            }
        });
    }

    function voidRecord(id) {
        var recordStatus = "";
        var conf = confirm("Are you sure you want to void this record number: " + id + " ?");
        if (conf === true) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Void", "Tender", new {area = "Procurement"})',
                data: { id: id },
                success: function (result) {
                    // toastr.warnning(result.Message);
                    alert(result.Message);
                    recordStatus = result.Status;
                    location.reload(true);
                }, //end succ
                error: function (result) {
                    alert(result);
                }
            });
        }
    }

    function onPassFaileResultEdit(e) {

        if (e.model.isNew() === false) {
            //$("#UnitPrice").attr("readonly", true);
            $("#SupplierName").kendoDropDownList({
                enable: false
            });
            $("#ItmCode").kendoDropDownList({
                enable: false
            });

        }
    }

    function onEditCriteria(e) {

        var item = $("#Type").data("kendoDropDownList").value();
        //var dataItem = this.dataItem(e.item);
        //var item = dataItem.Type;
        alert(item);
        //begin

        if (item === "2") {
            $("#Weight").val("0").trigger("change");
            $("#Weight").attr("readonly", true);
        } else {
            $("#Weight").attr("readonly", false);
        }
        //end
    }

    var popup;
    var aCode;
    function SelectItemCode() {

        popup = window.open('/Inventory/DataProvider/ItemFilterCat', 'WindowPopup', 'top=100, left=400, width=400, height=320,resizable=no,');
        popup.focus();
        return false;
    }

    function setLang(itemCode) {
        aCode = itemCode;
        $("#ItmCode").val(aCode).trigger("change");
    }


    var masterRow;
    var masterGrid;
    var masterDataItem;
    var codeid;
    var isapproved;
    var issecondapproved;
    var isSendForApproval;
    var isOnlineTransferred;

    var tenderType;
    var purchaseType;
    function detailExpand(e) {
        masterRow = e.masterRow;
        masterGrid = $("#grid").data("kendoGrid");
        masterDataItem = masterGrid.dataItem(masterRow);
        codeid = masterDataItem.TenderID;
        isapproved = masterDataItem.IsOnlineApproved;
        isSendForApproval = masterDataItem.IsSendForApproval;
        isOnlineTransferred = masterDataItem.IsOnlineTransferred;

        tenderType = masterDataItem.TenderType;
        purchaseType = masterDataItem.PurchaseCategory;
        var lotgd;
        if (tenderType === 1) {
            $('#Supplier').attr('disabled', 'disabled');
        }
        else {
            // $('#PurchaseRequisitionID').attr('required', 'required');
        }

        if (purchaseType !== 0) {
            lotgd = "#lotgrid_" + codeid;
            var lotgrid = $(lotgd).data("kendoGrid");
            lotgrid.hideColumn(0);

        } else {
            $('#PurchaseRequisitionID').attr('required', 'required');
        }
    }

    function onDataBoundTender(e) {
        //this.expandRow(this.tbody.find("tr.k-master-row").first());

        //approved
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();

        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            if (gridData[i].IsOnlineApproved || gridData[i].IsSendForApproval) {
                var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
                var editButton = $(currenRow).find(".k-grid-edit");
                var deleteButton = $(currenRow).find(".k-grid-delete");
                editButton.hide();
                deleteButton.hide();
            }
        }

        //changing colors
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            if (dataItem.IsSendForApproval && !dataItem.IsOnlineApproved) {
                row.css("background-color", "lightgreen");
            }
            if (!dataItem.IsSendForApproval && !dataItem.IsOnlineApproved) {
                row.css("background-color", "lightskyblue");
            }
            if (dataItem.CloseStatus) {
                row.css("color", "yellow");
            }
            if (dataItem.OpenStatus) {
                row.css("color", "red");
            }
        }
    }
    function onDataBoundTenderLines(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionItem_" + codeid;
        if (isapproved || isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }
    }

    var priceGridId = "";
    function onDataBoundPriceLines(e) {
        //console.log("price binding");
        priceGridId = "#" + e.sender.element[0].id;
        //console.log(priceGridId+"-top");
        if (isapproved || isSendForApproval) {

            $(".k-grid-add", priceGridId).hide();
            $(".k-grid-delete", priceGridId).hide();
            $(".k-grid-edit", priceGridId).hide();
        }
    }
    function onDataBoundTenderValidation(e) {

        var detailGrid = "#" + e.sender.element[0].id;// "#StoreRequisitionValidation_" + codeid;

        if (isapproved || !isSendForApproval) {

            $(".k-grid-add", detailGrid).hide();
            $(".k-grid-delete", detailGrid).hide();
            $(".k-grid-edit", detailGrid).hide();
        }

        this.table.find(".k-grid-edit").hide();
    }



    function onUploadSuccess(e) {
        var gridname = "#tenderminuteuploadgrid_" + codeid;
        $(gridname).data("kendoGrid").dataSource.read();
    }
    function bidSuccess(e) {
        var gridname = "#tenderbiddocument_" + codeid;
        $(gridname).data("kendoGrid").dataSource.read();
    }

    function bidCancellationSuccess(e) {
        //var gridname = "#TenderCancellationUploadDbModel" + cancelid;
        //$(gridname).data("kendoGrid").dataSource.read();
    }

    var lotid;
    function lotDetailExpand(e) {
        var lotrow = e.masterRow;
        var gridName = "#lotgrid_" + codeid;
        var lotgrid = $(gridName).data("kendoGrid");
        var lotDataItem = lotgrid.dataItem(lotrow);
        lotid = lotDataItem.LotID;

        if (tenderType === 0) {
            var lotitemgrid = "#lotitemgrid_" + lotid;
            $(".k-grid-add", lotitemgrid).hide();

        }
        var tabname = "#LotsTabstrip_" + lotid;
        var lottab = $(tabname).data("kendoTabStrip");
        $.ajax({
