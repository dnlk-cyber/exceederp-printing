@model ExceedERP.Core.Domain.Procurement.Tender.TenderMessages
<div class="form">
    <div class="row">
        <div class="col-md-1">

        </div>
        <div class="col-md-3">
            @Html.LabelFor(model => model.ReciverDepartment)

        </div>
        <div class="col-md-2">
           @(Html.Kendo().DropDownListFor(m => m.ReciverDepartment)
          .Filter(FilterType.Contains)
          .ValuePrimitive(true)
          .AutoBind(false)
          .OptionLabel("...Select Department...")
          .DataTextField("Name")
          .DataValueField("Name")
          .DataSource(dataSource =>
          {
              dataSource.Read(read => read.Action("GetDepartment", "Tender"))
                  .ServerFiltering(true);
          }))
        @Html.ValidationMessageFor(m => m)
        </div>
    </div>
    <br />

    <div class="row">
        <div class="col-md-1"></div>

        <div class="col-md-3">
            @Html.LabelFor(model => model.Reciver)


        </div>
        <div class="col-md-2">
           @(Html.Kendo().DropDownListFor(m => m.Reciver)
     .DataValueField("code")
      .DataTextField("Name")
      .Filter(FilterType.Contains)
      .DataSource(datasource => datasource.Read(read => read.Action("GetEmployees", "DataProvider" , new {area ="Inventory"}))))

        </div>
    </div>
    <br />

    <div class="row">
        <div class="col-md-1"></div>
        <div class="col-md-3">
            @Html.LabelFor(model => model.Message)


        </div>
        <div class="col-md-2">
            @Html.Kendo().TextBoxFor(model => model.Message)
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-1"></div>
        <div class="col-md-3">
            @Html.LabelFor(model => model.FileName)


        </div>
        <div class="col-md-4">
            @(Html.Kendo().Upload()
                  .Name("tenderdocument")
                  .Async(a => a.Save("UploadDocument", "TenderMessage" ))
                  .Events(e => e.Complete("bidSuccess").Upload("onUpload"))
                  .ShowFileList(false)
                  )
        </div>
    </div>

</div>
