@using System.Collections

@using ExceedERP.Web.Areas.Procurement.Models
@using ExceedERP.Core.Domain.Procurement.PurchaseOrder
<legend>Change of Order</legend>
@(Html.Kendo().Grid<PoChangeOforder>()
          .Name("grid")
          .Columns(columns =>
          {
              columns.Bound(p => p.PoChangeOforderId).Title("Change No.").Width(90).ClientTemplate("#=appendZeros(PoChangeOforderId)#");
              columns.ForeignKey(p => p.PurchaseOrderID, (IEnumerable)ViewData["PurchaseOrders"], "Code", "Name").Title("Purchase Order").Width(90).EditorTemplateName("PurchaseOrderSelector");
            
              columns.Bound(c => c.Status).Width(120);

              columns.Command(command =>
              {
                  command.Edit();
                  command.Destroy();
              }).Width(180);
          })
          .ToolBar(toolbar =>
          {
              toolbar.Create();
              // toolbar.Excel();
              // toolbar.Excel();
          })
          .Editable(editable => editable.Mode(GridEditMode.InLine))

          .HtmlAttributes(new { style = "height: 500px;" })
          .Pageable(pageable => pageable
              .Input(true)
              .Numeric(false)
              .Refresh(true)
              .PageSizes(true)
              .ButtonCount(20))
          .Scrollable()
          .Selectable(selectable =>
          {
              selectable.Mode(GridSelectionMode.Single);
              selectable.Type(GridSelectionType.Row);
          })
          .Sortable(sortable =>
          {
              sortable.SortMode(GridSortMode.SingleColumn);
          })
          .Filterable()

         
          .Events(ev => ev.DetailExpand("detailExpandMasterNew"))
          .Scrollable(h => h.Height(600))
          .Events(x => x.DataBound("onDataBoundMasterNew"))

          .DataSource(dataSource => dataSource
              .Ajax()
              .Sort(sort => sort.Add("PoChangeOforderId").Descending())
              .Events(ev => ev
                  .Error("error_handler(\"grid\")")
                  .RequestStart("onRequestStart(\"grid\")")
                  .RequestEnd("onRequestEnd(\"grid\")"))
              .Model(
                  model =>
                  {
                      model.Id(p => p.PoChangeOforderId);
                      model.Field(p => p.PoChangeOforderId).Editable(false);
                      model.Field(p => p.BranchId).Editable(false);
                      model.Field(p => p.BusinessUnitId).Editable(false);
                      model.Field(p => p.CurrentApprovalStep).Editable(false);
                      model.Field(p => p.Status).Editable(false);
                      model.Field(p => p.CreatedBy).Editable(false);
                      model.Field(p => p.ModifiedBy).Editable(false);
                      model.Field(p => p.LastModified).Editable(false);
                      model.Field(p => p.DateCreated).Editable(false);
                  })

               .Read(read => read.Action("PoChangeOforders_Read", "PoChangeOforder", new { id = "#= PoChangeOforderId #" }))
               .Create(create => create.Action("PoChangeOforders_Create", "PoChangeOforder", new { id = "#= PoChangeOforderId #" }))
               .Update(update => update.Action("PoChangeOforders_Update", "PoChangeOforder"))
               .Destroy(destroy => destroy.Action("PoChangeOforders_Destroy", "PoChangeOforder"))
          )
          .ClientDetailTemplateId("changetemplates"))



